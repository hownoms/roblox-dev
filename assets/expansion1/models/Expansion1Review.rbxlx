      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Models — procedural low-poly model builders (no mesh / texture asset ids).
	Safe to require on server and client (no services). Every call returns a FRESH, unparented
	Model with all parts Anchored and a PrimaryPart. Unknown ids return a pleasant fallback.

	Conventions (see each module header for details):
	- Front is -Z, up is +Y.
	- Shovel: PrimaryPart = Part "Handle" (grip). Other parts WeldConstraint'ed to Handle and
	  Massless. Handle attribute "GripOffset" (CFrame) -> assign to Tool.Grip.
	- Pet / Egg / Prop: PrimaryPart = invisible "Root" at the bottom-centre.
	- Treasure: PrimaryPart = invisible "Root" at the visual centre (for ViewportFrames).
	- Backpack: PrimaryPart = invisible "Root" at the centre of the face touching the torso's
	  back; pack extends to +Z. Weld at torso.CFrame * CFrame.new(0, 0, torso.Size.Z / 2)
	  (Root attribute "AttachOffset" = CFrame.new(0, 0, 0.5)). All parts Massless.
	- Pets, eggs, treasures, backpacks are welded to Root too (inert while anchored).
]]

local Shovels = require(script.Shovels)
local Pets = require(script.Pets)
local Eggs = require(script.Eggs)
local Treasures = require(script.Treasures)
local Backpacks = require(script.Backpacks)
local Props = require(script.Props)
local Shades = require(script.Shades)
local Consumables = require(script.Consumables)
local Diggers = require(script.Diggers)
local Rides = require(script.Rides)

local Models = {}

function Models.Shovel(shovelId: string): Model
	return Shovels.Build(shovelId)
end

function Models.Pet(petId: string): Model
	return Pets.Build(petId)
end

function Models.Egg(eggId: string): Model
	return Eggs.Build(eggId)
end

function Models.Treasure(treasureId: string): Model
	return Treasures.Build(treasureId)
end

-- v3 discovery: a treasure with its size + material variant (Config.Discovery) applied.
function Models.Find(treasureId: string, size: string?, material: string?): Model
	return Treasures.ApplyVariant(Treasures.Build(treasureId), size, material)
end

function Models.Backpack(backpackId: string): Model
	return Backpacks.Build(backpackId)
end

-- `variant` (optional, default 1) deterministically varies colours / shape.
function Models.Prop(name: string, variant: number?): Model
	return Props.Build(name, variant)
end

function Models.ListProps(): { string }
	return Props.List()
end

-- v2 (Survival agent: Shade, Consumable). Models.Digger(id): a vehicle pet id (or vehicle Kind)
-- at full vehicle size (scale 1); Models.Pet(id) draws the same vehicle at pet scale.
function Models.Shade(shadeId: string): Model
	return Shades.Build(shadeId)
end

function Models.Consumable(consumableId: string): Model
	return Consumables.Build(consumableId)
end

function Models.Digger(id: string, scale: number?): Model
	return Diggers.Build(id, scale)
end

-- v2.1 (Ride agent): full-size ride-on vehicle for a rideable pet (unanchor-ready, see Rides.luau)
function Models.RideVehicle(petId: string): Model
	return Rides.Build(petId)
end

return Models
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Backpacks</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Backpacks — worn on the character's back.
	PrimaryPart = invisible "Root" at the centre of the pack's CONTACT face (the face touching
	the torso's back). The pack extends towards +Z (behind the character, who faces -Z);
	shoulder straps reach forward to -Z. Weld Root to the torso at
	    torso.CFrame * CFrame.new(0, 0, torso.Size.Z / 2)
	(Root attribute "AttachOffset" = CFrame.new(0, 0, 0.5) for a 1-stud-deep torso).
	All parts Anchored (server unanchors), Massless, CanCollide false, welded to Root.
	A sand-coloured part named "SandFill" exists on open containers (decorative).
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Backpacks = {}

local V = Vector3.new
local CF = CFrame.new
local Z = Vector3.zAxis
local SAND = Color3.fromRGB(255, 222, 140)
local TIRE = Color3.fromRGB(45, 45, 55)
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon

type Ctx = {
	m: Model,
	id: string,
	c: Color3,
	a: Color3,
	mat: Enum.Material,
	am: Enum.Material,
	glow: boolean,
}

type ShapeBuilder = (x: Ctx) -> BasePart

local shapes: { [string]: ShapeBuilder } = {}

shapes.Bucket = function(x)
	local zc = 0.85
	local main = Build.cyl(x.m, "Body", 1.6, 1.6, CF(0, 0, zc), x.c, x.mat)
	Build.cyl(x.m, "Base", 0.3, 1.4, CF(0, -0.85, zc), Build.darken(x.c, 0.1), x.mat)
	Build.cyl(x.m, "Rim", 0.18, 1.78, CF(0, 0.8, zc), x.a, x.am)
	Build.ellipsoid(x.m, "SandFill", V(1.45, 0.5, 1.45), CF(0, 0.82, zc), SAND, Enum.Material.Sand)
	Build.beam(x.m, "Handle", V(-0.84, 0.6, zc), V(-0.55, 1.25, zc), 0.1, 0.1, x.a, x.am, Z)
	Build.beam(x.m, "Handle", V(-0.6, 1.25, zc), V(0.6, 1.25, zc), 0.1, 0.1, x.a, x.am, Z)
	Build.beam(x.m, "Handle", V(0.55, 1.25, zc), V(0.84, 0.6, zc), 0.1, 0.1, x.a, x.am, Z)
	-- star on the outer side
	local back = CF(0, 0, zc + 0.8) * CFrame.Angles(0, math.pi, 0)
	Build.tri(x.m, "Star", back * CF(0, 0.08, 0), 0.6, 0.5, 0.06, x.a, x.am)
	Build.tri(x.m, "Star", back * CF(0, -0.08, 0) * CFrame.Angles(0, 0, math.pi), 0.6, 0.5, 0.06, x.a, x.am)
	return main
end

shapes.Bag = function(x)
	local sack = string.find(x.id, "sack") ~= nil
	local bc, bs = V(0, -0.05, 0.65), V(1.8, 1.9, 1.2)
	local main = Build.ellipsoid(x.m, "Body", bs, CF(bc), x.c, x.mat)
	Build.ellipsoid(x.m, "Pocket", V(1.0, 0.75, 0.3), Build.surface(bc, bs, V(0, -0.35, 1)), x.a, x.am)
	if sack then
		Build.cyl(x.m, "Rope", 0.3, 0.55, CF(0, 0.95, 0.65), x.a, x.am)
		Build.ellipsoid(x.m, "Top", V(0.95, 0.5, 0.95), CF(0, 1.22, 0.65), x.c, x.mat)
		Build.part(x.m, "Patch", V(0.45, 0.45, 0.1), Build.surface(bc, bs, V(0.6, 0.4, 1)), x.a, x.am)
	else
		Build.ellipsoid(x.m, "Flap", V(1.7, 0.6, 1.1), CF(0, 0.68, 0.66), Build.darken(x.c, 0.12), x.mat)
		Build.ball(x.m, "Button", 0.24, Build.surface(V(0, 0.68, 0.66), V(1.7, 0.6, 1.1), V(0, -0.3, 1)), x.a, x.am)
	end
	return main
end

shapes.Box = function(x)
	local zc = 0.62
	local main = Build.part(x.m, "Body", V(1.9, 1.4, 1.2), CF(0, -0.1, zc), x.c, x.mat)
	Build.part(x.m, "Lid", V(2.0, 0.3, 1.3), CF(0, 0.72, zc), x.a, x.am)
	for side = -1, 1, 2 do
		Build.part(x.m, "HandlePost", V(0.12, 0.25, 0.12), CF(side * 0.5, 0.95, zc), Build.darken(x.a, 0.2))
	end
	Build.part(x.m, "Handle", V(1.12, 0.12, 0.16), CF(0, 1.08, zc), Build.darken(x.a, 0.2))
	Build.part(x.m, "Latch", V(0.3, 0.35, 0.1), CF(0, 0.45, zc + 0.62), x.a, x.am)
	Build.part(x.m, "Stripe", V(1.92, 0.18, 1.22), CF(0, -0.45, zc), x.a, x.am)
	return main
end

shapes.Barrel = function(x)
	local zc = 0.8
	local main = Build.cyl(x.m, "Body", 1.9, 1.5, CF(0, 0, zc), x.c, x.mat)
	Build.cyl(x.m, "Bulge", 1.0, 1.62, CF(0, 0, zc), x.c, x.mat)
	for _, y in { 0.62, -0.62 } do
		Build.cyl(x.m, "Hoop", 0.14, 1.6, CF(0, y, zc), x.a, if x.glow then NEON else Enum.Material.Metal)
	end
	Build.cyl(x.m, "Lid", 0.06, 1.38, CF(0, 0.94, zc), Build.darken(x.c, 0.2), x.mat)
	Build.ellipsoid(x.m, "SandFill", V(1.2, 0.4, 1.2), CF(0, 0.95, zc), SAND, Enum.Material.Sand)
	return main
end

local function wheel(m: Model, pos: Vector3, axis: Vector3, d: number, hub: Color3)
	Build.cylBetween(m, "Wheel", pos - axis * 0.09, pos + axis * 0.09, d, TIRE)
	Build.cylBetween(m, "Hub", pos - axis * 0.11, pos + axis * 0.11, d * 0.45, hub)
end

shapes.Cart = function(x)
	local zc = 0.7
	local main = Build.part(x.m, "Body", V(2.0, 1.0, 1.3), CF(0, 0, zc), x.c, x.mat)
	Build.part(x.m, "Lip", V(2.12, 0.16, 1.42), CF(0, 0.5, zc), x.a, x.am)
	Build.part(x.m, "Band", V(2.04, 0.14, 1.34), CF(0, -0.2, zc), Build.darken(x.c, 0.2), x.mat)
	Build.ellipsoid(x.m, "SandFill", V(1.8, 0.7, 1.1), CF(0, 0.55, zc), SAND, Enum.Material.Sand)
	for _, px in { -0.65, 0.65 } do
		for _, pz in { zc - 0.6, zc + 0.6 } do
			wheel(x.m, V(px, -0.55, pz), Z, 0.5, x.a)
		end
	end
	return main
end

shapes.Vehicle = function(x)
	if string.find(x.id, "ship") then
		local zc = 0.6
		local main = Build.part(x.m, "Hull", V(2.3, 0.7, 1.1), CF(-0.05, -0.5, zc), x.c, x.mat)
		Build.triPts(x.m, "Bow", V(1.1, -0.5, zc), V(1.65, -0.5, zc), Z, 1.1, 0.7, x.c, x.mat)
		Build.part(x.m, "Stripe", V(2.32, 0.15, 1.12), CF(-0.05, -0.22, zc), x.a, x.am)
		local cols = { Color3.fromRGB(230, 60, 60), Color3.fromRGB(255, 200, 40), Color3.fromRGB(60, 190, 100) }
		for i, col in cols do
			Build.part(x.m, "Container", V(0.55, 0.45, 0.9), CF(-0.35 + (i - 1) * 0.6, 0.08, zc), col)
		end
		Build.part(x.m, "Bridge", V(0.45, 0.85, 0.85), CF(-0.95, 0.25, zc), Color3.fromRGB(245, 245, 245))
		Build.part(
			x.m,
			"Windows",
			V(0.47, 0.14, 0.87),
			CF(-0.95, 0.5, zc),
			Color3.fromRGB(120, 210, 255),
			if x.glow then NEON else Enum.Material.Glass
		)
		Build.cyl(x.m, "Funnel", 0.45, 0.3, CF(-0.95, 0.88, zc), x.a, x.am)
		return main
	end
	-- dump / sand truck, length along X, wheels on the ±Z sides
	local zc = 0.65
	local main = Build.part(x.m, "Bed", V(1.5, 0.7, 1.15), CF(0.4, -0.12, zc) * CFrame.Angles(0, 0, 0.15), x.c, x.mat)
	Build.ellipsoid(
		x.m,
		"SandFill",
		V(1.3, 0.55, 1.0),
		CF(0.42, 0.25, zc) * CFrame.Angles(0, 0, 0.15),
		SAND,
		Enum.Material.Sand
	)
	Build.part(x.m, "Chassis", V(2.4, 0.3, 1.2), CF(0, -0.62, zc), x.a, x.am)
	Build.part(x.m, "Cab", V(0.8, 0.95, 1.1), CF(-0.8, -0.1, zc), x.c, x.mat)
	Build.part(
		x.m,
		"Window",
		V(0.5, 0.35, 1.14),
		CF(-0.75, 0.08, zc),
		Color3.fromRGB(140, 210, 255),
		Enum.Material.Glass
	)
	Build.part(
		x.m,
		"Bumper",
		V(0.12, 0.2, 1.2),
		CF(-1.25, -0.55, zc),
		Color3.fromRGB(220, 220, 225),
		Enum.Material.Metal
	)
	for _, px in { -0.8, 0.75 } do
		for _, pz in { zc - 0.62, zc + 0.62 } do
			wheel(x.m, V(px, -0.8, pz), Z, 0.6, Color3.fromRGB(220, 220, 225))
		end
	end
	return main
end

shapes.Orb = function(x)
	local zc = 1.0
	Build.part(x.m, "Harness", V(0.8, 0.8, 0.3), CF(0, 0, 0.15), Color3.fromRGB(60, 55, 75), Enum.Material.Metal)
	local main = Build.ball(x.m, "Orb", 1.7, CF(0, 0.05, zc), x.c, x.mat)
	Build.ball(x.m, "Core", 0.9, CF(0, 0.05, zc), Build.darken(x.c, 0.5), SMOOTH)
	main.Transparency = math.max(main.Transparency, 0.25)
	Build.cyl(x.m, "Ring", 0.06, 2.5, CF(0, 0.05, zc) * CFrame.Angles(0.45, 0, 0.3), x.a, NEON)
	return main
end

local FALLBACK: Types.BackpackLook = {
	Color = Color3.fromRGB(60, 170, 255),
	AccentColor = Color3.fromRGB(255, 230, 60),
	Shape = "Bucket",
	Material = SMOOTH,
	Glow = false,
}

local function build(id: string, look: Types.BackpackLook): Model
	local m = Build.model(id)
	local root = Build.root(m, CFrame.identity, V(0.6, 0.6, 0.1))
	root:SetAttribute("AttachOffset", CF(0, 0, 0.5))
	local ctx: Ctx = {
		m = m,
		id = id,
		c = look.Color,
		a = look.AccentColor,
		mat = look.Material,
		am = if look.Glow then NEON else SMOOTH,
		glow = look.Glow,
	}
	local builder = shapes[look.Shape] or shapes.Bucket
	local main = builder(ctx)

	-- shoulder straps (over the shoulders onto the chest)
	local strap = Build.darken(look.AccentColor, 0.25)
	for side = -1, 1, 2 do
		Build.part(m, "Strap", V(0.25, 0.08, 1.05), CF(side * 0.5, 0.86, -0.48), strap)
		Build.part(m, "Strap", V(0.25, 1.1, 0.08), CF(side * 0.5, 0.33, -1.03), strap)
	end

	if look.Glow then
		Build.glow(main, look.AccentColor, 1.2, 8)
		Build.sparkle(main, look.AccentColor, 4)
	end
	Build.massless(m, root)
	root.Massless = true
	Build.weldAll(m, root)
	return m
end

function Backpacks.Build(backpackId: string): Model
	local def = Config.GetBackpack(backpackId)
	return build(backpackId, if def then def.Look else FALLBACK)
end

function Backpacks.FromLook(name: string, look: Types.BackpackLook): Model
	return build(name, look)
end

return Backpacks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Build — shared procedural-geometry helpers for every model builder.
	Pure Instance construction: no services, safe on server and client.

	Conventions used by all builders:
	- Models are built around the world origin and returned unparented.
	- "Front" is -Z (LookVector), "up" is +Y, exactly like a Roblox character.
	- Every part is Anchored, CanCollide/CanQuery/CanTouch false by default; use Build.solid()
	  for parts players should stand on / bump into.
	- Cylinders: Build.cyl takes a CFrame whose **Y axis** is the cylinder axis (the helper
	  applies the Roblox X-axis correction internally).
	- Triangles: Build.tri builds a flat isosceles triangle (two WedgeParts) in the CFrame's XY
	  plane, apex towards +Y, thickness along Z.
]]

local Build = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local SMOOTH = Enum.Material.SmoothPlastic
local HALF_PI = math.pi / 2

Build.EYE = Color3.fromRGB(25, 22, 35)
Build.MOUTH = Color3.fromRGB(120, 30, 45)
Build.CHEEK = Color3.fromRGB(255, 140, 165)

-- Colour helpers ----------------------------------------------------------------------------

function Build.lighten(c: Color3, t: number): Color3
	return c:Lerp(WHITE, t)
end

function Build.darken(c: Color3, t: number): Color3
	return c:Lerp(BLACK, t)
end

-- Neon renders its colour as emitted light, so pale / near-white Neon blows out to a blinding
-- white blob under Future lighting + bloom (playtest feedback). Every Neon part made through
-- these helpers is clamped: brightness (HSV value) capped and pale colours re-saturated, so
-- glows stay clearly coloured. White highlights (eye shines) become a soft light grey.
local NEON_MAX_V = 0.78
local NEON_MIN_S = 0.45

function Build.neonSafe(c: Color3): Color3
	local h, s, v = c:ToHSV()
	if s > 0.08 then
		s = math.max(s, NEON_MIN_S)
	end
	return Color3.fromHSV(h, s, math.min(v, NEON_MAX_V))
end

-- Deterministic small hash for per-id variation.
function Build.hash(s: string): number
	local h = 7
	for i = 1, #s do
		h = (h * 31 + string.byte(s, i)) % 1000003
	end
	return h
end

-- Part factories ----------------------------------------------------------------------------

local function setup(p: BasePart, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?)
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	local mat = material or SMOOTH
	p.Material = mat
	if mat == Enum.Material.Neon then
		p.Color = Build.neonSafe(color)
	end
	if mat == Enum.Material.Glass then
		p.Transparency = 0.3
	elseif mat == Enum.Material.Ice then
		p.Transparency = 0.15
	elseif mat == Enum.Material.ForceField then
		p.Transparency = 0.1
	end
	if math.max(size.X, size.Y, size.Z) < 0.6 then
		p.CastShadow = false
	end
end

function Build.part(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	setup(p, name, size, cf, color, material)
	p.Parent = parent
	return p
end

function Build.ball(
	parent: Instance,
	name: string,
	diameter: number,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	setup(p, name, Vector3.new(diameter, diameter, diameter), cf, color, material)
	p.Parent = parent
	return p
end

-- Stretched sphere (Part + built-in Sphere SpecialMesh, no asset ids).
function Build.ellipsoid(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	setup(p, name, size, cf, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	p.Parent = parent
	return p
end

-- Cylinder whose axis is the Y axis of `cf`.
function Build.cyl(
	parent: Instance,
	name: string,
	length: number,
	diameter: number,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	setup(p, name, Vector3.new(length, diameter, diameter), cf * CFrame.Angles(0, 0, HALF_PI), color, material)
	p.Parent = parent
	return p
end

function Build.wedge(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): WedgePart
	local p = Instance.new("WedgePart")
	setup(p, name, size, cf, color, material)
	p.Parent = parent
	return p
end

-- Orientation helpers -----------------------------------------------------------------------

-- CFrame at `pos` whose Y axis points along `yDir`; X axis follows `xHint` as closely as possible.
function Build.orient(pos: Vector3, yDir: Vector3, xHint: Vector3?): CFrame
	local y = yDir.Unit
	local hint = xHint
	if hint == nil or math.abs(hint.Unit:Dot(y)) > 0.98 then
		hint = if math.abs(y.Y) < 0.95 then Vector3.yAxis:Cross(y) else Vector3.xAxis
	end
	local h = hint :: Vector3
	local x = (h - y * h:Dot(y)).Unit
	return CFrame.fromMatrix(pos, x, y)
end

-- Cylinder from point a to point b.
function Build.cylBetween(
	parent: Instance,
	name: string,
	a: Vector3,
	b: Vector3,
	diameter: number,
	color: Color3,
	material: Enum.Material?
): Part
	local d = b - a
	return Build.cyl(parent, name, d.Magnitude, diameter, Build.orient(a:Lerp(b, 0.5), d), color, material)
end

-- Block from a to b (Y = length), `width` along xHint, `thick` along the remaining axis.
function Build.beam(
	parent: Instance,
	name: string,
	a: Vector3,
	b: Vector3,
	width: number,
	thick: number,
	color: Color3,
	material: Enum.Material?,
	xHint: Vector3?
): Part
	local d = b - a
	return Build.part(
		parent,
		name,
		Vector3.new(width, d.Magnitude, thick),
		Build.orient(a:Lerp(b, 0.5), d, xHint),
		color,
		material
	)
end

-- Flat isosceles triangle centred on `cf`: apex at +Y (h/2), base at -Y, width along X,
-- thickness along Z. Two WedgeParts.
function Build.tri(
	parent: Instance,
	name: string,
	cf: CFrame,
	w: number,
	h: number,
	t: number,
	color: Color3,
	material: Enum.Material?
): (WedgePart, WedgePart)
	local size = Vector3.new(t, h, w / 2)
	-- Wedge local: full height at +Z (back), zero at -Z (front). Map local +Z to -X / +X.
	local right = cf * CFrame.fromMatrix(Vector3.new(w / 4, 0, 0), Vector3.zAxis, Vector3.yAxis, -Vector3.xAxis)
	local left = cf * CFrame.fromMatrix(Vector3.new(-w / 4, 0, 0), -Vector3.zAxis, Vector3.yAxis, Vector3.xAxis)
	local a = Build.wedge(parent, name, size, right, color, material)
	local b = Build.wedge(parent, name, size, left, color, material)
	return a, b
end

-- Triangle from a base-centre point to an apex point, width along widthDir.
function Build.triPts(
	parent: Instance,
	name: string,
	base: Vector3,
	apex: Vector3,
	widthDir: Vector3,
	w: number,
	t: number,
	color: Color3,
	material: Enum.Material?
)
	local d = apex - base
	Build.tri(parent, name, Build.orient(base:Lerp(apex, 0.5), d, widthDir), w, d.Magnitude, t, color, material)
end

-- Cheap low-poly cone / horn / crystal: two crossed triangles (4 wedges).
function Build.spike(
	parent: Instance,
	name: string,
	base: Vector3,
	apex: Vector3,
	w: number,
	color: Color3,
	material: Enum.Material?
)
	local d = apex - base
	local cf = Build.orient(base:Lerp(apex, 0.5), d)
	local h = d.Magnitude
	Build.tri(parent, name, cf, w, h, w * 0.28, color, material)
	Build.tri(parent, name, cf * CFrame.Angles(0, HALF_PI, 0), w, h, w * 0.28, color, material)
end

-- Point on the surface of an axis-aligned ellipsoid (centre, full size) in direction `dir`,
-- oriented so LookVector is the outward surface normal. Use for spots, plates, patches.
function Build.surface(centre: Vector3, size: Vector3, dir: Vector3): CFrame
	local a, b, c = size.X / 2, size.Y / 2, size.Z / 2
	local d = dir.Unit
	local t = 1 / math.sqrt((d.X / a) ^ 2 + (d.Y / b) ^ 2 + (d.Z / c) ^ 2)
	local p = centre + d * t
	local rel = d * t
	local n = Vector3.new(rel.X / (a * a), rel.Y / (b * b), rel.Z / (c * c)).Unit
	local up = if math.abs(n.Y) > 0.99 then Vector3.zAxis else Vector3.yAxis
	return CFrame.lookAt(p, p + n, up)
end

-- Faces -------------------------------------------------------------------------------------

export type FaceOpts = {
	spacing: number?, -- eye half-distance at scale 1 (default 0.28)
	eye: number?, -- eye diameter at scale 1 (default 0.3)
	mouth: boolean?, -- default true
	cheeks: boolean?, -- default true
	eyeColor: Color3?,
	radius: number?, -- surface curvature radius in studs (features sink to follow it); nil = flat
	eyes: boolean?, -- default true
}

-- Cute face. `cf` sits on the surface, LookVector pointing out of the face.
function Build.face(parent: Instance, cf: CFrame, s: number, opts: FaceOpts?)
	local o: FaceOpts = opts or {}
	local spacing = (o.spacing or 0.28) * s
	local eyeD = (o.eye or 0.3) * s
	local eyeColor = o.eyeColor or Build.EYE
	local radius: number = o.radius or 0 -- 0 = flat
	local function sink(dx: number, dy: number): number
		local r = radius
		if r <= 0 then
			return 0
		end
		local d2 = dx * dx + dy * dy
		local r2 = r * r
		return if d2 < r2 then r - math.sqrt(r2 - d2) else r
	end
	for side = -1, 1, 2 do
		local ex, ey = side * spacing, 0.08 * s
		local eyeCf = cf * CFrame.new(ex, ey, sink(ex, ey) - 0.02 * s)
		if o.eyes ~= false then
			Build.ball(parent, "Eye", eyeD, eyeCf, eyeColor)
			Build.ball(
				parent,
				"EyeShine",
				eyeD * 0.38,
				eyeCf * CFrame.new(0.22 * eyeD, 0.22 * eyeD, -0.36 * eyeD),
				WHITE,
				Enum.Material.Neon
			)
		end
		if o.cheeks ~= false then
			local cx, cy = side * (spacing + 0.2 * s), -0.1 * s
			Build.ellipsoid(
				parent,
				"Cheek",
				Vector3.new(0.22, 0.12, 0.08) * s,
				cf
					* CFrame.new(cx, cy, sink(cx, cy) - 0.005 * s)
					* CFrame.Angles(0, -math.asin(math.clamp(if radius > 0 then cx / radius else 0, -0.9, 0.9)), 0),
				Build.CHEEK
			)
		end
	end
	if o.mouth ~= false then
		local my = -0.14 * s
		Build.ellipsoid(
			parent,
			"Mouth",
			Vector3.new(0.24, 0.12, 0.08) * s,
			cf * CFrame.new(0, my, sink(0, my) - 0.01 * s),
			Build.MOUTH
		)
	end
end

-- Model plumbing ----------------------------------------------------------------------------

function Build.model(name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	return m
end

-- Invisible pivot part (becomes PrimaryPart).
function Build.root(model: Model, cf: CFrame, size: Vector3?): Part
	local r = Build.part(model, "Root", size or Vector3.new(1, 0.2, 1), cf, WHITE)
	r.Transparency = 1
	r.CastShadow = false
	model.PrimaryPart = r
	return r
end

function Build.setPivot(model: Model, primary: BasePart)
	model.PrimaryPart = primary
end

-- Players collide with / stand on this part.
function Build.solid(p: BasePart): BasePart
	p.CanCollide = true
	p.CanQuery = true
	p.CanTouch = true
	return p
end

function Build.glow(p: BasePart, color: Color3, brightness: number?, range: number?): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	-- Scaled down: model glows read as coloured auras, not white hot spots.
	light.Brightness = (brightness or 1.5) * 0.6
	light.Range = range or 8
	light.Shadows = false
	light.Parent = p
	return light
end

-- Texture-less sparkle emitter (uses the engine's default particle).
function Build.sparkle(p: BasePart, color: Color3, rate: number?): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = "Sparkles"
	e.Color = ColorSequence.new(color, WHITE)
	e.LightEmission = 0.45
	e.LightInfluence = 0
	e.Rate = rate or 5
	e.Lifetime = NumberRange.new(0.8, 1.5)
	e.Speed = NumberRange.new(0.4, 1.2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.4, 0.3),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Parent = p
	return e
end

-- Uniformly scale every part about `origin` (call BEFORE weldAll).
function Build.scale(model: Model, origin: CFrame, s: number)
	if math.abs(s - 1) < 1e-4 then
		return
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local rel = origin:ToObjectSpace(d.CFrame)
			d.Size = d.Size * s
			d.CFrame = origin * CFrame.new(rel.Position * s) * rel.Rotation
		elseif d:IsA("PointLight") then
			d.Range = d.Range * s
		end
	end
end

-- Apply a rigid transform (about the world origin) to every part except `except`.
function Build.transform(model: Model, cf: CFrame, except: BasePart?)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= except then
			d.CFrame = cf * d.CFrame
		end
	end
end

-- WeldConstraint every BasePart to `root` (inert while anchored; ready for unanchoring).
function Build.weldAll(model: Model, root: BasePart)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = d
		end
	end
end

-- Mark everything except `root` massless (worn / held models).
function Build.massless(model: Model, root: BasePart)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			d.Massless = true
		end
	end
end

-- Text on a part face (SurfaceGui, no assets). The TextLabel is named "Label".
function Build.label(p: BasePart, face: Enum.NormalId, text: string, textColor: Color3?, strokeColor: Color3?)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "LabelGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.3
	local t = Instance.new("TextLabel")
	t.Name = "Label"
	t.Size = UDim2.fromScale(0.92, 0.86)
	t.Position = UDim2.fromScale(0.04, 0.07)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = textColor or WHITE
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = strokeColor or Color3.fromRGB(35, 30, 60)
	stroke.Parent = t
	t.Parent = gui
	gui.Parent = p
end

-- Count BaseParts (QA / budgets).
function Build.count(model: Model): number
	local n = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Consumables</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Consumables — drinks & snacks (Config.Consumables), ~1.5 studs tall, chunky cartoon style.
	PrimaryPart = invisible "Root" at the VISUAL CENTRE (like treasures) so ViewportFrames and
	hand-held / pop-up effects frame them without offsets. Front is -Z. Everything anchored,
	nothing collides.
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local ConsumableModels = {}

local V = Vector3.new
local CF = CFrame.new
local rgb = Color3.fromRGB
local PI = math.pi
local M = Enum.Material

local WHITE = rgb(255, 255, 255)
local RIND = rgb(60, 160, 70)
local RIND_DARK = rgb(35, 110, 50)
local SEED = rgb(35, 25, 30)

type Builder = (m: Model, color: Color3) -> ()

local builders: { [string]: Builder } = {}

-- All builders work in a box roughly 1.0 x 1.5 x 1.0 centred on the origin.

local function straw(m: Model, from: Vector3, to: Vector3, color: Color3)
	local n = 4
	for i = 0, n - 1 do
		local a = from:Lerp(to, i / n)
		local b = from:Lerp(to, (i + 1) / n)
		Build.cylBetween(m, "Straw", a, b, 0.09, if i % 2 == 0 then WHITE else color)
	end
end

builders.Bottle = function(m, color)
	Build.cyl(m, "Body", 1.0, 0.75, CF(0, -0.2, 0), color, M.Glass)
	Build.cyl(m, "Water", 0.8, 0.62, CF(0, -0.28, 0), Build.lighten(color, 0.3))
	Build.cyl(m, "Label", 0.34, 0.77, CF(0, -0.2, 0), WHITE)
	Build.label(Build.part(m, "LabelFace", V(0.4, 0.3, 0.02), CF(0, -0.2, -0.39), WHITE), Enum.NormalId.Front, "💧")
	Build.cyl(m, "Shoulder", 0.25, 0.55, CF(0, 0.42, 0), color, M.Glass)
	Build.cyl(m, "Neck", 0.2, 0.3, CF(0, 0.6, 0), color, M.Glass)
	Build.cyl(m, "Cap", 0.16, 0.36, CF(0, 0.74, 0), rgb(40, 120, 255))
end

builders.Cup = function(m, color)
	Build.cyl(m, "Cup", 1.1, 0.8, CF(0, -0.2, 0), WHITE)
	Build.cyl(m, "Band", 0.3, 0.82, CF(0, -0.2, 0), color)
	Build.cyl(m, "Drink", 0.06, 0.7, CF(0, 0.33, 0), color)
	-- lemon wheel on the rim
	local wheel = CF(0.32, 0.38, -0.2) * CFrame.Angles(PI / 2, 0, 0.3)
	Build.cyl(m, "Lemon", 0.1, 0.5, wheel, rgb(255, 220, 40))
	Build.cyl(m, "LemonPith", 0.11, 0.38, wheel, rgb(255, 250, 200))
	straw(m, V(-0.12, 0.0, 0.05), V(-0.3, 0.78, 0.15), rgb(255, 90, 120))
end

builders.Coconut = function(m, color)
	Build.ball(m, "Shell", 1.1, CF(0, -0.15, 0), color)
	Build.cyl(m, "Cut", 0.06, 0.62, CF(0, 0.37, 0), rgb(250, 245, 230))
	Build.cyl(m, "Milk", 0.07, 0.5, CF(0, 0.38, 0), WHITE)
	straw(m, V(0.05, 0.2, 0), V(0.3, 0.75, 0.05), rgb(60, 200, 255))
	-- tiny cocktail umbrella
	Build.cylBetween(m, "UmbrellaStick", V(-0.15, 0.3, 0.05), V(-0.35, 0.78, 0.1), 0.05, rgb(230, 200, 140))
	Build.spike(m, "Umbrella", V(-0.37, 0.72, 0.1), V(-0.4, 0.92, 0.11), 0.55, rgb(255, 110, 170))
	-- coconut "eyes"
	for side = -1, 1, 2 do
		Build.ball(m, "Dot", 0.14, CF(side * 0.16, 0.05, -0.5), Build.darken(color, 0.4))
	end
end

builders.Popsicle = function(m, color)
	local top = Build.lighten(color, 0.25)
	Build.part(m, "Pop", V(0.65, 0.85, 0.3), CF(0, 0.05, 0), color)
	Build.cyl(m, "PopTop", 0.3, 0.65, CF(0, 0.475, 0) * CFrame.Angles(PI / 2, 0, 0), color)
	Build.part(m, "Stripe", V(0.67, 0.18, 0.32), CF(0, 0.2, 0), top)
	Build.part(m, "Stripe", V(0.67, 0.18, 0.32), CF(0, -0.15, 0), rgb(255, 230, 90))
	Build.part(m, "Stick", V(0.16, 0.55, 0.08), CF(0, -0.6, 0), rgb(230, 200, 140), M.Wood)
	Build.ball(m, "Drip", 0.14, CF(0.2, -0.38, -0.1), color)
end

builders.ShavedIce = function(m, color)
	-- paper cone (point down)
	Build.spike(m, "Cone", V(0, 0.05, 0), V(0, -0.75, 0), 0.85, WHITE)
	Build.cyl(m, "Rim", 0.12, 0.8, CF(0, 0.08, 0), rgb(255, 120, 160))
	-- rainbow ice dome
	Build.ball(m, "Ice", 0.9, CF(0, 0.38, 0), WHITE, M.Ice)
	Build.ball(m, "Syrup", 0.62, CF(-0.18, 0.5, -0.12), color)
	Build.ball(m, "Syrup", 0.58, CF(0.2, 0.48, 0.1), rgb(255, 90, 140))
	Build.ball(m, "Syrup", 0.5, CF(0.02, 0.66, 0.12), rgb(255, 230, 80))
	Build.cylBetween(m, "Spoon", V(0.15, 0.4, -0.2), V(0.35, 0.9, -0.3), 0.08, rgb(255, 140, 40))
end

builders.Slice = function(m, color)
	local t = 0.45
	-- triangle wedge, apex down
	local flesh = CF(0, 0.05, 0) * CFrame.Angles(0, 0, PI)
	Build.tri(m, "Flesh", flesh, 1.5, 1.2, t, color)
	Build.part(m, "Pith", V(1.55, 0.1, t + 0.02), CF(0, 0.66, 0), rgb(240, 250, 220))
	Build.part(m, "Rind", V(1.6, 0.18, t + 0.04), CF(0, 0.78, 0), RIND)
	for _, p in { V(-0.35, 0.35, 0), V(0.35, 0.35, 0), V(0, 0.1, 0), V(-0.15, -0.2, 0), V(0.15, -0.2, 0) } do
		Build.ellipsoid(m, "Seed", V(0.09, 0.15, t + 0.06), CF(p), SEED)
	end
end

builders.Melon = function(m, color)
	local size = V(1.4, 1.2, 1.6)
	Build.ellipsoid(m, "Melon", size, CF(0, -0.05, 0), color)
	for k = 0, 4 do
		local a = k / 5 * PI
		Build.ellipsoid(
			m,
			"Stripe",
			V(0.16, size.Y * 1.02, size.Z * 1.02),
			CF(0, -0.05, 0) * CFrame.Angles(0, a, 0),
			RIND_DARK
		)
	end
	Build.cylBetween(m, "Stem", V(0, 0.5, 0), V(0.08, 0.72, 0.02), 0.12, rgb(120, 85, 50))
	Build.triPts(m, "Leaf", V(0.05, 0.62, 0), V(0.42, 0.7, -0.1), V(0, 0, 1), 0.3, 0.05, rgb(90, 200, 100))
end

-- Public --------------------------------------------------------------------------------------------

function ConsumableModels.Build(id: string): Model
	local def: Types.ConsumableDef? = Config.GetConsumable(id)
	local m = Build.model(id)
	Build.root(m, CFrame.identity, V(0.2, 0.2, 0.2))
	local look: { [string]: any } = if def then def.Look else {}
	local color: Color3 = if typeof(look.Color) == "Color3" then look.Color else rgb(255, 235, 90)
	local style = if type(look.Style) == "string" then look.Style else "Cup"
	local builder = builders[style] or builders.Cup
	builder(m, color)
	m:SetAttribute("ConsumableId", id)
	return m
end

return ConsumableModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Diggers</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Diggers — chunky cartoon construction vehicles from primitives (no asset ids), one builder per
	vehicle Kind. Roughly 3-6 studs long at scale 1.

	v2.1: the Garage diggers became vehicle PETS (Config/Pets.luau, PetDef.VehicleKind = the Kind
	here, colours from PetDef.Look). Models.Pet(id) draws vehicle pets through Diggers.Build(id,
	Look.Size). The Ride agent may reuse these builders read-only (Diggers.FromLook / Kinds).

	API:
	  Diggers.Build(id, scale?)               id = a vehicle pet id (or a Kind name); scale default 1
	  Diggers.FromLook(name, look, scale?)    look = { Kind, Body: Color3, Accent: Color3, Glow }
	  Diggers.Kinds(): { string }             every Kind with a dedicated builder

	Conventions (Models/Build.luau):
	- PrimaryPart = invisible "Root" at the bottom-centre (pivot on the ground), front = -Z.
	- Every part Anchored, CanCollide / CanQuery / CanTouch false, so a digger never blocks the
	  dig raycasts or players. Static parts are welded to Root (inert while anchored).
	- Moving assemblies are sub-Models with an invisible PrimaryPart "Hinge" (NOT welded) and
	  the attributes the client animator reads:
	      Motion  "Swing"  rotate about the hinge's X axis by Amount * sin(pi * t)  (arms, buckets)
	              "Tip"    same as Swing, slower ease (dump beds)
	              "Spin"   rotate about the hinge's Y axis, Amount radians per second while digging
	              "Drill"  Spin + plunge along the hinge's +Y by Plunge studs * sin(pi * t)
	  Drill / Spin hinges have their Y axis along the bit (pointing where it digs).
	      Amount  number   radians (Swing / Tip) or radians per second (Spin / Drill)
	      Plunge  number?  studs (Drill)
	  Names: "Arm", "Loader", "Bed", "Blade", "Drill", "Cutter".
	- Model attributes "Kind" = Look.Kind and "Scale" = the build scale (Plunge is pre-scaled).
]]

local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Diggers = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis
local Y = Vector3.yAxis
local Z = Vector3.zAxis
local WHITE = Color3.new(1, 1, 1)
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local GLASS = Enum.Material.Glass

local TYRE = Color3.fromRGB(40, 38, 45)
local HUB = Color3.fromRGB(200, 200, 210)
local WINDOW = Color3.fromRGB(150, 220, 255)
local STEEL = Color3.fromRGB(150, 155, 165)
local SAND = Color3.fromRGB(240, 205, 130)

type Ctx = {
	m: Model,
	B: Color3, -- body
	A: Color3, -- accent
	am: Enum.Material, -- accent material (Neon when Glow)
	glow: boolean,
}

type KindBuilder = (c: Ctx) -> BasePart -- returns the main body part (for glow / sparkles)

local kinds: { [string]: KindBuilder } = {}

-- Helpers -----------------------------------------------------------------------------------

-- Moving sub-assembly. Parts built into the returned model are animated around `hinge`.
local function joint(parent: Instance, name: string, hinge: CFrame, motion: string, amount: number): Model
	local j = Instance.new("Model")
	j.Name = name
	local h = Build.part(j, "Hinge", V(0.2, 0.2, 0.2), hinge, WHITE)
	h.Transparency = 1
	h.CastShadow = false
	j.PrimaryPart = h
	j:SetAttribute("Motion", motion)
	j:SetAttribute("Amount", amount)
	j.Parent = parent
	return j
end

local function wheel(parent: Instance, pos: Vector3, diameter: number, width: number, hubColor: Color3?)
	Build.cyl(parent, "Wheel", width, diameter, Build.orient(pos, X), TYRE)
	local side = if pos.X >= 0 then 1 else -1
	Build.cyl(
		parent,
		"Hub",
		0.08,
		diameter * 0.5,
		Build.orient(pos + V(side * width / 2, 0, 0), X),
		hubColor or HUB,
		METAL
	)
end

-- Crawler track along Z at x, bottom on the ground.
local function track(parent: Instance, x: number, length: number, height: number, width: number)
	local y = height / 2
	Build.part(parent, "Track", V(width, height, length - height), CF(x, y, 0), TYRE)
	for _, z in { -(length - height) / 2, (length - height) / 2 } do
		Build.cyl(parent, "Track", width, height, Build.orient(V(x, y, z), X), TYRE)
	end
	local side = if x >= 0 then 1 else -1
	local n = math.max(2, math.floor(length / 1.1))
	for i = 0, n - 1 do
		local z = -(length - height) / 2 + (length - height) * i / (n - 1)
		Build.cyl(parent, "Roller", 0.06, height * 0.55, Build.orient(V(x + side * width / 2, y, z), X), STEEL, METAL)
	end
end

-- Cab box with windows on front and sides and a pair of cartoon eyes on the windshield.
local function cab(parent: Instance, centre: Vector3, size: Vector3, color: Color3, eyes: boolean?)
	Build.part(parent, "Cab", size, CF(centre), color)
	Build.part(parent, "Roof", V(size.X + 0.2, 0.18, size.Z + 0.2), CF(centre + V(0, size.Y / 2 + 0.09, 0)), color)
	local wy = centre.Y + size.Y * 0.12
	local frontZ = centre.Z - size.Z / 2
	Build.part(parent, "Window", V(size.X * 0.8, size.Y * 0.5, 0.06), CF(centre.X, wy, frontZ - 0.02), WINDOW, GLASS)
	for side = -1, 1, 2 do
		Build.part(
			parent,
			"Window",
			V(0.06, size.Y * 0.5, size.Z * 0.7),
			CF(centre.X + side * (size.X / 2 + 0.02), wy, centre.Z),
			WINDOW,
			GLASS
		)
	end
	if eyes ~= false then
		Build.face(parent, CF(centre.X, wy, frontZ - 0.06), math.min(size.X, size.Y) * 0.75, {
			mouth = false,
			cheeks = false,
		})
	end
end

-- Spiral-looking drill bit along the Y axis of `base` (base of the bit at its origin).
local function drillBit(
	parent: Instance,
	base: CFrame,
	length: number,
	diameter: number,
	c1: Color3,
	c2: Color3,
	mat: Enum.Material?
)
	local steps = 4
	local seg = length * 0.75 / steps
	for i = 0, steps - 1 do
		local d = diameter * (1 - i / (steps + 0.6))
		Build.cyl(
			parent,
			"Drill",
			seg,
			d,
			base * CF(0, seg * (i + 0.5), 0) * CFrame.Angles(0, i * 0.6, 0),
			if i % 2 == 0 then c1 else c2,
			if i % 2 == 0 then METAL else mat
		)
	end
	local tipBase = (base * CF(0, length * 0.75, 0)).Position
	local tip = (base * CF(0, length, 0)).Position
	Build.spike(parent, "DrillTip", tipBase, tip, diameter * (1 - steps / (steps + 0.6)) * 1.1, c1, METAL)
end

local function exhaust(parent: Instance, pos: Vector3, height: number)
	Build.cyl(parent, "Exhaust", height, 0.22, CF(pos + V(0, height / 2, 0)), Color3.fromRGB(70, 70, 80), METAL)
	Build.cyl(parent, "Exhaust", 0.08, 0.3, CF(pos + V(0, height, 0)), Color3.fromRGB(40, 40, 45), METAL)
end

local function beacon(parent: Instance, pos: Vector3)
	Build.ball(parent, "Beacon", 0.32, CF(pos), Color3.fromRGB(255, 160, 30), NEON)
end

-- Kinds -------------------------------------------------------------------------------------

kinds.ToyTruck = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.part(m, "Body", V(1.9, 0.5, 3.2), CF(0, 0.75, 0), B)
	for _, z in { -1.05, 1.05 } do
		for side = -1, 1, 2 do
			wheel(m, V(side * 1.0, 0.45, z), 0.9, 0.36)
		end
	end
	cab(m, V(0, 1.45, -0.95), V(1.6, 1.0, 1.1), A)
	Build.part(m, "Bumper", V(1.9, 0.25, 0.2), CF(0, 0.65, -1.65), Color3.fromRGB(255, 255, 255))
	-- tipping bed with a pile of sand, hinge at the rear bottom edge
	local bed = joint(m, "Bed", CF(0, 1.0, 1.55), "Tip", 0.55)
	Build.part(bed, "Bed", V(1.8, 0.12, 1.9), CF(0, 1.06, 0.6), A)
	for side = -1, 1, 2 do
		Build.part(bed, "Bed", V(0.12, 0.55, 1.9), CF(side * 0.84, 1.33, 0.6), A)
	end
	Build.part(bed, "Bed", V(1.8, 0.55, 0.12), CF(0, 1.33, -0.29), A)
	Build.part(bed, "Bed", V(1.8, 0.55, 0.12), CF(0, 1.33, 1.49), A)
	Build.ellipsoid(bed, "Sand", V(1.5, 0.7, 1.5), CF(0, 1.3, 0.6), SAND, Enum.Material.Sand)
	return body
end

kinds.DumpTruck = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.part(m, "Body", V(2.3, 0.55, 4.4), CF(0, 0.95, 0), A)
	for _, z in { -1.5, 0.8, 1.6 } do
		for side = -1, 1, 2 do
			wheel(m, V(side * 1.15, 0.6, z), 1.2, 0.45)
		end
	end
	Build.part(m, "Hood", V(2.1, 0.8, 0.9), CF(0, 1.6, -1.75), B)
	Build.part(m, "Grille", V(1.6, 0.5, 0.06), CF(0, 1.55, -2.22), Color3.fromRGB(60, 60, 70), METAL)
	cab(m, V(0, 2.25, -0.95), V(2.0, 1.2, 1.0), B)
	beacon(m, V(0, 2.98, -0.95))
	local bed = joint(m, "Bed", CF(0, 1.25, 2.15), "Tip", 0.6)
	Build.part(bed, "Bed", V(2.3, 0.16, 2.6), CF(0, 1.33, 0.85), B)
	for side = -1, 1, 2 do
		Build.part(bed, "Bed", V(0.16, 0.95, 2.6), CF(side * 1.07, 1.85, 0.85), B)
	end
	Build.part(bed, "Bed", V(2.3, 1.15, 0.16), CF(0, 1.95, -0.37), B)
	Build.wedge(bed, "Bed", V(2.3, 0.4, 0.6), CF(0, 2.7, -0.6) * CFrame.Angles(0, math.pi, 0), B)
	Build.part(bed, "Bed", V(2.3, 0.85, 0.12), CF(0, 1.8, 2.09), Build.darken(B, 0.15))
	Build.ellipsoid(bed, "Sand", V(1.9, 0.9, 2.2), CF(0, 2.15, 0.85), SAND, Enum.Material.Sand)
	return body
end

kinds.Excavator = function(c)
	local m, B, A = c.m, c.B, c.A
	for side = -1, 1, 2 do
		track(m, side * 0.95, 3.4, 0.75, 0.6)
	end
	Build.part(m, "Turntable", V(1.4, 0.2, 1.4), CF(0, 0.85, 0.1), A, METAL)
	local body = Build.part(m, "Body", V(2.2, 0.9, 2.4), CF(0, 1.4, 0.35), B)
	Build.part(m, "Counterweight", V(2.2, 0.7, 0.5), CF(0, 1.3, 1.65), A)
	cab(m, V(-0.5, 2.35, -0.25), V(1.1, 1.1, 1.1), B)
	exhaust(m, V(0.7, 1.85, 1.0), 0.6)
	-- boom + stick + bucket swing about the boom foot
	local arm = joint(m, "Arm", CF(0.45, 1.7, -0.75), "Swing", -0.5)
	local foot = V(0.45, 1.7, -0.75)
	local elbow = V(0.45, 3.1, -2.1)
	local wrist = V(0.45, 1.3, -3.0)
	Build.beam(arm, "Boom", foot, elbow, 0.45, 0.4, B, SMOOTH, X)
	Build.beam(arm, "Stick", elbow, wrist, 0.35, 0.32, B, SMOOTH, X)
	Build.cylBetween(arm, "Piston", foot + V(0, 0.3, 0.1), elbow + V(0, -0.4, 0.35), 0.16, STEEL, METAL)
	Build.ball(arm, "Elbow", 0.45, CF(elbow), A, METAL)
	local bucket = CF(wrist) * CFrame.Angles(-0.5, 0, 0)
	Build.part(arm, "Bucket", V(0.9, 0.12, 0.8), bucket * CF(0, -0.35, -0.1), A, METAL)
	Build.part(arm, "Bucket", V(0.9, 0.7, 0.12), bucket * CF(0, 0, 0.3), A, METAL)
	for side = -1, 1, 2 do
		Build.part(arm, "Bucket", V(0.1, 0.7, 0.8), bucket * CF(side * 0.45, 0, -0.1), A, METAL)
	end
	for i = -1, 1 do
		Build.spike(
			arm,
			"Tooth",
			(bucket * CF(i * 0.28, -0.4, -0.45)).Position,
			(bucket * CF(i * 0.28, -0.45, -0.75)).Position,
			0.14,
			STEEL,
			METAL
		)
	end
	return body
end

kinds.SkidSteer = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.part(m, "Body", V(1.9, 1.0, 2.4), CF(0, 1.0, 0.3), B)
	for _, z in { -0.55, 1.05 } do
		for side = -1, 1, 2 do
			wheel(m, V(side * 1.1, 0.55, z), 1.1, 0.42)
		end
	end
	cab(m, V(0, 2.1, 0.15), V(1.4, 1.2, 1.3), A)
	Build.part(m, "Engine", V(1.7, 0.5, 0.7), CF(0, 1.75, 1.2), B)
	exhaust(m, V(0.55, 2.0, 1.3), 0.45)
	-- lift arms + bucket pivot behind the cab
	local hinge = V(0, 2.3, 1.1)
	local arm = joint(m, "Arm", CF(hinge), "Swing", -0.35)
	for side = -1, 1, 2 do
		Build.beam(arm, "LiftArm", V(side * 0.95, 2.3, 1.1), V(side * 0.95, 0.85, -1.15), 0.18, 0.3, B, SMOOTH, Z)
	end
	local bucket = CF(0, 0.6, -1.45)
	Build.part(arm, "Bucket", V(2.1, 0.12, 0.8), bucket * CF(0, -0.3, 0), STEEL, METAL)
	Build.part(arm, "Bucket", V(2.1, 0.8, 0.12), bucket * CF(0, 0.05, 0.4), STEEL, METAL)
	for side = -1, 1, 2 do
		Build.part(arm, "Bucket", V(0.1, 0.6, 0.8), bucket * CF(side * 1.05, -0.05, 0), STEEL, METAL)
	end
	Build.ellipsoid(arm, "Sand", V(1.6, 0.45, 0.6), bucket * CF(0, -0.15, 0.05), SAND, Enum.Material.Sand)
	return body
end

kinds.Bulldozer = function(c)
	local m, B, A = c.m, c.B, c.A
	for side = -1, 1, 2 do
		track(m, side * 1.05, 3.8, 0.9, 0.7)
	end
	local body = Build.part(m, "Body", V(1.7, 1.1, 3.0), CF(0, 1.45, 0.2), B)
	Build.part(m, "Hood", V(1.5, 0.35, 1.5), CF(0, 2.15, -0.55), B)
	cab(m, V(0, 2.6, 0.95), V(1.6, 1.2, 1.2), B)
	exhaust(m, V(0.5, 2.3, -0.9), 0.7)
	beacon(m, V(0.55, 3.35, 1.3))
	-- blade on push arms, hinged at the track middle
	local blade = joint(m, "Blade", CF(0, 0.9, 0.2), "Swing", -0.22)
	for side = -1, 1, 2 do
		Build.beam(blade, "PushArm", V(side * 1.5, 0.9, 0.2), V(side * 1.5, 0.75, -2.1), 0.18, 0.28, A, SMOOTH, Z)
	end
	Build.part(blade, "Blade", V(3.4, 1.3, 0.22), CF(0, 0.95, -2.25) * CFrame.Angles(0.15, 0, 0), B)
	Build.part(blade, "BladeEdge", V(3.4, 0.16, 0.3), CF(0, 0.22, -2.35), STEEL, METAL)
	for side = -1, 1, 2 do
		Build.part(blade, "BladeSide", V(0.12, 1.2, 0.5), CF(side * 1.7, 0.95, -2.1), B)
	end
	-- rear ripper
	Build.beam(m, "Ripper", V(0, 1.2, 1.8), V(0, 0.35, 2.3), 0.22, 0.22, A, METAL, X)
	return body
end

kinds.Backhoe = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.part(m, "Body", V(1.9, 0.8, 3.6), CF(0, 1.15, 0), B)
	wheel(m, V(-1.05, 0.55, -1.1), 1.1, 0.45)
	wheel(m, V(1.05, 0.55, -1.1), 1.1, 0.45)
	wheel(m, V(-1.05, 0.8, 1.0), 1.6, 0.5)
	wheel(m, V(1.05, 0.8, 1.0), 1.6, 0.5)
	Build.part(m, "Hood", V(1.5, 0.6, 1.3), CF(0, 1.85, -1.1), B)
	cab(m, V(0, 2.35, 0.55), V(1.7, 1.4, 1.4), B)
	exhaust(m, V(0.5, 2.15, -1.3), 0.6)
	beacon(m, V(0, 3.2, 0.55))
	-- front loader
	local loader = joint(m, "Loader", CF(0, 1.9, -0.3), "Swing", 0.3)
	for side = -1, 1, 2 do
		Build.beam(loader, "LoaderArm", V(side * 1.0, 1.9, -0.3), V(side * 1.0, 0.75, -2.3), 0.16, 0.26, A, SMOOTH, Z)
	end
	Build.part(loader, "Loader", V(2.2, 0.75, 0.14), CF(0, 0.75, -2.5), STEEL, METAL)
	Build.part(loader, "Loader", V(2.2, 0.12, 0.6), CF(0, 0.4, -2.3), STEEL, METAL)
	-- rear arm (the "hoe")
	local arm = joint(m, "Arm", CF(0, 1.5, 1.85), "Swing", 0.45)
	local foot = V(0, 1.5, 1.85)
	local elbow = V(0, 2.9, 2.9)
	local wrist = V(0, 1.0, 3.5)
	Build.beam(arm, "Boom", foot, elbow, 0.35, 0.32, A, SMOOTH, X)
	Build.beam(arm, "Stick", elbow, wrist, 0.3, 0.28, A, SMOOTH, X)
	Build.ball(arm, "Elbow", 0.4, CF(elbow), B, METAL)
	local bucket = CF(wrist) * CFrame.Angles(0.5, math.pi, 0)
	Build.part(arm, "Bucket", V(0.7, 0.1, 0.6), bucket * CF(0, -0.3, -0.1), STEEL, METAL)
	Build.part(arm, "Bucket", V(0.7, 0.6, 0.1), bucket * CF(0, 0, 0.2), STEEL, METAL)
	for side = -1, 1, 2 do
		Build.part(arm, "Bucket", V(0.08, 0.6, 0.6), bucket * CF(side * 0.35, 0, -0.1), STEEL, METAL)
	end
	return body
end

kinds.DrillRig = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.part(m, "Body", V(2.1, 0.6, 3.8), CF(0, 0.95, 0.2), Color3.fromRGB(70, 70, 80))
	for _, z in { -1.2, 0.6, 1.5 } do
		for side = -1, 1, 2 do
			wheel(m, V(side * 1.1, 0.6, z), 1.2, 0.45)
		end
	end
	cab(m, V(0, 1.9, 1.3), V(1.9, 1.3, 1.2), B)
	-- mast
	for side = -1, 1, 2 do
		Build.part(m, "Mast", V(0.18, 4.6, 0.18), CF(side * 0.45, 3.4, -1.5), A, METAL)
	end
	for i = 0, 5 do
		Build.part(m, "Rung", V(0.9, 0.1, 0.1), CF(0, 1.5 + i * 0.75, -1.5), A, METAL)
	end
	Build.part(m, "MastTop", V(1.2, 0.35, 0.6), CF(0, 5.8, -1.5), B)
	beacon(m, V(0, 6.1, -1.5))
	Build.part(m, "Motor", V(0.8, 0.7, 0.7), CF(0, 2.35, -1.5), B)
	local drill = joint(m, "Drill", CFrame.fromMatrix(V(0, 1.95, -1.5), X, -Y), "Drill", 14)
	drill:SetAttribute("Plunge", 0.8)
	Build.cyl(drill, "Shaft", 1.0, 0.25, CF(0, 1.5, -1.5), STEEL, METAL)
	drillBit(drill, CFrame.fromMatrix(V(0, 1.15, -1.5), X, -Y), 1.1, 0.7, STEEL, B)
	return body
end

kinds.MiningDrill = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	-- mine cart body with metal bands on little rail wheels
	local body = Build.part(m, "Body", V(2.0, 1.3, 2.8), CF(0, 1.2, 0.4), B, Enum.Material.WoodPlanks)
	for _, z in { -0.6, 0.4, 1.4 } do
		Build.part(m, "Band", V(2.08, 1.36, 0.14), CF(0, 1.2, z), STEEL, METAL)
	end
	Build.part(m, "Rim", V(2.1, 0.14, 2.9), CF(0, 1.9, 0.4), STEEL, METAL)
	Build.ellipsoid(m, "Ore", V(1.6, 0.8, 2.2), CF(0, 1.9, 0.5), Color3.fromRGB(120, 110, 105), Enum.Material.Slate)
	for _, p in { V(-0.4, 2.2, 0.2), V(0.45, 2.15, 0.9), V(0.1, 2.25, -0.2) } do
		Build.ball(m, "Gem", 0.35, CF(p), A, am)
	end
	for _, z in { -0.5, 1.3 } do
		for side = -1, 1, 2 do
			wheel(m, V(side * 0.85, 0.35, z), 0.7, 0.25, A)
		end
	end
	Build.part(m, "Nose", V(1.6, 1.1, 0.5), CF(0, 1.15, -1.2), STEEL, METAL)
	beacon(m, V(0.7, 2.05, -0.9))
	-- forward drill tilted slightly down
	local axis = V(0, -0.25, -1).Unit
	local drill = joint(m, "Drill", Build.orient(V(0, 1.1, -1.45), axis, X), "Spin", 12)
	drillBit(drill, Build.orient(V(0, 1.1, -1.45), axis, X), 1.6, 1.0, STEEL, A, am)
	return body
end

kinds.TunnelBorer = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	for side = -1, 1, 2 do
		track(m, side * 1.0, 3.6, 0.7, 0.55)
	end
	local body = Build.cyl(m, "Body", 3.4, 2.3, Build.orient(V(0, 1.85, 0.3), Z), B)
	for _, z in { -0.6, 0.6, 1.6 } do
		Build.cyl(m, "Ring", 0.18, 2.45, Build.orient(V(0, 1.85, z), Z), A, am)
	end
	Build.part(m, "Hatch", V(0.9, 0.3, 1.0), CF(0, 3.05, 0.8), Build.darken(B, 0.2))
	beacon(m, V(0, 3.3, 0.8))
	-- round cutter face spinning about the body axis
	local face = Build.orient(V(0, 1.85, -1.5), -Z, X)
	local cutter = joint(m, "Cutter", face, "Spin", 6)
	Build.cyl(cutter, "Cutter", 0.3, 2.6, face, STEEL, METAL)
	Build.cyl(cutter, "Cutter", 0.2, 0.7, face * CF(0, 0.22, 0), A, am)
	for k = 0, 5 do
		local a = k * math.pi / 3
		local dir = (face * CFrame.Angles(0, a, 0)).RightVector
		local base = face.Position + dir * 0.9 - Z * 0.15
		Build.spike(cutter, "Tooth", base, base - Z * 0.45, 0.3, STEEL, METAL)
		Build.beam(cutter, "Spoke", face.Position - Z * 0.17, face.Position + dir * 1.2 - Z * 0.17, 0.18, 0.1, A, am, Z)
	end
	return body
end

kinds.Mole = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	for side = -1, 1, 2 do
		track(m, side * 0.9, 3.2, 0.6, 0.5)
	end
	local body = Build.ellipsoid(m, "Body", V(2.4, 2.0, 3.4), CF(0, 1.6, 0.3), B, METAL)
	Build.ellipsoid(m, "Belly", V(1.8, 1.2, 2.4), CF(0, 1.3, -0.1), Build.lighten(B, 0.25))
	Build.ellipsoid(m, "Head", V(1.6, 1.4, 1.5), CF(0, 1.8, -1.2), B, METAL)
	Build.ball(m, "Nose", 0.45, CF(0, 1.7, -1.98), Color3.fromRGB(255, 130, 170))
	Build.face(m, CF(0, 2.05, -1.86), 0.9, { mouth = false, radius = 0.75 })
	-- Keep the visor above the eye spheres and their highlights; a matte brow avoids neon bloom.
	Build.part(m, "Visor", V(1.2, 0.18, 0.4), CF(0, 2.44, -1.7), Build.darken(A, 0.12), SMOOTH)
	Build.cylBetween(m, "Antenna", V(0.3, 2.5, 0.2), V(0.45, 3.3, 0.4), 0.08, STEEL, METAL)
	Build.ball(m, "AntennaTip", 0.25, CF(0.45, 3.35, 0.4), A, am)
	for side = -1, 1, 2 do
		Build.ellipsoid(m, "Ear", V(0.5, 0.5, 0.2), CF(side * 0.6, 2.5, -1.0), B)
		local axis = V(side * 0.2, -0.3, -1).Unit
		local base = Build.orient(V(side * 1.05, 1.2, -1.3), axis, X)
		local drill = joint(m, "Drill", base, "Spin", 14)
		Build.cyl(drill, "Shoulder", 0.3, 0.6, base, A, am)
		drillBit(drill, base, 1.2, 0.6, STEEL, A, am)
	end
	return body
end

kinds.LavaDrill = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	for side = -1, 1, 2 do
		track(m, side * 1.15, 4.0, 0.9, 0.7)
	end
	local body = Build.part(m, "Body", V(2.0, 1.3, 3.2), CF(0, 1.55, 0.5), B, Enum.Material.Basalt)
	for _, z in { -0.4, 0.5, 1.4 } do
		Build.part(m, "LavaStripe", V(2.06, 0.18, 0.2), CF(0, 1.7, z), A, am)
	end
	Build.part(m, "Tank", V(1.4, 0.9, 1.2), CF(0, 2.6, 1.4), Build.darken(B, 0.2), Enum.Material.CrackedLava)
	cab(m, V(0, 2.75, 0.0), V(1.6, 1.1, 1.1), B)
	exhaust(m, V(-0.6, 2.2, 1.9), 1.0)
	exhaust(m, V(0.6, 2.2, 1.9), 1.0)
	-- frame holding a big downward-angled drill at the front
	for side = -1, 1, 2 do
		Build.beam(m, "Frame", V(side * 0.7, 2.0, -1.0), V(side * 0.7, 2.6, -2.0), 0.22, 0.22, A, am, X)
	end
	Build.part(m, "DrillHead", V(1.6, 0.8, 0.8), CF(0, 2.5, -2.1), B, METAL)
	local base = Build.orient(V(0, 2.1, -2.3), V(0, -1, -0.45).Unit, X)
	local drill = joint(m, "Drill", base, "Drill", 16)
	drill:SetAttribute("Plunge", 0.5)
	drillBit(drill, base, 2.1, 1.1, Color3.fromRGB(90, 80, 80), A, am)
	return body
end

kinds.CoreDriller = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	for side = -1, 1, 2 do
		track(m, side * 1.25, 4.4, 1.0, 0.75)
	end
	local body = Build.part(m, "Body", V(2.2, 1.4, 3.4), CF(0, 1.7, 0.6), B, METAL)
	for side = -1, 1, 2 do
		Build.wedge(m, "Fin", V(0.15, 0.9, 1.4), CF(side * 1.12, 2.8, 1.8), A, am)
	end
	cab(m, V(0, 3.0, 0.4), V(1.7, 1.2, 1.3), B)
	Build.ball(m, "Orb", 0.7, CF(0, 3.9, 1.4), A, am)
	for side = -1, 1, 2 do
		Build.beam(m, "Frame", V(side * 0.8, 2.0, -0.9), V(side * 0.8, 2.6, -2.2), 0.25, 0.25, B, METAL, X)
	end
	Build.cyl(m, "DrillHousing", 0.9, 1.6, Build.orient(V(0, 2.4, -2.2), V(0, -1, -0.5).Unit, X), B, METAL)
	local base = Build.orient(V(0, 2.0, -2.45), V(0, -1, -0.5).Unit, X)
	local drill = joint(m, "Drill", base, "Drill", 18)
	drill:SetAttribute("Plunge", 0.6)
	drillBit(drill, base, 2.4, 1.3, B, A, am)
	for k = 1, 3 do
		Build.cyl(drill, "DrillRing", 0.12, 1.3 * (1 - k * 0.2) + 0.15, base * CF(0, 0.45 * k, 0), A, am)
	end
	return body
end

export type VehicleLook = {
	Kind: string,
	Body: Color3,
	Accent: Color3,
	Glow: boolean,
}

local FALLBACK_LOOK: VehicleLook =
	{ Kind = "ToyTruck", Body = Color3.fromRGB(255, 210, 50), Accent = Color3.fromRGB(240, 70, 70), Glow = false }

-- Builder -----------------------------------------------------------------------------------

function Diggers.FromLook(name: string, look: VehicleLook, scale: number?): Model
	local kind = look.Kind
	local glow = look.Glow == true
	local s = math.clamp(scale or 1, 0.2, 5)

	local m = Build.model(name)
	m:SetAttribute("Kind", kind)
	m:SetAttribute("Scale", s)
	local root = Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local ctx: Ctx = { m = m, B = look.Body, A = look.Accent, am = if glow then NEON else SMOOTH, glow = glow }
	local builder = kinds[kind] or kinds.ToyTruck
	local main = builder(ctx)
	if glow then
		Build.glow(main, look.Accent, 1, 9)
		Build.sparkle(main, look.Accent, 2)
	end
	if math.abs(s - 1) > 1e-4 then
		Build.scale(m, CFrame.identity, s)
		for _, d in m:GetDescendants() do
			if d:IsA("Model") and typeof(d:GetAttribute("Plunge")) == "number" then
				d:SetAttribute("Plunge", (d:GetAttribute("Plunge") :: number) * s)
			end
		end
	end

	-- Weld static parts only: hinge assemblies are re-posed by the client every frame.
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d ~= root and d:FindFirstAncestorWhichIsA("Model") == m then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = d
		end
	end
	return m
end

-- `id` = a vehicle pet id (Config.GetPet(id).VehicleKind, colours from its Look), or a Kind name.
function Diggers.Build(id: string, scale: number?): Model
	local pet = Config.GetPet(id)
	local look: VehicleLook = FALLBACK_LOOK
	if pet and pet.VehicleKind then
		look = {
			Kind = pet.VehicleKind :: string,
			Body = pet.Look.BodyColor,
			Accent = pet.Look.AccentColor,
			Glow = pet.Look.Glow,
		}
	elseif kinds[id] then
		look = { Kind = id, Body = FALLBACK_LOOK.Body, Accent = FALLBACK_LOOK.Accent, Glow = false }
	end
	return Diggers.FromLook(id, look, scale)
end

-- Ids with a dedicated builder (QA / tests).
function Diggers.Kinds(): { string }
	local list = {}
	for kind in kinds do
		table.insert(list, kind)
	end
	table.sort(list)
	return list
end

return Diggers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Eggs</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Eggs — ~3 studs tall, PrimaryPart = invisible "Root" at the bottom-centre, front -Z.
	Pattern (spots or zig-zag band) is picked deterministically from the egg id.
	Glow -> Neon pattern + PointLight + sparkles. Main shell part is named "Shell".

	v2.1: Construction Crates (EggDef.Kind == "Crate") are chunky wooden / metal crates instead:
	~2.8 studs wide, plank box ("Shell", ShellColor) with a dark frame, steel corner brackets and a
	band of hazard tape (SpotColor / black). The lid is a sub-Model "Lid" (PrimaryPart "LidPlate",
	NOT welded to Root) so the hatch animation can pop it off. Model attribute "Crate" = true.
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Eggs = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis

local LOW_C, LOW_S = V(0, 1.2, 0), V(2.3, 2.4, 2.3)
local TOP_C, TOP_S = V(0, 1.65, 0), V(2.05, 2.6, 2.05)

local FALLBACK: Types.EggLook = {
	ShellColor = Color3.fromRGB(255, 245, 220),
	SpotColor = Color3.fromRGB(255, 150, 120),
	Glow = false,
}

-- Width (diameter) of the egg silhouette at height y.
local function widthAt(y: number): number
	local function w(c: Vector3, s: Vector3): number
		local rel = (y - c.Y) / (s.Y / 2)
		if math.abs(rel) >= 1 then
			return 0
		end
		return s.X * math.sqrt(1 - rel * rel)
	end
	return math.max(w(LOW_C, LOW_S), w(TOP_C, TOP_S))
end

local function build(id: string, look: Types.EggLook): Model
	local m = Build.model(id)
	local root = Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local shellMat = Enum.Material.SmoothPlastic
	local shell = Build.ellipsoid(m, "Shell", LOW_S, CF(LOW_C), look.ShellColor, shellMat)
	Build.ellipsoid(m, "ShellTop", TOP_S, CF(TOP_C), look.ShellColor, shellMat)
	local pm = if look.Glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local sc = look.SpotColor

	if Build.hash(id) % 2 == 0 then
		-- Spots
		local dirs = {
			V(0, 0.1, -1),
			V(0.85, 0.45, -0.4),
			V(-0.8, -0.2, -0.55),
			V(0.7, -0.35, 0.6),
			V(-0.6, 0.5, 0.65),
			V(0.1, 0.25, 1),
			V(-0.95, 0.15, 0.1),
			V(0.95, -0.05, 0.15),
		}
		for i, d in dirs do
			local size = if i % 3 == 0 then 0.42 else 0.6
			Build.ellipsoid(m, "Spot", V(size, size * 0.9, 0.14), Build.surface(LOW_C, LOW_S, d), sc, pm)
		end
		Build.ellipsoid(m, "Spot", V(0.5, 0.45, 0.14), Build.surface(TOP_C, TOP_S, V(0.3, 1, -0.35)), sc, pm)
	else
		-- Zig-zag band like a cracked shell
		local y = 1.45
		local d = widthAt(y) + 0.04
		Build.cyl(m, "Band", 0.38, d, CF(0, y, 0), sc, pm)
		local n = 8
		for k = 0, n - 1 do
			local a = (k + 0.5) / n * math.pi * 2
			local dir = V(math.sin(a), 0, -math.cos(a))
			local base = V(0, y + 0.17, 0) + dir * (widthAt(y + 0.17) / 2 - 0.02)
			local apexY = y + 0.55
			local apex = V(0, apexY, 0) + dir * (widthAt(apexY) / 2 - 0.02)
			Build.triPts(m, "Zig", base, apex, V(-dir.Z, 0, dir.X), 0.75, 0.08, sc, pm)
		end
		Build.ellipsoid(m, "Spot", V(0.55, 0.5, 0.14), Build.surface(TOP_C, TOP_S, V(0, 1, -0.2)), sc, pm)
	end

	Build.ellipsoid(
		m,
		"Shine",
		V(0.35, 0.6, 0.1),
		Build.surface(LOW_C, LOW_S, V(-0.55, 0.45, -0.7)),
		Build.lighten(look.ShellColor, 0.7)
	)

	if look.Glow then
		Build.glow(shell, sc, 1.2, 9)
		Build.sparkle(shell, sc, 4)
	end
	Build.weldAll(m, root)
	return m
end

-- Construction Crate ------------------------------------------------------------------------

local CRATE_W, CRATE_H = 2.8, 2.2
local BLACK = Color3.fromRGB(35, 35, 40)
local STEEL = Color3.fromRGB(165, 170, 182)

local function buildCrate(id: string, look: Types.EggLook): Model
	local m = Build.model(id)
	m:SetAttribute("Crate", true)
	local root = Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local metal = look.Glow
	local wood = if metal then Enum.Material.DiamondPlate else Enum.Material.WoodPlanks
	local frame = Build.darken(look.ShellColor, 0.35)
	local stripeMat = if look.Glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local w, h = CRATE_W, CRATE_H

	local shell = Build.part(m, "Shell", V(w, h, w), CF(0, h / 2, 0), look.ShellColor, wood)
	-- frame: vertical posts + top / bottom rims
	local e = 0.28
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Build.part(
				m,
				"Post",
				V(e, h + 0.04, e),
				CF(x * (w / 2 - e / 2 + 0.03), h / 2, z * (w / 2 - e / 2 + 0.03)),
				frame,
				wood
			)
			-- steel corner brackets top and bottom
			for _, y in { 0.2, h - 0.2 } do
				Build.part(
					m,
					"Bracket",
					V(e + 0.12, 0.32, e + 0.12),
					CF(x * (w / 2 - e / 2 + 0.03), y, z * (w / 2 - e / 2 + 0.03)),
					STEEL,
					Enum.Material.Metal
				)
			end
		end
	end
	for _, y in { 0.12, h - 0.12 } do
		for _, z in { -1, 1 } do
			Build.part(m, "Rim", V(w + 0.06, 0.24, e * 0.8), CF(0, y, z * (w / 2 + 0.02)), frame, wood)
			Build.part(m, "Rim", V(e * 0.8, 0.24, w + 0.06), CF(z * (w / 2 + 0.02), y, 0), frame, wood)
		end
	end
	-- diagonal braces on the sides and the back (the front carries the warning sign)
	for _, x in { -1, 1 } do
		local brace = Build.part(m, "Brace", V(0.12, h * 1.15, 0.24), CF(x * (w / 2 + 0.05), h / 2, 0), frame, wood)
		brace.CFrame = brace.CFrame * CFrame.Angles(math.rad(42), 0, 0)
	end
	local back = Build.part(m, "Brace", V(0.24, h * 1.15, 0.12), CF(0, h / 2, w / 2 + 0.05), frame, wood)
	back.CFrame = back.CFrame * CFrame.Angles(0, 0, math.rad(42))
	-- hazard tape band around the middle (alternating SpotColor / black blocks)
	local bandY = h * 0.62
	local n = 6
	local seg = w / n
	for face = 0, 3 do
		local yaw = CFrame.Angles(0, face * math.pi / 2, 0)
		for k = 0, n - 1 do
			local x = -w / 2 + seg * (k + 0.5)
			local color = if k % 2 == 0 then look.SpotColor else BLACK
			local mat = if k % 2 == 0 then stripeMat else Enum.Material.SmoothPlastic
			Build.part(m, "Tape", V(seg, 0.42, 0.08), yaw * CF(x, bandY, -(w / 2 + 0.1)), color, mat)
		end
	end
	-- stencilled warning triangle on the front
	Build.triPts(
		m,
		"Warning",
		V(0, h * 0.18, -(w / 2 + 0.1)),
		V(0, h * 0.46, -(w / 2 + 0.1)),
		X,
		0.6,
		0.06,
		look.SpotColor,
		stripeMat
	)

	-- lid (separate sub-Model so the hatch animation can pop it off)
	local lid = Instance.new("Model")
	lid.Name = "Lid"
	lid.Parent = m
	local plate = Build.part(lid, "LidPlate", V(w + 0.24, 0.3, w + 0.24), CF(0, h + 0.15, 0), frame, wood)
	lid.PrimaryPart = plate
	for _, x in { -0.8, 0, 0.8 } do
		Build.part(lid, "LidPlank", V(0.5, 0.12, w + 0.1), CF(x, h + 0.36, 0), look.ShellColor, wood)
	end
	Build.part(lid, "LidStripe", V(w + 0.1, 0.14, 0.4), CF(0, h + 0.38, 0), look.SpotColor, stripeMat)
	Build.part(lid, "Handle", V(0.9, 0.22, 0.22), CF(0, h + 0.55, 0), STEEL, Enum.Material.Metal)
	for _, d in lid:GetDescendants() do
		if d:IsA("BasePart") and d ~= plate then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = plate
			weld.Part1 = d
			weld.Parent = d
		end
	end

	if look.Glow then
		Build.glow(shell, look.SpotColor, 1.2, 9)
		Build.sparkle(shell, look.SpotColor, 4)
	end
	-- weld the static crate to Root (the Lid stays free)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d ~= root and d:FindFirstAncestorWhichIsA("Model") == m then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = d
			weld.Parent = d
		end
	end
	return m
end

function Eggs.Build(eggId: string): Model
	local def = Config.GetEgg(eggId)
	if def and def.Kind == "Crate" then
		return buildCrate(eggId, def.Look)
	end
	return build(eggId, if def then def.Look else FALLBACK)
end

-- A crate drawn from a look (previews / tests).
function Eggs.CrateFromLook(name: string, look: Types.EggLook): Model
	return buildCrate(name, look)
end

function Eggs.FromLook(name: string, look: Types.EggLook): Model
	return build(name, look)
end

return Eggs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Expansion1</string>
            <string name="Source"><![CDATA[--!strict
-- First-slice visual factories. No services, rewards, terrain edits or external asset IDs.
-- Bottom pivots for scenery; -Z front. Tools retain the existing Handle-space contract.
local Build = require(script.Parent.Build)
local Kit = {}
local V, CF = Vector3.new, CFrame.new
local rgb = Color3.fromRGB
local C = {
	Navy = rgb(29, 42, 68),
	Ink = rgb(27, 27, 36),
	Cream = rgb(255, 250, 232),
	Coral = rgb(255, 95, 125),
	Blue = rgb(40, 190, 245),
	Gold = rgb(255, 205, 40),
	Sand = rgb(255, 222, 140),
	Skin = rgb(222, 168, 118),
	Hair = rgb(80, 48, 35),
}
Kit.Palette = C
Kit.Spec = {
	Ability = { Charge = 0.8, Cooldown = 8, Range = 12, Corridor = V(12, 8, 8) },
	Vault = { Envelope = V(12, 10, 8), Anchors = 3, Gates = 3 },
	BallDiameter = 7.6, -- routine art choice, fits inside the vault; not the Core finale ball
	StandFootprint = V(2, 0, 2),
}

local function part(m: Instance, name: string, size: Vector3, pos: Vector3, color: Color3): Part
	return Build.part(m, name, size, CF(pos), color)
end

local function model(id: string): Model
	local m = Build.model(id)
	Build.root(m, CF())
	m:SetAttribute("EntityId", id)
	m:SetAttribute("VisualKitVersion", 1)
	return m
end

-- Kinematic block actors, deliberately separate from player avatars. Static dialogue poses
-- are factories; animation controller may interpolate limb groups later.
function Kit.NPC(id: string, pose: string?): Model
	assert(id == "npc_mara" or id == "npc_pip", "Unknown first-slice NPC")
	local m = model(id)
	local mara = id == "npc_mara"
	local outfit = if mara then C.Coral else C.Blue
	local p = pose or "Idle"
	assert(p == "Idle" or p == "Point" or p == "Celebrate", "Unknown dialogue pose")
	m:SetAttribute("Pose", p)
	m:SetAttribute("InteractionRange", 10)
	part(m, "Torso", V(2, 2, 1), V(0, 3, 0), if mara then outfit else C.Cream)
	for side = -1, 1, 2 do
		part(m, "Leg", V(0.9, 1.65, 0.9), V(side * 0.52, 1.075, 0), C.Navy)
		part(m, "Shoe", V(0.94, 0.35, 1.15), V(side * 0.52, 0.175, -0.08), C.Cream)
		local arm = Instance.new("Model")
		arm.Name = if side == -1 then "LeftArmPose" else "RightArmPose"
		arm.Parent = m
		local shoulder = V(side * 1.5, 3.75, 0)
		local sleeve =
			part(arm, "Sleeve", V(0.85, 1.2, 0.95), shoulder + V(0, -0.5, 0), if mara then outfit else C.Cream)
		part(arm, "Cuff", V(0.87, 0.16, 0.97), shoulder + V(0, -1.05, 0), C.Cream)
		part(arm, "Hand", V(0.8, 0.65, 0.9), shoulder + V(0, -1.43, 0), C.Skin)
		arm.PrimaryPart = sleeve
		local angle = if p == "Celebrate"
			then side * math.rad(140)
			else if p == "Point" and side == 1 then math.rad(90) else 0
		Build.transform(arm, CF(shoulder) * CFrame.Angles(0, 0, angle) * CF(-shoulder))
	end
	Build.cyl(m, "Head", 1.1, 1.45, CF(0, 4.55, 0), C.Skin)
	Build.face(m, CF(0, 4.6, -0.73), 1, { cheeks = false, eye = 0.2, spacing = 0.3 })
	part(m, "HairCap", V(1.5, 0.35, 1.45), V(0, 5.05, 0), C.Hair)
	if mara then
		Build.ball(m, "HairBun", 0.72, CF(0, 5.05, 0.75), C.Hair)
		for side = -1, 1, 2 do
			Build.beam(m, "Collar", V(side * 0.65, 3.9, -0.56), V(0, 3.45, -0.56), 0.18, 0.1, C.Cream)
			Build.cylBetween(m, "WhistleCord", V(side * 0.25, 3.9, -0.62), V(0, 3.2, -0.64), 0.045, C.Navy)
		end
		part(m, "Whistle", V(0.32, 0.16, 0.22), V(0, 3.16, -0.72), C.Gold)
	else
		part(m, "Apron", V(1.6, 2, 0.08), V(0, 2.85, -0.56), C.Blue)
		part(m, "ApronPocket", V(1.1, 0.55, 0.1), V(0, 2.55, -0.64), C.Navy)
		part(m, "ApronStrap", V(0.22, 0.45, 0.09), V(0, 3.95, -0.59), C.Cream)
		Build.cyl(m, "HugePencil", 1.6, 0.22, CF(0.47, 3.18, -0.74), C.Gold)
		part(m, "PencilEraser", V(0.24, 0.23, 0.24), V(0.47, 4.08, -0.74), C.Coral)
		Build.spike(m, "PencilTip", V(0.47, 2.38, -0.74), V(0.47, 2.08, -0.74), 0.22, C.Ink)
		part(m, "HairSweep", V(0.95, 0.3, 0.65), V(-0.3, 4.88, -0.52), C.Hair)
	end
	return m
end

function Kit.Broadwave(): Model
	local m = Build.model("tool_broadwave")
	m:SetAttribute("EntityId", "tool_broadwave")
	local handle = Build.cyl(m, "Handle", 1, 0.3, CF(0, 0.5, 0), C.Navy)
	Build.cyl(m, "Shaft", 1.15, 0.27, CF(0, 1.575, 0), C.Cream)
	Build.cyl(m, "LeftGrip", 0.55, 0.36, CF(0, 0.75, 0), C.Blue)
	for side = -1, 1, 2 do
		Build.beam(
			m,
			"GripCheek",
			V(side * 0.36, -0.42, 0),
			V(side * 0.08, 0.08, 0),
			0.14,
			0.16,
			C.Navy,
			nil,
			Vector3.zAxis
		)
	end
	Build.cylBetween(m, "GripBar", V(-0.45, -0.42, 0), V(0.45, -0.42, 0), 0.22, C.Navy)
	Build.cyl(m, "Collar", 0.3, 0.42, CF(0, 2.27, 0), C.Gold)
	part(m, "Blade", V(2.25, 1.1, 0.16), V(0, 2.95, 0), C.Blue)
	Build.ellipsoid(m, "BladeTip", V(2.25, 0.75, 0.16), CF(0, 3.46, 0), C.Blue)
	for side = -1, 1, 2 do
		part(m, "CupRim", V(0.14, 1.2, 0.3), V(side * 1.055, 2.99, 0.12), C.Navy)
	end
	-- Three cream crest dots: recognizable at inventory scale without tiny decal art.
	for i = -1, 1 do
		Build.ball(m, "FoamEmblem", 0.21, CF(i * 0.34, 3.12 + i * 0.06, 0.14), C.Cream)
	end
	local hcf = handle.CFrame
	local palm = CFrame.fromMatrix(V(0, -0.42, 0), Vector3.zAxis, -Vector3.xAxis, -Vector3.yAxis)
	handle:SetAttribute("GripOffset", hcf:ToObjectSpace(palm))
	handle:SetAttribute("TwoHanded", true)
	handle:SetAttribute("ShaftAxis", hcf:VectorToObjectSpace(Vector3.yAxis))
	handle:SetAttribute("CupAxis", hcf:VectorToObjectSpace(Vector3.zAxis))
	handle:SetAttribute("LeftHand", hcf:PointToObjectSpace(V(0, 0.75, 0)))
	handle:SetAttribute("BladePoint", hcf:PointToObjectSpace(V(0, 3.15, 0.2)))
	m.PrimaryPart = handle
	Build.massless(m, handle)
	Build.weldAll(m, handle)
	return m
end

-- The lid swings INSIDE the 12x10x8 envelope. Anchor shapes complement color.
function Kit.SpringVault(state: string?): Model
	local stage = state or "Covered"
	assert(stage == "Covered" or stage == "Partial" or stage == "Opened", "Unknown vault state")
	local m = model("landmark_spring_vault")
	m.Name ..= "_" .. stage
	m:SetAttribute("VisualState", stage)
	Build.solid(part(m, "Floor", V(12, 0.5, 8), V(0, 0.25, 0), C.Navy))
	for side = -1, 1, 2 do
		Build.solid(part(m, "SideWall", V(0.4, 4.5, 8), V(side * 5.8, 2.75, 0), C.Blue))
	end
	Build.solid(part(m, "BackWall", V(12, 4.5, 0.4), V(0, 2.75, 3.8), C.Blue))
	Build.solid(
		part(
			m,
			"FrontWall",
			V(12, if stage == "Opened" then 0.5 else 4.5, 0.4),
			V(0, if stage == "Opened" then 0.25 else 2.75, -3.8),
			C.Blue
		)
	)
	part(m, "AnchorRail", V(11.6, 0.3, 1.5), V(0, 5.25, -2.55), C.Navy)
	local lid = Instance.new("Model")
	lid.Name = "Lid"
	lid.Parent = m
	local plate = part(lid, "LidPlate", V(11.6, 0.45, 7.6), V(0, 5.15, 0), C.Coral)
	lid.PrimaryPart = plate
	for side = -1, 1, 2 do
		part(lid, "StripedHandle", V(1.9, 0.4, 0.5), V(side * 3.8, 5.57, -0.6), C.Navy)
		for i = -1, 1 do
			part(lid, "HandleStripe", V(0.3, 0.42, 0.52), V(side * 3.8 + i * 0.48, 5.57, -0.6), C.Cream)
		end
	end
	if stage == "Opened" then
		local hinge = V(0, 5.15, 3.7)
		Build.transform(lid, CF(hinge) * CFrame.Angles(math.rad(35), 0, 0) * CF(-hinge))
	end
	local latch = part(
		m,
		"Latch",
		V(1.3, if stage == "Opened" then 0.3 else 1.2, 0.35),
		V(0, if stage == "Opened" then 0.65 else 4.1, -3.8),
		C.Gold
	)
	latch:SetAttribute("ObjectiveId", "vault_latch")
	local hinge = Instance.new("Attachment")
	hinge.Name = "LidHinge"
	hinge.Position = V(0, 5.15, 3.7)
	hinge.Parent = m.PrimaryPart
	for i, x in { -3.7, 0, 3.7 } do
		local a = model("vault_anchor_" .. i)
		a.Parent = m
		a:SetAttribute("ObjectiveId", "vault_anchor_" .. i)
		a:SetAttribute("WorkRequiredSolo", 6)
		a:SetAttribute("WorkRequiredCrew", 8)
		a:SetAttribute("WorkRange", 12)
		a:SetAttribute("WorkCooldown", 0.5)
		local exposed = stage == "Opened" or (stage == "Partial" and i == 1)
		local base = part(a, "AnchorBase", V(2.5, 0.2, 1.5), V(x, 5.45, -2.55), C.Navy)
		base:SetAttribute("ProtectedGeometry", true)
		if i == 1 then
			Build.tri(
				a,
				"TriangleMarker",
				CF(x, 5.57, -2.55) * CFrame.Angles(-math.pi / 2, 0, 0),
				0.8,
				0.75,
				0.1,
				C.Cream
			)
		elseif i == 2 then
			part(a, "SquareMarker", V(0.65, 0.12, 0.65), V(x, 5.57, -2.55), C.Cream)
		else
			Build.cyl(a, "CircleMarker", 0.12, 0.7, CF(x, 5.57, -2.55), C.Cream)
		end
		if not exposed then
			local sand = part(
				a,
				"SandCover",
				V(2.3, if stage == "Covered" then 1.8 else 0.9, 1.4),
				V(x, if stage == "Covered" then 6.45 else 6, -2.55),
				C.Sand
			)
			sand:SetAttribute("RemovableVisual", true)
			-- Duplicate the marker above sand: players can read their target before uncovering.
			for _, d in a:GetChildren() do
				if d:IsA("BasePart") and string.find(d.Name, "Marker") then
					local top = d:Clone()
					top.Name = "Covered" .. d.Name
					top.CFrame += V(0, if stage == "Covered" then 1.9 else 1, 0)
					top.Parent = a
				end
			end
		end
		a:SetAttribute("VisualProgress", if exposed then 1 else if stage == "Partial" then 0.5 else 0)
	end
	if stage == "Covered" then
		part(m, "BurialSkirt", V(11.4, 3.4, 7.4), V(0, 2.4, 0), C.Sand)
	elseif stage == "Opened" then
		-- A visible toy spring explains the improbable compressed payload.
		for i = 0, 23 do
			local function coil(t: number): Vector3
				local angle = t * math.pi * 6
				return V(math.cos(angle) * 1.1, 0.65 + t * 1.9, math.sin(angle) * 1.1)
			end
			Build.cylBetween(m, "ToySpring", coil(i / 24), coil((i + 1) / 24), 0.16, C.Gold)
		end
	end
	return m
end

-- Anchored kinematic cargo: controller owns route, gate checks and safe resets.
function Kit.BeachBall(): Model
	local m = model("landmark_spring_vault_ball")
	m:SetAttribute("ParentEntityId", "landmark_spring_vault")
	m:SetAttribute("EventId", "event_vault")
	local d = Kit.Spec.BallDiameter
	local center = V(0, d / 2, 0)
	local sphere = Build.ball(m, "ContactSphere", d, CF(center), C.Cream)
	Build.solid(sphere)
	-- Same intersecting ellipsoid panel construction as the existing Props.BeachBall.
	for stripe, color in { C.Blue, C.Coral, C.Gold } do
		Build.ellipsoid(
			m,
			"ColorPanel",
			V(d + 0.06, d + 0.06, d * 0.65),
			CF(center) * CFrame.Angles(0, (stripe - 1) * math.pi / 3, 0),
			color
		)
	end
	Build.ball(m, "Cap", 0.6, CF(0, d - 0.18, 0), C.Cream)
	local a = Instance.new("Attachment")
	a.Name = "RollEffectOrigin"
	a.Parent = sphere
	m:SetAttribute("MovementMode", "ServerKinematic")
	return m
end

function Kit.TrophyStand(): Model
	local m = model("camp_trophy_stand")
	part(m, "Base", V(2, 0.25, 2), V(0, 0.125, 0), C.Navy)
	part(m, "Pedestal", V(1.6, 1.25, 1.6), V(0, 0.875, 0), C.Cream)
	part(m, "Top", V(2, 0.25, 2), V(0, 1.625, 0), C.Cream)
	part(m, "Plaque", V(0.8, 0.35, 0.06), V(0, 0.95, -0.83), C.Gold)
	local slot = Instance.new("Attachment")
	slot.Name = "TrophySlot"
	slot.Position = V(0, 1.75, 0)
	slot.Parent = m.PrimaryPart
	return m
end

-- Presentation-only quarter stages; authoritative work stays with the event service.
function Kit.SetAnchorProgress(anchor: Model, progress: number)
	local t = math.floor(math.clamp(progress, 0, 1) * 4) / 4
	anchor:SetAttribute("VisualProgress", t)
	local cover = anchor:FindFirstChild("SandCover")
	if cover and cover:IsA("BasePart") then
		local pivot = anchor:GetPivot()
		local localPos = pivot:PointToObjectSpace(cover.Position)
		local height = math.max(0.05, 1.8 * (1 - t))
		cover.Size = V(cover.Size.X, height, cover.Size.Z)
		cover.Position = pivot:PointToWorldSpace(V(localPos.X, 5.55 + height / 2, localPos.Z))
		cover.Transparency = if t == 1 then 1 else 0
		for _, d in anchor:GetChildren() do
			if d:IsA("BasePart") and string.sub(d.Name, 1, 7) == "Covered" then
				local markerPos = pivot:PointToObjectSpace(d.Position)
				d.Position = pivot:PointToWorldSpace(V(markerPos.X, 5.67 + height, markerPos.Z))
				d.Transparency = if t == 1 then 1 else 0
			end
		end
	end
end

function Kit.ChargeEffect(progress: number): Model
	local m = model("tool_broadwave_charge")
	local t = math.clamp(progress, 0, 1)
	for i = 1, 3 do
		local dot = Build.ball(m, "ChargeDot", 0.2, CF((i - 2) * 0.34, 3.12, 0.3), C.Cream)
		dot.Transparency = if t >= i / 3 then 0 else 0.7
	end
	return m
end

function Kit.TrophyReplica(): Model
	local m = Kit.BeachBall()
	Build.scale(m, CF(), 0.18)
	m.Name = "landmark_spring_vault_trophy"
	m:SetAttribute("EntityId", "landmark_spring_vault")
	m:SetAttribute("AssetVariant", "trophy_replica")
	m:SetAttribute("DisplayOnly", true)
	m:SetAttribute("MovementMode", "DisplayOnly")
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
		end
	end
	return m
end

-- Local presentation geometry only; caller animates normalized progress and destroys it.
-- Does not carve, award progress, grant sand or push players.
function Kit.AbilityEffect(progress: number, reducedMotion: boolean?): Model
	local m = model("tool_broadwave_effect")
	local t = math.clamp(progress, 0, 1)
	local z = -t * 8
	part(m, "Wave", V(12, if reducedMotion then 0.35 else 1.4, 0.25), V(0, 0.8, z), C.Blue).Transparency = 0.3
	for i = -3, 3 do
		Build.ellipsoid(m, "FoamCrest", V(1.4, 0.35, 0.4), CF(i * 1.65, 1.55, z), C.Cream)
	end
	return m
end

function Kit.BallEffect(reducedMotion: boolean?): Model
	local m = model("landmark_spring_vault_ball_effect")
	for i = 1, if reducedMotion then 4 else 8 do
		local count = if reducedMotion then 4 else 8
		local a = i / count * math.pi * 2
		Build.ellipsoid(m, "BouncePuff", V(0.9, 0.15, 0.5), CF(math.cos(a) * 4.2, 0.1, math.sin(a) * 4.2), C.Cream)
	end
	return m
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Pets</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Pets — cute low-poly creatures, one builder per Types.PetShape.
	Built at unit scale (~2-2.5 studs) then scaled by Look.Size about the bottom-centre.

	PrimaryPart = invisible "Root" at the bottom-centre (pivot), facing -Z (the pet's front).
	All parts Anchored, CanCollide/CanQuery false, welded to Root (client may unanchor).
	Glow -> Neon accents + PointLight. Legendary/Mythic -> "Sparkles" emitter on "Body";
	Mythic also gets a floating halo of neon orbs (parts named "Halo").

	v2.1: vehicle pets (PetDef.VehicleKind) are drawn by Models/Diggers at scale Look.Size
	(~3-5 studs long), with their animated sub-Models ("Arm", "Drill", ... with a "Motion"
	attribute) intact, so the client can play the dig animation. Model attribute "Vehicle" = true.
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)
local Diggers = require(script.Parent.Diggers)

local Pets = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis
local Y = Vector3.yAxis
local Z = Vector3.zAxis
local WHITE = Color3.new(1, 1, 1)
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon

type Ctx = {
	m: Model,
	id: string,
	B: Color3, -- body
	A: Color3, -- accent
	am: Enum.Material, -- accent material (Neon when Glow)
	glow: boolean,
}

-- Each builder returns the main body part and the Y of the top of the head (for the halo).
type ShapeBuilder = (c: Ctx) -> (BasePart, number)

local shapes: { [string]: ShapeBuilder } = {}

shapes.Crab = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.ellipsoid(m, "Body", V(2.0, 1.1, 1.5), CF(0, 0.85, 0), B)
	Build.ellipsoid(m, "Belly", V(1.7, 0.5, 1.3), CF(0, 0.55, 0), A)
	for side = -1, 1, 2 do
		Build.cylBetween(m, "Stalk", V(side * 0.3, 1.25, -0.42), V(side * 0.36, 1.72, -0.48), 0.12, B)
		local eye = CF(side * 0.36, 1.82, -0.5)
		Build.ball(m, "Eye", 0.36, eye, Build.EYE)
		Build.ball(m, "EyeShine", 0.13, eye * CF(0.07, 0.07, -0.13), WHITE, NEON)
		-- claw
		local shoulder = V(side * 0.85, 0.75, -0.35)
		local wrist = V(side * 1.2, 0.95, -0.85)
		Build.cylBetween(m, "Arm", shoulder, wrist, 0.22, B)
		Build.ball(m, "Pincer", 0.62, CF(side * 1.25, 1.0, -0.95), B)
		local jaw = Build.lighten(B, 0.15)
		Build.triPts(m, "Jaw", V(side * 1.25, 1.1, -1.12), V(side * 1.25, 1.2, -1.55), X, 0.36, 0.18, jaw)
		Build.triPts(m, "Jaw", V(side * 1.25, 0.9, -1.12), V(side * 1.25, 0.82, -1.45), X, 0.3, 0.16, jaw)
		-- legs
		for _, z in { -0.1, 0.25, 0.55 } do
			Build.beam(
				m,
				"Leg",
				V(side * 0.8, 0.7, z),
				V(side * 1.3, 0.05, z + 0.1),
				0.16,
				0.16,
				Build.darken(B, 0.1),
				SMOOTH,
				Z
			)
		end
	end
	Build.face(m, CF(0, 0.85, -0.72), 1, { eyes = false, radius = 0.8 })
	return body, 2.0
end

shapes.Bird = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local wing = Build.darken(B, 0.12)
	local body = Build.ellipsoid(m, "Body", V(1.3, 1.35, 1.45), CF(0, 1.05, 0.05), B)
	Build.ellipsoid(
		m,
		"Breast",
		V(0.95, 0.95, 0.3),
		Build.surface(V(0, 1.05, 0.05), V(1.3, 1.35, 1.45), V(0, -0.25, -1)),
		Build.lighten(B, 0.35)
	)
	local headC = V(0, 1.95, -0.3)
	Build.ball(m, "Head", 1.1, CF(headC), B)
	Build.face(m, CF(0, 1.98, -0.84), 0.85, { mouth = false, radius = 0.55 })
	Build.ellipsoid(m, "Beak", V(0.4, 0.24, 0.55), CF(0, 1.8, -0.86), A, am)
	Build.triPts(m, "Crest", V(0, 2.4, -0.35), V(0, 2.85, -0.12), Z, 0.36, 0.12, A, am)
	Build.triPts(m, "Crest", V(0, 2.38, -0.1), V(0, 2.72, 0.22), Z, 0.3, 0.12, A, am)
	for side = -1, 1, 2 do
		Build.ellipsoid(
			m,
			"Wing",
			V(0.22, 0.85, 1.15),
			CF(side * 0.7, 1.15, 0.12) * CFrame.Angles(0.15, 0, -side * 0.28),
			wing
		)
		Build.cylBetween(m, "Leg", V(side * 0.28, 0.06, 0), V(side * 0.28, 0.55, 0.05), 0.12, A)
		Build.ellipsoid(m, "Foot", V(0.3, 0.1, 0.42), CF(side * 0.28, 0.05, -0.1), A)
	end
	Build.triPts(m, "Tail", V(0, 0.95, 0.6), V(0, 0.75, 1.35), X, 0.75, 0.12, if c.glow then A else wing, am)
	return body, 2.9
end

shapes.Star = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local centre = V(0, 1.1, 0)
	local body = Build.ellipsoid(m, "Body", V(1.2, 1.2, 0.6), CF(centre), B)
	for k = 0, 4 do
		local a = math.rad(90 + 72 * k)
		local dir = V(math.cos(a), math.sin(a), 0)
		Build.tri(m, "Arm", CF(centre) * CFrame.Angles(0, 0, a - math.pi / 2) * CF(0, 0.85, 0), 0.8, 1.0, 0.42, B)
		Build.ball(m, "Dot", 0.2, CF(centre + dir * 0.85 + V(0, 0, -0.2)), A, am)
	end
	Build.face(m, CF(0, 1.1, -0.3), 1, { radius = 1.2 })
	return body, 2.4
end

shapes.Turtle = function(c)
	local m, B, A = c.m, c.B, c.A
	local shellC, shellS = V(0, 0.9, 0.1), V(1.9, 1.15, 2.0)
	local body = Build.ellipsoid(m, "Body", shellS, CF(shellC), A)
	Build.cyl(m, "Rim", 0.18, 2.05, CF(0, 0.55, 0.1), Build.lighten(A, 0.25))
	local plate = if c.glow then Build.lighten(A, 0.3) else Build.darken(A, 0.2)
	for _, dir in { V(0, 1, 0), V(0.7, 0.8, 0.5), V(-0.7, 0.8, 0.5), V(0, 0.8, -0.7) } do
		Build.ellipsoid(m, "Plate", V(0.62, 0.62, 0.2), Build.surface(shellC, shellS, dir), plate, c.am)
	end
	Build.ellipsoid(m, "Belly", V(1.7, 0.35, 1.8), CF(0, 0.45, 0.1), Build.lighten(B, 0.35))
	Build.ball(m, "Head", 0.95, CF(0, 1.0, -1.4), B)
	Build.face(m, CF(0, 1.02, -1.87), 0.8, { radius = 0.48 })
	for side = -1, 1, 2 do
		for _, z in { -0.6, 0.75 } do
			Build.ellipsoid(m, "Leg", V(0.5, 0.36, 0.62), CF(side * 0.78, 0.2, z) * CFrame.Angles(0, side * 0.4, 0), B)
		end
	end
	Build.triPts(m, "Tail", V(0, 0.5, 1.0), V(0, 0.4, 1.45), X, 0.3, 0.15, B)
	return body, 1.6
end

shapes.Fish = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local shark = string.find(c.id, "shark") ~= nil
	local fin = Build.lighten(B, 0.15)
	local body = Build.ellipsoid(m, "Body", V(1.2, 1.3, 2.0), CF(0, 1.3, 0), B)
	Build.triPts(m, "Tail", V(0, 1.3, 1.75), V(0, 1.3, 0.85), Y, 1.3, 0.14, fin)
	local dorsalH = if shark then 0.85 else 0.5
	Build.triPts(m, "Dorsal", V(0, 1.85, 0.1), V(0, 1.9 + dorsalH, 0.4), Z, 0.8, 0.12, fin)
	for side = -1, 1, 2 do
		Build.ellipsoid(
			m,
			"Fin",
			V(0.12, 0.35, 0.55),
			CF(side * 0.6, 1.1, -0.05) * CFrame.Angles(0.4, 0, side * 0.6),
			fin
		)
	end
	for _, z in { -0.35, 0.4 } do
		local k = math.sqrt(1 - (z / 1.0) ^ 2) * 1.05
		Build.ellipsoid(m, "Stripe", V(1.2 * k, 1.3 * k, 0.22), CF(0, 1.3, z), A, am)
	end
	Build.face(m, CF(0, 1.36, -0.96), 0.75, { radius = 0.45, cheeks = not shark })
	return body, 1.95 + dorsalH
end

shapes.Squid = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local domeC, domeS = V(0, 1.6, 0), V(1.6, 1.8, 1.6)
	local body = Build.ellipsoid(m, "Body", domeS, CF(domeC), B)
	for _, dir in { V(0.5, 0.6, 0.4), V(-0.6, 0.5, 0.3), V(0.1, 0.9, 0.5) } do
		Build.ellipsoid(m, "Spot", V(0.36, 0.36, 0.1), Build.surface(domeC, domeS, dir), A, am)
	end
	local tent = Build.darken(B, 0.06)
	for k = 0, 5 do
		local a = math.rad(30 + 60 * k)
		local dir = V(math.sin(a), 0, -math.cos(a))
		local p0 = V(0, 0.9, 0) + dir * 0.45
		local p1 = V(0, 0.38, 0) + dir * 0.85
		local p2 = V(0, 0.16, 0) + dir * 1.18
		Build.cylBetween(m, "Tentacle", p0, p1, 0.34, tent)
		Build.cylBetween(m, "Tentacle", p1, p2, 0.26, tent)
		Build.ball(m, "TentacleTip", 0.28, CF(p2 + V(0, 0.08, 0)), A, am)
	end
	Build.face(m, CF(0, 1.4, -0.78), 1, { radius = 0.8 })
	return body, 2.5
end

shapes.Blob = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local puffer = string.find(c.id, "puffer") ~= nil
	local ghost = string.find(c.id, "ghost") ~= nil or string.find(c.id, "spirit") ~= nil
	local bc, bs = V(0, 0.78, 0), V(1.9, 1.55, 1.8)
	local body = Build.ellipsoid(m, "Body", bs, CF(bc), B)
	if c.glow then
		body.Transparency = 0.25
		Build.ball(m, "Core", 0.8, CF(0, 0.8, 0.15), A, NEON)
	end
	Build.ellipsoid(m, "Shine", V(0.4, 0.24, 0.1), Build.surface(bc, bs, V(-0.5, 0.75, -0.45)), WHITE)
	Build.face(m, CF(0, 0.8, -0.9), 1.1, { radius = 0.92 })
	if puffer then
		for k = 0, 7 do
			local a = math.rad(45 * k + 22.5)
			local dir = V(math.cos(a), if k % 2 == 0 then 0.35 else -0.05, math.sin(a))
			local cf = Build.surface(bc, bs, dir)
			local n = cf.LookVector
			Build.triPts(m, "Spike", cf.Position - n * 0.08, cf.Position + n * 0.35, Y:Cross(n), 0.3, 0.1, A)
		end
	else
		if not ghost then
			for side = -1, 1, 2 do
				Build.ellipsoid(m, "Foot", V(0.5, 0.22, 0.55), CF(side * 0.45, 0.1, -0.25), Build.darken(B, 0.15))
			end
		end
		Build.cylBetween(m, "Antenna", V(0, 1.45, 0.05), V(0.15, 1.95, 0.1), 0.08, A)
		Build.ball(m, "Bobble", 0.3, CF(0.17, 2.02, 0.1), A, am)
	end
	return body, 2.1
end

shapes.Mole = function(c)
	local m, B, A = c.m, c.B, c.A
	local bc, bs = V(0, 0.75, 0), V(1.6, 1.5, 1.7)
	local body = Build.ellipsoid(m, "Body", bs, CF(bc), B)
	Build.ellipsoid(m, "Belly", V(0.9, 0.9, 0.16), Build.surface(bc, bs, V(0, -0.35, -1)), Build.lighten(B, 0.35))
	Build.ellipsoid(m, "Snout", V(0.6, 0.42, 0.5), CF(0, 0.66, -0.82), Build.lighten(B, 0.2))
	Build.ball(m, "Nose", 0.3, CF(0, 0.7, -1.1), A)
	Build.face(m, CF(0, 1.0, -0.8), 0.8, { mouth = false, radius = 0.8 })
	for side = -1, 1, 2 do
		Build.ellipsoid(m, "Paw", V(0.5, 0.18, 0.45), CF(side * 0.5, 0.09, -0.68) * CFrame.Angles(0, side * 0.3, 0), A)
	end
	-- mining helmet
	local yellow = Color3.fromRGB(255, 200, 40)
	Build.ellipsoid(m, "Helmet", V(1.3, 0.8, 1.35), CF(0, 1.38, 0.02), yellow)
	Build.cyl(m, "Brim", 0.1, 1.5, CF(0, 1.32, 0.02), Build.darken(yellow, 0.12))
	Build.cyl(m, "Lamp", 0.2, 0.32, CF(0, 1.55, -0.62) * CFrame.Angles(math.pi / 2, 0, 0), Color3.fromRGB(90, 90, 100))
	local bulb = Build.ball(m, "Bulb", 0.24, CF(0, 1.55, -0.73), Color3.fromRGB(255, 250, 200), NEON)
	Build.glow(bulb, Color3.fromRGB(255, 240, 190), 0.8, 6)
	return body, 1.8
end

shapes.Dino = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local steg = string.find(c.id, "steg") ~= nil
	local rex = string.find(c.id, "rex") ~= nil
	local sala = string.find(c.id, "salamander") ~= nil
	local bc, bs = V(0, 1.0, 0.1), V(1.3, 1.2, 1.7)
	local body = Build.ellipsoid(m, "Body", bs, CF(bc), B)
	Build.ellipsoid(m, "Belly", V(0.85, 0.85, 0.2), Build.surface(bc, bs, V(0, -0.3, -1)), Build.lighten(A, 0.1))
	Build.cylBetween(m, "Neck", V(0, 1.2, -0.4), V(0, 1.75, -0.7), 0.55, B)
	local hs = if rex then 1.15 else 1.0
	Build.ellipsoid(m, "Head", V(1.0, 0.9, 1.15) * hs, CF(0, 1.85, -0.78), B)
	Build.face(m, CF(0, 1.9, -0.78 - 0.56 * hs), 0.9 * hs, { radius = 0.5 * hs })
	Build.cylBetween(m, "Tail", V(0, 1.0, 0.8), V(0, 0.7, 1.5), 0.55, B)
	Build.triPts(m, "TailTip", V(0, 0.72, 1.45), V(0, 0.45, 2.1), X, 0.45, 0.3, B)
	for side = -1, 1, 2 do
		Build.ellipsoid(m, "Leg", V(0.45, 0.75, 0.6), CF(side * 0.48, 0.42, 0.3), B)
		Build.ellipsoid(m, "Foot", V(0.42, 0.16, 0.6), CF(side * 0.48, 0.08, 0.15), Build.darken(B, 0.15))
		local armLen = if rex then 0.22 else 0.38
		Build.beam(
			m,
			"Arm",
			V(side * 0.42, 1.05, -0.55),
			V(side * 0.48, 1.05 - armLen, -0.55 - armLen * 0.8),
			0.15,
			0.15,
			B,
			SMOOTH,
			X
		)
	end
	if sala then
		for _, dir in { V(0.5, 0.8, 0.2), V(-0.5, 0.8, -0.1), V(0.1, 0.9, 0.7), V(-0.3, 0.7, 0.8) } do
			Build.ellipsoid(m, "Spot", V(0.3, 0.3, 0.1), Build.surface(bc, bs, dir), A, am)
		end
	else
		local count = if steg then 5 else 3
		local h = if steg then 0.55 else 0.3
		for i = 1, count do
			local z = -0.4 + (i - 1) * (1.1 / (count - 1))
			local rel = math.clamp((z - bc.Z) / (bs.Z / 2), -1, 1)
			local y = bc.Y + bs.Y / 2 * math.sqrt(1 - rel * rel)
			local hh = h * (1 - math.abs(i - (count + 1) / 2) / count)
			Build.triPts(m, "Plate", V(0, y - 0.06, z), V(0, y + hh, z + 0.1), Z, hh * 1.1, 0.12, A, am)
		end
	end
	return body, 1.85 + 0.45 * hs
end

shapes.Dragon = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local bc, bs = V(0, 1.05, 0.1), V(1.4, 1.35, 1.8)
	local body = Build.ellipsoid(m, "Body", bs, CF(bc), B)
	Build.ellipsoid(m, "Belly", V(0.95, 0.95, 0.2), Build.surface(bc, bs, V(0, -0.3, -1)), Build.lighten(A, 0.2))
	Build.cylBetween(m, "Neck", V(0, 1.35, -0.45), V(0, 1.95, -0.7), 0.6, B)
	Build.ellipsoid(m, "Head", V(1.15, 1.0, 1.1), CF(0, 2.2, -0.75), B)
	Build.ellipsoid(m, "Snout", V(0.75, 0.5, 0.6), CF(0, 2.04, -1.25), Build.lighten(B, 0.1))
	Build.face(m, CF(0, 2.42, -1.25), 0.85, { mouth = false, cheeks = false, radius = 0.55 })
	for side = -1, 1, 2 do
		Build.triPts(m, "Horn", V(side * 0.3, 2.58, -0.6), V(side * 0.42, 3.1, -0.3), Z, 0.3, 0.14, A, am)
		Build.triPts(m, "Wing", V(side * 0.62, 1.55, 0.1), V(side * 1.8, 2.4, 0.4), Z, 1.3, 0.1, A, am)
		for _, z in { -0.45, 0.6 } do
			Build.ellipsoid(m, "Leg", V(0.45, 0.6, 0.5), CF(side * 0.5, 0.3, z), B)
		end
	end
	Build.cylBetween(m, "Tail", V(0, 1.0, 0.85), V(0, 0.6, 1.6), 0.5, B)
	Build.triPts(m, "TailTip", V(0, 0.6, 1.55), V(0, 0.68, 2.1), X, 0.55, 0.12, A, am)
	for _, z in { 0.0, 0.5 } do
		local rel = (z - bc.Z) / (bs.Z / 2)
		local y = bc.Y + bs.Y / 2 * math.sqrt(1 - rel * rel)
		Build.triPts(m, "Spine", V(0, y - 0.06, z), V(0, y + 0.32, z + 0.12), Z, 0.32, 0.1, A, am)
	end
	return body, 3.1
end

shapes.Golem = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local dark = Build.darken(B, 0.12)
	local body = Build.part(m, "Body", V(1.6, 1.3, 1.1), CF(0, 1.3, 0), B)
	Build.part(m, "Head", V(1.0, 0.85, 0.9), CF(0, 2.35, -0.05), B)
	Build.face(m, CF(0, 2.33, -0.5), 0.85)
	for side = -1, 1, 2 do
		Build.part(m, "Arm", V(0.5, 1.1, 0.55), CF(side * 1.08, 1.3, 0) * CFrame.Angles(0, 0, side * 0.12), dark)
		Build.part(m, "Fist", V(0.7, 0.6, 0.7), CF(side * 1.18, 0.55, 0), B)
		Build.part(m, "Leg", V(0.55, 0.65, 0.6), CF(side * 0.42, 0.33, 0), dark)
	end
	Build.spike(m, "Crystal", V(-0.6, 1.85, 0.1), V(-0.95, 2.6, 0.25), 0.38, A, am)
	Build.spike(m, "Crystal", V(0.65, 1.85, 0.05), V(0.98, 2.45, 0.2), 0.32, A, am)
	Build.spike(m, "Crystal", V(0, 1.6, 0.45), V(0, 2.35, 0.95), 0.42, A, am)
	Build.ball(m, "Gem", 0.36, CF(0, 1.45, -0.55), A, am)
	return body, 2.8
end

shapes.Seal = function(c)
	local m, B, A = c.m, c.B, c.A
	local fl = Build.darken(B, 0.1)
	local body = Build.ellipsoid(m, "Body", V(1.5, 1.25, 2.0), CF(0, 0.62, 0.15), B)
	Build.ball(m, "Head", 1.2, CF(0, 1.4, -0.55), B)
	Build.face(m, CF(0, 1.52, -1.13), 0.85, { mouth = false, radius = 0.6 })
	Build.ellipsoid(m, "Snout", V(0.55, 0.32, 0.3), CF(0, 1.28, -1.1), Build.lighten(B, 0.5))
	Build.ball(m, "Nose", 0.2, CF(0, 1.38, -1.24), Build.EYE)
	for side = -1, 1, 2 do
		Build.ellipsoid(
			m,
			"Flipper",
			V(0.2, 0.3, 0.7),
			CF(side * 0.72, 0.3, -0.35) * CFrame.Angles(0.3, 0, side * 0.8),
			fl
		)
		Build.ellipsoid(
			m,
			"TailFlipper",
			V(0.6, 0.15, 0.4),
			CF(side * 0.3, 0.12, 1.15) * CFrame.Angles(0, side * 0.5, 0),
			fl
		)
	end
	-- beach ball balanced on its head
	Build.ball(m, "Ball", 0.6, CF(0, 2.28, -0.6), A, c.am)
	Build.ellipsoid(m, "BallStripe", V(0.63, 0.63, 0.22), CF(0, 2.28, -0.6) * CFrame.Angles(0, 0.6, 0.3), WHITE)
	return body, 2.6
end

local FALLBACK: Types.PetLook = {
	BodyColor = Color3.fromRGB(255, 170, 120),
	AccentColor = Color3.fromRGB(255, 240, 200),
	Shape = "Blob",
	Size = 1,
	Glow = false,
}

local function build(id: string, look: Types.PetLook, rarity: Types.Rarity): Model
	local m = Build.model(id)
	local root = Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local ctx: Ctx = {
		m = m,
		id = id,
		B = look.BodyColor,
		A = look.AccentColor,
		am = if look.Glow then NEON else SMOOTH,
		glow = look.Glow,
	}
	local builder = shapes[look.Shape] or shapes.Blob
	local body, top = builder(ctx)

	if look.Glow then
		Build.glow(body, look.AccentColor, 1, 7)
	end
	if rarity == "Legendary" or rarity == "Mythic" then
		Build.sparkle(body, look.AccentColor, if rarity == "Mythic" then 8 else 4)
	end
	if rarity == "Mythic" then
		for k = 0, 5 do
			local a = math.rad(60 * k)
			Build.ball(
				m,
				"Halo",
				0.2,
				CF(math.cos(a) * 0.55, top + 0.35, math.sin(a) * 0.55),
				Color3.fromRGB(255, 240, 150),
				NEON
			)
		end
	end

	Build.scale(m, CFrame.identity, math.clamp(look.Size, 0.3, 3))
	Build.weldAll(m, root)
	return m
end

local function buildVehicle(def: Types.PetDef): Model
	local m = Diggers.Build(def.Id, def.Look.Size)
	m:SetAttribute("Vehicle", true)
	if def.Rarity == "Legendary" or def.Rarity == "Mythic" then
		local body = m:FindFirstChild("Body")
		if body and body:IsA("BasePart") then
			Build.sparkle(body, def.Look.AccentColor, if def.Rarity == "Mythic" then 8 else 4)
		end
	end
	return m
end

function Pets.Build(petId: string): Model
	local def = Config.GetPet(petId)
	if def and def.VehicleKind then
		return buildVehicle(def)
	end
	if def then
		return build(petId, def.Look, def.Rarity)
	end
	return build(petId, FALLBACK, "Common")
end

function Pets.FromLook(name: string, look: Types.PetLook, rarity: Types.Rarity?): Model
	return build(name, look, rarity or "Common")
end

return Pets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Props — beach scenery at real scale (avatar ~5 studs tall).
	PrimaryPart = invisible "Root" at the bottom-centre (pivot). FRONT faces -Z (towers look
	out along -Z, stall / shack counters open towards -Z, sign text is on the -Z face).
	Main bodies players should stand on / bump into have CanCollide = true; small details don't.
	Optional `variant` (number) picks colours / shape jitter deterministically.
	Signs carry a SurfaceGui whose TextLabel is named "Label" on a part named "SignBoard".
	Names are matched case-, space-, '_' and '-' insensitively ("Lifeguard Tower" works).
]]

local Types = require(script.Parent.Parent.Types)
local Build = require(script.Parent.Build)
local Pets = require(script.Parent.Pets)

local Props = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis
local Y = Vector3.yAxis
local Z = Vector3.zAxis
local rgb = Color3.fromRGB
local PI = math.pi

local WHITE = rgb(255, 255, 255)
local SAND = rgb(255, 222, 140)
local WOOD = rgb(176, 120, 72)
local WOOD_DARK = rgb(130, 85, 50)
local GOLD = rgb(255, 205, 40)
local M = Enum.Material

local solid = Build.solid

local function pick<T>(list: { T }, variant: number): T
	return list[(math.floor(variant) - 1) % #list + 1]
end

type PropBuilder = (m: Model, v: number) -> ()

local builders: { [string]: PropBuilder } = {}

builders.PalmTree = function(m, v)
	local rng = Random.new(v * 7919 + 13)
	local lean = rng:NextNumber() * PI * 2
	local lx, lz = math.cos(lean), math.sin(lean)
	local H = 10.5 + rng:NextNumber() * 1.5
	local function at(t: number): Vector3
		local b = 2.0 * t * t
		return V(lx * b, t * H, lz * b)
	end
	local barkA, barkB = rgb(170, 120, 75), rgb(140, 95, 58)
	local segs = 6
	for i = 0, segs - 1 do
		local a, b = at(i / segs), at((i + 1) / segs)
		solid(
			Build.cylBetween(
				m,
				"Trunk",
				a,
				b + (b - a).Unit * 0.15,
				1.15 - 0.07 * i,
				if i % 2 == 0 then barkA else barkB,
				M.Wood
			)
		)
	end
	local top = at(1)
	Build.ball(m, "Crown", 1.3, CF(top), rgb(60, 150, 70))
	for k = 0, 2 do
		local a = k / 3 * PI * 2 + 0.4
		Build.ball(m, "Coconut", 0.7, CF(top + V(math.cos(a) * 0.55, -0.55, math.sin(a) * 0.55)), rgb(120, 80, 45))
	end
	local greens = { rgb(70, 200, 100), rgb(50, 170, 80), rgb(90, 215, 110) }
	local fronds = 7
	local offset = rng:NextNumber() * PI
	for k = 0, fronds - 1 do
		local a = k / fronds * PI * 2 + offset
		local h = V(math.cos(a), 0, math.sin(a))
		local perp = V(-h.Z, 0, h.X)
		local mid = top + h * 2.2 + V(0, 0.55, 0)
		local tip = top + h * 4.8 + V(0, -1.5, 0)
		local col = greens[k % #greens + 1]
		Build.beam(m, "Frond", top, mid, 1.1, 0.14, col, M.SmoothPlastic, perp)
		Build.triPts(m, "Frond", mid, tip, perp, 1.1, 0.14, col)
	end
end

builders.Umbrella = function(m, v)
	local pairs_ = {
		{ rgb(255, 80, 90), WHITE },
		{ rgb(40, 170, 255), rgb(255, 230, 70) },
		{ rgb(255, 150, 40), WHITE },
		{ rgb(90, 210, 120), rgb(255, 245, 200) },
		{ rgb(170, 100, 255), rgb(255, 200, 230) },
	}
	local cols = pick(pairs_, v)
	local tilt = CFrame.Angles(0.06, 0, 0.04 * ((v % 3) - 1))
	Build.ellipsoid(m, "Mound", V(1.4, 0.45, 1.4), CF(), SAND, M.Sand)
	solid(Build.cylBetween(m, "Pole", V(0, 0, 0), (tilt * CF(0, 7.3, 0)).Position, 0.25, rgb(235, 235, 240)))
	local apex = (tilt * CF(0, 7.45, 0)).Position
	local R = 3.8
	local n = 8
	for k = 0, n - 1 do
		local a = (k + 0.5) / n * PI * 2
		local base = (tilt * CF(R * math.cos(PI / n) * math.cos(a), 6.1, R * math.cos(PI / n) * math.sin(a))).Position
		local tangent = tilt:VectorToWorldSpace(V(-math.sin(a), 0, math.cos(a)))
		Build.triPts(m, "Canopy", base, apex, tangent, 2 * R * math.sin(PI / n) + 0.05, 0.1, cols[k % 2 + 1])
	end
	Build.ball(m, "Finial", 0.4, CF(apex + V(0, 0.1, 0)), cols[1])
end

builders.BeachTowel = function(m, v)
	local cols = pick({
		{ rgb(255, 90, 120), WHITE },
		{ rgb(60, 170, 255), rgb(255, 230, 80) },
		{ rgb(90, 210, 120), rgb(255, 250, 240) },
		{ rgb(255, 160, 50), rgb(140, 90, 230) },
	}, v)
	Build.part(m, "Towel", V(3, 0.1, 5.6), CF(0, 0.14, 0), cols[1], M.Fabric)
	for _, z in { -1.6, 0, 1.6 } do
		Build.part(m, "Stripe", V(2.98, 0.025, 0.5), CF(0, 0.205, z), cols[2], M.Fabric)
	end
	Build.cylBetween(m, "Pillow", V(-1.3, 0.3, -2.45), V(1.3, 0.3, -2.45), 0.6, cols[2], M.Fabric)
end

builders.Sandcastle = function(m, v)
	local mat = M.Sand
	local dark = Build.darken(SAND, 0.12)
	solid(Build.part(m, "Base", V(6, 1.4, 6), CF(0, 0.7, 0), SAND, mat))
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			local c = V(sx * 2.6, 0, sz * 2.6)
			solid(Build.cyl(m, "Tower", 3.2, 1.7, CF(c + V(0, 1.6, 0)), SAND, mat))
			for k = 0, 3 do
				local a = (k + 0.5) / 4 * PI * 2
				Build.part(
					m,
					"Crenel",
					V(0.45, 0.45, 0.45),
					CF(c + V(math.cos(a) * 0.6, 3.42, math.sin(a) * 0.6)),
					SAND,
					mat
				)
			end
		end
	end
	local keep = V(0, 0, 0.4)
	solid(Build.cyl(m, "Keep", 4.6, 2.6, CF(keep + V(0, 2.3, 0)), SAND, mat))
	for k = 0, 5 do
		local a = k / 6 * PI * 2
		Build.part(m, "Crenel", V(0.5, 0.5, 0.5), CF(keep + V(math.cos(a) * 1.05, 4.85, math.sin(a) * 1.05)), SAND, mat)
	end
	Build.part(m, "Door", V(1.1, 1.1, 0.1), CF(0, 0.55, -3.02), dark, mat)
	for side = -1, 1, 2 do
		Build.part(m, "Window", V(0.35, 0.5, 0.1), CF(side * 0.5, 3.2, -0.82), dark, mat)
		Build.ellipsoid(m, "Shell", V(0.45, 0.38, 0.12), CF(side * 1.8, 0.8, -3.03), rgb(255, 170, 180))
	end
	local flag = pick({ rgb(255, 70, 80), rgb(60, 160, 255), rgb(255, 200, 40), rgb(90, 210, 120) }, v)
	Build.cylBetween(m, "FlagPole", V(0, 4.6, 0.4), V(0, 6.5, 0.4), 0.1, WHITE)
	Build.triPts(m, "Flag", V(0.05, 6.05, 0.4), V(1.0, 6.05, 0.4), Y, 0.7, 0.05, flag)
end

builders.Crab = function(m, v)
	local col = pick({ rgb(255, 110, 80), rgb(255, 80, 60), rgb(255, 150, 70), rgb(230, 70, 110) }, v)
	local look: Types.PetLook = {
		BodyColor = col,
		AccentColor = Build.lighten(col, 0.55),
		Shape = "Crab",
		Size = 0.8,
		Glow = false,
	}
	local crab = Pets.FromLook("Crab", look)
	for _, d in crab:GetChildren() do
		if d.Name ~= "Root" then
			d.Parent = m
		end
	end
	crab:Destroy()
	for _, d in m:GetDescendants() do
		if d:IsA("WeldConstraint") then
			d:Destroy()
		end
	end
end

local function trussPart(m: Model, size: Vector3, cf: CFrame, color: Color3): TrussPart
	local t = Instance.new("TrussPart")
	t.Name = "Ladder"
	t.Anchored = true
	t.Size = size
	t.CFrame = cf
	t.Color = color
	t.Material = M.SmoothPlastic
	t.Parent = m
	return t
end

builders.LifeguardTower = function(m, v)
	local wall = pick({ rgb(235, 55, 55), rgb(40, 150, 240), rgb(255, 190, 40) }, v)
	local wood = M.Wood
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			solid(
				Build.beam(m, "Leg", V(sx * 2.0, 0, sz * 2.0), V(sx * 1.75, 6.1, sz * 1.75), 0.4, 0.4, WHITE, wood, X)
			)
		end
		Build.beam(m, "Brace", V(sx * 1.95, 0.6, -1.95), V(sx * 1.8, 5.5, 1.8), 0.22, 0.22, WHITE, wood, Z)
	end
	Build.beam(m, "Brace", V(-1.95, 0.6, 1.95), V(1.8, 5.5, 1.8), 0.22, 0.22, WHITE, wood, X)
	solid(Build.part(m, "Platform", V(4.8, 0.4, 4.8), CF(0, 6.2, 0), WOOD, wood))
	solid(Build.part(m, "BackWall", V(4.4, 3.2, 0.3), CF(0, 8.0, 2.2), wall, wood))
	for side = -1, 1, 2 do
		solid(Build.part(m, "SideWall", V(0.3, 3.2, 2.0), CF(side * 2.2, 8.0, 1.2), wall, wood))
		solid(Build.part(m, "Pillar", V(0.3, 3.2, 0.3), CF(side * 2.2, 8.0, -2.2), WHITE, wood))
		solid(Build.part(m, "Railing", V(1.4, 1.1, 0.2), CF(side * 1.5, 6.95, -2.3), WHITE, wood))
	end
	local roofA, roofB = Build.tri(m, "Roof", CF(0, 10.25, 0) * CFrame.Angles(0, PI / 2, 0), 5.6, 1.3, 5.6, wall, wood)
	solid(roofA)
	solid(roofB)
	Build.part(m, "Eaves", V(5.4, 0.2, 5.6), CF(0, 9.6, 0), WHITE, wood)
	solid(trussPart(m, V(2, 6, 2), CF(0, 3.0, -3.1), WHITE))
	local sign = Build.part(m, "SignBoard", V(3.0, 0.7, 0.15), CF(0, 9.25, -2.35), WHITE)
	Build.label(sign, Enum.NormalId.Front, "LIFEGUARD", rgb(235, 55, 55), WHITE)
	Build.cylBetween(m, "Buoy", V(2.36, 7.8, 1.2), V(2.52, 7.8, 1.2), 1.1, rgb(255, 120, 40))
	Build.cylBetween(m, "BuoyHole", V(2.34, 7.8, 1.2), V(2.54, 7.8, 1.2), 0.5, Build.darken(wall, 0.3))
	Build.cylBetween(m, "FlagPole", V(0, 10.85, 0), V(0, 12.7, 0), 0.12, WHITE)
	Build.triPts(m, "Flag", V(0.05, 12.25, 0), V(1.2, 12.25, 0), Y, 0.8, 0.06, wall)
end

builders.BoardwalkStall = function(m, v)
	local cols = pick({
		{ rgb(255, 80, 100), WHITE },
		{ rgb(40, 170, 255), WHITE },
		{ rgb(255, 170, 40), rgb(255, 250, 220) },
		{ rgb(90, 200, 120), rgb(255, 250, 220) },
	}, v)
	local text = pick({ "SNACKS", "ICE CREAM", "SHELLS", "DRINKS" }, v)
	solid(Build.part(m, "BackWall", V(5, 3.6, 0.25), CF(0, 1.8, 1.6), WOOD, M.Wood))
	solid(Build.part(m, "Counter", V(5, 1.15, 1.0), CF(0, 0.575, -1.2), WOOD, M.Wood))
	solid(Build.part(m, "CounterTop", V(5.3, 0.15, 1.2), CF(0, 1.22, -1.2), WHITE))
	for sx = -1, 1, 2 do
		for _, z in { -1.6, 1.6 } do
			solid(Build.cyl(m, "Post", 3.9, 0.3, CF(sx * 2.4, 1.95, z), WHITE))
		end
	end
	for i = 0, 4 do
		local x = -2.0 + i
		Build.part(
			m,
			"Awning",
			V(1.0, 0.15, 3.9),
			CF(x, 4.0, -0.1) * CFrame.Angles(-0.2, 0, 0),
			cols[i % 2 + 1],
			M.Fabric
		)
		Build.tri(m, "Valance", CF(x, 3.42, -2.03) * CFrame.Angles(0, 0, PI), 1.0, 0.4, 0.06, cols[i % 2 + 1], M.Fabric)
	end
	local sign = Build.part(m, "SignBoard", V(3.2, 0.9, 0.15), CF(0, 4.85, -1.0), cols[1])
	Build.label(sign, Enum.NormalId.Front, text, WHITE)
	for i, col in { rgb(255, 90, 90), rgb(255, 220, 60), rgb(120, 220, 120) } do
		Build.ball(m, "Goods", 0.45, CF(-1.6 + i * 0.55, 1.52, -1.25), col)
	end
	Build.cyl(m, "Goods", 0.6, 0.3, CF(1.4, 1.6, -1.2), rgb(80, 180, 255), M.Glass)
end

builders.Surfboard = function(m, v)
	local cols = pick({
		{ rgb(255, 120, 60), WHITE },
		{ rgb(60, 190, 255), rgb(255, 230, 70) },
		{ rgb(255, 90, 160), WHITE },
		{ rgb(90, 220, 140), rgb(40, 90, 200) },
	}, v)
	local cf = CF(0, 3.45, 0) * CFrame.Angles(0, 0, 0.06 * ((v % 3) - 1))
	solid(Build.ellipsoid(m, "Board", V(1.8, 7, 0.3), cf, cols[1]))
	Build.ellipsoid(m, "Stripe", V(0.35, 6.6, 0.34), cf, cols[2])
	Build.triPts(m, "Fin", (cf * CF(0, -2.1, 0.12)).Position, (cf * CF(0, -2.5, 0.6)).Position, Y, 0.6, 0.08, cols[2])
end

builders.BeachBall = function(m, v)
	local c = V(0, 1, 0)
	Build.ball(m, "Ball", 2, CF(c), WHITE)
	local sets = {
		{ rgb(255, 70, 70), rgb(255, 215, 50), rgb(60, 150, 255) },
		{ rgb(255, 120, 200), rgb(90, 220, 140), rgb(255, 160, 40) },
	}
	for i, col in pick(sets, v) do
		Build.ellipsoid(m, "Stripe", V(2.15, 2.15, 1.4), CF(c) * CFrame.Angles(0, (i - 1) * PI / 3, 0), col)
	end
	Build.ball(m, "Cap", 0.45, CF(c + V(0, 0.9, 0)), WHITE)
end

builders.Rock = function(m, v)
	local rng = Random.new(v * 104729 + 7)
	local specs = {
		{ V(3.2, 2.2, 2.6), V(0, 1.0, 0) },
		{ V(2.2, 1.6, 2.0), V(1.2, 0.7, 0.4) },
		{ V(1.5, 1.2, 1.4), V(-1.3, 0.5, -0.3) },
	}
	for i, s in specs do
		local rot = CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, PI * 2), rng:NextNumber(-0.3, 0.3))
		local g = 120 + rng:NextInteger(-15, 20)
		solid(Build.part(m, "Rock", s[1], CF(s[2]) * rot, rgb(g, g, g + 8), M.Slate))
		if i == 1 then
			Build.ellipsoid(m, "Moss", V(2.0, 0.4, 1.6), CF(s[2] + V(0, 1.0, 0)) * rot, rgb(110, 170, 90), M.Grass)
		end
	end
end

builders.Shell = function(m, v)
	local col = pick({ rgb(255, 190, 170), rgb(255, 150, 180), rgb(200, 170, 255), rgb(255, 240, 220) }, v)
	local hinge = V(0, 0.15, 0.75)
	Build.ellipsoid(m, "Back", V(2.0, 0.25, 1.5), CF(0, 0.13, 0), Build.darken(col, 0.1))
	for _, a in { -0.9, -0.45, 0, 0.45, 0.9 } do
		local dir = V(math.sin(a), 0, -math.cos(a))
		Build.ellipsoid(
			m,
			"Rib",
			V(0.5, 0.35, 1.6),
			CF(hinge + dir * 0.75 + V(0, 0.08, 0)) * CFrame.Angles(0, -a, 0),
			Build.lighten(col, 0.1)
		)
	end
	Build.part(m, "Hinge", V(0.7, 0.25, 0.3), CF(0, 0.13, 0.8), col)
end

builders.Chest = function(m, v)
	local wood = pick({ rgb(150, 95, 45), rgb(120, 75, 40), rgb(170, 110, 60) }, v)
	solid(Build.part(m, "Base", V(3, 1.6, 2), CF(0, 0.8, 0), wood, M.Wood))
	solid(Build.cylBetween(m, "Lid", V(-1.5, 1.6, 0), V(1.5, 1.6, 0), 2.0, Build.lighten(wood, 0.08), M.Wood))
	for _, x in { -1.0, 1.0 } do
		Build.part(m, "Band", V(0.25, 1.64, 2.04), CF(x, 0.8, 0), GOLD, M.Metal)
		Build.cylBetween(m, "Band", V(x - 0.125, 1.6, 0), V(x + 0.125, 1.6, 0), 2.04, GOLD, M.Metal)
	end
	Build.part(m, "Lock", V(0.5, 0.6, 0.15), CF(0, 1.5, -1.05), GOLD, M.Metal)
	Build.ellipsoid(m, "Gold", V(1.4, 0.45, 1.0), CF(1.3, 0.12, -1.6), GOLD, M.Metal)
	for i = 0, 2 do
		Build.cyl(m, "Coin", 0.08, 0.5, CF(0.4 + i * 0.45, 0.05, -1.9 + (i % 2) * 0.3), GOLD, M.Metal)
	end
end

builders.Bucket = function(m, v)
	local cols = pick({
		{ rgb(60, 170, 255), rgb(255, 230, 60) },
		{ rgb(255, 90, 90), rgb(255, 255, 255) },
		{ rgb(255, 200, 40), rgb(60, 170, 255) },
		{ rgb(90, 210, 120), rgb(255, 120, 200) },
	}, v)
	Build.cyl(m, "Body", 1.2, 1.2, CF(0, 0.6, 0), cols[1])
	Build.cyl(m, "Rim", 0.14, 1.32, CF(0, 1.2, 0), cols[2])
	Build.ellipsoid(m, "SandFill", V(1.05, 0.35, 1.05), CF(0, 1.22, 0), SAND, M.Sand)
	Build.beam(m, "Handle", V(-0.62, 1.0, 0), V(-0.45, 1.6, 0), 0.08, 0.08, cols[2], M.SmoothPlastic, Z)
	Build.beam(m, "Handle", V(-0.5, 1.6, 0), V(0.5, 1.6, 0), 0.08, 0.08, cols[2], M.SmoothPlastic, Z)
	Build.beam(m, "Handle", V(0.45, 1.6, 0), V(0.62, 1.0, 0), 0.08, 0.08, cols[2], M.SmoothPlastic, Z)
	Build.cylBetween(m, "Spade", V(0.1, 1.0, 0.05), V(0.45, 2.2, 0.2), 0.12, cols[2])
	Build.ball(m, "SpadeGrip", 0.25, CF(0.47, 2.27, 0.21), cols[2])
end

builders.Sign = function(m, v)
	local text = pick({ "DIG!", "SELL", "SHOP", "EGGS", "DANGER!" }, v)
	solid(Build.part(m, "Post", V(0.35, 4, 0.35), CF(0, 2, 0.12), WOOD_DARK, M.Wood))
	Build.part(m, "Frame", V(3.4, 1.6, 0.14), CF(0, 3.6, 0.1), WOOD_DARK, M.Wood)
	local board = solid(Build.part(m, "SignBoard", V(3.2, 1.4, 0.2), CF(0, 3.6, 0), WOOD, M.Wood))
	Build.label(board, Enum.NormalId.Front, text, WHITE)
end

builders.Lamp = function(m, v)
	local metal = pick({ rgb(85, 110, 125), rgb(85, 90, 105), rgb(55, 135, 145) }, v)
	solid(Build.cyl(m, "Base", 0.4, 1.0, CF(0, 0.2, 0), metal, M.Metal))
	solid(Build.cyl(m, "Pole", 8.1, 0.3, CF(0, 4.45, 0), metal, M.Metal))
	Build.beam(m, "Arm", V(0, 8.3, 0), V(0, 8.6, -1.2), 0.2, 0.2, metal, M.Metal, X)
	Build.part(m, "Shade", V(0.85, 0.3, 0.85), CF(0, 8.6, -1.3), metal, M.Metal)
	local bulb = Build.ball(m, "Bulb", 0.55, CF(0, 8.3, -1.3), rgb(255, 235, 170), M.Neon)
	Build.glow(bulb, rgb(255, 220, 160), 1.5, 18)
	Build.ball(m, "Finial", 0.4, CF(0, 8.6, 0), metal, M.Metal)
end

builders.Bench = function(m, v)
	local wood = pick({ WOOD, rgb(80, 160, 220), rgb(230, 90, 80) }, v)
	local metal = rgb(50, 50, 60)
	for _, z in { -0.5, 0, 0.5 } do
		solid(Build.part(m, "Seat", V(5, 0.18, 0.45), CF(0, 1.5, z), wood, M.Wood))
	end
	for i, y in { 2.2, 2.75 } do
		solid(
			Build.part(m, "Back", V(5, 0.4, 0.15), CF(0, y, 0.78 + i * 0.05) * CFrame.Angles(-0.15, 0, 0), wood, M.Wood)
		)
	end
	for _, x in { -2.2, 2.2 } do
		Build.part(m, "Leg", V(0.2, 1.5, 0.2), CF(x, 0.75, -0.55), metal, M.Metal)
		Build.part(m, "Leg", V(0.2, 3.0, 0.2), CF(x, 1.5, 0.75) * CFrame.Angles(-0.1, 0, 0), metal, M.Metal)
		Build.part(m, "Armrest", V(0.22, 0.15, 1.4), CF(x * 1.08, 2.1, 0.05), metal, M.Metal)
	end
end

builders.Barrel = function(m, v)
	local wood = pick({ rgb(150, 95, 50), rgb(120, 80, 45), rgb(175, 120, 70) }, v)
	solid(Build.cyl(m, "Body", 2.8, 2.2, CF(0, 1.4, 0), wood, M.Wood))
	Build.cyl(m, "Bulge", 1.6, 2.36, CF(0, 1.4, 0), wood, M.Wood)
	for _, y in { 0.55, 2.25 } do
		Build.cyl(m, "Hoop", 0.18, 2.34, CF(0, y, 0), rgb(80, 80, 90), M.Metal)
	end
	Build.cyl(m, "Lid", 0.06, 2.0, CF(0, 2.81, 0), Build.darken(wood, 0.2), M.Wood)
end

builders.Starfish = function(m, v)
	local col = pick({ rgb(255, 150, 60), rgb(255, 90, 120), rgb(170, 100, 255), rgb(255, 210, 60) }, v)
	local dot = Build.lighten(col, 0.5)
	local c = CF(0, 0.15, 0)
	Build.ellipsoid(m, "Body", V(1.0, 0.3, 1.0), c, col)
	for k = 0, 4 do
		local a = k / 5 * PI * 2
		Build.tri(
			m,
			"Arm",
			c * CFrame.Angles(0, a, 0) * CFrame.Angles(-PI / 2, 0, 0) * CF(0, 0.85, 0),
			0.8,
			1.0,
			0.25,
			col
		)
		Build.ball(m, "Dot", 0.16, c * CFrame.Angles(0, a, 0) * CF(0, 0.12, -0.75), dot)
	end
end

builders.Dock = function(m, v)
	local planks = { rgb(175, 125, 80), rgb(160, 110, 70) }
	for i = 0, 9 do
		solid(Build.part(m, "Plank", V(8, 0.4, 1.55), CF(0, 4.4, -7.2 + i * 1.6), planks[i % 2 + 1], M.Wood))
	end
	for _, x in { -3.8, 3.8 } do
		Build.part(m, "Stringer", V(0.4, 0.5, 16), CF(x * 0.8, 3.95, 0), WOOD_DARK, M.Wood)
		for _, z in { -7, 0, 7 } do
			solid(Build.cyl(m, "Post", 5.0, 0.7, CF(x, 2.5, z), WOOD_DARK, M.Wood))
		end
	end
end

builders.Flag = function(m, v)
	local cols = pick({
		{ rgb(235, 50, 50), WHITE },
		{ rgb(40, 140, 255), rgb(255, 220, 50) },
		{ rgb(70, 200, 110), WHITE },
		{ rgb(150, 80, 230), GOLD },
		{ rgb(30, 30, 40), WHITE },
	}, v)
	Build.cyl(m, "Base", 0.3, 0.8, CF(0, 0.15, 0), rgb(200, 200, 210), M.Metal)
	solid(Build.cyl(m, "Pole", 10, 0.25, CF(0, 5, 0), WHITE, M.Metal))
	Build.ball(m, "Finial", 0.45, CF(0, 10.1, 0), GOLD, M.Metal)
	Build.part(m, "Cloth", V(3, 2, 0.08), CF(1.6, 8.9, 0), cols[1], M.Fabric)
	Build.part(m, "ClothStripe", V(3.02, 0.6, 0.1), CF(1.6, 8.9, 0), cols[2], M.Fabric)
end

builders.Cooler = function(m, v)
	local col = pick({ rgb(40, 200, 230), rgb(255, 90, 90), rgb(90, 200, 120), rgb(40, 110, 220) }, v)
	solid(Build.part(m, "Body", V(2.4, 1.4, 1.4), CF(0, 0.7, 0), col))
	solid(Build.part(m, "Lid", V(2.5, 0.35, 1.5), CF(0, 1.57, 0), WHITE))
	for side = -1, 1, 2 do
		Build.part(m, "HandlePost", V(0.14, 0.3, 0.14), CF(side * 0.6, 1.85, 0), rgb(220, 220, 225))
	end
	Build.part(m, "Handle", V(1.34, 0.14, 0.2), CF(0, 2.0, 0), rgb(220, 220, 225))
	Build.part(m, "Latch", V(0.4, 0.4, 0.1), CF(0, 1.35, -0.75), WHITE)
end

builders.SurfShack = function(m, v)
	local wallCol = pick({ rgb(255, 245, 225), rgb(140, 220, 240), rgb(255, 210, 170) }, v)
	local trim = pick({ rgb(40, 150, 240), rgb(255, 110, 90), rgb(60, 180, 120) }, v)
	local W = M.Wood
	solid(Build.part(m, "Floor", V(12, 0.6, 10), CF(0, 0.3, 0), WOOD, W))
	solid(Build.part(m, "BackWall", V(12, 5, 0.4), CF(0, 3.1, 4.8), wallCol, W))
	for side = -1, 1, 2 do
		solid(Build.part(m, "SideWall", V(0.4, 5, 9.6), CF(side * 5.8, 3.1, 0), wallCol, W))
	end
	-- front (-Z): wall left of the door, door gap, then serving window with counter
	solid(Build.part(m, "FrontWall", V(1.8, 5, 0.4), CF(-5.1, 3.1, -4.8), wallCol, W))
	solid(Build.part(m, "DoorHeader", V(1.8, 1.2, 0.4), CF(-3.3, 5.0, -4.8), wallCol, W))
	solid(Build.part(m, "FrontWall", V(8.4, 1.8, 0.4), CF(1.8, 1.5, -4.8), wallCol, W))
	solid(Build.part(m, "FrontHeader", V(8.4, 1.2, 0.4), CF(1.8, 5.0, -4.8), wallCol, W))
	Build.part(m, "WindowPost", V(0.3, 2.0, 0.3), CF(1.8, 3.4, -4.8), trim, W)
	solid(Build.part(m, "Counter", V(8.6, 0.2, 1.0), CF(1.8, 2.5, -5.1), trim, W))
	local ra, rb =
		Build.tri(m, "Roof", CF(0, 7.0, 0) * CFrame.Angles(0, PI / 2, 0), 11.5, 2.8, 13, rgb(225, 185, 105), M.Fabric)
	solid(ra)
	solid(rb)
	local sign = Build.part(m, "SignBoard", V(6, 1.3, 0.3), CF(1.2, 6.25, -5.35), trim, W)
	Build.label(sign, Enum.NormalId.Front, "SURF SHACK", WHITE)
	local boards = { { rgb(255, 120, 60), WHITE }, { rgb(60, 190, 255), rgb(255, 230, 70) } }
	for i, x in { -5.3, 5.3 } do
		local cf = CF(x, 3.4, -5.35) * CFrame.Angles(0.12, 0, 0)
		Build.ellipsoid(m, "Surfboard", V(1.4, 5.5, 0.25), cf, boards[i][1])
		Build.ellipsoid(m, "SurfboardStripe", V(0.3, 5.2, 0.28), cf, boards[i][2])
	end
	solid(Build.part(m, "Step", V(3, 0.3, 1), CF(-3.3, 0.15, -5.4), WOOD_DARK, W))
	local lamp = Build.ball(m, "Lantern", 0.5, CF(-3.3, 4.1, -5.3), rgb(255, 230, 160), M.Neon)
	Build.glow(lamp, rgb(255, 220, 160), 1, 14)
end

local function fallback(m: Model, _v: number)
	solid(Build.part(m, "Crate", V(2, 2, 2), CF(0, 1, 0), WOOD, M.Wood))
	for _, y in { 0.35, 1.65 } do
		Build.part(m, "Band", V(2.04, 0.2, 2.04), CF(0, y, 0), WOOD_DARK, M.Wood)
	end
end

local ORDER = {
	"PalmTree",
	"Umbrella",
	"BeachTowel",
	"Sandcastle",
	"Crab",
	"LifeguardTower",
	"BoardwalkStall",
	"Surfboard",
	"BeachBall",
	"Rock",
	"Shell",
	"Chest",
	"Bucket",
	"Sign",
	"Lamp",
	"Bench",
	"Barrel",
	"Starfish",
	"Dock",
	"Flag",
	"Cooler",
	"SurfShack",
}

local function key(name: string): string
	return (string.gsub(string.lower(name), "[%s_%-]", ""))
end

local byKey: { [string]: string } = {}
for _, name in ORDER do
	byKey[key(name)] = name
end

function Props.Build(name: string, variant: number?): Model
	local canonical = byKey[key(name)]
	local m = Build.model(canonical or name)
	Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local v = math.max(1, math.floor(variant or 1))
	local builder: PropBuilder = if canonical then builders[canonical] else fallback
	builder(m, v)
	return m
end

function Props.List(): { string }
	return table.clone(ORDER)
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Rides</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Rides — the full-size ride-on vehicle for rideable pets (v2.1, Ride agent). Built from
	primitives only (Build.luau style, no asset ids). Currently every rideable pet is drawn as a
	big cartoon excavator (~18 studs nose to tail, tracks 12 long, roof ~10.6 high); VehicleKind
	other than "Excavator" falls back to it.

	Conventions (differ from the other builders because this model is DRIVEN by physics):
	- Front is -Z, up is +Y. PrimaryPart = invisible "Root" at the bottom-centre (pivot on the
	  ground under the tracks). Returned unparented with every part Anchored; RideService
	  unanchors it, so everything is joined: static parts WeldConstraint'ed to Root, moving
	  parts welded to their hinge, hinges joined by Motor6Ds.
	- "Chassis": the ONLY colliding part, an invisible hull (y 0.9..3.5, 8.9 x 11.6) that carries
	  the mass. It sits ~0.9 above the ground so it never drags on the sand. Every visible part is
	  Massless, CanCollide / CanQuery / CanTouch false.
	- "RideSeat" (Seat): CanTouch false so passers-by never sit down by touching it; RideService
	  seats the owner with Seat:Sit(humanoid).
	- Drive constraints in Root: Attachment "RideAttachment", AlignPosition "RideAlignPosition"
	  and AlignOrientation "RideAlignOrientation" (both OneAttachment). RideService sets the
	  initial targets and force; the rider's client (network owner) moves the targets.
	- Animated digging arm (RideController): Root -> Motor6D "BoomMotor" -> Model "Boom"
	  (PrimaryPart "BoomHinge") -> "StickMotor" -> Model "Stick" ("StickHinge") ->
	  "BucketMotor" -> Model "Bucket" ("BucketHinge"). Animate Motor6D.Transform with rotations
	  about the hinge's X axis (positive = raise the front). Part "BucketSand" (Transparency 1)
	  can be shown while the bucket carries a load.
	- Model attributes: "PetId", "VehicleKind".
]]

local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Rides = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis
local SMOOTH = Enum.Material.SmoothPlastic
local METAL = Enum.Material.Metal
local GLASS = Enum.Material.Glass
local NEON = Enum.Material.Neon

local TYRE = Color3.fromRGB(40, 38, 45)
local STEEL = Color3.fromRGB(150, 155, 165)
local DARK = Color3.fromRGB(60, 60, 70)
local SAND = Color3.fromRGB(240, 205, 130)
local DEFAULT_BODY = Color3.fromRGB(255, 190, 20)
local DEFAULT_ACCENT = Color3.fromRGB(255, 90, 160)

-- Geometry the services / controller rely on (studs, model space).
Rides.HULL_SIZE = V(8.9, 2.6, 11.6)
Rides.HULL_Y = 2.2 -- hull centre height above the pivot
Rides.SEAT_POSITION = V(-1.9, 5.7, 0)
Rides.BUCKET_TIP = V(1.6, 2.0, -11.2) -- bucket teeth at rest

-- Weld every BasePart that is a DIRECT child of `group` to `hinge`.
local function weldGroup(group: Instance, hinge: BasePart)
	for _, child in group:GetChildren() do
		if child:IsA("BasePart") and child ~= hinge then
			local w = Instance.new("WeldConstraint")
			w.Part0 = hinge
			w.Part1 = child
			w.Parent = child
		end
	end
end

-- Moving sub-assembly: Model `name` with an invisible hinge part as PrimaryPart.
local function group(parent: Instance, name: string, hinge: CFrame): (Model, Part)
	local g = Instance.new("Model")
	g.Name = name
	local h = Build.part(g, name .. "Hinge", V(0.4, 0.4, 0.4), hinge, Color3.new(1, 1, 1))
	h.Transparency = 1
	h.CastShadow = false
	g.PrimaryPart = h
	g.Parent = parent
	return g, h
end

local function motor(name: string, part0: BasePart, part1: BasePart): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = part0.CFrame:ToObjectSpace(part1.CFrame)
	m.C1 = CFrame.identity
	m.Parent = part1
	return m
end

local function track(parent: Instance, x: number)
	local length, height, width = 12, 2.2, 1.9
	local y = height / 2
	local inner = length - height
	Build.part(parent, "Track", V(width, height, inner), CF(x, y, 0), TYRE)
	for _, z in { -inner / 2, inner / 2 } do
		Build.cyl(parent, "Track", width, height, Build.orient(V(x, y, z), X), TYRE)
	end
	local side = if x >= 0 then 1 else -1
	-- road wheels on the outside + cleats on top
	for i = 0, 4 do
		local z = -inner / 2 + inner * i / 4
		Build.cyl(parent, "Roller", 0.12, 1.3, Build.orient(V(x + side * (width / 2 + 0.04), y, z), X), STEEL, METAL)
	end
	for i = 0, 6 do
		local z = -inner / 2 + inner * i / 6
		Build.part(parent, "Cleat", V(width + 0.06, 0.18, 0.4), CF(x, height + 0.05, z), DARK)
	end
end

local function build(m: Model, root: BasePart, body: Color3, accent: Color3, glow: boolean)
	-- Collision hull (the only colliding part; carries the mass)
	local hull = Build.part(m, "Chassis", Rides.HULL_SIZE, CF(0, Rides.HULL_Y, 0), body)
	hull.Transparency = 1
	hull.CanCollide = true
	hull.CastShadow = false
	hull.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0, 1, 1)

	-- Undercarriage
	for side = -1, 1, 2 do
		track(m, side * 3.5)
	end
	Build.part(m, "Frame", V(5, 1.2, 9), CF(0, 1.6, 0), DARK)
	Build.cyl(m, "Turntable", 0.4, 5, CF(0, 2.4, 0.4), STEEL, METAL)

	-- House: body, accent stripe, counterweight, engine
	local house = Build.part(m, "Body", V(7.2, 2.8, 7.4), CF(0, 4.0, 1.2), body)
	Build.part(m, "Stripe", V(7.3, 0.4, 7.5), CF(0, 4.7, 1.2), accent, if glow then NEON else SMOOTH)
	Build.part(m, "Counterweight", V(7.2, 2.2, 1.4), CF(0, 3.9, 5.6), Build.darken(body, 0.25))
	Build.part(m, "EngineGrille", V(0.1, 1.2, 2.6), CF(3.62, 4.0, 3.2), DARK, METAL)
	Build.cyl(m, "Exhaust", 2.4, 0.45, CF(2.6, 6.6, 4.2), DARK, METAL)
	Build.cyl(m, "Exhaust", 0.2, 0.6, CF(2.6, 7.8, 4.2), Color3.fromRGB(35, 35, 40), METAL)
	Build.face(m, CF(-1.9, 3.9, -2.52) * CFrame.Angles(0, 0, 0), 2.4, { radius = 0 })

	-- Open cab (canopy on four posts) so the rider stays visible
	Build.part(m, "CabFloor", V(3.4, 0.2, 3.8), CF(-1.9, 5.5, -0.5), Build.darken(body, 0.15))
	for _, x in { -3.45, -0.35 } do
		for _, z in { -2.25, 1.25 } do
			Build.cyl(m, "CabPost", 4.6, 0.3, CF(x, 7.9, z), DARK, METAL)
		end
	end
	Build.part(m, "CabRoof", V(3.8, 0.4, 4.2), CF(-1.9, 10.4, -0.5), body)
	Build.part(m, "RoofStripe", V(3.85, 0.15, 1.0), CF(-1.9, 10.6, -0.5), accent)
	local windshield =
		Build.part(m, "Windshield", V(3.0, 2.4, 0.12), CF(-1.9, 8.8, -2.3), Color3.fromRGB(150, 220, 255), GLASS)
	windshield.Transparency = 0.65
	local beacon = Build.ball(m, "Beacon", 0.6, CF(-1.9, 10.85, -0.5), Color3.fromRGB(255, 160, 30), NEON)
	if glow then
		Build.glow(beacon, accent, 1.2, 12)
		Build.sparkle(house, accent, 2)
	end
	-- seat + back + levers
	local seat = Instance.new("Seat")
	seat.Name = "RideSeat"
	seat.Size = V(2.2, 0.5, 2.2)
	seat.CFrame = CF(Rides.SEAT_POSITION)
	seat.Color = DARK
	seat.Material = SMOOTH
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.BottomSurface = Enum.SurfaceType.Smooth
	seat.Anchored = true
	seat.CanCollide = false
	seat.CanQuery = false
	seat.CanTouch = false -- only Seat:Sit(owner) seats anyone
	seat.Parent = m
	Build.part(m, "SeatBack", V(2.2, 2.0, 0.4), CF(-1.9, 6.9, 1.05), DARK)
	for side = -1, 1, 2 do
		Build.cylBetween(
			m,
			"Lever",
			V(-1.9 + side * 0.7, 5.7, -1.6),
			V(-1.9 + side * 0.7, 7.0, -1.3),
			0.14,
			STEEL,
			METAL
		)
		Build.ball(m, "LeverKnob", 0.32, CF(-1.9 + side * 0.7, 7.05, -1.28), accent)
	end

	-- Digging arm: boom -> stick -> bucket
	local foot = V(1.6, 5.0, -2.2)
	local elbow = V(1.6, 10.0, -7.0)
	local wrist = V(1.6, 4.2, -10.0)
	local boom, boomHinge = group(m, "Boom", CF(foot))
	Build.beam(boom, "BoomBeam", foot, elbow, 1.0, 0.9, body, SMOOTH, X)
	Build.cylBetween(boom, "Piston", foot + V(0, -0.8, -0.4), foot:Lerp(elbow, 0.55) + V(0, -0.6, 0), 0.4, STEEL, METAL)
	Build.ball(boom, "BoomFoot", 1.2, CF(foot), accent, METAL)
	local stick, stickHinge = group(boom, "Stick", CF(elbow))
	Build.beam(stick, "StickBeam", elbow, wrist, 0.8, 0.8, body, SMOOTH, X)
	Build.ball(stick, "Elbow", 1.2, CF(elbow), accent, METAL)
	Build.cylBetween(stick, "Piston", elbow + V(0, 0.6, 0.5), wrist + V(0, 1.6, 0.6), 0.32, STEEL, METAL)
	local bucket, bucketHinge = group(stick, "Bucket", CF(wrist))
	local bk = CF(wrist) * CFrame.Angles(-0.35, 0, 0)
	Build.part(bucket, "BucketBottom", V(2.8, 0.2, 2.0), bk * CF(0, -1.7, -0.9), accent, METAL)
	Build.part(bucket, "BucketBack", V(2.8, 1.9, 0.2), bk * CF(0, -0.8, 0.1), accent, METAL)
	for side = -1, 1, 2 do
		Build.part(bucket, "BucketSide", V(0.2, 1.9, 2.0), bk * CF(side * 1.4, -0.8, -0.9), accent, METAL)
	end
	for i = 0, 3 do
		local x = -1.05 + i * 0.7
		local base = (bk * CF(x, -1.7, -1.85)).Position
		local tip = (bk * CF(x, -1.75, -2.45)).Position
		Build.spike(bucket, "Tooth", base, tip, 0.35, STEEL, METAL)
	end
	Build.ball(bucket, "Wrist", 0.9, CF(wrist), accent, METAL)
	local load =
		Build.ellipsoid(bucket, "BucketSand", V(2.4, 1.0, 1.6), bk * CF(0, -1.2, -0.9), SAND, Enum.Material.Sand)
	load.Transparency = 1

	-- Joints: statics -> Root, groups -> their hinge, hinges -> Motor6D chain
	weldGroup(m, root)
	weldGroup(boom, boomHinge)
	weldGroup(stick, stickHinge)
	weldGroup(bucket, bucketHinge)
	motor("BoomMotor", root, boomHinge)
	motor("StickMotor", boomHinge, stickHinge)
	motor("BucketMotor", stickHinge, bucketHinge)

	-- Only the hull has mass; nothing else collides or blocks raycasts.
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d ~= hull then
			d.Massless = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end

	-- Drive constraints (targets + force set by RideService / RideController)
	local attachment = Instance.new("Attachment")
	attachment.Name = "RideAttachment"
	attachment.Parent = root
	local alignPosition = Instance.new("AlignPosition")
	alignPosition.Name = "RideAlignPosition"
	alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPosition.Attachment0 = attachment
	alignPosition.ApplyAtCenterOfMass = true
	alignPosition.Responsiveness = Config.Ride.Responsiveness
	alignPosition.MaxVelocity = Config.Ride.MaxSpeed * 2
	alignPosition.MaxForce = 1e6
	alignPosition.Parent = root
	local alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Name = "RideAlignOrientation"
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.Attachment0 = attachment
	alignOrientation.Responsiveness = Config.Ride.Responsiveness
	alignOrientation.MaxTorque = 1e9
	alignOrientation.MaxAngularVelocity = 6
	alignOrientation.Parent = root
end

function Rides.Build(petId: string): Model
	local def = Config.GetPet(petId)
	if not def then
		for _, candidate in Config.Pets do
			if candidate.Id == petId then
				def = candidate
				break
			end
		end
	end
	local look = if def then def.Look else nil
	local body = if look then look.BodyColor else DEFAULT_BODY
	local accent = if look then look.AccentColor else DEFAULT_ACCENT
	local glow = if look then look.Glow == true else false
	local kind = if def and def.VehicleKind then def.VehicleKind else "Excavator"

	local m = Build.model("Ride_" .. petId)
	m:SetAttribute("PetId", petId)
	m:SetAttribute("VehicleKind", kind)
	local root = Build.root(m, CFrame.identity, V(1, 0.2, 1))
	build(m, root, body, accent, glow)
	return m
end

return Rides
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Shades</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Shades — placeable shade items (Config.Shades), chunky low-poly cartoon style.
	PrimaryPart = invisible "Root" at the bottom-centre (the ground point under the pole).
	Front is -Z. Everything is anchored; only the poles/posts are CanCollide (players walk under
	the canopy and bump into the poles). The canopy underside sits at ShadeDef.Height studs so it
	visibly covers the shaded circle (gameplay Radius is a little wider than the cloth).
	Model attributes: ShadeId, Radius, Height (handy for placement ghosts / owner labels).
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local ShadesModels = {}

local V = Vector3.new
local CF = CFrame.new
local rgb = Color3.fromRGB
local PI = math.pi
local M = Enum.Material

local WHITE = rgb(255, 255, 255)
local SAND = rgb(255, 222, 140)
local WOOD = rgb(176, 120, 72)
local WOOD_DARK = rgb(130, 85, 50)
local METAL = rgb(235, 235, 240)
local GOLD = rgb(255, 205, 40)
local STRAW = rgb(225, 190, 110)

local solid = Build.solid

type Look = { Color: Color3, Accent: Color3 }
type Builder = (m: Model, def: Types.ShadeDef, look: Look) -> ()

-- Faceted cone / pyramid roof: n triangles from the rim (circumradius R at height rimY) to the
-- apex. `offset` rotates the facets (-PI/4 with n = 4 gives an axis-aligned square roof).
local function roof(
	m: Model,
	name: string,
	centre: Vector3,
	rimY: number,
	apexY: number,
	R: number,
	n: number,
	offset: number,
	colors: { Color3 },
	material: Enum.Material?
): { { Base: Vector3, Tangent: Vector3, Width: number } }
	local apex = centre + V(0, apexY, 0)
	local apothem = R * math.cos(PI / n)
	local width = 2 * R * math.sin(PI / n)
	local edges = {}
	for k = 0, n - 1 do
		local a = offset + (k + 0.5) / n * PI * 2
		local base = centre + V(apothem * math.cos(a), rimY, apothem * math.sin(a))
		local tangent = V(-math.sin(a), 0, math.cos(a))
		Build.triPts(m, name, base, apex, tangent, width + 0.06, 0.14, colors[k % #colors + 1], material)
		table.insert(edges, { Base = base, Tangent = tangent, Width = width })
	end
	return edges
end

-- Hanging valance / scallops along every roof edge.
local function valance(
	m: Model,
	edges: { { Base: Vector3, Tangent: Vector3, Width: number } },
	depth: number,
	colors: { Color3 },
	scallops: number,
	material: Enum.Material?
)
	for i, e in edges do
		local strip = e.Width / scallops
		for s = 0, scallops - 1 do
			local along = (s + 0.5) * strip - e.Width / 2
			local pos = e.Base + e.Tangent * along - V(0, depth / 2, 0)
			local col = colors[(i + s) % #colors + 1]
			local cf = CFrame.fromMatrix(pos, e.Tangent, Vector3.yAxis)
			-- little pennant: a block with a downward triangle tip
			Build.part(m, "Valance", V(strip * 0.96, depth * 0.55, 0.1), cf * CF(0, depth * 0.22, 0), col, material)
			Build.tri(
				m,
				"Valance",
				cf * CF(0, -depth * 0.28, 0) * CFrame.Angles(0, 0, PI),
				strip * 0.96,
				depth * 0.45,
				0.1,
				col,
				material
			)
		end
	end
end

local function pole(m: Model, a: Vector3, b: Vector3, d: number, color: Color3, material: Enum.Material?): BasePart
	return solid(Build.cylBetween(m, "Pole", a, b, d, color, material))
end

local function mound(m: Model, size: number)
	Build.ellipsoid(m, "Mound", V(size, size * 0.3, size), CF(), SAND, M.Sand)
end

-- Builders ----------------------------------------------------------------------------------------

local builders: { [string]: Builder } = {}

builders.Umbrella = function(m, def, look)
	local H = def.Height
	local R = def.Radius * 0.75
	mound(m, 1.6)
	pole(m, V(0, 0, 0), V(0, H + 1.6, 0), 0.32, METAL)
	local edges = roof(m, "Canopy", Vector3.zero, H, H + 1.5, R, 10, 0, { look.Color, look.Accent }, M.Fabric)
	valance(m, edges, 0.5, { look.Color, look.Accent }, 1, M.Fabric)
	Build.ball(m, "Finial", 0.5, CF(0, H + 1.75, 0), look.Color)
	-- hub ring + a few ribs under the canopy
	Build.cyl(m, "Hub", 0.35, 0.6, CF(0, H - 0.4, 0), WHITE)
end

builders.Striped = function(m, def, look)
	local H = def.Height
	local R = def.Radius * 0.72
	mound(m, 1.8)
	for i = 0, 3 do
		local y0 = i * (H + 1.6) / 4
		local y1 = (i + 1) * (H + 1.6) / 4
		pole(m, V(0, y0, 0), V(0, y1, 0), 0.36, if i % 2 == 0 then WHITE else look.Color)
	end
	local stripes = { look.Color, WHITE, look.Accent, WHITE }
	local edges = roof(m, "Canopy", Vector3.zero, H, H + 1.8, R, 12, 0, stripes, M.Fabric)
	valance(m, edges, 0.6, { look.Accent, look.Color }, 2, M.Fabric)
	Build.ball(m, "Finial", 0.6, CF(0, H + 2.05, 0), look.Accent)
	Build.cyl(m, "Hub", 0.4, 0.7, CF(0, H - 0.4, 0), WHITE)
end

builders.Tarp = function(m, def, look)
	local H = def.Height
	local sx, sz = def.Radius * 0.6, def.Radius * 0.5
	local corners = { V(-sx, 0, -sz), V(sx, 0, -sz), V(-sx, 0, sz), V(sx, 0, sz) }
	for i, c in corners do
		local top = H + (if c.Z < 0 then 0.9 else 0) -- front edge higher: slanted tarp
		pole(m, c, c + V(0, top + 0.4, 0), 0.5, if i % 2 == 0 then WOOD else WOOD_DARK, M.Wood)
		Build.ball(m, "PoleCap", 0.6, CF(c + V(0, top + 0.45, 0)), WOOD_DARK, M.Wood)
		-- guy rope to a stake outside the corner
		local out = V(math.sign(c.X), 0, math.sign(c.Z))
		local stake = c + out * 2.2
		Build.cylBetween(m, "Rope", c + V(0, top, 0), stake + V(0, 0.4, 0), 0.08, rgb(240, 230, 200))
		Build.part(m, "Stake", V(0.3, 0.8, 0.3), CF(stake + V(0, 0.3, 0)), WOOD_DARK, M.Wood)
	end
	-- tarp sheet, tilted (front higher)
	local front = V(0, H + 0.9, -sz)
	local back = V(0, H, sz)
	local mid = front:Lerp(back, 0.5)
	local depth = (back - front).Magnitude
	local tarpCf = CFrame.lookAt(mid, mid + (back - front), Vector3.yAxis)
	Build.part(m, "Tarp", V(sx * 2 + 1.2, 0.18, depth + 1.2), tarpCf, look.Color, M.Fabric)
	-- two lighter stripes across the sheet
	for _, t in { -0.25, 0.25 } do
		Build.part(
			m,
			"TarpStripe",
			V(sx * 2 + 1.22, 0.2, 0.9),
			tarpCf * CF(0, 0, t * depth),
			Build.lighten(look.Color, 0.45),
			M.Fabric
		)
	end
	-- palm leaves tucked on top for the island look
	for k = 0, 2 do
		local a = k / 3 * PI * 2 + 0.3
		local base = mid + V(0, 0.25, 0)
		local tip = base + V(math.cos(a) * 3.2, 0.3, math.sin(a) * 3.2)
		Build.triPts(m, "Leaf", base, tip, V(-math.sin(a), 0, math.cos(a)), 1.3, 0.12, rgb(70, 190, 95))
	end
end

builders.Canopy = function(m, def, look)
	local H = def.Height
	local s = def.Radius * 0.62
	for _, c in { V(-s, 0, -s), V(s, 0, -s), V(-s, 0, s), V(s, 0, s) } do
		pole(m, c, c + V(0, H + 0.2, 0), 0.4, METAL, M.Metal)
		Build.part(m, "Foot", V(0.9, 0.2, 0.9), CF(c + V(0, 0.1, 0)), rgb(120, 120, 130), M.Metal)
	end
	-- frame
	for _, pair in { { V(-s, H, -s), V(s, H, -s) }, { V(-s, H, s), V(s, H, s) } } do
		Build.cylBetween(m, "Frame", pair[1], pair[2], 0.25, METAL, M.Metal)
	end
	for _, pair in { { V(-s, H, -s), V(-s, H, s) }, { V(s, H, -s), V(s, H, s) } } do
		Build.cylBetween(m, "Frame", pair[1], pair[2], 0.25, METAL, M.Metal)
	end
	local R = s / math.cos(PI / 4)
	local edges = roof(m, "Canopy", Vector3.zero, H + 0.1, H + 2.6, R, 4, -PI / 4, { look.Color }, M.Fabric)
	valance(m, edges, 0.9, { look.Color, look.Accent }, 6, M.Fabric)
	-- bunting between front poles
	local n = 7
	for i = 0, n - 1 do
		local t = (i + 0.5) / n
		local x = -s + t * 2 * s
		local sag = math.sin(t * PI) * 0.7
		local col = ({ rgb(255, 90, 90), rgb(255, 210, 60), rgb(60, 170, 255), rgb(90, 210, 120) })[i % 4 + 1]
		Build.tri(m, "Bunting", CF(x, H - 1.2 - sag, -s - 0.1) * CFrame.Angles(0, 0, PI), 0.8, 0.8, 0.08, col)
	end
	Build.cylBetween(m, "BuntingRope", V(-s, H - 0.75, -s - 0.1), V(s, H - 0.75, -s - 0.1), 0.05, WHITE)
end

builders.Cabana = function(m, def, look)
	local H = def.Height
	local s = def.Radius * 0.55
	for _, c in { V(-s, 0, -s), V(s, 0, -s), V(-s, 0, s), V(s, 0, s) } do
		pole(m, c, c + V(0, H + 0.4, 0), 0.8, WOOD, M.Wood)
		-- tied-back curtain on each post
		local inward = -V(math.sign(c.X), 0, math.sign(c.Z)) * 0.6
		Build.part(
			m,
			"Curtain",
			V(0.9, H - 1.4, 0.9),
			CF(c + inward + V(0, (H - 1.4) / 2 + 0.9, 0)),
			look.Accent,
			M.Fabric
		)
		Build.cyl(m, "Tie", 0.3, 1.05, CF(c + inward + V(0, H * 0.45, 0)), GOLD)
	end
	-- beams
	for _, pair in { { V(-s, H, -s), V(s, H, -s) }, { V(-s, H, s), V(s, H, s) } } do
		Build.beam(m, "Beam", pair[1], pair[2], 0.7, 0.7, WOOD_DARK, M.Wood, Vector3.zAxis)
	end
	-- thatched pyramid roof (two layers for a chunky straw look)
	local R = (s + 1.4) / math.cos(PI / 4)
	local edges =
		roof(m, "Thatch", Vector3.zero, H + 0.3, H + 4, R, 4, -PI / 4, { STRAW, Build.darken(STRAW, 0.1) }, M.Grass)
	roof(m, "Thatch", Vector3.zero, H + 1.6, H + 4.4, R * 0.62, 4, -PI / 4, { Build.lighten(STRAW, 0.1) }, M.Grass)
	valance(m, edges, 0.9, { Build.darken(STRAW, 0.15), STRAW }, 7, M.Grass)
	-- tiki top + rug
	Build.ball(m, "Topper", 0.9, CF(0, H + 4.3, 0), rgb(255, 120, 60))
	Build.part(m, "Rug", V(s * 1.6, 0.08, s * 1.6), CF(0, 0.05, 0), look.Accent, M.Fabric)
	Build.part(m, "RugStripe", V(s * 1.62, 0.09, 0.6), CF(0, 0.06, 0), WHITE, M.Fabric)
end

builders.Tent = function(m, def, look)
	local H = def.Height
	local R = def.Radius * 0.62
	local n = 8
	pole(m, V(0, 0, 0), V(0, H + 3.4, 0), 0.5, GOLD, M.Metal)
	for k = 0, n - 1 do
		local a = (k / n) * PI * 2
		local c = V(math.cos(a) * R, 0, math.sin(a) * R)
		pole(m, c, c + V(0, H, 0), 0.38, GOLD, M.Metal)
		Build.ball(m, "PoleCap", 0.6, CF(c + V(0, H + 0.1, 0)), GOLD, M.Metal)
		-- drapes on alternating poles
		if k % 2 == 0 then
			Build.part(
				m,
				"Drape",
				V(1.1, H - 1, 0.25),
				CFrame.lookAt(c + V(0, (H - 1) / 2 + 0.8, 0), V(0, (H - 1) / 2 + 0.8, 0)) * CF(0, 0, 0.4),
				Build.darken(look.Color, 0.05),
				M.Fabric
			)
		end
	end
	-- the polygon roof: corners at the poles (offset so facets meet at pole tops)
	local edges = roof(
		m,
		"Canopy",
		Vector3.zero,
		H,
		H + 3.2,
		R,
		n,
		-PI / n,
		{ look.Color, Build.darken(look.Color, 0.06) },
		M.Fabric
	)
	valance(m, edges, 0.8, { look.Accent, look.Color }, 3, M.Fabric)
	Build.ball(m, "Finial", 0.9, CF(0, H + 3.6, 0), GOLD, M.Metal)
	Build.part(m, "Flag", V(0.08, 0.7, 1.2), CF(0, H + 4.6, 0.6), rgb(255, 90, 120), M.Fabric)
	Build.cylBetween(m, "FlagPole", V(0, H + 3.6, 0), V(0, H + 5.1, 0), 0.1, GOLD)
end

builders.Pavilion = function(m, def, look)
	local H = def.Height
	local R = def.Radius * 0.58
	local n = 8
	-- low marble-ish base ring (decorative, non-colliding so you can walk on the sand)
	Build.cyl(m, "Base", 0.3, R * 2 + 1.5, CF(0, 0.15, 0), rgb(245, 235, 215), M.Marble)
	for k = 0, n - 1 do
		local a = (k / n) * PI * 2
		local c = V(math.cos(a) * R, 0, math.sin(a) * R)
		pole(m, c, c + V(0, H, 0), 1, rgb(250, 245, 235), M.Marble)
		Build.part(m, "Capital", V(1.6, 0.5, 1.6), CF(c + V(0, H + 0.1, 0)), GOLD, M.Metal)
		Build.part(m, "Plinth", V(1.6, 0.5, 1.6), CF(c + V(0, 0.45, 0)), GOLD, M.Metal)
	end
	-- ring beam
	for k = 0, n - 1 do
		local a0 = (k / n) * PI * 2
		local a1 = ((k + 1) / n) * PI * 2
		local p0 = V(math.cos(a0) * R, H + 0.5, math.sin(a0) * R)
		local p1 = V(math.cos(a1) * R, H + 0.5, math.sin(a1) * R)
		Build.beam(m, "RingBeam", p0, p1, 0.8, 0.8, GOLD, M.Metal)
	end
	-- two-tier roof
	local edges = roof(
		m,
		"Roof",
		Vector3.zero,
		H + 0.8,
		H + 3.4,
		R + 1.4,
		n,
		-PI / n,
		{ look.Color, Build.darken(look.Color, 0.12) },
		M.Fabric
	)
	valance(m, edges, 0.9, { look.Accent, look.Color }, 3, M.Fabric)
	roof(m, "Roof", Vector3.zero, H + 3, H + 5.4, R * 0.55, n, -PI / n, { look.Color }, M.Fabric)
	-- crown
	Build.ball(m, "Orb", 1.4, CF(0, H + 5.8, 0), GOLD, M.Metal)
	for k = 0, 4 do
		local a = (k / 5) * PI * 2
		Build.spike(
			m,
			"CrownSpike",
			V(math.cos(a) * 0.5, H + 6.1, math.sin(a) * 0.5),
			V(math.cos(a) * 0.7, H + 7.1, math.sin(a) * 0.7),
			0.5,
			GOLD,
			M.Metal
		)
	end
	local gem = Build.ball(m, "Gem", 0.5, CF(0, H + 6.6, 0), rgb(255, 80, 200), M.Neon)
	Build.glow(gem, rgb(255, 120, 220), 1, 10)
end

local function fallback(m: Model, def: Types.ShadeDef, look: Look)
	builders.Umbrella(m, def, look)
end

-- Public --------------------------------------------------------------------------------------------

local DEFAULT_DEF: Types.ShadeDef = {
	Id = "unknown",
	Name = "Shade",
	Price = 0,
	Radius = 6,
	Cooling = 1,
	Height = 7.5,
	Description = "",
	Look = {},
}

function ShadesModels.Build(id: string): Model
	local def = Config.GetShade(id) or DEFAULT_DEF
	local m = Build.model(id)
	Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local raw = def.Look
	local look: Look = {
		Color = if typeof(raw.Color) == "Color3" then raw.Color else rgb(255, 80, 90),
		Accent = if typeof(raw.Accent) == "Color3" then raw.Accent else WHITE,
	}
	local style = if type(raw.Style) == "string" then raw.Style else "Umbrella"
	local builder: Builder = builders[style] or fallback
	builder(m, def, look)
	m:SetAttribute("ShadeId", id)
	m:SetAttribute("Radius", def.Radius)
	m:SetAttribute("Height", def.Height)
	return m
end

return ShadesModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Shovels</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Shovels — held tools. Built in "tool space": origin at the top end of the shaft (the end
	away from the head), shaft along +Y towards the head, blade plane = XY. The blade's cupped
	(scooping) face is +Z, its "dig" edge/back is -Z.

	Two sizes (Look.Size, Types.ShovelSize):
	  "Hand"  small one-handed hand spade / trowel (~1.9 studs): short grip, scaled-down head.
	  "Full"  (default) full-size shovel held with BOTH hands: D-grip (Spade/Scoop/Trowel heads)
	          or T-grip (Pick/Claw/Trident/Drill) on top, a foam sleeve on the shaft for the
	          left hand, head at the far end.

	PrimaryPart = Part "Handle" (the top grip section). Every other part is welded to it with a
	WeldConstraint, Massless, CanCollide false, and still Anchored (the server unanchors).

	Handle attributes (all vectors / points in HANDLE space):
	  GripOffset  CFrame   -> Tool.Grip (the right palm frame, see below)
	  TwoHanded   boolean  full-size tool (ShopService copies it onto the Tool)
	  ShaftAxis   Vector3  tool +Y (top grip -> head)
	  CupAxis     Vector3  tool +Z (the blade's cupped face)
	  LeftHand    Vector3  where the left palm grips the shaft (two-handed tools only)
	  BladePoint  Vector3  centre of the blade's cupped face (the client rides a sand clump here)
	The client ShovelPoseController reads these to pose both arms and play the scoop.

	Grip math (verified against the engine's tool weld):
	  When a Tool is equipped the engine makes Weld "RightGrip": Part0 = RightHand (R15) /
	  Right Arm (R6), C0 = RightGripAttachment.CFrame (R15: CFrame.new(0, -0.15, 0) *
	  Angles(-90deg, 0, 0); R6: CFrame.new(0, -1, 0) * the same rotation), Part1 = Handle,
	  C1 = Tool.Grip. Weld rule: Hand * C0 == Handle * Grip, so
	      Handle = (Hand * C0) * Grip:Inverse()          -- call Hand * C0 the palm frame G.
	  G's axes, read on the R15 hand: G.Y = hand -Z (the fist axis, out of the thumb side),
	  G.Z = hand +Y (from the palm back towards the wrist / forearm), G.X = hand +X (the back of
	  the right hand). In the default "toolnone" hold animation (forearm pointing forward)
	  G's axes are the CHARACTER's axes (X right, Y up, Z back). Grip = G expressed in Handle
	  space = Handle:ToObjectSpace(T), with T = the palm frame written in tool space:
	  * Hand tools: T = CFrame.new(0, HAND_PALM_Y, 0) * HoldRotation:Inverse(), HoldRotation =
	    Ry(+INWARD) * Rx(-(90deg + DOWN)): in the plain hold pose the shaft runs down and forward
	    from the fist (DOWN = 55deg below horizontal, yawed INWARD 10deg), cup face up/forward.
	    The pose controller only takes over during a scoop, so this is also the idle look.
	  * Full tools: the right palm wraps the grip crossbar: fist axis G.Y = tool -X (along the
	    crossbar), forearm G.Z = tool -Y (straight in line with the shaft, so the wrist stays
	    straight), back of the hand G.X = tool +Z (overhand grip, knuckles on the cup side).
	    T = CFrame.fromMatrix((0, palmY, 0), +Z, -X, -Y). Without the pose controller (R6
	    avatars) the shovel simply points forward from the fist.
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Shovels = {}

-- Hand tools ------------------------------------------------------------------------------------
local HAND_PALM_Y = 0.38 -- palm on the middle of the short grip
local HAND_GRIP_LEN = 0.75
local HAND_HB = 1.05 -- head base
local HAND_HEAD_SCALE = 0.55 -- head builders are full size; hand tools shrink them
local HOLD_DOWN = math.rad(55) -- shaft angle below horizontal in the plain hold pose
local HOLD_INWARD = math.rad(10) -- yaw towards the body centre
local HOLD_ROTATION = CFrame.Angles(0, HOLD_INWARD, 0) * CFrame.Angles(-(math.pi / 2 + HOLD_DOWN), 0, 0)

-- Full (two-handed) tools -----------------------------------------------------------------------
local FULL_HANDLE_LEN = 1.0 -- Handle part: the shaft's top section
local FULL_SHAFT_TOP = 2.15
local FULL_HB = 2.4 -- head base (top of collar)
local FULL_LEFT_Y = 0.75 -- left hand on the foam sleeve, ~1.2 studs below the right palm
local D_GRIP_Y = -0.42 -- D-grip crossbar (right palm) above the shaft top
local T_GRIP_Y = -0.16 -- T-grip crossbar sits right on the shaft top
local D_GRIP_SHAPES = { Spade = true, Scoop = true, Trowel = true }

local FALLBACK: Types.ShovelLook = {
	HeadColor = Color3.fromRGB(255, 140, 40),
	HandleColor = Color3.fromRGB(255, 220, 80),
	HeadShape = "Spade",
	Material = Enum.Material.SmoothPlastic,
	Glow = false,
}

local V = Vector3.new
local X = Vector3.xAxis

type HeadBuilder = (m: Model, c: Color3, mat: Enum.Material, look: Types.ShovelLook, hb: number) -> BasePart

local function accent(look: Types.ShovelLook): (Color3, Enum.Material)
	if look.Glow then
		-- Saturated accent (not lightened): pale Neon blooms to white. Build clamps it further.
		return Build.lighten(look.HeadColor, 0.1), Enum.Material.Neon
	end
	return Build.darken(look.HeadColor, 0.25), look.Material
end

local heads: { [string]: HeadBuilder } = {}

heads.Scoop = function(m, c, mat, look, hb)
	Build.part(m, "Neck", V(0.42, 0.45, 0.22), CFrame.new(0, hb, 0), c, mat)
	local blade = Build.part(m, "Blade", V(1.3, 1.25, 0.14), CFrame.new(0, hb + 0.72, 0), c, mat)
	Build.ellipsoid(m, "BladeTip", V(1.3, 0.9, 0.14), CFrame.new(0, hb + 1.34, 0), c, mat)
	local rim = Build.darken(c, 0.12)
	for side = -1, 1, 2 do
		Build.part(
			m,
			"Rim",
			V(0.14, 1.35, 0.34),
			CFrame.new(side * 0.6, hb + 0.78, 0.12) * CFrame.Angles(0, 0, side * 0.05),
			rim,
			mat
		)
	end
	Build.part(m, "BackRim", V(1.3, 0.14, 0.34), CFrame.new(0, hb + 0.1, 0.12), rim, mat)
	if look.Glow then
		local ac, am = accent(look)
		Build.part(m, "GlowStrip", V(0.9, 0.12, 0.17), CFrame.new(0, hb + 0.9, 0), ac, am)
	end
	return blade
end

heads.Trowel = function(m, c, mat, look, hb)
	Build.cyl(m, "Neck", 0.5, 0.26, CFrame.new(0, hb, 0), c, mat)
	local blade = Build.part(m, "Blade", V(0.95, 0.8, 0.1), CFrame.new(0, hb + 0.6, 0), c, mat)
	Build.tri(m, "BladeTip", CFrame.new(0, hb + 1.45, 0), 0.95, 0.9, 0.1, c, mat)
	local ac, am = accent(look)
	Build.part(m, "Ridge", V(0.14, 1.45, 0.16), CFrame.new(0, hb + 0.85, 0), ac, am)
	return blade
end

heads.Spade = function(m, c, mat, look, hb)
	Build.cyl(m, "Socket", 0.7, 0.36, CFrame.new(0, hb + 0.2, 0.02), c, mat)
	local blade = Build.part(m, "Blade", V(1.2, 1.2, 0.14), CFrame.new(0, hb + 0.7, 0), c, mat)
	Build.tri(m, "BladeTip", CFrame.new(0, hb + 1.52, 0), 1.2, 0.45, 0.14, c, mat)
	local ac, am = accent(look)
	Build.part(m, "Tread", V(1.28, 0.14, 0.32), CFrame.new(0, hb + 0.13, 0.04), ac, am)
	if look.Glow then
		Build.part(m, "GlowStrip", V(0.14, 1.0, 0.17), CFrame.new(0, hb + 0.85, 0), ac, am)
	end
	return blade
end

heads.Pick = function(m, c, mat, look, hb)
	Build.cyl(m, "ShaftTop", 0.4, 0.3, CFrame.new(0, hb + 0.1, 0), look.HandleColor)
	local socket = Build.part(m, "Socket", V(0.5, 0.55, 0.6), CFrame.new(0, hb + 0.35, 0), c, mat)
	local mid = V(0, hb + 0.35, 0)
	-- Pointed arm towards -Z (down when held), chisel arm towards +Z; both curve back to the grip.
	local frontElbow = V(0, hb + 0.25, -0.9)
	local backElbow = V(0, hb + 0.25, 0.8)
	Build.beam(m, "Arm", mid, frontElbow, 0.34, 0.34, c, mat, X)
	Build.beam(m, "Arm", mid, backElbow, 0.34, 0.34, c, mat, X)
	Build.spike(m, "Point", frontElbow, V(0, hb - 0.15, -1.55), 0.38, c, mat)
	Build.triPts(m, "Chisel", backElbow, V(0, hb, 1.3), X, 0.5, 0.18, c, mat)
	local ac, am = accent(look)
	Build.part(m, "Band", V(0.56, 0.18, 0.66), CFrame.new(0, hb + 0.35, 0), ac, am)
	return socket
end

heads.Claw = function(m, c, mat, look, hb)
	local palm = Build.ellipsoid(m, "Palm", V(1.05, 0.6, 0.6), CFrame.new(0, hb + 0.2, 0), c, mat)
	local ac, am = accent(look)
	for i = -1, 1 do
		local x = i * 0.36
		local len = if i == 0 then 1.15 else 0.95
		local knuckle = V(x, hb + 0.25, 0)
		local bend = V(x * 1.1, hb + len, -0.12)
		Build.cylBetween(m, "Finger", knuckle, bend, 0.26, c, mat)
		Build.triPts(m, "Talon", bend - V(0, 0.05, 0), V(x * 1.15, hb + len + 0.55, -0.6), X, 0.3, 0.2, ac, am)
	end
	return palm
end

heads.Trident = function(m, c, mat, look, hb)
	Build.cyl(m, "Socket", 0.5, 0.3, CFrame.new(0, hb + 0.05, 0), c, mat)
	local bar = Build.beam(m, "Crossbar", V(-0.68, hb + 0.35, 0), V(0.68, hb + 0.35, 0), 0.24, 0.22, c, mat)
	local ac, am = accent(look)
	Build.cylBetween(m, "Tine", V(0, hb + 0.2, 0), V(0, hb + 1.35, 0), 0.2, c, mat)
	Build.tri(m, "Barb", CFrame.new(0, hb + 1.55, 0), 0.46, 0.5, 0.14, ac, am)
	for side = -1, 1, 2 do
		local x = side * 0.6
		Build.cylBetween(m, "Tine", V(x, hb + 0.3, 0), V(x * 1.05, hb + 1.05, 0), 0.18, c, mat)
		Build.triPts(m, "Barb", V(x * 1.05, hb + 1.0, 0), V(x * 1.1, hb + 1.42, 0), X, 0.36, 0.12, ac, am)
	end
	return bar
end

heads.Drill = function(m, c, mat, look, hb)
	local housing = Build.cyl(m, "Housing", 0.8, 0.9, CFrame.new(0, hb + 0.35, 0), look.HandleColor)
	local ac, am = accent(look)
	local tiers = { 1.0, 0.8, 0.6, 0.4 }
	for i, d in tiers do
		local col = if i % 2 == 1 then c else Build.lighten(c, 0.2)
		Build.cyl(m, "Bit", 0.36, d, CFrame.new(0, hb + 0.45 + i * 0.33, 0) * CFrame.Angles(0, i * 0.4, 0), col, mat)
	end
	Build.spike(m, "Tip", V(0, hb + 1.95, 0), V(0, hb + 2.4, 0), 0.32, ac, am)
	Build.cyl(m, "Band", 0.12, 0.94, CFrame.new(0, hb + 0.35, 0), ac, am)
	return housing
end

-- Builds the head at base height `hb`, scaled by `s` about the head base. Returns the main part.
local function addHead(m: Model, look: Types.ShovelLook, hb: number, s: number): BasePart
	local builder = heads[look.HeadShape] or heads.Spade
	local temp = Build.model("Head")
	local main = builder(temp, look.HeadColor, look.Material, look, hb)
	Build.scale(temp, CFrame.new(0, hb, 0), s)
	for _, child in temp:GetChildren() do
		child.Parent = m
	end
	temp:Destroy()
	if look.Glow then
		Build.glow(main, look.HeadColor, 1.2 * s, 8 * s)
	end
	return main
end

-- Shared finish: attributes, PrimaryPart, massless, welds.
local function finish(
	m: Model,
	handle: BasePart,
	palm: CFrame,
	twoHanded: boolean,
	leftHand: Vector3?,
	bladePoint: Vector3
): Model
	local hcf = handle.CFrame
	handle.CanTouch = true
	handle:SetAttribute("GripOffset", hcf:ToObjectSpace(palm))
	handle:SetAttribute("TwoHanded", twoHanded)
	handle:SetAttribute("ShaftAxis", hcf:VectorToObjectSpace(Vector3.yAxis))
	handle:SetAttribute("CupAxis", hcf:VectorToObjectSpace(Vector3.zAxis))
	if leftHand then
		handle:SetAttribute("LeftHand", hcf:PointToObjectSpace(leftHand))
	end
	handle:SetAttribute("BladePoint", hcf:PointToObjectSpace(bladePoint))
	m.PrimaryPart = handle
	Build.massless(m, handle)
	Build.weldAll(m, handle)
	return m
end

local function buildHand(id: string, look: Types.ShovelLook): Model
	local m = Build.model(id)
	local hc = look.HandleColor
	local trim = Build.darken(hc, 0.25)
	local handle = Build.cyl(m, "Handle", HAND_GRIP_LEN, 0.34, CFrame.new(0, HAND_GRIP_LEN / 2, 0), hc)
	Build.ellipsoid(m, "GripKnob", V(0.42, 0.24, 0.42), CFrame.new(0, 0, 0), trim)
	Build.cyl(m, "GripRing", 0.1, 0.38, CFrame.new(0, HAND_GRIP_LEN, 0), trim)
	Build.cyl(m, "Shaft", HAND_HB - HAND_GRIP_LEN, 0.22, CFrame.new(0, (HAND_HB + HAND_GRIP_LEN) / 2, 0), hc)
	local ac, am = accent(look)
	Build.cyl(m, "Collar", 0.16, 0.28, CFrame.new(0, HAND_HB - 0.06, 0), ac, am)
	addHead(m, look, HAND_HB, HAND_HEAD_SCALE)
	local palm = CFrame.new(0, HAND_PALM_Y, 0) * HOLD_ROTATION:Inverse()
	return finish(m, handle, palm, false, nil, V(0, HAND_HB + 0.75 * HAND_HEAD_SCALE, 0.1))
end

local function buildFull(id: string, look: Types.ShovelLook): Model
	local m = Build.model(id)
	local hc = look.HandleColor
	local trim = Build.darken(hc, 0.25)
	local ac, am = accent(look)

	local handle = Build.cyl(m, "Handle", FULL_HANDLE_LEN, 0.3, CFrame.new(0, FULL_HANDLE_LEN / 2, 0), hc)
	Build.cyl(
		m,
		"Shaft",
		FULL_SHAFT_TOP - FULL_HANDLE_LEN,
		0.27,
		CFrame.new(0, (FULL_SHAFT_TOP + FULL_HANDLE_LEN) / 2, 0),
		hc
	)
	-- Foam sleeve where the left hand grips.
	Build.cyl(m, "LeftGrip", 0.55, 0.36, CFrame.new(0, FULL_LEFT_Y, 0), trim)
	Build.cyl(m, "Collar", 0.3, 0.4, CFrame.new(0, FULL_SHAFT_TOP + 0.12, 0), ac, am)

	-- Top grip: crossbar along X (the right fist wraps it).
	local palmY = T_GRIP_Y
	if D_GRIP_SHAPES[look.HeadShape] then
		palmY = D_GRIP_Y
		for side = -1, 1, 2 do
			Build.beam(
				m,
				"GripCheek",
				V(side * 0.36, palmY, 0),
				V(side * 0.08, 0.08, 0),
				0.14,
				0.16,
				hc,
				nil,
				Vector3.zAxis
			)
		end
		Build.cyl(m, "GripCap", 0.12, 0.34, CFrame.new(0, 0.02, 0), trim)
	else
		for side = -1, 1, 2 do
			Build.ellipsoid(m, "GripKnob", V(0.26, 0.26, 0.26), CFrame.new(side * 0.47, palmY, 0), trim)
		end
	end
	Build.cylBetween(m, "GripBar", V(-0.45, palmY, 0), V(0.45, palmY, 0), 0.22, trim)

	addHead(m, look, FULL_HB, 1)
	local palm = CFrame.fromMatrix(V(0, palmY, 0), Vector3.zAxis, -Vector3.xAxis, -Vector3.yAxis)
	return finish(m, handle, palm, true, V(0, FULL_LEFT_Y, 0), V(0, FULL_HB + 0.75, 0.12))
end

local function build(id: string, look: Types.ShovelLook): Model
	if look.Size == "Hand" then
		return buildHand(id, look)
	end
	return buildFull(id, look)
end

function Shovels.Build(shovelId: string): Model
	local def = Config.GetShovel(shovelId)
	return build(shovelId, if def then def.Look else FALLBACK)
end

function Shovels.FromLook(name: string, look: Types.ShovelLook): Model
	return build(name, look)
end

return Shovels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Treasures</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Treasures — ~1.5 stud trinkets for reveal pop-ups and ViewportFrames.
	PrimaryPart = invisible "Root" at the visual centre (pivot), front -Z, each shape given a
	slight three-quarter tilt so it reads well from a camera placed in front (at -Z) looking at +Z.
	One builder per Types.TreasureShape plus a few id-specific specials (flip-flop, sunglasses,
	map, spyglass, ...). Glow -> Neon accents + PointLight; Legendary/Mythic -> sparkles.
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Treasures = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis
local Y = Vector3.yAxis
local Z = Vector3.zAxis
local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(35, 30, 45)
local GOLD = Color3.fromRGB(255, 205, 40)
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local FACE_Z = CFrame.Angles(math.pi / 2, 0, 0) -- cylinder axis Y -> Z (disc facing the camera)

type Ctx = {
	m: Model,
	id: string,
	c: Color3,
	mat: Enum.Material,
	ac: Color3, -- accent colour
	am: Enum.Material, -- accent material
	glow: boolean,
}

-- Returns the main part and an optional display tilt.
type ShapeBuilder = (x: Ctx) -> (BasePart, CFrame?)

local shapes: { [string]: ShapeBuilder } = {}
local specials: { [string]: ShapeBuilder } = {}

shapes.Coin = function(x)
	local main = Build.cyl(x.m, "Coin", 0.22, 1.4, FACE_Z, x.c, x.mat)
	Build.cyl(x.m, "Inner", 0.28, 1.0, FACE_Z, Build.lighten(x.c, 0.18), x.mat)
	Build.tri(x.m, "Emblem", CF(0, 0.02, -0.15), 0.5, 0.5, 0.06, x.ac, x.am)
	Build.tri(x.m, "Emblem", CF(0, -0.06, -0.15) * CFrame.Angles(0, 0, math.pi), 0.5, 0.5, 0.06, x.ac, x.am)
	return main, CFrame.Angles(0, 0.4, 0)
end

shapes.Cap = function(x)
	local main = Build.cyl(x.m, "Cap", 0.3, 1.2, FACE_Z, x.c, x.mat)
	Build.cyl(x.m, "Top", 0.32, 0.85, FACE_Z, Build.lighten(x.c, 0.2), x.mat)
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		local dir = V(math.cos(a), math.sin(a), 0)
		Build.part(
			x.m,
			"Crimp",
			V(0.2, 0.22, 0.3),
			CF(dir * 0.62) * CFrame.Angles(0, 0, a),
			Build.darken(x.c, 0.1),
			x.mat
		)
	end
	return main, CFrame.Angles(0.35, 0.35, 0)
end

shapes.Shell = function(x)
	local hinge = V(0, -0.6, 0)
	local main = Build.ellipsoid(x.m, "Back", V(1.5, 1.15, 0.24), CF(0, 0.02, 0.08), Build.darken(x.c, 0.1), x.mat)
	for _, a in { -0.9, -0.45, 0, 0.45, 0.9 } do
		local dir = V(-math.sin(a), math.cos(a), 0)
		Build.ellipsoid(
			x.m,
			"Rib",
			V(0.38, 1.25, 0.3),
			CF(hinge + dir * 0.6) * CFrame.Angles(0, 0, a),
			Build.lighten(x.c, 0.12),
			x.mat
		)
	end
	Build.part(x.m, "Hinge", V(0.6, 0.25, 0.22), CF(0, -0.62, 0), x.c, x.mat)
	if x.glow then
		Build.ball(x.m, "Pearl", 0.35, CF(0, -0.35, -0.2), WHITE, NEON)
	end
	return main, CFrame.Angles(-0.25, 0.35, 0)
end

shapes.Bottle = function(x)
	local main = Build.cyl(x.m, "Bottle", 0.9, 0.7, CF(0, -0.25, 0), x.c, x.mat)
	Build.ball(x.m, "Shoulder", 0.7, CF(0, 0.2, 0), x.c, x.mat)
	Build.cyl(x.m, "Neck", 0.45, 0.3, CF(0, 0.55, 0), x.c, x.mat)
	Build.cyl(x.m, "Cork", 0.22, 0.32, CF(0, 0.85, 0), Color3.fromRGB(170, 120, 70), Enum.Material.Wood)
	Build.cyl(x.m, "Scroll", 0.7, 0.3, CF(0, -0.2, 0), Color3.fromRGB(245, 225, 175))
	return main, CFrame.Angles(0, 0, -0.35)
end

shapes.Chest = function(x)
	local main = Build.part(x.m, "Base", V(1.4, 0.75, 0.9), CF(0, -0.25, 0), x.c, x.mat)
	Build.cylBetween(x.m, "Lid", V(-0.7, 0.12, 0), V(0.7, 0.12, 0), 0.9, Build.lighten(x.c, 0.08), x.mat)
	for _, px in { -0.42, 0.42 } do
		Build.part(x.m, "Band", V(0.14, 0.78, 0.94), CF(px, -0.25, 0), GOLD, Enum.Material.Metal)
		Build.cylBetween(x.m, "Band", V(px - 0.07, 0.12, 0), V(px + 0.07, 0.12, 0), 0.94, GOLD, Enum.Material.Metal)
	end
	Build.part(x.m, "Lock", V(0.25, 0.3, 0.1), CF(0, 0.02, -0.47), GOLD, Enum.Material.Metal)
	Build.ball(x.m, "Gem", 0.2, CF(0.25, 0.5, -0.2), Color3.fromRGB(255, 60, 90), NEON)
	return main, CFrame.Angles(0.25, 0.5, 0)
end

shapes.Gem = function(x)
	local main = Build.cyl(x.m, "Girdle", 0.22, 1.1, CF(0, 0.1, 0), x.c, x.mat)
	Build.cyl(x.m, "Crown", 0.3, 0.78, CF(0, 0.35, 0), Build.lighten(x.c, 0.25), x.mat)
	local pav = Build.darken(x.c, 0.08)
	local pcf = CFrame.new(0, -0.37, 0) * CFrame.Angles(math.pi, 0, 0)
	for k = 0, 3 do
		Build.tri(x.m, "Pavilion", pcf * CFrame.Angles(0, k * math.pi / 4, 0), 1.05, 0.78, 0.14, pav, x.mat)
	end
	if x.glow then
		Build.ball(x.m, "Glint", 0.3, CF(0, 0.05, 0), Build.lighten(x.c, 0.5), NEON)
	end
	return main, CFrame.Angles(0.3, math.pi / 4, 0)
end

shapes.Bone = function(x)
	local main = Build.cylBetween(x.m, "Shaft", V(-0.55, 0, 0), V(0.55, 0, 0), 0.3, x.c, x.mat)
	for sx = -1, 1, 2 do
		for sy = -1, 1, 2 do
			Build.ball(x.m, "Knob", 0.42, CF(sx * 0.62, sy * 0.14, 0), x.c, x.mat)
		end
	end
	return main, CFrame.Angles(0.2, 0.3, 0.5)
end

shapes.Skull = function(x)
	local main = Build.ball(x.m, "Cranium", 1.2, CF(0, 0.15, 0), x.c, x.mat)
	Build.part(x.m, "Jaw", V(0.75, 0.38, 0.65), CF(0, -0.38, -0.12), x.c, x.mat)
	local eye = if x.glow then Build.lighten(x.c, 0.4) else DARK
	local em = if x.glow then NEON else SMOOTH
	for side = -1, 1, 2 do
		Build.ball(x.m, "Socket", 0.34, CF(side * 0.24, 0.08, -0.47), eye, em)
	end
	Build.tri(x.m, "Nose", CF(0, -0.12, -0.53), 0.18, 0.18, 0.06, DARK)
	for i = -1, 1 do
		Build.part(x.m, "Tooth", V(0.14, 0.16, 0.08), CF(i * 0.18, -0.32, -0.45), Build.lighten(x.c, 0.3))
	end
	return main, CFrame.Angles(0.1, 0.35, 0)
end

shapes.Orb = function(x)
	local main = Build.ball(x.m, "Orb", 1.2, CF(), x.c, x.mat)
	if x.glow and x.mat ~= NEON then
		Build.ball(x.m, "Core", 0.55, CF(), Build.lighten(x.c, 0.5), NEON)
	end
	Build.ellipsoid(
		x.m,
		"Shine",
		V(0.3, 0.2, 0.08),
		Build.surface(Vector3.zero, V(1.2, 1.2, 1.2), V(-0.5, 0.55, -0.7)),
		WHITE
	)
	return main, nil
end

shapes.Crown = function(x)
	local main = Build.cyl(x.m, "Band", 0.45, 1.3, CF(0, -0.25, 0), x.c, x.mat)
	Build.cyl(x.m, "Inside", 0.04, 1.16, CF(0, -0.02, 0), Build.darken(x.c, 0.45))
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		local dir = V(math.sin(a), 0, -math.cos(a))
		local tangent = V(-dir.Z, 0, dir.X)
		Build.triPts(
			x.m,
			"Point",
			dir * 0.6 + V(0, -0.05, 0),
			dir * 0.62 + V(0, 0.5, 0),
			tangent,
			0.55,
			0.1,
			x.c,
			x.mat
		)
		local gem = if k % 2 == 0 then Color3.fromRGB(255, 60, 90) else Color3.fromRGB(60, 140, 255)
		Build.ball(x.m, "Jewel", 0.2, CF(dir * 0.66 + V(0, -0.25, 0)), gem, if x.glow then NEON else SMOOTH)
	end
	return main, CFrame.Angles(0.35, 0.2, 0)
end

shapes.Tablet = function(x)
	local main = Build.part(x.m, "Slab", V(1.0, 1.1, 0.2), CF(0, -0.15, 0), x.c, x.mat)
	Build.cyl(x.m, "Arch", 0.2, 1.0, CF(0, 0.4, 0) * FACE_Z, x.c, x.mat)
	for i, y in { 0.35, 0.1, -0.15, -0.4 } do
		local w = if i % 2 == 0 then 0.5 else 0.66
		Build.part(x.m, "Glyph", V(w, 0.08, 0.05), CF(0, y, -0.11), x.ac, x.am)
	end
	return main, CFrame.Angles(0, 0.35, 0)
end

shapes.Egg = function(x)
	local main = Build.ellipsoid(x.m, "Egg", V(0.95, 1.0, 0.95), CF(0, -0.15, 0), x.c, x.mat)
	Build.ellipsoid(x.m, "EggTop", V(0.8, 1.0, 0.8), CF(0, 0.1, 0), x.c, x.mat)
	for _, d in { V(0.2, 0.2, -1), V(-0.8, -0.2, -0.6), V(0.8, -0.4, -0.3) } do
		Build.ellipsoid(
			x.m,
			"Spot",
			V(0.25, 0.25, 0.08),
			Build.surface(V(0, -0.15, 0), V(0.95, 1.0, 0.95), d),
			x.ac,
			x.am
		)
	end
	return main, CFrame.Angles(0, 0, -0.2)
end

shapes.Anchor = function(x)
	local main = Build.part(x.m, "Shank", V(0.2, 1.2, 0.2), CF(0, 0.05, 0), x.c, x.mat)
	Build.cyl(x.m, "Ring", 0.14, 0.44, CF(0, 0.75, 0) * FACE_Z, x.c, x.mat)
	Build.cyl(x.m, "Hole", 0.16, 0.2, CF(0, 0.75, 0) * FACE_Z, DARK)
	Build.part(x.m, "Stock", V(0.8, 0.15, 0.16), CF(0, 0.45, 0), Build.darken(x.c, 0.1), x.mat)
	for side = -1, 1, 2 do
		Build.beam(x.m, "Arm", V(0, -0.55, 0), V(side * 0.5, -0.25, 0), 0.18, 0.18, x.c, x.mat, Z)
		Build.triPts(x.m, "Fluke", V(side * 0.48, -0.32, 0), V(side * 0.62, 0.05, 0), X, 0.3, 0.14, x.c, x.mat)
	end
	Build.ball(x.m, "Crown", 0.26, CF(0, -0.55, 0), x.c, x.mat)
	return main, CFrame.Angles(0, 0.4, 0.15)
end

shapes.Wheel = function(x)
	local R = 0.6
	local seg = 2 * R * math.tan(math.pi / 8) + 0.04
	for k = 0, 7 do
		local a = (k + 0.5) / 8 * math.pi * 2
		Build.part(
			x.m,
			"Rim",
			V(seg, 0.14, 0.16),
			CFrame.Angles(0, 0, a) * CF(0, R * math.cos(math.pi / 8), 0),
			x.c,
			x.mat
		)
	end
	for k = 0, 3 do
		local a = k / 8 * math.pi * 2
		local dir = V(math.cos(a), math.sin(a), 0)
		Build.beam(x.m, "Spoke", -dir * 0.72, dir * 0.72, 0.1, 0.1, Build.darken(x.c, 0.1), x.mat, Z)
	end
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		Build.ball(x.m, "Knob", 0.17, CF(math.cos(a) * 0.78, math.sin(a) * 0.78, 0), x.ac, x.am)
	end
	local hub = Build.cyl(x.m, "Hub", 0.22, 0.32, FACE_Z, x.ac, x.am)
	return hub, CFrame.Angles(0, 0.35, 0)
end

shapes.Shard = function(x)
	local main = Build.ellipsoid(
		x.m,
		"Base",
		V(0.9, 0.3, 0.7),
		CF(0, -0.58, 0),
		Color3.fromRGB(110, 100, 115),
		Enum.Material.Slate
	)
	Build.spike(x.m, "Crystal", V(0, -0.6, 0), V(0, 0.72, 0), 0.55, x.c, x.mat)
	Build.spike(x.m, "Crystal", V(-0.1, -0.55, 0), V(-0.55, 0.25, 0), 0.38, Build.lighten(x.c, 0.15), x.mat)
	Build.spike(x.m, "Crystal", V(0.1, -0.55, 0.05), V(0.5, 0.1, -0.1), 0.34, Build.darken(x.c, 0.1), x.mat)
	return main, CFrame.Angles(0, 0.3, 0)
end

shapes.Box = function(x)
	local main = Build.part(x.m, "Box", V(1.1, 1.1, 1.1), CF(), x.c, x.mat)
	Build.part(x.m, "Ribbon", V(1.12, 1.12, 0.22), CF(), x.ac, x.am)
	Build.part(x.m, "Ribbon", V(0.22, 1.12, 1.12), CF(), x.ac, x.am)
	for side = -1, 1, 2 do
		Build.ellipsoid(
			x.m,
			"Bow",
			V(0.4, 0.25, 0.25),
			CF(side * 0.18, 0.66, 0) * CFrame.Angles(0, 0, side * 0.5),
			x.ac,
			x.am
		)
	end
	return main, CFrame.Angles(0.3, 0.6, 0)
end

-- Specials keyed by treasure id ---------------------------------------------------------------

specials.lost_flip_flop = function(x)
	local main = Build.ellipsoid(x.m, "Sole", V(0.65, 1.5, 0.14), CF(), x.c, x.mat)
	local strap = Build.lighten(x.c, 0.5)
	Build.ball(x.m, "ToePost", 0.14, CF(0, 0.4, -0.08), strap)
	for side = -1, 1, 2 do
		Build.beam(x.m, "Strap", V(0, 0.4, -0.1), V(side * 0.28, -0.12, -0.08), 0.1, 0.08, strap, SMOOTH, Z)
	end
	return main, CFrame.Angles(-0.3, 0.3, 0.25)
end

specials.cool_sunglasses = function(x)
	local frame = Build.part(x.m, "Bridge", V(0.3, 0.1, 0.1), CF(0, 0.1, 0), x.c, x.mat)
	for side = -1, 1, 2 do
		Build.cyl(
			x.m,
			"Lens",
			0.1,
			0.6,
			CF(side * 0.38, 0, 0) * FACE_Z,
			Color3.fromRGB(40, 50, 90),
			Enum.Material.Glass
		)
		Build.cyl(x.m, "Frame", 0.08, 0.68, CF(side * 0.38, 0, 0.05) * FACE_Z, x.c, x.mat)
		Build.part(x.m, "Arm", V(0.06, 0.08, 0.9), CF(side * 0.7, 0.1, 0.45), x.c, x.mat)
		Build.ellipsoid(x.m, "Shine", V(0.18, 0.1, 0.04), CF(side * 0.38 - 0.1, 0.12, -0.06), WHITE)
	end
	return frame, CFrame.Angles(0.15, 0.45, 0)
end

specials.frozen_fish = function(x)
	local ice = Build.part(x.m, "Ice", V(1.3, 0.95, 0.7), CF(), x.c, Enum.Material.Ice)
	ice.Transparency = 0.45
	local fish = Color3.fromRGB(255, 140, 60)
	Build.ellipsoid(x.m, "Fish", V(0.85, 0.45, 0.25), CF(-0.08, 0, 0), fish)
	Build.triPts(x.m, "Tail", V(0.55, 0, 0), V(0.25, 0, 0), Y, 0.4, 0.06, fish)
	Build.ball(x.m, "Eye", 0.1, CF(-0.36, 0.06, -0.12), DARK)
	return ice, CFrame.Angles(0.2, 0.4, 0)
end

specials.treasure_map = function(x)
	local main = Build.part(x.m, "Paper", V(1.25, 1.0, 0.05), CF(), x.c, x.mat)
	for _, y in { 0.5, -0.5 } do
		Build.cylBetween(x.m, "Roll", V(-0.66, y, 0), V(0.66, y, 0), 0.18, Build.darken(x.c, 0.1), x.mat)
	end
	local red = Color3.fromRGB(220, 40, 40)
	Build.part(x.m, "X", V(0.4, 0.08, 0.04), CF(0.3, -0.15, -0.04) * CFrame.Angles(0, 0, 0.785), red)
	Build.part(x.m, "X", V(0.4, 0.08, 0.04), CF(0.3, -0.15, -0.04) * CFrame.Angles(0, 0, -0.785), red)
	for i = 0, 2 do
		Build.part(x.m, "Path", V(0.12, 0.05, 0.04), CF(-0.4 + i * 0.2, 0.15 - i * 0.1, -0.04), Build.darken(x.c, 0.5))
	end
	return main, CFrame.Angles(0.2, 0.3, 0.05)
end

specials.captains_spyglass = function(x)
	local main = Build.cylBetween(x.m, "Tube", V(-0.75, 0, 0), V(-0.1, 0, 0), 0.42, x.c, x.mat)
	Build.cylBetween(x.m, "Tube", V(-0.15, 0, 0), V(0.35, 0, 0), 0.34, Build.darken(x.c, 0.15), x.mat)
	Build.cylBetween(x.m, "Tube", V(0.3, 0, 0), V(0.75, 0, 0), 0.26, x.c, x.mat)
	Build.cylBetween(x.m, "Ring", V(-0.12, 0, 0), V(-0.04, 0, 0), 0.46, Color3.fromRGB(90, 55, 30), Enum.Material.Wood)
	Build.cylBetween(
		x.m,
		"Lens",
		V(-0.77, 0, 0),
		V(-0.74, 0, 0),
		0.36,
		Color3.fromRGB(150, 220, 255),
		Enum.Material.Glass
	)
	return main, CFrame.Angles(0.2, 0.5, 0.35)
end

specials.pocket_watch = function(x)
	local main = Build.cyl(x.m, "Case", 0.24, 1.2, FACE_Z, x.c, x.mat)
	Build.cyl(x.m, "Dial", 0.26, 0.95, FACE_Z, Color3.fromRGB(255, 250, 235))
	Build.part(x.m, "Hand", V(0.06, 0.38, 0.04), CF(0, 0.17, -0.14), DARK)
	Build.part(x.m, "Hand", V(0.06, 0.28, 0.04), CF(0.11, 0.05, -0.14) * CFrame.Angles(0, 0, -1.2), DARK)
	Build.cyl(x.m, "Crown", 0.16, 0.2, CF(0, 0.66, 0), x.c, x.mat)
	Build.cyl(x.m, "Bow", 0.06, 0.32, CF(0, 0.82, 0) * FACE_Z, x.c, x.mat)
	return main, CFrame.Angles(0, 0.35, 0)
end

specials.sun_mask = function(x)
	local main = Build.cyl(x.m, "Mask", 0.24, 1.05, FACE_Z, x.c, x.mat)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local dir = V(math.cos(a), math.sin(a), 0)
		Build.triPts(x.m, "Ray", dir * 0.48, dir * 0.85, V(-dir.Y, dir.X, 0), 0.32, 0.12, Build.lighten(x.c, 0.2), x.am)
	end
	Build.face(x.m, CF(0, 0.02, -0.12), 1.0, { cheeks = true })
	return main, CFrame.Angles(0, 0.3, 0)
end

specials.beach_ball_of_creation = function(x)
	local main = Build.ball(x.m, "Ball", 1.3, CF(), WHITE)
	local stripes = { Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 215, 50), Color3.fromRGB(60, 150, 255) }
	for i, col in stripes do
		Build.ellipsoid(x.m, "Stripe", V(1.4, 1.4, 0.9), CFrame.Angles(0, (i - 1) * math.pi / 3, 0), col, NEON)
	end
	Build.ball(x.m, "Cap", 0.3, CF(0, 0.62, 0), WHITE, NEON)
	return main, CFrame.Angles(0.3, 0.2, 0)
end

specials.trex_tooth = function(x)
	local main = Build.ellipsoid(x.m, "Tooth", V(0.62, 0.95, 0.5), CF(0, -0.2, 0), x.c, x.mat)
	Build.ellipsoid(x.m, "Tooth", V(0.42, 0.85, 0.36), CF(0.07, 0.3, 0) * CFrame.Angles(0, 0, -0.18), x.c, x.mat)
	Build.ellipsoid(x.m, "Tip", V(0.22, 0.4, 0.2), CF(0.16, 0.66, 0) * CFrame.Angles(0, 0, -0.3), x.c, x.mat)
	Build.ellipsoid(x.m, "Root", V(0.5, 0.3, 0.42), CF(0, -0.62, 0), Build.darken(x.c, 0.2), x.mat)
	return main, CFrame.Angles(0, 0.4, -0.1)
end

specials.mammoth_tusk = function(x)
	local pts = {}
	for i = 0, 4 do
		local a = math.rad(200 - i * 30)
		table.insert(pts, V(math.cos(a) * 0.7 + 0.1, math.sin(a) * 0.7 + 0.25, 0))
	end
	local main: BasePart = Build.cylBetween(x.m, "Tusk", pts[1], pts[2], 0.42, Build.darken(x.c, 0.1), x.mat)
	for i = 2, #pts - 1 do
		Build.ball(x.m, "Joint", 0.42 - (i - 1) * 0.07, CF(pts[i]), x.c, x.mat)
		Build.cylBetween(x.m, "Tusk", pts[i], pts[i + 1], 0.42 - (i - 1) * 0.07, x.c, x.mat)
	end
	Build.ball(x.m, "Tip", 0.16, CF(pts[#pts]), x.c, x.mat)
	return main, CFrame.Angles(0, 0.3, 0)
end

-- Relics have unique silhouettes; they must never read as the common coin/orb fallback.
specials.sun_compass = function(x)
	local brass = Color3.fromRGB(204, 149, 63)
	local main = Build.cyl(x.m, "CompassCase", 0.24, 1.45, FACE_Z, brass, Enum.Material.Metal)
	Build.cyl(x.m, "Dial", 0.035, 1.18, CF(0, 0, -0.145) * FACE_Z, Color3.fromRGB(28, 47, 66))
	for k = 0, 7 do
		local a = k * math.pi / 4
		local p = V(math.sin(a) * 0.48, math.cos(a) * 0.48, -0.18)
		Build.part(x.m, "DialMark", V(0.045, 0.13, 0.035), CF(p) * CFrame.Angles(0, 0, -a), brass, Enum.Material.Metal)
	end
	Build.tri(x.m, "DownNeedle", CF(0, -0.17, -0.22) * CFrame.Angles(0, 0, math.pi), 0.28, 0.62, 0.07, x.c, NEON)
	Build.tri(x.m, "Counterweight", CF(0, 0.17, -0.21), 0.2, 0.35, 0.06, Color3.fromRGB(222, 90, 72))
	Build.ball(x.m, "Axle", 0.16, CF(0, 0, -0.25), brass, Enum.Material.Metal)
	Build.cyl(x.m, "Crown", 0.2, 0.26, CF(0, 0.8, 0), brass, Enum.Material.Metal)
	for side = -1, 1, 2 do
		Build.cylBetween(
			x.m,
			"ChainLoop",
			V(side * 0.15, 0.82, 0),
			V(side * 0.12, 1.03, 0),
			0.07,
			brass,
			Enum.Material.Metal
		)
	end
	Build.cylBetween(x.m, "ChainLoop", V(-0.12, 1.03, 0), V(0.12, 1.03, 0), 0.07, brass, Enum.Material.Metal)
	return main, CFrame.Angles(0, 0.15, -0.12)
end

specials.tide_heart = function(x)
	local pearl = Color3.fromRGB(226, 242, 226)
	local teal = Color3.fromRGB(43, 121, 128)
	local main = Build.ellipsoid(x.m, "ShellHeart", V(1.35, 1.1, 0.8), CF(), pearl)
	-- Raised spiral follows a stylized shell face, with enough contrast to read at icon size.
	local last: Vector3? = nil
	for k = 0, 13 do
		local t = k / 13
		local a = t * math.pi * 3.3
		local r = 0.08 + t * 0.5
		local p = V(math.cos(a) * r, math.sin(a) * r * 0.8, -0.4 - 0.035 * (1 - t))
		if last then
			Build.cylBetween(x.m, "ShellSpiral", last, p, 0.07, teal)
		end
		last = p
	end
	Build.ellipsoid(x.m, "TidePearl", V(0.42, 0.5, 0.25), CF(0, 0, -0.46), x.c, NEON)
	Build.tri(x.m, "ShellLip", CF(0, -0.58, -0.1) * CFrame.Angles(0, 0, math.pi), 0.65, 0.5, 0.28, pearl)
	return main, CFrame.Angles(0, 0.25, 0.15)
end

local RAINBOW_GLOW = Color3.fromRGB(255, 230, 160)

local FALLBACK: Types.TreasureLook = {
	Color = Color3.fromRGB(255, 205, 60),
	Shape = "Coin",
	Material = Enum.Material.Metal,
	Glow = false,
}

local function build(id: string, look: Types.TreasureLook, rarity: Types.Rarity): Model
	local m = Build.model(id)
	local root = Build.root(m, CFrame.identity, V(0.2, 0.2, 0.2))
	local ctx: Ctx = {
		m = m,
		id = id,
		c = look.Color,
		mat = look.Material,
		ac = if look.Glow then Build.lighten(look.Color, 0.45) else Build.darken(look.Color, 0.3),
		am = if look.Glow then NEON else look.Material,
		glow = look.Glow,
	}
	local builder = specials[id] or shapes[look.Shape] or shapes.Coin
	local main, tilt = builder(ctx)
	if tilt then
		Build.transform(m, tilt, root)
	end
	if look.Glow then
		Build.glow(main, if id == "beach_ball_of_creation" then RAINBOW_GLOW else look.Color, 1.3, 7)
	end
	if rarity == "Legendary" or rarity == "Mythic" or rarity == "Relic" then
		Build.sparkle(main, Build.lighten(look.Color, 0.3), if rarity == "Mythic" then 10 else 5)
	end
	Build.weldAll(m, root)
	return m
end

function Treasures.Build(treasureId: string): Model
	local def = Config.GetTreasure(treasureId)
	if def then
		return build(treasureId, def.Look, def.Rarity)
	end
	return build(treasureId, FALLBACK, "Common")
end

-- v3 discovery: size + material variants of a built treasure (Config.Discovery). Scales about
-- the pivot and re-skins every visible part: Golden = gold metal, Fossilized = stone,
-- Crystal = tinted glass with a soft glow. Returns the same model.
local VARIANT_SKINS: { [string]: { Color: Color3, Material: Enum.Material, Transparency: number } } = {
	Golden = { Color = Color3.fromRGB(255, 200, 45), Material = Enum.Material.Metal, Transparency = 0 },
	Fossilized = { Color = Color3.fromRGB(150, 128, 104), Material = Enum.Material.Slate, Transparency = 0 },
	Crystal = { Color = Color3.fromRGB(130, 225, 255), Material = Enum.Material.Glass, Transparency = 0.25 },
}

function Treasures.ApplyVariant(model: Model, size: string?, material: string?): Model
	local sizeDef = nil
	for _, v in Config.Discovery.SIZES do
		if v.Id == size then
			sizeDef = v
		end
	end
	local scale = if sizeDef and sizeDef.Scale then sizeDef.Scale else 1
	Build.scale(model, model:GetPivot(), scale)
	local skin = if material then VARIANT_SKINS[material] else nil
	if skin then
		local root = model.PrimaryPart
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and d ~= root and d.Transparency < 1 then
				local keepNeon = d.Material == NEON
				d.Color = if keepNeon
					then Build.neonSafe(Build.lighten(skin.Color, 0.2))
					else skin.Color:Lerp(d.Color, 0.15)
				if not keepNeon then
					d.Material = skin.Material
					d.Transparency = math.max(d.Transparency, skin.Transparency)
				end
			end
		end
		if material == "Crystal" or material == "Golden" then
			local main = root or model:FindFirstChildWhichIsA("BasePart")
			if main then
				Build.sparkle(main, skin.Color, 4)
			end
		end
	end
	model:SetAttribute("Size", size or "Normal")
	model:SetAttribute("Material", material or "None")
	return model
end

function Treasures.FromLook(name: string, look: Types.TreasureLook, rarity: Types.Rarity?): Model
	return build(name, look, rarity or "Common")
end

return Treasures
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Single source of truth for network endpoints. The server creates them on first access;
-- clients wait for them. Names must match docs/ARCHITECTURE.md.
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.Events = table.freeze({
	-- client -> server
	"Dig",
	"ReturnToSurface",
	"BuyShovel",
	"EquipShovel",
	"BuyBackpack",
	"EquipBackpack",
	"HatchEgg",
	"EquipPet",
	"UnequipPet",
	"DeletePet",
	"Rebirth",
	"ClaimDailyReward",
	"ClaimQuest",
	"RedeemCode",
	"SetSetting",
	"PromptPurchase",
	-- v2 survival
	"BuyShade",
	"PlaceShade", -- (shadeId: string, position: Vector3, yaw: number)
	"PickUpShade",
	"BuyConsumable", -- (id: string, count: number)
	"UseConsumable", -- (id: string)
	"DrinkFountain",
	-- v2.1 ride-on excavator (RideService)
	"ToggleRide", -- () spawn + sit in your rideable pet, or get out
	"RideDig", -- () scoop in front of your vehicle (server picks the point)
	-- v2.2 duplicate fusion: (uid: string) fuse Config.GOLDEN_FUSE_COUNT copies into a Golden pet
	"FusePets",
	-- v2.2 analytics: (name: string, a: any?, b: any?) whitelisted UI events (Analytics.OnTrack)
	"Track",
	-- v2.2 rebirth perks: (perkId: string) buy the next level with Rebirth Tokens (RebirthService)
	"BuyRebirthPerk",
	-- v3 discovery (DiscoveryService): () start a detector scan; (id: string, errors: {number})
	-- answer an excavation with per-ring timing errors in seconds (-1 = no tap)
	"Scan",
	"Excavate",
	-- server -> client
	"DataChanged",
	"Notify",
	"DigResult",
	"TreasureFound",
	"EggHatched", -- (petIds: {string}, info: { EggId, Chances: {number}, Pity: {boolean} }?) v2.2 info
	"EventChanged",
	-- v2.2 offline earnings (OfflineService): (info: { Seconds, Sand, Coins, CapSeconds, Capped, PetId })
	"OfflineEarnings",
	-- v2.1 companions: a digging pet dug. server -> all clients:
	-- (player: Player, slot: number, petId: string, position: Vector3, sandGained: number)
	-- slot = 1-based index into the owner's "EquippedPets" attribute list.
	"PetDug",
	"Scoop", -- server -> other clients: (player: Player) a successful shovel dig (scoop animation)
	"RideDug", -- server -> all clients: (player: Player, position: Vector3, success: boolean, layerIndex: number)
	-- v3 discovery, server -> owner: Types.DetectorPing / Types.ExcavationInfo / Types.FindInfo
	"DetectorPing",
	"ExcavationStart",
	"FindRevealed",
})

Remotes.Functions = table.freeze({
	"GetData",
	"GetOwnedPasses",
})

local FOLDER_NAME = "Net"
local isServer = RunService:IsServer()

local function getFolder(): Folder
	local existing = script:FindFirstChild(FOLDER_NAME)
	if existing then
		return existing :: Folder
	end
	if isServer then
		local folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = script
		return folder
	end
	return script:WaitForChild(FOLDER_NAME) :: Folder
end

local function getOrCreate(name: string, className: string): Instance
	local folder = getFolder()
	local existing = folder:FindFirstChild(name)
	if existing then
		return existing
	end
	if isServer then
		local remote = Instance.new(className)
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	return folder:WaitForChild(name)
end

function Remotes.Get(name: string): RemoteEvent
	assert(table.find(Remotes.Events, name), "Unknown RemoteEvent: " .. name)
	return getOrCreate(name, "RemoteEvent") :: RemoteEvent
end

function Remotes.GetFunction(name: string): RemoteFunction
	assert(table.find(Remotes.Functions, name), "Unknown RemoteFunction: " .. name)
	return getOrCreate(name, "RemoteFunction") :: RemoteFunction
end

-- Server calls this once at boot so every remote exists before clients look for them.
function Remotes.CreateAll()
	assert(isServer, "Remotes.CreateAll is server-only")
	for _, name in Remotes.Events do
		Remotes.Get(name)
	end
	for _, name in Remotes.Functions do
		Remotes.GetFunction(name)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Types — shared exported Luau types for Dig the Beach.
	Owner: Game design. Other areas code against these; do not change field names without
	updating docs/ARCHITECTURE.md.

	Units:
	- Depth is always in STUDS BELOW THE SURFACE (positive number, 0 = beach surface).
	- Prices / values are in Coins unless stated otherwise. Robux prices are suggestions only.
	- Multipliers are plain factors (1 = no bonus). Pet multipliers combine ADDITIVELY:
	  total = 1 + sum(pet.Multiplier - 1) (see Config.PetMultiplier).
]]

-- Rarity ---------------------------------------------------------------------------------

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic" | "Relic" -- v3: Relic (finds only)

export type RarityDef = {
	Name: Rarity,
	Order: number, -- 1 = Common ... 6 = Mythic, 7 = Relic (v3 discovery slice, finds only)
	Color: Color3, -- main text / frame colour
	Gradient: { Color3 }, -- 2+ colours for UIGradient on cards
	Announce: boolean, -- server-wide chat/toast when someone finds/hatches this rarity
}

-- Rewards (quests, daily, codes, products) -------------------------------------------------

export type Reward = {
	Coins: number?, -- flat coins
	-- "seconds of income": multiplied by the RewardScale of the layer at the player's MaxDepth,
	-- so rewards stay meaningful all game. Resolve with Config.ResolveCoins(reward, maxDepth).
	ScaledCoins: number?,
	RebirthTokens: number?,
	Boost: string?, -- BoostDef.Id
	BoostSeconds: number?,
	Pet: string?, -- PetDef.Id granted directly
	Egg: string?, -- EggDef.Id hatched for free
	EggCount: number?, -- default 1
	Rebirth: boolean?, -- grant one rebirth without paying its coin cost (Skip Rebirth product)
	Consumables: { [string]: number }?, -- v2 survival: consumable id -> count (granted by SurvivalService)
}

-- World ------------------------------------------------------------------------------------

export type LootEntry = {
	TreasureId: string,
	Weight: number,
}

export type LayerDef = {
	Id: string,
	Name: string,
	DepthStart: number, -- studs below surface (inclusive)
	DepthEnd: number, -- studs below surface (exclusive)
	Material: Enum.Material, -- terrain material; unique per layer (colour override is global per material)
	Color: Color3, -- Terrain:SetMaterialColor(Material, Color)
	Hardness: number, -- equipped shovel Power must be >= Hardness
	SandValue: number, -- sand per dig before multipliers
	TreasureChance: number, -- 0..1 chance per successful dig to roll LootTable (before luck)
	LootTable: { LootEntry },
	RewardScale: number, -- ~coins/second a typical player earns here; scales ScaledCoins rewards
	FlavorText: string,
	AmbientColor: Color3, -- suggested Lighting tint / fog colour while the camera is in this layer
}

-- Equipment --------------------------------------------------------------------------------

export type ShovelShape = "Scoop" | "Trowel" | "Spade" | "Pick" | "Claw" | "Trident" | "Drill"

-- "Hand": small one-handed hand tool (~2 studs). "Full" (default when nil): full-size tool held
-- with both hands (client ShovelPoseController).
export type ShovelSize = "Hand" | "Full"

export type ShovelLook = {
	HeadColor: Color3,
	HandleColor: Color3,
	HeadShape: ShovelShape,
	Material: Enum.Material, -- Part material for the head
	Glow: boolean, -- add PointLight / Neon accents
	Size: ShovelSize?, -- nil = "Full"
}

export type ShovelDef = {
	Id: string,
	Name: string,
	Price: number, -- coins
	Power: number, -- compared against LayerDef.Hardness
	Cooldown: number, -- seconds between digs
	Radius: number, -- dig size: half the edge of the voxel cube a dig removes (see Shovels.luau)
	SandMultiplier: number,
	RebirthsRequired: number,
	Description: string,
	Look: ShovelLook,
}

export type BackpackShape = "Bucket" | "Bag" | "Box" | "Barrel" | "Cart" | "Vehicle" | "Orb"

export type BackpackLook = {
	Color: Color3,
	AccentColor: Color3,
	Shape: BackpackShape,
	Material: Enum.Material,
	Glow: boolean,
}

export type BackpackDef = {
	Id: string,
	Name: string,
	Price: number,
	Capacity: number, -- sand (multiplied by rebirth multiplier & Mega Backpack pass)
	RebirthsRequired: number,
	Description: string,
	Look: BackpackLook,
}

-- Pets & eggs ------------------------------------------------------------------------------

export type PetShape =
	"Crab"
	| "Bird"
	| "Star"
	| "Turtle"
	| "Fish"
	| "Squid"
	| "Blob"
	| "Mole"
	| "Dino"
	| "Dragon"
	| "Golem"
	| "Seal"
	| "Vehicle" -- v2.1: vehicle pet, drawn by Models/Diggers (PetDef.VehicleKind)

export type PetLook = {
	BodyColor: Color3,
	AccentColor: Color3,
	Shape: PetShape,
	Size: number, -- overall scale factor, ~1 (Common) .. 1.6 (Mythic)
	Glow: boolean,
}

export type PetDef = {
	Id: string,
	Name: string,
	Rarity: Rarity,
	Multiplier: number, -- sand multiplier (additive with other pets, see Config.PetMultiplier)
	Exclusive: boolean, -- not in any egg (daily reward / code / event)
	Look: PetLook,
	-- v2.1: digging companions (vehicles from Construction Crates, some creatures).
	Dig: PetDigDef?,
	Rideable: boolean?, -- v2.1: the player can ride it (see Services/RideService)
	VehicleKind: string?, -- v2.1: Models/Diggers builder kind for vehicle pets (e.g. "Excavator")
}

export type PetDigDef = {
	Power: number, -- digs layers with Hardness <= Power
	Interval: number, -- seconds between digs
	Radius: number, -- same scale as shovel Radius
	SandMultiplier: number, -- replaces the shovel factor for this pet's digs
}

export type PetInstance = {
	Id: string, -- PetDef.Id
	Equipped: boolean,
	-- v2.2: fused from Config.GOLDEN_FUSE_COUNT identical copies (PetService "FusePets"):
	-- x Config.GOLDEN_SAND_BONUS on its sand bonus, digs Config.GOLDEN_DIG_SPEED x as often.
	Golden: boolean?,
}

export type EggCurrency = "Coins" | "Tokens" | "Robux"

export type EggEntry = {
	PetId: string,
	Weight: number,
}

export type EggLook = {
	ShellColor: Color3,
	SpotColor: Color3,
	Glow: boolean,
}

export type EggDef = {
	Id: string,
	Name: string,
	Currency: EggCurrency,
	Price: number, -- coins / tokens per hatch; for Robux eggs the Robux suggestion (see ProductKey)
	ProductKey: string?, -- Robux eggs: key into Config.Monetization.Products for a single hatch
	UnlockLayer: number, -- index into Config.Layers; requires MaxDepth >= that layer's DepthStart
	Pets: { EggEntry },
	Look: EggLook,
	Kind: ("Egg" | "Crate")?, -- v2.1: Construction Crates hatch vehicle pets; default "Egg"
	-- v2.2 pity: after this many hatches in a row without a Rare-or-better pet, the next hatch is
	-- guaranteed Rare+ (Stats.GetHatchOdds). nil = no pity (every entry is already Rare+).
	PityAt: number?,
}

-- Treasure ---------------------------------------------------------------------------------

export type TreasureShape =
	"Coin"
	| "Cap"
	| "Shell"
	| "Bottle"
	| "Chest"
	| "Gem"
	| "Bone"
	| "Skull"
	| "Orb"
	| "Crown"
	| "Tablet"
	| "Egg"
	| "Anchor"
	| "Wheel"
	| "Shard"
	| "Box"

export type TreasureLook = {
	Color: Color3,
	Shape: TreasureShape,
	Material: Enum.Material,
	Glow: boolean,
}

export type TreasureDef = {
	Id: string,
	Name: string,
	Layer: number, -- index into Config.Layers where it is found
	Rarity: Rarity,
	SellValue: number, -- coins when sold
	FlavorText: string,
	Look: TreasureLook,
	-- v3 Relics: value = ScaledValue seconds of income (RewardScale of the player's deepest layer)
	-- instead of SellValue; findable in any deposit of layer >= Layer (Config.Discovery).
	ScaledValue: number?,
}

-- v3 discovery slice (docs/design/Discovery.md) ------------------------------------------------

export type FindSize = "Tiny" | "Normal" | "Large" | "Giant"
export type FindMaterial = "None" | "Golden" | "Fossilized" | "Crystal"
export type FindQuality = "Damaged" | "Good" | "Pristine"
-- Presentation tier: Pop (float text) < Beam (coloured beam) < Card (Reveal card + camera)
-- < Server (announce + beam for everyone) < Spectacle (Relic).
export type FindTier = "Pop" | "Beam" | "Card" | "Server" | "Spectacle"
export type DetectorSignal = "White" | "Gold" | "Purple"

-- server -> owner "DetectorPing": coarse info only (never positions or the deposit list).
export type DetectorPing = {
	Band: number, -- 0 = nothing in range, 1 = hot (closest) .. 4 = edge of range
	Sector: number, -- 0..SECTORS-1 compass sector (0 = +Z, clockwise towards +X); -1 = none
	Vertical: string, -- "Down" | "Level" | "Up" | ""
	Signal: string, -- DetectorSignal or ""
	Remaining: number, -- seconds left in this scan
	Overhead: boolean?, -- true: the find is (nearly) straight below / above, dig vertically here
}

-- server -> owner "ExcavationStart"
export type ExcavationInfo = {
	Id: string,
	Position: Vector3, -- where the find emerges (visible ground)
	Signal: string, -- DetectorSignal of the find (ring colour)
	Rings: number,
	RingSeconds: number,
	RingGap: number,
	PerfectWindow: number,
	GoodWindow: number,
	Timeout: number,
}

-- server -> owner "FindRevealed"
export type FindInfo = {
	Id: string, -- excavation id ("" for ambient finds)
	TreasureId: string,
	Rarity: string,
	Size: string,
	Material: string,
	Quality: string,
	Value: number, -- coins at sell time (before coin boosts)
	Tier: string, -- FindTier
	IsNew: boolean, -- first time this treasure is in the Index
	NewVariants: { string }, -- variant ids seen for the first time on this treasure
	Perfect: boolean, -- every ring Perfect
	Ambient: boolean, -- popcorn find straight from a dig (no excavation)
	Position: Vector3,
}

-- Progression ------------------------------------------------------------------------------

export type RebirthConfig = {
	BaseCost: number,
	CostGrowth: number,
	MultiplierPerRebirth: number,
	BaseTokens: number,
	Resets: { string }, -- PlayerData keys reset on rebirth
	Keeps: { string }, -- PlayerData keys explicitly kept (documentation)
	Cost: (rebirths: number) -> number, -- coins for the NEXT rebirth when you have `rebirths`
	Multiplier: (rebirths: number) -> number, -- permanent sand & capacity multiplier
	Tokens: (rebirths: number) -> number, -- tokens granted for the NEXT rebirth
}

export type QuestKind =
	"DigTimes"
	| "SellTimes"
	| "FindTreasures"
	| "FindRarity" -- Target treasures of Rarity or rarer
	| "HatchEggs"
	| "PlayMinutes"
	| "BuyUpgrade" -- buy any shovel or backpack
	| "ReachDepth" -- Target = studs below surface (compare with MaxDepth)
	| "Rebirth"

export type QuestReset = "Daily" | "Once"

export type QuestDef = {
	Id: string,
	Name: string,
	Description: string,
	Kind: QuestKind,
	Target: number,
	Rarity: Rarity?, -- FindRarity only
	Reset: QuestReset,
	Reward: Reward,
}

export type QuestProgress = {
	Progress: number,
	Claimed: boolean,
	Day: number?, -- UTC day number (os.time() // 86400) this progress belongs to (Daily quests)
}

export type DailyRewardDef = {
	Day: number, -- 1..7
	Label: string,
	Reward: Reward,
}

export type CodeDef = {
	Code: string, -- matched case-insensitively
	Reward: Reward,
	Enabled: boolean,
	Expires: number?, -- unix time; nil = never
	GroupOnly: boolean?, -- requires membership of Config.GROUP_ID
	Note: string,
}

-- Boosts & events --------------------------------------------------------------------------

export type BoostKind = "Sand" | "Luck" | "Coins" | "Speed"

export type BoostDef = {
	Id: string,
	Name: string,
	Kind: BoostKind,
	Multiplier: number, -- Speed: cooldown is divided by this
	Description: string,
	Color: Color3,
}

export type EventDef = {
	Id: string,
	Name: string,
	Description: string,
	Kind: BoostKind,
	Multiplier: number,
	IntervalSeconds: number, -- event is active while (os.time() + OffsetSeconds) % IntervalSeconds < DurationSeconds
	DurationSeconds: number,
	OffsetSeconds: number,
	Color: Color3,
}

-- Monetization -----------------------------------------------------------------------------

export type GamePassDef = {
	Id: number, -- 0 = not created yet (owner pastes Creator Hub id)
	Name: string,
	Price: number, -- suggested Robux
	Description: string,
	Color: Color3,
	SandMultiplier: number?,
	LuckMultiplier: number?, -- v2.3: must stay nil on every pass (no paid luck; Config asserts)
	CoinMultiplier: number?, -- v2.3: sell coins factor (VIP), Stats.GetCoinFactors
	CapacityMultiplier: number?,
	ExtraPetSlots: number?,
	SpeedMultiplier: number?,
	-- v2.2: changes the odds of a random outcome (luck): hidden + refused for players whose
	-- PolicyService says ArePaidRandomItemsRestricted (Services/PolicyService).
	PaidRandom: boolean?,
}

export type ProductDef = {
	Id: number, -- 0 = not created yet
	Name: string,
	Price: number, -- suggested Robux
	Description: string,
	Grant: Reward,
	-- v2.2: buys a random item, a luck modifier, or currency that buys random items (eggs and
	-- crates): hidden + refused for PolicyService-restricted players (Services/PolicyService).
	PaidRandom: boolean?,
}

export type PremiumPerks = {
	SandMultiplier: number,
	DailyRewardMultiplier: number,
	ChatTag: string,
}

export type MonetizationConfig = {
	GamePasses: { [string]: GamePassDef },
	Products: { [string]: ProductDef },
	Premium: PremiumPerks,
}

-- Presentation -----------------------------------------------------------------------------

export type SoundDef = {
	Id: string, -- "rbxasset://..." built-in, or "" = not set yet (skip playing)
	Volume: number,
	PlaybackSpeed: number,
	Looped: boolean,
}

export type ThemeColors = {
	Sand: Color3,
	SandDark: Color3,
	Ocean: Color3,
	OceanDark: Color3,
	Sky: Color3,
	Sunset: Color3,
	Coral: Color3,
	Palm: Color3,
	Gold: Color3,
	Purple: Color3,
	Panel: Color3,
	PanelAlt: Color3,
	Text: Color3,
	TextDark: Color3,
	Stroke: Color3,
	Success: Color3,
	Danger: Color3,
	Warning: Color3,
	Disabled: Color3,
	Coins: Color3,
	Tokens: Color3,
	Robux: Color3,
	-- v3 restyle (docs/UI_STYLE.md): ocean-navy panel bodies, meaning colours for text
	Navy: Color3, -- panel body top
	NavyDark: Color3, -- panel body bottom
	NavyCard: Color3, -- inner cards on a navy body
	NavyCardDark: Color3,
	Money: Color3, -- coins / money text
	Time: Color3, -- boosts / timers text
	Highlight: Color3, -- "next" stat box, current-step accents
}

export type ThemeFonts = {
	Title: Enum.Font,
	Body: Enum.Font,
	Number: Enum.Font,
}

export type ThemeDef = {
	Colors: ThemeColors,
	Fonts: ThemeFonts,
	CornerSmall: UDim,
	CornerMedium: UDim,
	CornerLarge: UDim,
	CornerPill: UDim,
	StrokeThickness: number,
	MinTouchSize: number, -- px; never make a tappable button smaller than this
	TweenTime: number,
}

export type TutorialStep = {
	Id: string,
	Text: string, -- short, kid-friendly, big font
	Target: string?, -- CollectionService tag the 3D arrow / beam points at ("Sand" = nearest dig-zone sand)
	Complete: string, -- event that completes the step (see Config.TUTORIAL_STEPS)
}

-- Persistence & networking -----------------------------------------------------------------

-- v2: survival (heat / shade / consumables) ---------------------------------------------------
-- Owned by the Survival agent; may add fields, must keep these.

export type HeatConfig = {
	Max: number, -- heat meter range 0..Max
	SunRisePerSecond: number, -- standing in the sun on the surface
	DigRisePerDig: number, -- extra heat per dig while in the sun
	ShadeFallPerSecond: number, -- base cooling while in shade (scaled by the shade's Cooling)
	UndergroundDepth: number, -- studs below surface where it counts as underground (cool)
	UndergroundFallPerSecond: number,
	SunburntAt: number, -- heat at which the player becomes Sunburnt
	RecoverAt: number, -- Sunburnt clears when heat drops to this
	SunburntCooldownMultiplier: number, -- dig cooldown multiplier while Sunburnt (e.g. 2)
	NewPlayerGraceSeconds: number, -- no heat gain for brand-new players' first minutes
	-- Survival agent additions
	TickSeconds: number, -- server heat tick interval
	DigRiseMaxPerSecond: number, -- cap on dig heat per second (fast shovels / diggers)
	OffSandFallPerSecond: number, -- cooling anywhere off the hot sand (boardwalk, hub, sea)
	WarningAt: number, -- "getting hot" hint threshold
	EventSunMultipliers: { [string]: number }, -- Config.Events id -> multiplier on sun heat
	FountainCooldownSeconds: number,
	ConsumableMaxStack: number, -- max count of one consumable in PlayerData.Consumables
	ConsumableBoostCapSeconds: number, -- consumable boosts stack time up to this many seconds
	ShadeSlots: number, -- placed shades per player
	ShadeSlotsVip: number, -- placed shades with the VIP pass
	ShadePlaceRange: number, -- max horizontal studs from the player to the placement point
	ShadeMinSpacing: number, -- min studs between two shade poles
	ShadeHubClearance: number, -- min studs from hub stations (tagged parts)
}

export type ShadeDef = {
	Id: string,
	Name: string,
	Price: number,
	RebirthsRequired: number?,
	Radius: number, -- studs (horizontal) of shade
	Cooling: number, -- multiplier on HeatConfig.ShadeFallPerSecond
	Height: number, -- studs from the ground to the underside of the canopy (shade check + model)
	Description: string,
	Look: { [string]: any },
}

export type ConsumableDef = {
	Id: string,
	Name: string,
	Price: number, -- coins; 0 = free (e.g. water fountain only)
	Cooling: number, -- heat removed instantly
	Boost: string?, -- Config.Boosts id granted on use
	BoostSeconds: number?,
	Icon: string, -- emoji/text icon
	Description: string,
	Look: { [string]: any },
}

-- v2 digger companions were folded into pets in v2.1 (vehicle pets from Construction Crates).
-- DiggerInstance stays only so old saves' PlayerData.Diggers can be read by the DataService
-- migration (v1 -> v2), which converts them to pets and leaves the table empty.
export type DiggerInstance = {
	Level: number,
	Equipped: boolean,
}

export type PlayerData = {
	Coins: number,
	Sand: number, -- sand currently in backpack
	TotalSandDug: number,
	Rebirths: number,
	RebirthTokens: number,
	MaxDepth: number, -- studs below surface
	Shovel: string,
	OwnedShovels: { [string]: boolean },
	Backpack: string,
	OwnedBackpacks: { [string]: boolean },
	Pets: { [string]: PetInstance }, -- key = uid
	PetSlots: number,
	Treasures: { [string]: number }, -- legacy (v3: emptied by the migration into Finds, never written)
	-- v3 discovery: unsold finds, key "treasureId|Size|Material|Quality" -> count (Util/Finds.Key)
	Finds: { [string]: number },
	-- v3 discovery: variants seen per treasure, key "treasureId/VariantId" (never reset)
	FindVariants: { [string]: boolean },
	Index: { [string]: boolean }, -- discovered treasures (collection), never reset
	DailyStreak: number,
	LastDailyClaim: number, -- unix
	Quests: { [string]: QuestProgress },
	RedeemedCodes: { [string]: boolean },
	Settings: { [string]: any },
	Boosts: { [string]: number }, -- boostId -> expires unix
	Consumables: { [string]: number }, -- v2: consumable id -> count
	OwnedShades: { [string]: boolean }, -- v2
	Diggers: { [string]: DiggerInstance }, -- v2 (legacy): emptied by the v2.1 migration, never written
	Pity: { [string]: number }, -- v2.2: eggId -> hatches in a row without a Rare+ pet (EggDef.PityAt)
	LastOnline: number, -- v2.2: unix time last seen online (OfflineService), 0 = never
	RebirthPerks: { [string]: number }, -- v2.2: Config.RebirthPerks id -> level (never reset)
	PlayTime: number, -- seconds
	FirstJoin: number, -- unix
	Version: number,
}

-- v2 (Beach): DigService.DigAt(player, position, opts). Shovel/Auto digs use the equipped
-- shovel's stats; Digger / Pet (PetDigService) / Ride digs pass their own.
export type DigSource = "Shovel" | "Digger" | "Auto" | "Pet" | "Ride"

export type DigOptions = {
	Power: number, -- compared against LayerDef.Hardness
	Radius: number, -- same scale as ShovelDef.Radius
	SandMultiplier: number, -- replaces the shovel's SandMultiplier in Stats
	Source: DigSource,
	Silent: boolean?, -- true: no DigResult is sent to the player
	Origin: Vector3?, -- "Ride": server-side vehicle position the range check measures from
}

export type DigFailReason = "Cooldown" | "TooHard" | "BackpackFull" | "OutOfZone" | "TooFar" | "Bottom"

export type DigResult = {
	Success: boolean,
	Reason: DigFailReason?,
	Position: Vector3,
	Radius: number,
	SandGained: number,
	Sand: number, -- backpack total after the dig
	Capacity: number, -- effective backpack capacity
	Depth: number, -- studs below surface of the dig point
	LayerIndex: number,
	NewMaxDepth: boolean, -- true if this dig set a personal record
	NewLayer: boolean, -- true if this is the first time the player reached this layer
	TreasureId: string?,
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="45">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Finds</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Finds (v3 discovery slice) — pure functions shared by the server (authoritative) and the client
	(Index odds, reveal presentation, detector UI). Numbers live in Config.Discovery; the design
	is docs/design/Discovery.md.

	Value of a find = base x size x material x quality, where base = TreasureDef.SellValue, or for
	Relics ScaledValue x RewardScale of the player's deepest layer (seconds of income).

	Odds: Finds.VariantOdds(group, luck) is the ONE odds function. The server rolls with
	Finds.RollVariant (= Weighted.Pick over the same list) and the Index shows the same list with
	the player's current luck (Stats.GetLuck), so displayed odds are the true odds.

	Unsold finds are stored in PlayerData.Finds as "treasureId|Size|Material|Quality" -> count.
	Variants seen are in PlayerData.FindVariants as "treasureId/VariantId" -> true.
]]

local Shared = script.Parent.Parent
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Weighted = require(script.Parent.Weighted)

local D = Config.Discovery

export type VariantOdd = { Id: string, Chance: number }
export type Grade = "Perfect" | "Good" | "Miss"
export type VariantDef = typeof(Config.Discovery.SIZES[1])
export type QualityDef = typeof(Config.Discovery.QUALITIES[1])

local Finds = {}

Finds.TIERS = table.freeze({ "Pop", "Beam", "Card", "Server", "Spectacle" })

local sizeById: { [string]: VariantDef } = {}
for _, v in D.SIZES do
	sizeById[v.Id] = v
end
local materialById: { [string]: VariantDef } = {}
for _, v in D.MATERIALS do
	materialById[v.Id] = v
end
local qualityById: { [string]: QualityDef } = {}
for _, q in D.QUALITIES do
	qualityById[q.Id] = q
end
local tierOrder: { [string]: number } = {}
for i, t in Finds.TIERS do
	tierOrder[t] = i
end

-- Relics by unlock layer (any deposit of layer >= def.Layer may hold one).
local relics: { Types.TreasureDef } = {}
for _, def in Config.Treasures do
	if def.Rarity == "Relic" then
		table.insert(relics, def)
	end
end

function Finds.GetSize(id: string): VariantDef?
	return sizeById[id]
end

function Finds.GetMaterial(id: string): VariantDef?
	return materialById[id]
end

function Finds.GetQuality(id: string): QualityDef?
	return qualityById[id]
end

function Finds.IsSize(id: any): boolean
	return type(id) == "string" and sizeById[id] ~= nil
end

function Finds.IsMaterial(id: any): boolean
	return type(id) == "string" and materialById[id] ~= nil
end

-- Keys ------------------------------------------------------------------------------------------

function Finds.Key(treasureId: string, size: string, material: string, quality: string): string
	return treasureId .. "|" .. size .. "|" .. material .. "|" .. quality
end

-- (treasureId, size, material, quality) or nil for a malformed / unknown key.
function Finds.ParseKey(key: string): (string?, string?, string?, string?)
	local id, size, material, quality = string.match(key, "^([^|]+)|([^|]+)|([^|]+)|([^|]+)$")
	if not id or not size or not material or not quality then
		return nil, nil, nil, nil
	end
	local i, sz, m, q = id :: string, size :: string, material :: string, quality :: string
	if not Config.GetTreasure(i) or not sizeById[sz] or not materialById[m] or not qualityById[q] then
		return nil, nil, nil, nil
	end
	return i, sz, m, q
end

function Finds.VariantKey(treasureId: string, variantId: string): string
	return treasureId .. "/" .. variantId
end

-- Odds -------------------------------------------------------------------------------------------

local function sanitizeLuck(luck: number?): number
	local l = luck or 1
	if l ~= l or l == math.huge or l < 1 then
		return 1
	end
	return l
end

-- True odds of a variant group ("Size" | "Material") at this luck: luck multiplies the weight of
-- every Lucky (rarer-than-default) variant. Returns { {Id, Chance} } in config order, sums to 1.
function Finds.VariantOdds(group: string, luck: number?): { VariantOdd }
	local list: { VariantDef } = if group == "Size" then D.SIZES else D.MATERIALS
	local l = sanitizeLuck(luck)
	local total = 0
	for _, v in list do
		total += v.Weight * (if v.Lucky then l else 1)
	end
	local out: { VariantOdd } = {}
	for _, v in list do
		table.insert(out, { Id = v.Id, Chance = v.Weight * (if v.Lucky then l else 1) / total })
	end
	return out
end

function Finds.RollVariant(group: string, luck: number?, roll: number): string
	local odds = Finds.VariantOdds(group, luck)
	local picked = Weighted.Pick(odds, function(o: VariantOdd): number
		return o.Chance
	end, roll)
	return if picked then picked.Id else (if group == "Size" then "Normal" else "None")
end

-- Deposit contents: a Relic with D.RELIC_CHANCE (when one is unlocked at this layer), else the
-- layer's LootTable at base weights. relicRoll / lootRoll in [0, 1).
function Finds.RollTreasure(layerIndex: number, relicRoll: number, lootRoll: number): string?
	local index = math.clamp(math.floor(layerIndex), 1, #Config.Layers)
	if relicRoll < D.RELIC_CHANCE then
		local eligible: { Types.TreasureDef } = {}
		for _, def in relics do
			if def.Layer <= index then
				table.insert(eligible, def)
			end
		end
		if #eligible > 0 then
			return eligible[math.clamp(math.floor(lootRoll * #eligible) + 1, 1, #eligible)].Id
		end
	end
	local entry = Weighted.Pick(Config.Layers[index].LootTable, function(e: Types.LootEntry): number
		return e.Weight
	end, lootRoll)
	return if entry then entry.TreasureId else nil
end

function Finds.Relics(): { Types.TreasureDef }
	return relics
end

-- Expected deposits per chunk at a layer (fraction = chance of one more).
function Finds.Density(layerIndex: number): number
	return D.DENSITY[math.clamp(math.floor(layerIndex), 1, #D.DENSITY)]
end

-- Excavation scoring ---------------------------------------------------------------------------------

-- One ring: absolute timing error in seconds (negative / NaN / non-number = no tap).
function Finds.Grade(err: any): Grade
	if type(err) ~= "number" or err ~= err or err < 0 then
		return "Miss"
	end
	if err <= D.PERFECT_WINDOW then
		return "Perfect"
	elseif err <= D.GOOD_WINDOW then
		return "Good"
	end
	return "Miss"
end

-- Scores a client report (clamped: at most D.RINGS entries count). Returns (score, perfects).
function Finds.Score(errors: any): (number, number)
	if type(errors) ~= "table" then
		return 0, 0
	end
	local score, perfects = 0, 0
	for i = 1, D.RINGS do
		local grade = Finds.Grade((errors :: { any })[i])
		if grade == "Perfect" then
			score += 2
			perfects += 1
		elseif grade == "Good" then
			score += 1
		end
	end
	return score, perfects
end

function Finds.QualityForScore(score: number): Types.FindQuality
	local best: Types.FindQuality = "Damaged"
	for _, q in D.QUALITIES do
		if score >= q.MinScore then
			best = q.Id
		end
	end
	return best
end

-- Value -----------------------------------------------------------------------------------------

function Finds.BaseValue(def: Types.TreasureDef, maxDepth: number): number
	if def.ScaledValue then
		return def.ScaledValue * Config.GetLayerAtDepth(maxDepth).RewardScale
	end
	return def.SellValue
end

-- Coins for one find (before coin boosts / events), rounded down, at least 1.
function Finds.Value(treasureId: string, size: string, material: string, quality: string, maxDepth: number): number
	local found = Config.GetTreasure(treasureId)
	if not found then
		return 0
	end
	local def = found :: Types.TreasureDef
	local s = sizeById[size]
	local m = materialById[material]
	local q = qualityById[quality]
	local mult = (if s then s.ValueMultiplier else 1)
		* (if m then m.ValueMultiplier else 1)
		* (if q then q.ValueMultiplier else 1)
	return math.max(1, math.floor(Finds.BaseValue(def, maxDepth) * mult))
end

-- Total coins of a PlayerData.Finds table (unknown keys ignored).
function Finds.TotalValue(finds: { [string]: number }?, maxDepth: number): number
	local total = 0
	local list: { [string]: number } = finds or {}
	for key, count in list do
		if type(key) == "string" and type(count) == "number" and count > 0 then
			local id, size, material, quality = Finds.ParseKey(key)
			if id and size and material and quality then
				total += Finds.Value(id, size, material, quality, maxDepth) * count
			end
		end
	end
	return total
end

function Finds.Count(finds: { [string]: number }?): number
	local n = 0
	local list: { [string]: number } = finds or {}
	for _, count in list do
		if type(count) == "number" and count > 0 then
			n += count
		end
	end
	return n
end

-- Presentation --------------------------------------------------------------------------------------

function Finds.TierOrder(tier: string): number
	return tierOrder[tier] or 1
end

-- Tier by rarity; a Giant or any material variant lifts a Pop to a Beam (variants feel special).
function Finds.Tier(rarity: string, size: string?, material: string?): Types.FindTier
	local tier: Types.FindTier = D.TIER_BY_RARITY[rarity] or "Pop"
	if tier == "Pop" and (size == "Giant" or (material ~= nil and material ~= "None")) then
		tier = "Beam"
	end
	return tier
end

function Finds.Signal(rarity: string): Types.DetectorSignal
	return D.SIGNAL_BY_RARITY[rarity] or "White"
end

-- "Giant Golden Bottle Cap" (default variants add nothing).
function Finds.DisplayName(treasureId: string, size: string?, material: string?): string
	local def = Config.GetTreasure(treasureId)
	local parts = {}
	local s = if size then sizeById[size] else nil
	local m = if material then materialById[material] else nil
	if s and s.Name ~= "" then
		table.insert(parts, s.Name)
	end
	if m and m.Name ~= "" then
		table.insert(parts, m.Name)
	end
	table.insert(parts, if def then def.Name else treasureId)
	return table.concat(parts, " ")
end

-- Detector --------------------------------------------------------------------------------------------

-- 1 (hot) .. #BANDS + 1 (edge of range), 0 = out of range.
function Finds.Band(distance: number, range: number?): number
	if distance ~= distance or distance > (range or D.DETECTOR_RANGE) then
		return 0
	end
	for i, limit in D.BANDS do
		if distance < limit then
			return i
		end
	end
	return #D.BANDS + 1
end

-- Compass sector of a horizontal offset: 0 = +Z, increasing towards +X. -1 for ~zero offset.
function Finds.Sector(dx: number, dz: number): number
	if math.abs(dx) < 0.5 and math.abs(dz) < 0.5 then
		return -1
	end
	local angle = math.atan2(dx, dz) -- 0 at +Z, +pi/2 at +X
	return math.floor(angle / (2 * math.pi) * D.SECTORS + 0.5) % D.SECTORS
end

-- Unit horizontal world direction of a sector (inverse of Finds.Sector).
function Finds.SectorDirection(sector: number): Vector3
	local angle = sector / D.SECTORS * 2 * math.pi
	return Vector3.new(math.sin(angle), 0, math.cos(angle))
end

function Finds.Vertical(dy: number): string
	if dy <= -D.VERTICAL_LEVEL then
		return "Down"
	elseif dy >= D.VERTICAL_LEVEL then
		return "Up"
	end
	return "Level"
end

-- True when the find at `offset` is (nearly) straight below / above: digging vertically from here
-- reaches it, while the compass sector of a tiny horizontal offset would only send you wandering.
function Finds.Overhead(offset: Vector3): boolean
	if Finds.Vertical(offset.Y) == "Level" then
		return false
	end
	local horizontal = Vector3.new(offset.X, 0, offset.Z).Magnitude
	return horizontal <= math.max(D.OVERHEAD_MIN, math.abs(offset.Y) * D.OVERHEAD_SLOPE)
end

-- The coarse ping for a deposit at `offset` (deposit - player) of this rarity.
function Finds.Ping(offset: Vector3?, rarity: string?, remaining: number, range: number?): Types.DetectorPing
	if not offset or not rarity then
		return { Band = 0, Sector = -1, Vertical = "", Signal = "", Remaining = remaining }
	end
	local o = offset :: Vector3
	local band = Finds.Band(o.Magnitude, range)
	if band == 0 then
		return { Band = 0, Sector = -1, Vertical = "", Signal = "", Remaining = remaining }
	end
	return {
		Band = band,
		Sector = Finds.Sector(o.X, o.Z),
		Vertical = Finds.Vertical(o.Y),
		Signal = Finds.Signal(rarity :: string),
		Remaining = remaining,
		Overhead = Finds.Overhead(o),
	}
end

-- Seconds between detector beeps for a band (client sound pacing).
function Finds.BeepInterval(band: number): number
	if band <= 0 then
		return 0
	end
	return ({ 0.12, 0.25, 0.45, 0.8 })[math.clamp(band, 1, 4)]
end

return Finds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Number/time formatting shared by UI, leaderboards and notifications.
local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234 -> "1.23K", 15 -> "15", 1e15 -> "1Qa"
function Format.Abbreviate(n: number): string
	if n ~= n then
		return "0"
	end
	local sign = if n < 0 then "-" else ""
	n = math.abs(n)
	if n < 1000 then
		return sign .. tostring(math.floor(n))
	end
	local tier = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
	local scaled = n / 10 ^ (tier * 3)
	local text = if scaled >= 100
		then string.format("%d", math.floor(scaled))
		elseif scaled >= 10 then string.format("%.1f", math.floor(scaled * 10) / 10)
		else string.format("%.2f", math.floor(scaled * 100) / 100)
	text = (text:gsub("%.?0+$", ""))
	return sign .. text .. SUFFIXES[tier + 1]
end

-- v2.2 odds display: probability (0..1) -> "60%", "12.5%", "1.9%", "0.5%", "0.05%", "0.012%".
-- >= 10%: one decimal; >= 1%: two; below that two significant digits. Trailing zeros dropped.
function Format.Chance(probability: number): string
	if probability ~= probability or probability <= 0 then
		return "0%"
	end
	local pct = math.min(probability, 1) * 100
	local decimals = if pct >= 10 then 1 elseif pct >= 1 then 2 else math.ceil(-math.log10(pct)) + 1
	local text = string.format("%." .. math.clamp(decimals, 0, 8) .. "f", pct)
	if string.find(text, ".", 1, true) then
		text = (text:gsub("0+$", ""):gsub("%.$", ""))
	end
	return text .. "%"
end

-- 1234567 -> "1,234,567"
function Format.Commas(n: number): string
	local s = tostring(math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (if n < 0 then "-" else "") .. out
end

-- 125 -> "2:05", 3725 -> "1:02:05"
function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

function Format.Depth(studs: number): string
	return Format.Commas(math.floor(studs)) .. "m"
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RateLimiter — token bucket per key (usually a Player). Pure: the clock is injectable so it
	can be unit-tested outside Roblox.

		local limiter = RateLimiter.new(10, 1) -- burst of 10, refills 10 per second
		if not limiter:Check(player) then return end
]]

export type RateLimiter = {
	Check: (self: RateLimiter, key: any, cost: number?) -> boolean,
	Remove: (self: RateLimiter, key: any) -> (),
}

type Bucket = { Tokens: number, Last: number }

local RateLimiter = {}

function RateLimiter.new(capacity: number, windowSeconds: number, clock: (() -> number)?): RateLimiter
	assert(capacity > 0 and windowSeconds > 0, "RateLimiter: capacity and window must be > 0")
	local now: () -> number = clock or os.clock
	local refillPerSecond = capacity / windowSeconds
	local buckets: { [any]: Bucket } = {}

	local self = {} :: RateLimiter

	function self.Check(_: RateLimiter, key: any, cost: number?): boolean
		local price = cost or 1
		local t = now()
		local bucket = buckets[key]
		if not bucket then
			bucket = { Tokens = capacity, Last = t }
			buckets[key] = bucket
		end
		bucket.Tokens = math.min(capacity, bucket.Tokens + (t - bucket.Last) * refillPerSecond)
		bucket.Last = t
		if bucket.Tokens >= price then
			bucket.Tokens -= price
			return true
		end
		return false
	end

	function self.Remove(_: RateLimiter, key: any)
		buckets[key] = nil
	end

	return self
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">RideMath</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RideMath — ride-on vehicle geometry shared by RideService (server) and RideController
	(client) so both agree on the allowed area and the ground height (Config.Ride).

	- Bounds(zoneCFrame, zoneSize): the rectangle the vehicle PIVOT may occupy: the dig zone
	  (minus EdgeMargin) plus the boardwalk up to InlandMaxZ.
	- Clamp(position, bounds): position clamped into the rectangle (Y unchanged).
	- Inside(position, bounds, slack): horizontal containment test.
	- GroundY(pivot): height for the pivot (bottom of the tracks) at `pivot`: the highest of the
	  track samples, where each sample is the boardwalk deck top (z >= DeckSeaEdgeZ) or the terrain
	  surface from a raycast, floored at SURFACE_Y so the vehicle rides OVER dug holes at surface
	  level instead of falling in.
]]

local Workspace = game:GetService("Workspace")

local Config = require(script.Parent.Parent.Config)

local RideMath = {}

export type Bounds = { MinX: number, MaxX: number, MinZ: number, MaxZ: number }

local R = Config.Ride
local S = Config.SURFACE_Y

local terrainOnly = RaycastParams.new()
terrainOnly.FilterType = Enum.RaycastFilterType.Include
terrainOnly.FilterDescendantsInstances = { Workspace.Terrain }
terrainOnly.IgnoreWater = true

function RideMath.Bounds(zoneCFrame: CFrame, zoneSize: Vector3): Bounds
	local c = zoneCFrame.Position
	return {
		MinX = c.X - zoneSize.X / 2 + R.EdgeMargin,
		MaxX = c.X + zoneSize.X / 2 - R.EdgeMargin,
		MinZ = c.Z - zoneSize.Z / 2 + R.EdgeMargin,
		MaxZ = R.InlandMaxZ,
	}
end

function RideMath.Clamp(position: Vector3, b: Bounds): Vector3
	return Vector3.new(math.clamp(position.X, b.MinX, b.MaxX), position.Y, math.clamp(position.Z, b.MinZ, b.MaxZ))
end

function RideMath.Inside(position: Vector3, b: Bounds, slack: number?): boolean
	local s = slack or 0
	return position.X >= b.MinX - s
		and position.X <= b.MaxX + s
		and position.Z >= b.MinZ - s
		and position.Z <= b.MaxZ + s
end

-- Ground height at one world (x, z) point.
function RideMath.GroundAt(x: number, z: number): number
	if z >= R.DeckSeaEdgeZ then
		return S + R.DeckTop
	end
	local hit = Workspace:Raycast(Vector3.new(x, S + 12, z), Vector3.new(0, -24, 0), terrainOnly)
	if hit then
		return math.max(hit.Position.Y, S)
	end
	return S
end

-- Pivot height for a vehicle whose pivot is at `pivot` (only position + yaw are used).
function RideMath.GroundY(pivot: CFrame): number
	local best = -math.huge
	for _, sample in R.TrackSamples do
		local p = pivot * Vector3.new(sample.X, 0, sample.Y)
		best = math.max(best, RideMath.GroundAt(p.X, p.Z))
	end
	return best + R.HoverHeight
end

return RideMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Signal — tiny typed event object (no Instances, works on server and client).

		local changed = Signal.new() :: Signal.Signal<Player, number>
		local conn = changed:Connect(function(player, value) ... end)
		changed:Fire(player, 5)
		conn:Disconnect()

	Handlers run in their own thread (task.spawn), so a yielding or erroring handler never
	blocks the caller or other handlers.
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal<T...> = {
	Connect: (self: Signal<T...>, handler: (T...) -> ()) -> Connection,
	Once: (self: Signal<T...>, handler: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	Wait: (self: Signal<T...>) -> T...,
	DisconnectAll: (self: Signal<T...>) -> (),
}

local Signal = {}

function Signal.new<T...>(): Signal<T...>
	type Entry = { Handler: (T...) -> (), Connection: Connection }
	local entries: { Entry } = {}

	local function remove(connection: Connection)
		for i, entry in entries do
			if entry.Connection == connection then
				table.remove(entries, i)
				return
			end
		end
	end

	local self = {} :: Signal<T...>

	function self.Connect(_: Signal<T...>, handler: (T...) -> ()): Connection
		local connection = {} :: Connection
		connection.Connected = true
		function connection.Disconnect(c: Connection)
			if c.Connected then
				c.Connected = false
				remove(c)
			end
		end
		table.insert(entries, { Handler = handler, Connection = connection })
		return connection
	end

	function self.Once(s: Signal<T...>, handler: (T...) -> ()): Connection
		local connection: Connection
		connection = s:Connect(function(...: T...)
			connection:Disconnect()
			handler(...)
		end)
		return connection
	end

	function self.Fire(_: Signal<T...>, ...: T...)
		-- Snapshot so handlers may connect/disconnect while we iterate.
		local snapshot = table.clone(entries)
		for _, entry in snapshot do
			if entry.Connection.Connected then
				task.spawn(entry.Handler, ...)
			end
		end
	end

	function self.Wait(s: Signal<T...>): T...
		local thread = coroutine.running()
		s:Once(function(...: T...)
			task.spawn(thread, ...)
		end)
		return coroutine.yield()
	end

	function self.DisconnectAll(_: Signal<T...>)
		for _, entry in entries do
			entry.Connection.Connected = false
		end
		table.clear(entries)
	end

	return self
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Stats</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Stats — the ONE place the multiplier stack is computed. Pure functions of a Context, used by
	the server (authoritative) and safe for the client to mirror for UI ("x12.5 sand", odds...).

	Building a Context on the client:
		{
			Data = <PlayerData from DataChanged/GetData>,
			Passes = <GetOwnedPasses() result>,
			IsPremium = player.MembershipType == Enum.MembershipType.Premium,
			InGroup = player:GetAttribute("InGroup") == true,
			FriendsInServer = player:GetAttribute("FriendsInServer") or 0,
			ActiveEvents = <EventChanged ids>,
			Now = os.time(),
		}
	(The server also publishes the results as Player attributes — see MultiplierService.)

	Sand per dig = layer.SandValue x shovel x rebirth x pets x passes x premium x group x friends
	               x index x Sand boosts x Sand events
	Capacity     = backpack.Capacity x rebirth x pass CapacityMultiplier (Mega Backpack) x Deep Pockets perk
	Luck         = Luck boosts x Luck events (v2.3: no pass sells luck; LuckMultiplier stays
	               supported but Config rejects it on passes)
	Coins (sell) = Golden Touch perk x pass CoinMultiplier (VIP, v2.3) x Coins boosts x Coins events
	(v2.2 Rebirth perks, Config.RebirthPerks: Pet Den adds pet slots, Lucky Digger multiplies the
	treasure chance only.)
	Speed        = pass SpeedMultiplier x Speed boosts x Speed events (cooldown is divided by it)

	v2.2 TRUE ODDS (Roblox policy: paid random items show their real, modified odds):
	Stats.GetHatchOdds(egg, luck, pityCount?) -> ({ [petId]: probability }, pityActive)
	Stats.GetHatchOddsList(egg, luck, pityCount?) -> ({ { PetId, Chance } } in egg order, pityActive)
	Stats.RollHatch(egg, luck, pityCount, roll) -> petId?
	The server rolls with RollHatch (= Weighted.Pick over GetHatchOddsList) and the egg panel
	displays GetHatchOddsList with the same luck (Stats.GetLuck) and pity counter
	(PlayerData.Pity[egg.Id]), so what players see is exactly what the server rolls.
]]

local Shared = script.Parent.Parent
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Finds = require(script.Parent.Finds) -- v3 discovery slice
local Weighted = require(script.Parent.Weighted)

export type Context = {
	Data: Types.PlayerData,
	Passes: { [string]: boolean },
	IsPremium: boolean,
	InGroup: boolean,
	FriendsInServer: number,
	ActiveEvents: { string },
	Now: number,
}

export type Factor = {
	Name: string, -- short label for UI breakdowns ("Shovel", "Rebirth", "2x Sand"...)
	Value: number,
}

local Stats = {}

local PASS_KEYS: { string } = {}
for key in Config.Monetization.GamePasses do
	table.insert(PASS_KEYS, key)
end
table.sort(PASS_KEYS)

function Stats.Product(factors: { Factor }): number
	local total = 1
	for _, factor in factors do
		total *= factor.Value
	end
	return total
end

function Stats.GetShovel(data: Types.PlayerData): Types.ShovelDef
	return Config.GetShovel(data.Shovel) or Config.Shovels[1]
end

function Stats.GetBackpack(data: Types.PlayerData): Types.BackpackDef
	return Config.GetBackpack(data.Backpack) or Config.Backpacks[1]
end

-- Equip slots: PlayerData.PetSlots + ExtraPets pass.
function Stats.GetPetSlots(ctx: Context): number
	local slots = ctx.Data.PetSlots + Config.RebirthPerks.ExtraPetSlots(ctx.Data.RebirthPerks) -- v2.2 Pet Den
	for _, key in PASS_KEYS do
		local pass = Config.Monetization.GamePasses[key]
		if ctx.Passes[key] and pass.ExtraPetSlots then
			slots += pass.ExtraPetSlots
		end
	end
	return slots
end

-- Equipped pet ids, capped at `maxSlots` (sorted by uid so the cap is deterministic).
-- v2.2: second result golden[i] = true when ids[i] is a Golden pet (Config.PetMultiplier).
function Stats.GetEquippedPetIds(data: Types.PlayerData, maxSlots: number): ({ string }, { [number]: boolean })
	local uids = {}
	for uid, pet in data.Pets do
		if pet.Equipped then
			table.insert(uids, uid)
		end
	end
	table.sort(uids)
	local ids = {}
	local golden: { [number]: boolean } = {}
	for i, uid in uids do
		if i > maxSlots then
			break
		end
		table.insert(ids, data.Pets[uid].Id)
		if data.Pets[uid].Golden == true then
			golden[#ids] = true
		end
	end
	return ids, golden
end

-- v2.2: equipped pets (valid ids) in the order of the "EquippedPets" attribute: by Id, normal
-- before Golden. PetService (attributes), PetDigService (slots) and the client all use this.
function Stats.SortEquipped(pets: { [string]: Types.PetInstance }): { Types.PetInstance }
	local list: { Types.PetInstance } = {}
	for _, pet in pets do
		if pet.Equipped and Config.GetPet(pet.Id) then
			table.insert(list, pet)
		end
	end
	table.sort(list, function(a: Types.PetInstance, b: Types.PetInstance): boolean
		if a.Id ~= b.Id then
			return a.Id < b.Id
		end
		return a.Golden ~= true and b.Golden == true
	end)
	return list
end

function Stats.IsBoostActive(data: Types.PlayerData, boostId: string, now: number): boolean
	local expires = data.Boosts[boostId]
	return expires ~= nil and expires > now
end

-- Seconds left on a boost (0 when inactive).
function Stats.GetBoostRemaining(data: Types.PlayerData, boostId: string, now: number): number
	local expires = data.Boosts[boostId]
	if expires == nil then
		return 0
	end
	return math.max(0, expires - now)
end

-- Appends boost + event factors of a given kind.
local function addTimed(ctx: Context, kind: Types.BoostKind, factors: { Factor })
	local boostIds = {}
	for boostId, expires in ctx.Data.Boosts do
		if expires > ctx.Now then
			table.insert(boostIds, boostId)
		end
	end
	table.sort(boostIds)
	for _, boostId in boostIds do
		local def = Config.GetBoost(boostId)
		if def and def.Kind == kind then
			table.insert(factors, { Name = def.Name, Value = def.Multiplier })
		end
	end
	for _, eventId in ctx.ActiveEvents do
		local event = Config.GetEvent(eventId)
		if event and event.Kind == kind then
			table.insert(factors, { Name = event.Name, Value = event.Multiplier })
		end
	end
end

local function addPasses(ctx: Context, field: string, factors: { Factor })
	for _, key in PASS_KEYS do
		if ctx.Passes[key] then
			local pass = Config.Monetization.GamePasses[key] :: any
			local value = pass[field]
			if type(value) == "number" and value ~= 1 then
				table.insert(factors, { Name = pass.Name, Value = value })
			end
		end
	end
end

-- Sand ----------------------------------------------------------------------------------------

-- Additive pet bonus of the equipped pets (Golden pets count x GOLDEN_SAND_BONUS).
function Stats.GetPetMultiplier(ctx: Context): number
	local ids, golden = Stats.GetEquippedPetIds(ctx.Data, Stats.GetPetSlots(ctx))
	return Config.PetMultiplier(ids, golden)
end

function Stats.GetSandFactors(ctx: Context): { Factor }
	local data = ctx.Data
	local factors: { Factor } = {
		{ Name = "Shovel", Value = Stats.GetShovel(data).SandMultiplier },
		{ Name = "Rebirth", Value = Config.RebirthMultiplier(data.Rebirths) },
		{ Name = "Pets", Value = Stats.GetPetMultiplier(ctx) },
	}
	addPasses(ctx, "SandMultiplier", factors)
	if ctx.IsPremium then
		table.insert(factors, { Name = "Premium", Value = Config.Monetization.Premium.SandMultiplier })
	end
	if ctx.InGroup and Config.GROUP_ID ~= 0 then
		table.insert(factors, { Name = "Group", Value = Config.GROUP_SAND_MULTIPLIER })
	end
	local friends = math.max(0, math.floor(ctx.FriendsInServer))
	if friends > 0 then
		local bonus = math.min(friends * Config.FRIEND_BONUS_PER_FRIEND, Config.FRIEND_BONUS_MAX)
		table.insert(factors, { Name = "Friends", Value = 1 + bonus })
	end
	local completed = Config.CountCompletedIndexLayers(data.Index)
	if completed > 0 then
		table.insert(factors, { Name = "Index", Value = 1 + completed * Config.INDEX_LAYER_BONUS })
	end
	addTimed(ctx, "Sand", factors)
	return factors
end

function Stats.GetSandMultiplier(ctx: Context): number
	return Stats.Product(Stats.GetSandFactors(ctx))
end

function Stats.GetSandPerDig(ctx: Context, layerIndex: number): number
	local layer = Config.Layers[math.clamp(layerIndex, 1, #Config.Layers)]
	return layer.SandValue * Stats.GetSandMultiplier(ctx)
end

-- Capacity ------------------------------------------------------------------------------------

function Stats.GetCapacity(ctx: Context): number
	local factors: { Factor } = {
		{ Name = "Rebirth", Value = Config.RebirthMultiplier(ctx.Data.Rebirths) },
	}
	addPasses(ctx, "CapacityMultiplier", factors)
	local pockets = Config.RebirthPerks.CapacityFactor(ctx.Data.RebirthPerks) -- v2.2 Deep Pockets perk
	if pockets ~= 1 then
		table.insert(factors, { Name = "Deep Pockets", Value = pockets })
	end
	return math.floor(Stats.GetBackpack(ctx.Data).Capacity * Stats.Product(factors))
end

-- Luck ----------------------------------------------------------------------------------------

function Stats.GetLuckFactors(ctx: Context): { Factor }
	local factors: { Factor } = {}
	addPasses(ctx, "LuckMultiplier", factors)
	addTimed(ctx, "Luck", factors)
	return factors
end

function Stats.GetLuck(ctx: Context): number
	return Stats.Product(Stats.GetLuckFactors(ctx))
end

-- Chance (0..MAX_TREASURE_CHANCE) that a successful dig in this layer finds a treasure.
function Stats.GetTreasureChance(ctx: Context, layerIndex: number): number
	local layer = Config.Layers[math.clamp(layerIndex, 1, #Config.Layers)]
	-- v2.2 Lucky Digger perk: treasure chance only (egg odds are untouched by it)
	local perk = Config.RebirthPerks.TreasureFactor(ctx.Data.RebirthPerks)
	return math.min(layer.TreasureChance * Stats.GetLuck(ctx) * perk, Config.MAX_TREASURE_CHANCE)
end

-- Luck multiplies the weight of every non-Common entry (loot tables and eggs).
function Stats.LuckWeight(baseWeight: number, rarity: Types.Rarity?, luck: number): number
	if rarity == nil or rarity == "Common" then
		return baseWeight
	end
	return baseWeight * luck
end

-- Hatch odds + pity (v2.2) -----------------------------------------------------------------------

export type HatchOdd = { PetId: string, Chance: number }

local function rarityOrderOf(petId: string): number
	local pet = Config.GetPet(petId)
	local rarity = if pet then Config.GetRarity(pet.Rarity) else nil
	return if rarity then rarity.Order else 0
end

-- Does this pet count as "Rare or better" for pity?
function Stats.IsPityRarity(petId: string): boolean
	return rarityOrderOf(petId) >= Config.PITY_MIN_RARITY_ORDER
end

-- Pity is active (the next hatch is guaranteed Rare+) after egg.PityAt hatches without one.
function Stats.IsPityActive(egg: Types.EggDef, pityCount: number?): boolean
	local at = egg.PityAt
	return at ~= nil and (pityCount or 0) >= at
end

-- Which upcoming hatch is guaranteed Rare+: 1 = the next one. nil when the egg has no pity.
function Stats.HatchesUntilPity(egg: Types.EggDef, pityCount: number?): number?
	local at = egg.PityAt
	if at == nil then
		return nil
	end
	return math.max(1, (at :: number) + 1 - (pityCount or 0))
end

-- The pity counter after hatching petId (reset by a Rare+ pet, otherwise +1).
function Stats.NextPityCount(egg: Types.EggDef, pityCount: number?, petId: string): number
	if egg.PityAt == nil or Stats.IsPityRarity(petId) then
		return 0
	end
	return (pityCount or 0) + 1
end

local function sanitizeLuck(luck: number): number
	if luck ~= luck or luck <= 0 or luck == math.huge then
		return 1
	end
	return luck
end

-- THE odds function. Probability of each pet for ONE hatch of `egg` with this luck (Stats.GetLuck)
-- and pity counter (PlayerData.Pity[egg.Id]); in egg order. Luck multiplies the weight of every
-- non-Common pet (Stats.LuckWeight). When pity is active only Rare+ pets keep their (luck)
-- weight. Returns (list, pityActive). Chances sum to 1.
function Stats.GetHatchOddsList(egg: Types.EggDef, luck: number, pityCount: number?): ({ HatchOdd }, boolean)
	local l = sanitizeLuck(luck)
	local pity = Stats.IsPityActive(egg, pityCount)
	local weights: { number } = {}
	for i, entry in egg.Pets do
		local pet = Config.GetPet(entry.PetId)
		local w = Stats.LuckWeight(entry.Weight, if pet then pet.Rarity else nil, l)
		if pity and not Stats.IsPityRarity(entry.PetId) then
			w = 0
		end
		weights[i] = w
	end
	local indices: { number } = {}
	for i in egg.Pets do
		indices[i] = i
	end
	local probabilities = Weighted.Odds(indices, function(i: number): number
		return weights[i]
	end)
	local list: { HatchOdd } = {}
	for i, entry in egg.Pets do
		list[i] = { PetId = entry.PetId, Chance = probabilities[i] }
	end
	return list, pity
end

-- Same odds keyed by pet id (an egg lists each pet once).
function Stats.GetHatchOdds(egg: Types.EggDef, luck: number, pityCount: number?): ({ [string]: number }, boolean)
	local list, pity = Stats.GetHatchOddsList(egg, luck, pityCount)
	local map: { [string]: number } = {}
	for _, odd in list do
		map[odd.PetId] = (map[odd.PetId] or 0) + odd.Chance
	end
	return map, pity
end

-- Server roll: `roll` in [0, 1) (Random:NextNumber()). Picks from GetHatchOddsList, so the
-- shown odds and the real roll can never diverge.
function Stats.RollHatch(egg: Types.EggDef, luck: number, pityCount: number?, roll: number): string?
	local list = Stats.GetHatchOddsList(egg, luck, pityCount)
	local odd = Weighted.Pick(list, function(o: HatchOdd): number
		return o.Chance
	end, roll)
	return if odd then odd.PetId else nil
end

-- Coins & speed -------------------------------------------------------------------------------

function Stats.GetCoinFactors(ctx: Context): { Factor }
	local factors: { Factor } = {}
	local touch = Config.RebirthPerks.CoinFactor(ctx.Data.RebirthPerks) -- v2.2 Golden Touch perk
	if touch ~= 1 then
		table.insert(factors, { Name = "Golden Touch", Value = touch })
	end
	addPasses(ctx, "CoinMultiplier", factors) -- v2.3: VIP +10% sell coins
	addTimed(ctx, "Coins", factors)
	return factors
end

function Stats.GetCoinMultiplier(ctx: Context): number
	return Stats.Product(Stats.GetCoinFactors(ctx))
end

function Stats.GetSpeedMultiplier(ctx: Context): number
	local factors: { Factor } = {}
	addPasses(ctx, "SpeedMultiplier", factors)
	addTimed(ctx, "Speed", factors)
	return math.max(Stats.Product(factors), 0.01)
end

-- Seconds between digs with the equipped shovel (before server latency leniency).
function Stats.GetCooldown(ctx: Context): number
	return Stats.GetShovel(ctx.Data).Cooldown / Stats.GetSpeedMultiplier(ctx)
end

-- Coins a full sell would pay right now (sand + unsold treasures + v3 finds, coin multipliers
-- applied). Finds: Util/Finds.TotalValue (base x size x material x quality).
function Stats.GetSellValue(ctx: Context): number
	local data = ctx.Data
	local total = math.max(data.Sand, 0) * Config.SELL_RATE
	for treasureId, count in data.Treasures do
		local def = Config.GetTreasure(treasureId)
		if def and count > 0 then
			total += def.SellValue * count
		end
	end
	total += Finds.TotalValue(data.Finds, data.MaxDepth)
	return math.floor(total * Stats.GetCoinMultiplier(ctx))
end

return Stats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">TableUtil</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TableUtil — pure table helpers used by persistence.
]]

local TableUtil = {}

function TableUtil.DeepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value :: any do
		copy[TableUtil.DeepCopy(k)] = TableUtil.DeepCopy(v)
	end
	return (copy :: any) :: T
end

--[[
	Fill every key that exists in `template` but is missing (or has the wrong type) in `target`,
	recursing into nested tables. Keys that only exist in `target` are kept. Mutates and
	returns `target`. NaN / infinite numbers are treated as corrupt and replaced.
]]
function TableUtil.Reconcile(target: { [any]: any }, template: { [any]: any }): { [any]: any }
	for key, default in template do
		local current = target[key]
		if current == nil or type(current) ~= type(default) then
			target[key] = TableUtil.DeepCopy(default)
		elseif type(current) == "number" and (current ~= current or math.abs(current) == math.huge) then
			target[key] = default
		elseif type(default) == "table" then
			TableUtil.Reconcile(current, default)
		end
	end
	return target
end

function TableUtil.Count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

return TableUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Week</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Week — ISO-8601 week numbers (UTC) for weekly leaderboards. Weeks start on Monday; week 1 is
	the week holding the year's first Thursday, so 29 Dec .. 3 Jan can belong to either year.

		Week.Iso(unix): (isoYear, isoWeek)
		Week.Key(unix): "W2026_41"   (week zero-padded; used in OrderedDataStore names)
		Week.SecondsLeft(unix): seconds until the next Monday 00:00 UTC
]]

local Week = {}

local DAY = 86400

function Week.Iso(unix: number): (number, number)
	local days = math.floor(unix / DAY)
	local weekday = (days + 3) % 7 + 1 -- 1970-01-01 was a Thursday; Monday = 1 .. Sunday = 7
	local thursday = days - weekday + 4 -- the Thursday of this ISO week decides the year
	local t = os.date("!*t", thursday * DAY) :: any
	local year: number = t.year
	local yday: number = t.yday
	return year, math.floor((yday - 1) / 7) + 1
end

function Week.Key(unix: number): string
	local year, week = Week.Iso(unix)
	return string.format("W%d_%02d", year, week)
end

function Week.SecondsLeft(unix: number): number
	local days = math.floor(unix / DAY)
	local weekday = (days + 3) % 7 + 1
	return (days - weekday + 8) * DAY - unix
end

return Week
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Weighted</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Weighted — pure weighted random selection (loot tables, eggs).
	`roll` is a number in [0, 1) supplied by the caller (Random:NextNumber()), which keeps this
	module deterministic and unit-testable. Entries with a non-positive or non-finite weight are
	skipped. Returns nil when no entry has weight.
]]

local Weighted = {}

local function validWeight(w: number): boolean
	return w == w and w > 0 and w ~= math.huge
end

function Weighted.Total<T>(entries: { T }, weightOf: (T) -> number): number
	local total = 0
	for _, entry in entries do
		local w = weightOf(entry)
		if validWeight(w) then
			total += w
		end
	end
	return total
end

function Weighted.Pick<T>(entries: { T }, weightOf: (T) -> number, roll: number): T?
	local total = Weighted.Total(entries, weightOf)
	if total <= 0 then
		return nil
	end
	local target = math.clamp(roll, 0, 1) * total
	local last: T? = nil
	for _, entry in entries do
		local w = weightOf(entry)
		if validWeight(w) then
			last = entry
			if target < w then
				return entry
			end
			target -= w
		end
	end
	-- Floating point slack (roll ~= 1): return the last valid entry.
	return last
end

-- Probability (0..1) of each entry, in input order (UI odds display).
function Weighted.Odds<T>(entries: { T }, weightOf: (T) -> number): { number }
	local total = Weighted.Total(entries, weightOf)
	local odds = {}
	for i, entry in entries do
		local w = weightOf(entry)
		odds[i] = if total > 0 and validWeight(w) then w / total else 0
	end
	return odds
end

return Weighted
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="55">
