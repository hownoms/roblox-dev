local HUD = {}

HUD.Buttons = {} :: { [string]: Button.Button }
HUD.Coins = nil :: IconLabel.IconLabel?
HUD.ActionsRow = nil :: Frame? -- v3 discovery: the bottom Surface/Sell/Auto row (UI/DetectorHUD adds Scan)

local C = Style.Colors
local backpackPulse: Tween? = nil
local backpackHighlight = false
local sellArrowTween: Tween? = nil
local flashTweens: { [string]: Tween } = {}
local refreshBackpackMotion: () -> () = function() end

-- Progressive menu disclosure state (see the "Menu gating" section below).
local gateVisible: { [string]: boolean } = {}
local refreshMenu: () -> () = function() end

-- Is a gated HUD button (menu entry or Daily) currently shown? Ungated buttons: true.
function HUD.IsUnlocked(name: string): boolean
	if MenuGate.MESSAGES[name] == nil then
		return true
	end
	return gateVisible[name] == true
end

-- Re-evaluate the menu unlock rules right now (also runs on every relevant data change).
function HUD.RefreshMenu()
	refreshMenu()
end

-- Briefly pulse a HUD button to draw attention (e.g. Shop after "Too hard!"). Never points at
-- a hidden (still locked) button.
function HUD.Flash(name: string, seconds: number?)
	if State.GetSetting("ReducedMotion", false) == true then
		return
	end
	local button = HUD.Buttons[name]
	if not button or flashTweens[name] then
		return
	end
	if not HUD.IsUnlocked(name) then
		refreshMenu() -- e.g. the tutorial just reached the step that unlocks it
		if not HUD.IsUnlocked(name) then
			return
		end
	end
	local tween = Style.Pulse(button.Holder, 0.14, 0.5)
	flashTweens[name] = tween
	task.delay(seconds or 3, function()
		if flashTweens[name] == tween then
			Style.StopPulse(button.Holder, tween)
			flashTweens[name] = nil
		end
	end)
end

-- Tutorial: make the backpack bar pulse even before it's full.
function HUD.SetBackpackHighlight(on: boolean)
	backpackHighlight = on
	refreshBackpackMotion()
end

local ROUND = Vector2.new(64, 70) -- round button holder (64 px face + lip)

local function buildTopRight(canvas: Frame)
	local cluster = Instance.new("Frame")
	cluster.Name = "TopRight"
	cluster.BackgroundTransparency = 1
	cluster.Size = Layout.SizeOf(Layout.Current().TopRight)
	cluster.Parent = canvas
	Layout.Observe(function(regions: Layout.Regions)
		cluster.Position = Layout.Position(regions.TopRight)
		cluster.Size = Layout.SizeOf(regions.TopRight)
	end)

	local coins = IconLabel.new({
		Name = "Coins",
		Icon = "Coins",
		Color = C.Gold,
		TextColor = C.Money,
		Size = UDim2.fromOffset(214, 50),
		Position = UDim2.fromOffset(20, 4),
		MaxTextSize = 34,
		Parent = cluster,
	})
	HUD.Coins = coins
	local tokens = IconLabel.new({
		Name = "Tokens",
		Icon = "Tokens",
		Color = C.Tokens,
		TextColor = C.Tokens,
		Size = UDim2.fromOffset(150, 38),
		Position = UDim2.fromOffset(20, 60),
		MaxTextSize = 26,
		Parent = cluster,
	})
	local rebirth = IconLabel.new({
		Name = "Multiplier",
		Icon = "Rebirth",
		Color = C.Purple,
		TextColor = C.Time,
		Size = UDim2.fromOffset(192, 38),
		Position = UDim2.fromOffset(196, 60),
		MaxTextSize = 22,
		Parent = cluster,
	})

	for i, item in { { Name = "Daily", Color = C.Gold }, { Name = "Settings", Color = C.OceanDark } } do
		HUD.Buttons[item.Name] = Button.new({
			Name = item.Name,
			Icon = item.Name,
			Vertical = true,
			Round = true,
			HitPadding = 8,
			Color = item.Color,
			Size = UDim2.fromOffset(ROUND.X, ROUND.Y),
			Position = UDim2.fromOffset(244 + (i - 1) * (ROUND.X + 16), 0),
			Parent = cluster,
			OnClick = function()
				Panel.Toggle(item.Name)
			end,
		})
	end

	local lastCoins: number? = nil
	State.Observe("Coins", function(value: any)
		if typeof(value) ~= "number" then
			return
		end
		coins:SetValue(value)
		if lastCoins and State.Loaded and value > lastCoins then
			UIEffects.FloatFrom(coins.Frame, "+" .. Format.Abbreviate(value - lastCoins), C.Money)
		end
		lastCoins = value
	end)
	State.Observe("RebirthTokens", function(value: any)
		if typeof(value) == "number" then
			tokens:SetValue(value)
		end
	end)
	State.ObserveMany({ "Rebirths", "Pets", "Passes" }, function()
		local mult = Config.RebirthMultiplier(State.Data.Rebirths)
		rebirth:SetText(
			"x" .. string.format("%.1f", mult) .. "  pets x" .. string.format("%.2f", State.GetPetMultiplier())
		)
	end)
end

local MENU = {
	{ Name = "Shop", Icon = "Shop", Color = C.Palm, Panel = "Shop" },
	{ Name = "Beach", Icon = "Beach", Color = C.Sunset, Panel = "BeachShop" }, -- Survival's panel
	{ Name = "Eggs", Icon = "Eggs", Color = C.Gold, Panel = "Eggs" },
	{ Name = "Pets", Icon = "Pets", Color = C.Coral, Panel = "Pets" },
	{ Name = "Index", Icon = "Index", Color = C.Ocean, Panel = "Index" },
	{ Name = "Quests", Icon = "Quests", Color = Color3.fromRGB(255, 120, 70), Panel = "Quests" },
	{ Name = "Rebirth", Icon = "Rebirth", Color = C.Purple, Panel = "Rebirth" },
	{ Name = "Store", Icon = "Store", Color = Color3.fromRGB(240, 85, 200), Panel = "Store" },
}

-- Cheapest affordable shovel/backpack upgrade exists (Shop "!" badge).
local function canAffordUpgrade(): boolean
	local data = State.Data
	for _, kind in { "Shovels", "Backpacks" } do
		local id = ShopPanel.NextUpgrade(kind)
		local def: any = if id
			then (if kind == "Shovels" then Config.GetShovel(id) else Config.GetBackpack(id))
			else nil
		if def and data.Coins >= def.Price then
			return true
		end
	end
	return false
end

local function buildMenu(canvas: Frame)
	local grid = Instance.new("Frame")
	grid.Name = "Menu"
	grid.BackgroundTransparency = 1
	grid.Parent = canvas
	Layout.Observe(function(regions: Layout.Regions)
		grid.Position = Layout.Position(regions.Menu)
		grid.Size = Layout.SizeOf(regions.Menu)
	end)
	-- Cells are placed by the menu gating (2 columns, visible buttons only, no gaps), not by a
	-- UIGridLayout, so the re-flow is deterministic and can slide.
	for i, item in MENU do
		HUD.Buttons[item.Name] = Button.new({
			Name = item.Name,
			Icon = item.Icon,
			Text = item.Name,
			Vertical = true,
			Color = item.Color,
			Size = UDim2.fromOffset(Layout.MENU_CELL, Layout.MENU_CELL),
			LayoutOrder = i,
			MaxTextSize = 20,
			Corner = UDim.new(0, 12),
			Parent = grid,
			OnClick = function()
				Panel.Toggle(item.Panel)
			end,
		})
	end

	-- badges
	local function refreshBadges()
		local data = State.Data
		local quests = Progress.ClaimableQuests(data)
		HUD.Buttons.Quests:SetBadge(if quests > 0 then tostring(quests) else nil)
		HUD.Buttons.Daily:SetBadge(if Progress.Daily(data).CanClaim and State.Loaded then "!" else nil)
		HUD.Buttons.Rebirth:SetBadge(
			if Progress.CanRebirth(data) or Progress.CanBuyRebirthPerk(data) then "!" else nil -- v2.2 perks
		)
		HUD.Buttons.Shop:SetBadge(if State.Loaded and canAffordUpgrade() then "!" else nil)
	end
	State.ObserveMany({
		"Quests",
		"Coins",
		"Rebirths",
		"DailyStreak",
		"LastDailyClaim",
		"MaxDepth",
		"OwnedShovels",
		"OwnedBackpacks",
		"Shovel",
		"Backpack",
		"RebirthTokens", -- v2.2 perk badge
		"RebirthPerks",
	}, refreshBadges)
	State.LoadedSignal:Connect(refreshBadges)
	task.spawn(function()
		while true do
			task.wait(5)
			refreshBadges()
		end
	end)
end

local function buildTimers(canvas: Frame)
	local row = Instance.new("Frame")
	row.Name = "Timers"
	row.BackgroundTransparency = 1
	row.Parent = canvas
	Layout.Observe(function(regions: Layout.Regions)
		row.Position = Layout.Position(regions.Timers)
		row.Size = Layout.SizeOf(regions.Timers)
	end)
	Style.List(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)

	type Chip = { Frame: Frame, Label: TextLabel, Icon: AtlasIcon.AtlasIcon }
	local chips: { [string]: Chip } = {}

	-- Small dark pill: coloured icon + "Name 4:21" (time in sky blue).
	local function chip(key: string, icon: string, color: Color3, order: number, dim: boolean): TextLabel
		local existing = chips[key]
		if existing then
			existing.Frame.LayoutOrder = order
			existing.Frame.BackgroundTransparency = if dim then 0.4 else 0.08
			return existing.Label
		end
		local frame = Instance.new("Frame")
		frame.Name = key
		frame.Size = UDim2.fromOffset(186, 34)
		frame.LayoutOrder = order
		frame.Parent = row
		Style.Pill(frame, if dim then 0.4 else 0.08)
		local ring = frame:FindFirstChildOfClass("UIStroke")
		if ring then
			ring.Color = Style.Darken(color, 0.2)
		end
		local glyph = AtlasIcon.new({
			Icon = icon,
			Size = UDim2.fromOffset(40, 40),
			Position = UDim2.new(0, -6, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			ZIndex = 3,
			Parent = frame,
		})
		local label = Style.Label({
			Size = UDim2.new(1, -46, 0.78, 0),
			Position = UDim2.new(0, 38, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			MaxTextSize = 18,
			RichText = true,
			XAlign = Enum.TextXAlignment.Left,
			ZIndex = 2,
			Parent = frame,
		})
		chips[key] = { Frame = frame, Label = label, Icon = glyph }
		Style.PopIn(frame)
		return label
	end
	local timeHex = "#" .. C.Time:ToHex()
	local function timed(name: string, seconds: number): string
		return name .. ' <font color="' .. timeHex .. '">' .. Format.Time(seconds) .. "</font>"
	end

	local function update()
		local seen: { [string]: boolean } = {}
		local order = 0
		for _, boost in Config.Boosts do
			local remaining = State.GetBoostRemaining(boost.Id)
			if remaining > 0 then
				order += 1
				local key = "Boost_" .. boost.Id
				seen[key] = true
				chip(key, "BoostKinds." .. boost.Kind, boost.Color, order, false).Text = timed(boost.Name, remaining)
			end
		end
		local now = Progress.Now()
		local anyActive = false
		for _, event in Config.Events do
			local active = State.IsEventActive(event.Id)
				or (#State.ActiveEvents == 0 and Config.GetSecondsUntilEvent(event.Id, now) == 0)
			if active then
				anyActive = true
				order += 1
				local key = "Event_" .. event.Id
				seen[key] = true
				local phase = (now + event.OffsetSeconds) % event.IntervalSeconds
				local left = if phase < event.DurationSeconds then event.DurationSeconds - phase else 0
				-- v2.2: started early on this server (server dig goal) -> its real end time
				local forcedEnd = workspace:GetAttribute("EventEnds_" .. event.Id)
				if typeof(forcedEnd) == "number" then
					left = math.max(left, forcedEnd - now)
				end
				left = math.max(0, left)
				chip(key, "Events." .. event.Id, event.Color, order, false).Text = timed(event.Name .. "!", left)
			end
		end
		if not anyActive then
			-- anticipation: show the next upcoming event
			local soonest: string? = nil
			local soonestIn = math.huge
			for _, event in Config.Events do
				local wait = Config.GetSecondsUntilEvent(event.Id, now)
				if wait < soonestIn then
					soonestIn = wait
					soonest = event.Id
				end
			end
			if soonest then
				local event = Config.GetEvent(soonest)
				if event then
					order += 1
					local key = "Next_" .. event.Id
					seen[key] = true
					chip(key, "Events." .. event.Id, event.Color, order, true).Text =
						timed(event.Name .. " in", soonestIn)
				end
			end
		end
		for key, entry in chips do
			if not seen[key] then
				entry.Frame:Destroy()
				chips[key] = nil
			end
		end
	end

	State.ObserveMany({ "Boosts", "ActiveEvents" }, update)
	task.spawn(function()
		while true do
			task.wait(1)
			update()
		end
	end)
end

local function buildDepthMeter(canvas: Frame)
	local holder = Instance.new("Frame")
	holder.Name = "Depth"
	holder.BackgroundTransparency = 1
	holder.Parent = canvas
	Layout.Observe(function(regions: Layout.Regions)
		holder.Position = Layout.Position(regions.Depth)
		holder.Size = Layout.SizeOf(regions.Depth)
	end)

	local card = Instance.new("Frame")
	card.Name = "Card"
	card.Size = UDim2.new(1, 0, 0, 70)
	card.BackgroundTransparency = 0.08
	card.Parent = holder
	Style.Corner(card, Style.Theme.CornerMedium)
	local cardStroke = Style.Stroke(card, C.Stroke, 3)
	Style.NavyBody(card)

	AtlasIcon.new({
		Name = "DepthIcon",
		Icon = "Depth",
		Size = UDim2.fromOffset(48, 48),
		Position = UDim2.fromOffset(-8, -6),
		AnchorPoint = Vector2.zero,
		Rotation = -8,
		ZIndex = 3,
		Parent = card,
	})
	local depthLabel = Style.Label({
		Name = "Depth",
		Text = "0m",
		Size = UDim2.new(1, -52, 0, 36),
		Position = UDim2.fromOffset(44, 3),
		Font = Style.Fonts.Title,
		MaxTextSize = 34,
		StrokeThickness = 3,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = card,
	})
	local layerIcon = AtlasIcon.new({
		Name = "LayerIcon",
		Icon = "Layers." .. Config.Layers[1].Id,
		Size = UDim2.fromOffset(26, 26),
		Position = UDim2.fromOffset(8, 41),
		AnchorPoint = Vector2.zero,
		ZIndex = 3,
		Parent = card,
	})
	local layerLabel = Style.Label({
		Name = "Layer",
		Text = Config.Layers[1].Name,
		Size = UDim2.new(1, -46, 0, 24),
		Position = UDim2.fromOffset(38, 42),
		MaxTextSize = 21,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = card,
	})

	local bar = ProgressBar.new({
		Name = "LayerProgress",
		Size = UDim2.new(1, -8, 0, 14),
		Position = UDim2.new(0.5, 0, 0, 76),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = Config.Layers[1].Color,
		Parent = holder,
	})
	bar.Label.Visible = false
	local nextLabel = Style.Label({
		Name = "Next",
		Text = "",
		Size = UDim2.new(1, -4, 0, 26),
		Position = UDim2.new(1, -2, 0, 92),
		AnchorPoint = Vector2.new(1, 0),
		MaxTextSize = 13,
		MinTextSize = 9,
		Font = Style.Fonts.Body,
		Wrapped = true,
		RichText = true,
		XAlign = Enum.TextXAlignment.Right,
		YAlign = Enum.TextYAlignment.Top,
		Parent = holder,
	})

	local record = "0m"
	local nextText = ""
	local function setInfo()
		nextLabel.Text = '<font color="#' .. C.Gold:ToHex() .. '">Best ' .. record .. "</font>  ·  " .. nextText
	end
	local lastLayer = 0
	local function update(depth: number, index: number)
		local layer = Config.Layers[index]
		depthLabel.Text = Format.Depth(Config.DepthToMeters(depth))
		if index ~= lastLayer then
			lastLayer = index
			layerIcon:Set("Layers." .. layer.Id)
			layerLabel.Text = layer.Name
			layerLabel.TextColor3 = Color3.new(1, 1, 1):Lerp(layer.Color, 0.55)
			cardStroke.Color = Style.Darken(layer.Color, 0.5)
			bar:SetColor(layer.Color)
			Style.Pop(card, 0.12)
			local nextLayer = Config.Layers[index + 1]
			if nextLayer then
				local canDig = State.GetShovel().Power >= nextLayer.Hardness
				nextText = "Next: "
					.. nextLayer.Name
					.. " @ "
					.. Format.Depth(nextLayer.DepthStart)
					.. (
						if canDig
							then ""
							else '<font color="#'
								.. C.Coral:ToHex()
								.. '"> (needs Power '
								.. nextLayer.Hardness
								.. ")</font>"
					)
			else
				nextText = "The CORE!"
			end
			setInfo()
		end
		local span = layer.DepthEnd - layer.DepthStart
		bar:Set((depth - layer.DepthStart) / span)
	end
	LayerController.DepthChanged:Connect(update)
	State.Changed("Shovel"):Connect(function()
		lastLayer = 0
		update(LayerController.Depth, LayerController.LayerIndex)
	end)
	update(0, 1)
	State.Observe("MaxDepth", function(value: any)
		if typeof(value) == "number" then
			record = Format.Depth(Config.DepthToMeters(value))
			setInfo()
		end
	end)
end

local function buildBottom(canvas: Frame)
	local holder = Instance.new("Frame")
	holder.Name = "Bottom"
	holder.BackgroundTransparency = 1
	holder.Parent = canvas
	Layout.Observe(function(regions: Layout.Regions)
		holder.Position = Layout.Position(regions.Bottom)
		holder.Size = Layout.SizeOf(regions.Bottom)
	end)

	local bar = ProgressBar.new({
		Name = "Backpack",
		Size = UDim2.fromOffset(400, 44),
		Position = UDim2.new(0.5, 0, 1, 0),
		AnchorPoint = Vector2.new(0.5, 1),
		Color = C.Sand,
		Text = "0 / 20",
		MaxTextSize = 26,
		Parent = holder,
	})
	bar.Label.Size = UDim2.new(1, -60, 0.8, 0)
	bar.Label.Position = UDim2.new(0.5, 18, 0.5, 0)
	AtlasIcon.new({
		Name = "BackpackIcon",
		Icon = "Backpack",
		Size = UDim2.fromOffset(60, 60),
		Position = UDim2.new(0, -16, 0.5, -4),
		AnchorPoint = Vector2.new(0, 0.5),
		Rotation = -8,
		ZIndex = 4,
		Parent = bar.Frame,
	})

	local arrow = Style.Label({
		Name = "SellArrow",
		Text = "FULL! GO SELL!",
		Size = UDim2.fromOffset(260, 36),
		Position = UDim2.new(0.5, 0, 1, -52),
		AnchorPoint = Vector2.new(0.5, 1),
		TextColor = C.Coral,
		StrokeThickness = 3,
		MaxTextSize = 30,
		Parent = holder,
	})
	arrow.Visible = false
	refreshBackpackMotion = function()
		local full = State.Data.Sand >= State.GetCapacity()
		local animate = State.GetSetting("ReducedMotion", false) ~= true
		if animate and (full or backpackHighlight) then
			if not backpackPulse then
				backpackPulse = Style.Pulse(bar.Frame, 0.07, 0.6)
			end
		elseif backpackPulse then
			Style.StopPulse(bar.Frame, backpackPulse)
			backpackPulse = nil
		end
		if animate and full then
			if not sellArrowTween then
				sellArrowTween = Style.Tween(
					arrow,
					0.35,
					{ Position = UDim2.new(0.5, 0, 1, -62) },
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					-1,
					true
				)
			end
		else
			if sellArrowTween then
				sellArrowTween:Cancel()
				sellArrowTween = nil
			end
			arrow.Position = UDim2.new(0.5, 0, 1, -52)
		end
	end
	State.Changed("Settings"):Connect(function()
		refreshBackpackMotion()
		if State.GetSetting("ReducedMotion", false) == true then
			for name, tween in flashTweens do
				Style.StopPulse(HUD.Buttons[name].Holder, tween)
				flashTweens[name] = nil
			end
		end
	end)

	local row = Instance.new("Frame")
	row.Name = "Actions"
	row.BackgroundTransparency = 1
	row.AnchorPoint = Vector2.new(0.5, 1)
	row.Position = UDim2.new(0.5, 0, 1, -92)
	row.Size = UDim2.fromOffset(400, 80)
	row.Parent = holder
	Style.List(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)
	HUD.ActionsRow = row -- v3 discovery: UI/DetectorHUD adds the Scan button here (LayoutOrder 0)

	HUD.Buttons.Surface = Button.new({
		Name = "Surface",
		Icon = "Surface",
		Text = "Surface",
		Vertical = true,
		Color = C.Ocean,
		Size = UDim2.fromOffset(80, 80),
		MaxTextSize = 18,
		LayoutOrder = 1,
		Parent = row,
		OnClick = function()
			SoundController.Play("Teleport")
			Remotes.Get("ReturnToSurface"):FireServer()
		end,
	})

	local sell = Button.new({
		Name = "Sell",
		Icon = "Sell",
		Text = "Sell",
		Vertical = true,
		Color = C.Success,
		Size = UDim2.fromOffset(80, 80),
		MaxTextSize = 18,
		LayoutOrder = 2,
		Parent = row,
		OnClick = function()
			if State.CanSellAnywhere() then
				State.SetSetting("SellNow", true)
			elseif not PurchaseController.PromptPass("SellAnywhere") then
				SoundController.Play("Error")
			end
		end,
	})
	HUD.Buttons.Sell = sell

	local auto = Button.new({
		Name = "AutoDig",
		Icon = "AutoDig",
		Text = "Auto",
		Vertical = true,
		Color = C.Disabled,
		Size = UDim2.fromOffset(80, 80),
		MaxTextSize = 18,
		LayoutOrder = 3,
		Parent = row,
		OnClick = function()
			if State.OwnsPass("AutoDig") then
				State.SetSetting("AutoDig", not (State.GetSetting("AutoDig", false) == true))
			else
				PurchaseController.PromptPass("AutoDig")
			end
		end,
	})
	HUD.Buttons.AutoDig = auto

	State.ObserveMany({ "Passes", "Settings", "RebirthPerks" }, function()
		local ownsSell = State.CanSellAnywhere() -- v2.2: pass or rebirth perk
		sell:SetVisible(ownsSell or PurchaseController.IsPassConfigured("SellAnywhere"))
		sell:SetText(if ownsSell then "Sell" else "Sell R$")
		local ownsAuto = State.OwnsPass("AutoDig")
		auto:SetVisible(ownsAuto or PurchaseController.IsPassConfigured("AutoDig"))
		local on = ownsAuto and State.GetSetting("AutoDig", false) == true
		auto:SetColor(if on then C.Success elseif ownsAuto then C.OceanDark else C.Disabled)
		auto:SetText(if on then "Auto ON" elseif ownsAuto then "Auto OFF" else "Auto R$")
	end)

	local wasFull = false
	local function update()
		local sand = State.Data.Sand or 0
		local capacity = math.max(State.GetCapacity(), 1)
		local full = sand >= capacity
		bar:Set(sand / capacity, Format.Abbreviate(sand) .. " / " .. Format.Abbreviate(capacity))
		bar:SetColor(if full then C.Danger elseif sand / capacity > 0.8 then C.Warning else C.Sand)
		if full ~= wasFull then
			wasFull = full
			arrow.Visible = full
			if full then
				SoundController.Play("DigBlocked", 1.4)
				if State.CanSellAnywhere() then
					HUD.Flash("Sell", 4)
				end
			end
		end
		refreshBackpackMotion()
	end
	State.ObserveMany({ "Sand", "Backpack", "Rebirths", "Passes" }, update)
end

-- Menu gating: progressive disclosure (UI/MenuGate, docs/design/Onboarding.md) -------------------

local newTags: { [string]: TextLabel } = {}
local newTagTweens: { [string]: Tween } = {}

local function refreshNewTagMotion()
	for name, tag in newTags do
		local tween = newTagTweens[name]
		if State.GetSetting("ReducedMotion", false) == true then
			if tween then
				Style.StopPulse(tag, tween)
				newTagTweens[name] = nil
			end
		elseif not tween then
			newTagTweens[name] = Style.Pulse(tag, 0.1, 0.9)
		end
	end
end

State.Changed("Settings"):Connect(refreshNewTagMotion)

-- Gold "NEW!" tag on the top-left corner until the button's panel is first opened.
local function setNewTag(name: string, on: boolean)
	local button = HUD.Buttons[name]
	local tag = newTags[name]
	if not button then
		return
	end
	if on and not tag then
		local label = Style.Label({
			Name = "NewTag",
			Text = "NEW!",
			Size = UDim2.fromOffset(50, 22),
			Position = UDim2.fromOffset(-8, -8),
			AnchorPoint = Vector2.zero,
			MaxTextSize = 16,
			StrokeThickness = 2,
			ZIndex = 8,
			Parent = button.Holder,
		})
		label.BackgroundTransparency = 0
		label.BackgroundColor3 = C.Gold
		label.Rotation = -8
		Style.Corner(label, Style.Theme.CornerPill)
		local ring = Instance.new("UIStroke")
		ring.Color = C.Stroke
		ring.Thickness = 2.5
		ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		ring.Parent = label
		newTags[name] = label
		refreshNewTagMotion()
	elseif not on and tag then
		if newTagTweens[name] then
			newTagTweens[name]:Cancel()
			newTagTweens[name] = nil
		end
		tag:Destroy()
		newTags[name] = nil
	end
end

-- Visible menu buttons fill the 2 columns in MENU order without gaps.
local function reflow(previous: { [string]: boolean }, animate: boolean)
	local k = 0
	for _, name in MenuGate.MENU do
		local button = HUD.Buttons[name]
		if button then
			local show = gateVisible[name] == true
			button.Holder.Visible = show
			if show then
				k += 1
				local cell = MenuGate.CellPosition(
					k,
					Layout.MENU_CELL,
					Layout.MENU_GAP_X,
					Layout.MENU_GAP_Y,
					Layout.MENU_COLUMNS
				)
				local target = UDim2.fromOffset(cell.X, cell.Y)
				if animate and previous[name] and button.Holder.Position ~= target then
					Style.Tween(button.Holder, 0.25, { Position = target }, Enum.EasingStyle.Back)
				else
					button.Holder.Position = target
				end
			end
		end
	end
	local daily = HUD.Buttons.Daily
	if daily then
		daily.Holder.Visible = gateVisible.Daily == true
	end
end

local function buildMenuGating()
	local evaluated = false
	local heatUnlockAt = MenuGate.BEACH_HEAT
	local localPlayer = Players.LocalPlayer

	refreshMenu = function()
		if not State.Loaded then
			reflow({}, false) -- before the data arrives every gated button stays hidden
			return
		end
		local data = State.Data
		local heat = localPlayer:GetAttribute("Heat")
		local visible = MenuGate.Evaluate({ Data = data, Heat = if type(heat) == "number" then heat else 0 })
		local settings: { [string]: any } = data.Settings or {}
		local persisted = MenuGate.ParseList(settings[MenuGate.UNLOCK_KEY])
		local seen = MenuGate.ParseList(settings[MenuGate.SEEN_KEY])
		local first = not evaluated
		evaluated = true

		if first and MenuGate.IsReturning(data) and settings[MenuGate.SEEN_KEY] == nil then
			-- returning players: everything is already familiar, nothing is "NEW"
			for _, name in MenuGate.ALL do
				seen[name] = true
			end
			State.SetSetting(MenuGate.SEEN_KEY, MenuGate.FormatList(seen))
		end

		local fresh: { string } = {}
		local changed = false
		for _, name in MenuGate.ALL do
			if visible[name] and not gateVisible[name] then
				table.insert(fresh, name)
			end
			if visible[name] and not persisted[name] then
				persisted[name] = true
				changed = true
			end
		end
		if changed and not MenuGate.IsReturning(data) then
			State.SetSetting(MenuGate.UNLOCK_KEY, MenuGate.FormatList(persisted))
		end

		local previous = gateVisible
		gateVisible = visible
		reflow(previous, not first)
		for _, name in MenuGate.ALL do
			setNewTag(name, visible[name] == true and not seen[name])
		end
		if first or #fresh == 0 then
			return -- unlocks found at load (earned last session) appear quietly
		end
		for _, name in fresh do
			local button = HUD.Buttons[name]
			if button then
				Style.PopIn(button.Holder, 0.45)
			end
			Track.Send("menu_unlocked", name)
		end
		SoundController.Play("Purchase", 1.25)
		if #fresh == 1 then
			Toasts.Show(MenuGate.MESSAGES[fresh[1]], "Success", 4)
		else
			Toasts.Show("New menus unlocked! Look for NEW", "Success", 4)
		end
	end

	-- Opening a panel (from the HUD, a world prompt or the tutorial) clears its NEW tag.
	Panel.Changed:Connect(function(panelName: string?)
		if not panelName then
			return
		end
		Track.Send("panel_opened", panelName)
		local name = MenuGate.PANEL_TO_BUTTON[panelName]
		if not name or not State.Loaded then
			return
		end
		local seen = MenuGate.ParseList(State.GetSetting(MenuGate.SEEN_KEY, nil))
		if not seen[name] then
			seen[name] = true
			State.SetSetting(MenuGate.SEEN_KEY, MenuGate.FormatList(seen))
		end
		setNewTag(name, false)
	end)

	State.ObserveMany({
		"Coins",
		"Rebirths",
		"Pets",
		"Index",
		"OwnedShovels",
		"OwnedShades",
		"Quests",
		"PlayTime",
		"LastDailyClaim",
		"Settings",
	}, refreshMenu)
	State.LoadedSignal:Connect(refreshMenu)
	-- "Getting hot" is transient: unlock the Beach shop the moment heat crosses the line.
	localPlayer:GetAttributeChangedSignal("Heat"):Connect(function()
		local heat = localPlayer:GetAttribute("Heat")
		if type(heat) == "number" and heat >= heatUnlockAt and not gateVisible.Beach then
			refreshMenu()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			refreshMenu()
		end
	end)
end

-- First visible menu button (gamepad ButtonY focus target), nil if none is unlocked yet.
function HUD.FirstMenuButton(): Button.Button?
	for _, name in MenuGate.MENU do
		local button = HUD.Buttons[name]
		if button and gateVisible[name] then
			return button
		end
	end
	return nil
end

function HUD.Init()
	local canvas = Root.Get("HUD")
	buildTopRight(canvas)
	buildMenu(canvas)
	buildTimers(canvas)
	buildDepthMeter(canvas)
	buildBottom(canvas)
	buildMenuGating()
	-- A confirmed sale also covers treasure-only sales. Sand resets (e.g. rebirth) are silent.
	task.spawn(function()
		Remotes.Get("Notify").OnClientEvent:Connect(function(kind: any, text: any)
			if kind ~= "Sell" or typeof(text) ~= "string" then
				return
			end
			SoundController.Play("Sell")
			local coins = HUD.Coins
			if coins then
				UIEffects.FlyTo(Icons.Coins, coins.Badge, 10, nil, function()
					SoundController.Play("Coin")
				end)
			end
		end)
	end)

	DigController.Feedback:Connect(function(reason: string)
		if reason == "TooHard" then
			HUD.Flash("Shop", 4)
		end
	end)
	-- hide the menu clutter while a panel is open on small screens
	Panel.Changed:Connect(function(name: string?)
		local menu = canvas:FindFirstChild("Menu")
		if menu and menu:IsA("GuiObject") then
			menu.Visible = name == nil or Root.GetDesignSize().X > 1160 -- 820-wide panels clear the menu
		end
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">HatchAnimation</string>
              <string name="Source"><![CDATA[--!strict
--[[
	HatchAnimation — EggHatched({petIds}): dim overlay, 1-3 eggs side by side wobble harder and
	harder (EggShake sounds), flash, eggs pop — then the shared Reveal popup (UI/Reveal: huge
	outlined rarity word, card per pet with its spinning model and RARITY / SAND BONUS / DIGS /
	RIDEABLE rows, sparkles, tap to close). Legendary/Mythic add confetti + a big flash. Tap
	skips the wobble; hatches are queued.
	v2.1: Construction Crates (EggDef.Kind == "Crate") don't crack: their lid (sub-Model "Lid" of
	Models.Egg) pops off and flips away before the vehicle springs out. Digging pets show a ⛏ line.
	v2.2: EggHatched's optional second argument { EggId, Chances, Pity } adds a CHANCE row to each
	card: the true chance (luck and pity included) that pet had on the server's roll, e.g. "0.5%"
	or "100% (pity)". EggId picks the right shell even for hatches the panel didn't start.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Root = require(script.Parent.Root)
local Style = require(script.Parent.Components.Style)
local Viewport = require(script.Parent.Components.Viewport)
local Reveal = require(script.Parent.Reveal)
local ItemStats = require(script.Parent.ItemStats)
local UIEffects = require(script.Parent.UIEffects)
local State = require(script.Parent.Parent.Controllers.State)
local SoundController = require(script.Parent.Parent.Controllers.SoundController)
local ModelFactory = require(script.Parent.Parent.Util.ModelFactory)
local Signal = require(script.Parent.Parent.Util.Signal)

local HatchAnimation = {}

HatchAnimation.Finished = Signal.new() -- (petIds)
HatchAnimation.Hatched = Signal.new() -- (petIds) fired as soon as results arrive

local C = Style.Colors
local pendingEgg: string? = nil
export type HatchInfo = { EggId: string?, Chances: { number }?, Pity: { boolean }? }
type Batch = { Ids: { string }, Info: HatchInfo? }
local queue: { Batch } = {}
local playing = false

-- The egg panel tells us which egg was just requested so we show the right shell.
function HatchAnimation.SetPendingEgg(eggId: string)
	pendingEgg = eggId
end

local function eggFor(petId: string): string
	if pendingEgg then
		return pendingEgg :: string
	end
	for _, egg in Config.Eggs do
		for _, entry in egg.Pets do
			if entry.PetId == petId then
				return egg.Id
			end
		end
	end
	return Config.Eggs[1].Id
end

local function resolvePetId(value: any): string?
	if typeof(value) ~= "string" then
		return nil
	end
	if Config.GetPet(value) then
		return value
	end
	-- tolerate the server sending pet uids instead of ids
	local instance = State.Data.Pets and State.Data.Pets[value]
	if instance then
		return instance.Id
	end
	return nil
end

-- Crate reveal: the lid flies up and tumbles off (runs in its own thread).
local function popLid(view: Viewport.Viewport)
	local model = view.Model
	local lid = if model then model:FindFirstChild("Lid") else nil
	if not lid or not lid:IsA("Model") then
		return
	end
	local lidModel = lid :: Model
	local start = lidModel:GetPivot()
	task.spawn(function()
		local t0 = os.clock()
		while lidModel.Parent do
			local t = math.min((os.clock() - t0) / 0.45, 1)
			local up = 3.2 * t - 1.2 * t * t
			lidModel:PivotTo(start * CFrame.new(0.8 * t, up, 0) * CFrame.Angles(0, 0, -1.6 * t))
			if t >= 1 then
				break
			end
			task.wait(1 / 30)
		end
	end)
end

-- Reveal card for one hatched pet (chance = the true probability the server rolled it with).
local function revealItem(petId: string, chance: number?, pity: boolean?): Reveal.Item
	local def = Config.GetPet(petId)
	local rarity = if def then Config.GetRarity(def.Rarity) else nil
	local color = if rarity then rarity.Color else C.Text
	local rows: { Reveal.Row } = {}
	if def then
		local dig = def.Dig
		table.insert(rows, { Label = "RARITY", Value = def.Rarity :: string, Color = color })
		table.insert(
			rows,
			{ Label = "SAND BONUS", Value = "x" .. string.format("%.2f", def.Multiplier), Color = C.Money }
		)
		table.insert(rows, {
			Label = "DIGS",
			Value = if dig then ItemStats.DigsTo(dig.Power) else "No",
			Color = if dig then C.Time else C.Disabled,
		})
		table.insert(rows, {
			Label = "RIDEABLE",
			Value = if def.Rideable then "YES!" else "No",
			Color = if def.Rideable then C.Gold else C.Disabled,
		})
		if chance then
			table.insert(rows, {
				Label = "CHANCE",
				Value = Format.Chance(chance) .. (if pity then " (pity)" else ""),
				Color = if pity then C.Gold else C.Time,
			})
		end
	end
	return {
		Name = if def then def.Name else petId,
		NameColor = color,
		Model = ModelFactory.Pet(petId),
		Rows = rows,
	}
end

local function play(petIds: { string }, info: HatchInfo?)
	playing = true
	if info and typeof(info.EggId) == "string" and Config.GetEgg(info.EggId :: string) then
		pendingEgg = info.EggId
	end
	local canvas = Root.Get("Popups")
	local overlay = Instance.new("TextButton")
	overlay.Name = "Hatch"
	overlay.Text = ""
	overlay.AutoButtonColor = false
	overlay.Selectable = false
	overlay.BackgroundColor3 = Color3.new(0, 0, 0)
	overlay.BackgroundTransparency = 1
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = 30
	overlay.Parent = canvas
	Style.Tween(overlay, 0.25, { BackgroundTransparency = 0.45 })

	local skip = State.GetSetting("ReducedMotion", false) == true
	overlay.Activated:Connect(function()
		skip = true
	end)

	local n = #petIds
	local slotWidth = 230
	local slots: { Frame } = {}
	local eggViews: { Viewport.Viewport } = {}
	local eggIds: { string } = {}
	for i, petId in petIds do
		local slot = Instance.new("Frame")
		slot.Name = "Slot" .. i
		slot.BackgroundTransparency = 1
		slot.AnchorPoint = Vector2.new(0.5, 0.5)
		slot.Size = UDim2.fromOffset(slotWidth, 300)
		slot.Position = UDim2.new(0.5, (i - (n + 1) / 2) * (slotWidth + 20), 0.5, 0)
		slot.ZIndex = 31
		slot.Parent = overlay
		local egg = Viewport.new({
			Name = "Egg",
			Size = UDim2.fromOffset(180, 180),
			Position = UDim2.fromScale(0.5, 0.42),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 34,
			Pitch = 8,
			Parent = slot,
		})
		local eggId = eggFor(petId)
		eggIds[i] = eggId
		egg:SetModel(ModelFactory.Egg(eggId))
		if not skip then
			Style.PopIn(egg.Frame, 0.4)
		end
		table.insert(slots, slot)
		table.insert(eggViews, egg)
	end
	pendingEgg = nil

	-- wobble, building up
	local wobbles = { 8, 10, 14, 18, 24, 30 }
	for step, angle in wobbles do
		if skip or State.GetSetting("ReducedMotion", false) == true then
			break
		end
		SoundController.Play("EggShake", 0.9 + step * 0.08)
		local t = math.max(0.06, 0.16 - step * 0.015)
		for _, egg in eggViews do
			Style.Tween(egg.Frame, t, { Rotation = angle }, Enum.EasingStyle.Sine)
		end
		task.wait(t)
		for _, egg in eggViews do
			Style.Tween(egg.Frame, t, { Rotation = -angle }, Enum.EasingStyle.Sine)
		end
		task.wait(t)
		if step % 2 == 0 then
			task.wait(0.12)
		end
	end

	-- crack!
	SoundController.Play("Hatch")
	local best = 0
	for _, petId in petIds do
		local def = Config.GetPet(petId)
		local rarity = if def then Config.GetRarity(def.Rarity) else nil
		best = math.max(best, if rarity then rarity.Order else 1)
	end
	UIEffects.Flash(Color3.new(1, 1, 1), if best >= 5 then 0.95 else 0.7)
	for i in petIds do
		local egg = eggViews[i]
		egg.Frame.Rotation = 0
		if State.GetSetting("ReducedMotion", false) == true then
			egg.Frame.Visible = false
		elseif Config.IsCrate(eggIds[i]) then
			-- crates open: the lid pops off, then the crate fades
			popLid(egg)
			task.delay(0.25, function()
				Style.Tween(egg.Frame, 0.25, { ImageTransparency = 1 })
			end)
			task.delay(0.5, function()
				egg.Frame.Visible = false
			end)
		else
			Style.Tween(egg.Frame, 0.2, { Size = UDim2.fromOffset(240, 240), ImageTransparency = 1 })
			task.delay(0.2, function()
				egg.Frame.Visible = false
			end)
		end
	end

	-- hand over to the shared Reveal popup (it has its own dim + tap to close)
	task.wait(0.4)
	Style.Tween(overlay, 0.2, { BackgroundTransparency = 1 })
	task.wait(0.2)
	overlay:Destroy()
	local bestRarity: Types.RarityDef? = nil
	local items: { Reveal.Item } = {}
	local chances = if info then info.Chances else nil
	local pities = if info then info.Pity else nil
	for i, petId in petIds do
		local chance = if chances and typeof(chances[i]) == "number" then chances[i] else nil
		local pity = if pities then pities[i] == true else false
		table.insert(items, revealItem(petId, chance, pity))
		local def = Config.GetPet(petId)
		local rarity = if def then Config.GetRarity(def.Rarity) else nil
		if rarity and (not bestRarity or rarity.Order > (bestRarity :: Types.RarityDef).Order) then
			bestRarity = rarity
		end
	end
	local top = bestRarity
	local done = false
	Reveal.Show({
		Headline = if top then string.upper(top.Name) .. "!" else "HATCHED!",
		Color = if top then top.Color else C.Gold,
		Gradient = if top then top.Gradient else nil,
		Caption = if #petIds > 1 then "You hatched " .. #petIds .. " pets!" else nil,
		Items = items,
		Sound = if best >= 5 then "RareTreasure" else "",
		Confetti = best >= 4,
		Hold = 4,
		OnClosed = function()
			done = true
		end,
	})
	while not done do
		task.wait(0.1)
	end
	HatchAnimation.Finished:Fire(petIds)
	playing = false
	local nextBatch = table.remove(queue, 1)
	if nextBatch then
		play(nextBatch.Ids, nextBatch.Info)
	end
end

function HatchAnimation.Play(results: { any }, info: HatchInfo?)
	local ids = {}
	for _, value in results do
		local id = resolvePetId(value)
		if id then
			table.insert(ids, id)
		end
		if #ids >= 5 then
			break
		end
	end
	if #ids == 0 then
		return
	end
	HatchAnimation.Hatched:Fire(ids)
	if playing then
		table.insert(queue, { Ids = ids, Info = info })
	else
		task.spawn(play, ids, info)
	end
end

function HatchAnimation.Init()
	task.spawn(function()
		Remotes.Get("EggHatched").OnClientEvent:Connect(function(results: any, rawInfo: any)
			local info: HatchInfo? = nil
			if typeof(rawInfo) == "table" then
				info = {
					EggId = if typeof(rawInfo.EggId) == "string" then rawInfo.EggId else nil,
					Chances = if typeof(rawInfo.Chances) == "table" then rawInfo.Chances else nil,
					Pity = if typeof(rawInfo.Pity) == "table" then rawInfo.Pity else nil,
				}
			end
			if typeof(results) == "table" then
				-- accept {petIds} or {Pets = {...}}
				local list = if typeof(results.Pets) == "table" then results.Pets else results
				HatchAnimation.Play(list, info)
			elseif typeof(results) == "string" then
				HatchAnimation.Play({ results })
			end
		end)
	end)
end

return HatchAnimation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="140">
            <Properties>
              <string name="Name">Icons</string>
              <string name="Source"><![CDATA[--!strict
-- Emoji/text icons only (no image asset ids). Keep to widely supported emoji (Unicode <= 12).
local Icons = {}

Icons.Coins = "💰"
Icons.Tokens = "🔷"
Icons.Rebirth = "♻️"
Icons.Sand = "⏳"
Icons.Backpack = "🎒"
Icons.Depth = "⛏️"
Icons.Shop = "🛒"
Icons.Eggs = "🥚"
Icons.Pets = "🐾"
Icons.Index = "📖"
Icons.Quests = "📜"
Icons.Daily = "🎁"
Icons.Store = "💎"
Icons.Settings = "⚙️"
Icons.Beach = "⛱️"
Icons.Garage = "🚜"
Icons.Dig = "⛏️" -- v2.1: digging pet badge
Icons.Ride = "🚜" -- v2.1: rideable pet badge
Icons.Crate = "📦" -- v2.1: Construction Crate
Icons.Surface = "⬆️"
Icons.Sell = "💸"
Icons.AutoDig = "🤖"
Icons.Lock = "🔒"
Icons.Check = "✅"
Icons.Close = "✖"
Icons.Star = "⭐"
Icons.Robux = "R$"
Icons.Power = "💪"
Icons.Speed = "⚡"
Icons.Radius = "📏"
Icons.Multiplier = "✖️"
Icons.Hand = "👆"
Icons.Arrow = "⬇️"

Icons.Layers = {
	dry_sand = "🏖️",
	wet_sand = "🌊",
	shell_bed = "🐚",
	tidal_clay = "🦀",
	pirate_cove = "🏴‍☠️",
	shipwreck = "⚓",
	fossil_bed = "🦖",
	bedrock = "⛰️",
	crystal_caverns = "💎",
	frozen_abyss = "🧊",
	ancient_ruins = "🏛️",
	magma_chamber = "🌋",
	obsidian_depths = "🖤",
	alien_hive = "👽",
	the_core = "🌟",
} :: { [string]: string }

Icons.PetShapes = {
	Crab = "🦀",
	Bird = "🐦",
	Star = "⭐",
	Turtle = "🐢",
	Fish = "🐟",
	Squid = "🦑",
	Blob = "💧",
	Mole = "🐹",
	Dino = "🦖",
	Dragon = "🐉",
	Golem = "🗿",
	Seal = "🐳",
} :: { [string]: string }

-- v2.1 vehicle pets (PetDef.VehicleKind)
Icons.VehicleKinds = {
	ToyTruck = "🚚",
	DumpTruck = "🚛",
	Excavator = "🚜",
	SkidSteer = "🚜",
	Bulldozer = "🚜",
	Backhoe = "🚜",
	DrillRig = "🏗️",
	MiningDrill = "⛏️",
	TunnelBorer = "🏗️",
	Mole = "🤖",
	LavaDrill = "🌋",
	CoreDriller = "🏗️",
} :: { [string]: string }

Icons.BackpackShapes = {
	Bucket = "🧺",
	Bag = "👜",
	Box = "📦",
	Barrel = "🛢️",
	Cart = "🛒",
	Vehicle = "🚜",
	Orb = "🔮",
} :: { [string]: string }

Icons.TreasureShapes = {
	Coin = "🥇",
	Cap = "🧢",
	Shell = "🐚",
	Bottle = "🍾",
	Chest = "🧰",
	Gem = "💎",
	Bone = "🦴",
	Skull = "💀",
	Orb = "🔮",
	Crown = "👑",
	Tablet = "📜",
	Egg = "🥚",
	Anchor = "⚓",
	Wheel = "☸️",
	Shard = "🔷",
	Box = "📦",
} :: { [string]: string }

Icons.BoostKinds = {
	Sand = "⏳",
	Luck = "🍀",
	Coins = "💰",
	Speed = "⚡",
} :: { [string]: string }

Icons.Events = {
	HighTide = "🌊",
	GoldenHour = "🌅",
} :: { [string]: string }

function Icons.Layer(id: string): string
	return Icons.Layers[id] or "⛏️"
end

function Icons.PetShape(shape: string): string
	return Icons.PetShapes[shape] or "🐾"
end

-- Pet icon: the vehicle icon for vehicle pets, else the creature shape icon.
function Icons.Pet(shape: string, vehicleKind: string?): string
	if vehicleKind then
		return Icons.VehicleKinds[vehicleKind] or "🚜"
	end
	return Icons.PetShape(shape)
end

function Icons.Event(id: string, kind: string?): string
	return Icons.Events[id] or (kind and Icons.BoostKinds[kind]) or "🎉"
end

return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">ItemStats</string>
              <string name="Source"><![CDATA[--!strict
-- ItemStats — short stat strings shared by the shop upgrade rows and the Reveal popup
-- ("Dig 4x4", "Holds 120", "Digs Pirate Cove"). Keep the numbers in sync with the server:
-- dig cube edge = Radius * 2 rounded to whole 4-stud voxels (DigService), min one voxel.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local ItemStats = {}

local VOXEL = 4

-- Edge (studs) of the cube one dig removes.
function ItemStats.DigEdge(radius: number): number
	return math.max(1, math.floor(radius * 2 / VOXEL + 0.5)) * VOXEL
end

function ItemStats.DigSize(radius: number): string
	local edge = ItemStats.DigEdge(radius)
	return edge .. "×" .. edge
end

-- Deepest layer name a dig power reaches.
function ItemStats.DigsTo(power: number): string
	return Config.Layers[Config.GetMaxLayerIndexForPower(power)].Name
end

function ItemStats.Rate(shovel: Types.ShovelDef): string
	return string.format("%.1f/s", 1 / shovel.Cooldown)
end

-- 1-based position of a shovel in the price ladder (Config.Shovels), 1 when unknown.
function ItemStats.ShovelTier(id: string?): number
	for i, def in Config.Shovels do
		if def.Id == id then
			return i
		end
	end
	return 1
end

--[[
	How "heavy" a shovel feels, 1 (starter) .. 2: scales the dig burst, flying chunks, shake,
	the scooped sand clump and the dig sound, so every upgrade is visible and audible even when
	its dig cube stays the same size (Hand Spade and Garden Trowel both dig 4x4).
]]
function ItemStats.Heft(id: string?): number
	return math.min(2, 1 + 0.2 * (ItemStats.ShovelTier(id) - 1))
end

-- One line saying what a new shovel improves over the old one ("+50% SAND · NOW DIGS SHELL BED").
function ItemStats.UpgradeSummary(old: Types.ShovelDef?, new: Types.ShovelDef): string?
	if not old then
		return nil
	end
	local parts = {}
	local newLayer = Config.GetMaxLayerIndexForPower(new.Power)
	if newLayer > Config.GetMaxLayerIndexForPower(old.Power) then
		table.insert(parts, "NOW DIGS " .. string.upper(Config.Layers[newLayer].Name))
	end
	if new.SandMultiplier > old.SandMultiplier then
		table.insert(parts, "+" .. math.floor((new.SandMultiplier / old.SandMultiplier - 1) * 100 + 0.5) .. "% SAND")
	end
	if ItemStats.DigEdge(new.Radius) > ItemStats.DigEdge(old.Radius) then
		table.insert(parts, "BIGGER DIGS")
	end
	if new.Cooldown < old.Cooldown * 0.97 then
		table.insert(parts, "+" .. math.floor((old.Cooldown / new.Cooldown - 1) * 100 + 0.5) .. "% SPEED")
	end
	return if #parts > 0 then table.concat(parts, " · ") else nil
end

function ItemStats.SandMult(multiplier: number): string
	-- Currency formatting floors small numbers, which hides fractional shovel upgrades.
	return "x" .. (if multiplier < 1000 then tostring(multiplier) else Format.Abbreviate(multiplier))
end

return ItemStats
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="142">
            <Properties>
              <string name="Name">Layout</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Layout — the one place that decides where every always-on HUD region goes (design px, see
	Root: a landscape phone is ~1190-1330 x 500-540, a 1080p PC ~1420 x 760-800, a tablet
	~1000 x 750). Pure math (Layout.Compute) so tests can check any screen size; HUD, the
	objective banner, Toasts, SurvivalHUD and RideButton all position themselves from it and
	follow Layout.Changed.

	Regions (x, y = top-left; W, H = canvas design size):
	  TopRight  currency cluster: Coins pill + Daily/Settings round buttons, Tokens and the
	            multiplier pill under them          x W-400..W-12, y 8..108
	  Menu      2-column square menu, left-centre   x 14..168, 4 rows of 74 (y 4.. on short
	            screens so the bottom row clears the phone thumbstick)
	  Depth     depth meter 200 x 118:
	              wide screens (W >= 1184): top-centre-right, left of the TopRight cluster
	              narrow screens: right edge under the TopRight cluster (y 116)
	  Centre    top-centre column between the menu and the Depth/TopRight block (<= 380 wide):
	            objective banner y 8..54, boost/event chips y 60..96, toasts from y 102
	  Survival  SurvivalHUD (heat meter + snack slots) on the right edge under Depth/TopRight
	  Social    server dig goal bar + "Friends +X%" chip (UI/SocialHUD), 200 x 80: under the
	            Depth meter on wide screens, under the SurvivalHUD on narrow ones (left of it
	            on short narrow PC windows)
	  Bottom    backpack bar + Surface/Sell/Auto, 420 x 180 centred on the bottom edge
	  Ride      Ride button beside the bottom bar (right side; left side only when that would
	            meet the SurvivalHUD, i.e. short narrow PC windows); RideDig = touch dig button
	Phones keep the thumbstick (bottom-left) and jump button (bottom-right) zones clear:
	nothing but the bottom bar/Ride reaches below y H-183 near those corners (tests check this).
]]
local Root = require(script.Parent.Root)
local Signal = require(script.Parent.Parent.Util.Signal)

local Layout = {}

export type Rect = { X: number, Y: number, W: number, H: number }

export type Regions = {
	Size: Vector2,
	Wide: boolean,
	TopRight: Rect,
	Menu: Rect,
	Depth: Rect,
	Centre: Rect, -- the whole top-centre column (banner + chips + toasts)
	Banner: Rect,
	Timers: Rect,
	Toasts: Rect,
	Survival: Rect,
	Social: Rect,
	Bottom: Rect,
	Ride: Rect,
	RideDig: Rect,
}

Layout.MENU_CELL = 74 -- >= Theme.MinTouchSize
Layout.MENU_GAP_X = 6
Layout.MENU_GAP_Y = 4
Layout.MENU_COLUMNS = 2
Layout.MENU_ROWS = 4
Layout.TOP_RIGHT = Vector2.new(388, 100)
Layout.DEPTH = Vector2.new(200, 118)
Layout.SURVIVAL = Vector2.new(218, 184)
Layout.SOCIAL = Vector2.new(200, 80)
Layout.BOTTOM = Vector2.new(420, 180)
Layout.RIDE = Vector2.new(80, 86)
Layout.RIDE_DIG = 96
Layout.CENTRE_WIDTH = 380
Layout.WIDE_AT = 1184

local MARGIN = 12

local function rect(x: number, y: number, w: number, h: number): Rect
	return { X = x, Y = y, W = w, H = h }
end

function Layout.Overlaps(a: Rect, b: Rect): boolean
	return a.X < b.X + b.W and b.X < a.X + a.W and a.Y < b.Y + b.H and b.Y < a.Y + a.H
end

function Layout.Compute(size: Vector2): Regions
	local W, H = size.X, size.Y
	local menuW = Layout.MENU_COLUMNS * Layout.MENU_CELL + (Layout.MENU_COLUMNS - 1) * Layout.MENU_GAP_X
	local menuH = Layout.MENU_ROWS * Layout.MENU_CELL + (Layout.MENU_ROWS - 1) * Layout.MENU_GAP_Y
	local menuY = math.max(4, math.floor((H - menuH) / 2 - 96))
	local menu = rect(14, menuY, menuW, menuH)

	local topRight = rect(W - MARGIN - Layout.TOP_RIGHT.X, 8, Layout.TOP_RIGHT.X, Layout.TOP_RIGHT.Y)
	local wide = W >= Layout.WIDE_AT
	local depth = if wide
		then rect(topRight.X - 10 - Layout.DEPTH.X, 8, Layout.DEPTH.X, Layout.DEPTH.Y)
		else rect(W - MARGIN - Layout.DEPTH.X, topRight.Y + topRight.H + 8, Layout.DEPTH.X, Layout.DEPTH.Y)

	-- top-centre column: between the menu and whatever sits at the top right
	local bandLeft = menu.X + menu.W + MARGIN
	local bandRight = (if wide then depth.X else topRight.X) - MARGIN
	local width = math.min(Layout.CENTRE_WIDTH, bandRight - bandLeft)
	local cx = math.clamp(W / 2, bandLeft + width / 2, bandRight - width / 2)
	local left = math.floor(cx - width / 2)
	local centre = rect(left, 8, width, 94 + 3 * 46)
	local banner = rect(left, 8, width, 46)
	local timers = rect(left, 60, width, 36)
	local toasts = rect(left, 102, width, 3 * 46)

	local survivalTop = if wide then topRight.Y + topRight.H + 8 else depth.Y + depth.H + 6
	local survival = rect(W - 8 - Layout.SURVIVAL.X, survivalTop, Layout.SURVIVAL.X, Layout.SURVIVAL.Y)

	local bottom =
		rect(math.floor(W / 2 - Layout.BOTTOM.X / 2), H - 10 - Layout.BOTTOM.Y, Layout.BOTTOM.X, Layout.BOTTOM.Y)
	local ride = rect(bottom.X + bottom.W + 4, H - 116 - Layout.RIDE.Y, Layout.RIDE.X, Layout.RIDE.Y)
	if Layout.Overlaps(ride, survival) then
		-- short narrow screens (PC windows): the left side of the bottom bar instead
		ride.X = bottom.X - 4 - Layout.RIDE.X
	end
	local rideDig = rect(W - 170 - Layout.RIDE_DIG, H - 16 - Layout.RIDE_DIG, Layout.RIDE_DIG, Layout.RIDE_DIG)
	local social = if wide
		then rect(depth.X, depth.Y + depth.H + 6, Layout.SOCIAL.X, Layout.SOCIAL.Y)
		else rect(W - MARGIN - Layout.SOCIAL.X, survival.Y + survival.H + 6, Layout.SOCIAL.X, Layout.SOCIAL.Y)
	if not wide and (social.Y + social.H > H - 8 or Layout.Overlaps(social, rideDig)) then
		-- short narrow screens (PC windows): left of the SurvivalHUD, under the top-centre column
		social = rect(survival.X - 8 - Layout.SOCIAL.X, survival.Y, Layout.SOCIAL.X, Layout.SOCIAL.Y)
	end

	return {
		Size = size,
		Wide = wide,
		TopRight = topRight,
		Menu = menu,
		Depth = depth,
		Centre = centre,
		Banner = banner,
		Timers = timers,
		Toasts = toasts,
		Survival = survival,
		Social = social,
		Bottom = bottom,
		Ride = ride,
		RideDig = rideDig,
	}
end

function Layout.Position(r: Rect): UDim2
	return UDim2.fromOffset(r.X, r.Y)
end

function Layout.SizeOf(r: Rect): UDim2
	return UDim2.fromOffset(r.W, r.H)
end

Layout.Changed = Signal.new() -- (regions)
local current: Regions = Layout.Compute(Root.DesignSize)
local hooked = false

function Layout.Current(): Regions
	return current
end

local function designSize(): Vector2?
	local size = Root.GetDesignSize()
	if size.X <= 0 or size.Y <= 0 then
		return nil
	end
	return Vector2.new(math.floor(size.X), math.floor(size.Y))
end

function Layout.Refresh()
	local size = designSize()
	if size == nil or size == current.Size then
		return
	end
	current = Layout.Compute(size :: Vector2)
	Layout.Changed:Fire(current)
end

-- Calls fn(regions) now and whenever the screen layout changes.
function Layout.Observe(fn: (Regions) -> ())
	if not hooked and Root.Layers.HUD then
		hooked = true
		Root.ScaleChanged:Connect(Layout.Refresh)
		Root.Layers.HUD.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(Layout.Refresh)
		local size = designSize()
		if size then
			current = Layout.Compute(size)
		end
	end
	Layout.Changed:Connect(fn)
	fn(current)
end

return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="143">
            <Properties>
              <string name="Name">MenuGate</string>
              <string name="Source"><![CDATA[--!strict
--[[
	MenuGate — progressive menu disclosure rules (docs/design/Onboarding.md). Pure functions of
	the player's data so tests can check every rule; HUD applies the result (visibility, 2-column
	re-flow, pop-in, "NEW!" tag, unlock toast).

	A button is shown when its rule holds now OR it was ever unlocked before (persisted in
	data.Settings.MenuUnlocked, a comma list), so nothing ever disappears again even when the
	trigger was transient (coins spent, heat cooled off, rebirth reset the shovels).
	"NEW!" shows until the matching panel is first opened (data.Settings.MenuSeen).
	Returning players (PlayTime > RETURNING_PLAYTIME or Rebirths > 0) see everything.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local MenuGate = {}

-- Menu grid order (HUD) + the top-right Daily button. Settings is always visible.
MenuGate.MENU = table.freeze({ "Shop", "Beach", "Eggs", "Pets", "Index", "Quests", "Rebirth", "Store" })
MenuGate.ALL = table.freeze({ "Shop", "Beach", "Eggs", "Pets", "Index", "Quests", "Rebirth", "Store", "Daily" })

-- Panel name -> gated button name (opening the panel clears that button's NEW tag).
MenuGate.PANEL_TO_BUTTON = table.freeze({
	Shop = "Shop",
	BeachShop = "Beach",
	Eggs = "Eggs",
	Pets = "Pets",
	Index = "Index",
	Quests = "Quests",
	Rebirth = "Rebirth",
	Store = "Store",
	Daily = "Daily",
})

MenuGate.UNLOCK_KEY = "MenuUnlocked"
MenuGate.SEEN_KEY = "MenuSeen"

-- Tuning (seconds of total PlayTime / fractions).
MenuGate.RETURNING_PLAYTIME = 20 * 60
MenuGate.BEACH_HEAT = 50
MenuGate.BEACH_PLAYTIME = 4 * 60
MenuGate.STORE_PLAYTIME = 8 * 60
MenuGate.DAILY_PLAYTIME = 60
MenuGate.REBIRTH_FRACTION = 0.6
-- Tutorial (Config.TUTORIAL_STEPS) completed-step counts that reveal a button: reaching the
-- "shop" step shows Shop, reaching the "egg" step shows Eggs. Derived from the step ids so
-- inserting a step never shifts which button unlocks when.
local function stepsBefore(id: string): number
	for i, step in Config.TUTORIAL_STEPS do
		if step.Id == id then
			return i - 1
		end
	end
	error("MenuGate: no tutorial step " .. id)
end
MenuGate.TUTORIAL_SHOP = stepsBefore("shop")
MenuGate.TUTORIAL_EGGS = stepsBefore("egg")

-- Unlock lines (short, no emoji: toasts use TextScaled labels).
MenuGate.MESSAGES = table.freeze({
	Shop = "Shop unlocked! Buy a better shovel",
	Beach = "Beach shop unlocked! Shade and snacks cool you",
	Eggs = "Eggs unlocked! Hatch a pet helper",
	Pets = "Pets unlocked! Equip pets for more sand",
	Index = "Index unlocked! Collect every treasure",
	Quests = "Quests unlocked! Finish them for rewards",
	Rebirth = "Rebirth unlocked! Restart stronger",
	Store = "Store unlocked! Boosts and passes",
	Daily = "Daily rewards unlocked! Claim one every day",
})

export type Context = {
	Data: Types.PlayerData,
	Heat: number?, -- current Heat attribute (transient: the unlock is persisted when it fires)
}

local function count(t: { [any]: any }?): number
	local n = 0
	if t then
		for _ in t do
			n += 1
		end
	end
	return n
end

function MenuGate.IsReturning(data: Types.PlayerData): boolean
	return (data.PlayTime or 0) > MenuGate.RETURNING_PLAYTIME or (data.Rebirths or 0) > 0
end

local function tutorialDone(data: Types.PlayerData): number
	local saved = data.Settings and data.Settings.Tutorial
	return if type(saved) == "number" then saved else 0
end

local function flag(data: Types.PlayerData, name: string): boolean
	return data.Settings ~= nil and data.Settings["FTUE_" .. name] == true
end

-- The rule for each button right now (ignores what was persisted).
function MenuGate.Rules(ctx: Context): { [string]: boolean }
	local data = ctx.Data
	local playTime = data.PlayTime or 0
	local shovels = count(data.OwnedShovels)
	local pets = count(data.Pets)
	local tutorial = tutorialDone(data)
	local anyClaimed = false
	local quests: { [string]: Types.QuestProgress } = data.Quests or {}
	for _, quest in quests do
		if quest.Claimed then
			anyClaimed = true
			break
		end
	end
	return {
		Shop = flag(data, "FirstSell") or tutorial >= MenuGate.TUTORIAL_SHOP or shovels > 1,
		Beach = (ctx.Heat or 0) >= MenuGate.BEACH_HEAT or playTime >= MenuGate.BEACH_PLAYTIME or count(
			data.OwnedShades
		) > 0,
		Eggs = tutorial >= MenuGate.TUTORIAL_EGGS or shovels >= 3 or pets > 0,
		Pets = pets > 0,
		Index = data.Index ~= nil and next(data.Index) ~= nil,
		Quests = shovels > 1 or flag(data, "FirstShovel") or anyClaimed,
		Rebirth = (data.Rebirths or 0) > 0
			or (data.Coins or 0) >= MenuGate.REBIRTH_FRACTION * Config.RebirthCost(data.Rebirths or 0),
		Store = playTime >= MenuGate.STORE_PLAYTIME,
		Daily = playTime >= MenuGate.DAILY_PLAYTIME or (data.LastDailyClaim or 0) > 0,
	}
end

function MenuGate.ParseList(value: any): { [string]: boolean }
	local set: { [string]: boolean } = {}
	if type(value) == "string" then
		for name in string.gmatch(value, "[^,]+") do
			if MenuGate.MESSAGES[name] then
				set[name] = true
			end
		end
	end
	return set
end

-- Canonical (MenuGate.ALL order) comma list; at most 53 chars (SetSetting allows 64).
function MenuGate.FormatList(set: { [string]: boolean }): string
	local names = {}
	for _, name in MenuGate.ALL do
		if set[name] then
			table.insert(names, name)
		end
	end
	return table.concat(names, ",")
end

-- Which buttons are visible: returning players see all, otherwise persisted OR rule.
function MenuGate.Evaluate(ctx: Context): { [string]: boolean }
	local data = ctx.Data
	local visible: { [string]: boolean } = {}
	if MenuGate.IsReturning(data) then
		for _, name in MenuGate.ALL do
			visible[name] = true
		end
		return visible
	end
	local persisted = MenuGate.ParseList(data.Settings and data.Settings[MenuGate.UNLOCK_KEY])
	local rules = MenuGate.Rules(ctx)
	for _, name in MenuGate.ALL do
		visible[name] = persisted[name] == true or rules[name] == true
	end
	return visible
end

-- Design-px top-left of the k-th visible menu cell (2 columns, no gaps between visible ones).
function MenuGate.CellPosition(k: number, cell: number, gapX: number, gapY: number, columns: number): Vector2
	local col = (k - 1) % columns
	local row = (k - 1) // columns
	return Vector2.new(col * (cell + gapX), row * (cell + gapY))
end

return MenuGate
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">ObjectiveBanner</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ObjectiveBanner — the slim top-centre objective pill (docs/UI_STYLE.md): dark navy pill with
	an atlas icon overlapping its left end, one short bold outlined line ("Tap the sand to
	DIG!"), an optional step counter chip and an optional bouncing arrow. Toasts stack under it
	(UI/Layout: Banner region, top of the centre column). Used by TutorialController.

		ObjectiveBanner.Show("Sell your sand!", "Sell", { Step = "4/6", Arrow = true })
		ObjectiveBanner.Hide()
]]
local Root = require(script.Parent.Root)
local Layout = require(script.Parent.Layout)
local Style = require(script.Parent.Components.Style)
local AtlasIcon = require(script.Parent.Components.AtlasIcon)
local State = require(script.Parent.Parent.Controllers.State)

local ObjectiveBanner = {}

export type Options = { Step: string?, Arrow: boolean? }

local frame: Frame? = nil
local icon: AtlasIcon.AtlasIcon
local label: TextLabel
local step: TextLabel
local arrow: AtlasIcon.AtlasIcon
local arrowTween: Tween? = nil
local hiding = 0

ObjectiveBanner.Visible = false

local function refreshArrow()
	if arrowTween then
		arrowTween:Cancel()
		arrowTween = nil
	end
	if not frame then
		return
	end
	arrow.Frame.Position = UDim2.new(1, -6, 0.5, -2)
	if ObjectiveBanner.Visible and arrow.Frame.Visible and State.GetSetting("ReducedMotion", false) ~= true then
		arrow.Frame.Position = UDim2.new(1, -6, 0.5, -6)
		arrowTween = Style.Tween(
			arrow.Frame,
			0.4,
			{ Position = UDim2.new(1, -6, 0.5, 4) },
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		)
	end
end

State.Changed("Settings"):Connect(refreshArrow)

local function build(): Frame
	local existing = frame
	if existing then
		return existing
	end
	local pill = Instance.new("Frame")
	pill.Name = "Objective"
	pill.Visible = false
	pill.ZIndex = 5
	pill.Parent = Root.Get("HUD")
	Style.Pill(pill, 0.08)
	local ring = pill:FindFirstChildOfClass("UIStroke")
	if ring then
		ring.Thickness = 3
	end
	Layout.Observe(function(regions: Layout.Regions)
		pill.Position = Layout.Position(regions.Banner)
		pill.Size = Layout.SizeOf(regions.Banner)
	end)

	icon = AtlasIcon.new({
		Name = "ObjectiveIcon",
		Icon = "Star",
		Size = UDim2.fromOffset(58, 58),
		Position = UDim2.new(0, -12, 0.5, -2),
		AnchorPoint = Vector2.new(0, 0.5),
		Rotation = -8,
		ZIndex = 7,
		Parent = pill,
	})
	label = Style.Label({
		Name = "Text",
		Text = "",
		Size = UDim2.new(1, -150, 0.78, 0),
		Position = UDim2.new(0, 52, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		MaxTextSize = 24,
		StrokeThickness = 3,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = pill,
	})
	step = Style.Label({
		Name = "Step",
		Text = "",
		Size = UDim2.fromOffset(52, 28),
		Position = UDim2.new(1, -46, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Font = Style.Fonts.Title,
		MaxTextSize = 18,
		ZIndex = 7,
		Parent = pill,
	})
	step.BackgroundTransparency = 0
	step.BackgroundColor3 = Style.Colors.Coral
	Style.Corner(step, Style.Theme.CornerPill)
	Style.Stroke(step, Style.Colors.Stroke, 2)
	arrow = AtlasIcon.new({
		Name = "Arrow",
		Icon = "Arrow",
		Size = UDim2.fromOffset(34, 34),
		Position = UDim2.new(1, -6, 0.5, -2),
		AnchorPoint = Vector2.new(1, 0.5),
		ZIndex = 7,
		Parent = pill,
	})
	frame = pill
	return pill
end

function ObjectiveBanner.Show(text: string, iconKey: string?, options: Options?)
	local pill = build()
	local opts: Options = options or {}
	hiding += 1
	label.Text = text
	icon:Set(iconKey or "Star")
	step.Visible = opts.Step ~= nil
	step.Text = opts.Step or ""
	local wantArrow = opts.Arrow == true
	arrow.Frame.Visible = wantArrow
	label.Size = UDim2.new(1, (if opts.Step then -110 else -60) - (if wantArrow then 34 else 0), 0.78, 0)
	step.Position = UDim2.new(1, if wantArrow then -44 else -8, 0.5, 0)
	pill.Visible = true
	ObjectiveBanner.Visible = true
	refreshArrow()
	Style.PopIn(pill, 0.35)
end

function ObjectiveBanner.Hide()
	local maybe = frame
	ObjectiveBanner.Visible = false
	refreshArrow()
	if not maybe or not maybe.Visible then
		return
	end
	local pill = maybe :: Frame
	hiding += 1
	local token = hiding
	local scale = Style.GetPopScale(pill)
	Style.Tween(scale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Once(function()
		if token == hiding then
			pill.Visible = false
		end
	end)
end

function ObjectiveBanner.Get(): Frame?
	return frame
end

return ObjectiveBanner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="145">
            <Properties>
              <string name="Name">OfflinePopup</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OfflinePopup — "Welcome back!" card for offline pet earnings (server OfflineService, v2.2).

	OfflineEarnings({ Seconds, Away, Sand, Coins, CapSeconds, Capped, PetId }) arrives a few
	seconds after joining. The coins are already granted by the server; the shared Reveal popup
	shows what the pets dug ("While you were away your pets dug 12K sand -> +12K coins!") and,
	when it closes, coins fly into the coins counter. If the cap was hit it says so and points at
	the Long Nap rebirth perk. No Robux upsell, on purpose.

	Public API:
		OfflinePopup.Show(info)   (also used by tests)
		OfflinePopup.LastText: string   (the summary line of the last popup; tests)
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Style = require(script.Parent.Components.Style)
local Reveal = require(script.Parent.Reveal)
local UIEffects = require(script.Parent.UIEffects)
local Icons = require(script.Parent.Icons)
local HUD = require(script.Parent.HUD)
local SoundController = require(script.Parent.Parent.Controllers.SoundController)
local ModelFactory = require(script.Parent.Parent.Util.ModelFactory)

local OfflinePopup = {}

OfflinePopup.LastText = ""

local C = Style.Colors

local function num(value: any): number
	return if typeof(value) == "number" and value == value then value else 0
end

function OfflinePopup.Show(info: any)
	if typeof(info) ~= "table" then
		return
	end
	local coins = num(info.Coins)
	if coins <= 0 then
		return
	end
	local sand = num(info.Sand)
	local seconds = num(info.Seconds)
	local away = math.max(num(info.Away), seconds)
	local capped = info.Capped == true
	local petId = if typeof(info.PetId) == "string" and Config.GetPet(info.PetId) then info.PetId else nil

	OfflinePopup.LastText = string.format(
		"While you were away your pets dug %s sand → +%s coins!",
		Format.Abbreviate(sand),
		Format.Abbreviate(coins)
	)
	local rows = {
		{ Label = "AWAY", Value = Format.Time(away), Color = C.Time },
		{ Label = "PETS DUG", Value = Format.Abbreviate(sand) .. " sand", Color = C.Highlight },
		{ Label = "COINS", Value = "+" .. Format.Abbreviate(coins), Color = C.Money },
	}
	if capped then
		table.insert(rows, {
			Label = "LIMIT",
			Value = Format.Time(num(info.CapSeconds)) .. " (Long Nap perk)",
			Color = C.Coral,
		})
	end
	local model: Model? = nil
	if petId then
		local ok, result = pcall(ModelFactory.Pet, petId)
		if ok then
			model = result
		end
	end
	Reveal.Show({
		Headline = "WELCOME BACK!",
		Caption = OfflinePopup.LastText,
		Color = C.Money,
		Items = {
			{
				Name = "Tap to collect!",
				NameColor = C.Money,
				Model = model,
				Rows = rows,
			},
		},
		Sound = "Purchase",
		Confetti = true,
		Hold = 8,
		OnClosed = function()
			SoundController.Play("Coin")
			local counter = HUD.Coins
			if counter then
				UIEffects.FlyTo(Icons.Coins, counter.Badge, 12, nil, function()
					SoundController.Play("Coin")
				end)
			end
		end,
	})
end

function OfflinePopup.Init()
	Remotes.Get("OfflineEarnings").OnClientEvent:Connect(OfflinePopup.Show)
end

return OfflinePopup
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="146">
            <Properties>
              <string name="Name">Panels</string>
            </Properties>
            <Item class="ModuleScript" referent="147">
              <Properties>
                <string name="Name">BeachShopPanel</string>
                <string name="Source"><![CDATA[--!strict
--[[
	BeachShopPanel — Panel "BeachShop" (owner: Survival): shade items and snacks.
	Open with Panel.Open("BeachShop", { Tab = "Shade" | "Snacks" }) (HUD "Beach" button, the
	BeachShop stand's ProximityPrompt, empty quick-slots).

	Shade: UPGRADE ROWS (Components/UpgradeRow, v3 restyle): Models.Shade preview, your best
	shade ➜ this one ("Shade 6 ➜ Shade 8 studs", cooling), and one state button:
	  <coins price> (green / grey) / Rebirth N (locked) / Place or Move (owned) — plus Pick Up
	  when that shade is out on the beach. Buying starts placement right away.
	Snack cards (navy cards): big Models.Consumable preview, cooling + boost, "xN" owned,
	Buy 1 / Buy 5. Water is free at the fountain (card explains, no buy button).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Models = require(Shared:WaitForChild("Models"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Components = script.Parent.Parent.Components
local Style = require(Components.Style)
local Panel = require(Components.Panel)
local Button = require(Components.Button)
local Card = require(Components.Card)
local UpgradeRow = require(Components.UpgradeRow)
local Viewport = require(Components.Viewport)
local Icons = require(script.Parent.Parent.Icons)
local UIEffects = require(script.Parent.Parent.UIEffects)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local SoundController = require(script.Parent.Parent.Parent.Controllers.SoundController)
local SurvivalController = require(script.Parent.Parent.Parent.Controllers.SurvivalController)
local PlacementController = require(script.Parent.Parent.Parent.Controllers.PlacementController)

local BeachShopPanel = {}

local C = Style.Colors

local CARD_SIZE = Vector2.new(184, 290)
local PREVIEW_HEIGHT = 128

type Tab = string -- "Shade" | "Snacks"

type ItemCard = {
	Id: string,
	Update: () -> (),
}

local panel: Panel.Panel
local tabs: { [Tab]: Button.Button } = {}
local scrollers: { [Tab]: ScrollingFrame } = {}
local cards: { ItemCard } = {}
local built = false
local currentTab: Tab = "Shade"
local pendingPlace: { [string]: boolean } = {}

local function safeModel(builder: (string) -> Model, id: string): Model?
	local ok, result = pcall(builder, id)
	if ok and typeof(result) == "Instance" and result:IsA("Model") then
		for _, d in result:GetDescendants() do
			if d:IsA("BillboardGui") then
				d:Destroy()
			end
		end
		return result
	end
	return nil
end

local function preview(face: Frame, colors: { Color3 }, model: Model?, pitch: number, fillAmount: number)
	local frame = Instance.new("Frame")
	frame.Name = "Preview"
	frame.Size = UDim2.new(1, -12, 0, PREVIEW_HEIGHT)
	frame.Position = UDim2.fromOffset(6, 6)
	frame.BackgroundColor3 = colors[1]
	frame.ZIndex = 3
	frame.Parent = face
	Style.Corner(frame, Style.Theme.CornerSmall)
	Style.Stroke(frame, C.Stroke, 3)
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	Style.Gradient(frame, colors, 90)
	if model then
		-- Fill the frame: the viewport is the whole preview, the camera hugs the bounding box.
		local vp = Viewport.new({
			Size = UDim2.fromScale(1, 1),
			ZIndex = 4,
			Pitch = pitch,
			Fill = fillAmount,
			Yaw = 25,
			Parent = frame,
		})
		vp:SetModel(model)
	end
end

local function nameLabel(face: Frame, text: string)
	Style.Label({
		Name = "ItemName",
		Text = text,
		Size = UDim2.new(1, -12, 0, 24),
		Position = UDim2.fromOffset(6, PREVIEW_HEIGHT + 8),
		MaxTextSize = 20,
		StrokeThickness = 2.5,
		ZIndex = 3,
		Parent = face,
	})
end

local function statsLabel(face: Frame): TextLabel
	return Style.Label({
		Name = "Stats",
		Text = "",
		Size = UDim2.new(1, -12, 0, 44),
		Position = UDim2.fromOffset(6, PREVIEW_HEIGHT + 32),
		TextColor = C.Sky,
		StrokeThickness = 1.5,
		Font = Style.Fonts.Body,
		MaxTextSize = 13,
		Wrapped = true,
		RichText = true,
		ZIndex = 3,
		Parent = face,
	})
end

-- Shade cards ---------------------------------------------------------------------------------------

local function isPlaced(shadeId: string): boolean
	return SurvivalController.IsShadePlaced(shadeId)
end

local function shadeStat(def: Types.ShadeDef): UpgradeRow.Stat
	return { Main = "Shade " .. def.Radius .. " studs", Sub = "cools x" .. Format.Abbreviate(def.Cooling) }
end

-- Biggest shade you own (the "current" box of every row).
local function bestOwnedShade(): Types.ShadeDef?
	local best: Types.ShadeDef? = nil
	for id, owned in State.Data.OwnedShades or ({} :: { [string]: boolean }) do
		local def = if owned then Config.GetShade(id) else nil
		if def and (not best or def.Radius > (best :: Types.ShadeDef).Radius) then
			best = def
		end
	end
	return best
end

local function makeShadeCard(def: Types.ShadeDef, order: number, parent: Instance): ItemCard
	local rebirths = def.RebirthsRequired or 0
	local row = UpgradeRow.new({
		Name = def.Id,
		Title = def.Name,
		LayoutOrder = order,
		Parent = parent,
		Model = safeModel(Models.Shade, def.Id),
		Pitch = 14,
		Fill = 0.86,
		Yaw = 25,
		StageColors = { C.Sky, Style.Lighten(C.Sand, 0.1) },
		ActionWidth = 230,
		OnClick = function()
			local owned = (State.Data.OwnedShades or ({} :: { [string]: boolean }))[def.Id] == true
			if owned then
				panel:Close()
				PlacementController.Begin(def.Id)
			else
				pendingPlace[def.Id] = true
				Remotes.Get("BuyShade"):FireServer(def.Id)
			end
		end,
	})
	local main = row.Button
	local pickUp = Button.new({
		Name = "PickUp",
		Text = "Pick Up",
		Size = UDim2.new(0, 104, 0, 80),
		Color = C.Coral,
		MaxTextSize = 20,
		LayoutOrder = 20,
		ZIndex = 5,
		Parent = row.Actions,
		OnClick = function()
			Remotes.Get("PickUpShade"):FireServer(def.Id)
		end,
	})

	return {
		Id = def.Id,
		Update = function()
			local data = State.Data
			local owned = (data.OwnedShades or ({} :: { [string]: boolean }))[def.Id] == true
			local placed = owned and isPlaced(def.Id)
			local best = bestOwnedShade()
			row:SetStats(if best and best ~= def and not owned then shadeStat(best) else nil, shadeStat(def))
			pickUp:SetVisible(placed)
			main.Holder.Size = if placed then UDim2.new(0, 118, 0, 80) else UDim2.new(1, 0, 0, 80)
			local locked = not owned and data.Rebirths < rebirths
			row:SetLocked(locked)
			if owned then
				main:SetEnabled(true)
				main:SetColor(C.Ocean)
				main:SetIcon("place_shade|⛱️")
				main:SetText(if placed then "Move" else "Place")
			elseif locked then
				main:SetEnabled(false)
				main:SetIcon("Lock")
				main:SetText("Rebirth " .. rebirths)
			else
				main:SetIcon("Coins")
				main:SetText(Format.Abbreviate(def.Price))
				main:SetEnabled(data.Coins >= def.Price)
				main:SetColor(C.Success)
			end
			row:SetTag(if placed then "ON BEACH" elseif owned then "OWNED" else nil, if placed then C.Palm else C.Ocean)
			row.Card:SetHighlight(if placed then C.Gold else nil)
		end,
	}
end

-- Snack cards ---------------------------------------------------------------------------------------

local function makeSnackCard(def: Types.ConsumableDef, order: number, parent: Instance): ItemCard
	local card = Card.new({ Name = def.Id, LayoutOrder = order, Parent = parent })
	local face = card.Face
	preview(face, { Style.Lighten(C.Ocean, 0.35), C.Sky }, safeModel(Models.Consumable, def.Id), 18, 0.8)
	nameLabel(face, def.Name)
	local stats = statsLabel(face)
	local boost = if def.Boost then Config.GetBoost(def.Boost) else nil
	local boostText = if boost and def.BoostSeconds
		then string.format("\n+ %s %ds", boost.Name, def.BoostSeconds)
		else "\n" .. def.Description
	local isFree = def.Price <= 0

	local have: TextLabel = Style.Label({
		Name = "Have",
		Text = "",
		Size = UDim2.fromOffset(60, 28),
		Position = UDim2.fromOffset(10, 10),
		MaxTextSize = 18,
		ZIndex = 6,
		Parent = face,
	})
	have.BackgroundTransparency = 0
	have.BackgroundColor3 = C.NavyDark
	Style.Corner(have, Style.Theme.CornerPill)
	Style.Stroke(have, C.Stroke, 2)

	local buyOne: Button.Button? = nil
	local buyFive: Button.Button? = nil
	if isFree then
		local info = Button.new({
			Name = "Free",
			Text = "At the fountain",
			Icon = "water",
			Size = UDim2.new(1, -14, 0, 74),
			Position = UDim2.new(0.5, 0, 1, -6),
			AnchorPoint = Vector2.new(0.5, 1),
			Color = C.Ocean,
			MaxTextSize = 16,
			ZIndex = 4,
			Parent = face,
		})
		info:SetEnabled(false)
	else
		buyOne = Button.new({
			Name = "Buy1",
			Text = "Buy",
			Icon = "Coins",
			Size = UDim2.new(0.6, -9, 0, 74),
			Position = UDim2.new(0, 6, 1, -6),
			AnchorPoint = Vector2.new(0, 1),
			Color = C.Success,
			MaxTextSize = 17,
			ZIndex = 4,
			Parent = face,
			OnClick = function()
				Remotes.Get("BuyConsumable"):FireServer(def.Id, 1)
			end,
		})
		buyFive = Button.new({
			Name = "Buy5",
			Text = "x5",
			Size = UDim2.new(0.4, -9, 0, 74),
			Position = UDim2.new(1, -6, 1, -6),
			AnchorPoint = Vector2.new(1, 1),
			Color = C.Sunset,
			MaxTextSize = 17,
			ZIndex = 4,
			Parent = face,
			OnClick = function()
				Remotes.Get("BuyConsumable"):FireServer(def.Id, 5)
			end,
		})
	end

	return {
		Id = def.Id,
		Update = function()
			stats.Text = string.format("Cools <b>-%d</b> heat%s", def.Cooling, boostText)
			local count = (State.Data.Consumables or ({} :: { [string]: number }))[def.Id] or 0
			have.Visible = not isFree and count > 0
			have.Text = "x" .. tostring(count)
			local coins = State.Data.Coins
			local one = buyOne
			if one then
				one:SetEnabled(coins >= def.Price)
				one:SetText(Format.Abbreviate(def.Price))
			end
			local five = buyFive
			if five then
				five:SetEnabled(coins >= def.Price * 5)
				five:SetText("x5")
			end
			card:SetHighlight(if count > 0 then C.Gold else nil)
		end,
	}
end

-- Panel ---------------------------------------------------------------------------------------------

local function refresh()
	if not built then
		return
	end
	for _, item in cards do
		item.Update()
	end
end

local function selectTab(tab: Tab)
	currentTab = tab
	for k, button in tabs do
		button:SetColor(if k == tab then C.Sunset else C.NavyCard)
		scrollers[k].Visible = k == tab
	end
end

local function build()
	if built then
		return
	end
	built = true
	local body = panel.Body
	local tabRow = Instance.new("Frame")
	tabRow.Name = "Tabs"
	tabRow.BackgroundTransparency = 1
	tabRow.Size = UDim2.new(1, 0, 0, 58)
	tabRow.ZIndex = 5
	tabRow.Parent = body
	Style.List(tabRow, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left)
	for i, tab in { "Shade", "Snacks" } do
		tabs[tab] = Button.new({
			Text = tab,
			Icon = if tab == "Shade" then "shade" else "watermelon_slice",
			Size = UDim2.fromOffset(190, 56),
			Color = C.NavyCard,
			LayoutOrder = i,
			ZIndex = 5,
			Parent = tabRow,
			OnClick = function()
				selectTab(tab)
			end,
		})
		local scroller = Panel.Scroller(body, UDim2.new(1, 0, 1, -64), UDim2.fromOffset(0, 64))
		scroller.Name = tab
		if tab == "Shade" then
			Style.List(scroller, Enum.FillDirection.Vertical, 10)
		else
			local grid = Instance.new("UIGridLayout")
			grid.CellSize = UDim2.fromOffset(CARD_SIZE.X, CARD_SIZE.Y)
			grid.CellPadding = UDim2.fromOffset(10, 12)
			grid.SortOrder = Enum.SortOrder.LayoutOrder
			grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
			grid.Parent = scroller
		end
		scrollers[tab] = scroller
		if tab == "Shade" then
			for order, def in Config.Shades do
				table.insert(cards, makeShadeCard(def, order, scroller))
			end
		else
			for order, def in Config.Consumables do
				table.insert(cards, makeSnackCard(def, order, scroller))
			end
		end
	end
	-- hint line: how heat works (top right of the tab row)
	Style.Label({
		Name = "Hint",
		Text = "Sun heats you up. Shade, digging deep and snacks cool you down!",
		Size = UDim2.new(1, -410, 0, 44),
		Position = UDim2.new(1, 0, 0, 2),
		AnchorPoint = Vector2.new(1, 0),
		TextColor = C.Sky,
		StrokeThickness = 1.5,
		Font = Style.Fonts.Body,
		MaxTextSize = 15,
		Wrapped = true,
		ZIndex = 5,
		Parent = body,
	})
	selectTab(currentTab)
	refresh()
end

function BeachShopPanel.Init()
	panel = Panel.new({
		Name = "BeachShop",
		Title = "Beach Shop",
		Icon = Icons.Beach,
		Color = C.Sunset,
		Size = Vector2.new(800, 490),
	})
	panel.Opened:Connect(function(args: any)
		build()
		if typeof(args) == "table" and (args.Tab == "Shade" or args.Tab == "Snacks") then
			selectTab(args.Tab)
		end
		refresh()
	end)
	State.ObserveMany({ "Coins", "OwnedShades", "Consumables", "Rebirths" }, refresh)
	-- placed shades appear / disappear in the world
	CollectionService:GetInstanceAddedSignal("PlacedShade"):Connect(function()
		task.defer(refresh)
	end)
	CollectionService:GetInstanceRemovedSignal("PlacedShade"):Connect(function()
		task.defer(refresh)
	end)
	-- buying a shade jumps straight into placing it
	State.Changed("OwnedShades"):Connect(function(owned: any, old: any)
		if typeof(owned) ~= "table" then
			return
		end
		for id in pendingPlace do
			if owned[id] and not (typeof(old) == "table" and old[id]) then
				pendingPlace[id] = nil
				SoundController.Play("Purchase")
				UIEffects.Confetti(30)
				panel:Close()
				PlacementController.Begin(id)
			end
		end
	end)
end

return BeachShopPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="148">
              <Properties>
                <string name="Name">DailyPanel</string>
                <string name="Source"><![CDATA[--!strict
--[[
	DailyPanel — 7-day streak (docs/UI_STYLE.md "Daily rewards"): a horizontal row of day cards
	("DAY N", big atlas icon, amount coloured by type: green coins, sky-blue boosts, gold pets/
	eggs, mint tokens). Today's card gets a gold outline + pulse, claimed days a check overlay,
	Day 7 is a wider jackpot card. A big green CLAIM button below (countdown when not ready).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Components = script.Parent.Parent.Components
local Style = require(Components.Style)
local Panel = require(Components.Panel)
local Button = require(Components.Button)
local Card = require(Components.Card)
local AtlasIcon = require(Components.AtlasIcon)
local Icons = require(script.Parent.Parent.Icons)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local Progress = require(script.Parent.Parent.Parent.Util.Progress)

local DailyPanel = {}

local C = Style.Colors

local DAY = Vector2.new(92, 214)
local JACKPOT_W = 152

type Tile = {
	Card: Card.Card,
	Claimed: Frame,
	Today: TextLabel,
	Amount: TextLabel,
	Sub: TextLabel,
	Def: Types.DailyRewardDef,
	Pulse: Tween?,
}

local panel: Panel.Panel
local built = false
local tiles: { Tile } = {}
local claimButton: Button.Button
local streakLabel: TextLabel

-- (icon key, amount text, amount colour, sub line) for a reward
local function describe(reward: Types.Reward): (string, string, Color3, string)
	local coins = Config.ResolveCoins(reward, State.Data.MaxDepth)
	local boost = if reward.Boost then Config.GetBoost(reward.Boost) else nil
	local boostText = if boost then boost.Name .. " " .. math.floor((reward.BoostSeconds or 0) / 60) .. "m" else ""
	if reward.Pet then
		local pet = Config.GetPet(reward.Pet)
		return if pet then "PetShapes." .. pet.Look.Shape else "Pets",
			if pet then pet.Name else reward.Pet,
			C.Gold,
			boostText
	elseif reward.Egg then
		local egg = Config.GetEgg(reward.Egg)
		return "Eggs", "x" .. (reward.EggCount or 1), C.Gold, if egg then egg.Name else ""
	elseif boost then
		return "BoostKinds." .. boost.Kind, math.floor((reward.BoostSeconds or 0) / 60) .. " min", C.Time, boost.Name
	elseif coins > 0 then
		local tokens = reward.RebirthTokens or 0
		return "Coins",
			Format.Abbreviate(coins),
			C.Money,
			if tokens > 0 then "+" .. tokens .. " Token" .. (if tokens > 1 then "s" else "") else "Coins"
	elseif reward.RebirthTokens then
		return "Tokens", "+" .. reward.RebirthTokens, C.Tokens, "Tokens"
	end
	return "gift", "", C.Text, ""
end

local function refresh()
	if not built then
		return
	end
	local status = Progress.Daily(State.Data)
	local streak = if status.Broken then 0 else State.Data.DailyStreak
	streakLabel.Text = "Streak: "
		.. streak
		.. " day"
		.. (if streak == 1 then "" else "s")
		.. (if status.Broken and State.Data.DailyStreak > 0 then "  (reset — come back every day!)" else "")
	for day, tile in tiles do
		local claimed = day <= status.ClaimedThroughDay
		local isNext = day == status.NextDay
		tile.Card:SetHighlight(if isNext then C.Gold else nil)
		tile.Claimed.Visible = claimed
		tile.Today.Visible = isNext
		tile.Today.Text = if status.CanClaim then "TODAY!" else Format.Time(status.NextIn)
		local _, amount, _, sub = describe(tile.Def.Reward)
		tile.Amount.Text = amount
		tile.Sub.Text = sub
		if isNext and status.CanClaim and not tile.Pulse then
			tile.Pulse = Style.Pulse(tile.Card.Holder, 0.05, 0.9)
		elseif not (isNext and status.CanClaim) and tile.Pulse then
			Style.StopPulse(tile.Card.Holder, tile.Pulse)
			tile.Pulse = nil
		end
	end
	claimButton:SetEnabled(status.CanClaim and State.Loaded)
	claimButton:SetText(if status.CanClaim then "CLAIM!" else "Next in " .. Format.Time(status.NextIn))
end

local function build()
	if built then
		return
	end
	built = true
	local body = panel.Body
	streakLabel = Style.Label({
		Name = "Streak",
		Text = "",
		Size = UDim2.new(1, 0, 0, 30),
		TextColor = C.Highlight,
		MaxTextSize = 24,
		StrokeThickness = 2.5,
		ZIndex = 6,
		Parent = body,
	})
	local row = Instance.new("Frame")
	row.Name = "Days"
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, DAY.Y + 10)
	row.Position = UDim2.fromOffset(0, 40)
	row.ZIndex = 5
	row.Parent = body
	Style.List(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	for i, def in Config.DailyRewards do
		local jackpot = i == #Config.DailyRewards
		local card = Card.new({
			Name = "Day" .. i,
			Size = UDim2.fromOffset(if jackpot then JACKPOT_W else DAY.X, DAY.Y),
			LayoutOrder = i,
			Gradient = if jackpot then { C.Gold, C.Sunset } else nil,
			ZIndex = 6,
			Parent = row,
		})
		Style.Label({
			Name = "Day",
			Text = "DAY " .. i,
			Size = UDim2.new(1, -8, 0, 28),
			Position = UDim2.fromOffset(4, 6),
			MaxTextSize = 22,
			StrokeThickness = 2.5,
			ZIndex = 8,
			Parent = card.Face,
		})
		local icon, amountText, amountColor, sub = describe(def.Reward)
		AtlasIcon.new({
			Name = "RewardIcon",
			Icon = icon,
			Size = UDim2.new(1, -10, 0, if jackpot then 100 else 80),
			Position = UDim2.new(0.5, 0, 0, if jackpot then 84 else 76),
			ZIndex = 8,
			Parent = card.Face,
		})
		local amount = Style.Label({
			Name = "Amount",
			Text = amountText,
			Size = UDim2.new(1, -8, 0, 30),
			Position = UDim2.new(0.5, 0, 1, -40),
			AnchorPoint = Vector2.new(0.5, 1),
			TextColor = amountColor,
			MaxTextSize = 24,
			StrokeThickness = 3,
			ZIndex = 8,
			Parent = card.Face,
		})
		local subLabel = Style.Label({
			Name = "Sub",
			Text = sub,
			Size = UDim2.new(1, -8, 0, 28),
			Position = UDim2.new(0.5, 0, 1, -8),
			AnchorPoint = Vector2.new(0.5, 1),
			Font = Style.Fonts.Body,
			Wrapped = true,
			MaxTextSize = 12,
			StrokeThickness = 1.5,
			ZIndex = 8,
			Parent = card.Face,
		})
		local claimed = Instance.new("Frame")
		claimed.Name = "Claimed"
		claimed.BackgroundColor3 = C.NavyDark
		claimed.BackgroundTransparency = 0.35
		claimed.Size = UDim2.fromScale(1, 1)
		claimed.ZIndex = 10
		claimed.Visible = false
		claimed.Parent = card.Face
		Style.Corner(claimed, Style.Theme.CornerMedium)
		AtlasIcon.new({
			Name = "Check",
			Icon = "Check",
			Size = UDim2.fromScale(0.7, 0.5),
			ZIndex = 11,
			Parent = claimed,
		})
		local today = Style.Label({
			Name = "Today",
			Text = "TODAY!",
			Size = UDim2.new(1, 8, 0, 26),
			Position = UDim2.new(0.5, 0, 0, -14),
			AnchorPoint = Vector2.new(0.5, 0),
			MaxTextSize = 17,
			StrokeThickness = 2,
			ZIndex = 12,
			Parent = card.Holder,
		})
		today.BackgroundTransparency = 0
		today.BackgroundColor3 = C.Coral
		today.Visible = false
		Style.Corner(today, Style.Theme.CornerPill)
		Style.Stroke(today, C.Stroke, 2)
		table.insert(
			tiles,
			{ Card = card, Claimed = claimed, Today = today, Amount = amount, Sub = subLabel, Def = def, Pulse = nil }
		)
	end
	claimButton = Button.new({
		Name = "Claim",
		Text = "CLAIM!",
		Icon = "gift",
		Size = UDim2.fromOffset(320, 84),
		Position = UDim2.new(0.5, 0, 1, 0),
		AnchorPoint = Vector2.new(0.5, 1),
		Color = C.Success,
		MaxTextSize = 34,
		ZIndex = 6,
		Sound = "Purchase",
		Parent = body,
		OnClick = function()
			Remotes.Get("ClaimDailyReward"):FireServer()
		end,
	})
end

function DailyPanel.Init()
	panel = Panel.new({
		Name = "Daily",
		Title = "Daily Rewards",
		Icon = Icons.Daily,
		Color = C.Gold,
		Size = Vector2.new(820, 450),
	})
	panel.Opened:Connect(function()
		build()
		refresh()
	end)
	State.ObserveMany({ "DailyStreak", "LastDailyClaim" }, function()
		if built then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if built and panel.IsOpen then
				refresh()
			end
		end
	end)
	-- Gentle nudge: open the calendar once per session when a reward is waiting.
	State.LoadedSignal:Connect(function()
		task.wait(6)
		if Progress.Daily(State.Data).CanClaim and not Panel.Current() and State.Data.TotalSandDug > 0 then
			panel:Open()
		end
	end)
end

return DailyPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="149">
              <Properties>
                <string name="Name">EggPanel</string>
                <string name="Source"><![CDATA[--!strict
--[[
	EggPanel — egg list (left) + selected egg detail (right): spinning egg preview, price,
	full odds table (every pet with % chance, rarity colour, bonus — required odds disclosure),
	Hatch x1 / Hatch x3 buttons. x3 needs the Triple Hatch pass (prompts it if configured).
	Robux eggs would prompt their developer product (dormant since v2.3: no egg is sold for Robux,
	Config asserts it; the Golden Egg costs Rebirth Tokens).
	Panel.Open("Eggs", { EggId = "pirate_egg" }) focuses a specific egg (map pedestals).

	v2.1: Construction Crates (EggDef.Kind == "Crate") are listed here too, drawn as crates, with
	"Open" buttons, a "Construction Crate" tag and odds rows that show each vehicle's dig stats
	("⛏ digs Pirate Cove · every 3.0s") and a 🚜 badge on rideable pets. The crate yard pallets
	(tag "CrateShop", attribute EggId, "Open" prompt) are hooked here and focus their crate.
	v2.2 playtest ("I clicked the crates and eggs showed up"): the list has EGGS / CRATES tabs and
	shows one kind at a time. A crate prompt (or any EggId that is a crate) opens the Crates tab,
	titled "Construction Crates"; the menu button opens the Eggs tab. Panel.Open("Eggs",
	{ Tab = "Crates" }) also works.

	v2.2 TRUE ODDS (Roblox policy): every row shows the player's REAL chance for the next hatch,
	from Stats.GetHatchOddsList(egg, Stats.GetLuck(State.GetStatsContext()), Pity[egg]), the same
	function the server rolls with (PetService -> Stats.RollHatch). It refreshes when passes,
	boosts, events or the pity counter change, and every second while open (boost expiry). A note
	under the title lists the active luck modifiers ("Includes your luck x4: 2x Luck x2, ...").
	PITY: each egg card says "Rare+ in N" and the detail says "Rare+ guaranteed in N hatches". On the
	guaranteed hatch the odds rows show the Rare+-only distribution.
	POLICY: (dormant) Robux eggs whose products are PaidRandom are hidden while restricted.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local Stats = require(Shared:WaitForChild("Util"):WaitForChild("Stats"))

local Components = script.Parent.Parent.Components
local Style = require(Components.Style)
local Panel = require(Components.Panel)
local Button = require(Components.Button)
local Card = require(Components.Card)
local AtlasIcon = require(Components.AtlasIcon)
local Viewport = require(Components.Viewport)
local Icons = require(script.Parent.Parent.Icons)
local HatchAnimation = require(script.Parent.Parent.HatchAnimation)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local PurchaseController = require(script.Parent.Parent.Parent.Controllers.PurchaseController)
local ModelFactory = require(script.Parent.Parent.Parent.Util.ModelFactory)
local Tagged = require(script.Parent.Parent.Parent.Util.Tagged)

local EggPanel = {}

local C = Style.Colors

local panel: Panel.Panel
local built = false
local selected: string = Config.Eggs[1].Id
local tiles: { [string]: { Card: Card.Card, Price: TextLabel, Lock: AtlasIcon.AtlasIcon, Pity: TextLabel } } = {}
local chanceLabels: { [string]: TextLabel } = {} -- petId -> "Chance" label of the shown egg
local detail: {
	View: Viewport.Viewport,
	Name: TextLabel,
	Price: TextLabel,
	Odds: ScrollingFrame,
	Kind: TextLabel,
	Luck: TextLabel,
	Hatch1: Button.Button,
	Hatch3: Button.Button,
}? =
	nil
local shownEgg: string? = nil

type Tab = "Eggs" | "Crates"
local currentTab: Tab = "Eggs"
local tabButtons: { [Tab]: Button.Button } = {}
local TAB_TITLES: { [Tab]: string } = { Eggs = "Eggs", Crates = "Construction Crates" }

local function isCrate(egg: Types.EggDef): boolean
	return egg.Kind == "Crate"
end

local function tabOf(egg: Types.EggDef): Tab
	return if isCrate(egg) then "Crates" else "Eggs"
end

-- "⛏ digs Pirate Cove · every 3.0s" for a digging pet.
local function digText(dig: Types.PetDigDef): string
	local layer = Config.Layers[Config.GetMaxLayerIndexForPower(dig.Power)]
	return string.format("digs %s · every %.1fs", layer.Name, dig.Interval)
end

local function currencyIcon(egg: Types.EggDef): string
	return if egg.Currency == "Tokens" then "Tokens" elseif egg.Currency == "Robux" then "Robux" else "Coins"
end

-- "1.2K" / "R$ 99" (the currency is shown as an icon on buttons and in front of prices)
local function amountText(egg: Types.EggDef, count: number): string
	if egg.Currency == "Robux" then
		return "R$ " .. egg.Price * count
	end
	return Format.Abbreviate(egg.Price * count)
end

local function balance(egg: Types.EggDef): number
	if egg.Currency == "Tokens" then
		return State.Data.RebirthTokens
	elseif egg.Currency == "Coins" then
		return State.Data.Coins
	end
	return 0
end

local function priceText(egg: Types.EggDef, count: number): string
	if egg.Currency == "Robux" then
		return "R$ " .. egg.Price * count
	end
	return Format.Abbreviate(egg.Price * count) .. (if egg.Currency == "Tokens" then " tokens" else " coins")
end

local function petCount(): number
	local n = 0
	for _ in State.Data.Pets or {} :: { [string]: Types.PetInstance } do
		n += 1
	end
	return n
end

-- Robux product that hatches `count` of this egg (via Grant.Egg / EggCount), if any.
local function productFor(egg: Types.EggDef, count: number): string?
	if count == 1 and egg.ProductKey then
		return egg.ProductKey
	end
	for key, product in Config.Monetization.Products do
		if product.Grant.Egg == egg.Id and (product.Grant.EggCount or 1) == count then
			return key
		end
	end
	return nil
end

-- "x1.5" / "x2" / "x1.25"
local function factorText(value: number): string
	local text = string.format("%.2f", value):gsub("0+$", ""):gsub("%.$", "")
	return "x" .. text
end

-- The player's luck right now (same Stats.GetLuck the server rolls with) and its modifiers.
local function currentLuck(): (number, { Stats.Factor })
	local ctx = State.GetStatsContext()
	return Stats.GetLuck(ctx), Stats.GetLuckFactors(ctx)
end

local function pityCount(egg: Types.EggDef): number
	local pity = State.Data.Pity
	local count = if pity then pity[egg.Id] else nil
	return if typeof(count) == "number" then count else 0
end

-- What the panel shows for one egg: { [petId] = text } plus the luck / pity note (tests read it).
function EggPanel.GetDisplayedOdds(eggId: string): ({ [string]: string }, string)
	local maybeEgg = Config.GetEgg(eggId)
	if not maybeEgg then
		return {}, ""
	end
	local egg = maybeEgg :: Types.EggDef
	local luck, factors = currentLuck()
	local list, pityActive = Stats.GetHatchOddsList(egg, luck, pityCount(egg))
	local texts: { [string]: string } = {}
	for _, odd in list do
		texts[odd.PetId] = Format.Chance(odd.Chance)
	end
	local parts: { string } = {}
	for _, factor in factors do
		table.insert(parts, factor.Name .. " " .. factorText(factor.Value))
	end
	local note = if #factors > 0
		then "Includes your luck " .. factorText(luck) .. ": " .. table.concat(parts, ", ")
		else "Your odds per hatch (no luck boosts active)"
	local untilPity = Stats.HatchesUntilPity(egg, pityCount(egg))
	if pityActive then
		note ..= "  ·  PITY: this hatch is Rare+ guaranteed!"
	elseif untilPity then
		note ..= string.format("  ·  Rare+ guaranteed in %d hatches", untilPity :: number)
	end
	return texts, note
end

-- Short pity line for an egg card ("" when the egg has no pity).
local function pityShort(egg: Types.EggDef): string
	local untilPity = Stats.HatchesUntilPity(egg, pityCount(egg))
	if not untilPity then
		return ""
	end
	local n = untilPity :: number
	return if n <= 1 then "Rare+ next hatch!" else "Rare+ in " .. n
end

-- Robux eggs are only listed while one of their products may be offered (policy).
local function isListed(egg: Types.EggDef): boolean
	if egg.Currency ~= "Robux" then
		return true
	end
	local key = productFor(egg, 1)
	return key == nil or State.CanBuy("Product", key :: string)
end

local function refreshOdds()
	local d = detail
	local egg = Config.GetEgg(selected)
	if not d or not egg or shownEgg ~= selected then
		return
	end
	local texts, note = EggPanel.GetDisplayedOdds(selected)
	for petId, label in chanceLabels do
		label.Text = texts[petId] or "0%"
	end
	((d :: any).Luck :: TextLabel).Text = note
end

local function hatch(egg: Types.EggDef, count: number)
	if egg.Currency == "Robux" then
		local key = productFor(egg, count)
		if key then
			HatchAnimation.SetPendingEgg(egg.Id)
			PurchaseController.PromptProduct(key)
		end
		return
	end
	HatchAnimation.SetPendingEgg(egg.Id)
	Remotes.Get("HatchEgg"):FireServer(egg.Id, count)
end

local function updateButtons()
	local d = detail
	local maybeEgg = Config.GetEgg(selected)
	if not d or not maybeEgg then
		return
	end
	local egg = maybeEgg :: Types.EggDef
	local dd = d :: any
	local hatch1: Button.Button = dd.Hatch1
	local hatch3: Button.Button = dd.Hatch3
	local verb = if isCrate(egg) then "Open" else "Hatch"
	local unlocked = Config.IsEggUnlocked(egg.Id, State.Data.MaxDepth)
	local full = petCount() >= Config.PET_INVENTORY_LIMIT
	if egg.Currency == "Robux" then
		local key1 = productFor(egg, 1)
		local key3 = productFor(egg, 3)
		local ok1 = key1 ~= nil and PurchaseController.IsProductConfigured(key1 :: string)
		local ok3 = key3 ~= nil and PurchaseController.IsProductConfigured(key3 :: string)
		hatch1:SetEnabled(ok1 and not full)
		hatch1:SetIcon("Eggs")
		hatch1:SetText(
			if ok1 then "Hatch 1  R$ " .. Config.Monetization.Products[key1 :: string].Price else "Coming soon"
		)
		hatch3:SetVisible(key3 ~= nil)
		hatch3:SetEnabled(ok3 and not full)
		hatch3:SetIcon("Eggs")
		hatch3:SetText(
			if ok3 then "Hatch 3  R$ " .. Config.Monetization.Products[key3 :: string].Price else "Coming soon"
		)
		return
	end
	local have = balance(egg)
	if not unlocked then
		local layer = Config.Layers[egg.UnlockLayer]
		hatch1:SetEnabled(false)
		hatch1:SetIcon("Lock")
		hatch1:SetText("Reach " .. layer.Name)
		hatch3:SetVisible(false)
		return
	end
	if full then
		hatch1:SetEnabled(false)
		hatch1:SetIcon("Pets")
		hatch1:SetText("Pet bag full!")
		hatch3:SetVisible(false)
		return
	end
	hatch1:SetEnabled(have >= egg.Price)
	hatch1:SetIcon(currencyIcon(egg))
	hatch1:SetText(verb .. " 1 · " .. amountText(egg, 1))
	local owns3 = State.OwnsPass("TripleHatch")
	local passOk = PurchaseController.IsPassConfigured("TripleHatch")
	hatch3:SetVisible(owns3 or passOk)
	if owns3 then
		hatch3:SetEnabled(have >= egg.Price * Config.TRIPLE_HATCH_COUNT)
		hatch3:SetColor(C.Purple)
		hatch3:SetIcon(currencyIcon(egg))
		hatch3:SetText(verb .. " 3 · " .. amountText(egg, Config.TRIPLE_HATCH_COUNT))
	else
		hatch3:SetEnabled(true)
		hatch3:SetColor(C.Robux)
		hatch3:SetIcon("Lock")
		hatch3:SetText(verb .. " 3 (pass)")
	end
end

local function showEgg(eggId: string)
	local maybeEgg = Config.GetEgg(eggId)
	local d = detail
	if not maybeEgg or not d then
		return
	end
	local egg = maybeEgg :: Types.EggDef
	selected = eggId
	local dd = d :: any
	for id, tile in tiles do
		tile.Card:SetHighlight(if id == eggId then C.Gold else nil)
	end
	if shownEgg ~= eggId then
		shownEgg = eggId;
		(dd.View :: Viewport.Viewport):SetModel(ModelFactory.Egg(eggId))
		Style.Pop((dd.View :: Viewport.Viewport).Frame, 0.15);
		(dd.Name :: TextLabel).Text = egg.Name;
		(dd.Kind :: TextLabel).Text = if isCrate(egg)
			then "Construction Crate: pets that DIG for you! Your odds:"
			else "Your odds per hatch:"
		local odds: ScrollingFrame = dd.Odds
		for _, child in odds:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		table.clear(chanceLabels)
		for i, entry in egg.Pets do
			local pet = Config.GetPet(entry.PetId)
			if pet then
				local rarity = Config.GetRarity(pet.Rarity)
				local dig = pet.Dig
				local row = Card.new({
					Name = pet.Id,
					Size = UDim2.new(1, -8, 0, if dig then 58 else 46),
					LayoutOrder = i,
					Gradient = if rarity then rarity.Gradient else nil,
					GradientRotation = 0,
					ZIndex = 6,
					Parent = odds,
				})
				AtlasIcon.new({
					Icon = if pet.VehicleKind
						then "VehicleKinds." .. pet.VehicleKind
						else "PetShapes." .. pet.Look.Shape,
					Size = UDim2.fromOffset(38, 38),
					Position = UDim2.new(0, 6, 0.5, 0),
					AnchorPoint = Vector2.new(0, 0.5),
					ZIndex = 8,
					Parent = row.Face,
				})
				Style.Label({
					Text = pet.Name .. (if pet.Rideable then "  (ride!)" else ""),
					Size = UDim2.new(0.55, -44, if dig then 0.5 else 0.8, 0),
					Position = UDim2.new(0, 48, if dig then 0.3 else 0.5, 0),
					AnchorPoint = Vector2.new(0, 0.5),
					MaxTextSize = 18,
					XAlign = Enum.TextXAlignment.Left,
					ZIndex = 8,
					Parent = row.Face,
				})
				if dig then
					local digLabel = Style.Label({
						Text = digText(dig) .. (if pet.Rideable then "  ·  Rideable!" else ""),
						Size = UDim2.new(0.56, -44, 0.34, 0),
						Position = UDim2.new(0, 48, 0.76, 0),
						AnchorPoint = Vector2.new(0, 0.5),
						Font = Style.Fonts.Body,
						MaxTextSize = 13,
						XAlign = Enum.TextXAlignment.Left,
						ZIndex = 8,
						Parent = row.Face,
					})
					digLabel.Name = "Dig"
				end
				Style.Label({
					Text = "x" .. string.format("%.2f", pet.Multiplier),
					Size = UDim2.new(0.2, 0, 0.7, 0),
					Position = UDim2.new(0.58, 0, 0.5, 0),
					AnchorPoint = Vector2.new(0, 0.5),
					Font = Style.Fonts.Number,
					MaxTextSize = 16,
					ZIndex = 8,
					Parent = row.Face,
				})
				chanceLabels[entry.PetId] = Style.Label({
					Name = "Chance",
					Text = "",
					Size = UDim2.new(0.2, 0, 0.75, 0),
					Position = UDim2.new(1, -10, 0.5, 0),
					AnchorPoint = Vector2.new(1, 0.5),
					Font = Style.Fonts.Number,
					MaxTextSize = 20,
					XAlign = Enum.TextXAlignment.Right,
					ZIndex = 8,
					Parent = row.Face,
				})
			end
		end
	end
	local unlocked = Config.IsEggUnlocked(egg.Id, State.Data.MaxDepth);
	(dd.Price :: TextLabel).Text = if unlocked or egg.Currency == "Robux"
		then priceText(egg, 1) .. " each"
		else "Unlocks at " .. Config.Layers[egg.UnlockLayer].Name
	refreshOdds()
	updateButtons()
end

local function build()
	if built then
		return
	end
	built = true
	local body = panel.Body

	local tabRow = Instance.new("Frame")
	tabRow.Name = "Tabs"
	tabRow.BackgroundTransparency = 1
	tabRow.Size = UDim2.fromOffset(250, 48)
	tabRow.ZIndex = 5
	tabRow.Parent = body
	Style.List(tabRow, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left)
	for i, tab: Tab in { "Eggs", "Crates" } :: { Tab } do
		tabButtons[tab] = Button.new({
			Text = tab,
			Icon = if tab == "Eggs" then "Eggs" else "Crate",
			Size = UDim2.fromOffset(121, 46),
			Color = C.NavyCard,
			LayoutOrder = i,
			ZIndex = 5,
			Parent = tabRow,
			OnClick = function()
				EggPanel.SelectTab(tab)
			end,
		})
	end

	local list = Panel.Scroller(body, UDim2.new(0, 250, 1, -56), UDim2.fromOffset(0, 56))
	Style.List(list, Enum.FillDirection.Vertical, 8)
	for i, egg in Config.Eggs do
		local card =
			Card.new({ Name = egg.Id, Size = UDim2.new(1, -14, 0, 78), LayoutOrder = i, ZIndex = 6, Parent = list })
		local swatch = Instance.new("Frame")
		swatch.Size = UDim2.fromOffset(42, 50)
		swatch.Position = UDim2.new(0, 8, 0.5, 0)
		swatch.AnchorPoint = Vector2.new(0, 0.5)
		swatch.BackgroundColor3 = egg.Look.ShellColor
		swatch.ZIndex = 8
		swatch.Parent = card.Face
		Style.Stroke(swatch, C.Stroke, 2)
		if isCrate(egg) then
			-- a little crate: square wooden block with a hazard band
			swatch.Size = UDim2.fromOffset(44, 44)
			Style.Corner(swatch, UDim.new(0, 6))
			local band = Instance.new("Frame")
			band.Name = "Tape"
			band.BorderSizePixel = 0
			band.BackgroundColor3 = egg.Look.SpotColor
			band.Size = UDim2.new(1, 0, 0.26, 0)
			band.Position = UDim2.fromScale(0, 0.37)
			band.ZIndex = 9
			band.Parent = swatch
			AtlasIcon.new({ Icon = "Crate", Size = UDim2.fromScale(0.86, 0.86), ZIndex = 10, Parent = swatch })
		else
			Style.Corner(swatch, UDim.new(0.5, 0))
			Style.Gradient(swatch, { Color3.new(1, 1, 1), egg.Look.SpotColor:Lerp(Color3.new(1, 1, 1), 0.4) }, 90)
		end
		Style.Label({
			Text = egg.Name,
			Size = UDim2.new(1, -66, 0, 26),
			Position = UDim2.fromOffset(58, 6),
			StrokeThickness = 2,
			MaxTextSize = 19,
			XAlign = Enum.TextXAlignment.Left,
			ZIndex = 8,
			Parent = card.Face,
		})
		local price = Style.Label({
			Text = priceText(egg, 1) .. (if isCrate(egg) then "  ·  Crate" else ""),
			Size = UDim2.new(1, -66, 0, 22),
			Position = UDim2.fromOffset(58, 32),
			TextColor = C.Sand,
			Font = Style.Fonts.Number,
			StrokeThickness = 2,
			MaxTextSize = 16,
			XAlign = Enum.TextXAlignment.Left,
			ZIndex = 8,
			Parent = card.Face,
		})
		local pity = Style.Label({
			Name = "Pity",
			Text = pityShort(egg),
			Size = UDim2.new(1, -66, 0, 18),
			Position = UDim2.fromOffset(58, 54),
			TextColor = C.Gold,
			Font = Style.Fonts.Body,
			StrokeThickness = 2,
			MaxTextSize = 14,
			XAlign = Enum.TextXAlignment.Left,
			ZIndex = 8,
			Parent = card.Face,
		})
		local lock = AtlasIcon.new({
			Name = "Lock",
			Icon = "Lock",
			Size = UDim2.fromOffset(34, 34),
			Position = UDim2.new(1, -8, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			ZIndex = 9,
			Parent = card.Face,
		})
		local hit = Instance.new("TextButton")
		hit.Name = "Face"
		hit.Text = ""
		hit.BackgroundTransparency = 1
		hit.Size = UDim2.fromScale(1, 1)
		hit.ZIndex = 10
		hit.Parent = card.Face
		hit.Activated:Connect(function()
			showEgg(egg.Id)
		end)
		tiles[egg.Id] = { Card = card, Price = price, Lock = lock, Pity = pity }
	end

	local right = Instance.new("Frame")
	right.Name = "Detail"
	right.BackgroundTransparency = 1
	right.Position = UDim2.fromOffset(262, 0)
	right.Size = UDim2.new(1, -262, 1, 0)
	right.ZIndex = 5
	right.Parent = body

	local stage = Instance.new("Frame")
	stage.Name = "Stage"
	stage.Size = UDim2.fromOffset(190, 190)
	stage.BackgroundColor3 = Color3.new(1, 1, 1)
	stage.ZIndex = 5
	stage.Parent = right
	Style.Corner(stage, Style.Theme.CornerLarge)
	Style.Stroke(stage, C.Stroke, 3)
	Style.Gradient(stage, { C.Sky, C.Ocean }, 90)
	local view = Viewport.new({
		Size = UDim2.fromScale(1, 1),
		ZIndex = 6,
		Spin = true,
		SpinSpeed = 0.8,
		Pitch = 10,
		Parent = stage,
	})

	local name = Style.Label({
		Text = "",
		Size = UDim2.new(1, -200, 0, 40),
		Position = UDim2.fromOffset(200, 0),
		StrokeThickness = 2,
		MaxTextSize = 32,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = right,
	})
	local price = Style.Label({
		Text = "",
		Size = UDim2.new(1, -200, 0, 28),
		Position = UDim2.fromOffset(200, 40),
		TextColor = C.Sand,
		Font = Style.Fonts.Number,
		StrokeThickness = 2,
		MaxTextSize = 22,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = right,
	})
	local kind = Style.Label({
		Text = "Your odds per hatch:",
		Size = UDim2.new(1, -200, 0, 20),
		Position = UDim2.fromOffset(200, 68),
		Font = Style.Fonts.Body,
		StrokeThickness = 2,
		MaxTextSize = 14,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = right,
	})
	local hatch1 = Button.new({
		Text = "Hatch 1",
		Icon = "Coins",
		Size = UDim2.fromOffset(190, 80),
		Position = UDim2.fromOffset(0, 198),
		Color = C.Success,
		MaxTextSize = 20,
		ZIndex = 6,
		Parent = right,
		OnClick = function()
			local egg = Config.GetEgg(selected)
			if egg then
				hatch(egg, 1)
			end
		end,
	})
	local hatch3 = Button.new({
		Text = "Hatch 3",
		Icon = "Coins",
		Size = UDim2.fromOffset(190, 80),
		Position = UDim2.fromOffset(0, 284),
		Color = C.Purple,
		MaxTextSize = 18,
		ZIndex = 6,
		Parent = right,
		OnClick = function()
			local maybeEgg = Config.GetEgg(selected)
			if not maybeEgg then
				return
			end
			local egg = maybeEgg :: Types.EggDef
			if egg.Currency ~= "Robux" and not State.OwnsPass("TripleHatch") then
				PurchaseController.PromptPass("TripleHatch")
				return
			end
			hatch(egg, Config.TRIPLE_HATCH_COUNT)
		end,
	})
	-- v2.2: the player's active luck modifiers + pity status (true odds disclosure)
	local luckNote = Style.Label({
		Name = "LuckNote",
		Text = "",
		Size = UDim2.new(1, -200, 0, 30),
		Position = UDim2.fromOffset(200, 88),
		TextColor = C.Gold,
		Font = Style.Fonts.Body,
		StrokeThickness = 2,
		Wrapped = true,
		MaxTextSize = 13,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = right,
	})
	local odds = Panel.Scroller(right, UDim2.new(1, -200, 1, -122), UDim2.fromOffset(200, 122))
	Style.List(odds, Enum.FillDirection.Vertical, 6)

	kind.Name = "Kind"
	detail = {
		View = view,
		Name = name,
		Price = price,
		Odds = odds,
		Kind = kind,
		Luck = luckNote,
		Hatch1 = hatch1,
		Hatch3 = hatch3,
	}
end

local function refreshTiles()
	for id, tile in tiles do
		local egg = Config.GetEgg(id)
		if egg then
			local unlocked = egg.Currency == "Robux" or Config.IsEggUnlocked(id, State.Data.MaxDepth)
			tile.Card.Holder.Visible = isListed(egg) and tabOf(egg) == currentTab
			tile.Pity.Text = pityShort(egg)
			tile.Lock.Frame.Visible = not unlocked
			tile.Price.TextColor3 = if egg.Currency ~= "Robux" and balance(egg) < egg.Price then C.Danger else C.Money
		end
	end
	local selectedEgg = Config.GetEgg(selected)
	if selectedEgg and not isListed(selectedEgg) then
		local fallback = Config.Eggs[1]
		for _, egg in Config.Eggs do
			if tabOf(egg) == tabOf(selectedEgg) then
				fallback = egg
				break
			end
		end
		showEgg(fallback.Id) -- the shown egg was hidden by policy
	end
	refreshOdds()
	updateButtons()
end

-- Best unlocked coin egg or crate of this tab (what the tab shows when nothing was asked for).
local function defaultFor(tab: Tab): string
	local best: string? = nil
	for _, egg in Config.Eggs do
		if tabOf(egg) == tab and isListed(egg) then
			if best == nil or (egg.Currency == "Coins" and Config.IsEggUnlocked(egg.Id, State.Data.MaxDepth)) then
				best = egg.Id
			end
		end
	end
	return best or Config.Eggs[1].Id
end

-- Shows one tab (Eggs or Crates): filters the list, retitles the panel, picks an egg to show.
function EggPanel.SelectTab(tab: Tab, eggId: string?)
	if not built then
		return
	end
	currentTab = tab
	for t, button in tabButtons do
		button:SetColor(if t == tab then C.Sunset else C.NavyCard)
	end
	panel:SetTitle(TAB_TITLES[tab])
	local current = Config.GetEgg(selected)
	local keep = current ~= nil and tabOf(current) == tab and isListed(current)
	showEgg(eggId or (if keep then selected else defaultFor(tab)))
	refreshTiles()
end

function EggPanel.GetTab(): string
	return currentTab
end

-- Crate yard pallets (World/Hub: tag "CrateShop", attribute EggId, "Open" prompt).
-- v2.3 streaming-safe (Util/Tagged): late stream-in, stream-out cleanup.
local function hookCrateYard()
	Tagged.WatchPrompts("CrateShop", function(inst: Instance, prompt: ProximityPrompt)
		local id = prompt:GetAttribute("EggId") or inst:GetAttribute("EggId")
		Panel.Open("Eggs", { EggId = if typeof(id) == "string" then id else nil })
	end)
end

function EggPanel.Init()
	panel =
		Panel.new({ Name = "Eggs", Title = "Eggs", Icon = Icons.Eggs, Color = C.Sunset, Size = Vector2.new(800, 480) })
	panel.Opened:Connect(function(args: any)
		build()
		local target = if typeof(args) == "table" and typeof(args.EggId) == "string" then args.EggId else nil
		local targetEgg = if target then Config.GetEgg(target) else nil
		local tab: Tab = if targetEgg
			then tabOf(targetEgg)
			elseif typeof(args) == "table" and args.Tab == "Crates" then "Crates"
			else "Eggs"
		EggPanel.SelectTab(tab, if targetEgg and isListed(targetEgg) then targetEgg.Id else nil)
	end)
	State.ObserveMany({
		"Coins",
		"RebirthTokens",
		"MaxDepth",
		"Passes",
		"Pets",
		"Pity",
		"Boosts",
		"ActiveEvents",
		"PaidRandomRestricted",
	}, function()
		if built then
			refreshTiles()
		end
	end)
	-- boosts expire and friends come and go without a data change: keep the odds live while open
	task.spawn(function()
		while true do
			task.wait(1)
			if built and panel.IsOpen then
				refreshOdds()
			end
		end
	end)
	hookCrateYard()
end

return EggPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="150">
              <Properties>
                <string name="Name">IndexPanel</string>
                <string name="Source"><![CDATA[--!strict
--[[
	IndexPanel — collection book. Left: one tab per layer (emoji, name, found/total, ✅ when
	complete). Right: that layer's treasures; discovered ones show a 3D preview, rarity and how
	many you hold, undiscovered ones are black silhouettes named "???". Header shows the
	collection bonus: +Config.INDEX_LAYER_BONUS sand per completed layer.
	v3 discovery: each discovered card shows variant pills (sizes XS/M/L/XL, materials
	Gold/Fos/Cry) lit once found (PlayerData.FindVariants), and the header shows the TRUE variant
	odds with your current luck (Util/Finds.VariantOdds, the same function the server rolls
	with). Relics are listed in their layer but do not count towards layer completion.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Components = script.Parent.Parent.Components
local Style = require(Components.Style)
local Panel = require(Components.Panel)
local Button = require(Components.Button)
local Card = require(Components.Card)
local Viewport = require(Components.Viewport)
local Icons = require(script.Parent.Parent.Icons)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local ModelFactory = require(script.Parent.Parent.Parent.Util.ModelFactory)
local Finds = require(Shared:WaitForChild("Util"):WaitForChild("Finds"))
local Stats = require(Shared:WaitForChild("Util"):WaitForChild("Stats"))

local IndexPanel = {}

local C = Style.Colors

local panel: Panel.Panel
local built = false
local selectedLayer = 1
local layerButtons: { Button.Button } = {}
local grid: ScrollingFrame
local titleLabel: TextLabel
local bonusLabel: TextLabel
local oddsLabel: TextLabel

local byLayer: { [number]: { Types.TreasureDef } } = {}
for _, treasure in Config.Treasures do
	local list = byLayer[treasure.Layer]
	if not list then
		list = {}
		byLayer[treasure.Layer] = list
	end
	table.insert(list :: { Types.TreasureDef }, treasure)
end
for _, list in byLayer do
	table.sort(list, function(a: Types.TreasureDef, b: Types.TreasureDef): boolean
		local ra = Config.GetRarity(a.Rarity)
		local rb = Config.GetRarity(b.Rarity)
		return (if ra then ra.Order else 0) < (if rb then rb.Order else 0)
	end)
end

local EMPTY: { Types.TreasureDef } = {}

local function found(layerIndex: number): (number, number)
	local list: { Types.TreasureDef } = byLayer[layerIndex] or EMPTY
	local count = 0
	local total = 0
	for _, treasure in list do
		if treasure.Rarity ~= "Relic" then
			total += 1
			if State.Data.Index[treasure.Id] then
				count += 1
			end
		end
	end
	return count, total
end

-- How many of this treasure you hold unsold (v3 Finds of every variant + legacy Treasures).
function IndexPanel.Held(treasureId: string): number
	local legacy: { [string]: number } = State.Data.Treasures or {}
	local finds: { [string]: number } = State.Data.Finds or {}
	local held = legacy[treasureId] or 0
	for key, count in finds do
		if type(key) == "string" and string.sub(key, 1, #treasureId + 1) == treasureId .. "|" then
			held += count
		end
	end
	return held
end

-- Variant pills: { {Id, Short, Found, Color} } sizes then materials (the default material "None"
-- is not a pill).
function IndexPanel.VariantPills(treasureId: string): { { Id: string, Short: string, Found: boolean, Color: Color3 } }
	local list = {}
	local seen: { [string]: boolean } = State.Data.FindVariants or {}
	for _, group in { Config.Discovery.SIZES, Config.Discovery.MATERIALS } do
		for _, v in group do
			if v.Id ~= "None" then
				table.insert(list, {
					Id = v.Id,
					Short = v.Short,
					Found = seen[Finds.VariantKey(treasureId, v.Id)] == true,
					Color = v.Color,
				})
			end
		end
	end
	return list
end

-- "Tiny 20% · Large 14% ..." true odds at the player's current luck.
function IndexPanel.OddsText(): string
	local ok, luck = pcall(function(): number
		return Stats.GetLuck(State.GetStatsContext())
	end)
	local l = if ok and type(luck) == "number" then luck else 1
	local parts = {}
	for _, group in { "Size", "Material" } do
		for _, o in Finds.VariantOdds(group, l) do
			if o.Id ~= "Normal" and o.Id ~= "None" then
				local pct = o.Chance * 100
				table.insert(
					parts,
					o.Id .. " " .. (if pct >= 10 then string.format("%.0f", pct) else string.format("%.1f", pct)) .. "%"
				)
			end
		end
	end
	local text = "Find odds: " .. table.concat(parts, "  ")
	if l > 1.001 then
		text ..= string.format("  (luck x%.2g)", l)
	end
	return text
end

local function renderLayer()
	for _, child in grid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local layer = Config.Layers[selectedLayer]
	local have, total = found(selectedLayer)
	titleLabel.Text = layer.Name .. "  —  " .. have .. "/" .. total .. " found"
	titleLabel.TextColor3 = Color3.new(1, 1, 1):Lerp(layer.Color, 0.5)
	local reached = State.Data.MaxDepth >= layer.DepthStart
	local treasures: { Types.TreasureDef } = byLayer[selectedLayer] or EMPTY
	for i, treasure in treasures do
		local discovered = State.Data.Index[treasure.Id] == true
		local rarity = Config.GetRarity(treasure.Rarity)
		local card = Card.new({
			Name = treasure.Id,
			LayoutOrder = i,
			Gradient = if discovered and rarity then rarity.Gradient else { C.NavyCard, C.NavyDark },
			ZIndex = 6,
			Parent = grid,
		})
		local vp = Viewport.new({
			Size = UDim2.new(1, -16, 0, 96),
			Position = UDim2.fromOffset(8, 6),
			ZIndex = 8,
			Silhouette = not discovered,
			Pitch = 20,
			Parent = card.Face,
		})
		vp:SetModel(ModelFactory.Treasure(treasure.Id))
		Style.Label({
			Text = if discovered then treasure.Name else "???",
			Size = UDim2.new(1, -10, 0, 24),
			Position = UDim2.fromOffset(5, 104),
			MaxTextSize = 17,
			ZIndex = 8,
			Parent = card.Face,
		})
		local held = IndexPanel.Held(treasure.Id)
		Style.Label({
			Text = if discovered
				then treasure.Rarity .. (if held > 0 then "  ·  x" .. held else "")
				elseif reached then treasure.Rarity .. " · keep digging!"
				else "Reach " .. Format.Depth(layer.DepthStart),
			Size = UDim2.new(1, -10, 0, 18),
			Position = UDim2.fromOffset(5, 128),
			Font = Style.Fonts.Body,
			MaxTextSize = 13,
			ZIndex = 8,
			Parent = card.Face,
		})
		if discovered then
			local pills = Instance.new("Frame")
			pills.Name = "Variants"
			pills.BackgroundTransparency = 1
			pills.Size = UDim2.new(1, -10, 0, 34)
			pills.Position = UDim2.fromOffset(5, 166)
			pills.ZIndex = 8
			pills.Parent = card.Face
			local pillGrid = Instance.new("UIGridLayout")
			pillGrid.CellSize = UDim2.fromOffset(32, 15)
			pillGrid.CellPadding = UDim2.fromOffset(3, 3)
			pillGrid.SortOrder = Enum.SortOrder.LayoutOrder
			pillGrid.Parent = pills
			for j, pill in IndexPanel.VariantPills(treasure.Id) do
				local label = Style.Label({
					Name = pill.Id,
					Text = pill.Short,
					Size = UDim2.fromOffset(32, 15),
					Font = Style.Fonts.Body,
					TextColor = if pill.Found then C.TextDark else Color3.fromRGB(140, 150, 170),
					Stroke = false,
					MaxTextSize = 11,
					ZIndex = 9,
					Parent = pills,
				})
				label.LayoutOrder = j
				label.BackgroundTransparency = 0
				label.BackgroundColor3 = if pill.Found then pill.Color else C.NavyDark
				label:SetAttribute("Found", pill.Found)
				Style.Corner(label, Style.Theme.CornerPill)
			end
			Style.Label({
				Text = Format.Abbreviate(treasure.SellValue) .. " coins",
				Size = UDim2.new(1, -10, 0, 18),
				Position = UDim2.fromOffset(5, 146),
				Font = Style.Fonts.Number,
				TextColor = C.Money,
				MaxTextSize = 14,
				ZIndex = 8,
				Parent = card.Face,
			})
		end
	end
	for i, button in layerButtons do
		button:SetColor(if i == selectedLayer then C.Sunset else C.NavyCard)
	end
end

local function refresh()
	if not built then
		return
	end
	local completed = Config.CountCompletedIndexLayers(State.Data.Index)
	oddsLabel.Text = IndexPanel.OddsText()
	bonusLabel.Text = "Collection bonus: +"
		.. math.floor(completed * Config.INDEX_LAYER_BONUS * 100 + 0.5)
		.. "% sand  ("
		.. completed
		.. "/"
		.. #Config.Layers
		.. " layers complete, +"
		.. math.floor(Config.INDEX_LAYER_BONUS * 100 + 0.5)
		.. "% each)"
	for i, button in layerButtons do
		local layer = Config.Layers[i]
		local have, total = found(i)
		local reached = State.Data.MaxDepth >= layer.DepthStart
		button:SetIcon(
			if have == total and total > 0 then "Check" elseif reached then "Layers." .. layer.Id else "Lock"
		)
		button:SetText(layer.Name .. " " .. have .. "/" .. total)
	end
	renderLayer()
end

local function build()
	if built then
		return
	end
	built = true
	local body = panel.Body
	local list = Panel.Scroller(body, UDim2.new(0, 230, 1, 0))
	Style.List(list, Enum.FillDirection.Vertical, 6)
	for i, layer in Config.Layers do
		layerButtons[i] = Button.new({
			Text = layer.Name,
			Icon = "Layers." .. layer.Id,
			Size = UDim2.new(1, -14, 0, 56),
			Color = C.NavyCard,
			MaxTextSize = 16,
			LayoutOrder = i,
			ZIndex = 6,
			Parent = list,
			OnClick = function()
				selectedLayer = i
				renderLayer()
			end,
		})
	end
	titleLabel = Style.Label({
		Text = "",
		Size = UDim2.new(1, -244, 0, 30),
		Position = UDim2.fromOffset(244, 0),
		StrokeThickness = 2,
		MaxTextSize = 26,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = body,
	})
	bonusLabel = Style.Label({
		Text = "",
		Size = UDim2.new(1, -244, 0, 22),
		Position = UDim2.fromOffset(244, 32),
		TextColor = C.Palm,
		Font = Style.Fonts.Body,
		StrokeThickness = 2,
		MaxTextSize = 16,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = body,
	})
	oddsLabel = Style.Label({
		Name = "Odds",
		Text = "",
		Size = UDim2.new(1, -244, 0, 18),
		Position = UDim2.fromOffset(244, 56),
		TextColor = C.Sky,
		Font = Style.Fonts.Body,
		StrokeThickness = 2,
		MaxTextSize = 14,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = body,
	})
	grid = Panel.Scroller(body, UDim2.new(1, -244, 1, -80), UDim2.fromOffset(244, 80))
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(150, 204)
	layout.CellPadding = UDim2.fromOffset(10, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
end

function IndexPanel.Init()
	panel = Panel.new({
		Name = "Index",
		Title = "Treasure Index",
		Icon = Icons.Index,
		Color = C.Ocean,
		Size = Vector2.new(800, 480),
	})
	panel.Opened:Connect(function()
		build()
		selectedLayer = Config.GetLayerIndexAtDepth(State.Data.MaxDepth)
		refresh()
	end)
	State.ObserveMany({ "Index", "Treasures", "Finds", "FindVariants", "MaxDepth", "Passes", "Boosts" }, function()
		if built and panel.IsOpen then
			refresh()
		end
	end)
end

return IndexPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="151">
              <Properties>
                <string name="Name">PetsPanel</string>
                <string name="Source"><![CDATA[--!strict
--[[
	PetsPanel — pet inventory: grid of pet tiles (emoji on rarity gradient, bonus, ✅ when
	equipped), sorted by multiplier (or rarity), header with "Equipped 2/3" + total pet bonus,
	"Equip Best" and sort toggle. Selecting a pet shows a spinning 3D preview with
	Equip/Unequip and Delete (tap twice to confirm).
	v2.1: digging pets show a ⛏ badge (top-left of the tile) and their dig stats in the detail
	("⛏ digs to Pirate Cove · every 3.0s · x2.25 sand"); rideable pets a 🚜 "Rideable" badge (the
	Ride agent adds the actual ride button). Vehicle pets use vehicle icons.
	v2.2 DUPLICATE FUSION: selecting a pet with >= Config.GOLDEN_FUSE_COUNT (5) identical non-golden
	copies enables "Fuse 5 -> Golden" (remote FusePets(uid), validated by PetService). Golden pets
	(PetInstance.Golden) get a gold outline + "GOLDEN" tag, a gold-tinted sparkling preview
	(ModelFactory.MakeGolden), x1.5 sand bonus and 1.25x dig speed in their stats.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Components = script.Parent.Parent.Components
local Style = require(Components.Style)
local Panel = require(Components.Panel)
local Button = require(Components.Button)
local Card = require(Components.Card)
local AtlasIcon = require(Components.AtlasIcon)
local Viewport = require(Components.Viewport)
local Icons = require(script.Parent.Parent.Icons)
local Toasts = require(script.Parent.Parent.Toasts)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local ModelFactory = require(script.Parent.Parent.Parent.Util.ModelFactory)

local PetsPanel = {}

local C = Style.Colors

type Entry = { Uid: string, Pet: Types.PetInstance, Def: Types.PetDef, Order: number, Mult: number }

local panel: Panel.Panel
local built = false
local sortMode: "Bonus" | "Rarity" = "Bonus"
local selectedUid: string? = nil
local confirmDelete = false

local grid: ScrollingFrame
local equippedLabel: TextLabel
local bonusLabel: TextLabel
local sortButton: Button.Button
local view: Viewport.Viewport
local nameLabel: TextLabel
local infoLabel: TextLabel
local digLabel: TextLabel
local equipButton: Button.Button
local deleteButton: Button.Button
local fuseButton: Button.Button
local emptyLabel: TextLabel
local shownModelFor: string? = nil

-- v2.2: this pet's own multiplier, Golden included.
local function multOf(pet: Types.PetInstance): number
	return Config.PetEffectiveMultiplier(pet.Id, pet.Golden == true)
end

-- Non-golden copies of petId in the inventory (the fusion count).
local function copiesOf(petId: string): number
	local n = 0
	for _, pet in State.Data.Pets or {} :: { [string]: Types.PetInstance } do
		if pet.Id == petId and pet.Golden ~= true then
			n += 1
		end
	end
	return n
end

local function petIcon(def: Types.PetDef): string
	return if def.VehicleKind then "VehicleKinds." .. def.VehicleKind else "PetShapes." .. def.Look.Shape
end

local function rarityOrder(def: Types.PetDef): number
	local rarity = Config.GetRarity(def.Rarity)
	return if rarity then rarity.Order else 0
end

-- "⛏ digs to Pirate Cove · every 3.0s · x2.25 sand" (nil for pets that don't dig)
local function digInfo(def: Types.PetDef, golden: boolean?): string?
	local dig = def.Dig
	if not dig then
		return nil
	end
	assert(dig) -- refine for the type checker (guarded above)
	local layer = Config.Layers[Config.GetMaxLayerIndexForPower(dig.Power)]
	local interval = Config.GetPetDigInterval(def.Id, golden) or dig.Interval
	return string.format("digs to %s · every %.1fs · x%g sand", layer.Name, interval, dig.SandMultiplier)
end

local function entries(): { Entry }
	local list: { Entry } = {}
	for uid, pet in State.Data.Pets or {} :: { [string]: Types.PetInstance } do
		local def = Config.GetPet(pet.Id)
		if def then
			table.insert(list, { Uid = uid, Pet = pet, Def = def, Order = 0, Mult = multOf(pet) })
		end
	end
	table.sort(list, function(a: Entry, b: Entry): boolean
		if a.Pet.Equipped ~= b.Pet.Equipped then
			return a.Pet.Equipped
		end
		if sortMode == "Rarity" and a.Def.Rarity ~= b.Def.Rarity then
			return rarityOrder(a.Def) > rarityOrder(b.Def)
		end
		if a.Mult ~= b.Mult then
			return a.Mult > b.Mult
		end
		if a.Def.Id ~= b.Def.Id then
			return a.Def.Id < b.Def.Id
		end
		return a.Uid < b.Uid
	end)
	return list
end

local function equipBest()
	local list = entries()
	table.sort(list, function(a: Entry, b: Entry): boolean
		return a.Mult > b.Mult
	end)
	local slots = State.GetPetSlots()
	local best: { [string]: boolean } = {}
	for i = 1, math.min(slots, #list) do
		best[list[i].Uid] = true
	end
	local changed = false
	for _, entry in list do
		if entry.Pet.Equipped and not best[entry.Uid] then
			Remotes.Get("UnequipPet"):FireServer(entry.Uid)
			changed = true
		end
	end
	for _, entry in list do
		if best[entry.Uid] and not entry.Pet.Equipped then
			Remotes.Get("EquipPet"):FireServer(entry.Uid)
			changed = true
		end
	end
	if not changed then
		Toasts.Show("Your best pets are already equipped! 🐾", "Info")
	end
end

local function refreshDetail()
	local uid = selectedUid
	local pet = if uid then State.Data.Pets[uid] else nil
	local def = if pet then Config.GetPet(pet.Id) else nil
	if not uid or not pet or not def then
		view:SetModel(nil)
		shownModelFor = nil
		nameLabel.Text = "Pick a pet!"
		infoLabel.Text = "Tap a pet to see it here."
		digLabel.Text = ""
		equipButton:SetVisible(false)
		deleteButton:SetVisible(false)
		fuseButton:SetVisible(false)
		return
	end
	local p = pet :: Types.PetInstance
	local d = def :: Types.PetDef
	local golden = p.Golden == true
	if shownModelFor ~= uid then
		shownModelFor = uid
		local model = ModelFactory.Pet(d.Id)
		view:SetModel(if golden then ModelFactory.MakeGolden(model) else model)
		Style.Pop(view.Frame, 0.15)
	end
	local rarity = Config.GetRarity(d.Rarity)
	nameLabel.Text = (if golden then "Golden " else "") .. d.Name
	nameLabel.TextColor3 = if golden then C.Gold elseif rarity then rarity.Color else C.Text
	infoLabel.Text = d.Rarity
		.. "  ·  x"
		.. string.format("%.2f", multOf(p))
		.. " sand"
		.. (if d.Rideable then "  ·  Rideable!" else "")
	digLabel.Text = digInfo(d, golden) or ""
	-- v2.2 fusion: N identical non-golden copies -> one Golden pet
	fuseButton:SetVisible(not golden)
	if not golden then
		local copies = copiesOf(d.Id)
		local need = Config.GOLDEN_FUSE_COUNT
		fuseButton:SetEnabled(copies >= need)
		fuseButton:SetText(
			if copies >= need
				then string.format("Fuse %d → Golden", need)
				else string.format("Golden: %d/%d copies", copies, need)
		)
	end
	equipButton:SetVisible(true)
	deleteButton:SetVisible(true)
	if p.Equipped then
		equipButton:SetText("Unequip")
		equipButton:SetColor(C.Warning)
		equipButton:SetEnabled(true)
	else
		equipButton:SetText("Equip")
		equipButton:SetColor(C.Success)
		equipButton:SetEnabled(#State.GetEquippedPetIds() < State.GetPetSlots())
		if not equipButton.Enabled then
			equipButton:SetText("Slots full")
		end
	end
	deleteButton:SetText(if confirmDelete then "Sure? 🗑️" else "Delete")
	deleteButton:SetEnabled(not p.Equipped)
end

local function refreshGrid()
	if not built then
		return
	end
	for _, child in grid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local list = entries()
	emptyLabel.Visible = #list == 0
	for i, entry in list do
		local rarity = Config.GetRarity(entry.Def.Rarity)
		local card = Card.new({
			Name = entry.Uid,
			LayoutOrder = i,
			Gradient = if rarity then rarity.Gradient else nil,
			ZIndex = 6,
			Parent = grid,
		})
		if entry.Uid == selectedUid then
			card:SetHighlight(C.Gold)
		elseif entry.Pet.Golden then
			card.Stroke.Color = C.Gold
		end
		if entry.Pet.Golden then
			local tag = Style.Label({
				Name = "GoldenTag",
				Text = "GOLDEN",
				Size = UDim2.new(1, -8, 0, 16),
				Position = UDim2.new(0.5, 0, 0.62, 0),
				AnchorPoint = Vector2.new(0.5, 1),
				TextColor = C.Gold,
				StrokeThickness = 2,
				MaxTextSize = 14,
				ZIndex = 9,
				Parent = card.Face,
			})
			tag.Rotation = -6
		end
		AtlasIcon.new({
			Icon = petIcon(entry.Def),
			Size = UDim2.new(1, -10, 0.6, 0),
			Position = UDim2.new(0.5, 0, 0, 4),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 8,
			Parent = card.Face,
		})
		Style.Label({
			Text = "x" .. string.format("%.2f", entry.Mult),
			Size = UDim2.new(1, -8, 0.3, 0),
			Position = UDim2.new(0.5, 0, 1, -4),
			AnchorPoint = Vector2.new(0.5, 1),
			Font = Style.Fonts.Number,
			MaxTextSize = 17,
			ZIndex = 8,
			Parent = card.Face,
		})
		-- digging pet / rideable badges (atlas icons "Dig" / "Ride"), top-left
		if entry.Def.Dig or entry.Def.Rideable then
			local badges = Instance.new("Frame")
			badges.Name = "Badges"
			badges.BackgroundTransparency = 1
			badges.Size = UDim2.fromOffset(52, 26)
			badges.Position = UDim2.fromOffset(2, 2)
			badges.ZIndex = 9
			badges.Parent = card.Face
			Style.List(badges, Enum.FillDirection.Horizontal, 0, Enum.HorizontalAlignment.Left)
			local keys: { string } = {}
			if entry.Def.Dig then
				table.insert(keys, "Dig")
			end
			if entry.Def.Rideable then
				table.insert(keys, "Ride")
			end
			for i, key in keys do
				AtlasIcon.new({
					Icon = key,
					Size = UDim2.fromOffset(26, 26),
					LayoutOrder = i,
					ZIndex = 9,
					Parent = badges,
				})
			end
		end
		if entry.Pet.Equipped then
			AtlasIcon.new({
				Name = "Equipped",
				Icon = "Check",
				Size = UDim2.fromOffset(28, 28),
				Position = UDim2.new(1, -2, 0, 2),
				AnchorPoint = Vector2.new(1, 0),
				ZIndex = 9,
				Parent = card.Face,
			})
		end
		local hit = Instance.new("TextButton")
		hit.Name = "Face"
		hit.Text = ""
		hit.BackgroundTransparency = 1
		hit.Size = UDim2.fromScale(1, 1)
		hit.ZIndex = 10
		hit.Parent = card.Face
		hit.Activated:Connect(function()
			if selectedUid ~= entry.Uid then
				selectedUid = entry.Uid
				confirmDelete = false
				refreshGrid()
			end
		end)
	end
	local equipped = #State.GetEquippedPetIds()
	equippedLabel.Text = "Equipped "
		.. equipped
		.. "/"
		.. State.GetPetSlots()
		.. "   ·   "
		.. #list
		.. "/"
		.. Config.PET_INVENTORY_LIMIT
	bonusLabel.Text = "Bonus x" .. string.format("%.2f", State.GetPetMultiplier())
	if selectedUid and not State.Data.Pets[selectedUid :: string] then
		selectedUid = nil
	end
	if not selectedUid and list[1] then
		selectedUid = list[1].Uid
	end
	refreshDetail()
end

local function build()
	if built then
		return
	end
	built = true
	local body = panel.Body

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, 50)
	header.ZIndex = 5
	header.Parent = body
	equippedLabel = Style.Label({
		Text = "",
		Size = UDim2.new(0, 260, 0, 24),
		Position = UDim2.fromOffset(4, 0),
		StrokeThickness = 2,
		MaxTextSize = 20,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = header,
	})
	bonusLabel = Style.Label({
		Text = "",
		Size = UDim2.new(0, 260, 0, 22),
		Position = UDim2.fromOffset(4, 26),
		TextColor = C.Palm,
		Font = Style.Fonts.Number,
		StrokeThickness = 2,
		MaxTextSize = 18,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = header,
	})
	Button.new({
		Text = "Equip Best",
		Icon = Icons.Star,
		Size = UDim2.fromOffset(170, 48),
		Position = UDim2.new(1, -180, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		Color = C.Palm,
		MaxTextSize = 18,
		ZIndex = 6,
		Parent = header,
		OnClick = equipBest,
	})
	sortButton = Button.new({
		Text = "Sort: Bonus",
		Size = UDim2.fromOffset(170, 48),
		Position = UDim2.new(1, 0, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		Color = C.Ocean,
		MaxTextSize = 18,
		ZIndex = 6,
		Parent = header,
		OnClick = function()
			sortMode = if sortMode == "Bonus" then "Rarity" else "Bonus"
			sortButton:SetText("Sort: " .. sortMode)
			refreshGrid()
		end,
	})

	grid = Panel.Scroller(body, UDim2.new(1, -250, 1, -58), UDim2.fromOffset(0, 58))
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(94, 104)
	layout.CellPadding = UDim2.fromOffset(8, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	emptyLabel = Style.Label({
		Text = "No pets yet!\nHatch an egg!",
		Size = UDim2.new(1, -250, 0, 80),
		Position = UDim2.fromOffset(0, 120),
		TextColor = C.Sand,
		StrokeThickness = 2,
		Wrapped = true,
		MaxTextSize = 26,
		ZIndex = 6,
		Parent = body,
	})

	local side = Card.new({
		Name = "Detail",
		Size = UDim2.new(0, 236, 1, -58),
		Position = UDim2.new(1, 0, 0, 58),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 5,
		Parent = body,
	})
	local stage = Instance.new("Frame")
	stage.Size = UDim2.new(1, -20, 0, 110)
	stage.Position = UDim2.fromOffset(10, 10)
	stage.ZIndex = 7
	stage.Parent = side.Face
	Style.Corner(stage, Style.Theme.CornerMedium)
	Style.Stroke(stage, C.Stroke, 3)
	stage.BackgroundColor3 = Color3.new(1, 1, 1)
	Style.Gradient(stage, { C.Sky, C.Ocean }, 90)
	view = Viewport.new({ Size = UDim2.fromScale(1, 1), Spin = true, ZIndex = 8, Pitch = 12, Parent = stage })
	nameLabel = Style.Label({
		Text = "",
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.fromOffset(8, 124),
		MaxTextSize = 24,
		ZIndex = 7,
		Parent = side.Face,
	})
	infoLabel = Style.Label({
		Text = "",
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.fromOffset(8, 154),
		Font = Style.Fonts.Body,
		StrokeThickness = 2,
		MaxTextSize = 16,
		ZIndex = 7,
		Parent = side.Face,
	})
	digLabel = Style.Label({
		Text = "",
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.fromOffset(8, 176),
		TextColor = C.Sand,
		Font = Style.Fonts.Body,
		StrokeThickness = 2,
		MaxTextSize = 14,
		ZIndex = 7,
		Parent = side.Face,
	})
	digLabel.Name = "DigInfo"
	fuseButton = Button.new({
		Name = "Fuse",
		Text = "Fuse",
		Size = UDim2.new(1, -20, 0, 46),
		Position = UDim2.fromOffset(10, 200),
		MaxTextSize = 18,
		Color = C.Gold,
		ZIndex = 7,
		Parent = side.Face,
		OnClick = function()
			local uid = selectedUid
			local pet = if uid then State.Data.Pets[uid] else nil
			if uid and pet and pet.Golden ~= true and copiesOf(pet.Id) >= Config.GOLDEN_FUSE_COUNT then
				Remotes.Get("FusePets"):FireServer(uid)
			end
		end,
	})
	equipButton = Button.new({
		Text = "Equip",
		Size = UDim2.new(0.5, -14, 0, 76),
		Position = UDim2.new(0, 10, 1, -10),
		AnchorPoint = Vector2.new(0, 1),
		MaxTextSize = 22,
		Color = C.Success,
		ZIndex = 7,
		Parent = side.Face,
		OnClick = function()
			local uid = selectedUid
			local pet = if uid then State.Data.Pets[uid] else nil
			if uid and pet then
				Remotes.Get(if pet.Equipped then "UnequipPet" else "EquipPet"):FireServer(uid)
			end
		end,
	})
	deleteButton = Button.new({
		Text = "Delete",
		Size = UDim2.new(0.5, -14, 0, 76),
		Position = UDim2.new(1, -10, 1, -10),
		AnchorPoint = Vector2.new(1, 1),
		Color = C.Danger,
		MaxTextSize = 20,
		ZIndex = 7,
		Parent = side.Face,
		OnClick = function()
			local uid = selectedUid
			if not uid then
				return
			end
			if not confirmDelete then
				confirmDelete = true
				refreshDetail()
				task.delay(3, function()
					if confirmDelete and selectedUid == uid then
						confirmDelete = false
						refreshDetail()
					end
				end)
				return
			end
			confirmDelete = false
			Remotes.Get("DeletePet"):FireServer(uid)
		end,
	})
end

function PetsPanel.Init()
	panel =
		Panel.new({ Name = "Pets", Title = "Pets", Icon = Icons.Pets, Color = C.Coral, Size = Vector2.new(800, 480) })
	panel.Opened:Connect(function()
		build()
		refreshGrid()
	end)
	State.ObserveMany({ "Pets", "PetSlots", "Passes" }, function()
		if built and panel.IsOpen then
			refreshGrid()
		end
	end)
end

return PetsPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="152">
              <Properties>
                <string name="Name">QuestsPanel</string>
                <string name="Source"><![CDATA[--!strict
-- QuestsPanel — daily quests (with reset countdown) and milestones: progress bars, rewards,
-- big green Claim buttons; claimed quests sink to the bottom with a tick.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Components = script.Parent.Parent.Components
local Style = require(Components.Style)
local Panel = require(Components.Panel)
local Button = require(Components.Button)
local Card = require(Components.Card)
local ProgressBar = require(Components.ProgressBar)
local AtlasIcon = require(Components.AtlasIcon)
local Icons = require(script.Parent.Parent.Icons)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local Progress = require(script.Parent.Parent.Parent.Util.Progress)
local RewardText = require(script.Parent.Parent.Parent.Util.RewardText)

local QuestsPanel = {}

local C = Style.Colors

type Row = {
	Quest: Types.QuestDef,
	Card: Card.Card,
	Bar: ProgressBar.ProgressBar,
	Reward: TextLabel,
	Claim: Button.Button,
}

local panel: Panel.Panel
local built = false
local rows: { Row } = {}
local resetLabel: TextLabel

local function progressText(quest: Types.QuestDef, value: number): string
	if quest.Kind == "ReachDepth" then
		return Format.Depth(value) .. " / " .. Format.Depth(quest.Target)
	elseif quest.Kind == "PlayMinutes" then
		return math.floor(value) .. " / " .. quest.Target .. " min"
	end
	return Format.Abbreviate(value) .. " / " .. Format.Abbreviate(quest.Target)
end

local function refresh()
	if not built then
		return
	end
	local data = State.Data
	for _, row in rows do
		local quest = row.Quest
		local value, claimed = Progress.Quest(quest, data)
		local done = value >= quest.Target
		row.Bar:Set(value / quest.Target, if claimed then "Done!" else progressText(quest, value))
		row.Bar:SetColor(if done then C.Success else C.Ocean)
		row.Reward.Text = RewardText.Describe(quest.Reward, data.MaxDepth)
		if claimed then
			row.Claim:SetEnabled(false)
			row.Claim:SetText("Done!")
		elseif done then
			row.Claim:SetEnabled(true)
			row.Claim:SetText("Claim!")
		else
			row.Claim:SetEnabled(false)
			row.Claim:SetText(math.floor(value / quest.Target * 100) .. "%")
		end
		local base = if quest.Reset == "Daily" then 0 else 100
		row.Card.Holder.LayoutOrder = base
			+ (if claimed then 50 elseif done then -50 else 0)
			+ (table.find(Config.Quests, quest) or 0)
		row.Card:SetHighlight(if done and not claimed then C.Gold else nil)
	end
end

local function build()
	if built then
		return
	end
	built = true
	local body = panel.Body
	resetLabel = Style.Label({
		Text = "",
		Size = UDim2.new(1, 0, 0, 24),
		Font = Style.Fonts.Body,
		StrokeThickness = 2,
		MaxTextSize = 17,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = body,
	})
	local list = Panel.Scroller(body, UDim2.new(1, 0, 1, -30), UDim2.fromOffset(0, 30))
	Style.List(list, Enum.FillDirection.Vertical, 8)
	for i, quest in Config.Quests do
		local card = Card.new({
			Name = quest.Id,
			Size = UDim2.new(1, -16, 0, 86),
			LayoutOrder = i,
			Color = if quest.Reset == "Daily" then C.NavyCard else Style.Darken(C.Purple, 0.55),
			ZIndex = 6,
			Parent = list,
		})
		Style.Label({
			Text = quest.Name,
			Size = UDim2.new(0.5, -36, 0, 26),
			Position = UDim2.fromOffset(44, 6),
			StrokeThickness = 2,
			MaxTextSize = 21,
			XAlign = Enum.TextXAlignment.Left,
			ZIndex = 8,
			Parent = card.Face,
		})
		Style.Label({
			Text = quest.Description,
			Size = UDim2.new(0.5, -150, 0, 22),
			Position = UDim2.new(0.5, 0, 0, 8),
			Font = Style.Fonts.Body,
			StrokeThickness = 2,
			MaxTextSize = 15,
			XAlign = Enum.TextXAlignment.Left,
			ZIndex = 8,
			Parent = card.Face,
		})
		AtlasIcon.new({
			Icon = if quest.Reset == "Daily" then "Quests" else "trophy",
			Size = UDim2.fromOffset(32, 32),
			Position = UDim2.fromOffset(8, 3),
			AnchorPoint = Vector2.zero,
			ZIndex = 8,
			Parent = card.Face,
		})
		local bar = ProgressBar.new({
			Size = UDim2.new(0.55, 0, 0, 28),
			Position = UDim2.fromOffset(12, 40),
			MaxTextSize = 16,
			ZIndex = 8,
			Parent = card.Face,
		})
		local reward = Style.Label({
			Text = "",
			Size = UDim2.new(0.45, -150, 0, 36),
			Position = UDim2.new(0.55, 22, 0, 36),
			TextColor = C.Sand,
			Font = Style.Fonts.Title,
			StrokeThickness = 2,
			Wrapped = true,
			MaxTextSize = 16,
			XAlign = Enum.TextXAlignment.Left,
			ZIndex = 8,
			Parent = card.Face,
		})
		local claim = Button.new({
			Text = "Claim!",
			Size = UDim2.fromOffset(130, 76),
			Position = UDim2.new(1, -10, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Color = C.Success,
			MaxTextSize = 20,
			ZIndex = 8,
			Sound = "Purchase",
			Parent = card.Face,
			OnClick = function()
				Remotes.Get("ClaimQuest"):FireServer(quest.Id)
			end,
		})
		table.insert(rows, { Quest = quest, Card = card, Bar = bar, Reward = reward, Claim = claim })
	end
end

function QuestsPanel.Init()
	panel = Panel.new({
		Name = "Quests",
		Title = "Quests",
		Icon = Icons.Quests,
		Color = C.Sunset,
		Size = Vector2.new(800, 480),
	})
	panel.Opened:Connect(function()
		build()
		refresh()
	end)
	State.ObserveMany({ "Quests", "MaxDepth", "Rebirths" }, function()
		if built and panel.IsOpen then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			if built and panel.IsOpen then
				resetLabel.Text = "Daily quests reset in " .. Format.Time(Progress.SecondsToDailyReset())
			end
			task.wait(1)
		end
	end)
end

return QuestsPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="153">
              <Properties>
                <string name="Name">RebirthPanel</string>
                <string name="Source"><![CDATA[--!strict
--[[
	RebirthPanel — two tabs (docs/design/Rebirth.md):
	  Rebirth: multiplier now -> after, tokens gained, cost progress bar, the RECOVERY PREVIEW
	           ("With x1.5 you'll reach Crystal Caverns about 1.5x faster" + what your perks give
	           you at the start of the next run), what resets / what you keep, a Rebirth button
	           with a second-tap confirm, and the Skip Rebirth product.
	  Perks:   one UpgradeRow per Config.RebirthPerks entry: current level -> next level, and a
	           token price button (green affordable / grey not / MAX). Fires BuyRebirthPerk(id).
	Open with Panel.Open("Rebirth", { Tab = "Rebirth" | "Perks" }).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Components = script.Parent.Parent.Components
local Style = require(Components.Style)
local Panel = require(Components.Panel)
local Button = require(Components.Button)
local Card = require(Components.Card)
local ProgressBar = require(Components.ProgressBar)
local UpgradeRow = require(Components.UpgradeRow)
local AtlasIcon = require(Components.AtlasIcon)
local Icons = require(script.Parent.Parent.Icons)
local Banner = require(script.Parent.Parent.Banner)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local PurchaseController = require(script.Parent.Parent.Parent.Controllers.PurchaseController)

local RebirthPerksConfig = require(Shared:WaitForChild("Config"):WaitForChild("RebirthPerks"))
local Perks = Config.RebirthPerks

local RebirthPanel = {}

local C = Style.Colors
local TAB_H = 58

type Tab = string -- "Rebirth" | "Perks"

local panel: Panel.Panel
local built = false
local confirm = false
local currentTab: Tab = "Rebirth"
local tabs: { [Tab]: Button.Button } = {}
local pages: { [Tab]: GuiObject } = {}
local multLabel: TextLabel
local tokensLabel: TextLabel
local recoveryLabel: TextLabel
local perkNoteLabel: TextLabel
local bar: ProgressBar.ProgressBar
local rebirthButton: Button.Button
local skipButton: Button.Button
local walletLabel: TextLabel
local perkRows: { [string]: UpgradeRow.UpgradeRow } = {}

-- Pure helpers (also used by tests) ---------------------------------------------------------------

-- "With x1.5 you'll reach Crystal Caverns about 1.5x faster": income scales with the rebirth
-- multiplier (sand per dig; capacity grows with it too, so trips stay the same length).
function RebirthPanel.RecoveryText(rebirths: number, maxDepth: number): (string, number)
	local now = Config.RebirthMultiplier(rebirths)
	local after = Config.RebirthMultiplier(rebirths + 1)
	local ratio = after / now
	local layer = Config.GetLayerAtDepth(maxDepth)
	return string.format("With x%.1f you'll reach %s about %.1f× faster!", after, layer.Name, ratio), ratio
end

-- What the next run starts with, from the perks owned.
function RebirthPanel.PerkStartText(perks: { [string]: number }?): string
	local parts = {}
	local head = Perks.Effect(perks, "HeadStart")
	if head.ShovelIndex then
		local shovel = Config.Shovels[head.ShovelIndex]
		table.insert(parts, "start with a " .. shovel.Name .. " + " .. Format.Abbreviate(head.Coins or 0) .. " coins")
	end
	local keep = Perks.Effect(perks, "KeepBackpack").KeepIndex
	if keep then
		local last = Config.Backpacks[math.min(keep, #Config.Backpacks)]
		table.insert(
			parts,
			if keep >= #Config.Backpacks then "keep your backpack" else "keep backpacks up to " .. last.Name
		)
	end
	if #parts == 0 then
		return "Spend Rebirth Tokens on Perks to start every run stronger!"
	end
	return "Your perks: " .. table.concat(parts, ", ") .. "."
end

local function pct(factor: number): string
	return "+" .. math.floor((factor - 1) * 100 + 0.5) .. "%"
end

-- The stat box text for a perk at `level` (0 = not bought).
function RebirthPanel.PerkStat(id: string, level: number): UpgradeRow.Stat
	local def = Perks.Get(id)
	local none: RebirthPerksConfig.PerkLevel = {}
	local fx: RebirthPerksConfig.PerkLevel = if def and level > 0 then def.Levels[level] else none
	if id == "SellAnywhere" then
		return if fx.Unlocked
			then { Main = "Sell anywhere", Sub = "one tap" }
			else { Main = "Walk to sell", Sub = "sell stand" }
	elseif id == "HeadStart" then
		local shovel = Config.Shovels[fx.ShovelIndex or 1]
		return { Main = shovel.Name, Sub = "+" .. Format.Abbreviate(fx.Coins or 0) .. " coins" }
	elseif id == "KeepBackpack" then
		local keep = fx.KeepIndex or 0
		if keep <= 0 then
			return { Main = "Keep none", Sub = "back to Bucket" }
		elseif keep >= #Config.Backpacks then
			return { Main = "Keep any", Sub = "every backpack" }
		end
		return { Main = "Keep up to", Sub = Config.Backpacks[keep].Name }
	elseif id == "DeepPockets" then
		return { Main = "Holds " .. pct(fx.Capacity or 1), Sub = "backpack space" }
	elseif id == "LuckyDigger" then
		return { Main = "Treasure " .. pct(fx.TreasureChance or 1), Sub = "find chance" }
	elseif id == "LongNap" then
		local hours = Perks.OFFLINE_CAP_HOURS + (fx.OfflineHours or 0)
		local eff = Perks.OFFLINE_EFFICIENCY + (fx.OfflineEfficiency or 0)
		return { Main = hours .. "h away", Sub = math.floor(eff * 100 + 0.5) .. "% pet digging" }
	elseif id == "PetDen" then
		return { Main = "+" .. (fx.PetSlots or 0) .. " pet slots", Sub = "equip more pets" }
	elseif id == "GoldenTouch" then
		return { Main = "Coins " .. pct(fx.Coin or 1), Sub = "when you sell" }
	end
	return { Main = "Level " .. level }
end

-- Refresh -----------------------------------------------------------------------------------------

local function refreshPerks()
	local data = State.Data
	local tokens = data.RebirthTokens or 0
	walletLabel.Text = "Rebirth Tokens: " .. tokens .. "   ·   Perks last forever!"
	for _, def in Perks.List do
		local row = perkRows[def.Id]
		if row then
			local level = Perks.Level(data.RebirthPerks, def.Id)
			local maxLevel = #def.Costs
			local cost = Perks.NextCost(data.RebirthPerks, def.Id)
			local button = row.Button
			if cost then
				row:SetStats(RebirthPanel.PerkStat(def.Id, level), RebirthPanel.PerkStat(def.Id, level + 1))
				button:SetIcon("Tokens")
				button:SetText(tostring(cost))
				button:SetColor(C.Success)
				button:SetEnabled(tokens >= cost)
				row:SetTag(if maxLevel > 1 then "LV " .. level .. "/" .. maxLevel else nil, C.Purple)
				row.Card:SetHighlight(nil)
			else
				row:SetStats(nil, RebirthPanel.PerkStat(def.Id, level))
				button:SetIcon("Check")
				button:SetText("MAX")
				button:SetColor(C.Disabled)
				button:SetEnabled(false)
				row:SetTag("MAX", C.Gold)
				row.Card:SetHighlight(C.Gold)
			end
		end
	end
end

local function refresh()
	if not built then
		return
	end
	local data = State.Data
	local n = data.Rebirths
	local cost = Config.RebirthCost(n)
	multLabel.Text = string.format("x%.1f  ➜  x%.1f", Config.RebirthMultiplier(n), Config.RebirthMultiplier(n + 1))
	local tokens = Config.RebirthTokens(n)
	tokensLabel.Text =
		string.format("+%d Rebirth Token%s   ·   Rebirths: %d", tokens, if tokens == 1 then "" else "s", n)
	bar:Set(data.Coins / cost, Format.Abbreviate(data.Coins) .. " / " .. Format.Abbreviate(cost) .. " coins")
	bar:SetColor(if data.Coins >= cost then C.Success else C.Gold)
	recoveryLabel.Text = (RebirthPanel.RecoveryText(n, data.MaxDepth or 0))
	perkNoteLabel.Text = RebirthPanel.PerkStartText(data.RebirthPerks)
	local can = data.Coins >= cost
	rebirthButton:SetEnabled(can)
	rebirthButton:SetText(
		if not can
			then "Need " .. Format.Abbreviate(cost - data.Coins) .. " more"
			elseif confirm then "Tap again to REBIRTH!"
			else "Rebirth!"
	)
	skipButton:SetVisible(PurchaseController.IsProductConfigured("SkipRebirth"))
	skipButton:SetText("Skip R$ " .. PurchaseController.GetPrice("Product", "SkipRebirth"))
	refreshPerks()
	local perkBadge = false
	for _, def in Perks.List do
		local nextCost = Perks.NextCost(data.RebirthPerks, def.Id)
		if nextCost and (data.RebirthTokens or 0) >= nextCost then
			perkBadge = true
		end
	end
	tabs.Perks:SetBadge(if perkBadge then "!" else nil)
end

local function selectTab(tab: Tab)
	currentTab = tab
	for name, button in tabs do
		button:SetColor(if name == tab then C.Purple else C.NavyCard)
		pages[name].Visible = name == tab
	end
end

-- Build -------------------------------------------------------------------------------------------

local function listCard(parent: Instance, title: string, lines: string, color: Color3, x: number, y: number)
	local card = Card.new({
		Name = title,
		Size = UDim2.new(0.5, -8, 0, 96),
		Position = UDim2.new(x, if x > 0 then 8 else 0, 0, y),
		Color = Style.Darken(color, 0.35),
		ZIndex = 6,
		Parent = parent,
	})
	Style.Label({
		Text = title,
		Size = UDim2.new(1, -16, 0, 24),
		Position = UDim2.fromOffset(8, 4),
		MaxTextSize = 20,
		ZIndex = 8,
		Parent = card.Face,
	})
	Style.Label({
		Text = lines,
		Size = UDim2.new(1, -16, 1, -34),
		Position = UDim2.fromOffset(8, 30),
		Font = Style.Fonts.Body,
		Wrapped = true,
		MaxTextSize = 15,
		YAlign = Enum.TextYAlignment.Top,
		ZIndex = 8,
		Parent = card.Face,
	})
end

local function buildRebirthPage(page: Frame)
	multLabel = Style.Label({
		Name = "Multiplier",
		Text = "",
		Size = UDim2.new(1, 0, 0, 44),
		TextColor = C.Time,
		StrokeThickness = 3,
		MaxTextSize = 40,
		ZIndex = 6,
		Parent = page,
	})
	tokensLabel = Style.Label({
		Name = "Tokens",
		Text = "",
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 44),
		Font = Style.Fonts.Body,
		StrokeThickness = 2,
		MaxTextSize = 17,
		ZIndex = 6,
		Parent = page,
	})
	bar = ProgressBar.new({
		Size = UDim2.new(1, -40, 0, 30),
		Position = UDim2.new(0.5, 0, 0, 68),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = C.Gold,
		ZIndex = 6,
		Parent = page,
	})
	recoveryLabel = Style.Label({
		Name = "Recovery",
		Text = "",
		Size = UDim2.new(1, -20, 0, 26),
		Position = UDim2.new(0.5, 0, 0, 102),
		AnchorPoint = Vector2.new(0.5, 0),
		TextColor = C.Money,
		StrokeThickness = 2.5,
		MaxTextSize = 22,
		ZIndex = 6,
		Parent = page,
	})
	perkNoteLabel = Style.Label({
		Name = "PerkNote",
		Text = "",
		Size = UDim2.new(1, -20, 0, 20),
		Position = UDim2.new(0.5, 0, 0, 128),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Style.Fonts.Body,
		TextColor = C.Highlight,
		MaxTextSize = 16,
		ZIndex = 6,
		Parent = page,
	})
	listCard(
		page,
		"Resets",
		"Coins, sand, shovels, backpacks and unsold treasures. Your hole is refilled.",
		C.Coral,
		0,
		154
	)
	listCard(
		page,
		"You keep",
		"Pets, Index, depth record, quests, boosts, tokens, perks — and +"
			.. Config.Rebirths.MultiplierPerRebirth
			.. "x sand & backpack space FOREVER!",
		C.Palm,
		0.5,
		154
	)
	rebirthButton = Button.new({
		Name = "RebirthButton",
		Text = "Rebirth!",
		Icon = Icons.Rebirth,
		Size = UDim2.fromOffset(330, 74),
		Position = UDim2.new(0.5, -90, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		Color = C.Purple,
		MaxTextSize = 24,
		ZIndex = 6,
		Parent = page,
		OnClick = function()
			if not confirm then
				confirm = true
				refresh()
				task.delay(3, function()
					confirm = false
					refresh()
				end)
				return
			end
			confirm = false
			Remotes.Get("Rebirth"):FireServer()
		end,
	})
	skipButton = Button.new({
		Name = "Skip",
		Text = "Skip R$ " .. PurchaseController.GetPrice("Product", "SkipRebirth"),
		Size = UDim2.fromOffset(170, 74),
		Position = UDim2.new(1, -10, 1, -4),
		AnchorPoint = Vector2.new(1, 1),
		Color = C.Robux,
		MaxTextSize = 20,
		ZIndex = 6,
		Parent = page,
		OnClick = function()
			PurchaseController.PromptProduct("SkipRebirth")
		end,
	})
end

local function buildPerksPage(page: Frame)
	walletLabel = Style.Label({
		Name = "Wallet",
		Text = "",
		Size = UDim2.new(1, 0, 0, 26),
		TextColor = C.Tokens,
		StrokeThickness = 2.5,
		MaxTextSize = 22,
		ZIndex = 6,
		Parent = page,
	})
	local scroller = Panel.Scroller(page, UDim2.new(1, 0, 1, -32), UDim2.fromOffset(0, 32))
	scroller.Name = "PerkList"
	Style.List(scroller, Enum.FillDirection.Vertical, 10)
	for order, def in Perks.List do
		local id = def.Id
		local row = UpgradeRow.new({
			Name = id,
			Title = def.Name,
			LayoutOrder = order,
			Parent = scroller,
			StageColors = { C.Purple, Style.Darken(C.Purple, 0.4) },
			ActionWidth = 150,
			OnClick = function()
				Remotes.Get("BuyRebirthPerk"):FireServer(id)
			end,
		})
		local stage = row.Card.Face:FindFirstChild("Preview")
		if stage then
			AtlasIcon.new({
				Name = "PerkIcon",
				Icon = def.Icon,
				Size = UDim2.fromScale(0.78, 0.78),
				Position = UDim2.fromScale(0.5, 0.5),
				AnchorPoint = Vector2.new(0.5, 0.5),
				ZIndex = 5,
				Parent = stage,
			})
		end
		perkRows[id] = row
	end
end

local function build()
	if built then
		return
	end
	built = true
	local body = panel.Body
	local tabRow = Instance.new("Frame")
	tabRow.Name = "Tabs"
	tabRow.BackgroundTransparency = 1
	tabRow.Size = UDim2.new(1, 0, 0, TAB_H)
	tabRow.ZIndex = 5
	tabRow.Parent = body
	Style.List(tabRow, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left)
	for i, tab in { "Rebirth", "Perks" } do
		tabs[tab] = Button.new({
			Name = tab .. "Tab",
			Text = tab,
			Icon = if tab == "Rebirth" then "Rebirth" else "Tokens",
			Size = UDim2.fromOffset(200, 54),
			Color = C.NavyCard,
			LayoutOrder = i,
			ZIndex = 5,
			Parent = tabRow,
			OnClick = function()
				selectTab(tab)
			end,
		})
		local page = Instance.new("Frame")
		page.Name = tab .. "Page"
		page.BackgroundTransparency = 1
		page.Size = UDim2.new(1, 0, 1, -(TAB_H + 6))
		page.Position = UDim2.fromOffset(0, TAB_H + 6)
		page.ZIndex = 5
		page.Parent = body
		pages[tab] = page
		if tab == "Rebirth" then
			buildRebirthPage(page)
		else
			buildPerksPage(page)
		end
	end
	selectTab(currentTab)
end

function RebirthPanel.Init()
	panel = Panel.new({
		Name = "Rebirth",
		Title = "Rebirth",
		Icon = Icons.Rebirth,
		Color = C.Purple,
		Size = Vector2.new(780, 500),
	})
	panel.Opened:Connect(function(args: any)
		build()
		confirm = false
		if typeof(args) == "table" and (args.Tab == "Rebirth" or args.Tab == "Perks") then
			selectTab(args.Tab)
		end
		refresh()
	end)
	State.ObserveMany({ "Coins", "Rebirths", "RebirthTokens", "RebirthPerks", "MaxDepth" }, refresh)
	State.Changed("Rebirths"):Connect(function(new: any, old: any)
		if typeof(new) == "number" and typeof(old) == "number" and new > old then
			panel:Close()
			Banner.Show({
				Title = "REBIRTH " .. new .. "!",
				Icon = "Rebirth",
				Subtitle = string.format(
					"Everything is now x%.1f — spend your tokens on Perks!",
					Config.RebirthMultiplier(new)
				),
				Tag = "NEW MULTIPLIER",
				Color = C.Purple,
				Sound = "Rebirth",
				Confetti = true,
				Duration = 4,
			})
		end
	end)
	-- a perk level bought: little celebration
	State.Changed("RebirthPerks"):Connect(function(new: any, old: any)
		if typeof(new) ~= "table" or typeof(old) ~= "table" or not panel.IsOpen then
			return
		end
		for id, level in new do
			local row = perkRows[id]
			if row and typeof(level) == "number" and level > Perks.Level(old, id) then
				Style.Pop(row.Card.Holder, 0.08)
			end
		end
	end)
end

-- Tests / other panels.
function RebirthPanel.SelectTab(tab: Tab)
	if built and pages[tab] then
		selectTab(tab)
	end
end

function RebirthPanel.CurrentTab(): Tab
	return currentTab
end

return RebirthPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="154">
              <Properties>
                <string name="Name">SettingsPanel</string>
                <string name="Source"><![CDATA[--!strict
-- SettingsPanel — Music / SFX / Low graphics / Auto Dig toggles (SetSetting) and the Codes box
-- (RedeemCode). Toggles update locally at once; the server persists them in Settings.
-- v2.2 (Status & Social): "Nameplates" toggle (ShowNameplates, StatusController) and an
-- "Invite friends" card (SocialHUD.PromptInvite: Roblox invite dialog, no reward).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Components = script.Parent.Parent.Components
local Style = require(Components.Style)
local Panel = require(Components.Panel)
local Button = require(Components.Button)
local Card = require(Components.Card)
local AtlasIcon = require(Components.AtlasIcon)
local Icons = require(script.Parent.Parent.Icons)
local Toasts = require(script.Parent.Parent.Toasts)
local SocialHUD = require(script.Parent.Parent.SocialHUD)
local State = require(script.Parent.Parent.Parent.Controllers.State)

local SettingsPanel = {}

local C = Style.Colors

type Toggle = { Key: string, Default: boolean, Button: Button.Button, Row: Frame, NeedsPass: string? }

local TOGGLES = {
	{ Key = "Music", Label = "Music", Icon = "music", Default = true },
	{ Key = "SFX", Label = "Sound Effects", Icon = "sfx", Default = true },
	{ Key = "LowGraphics", Label = "Low Graphics", Icon = "settings|📱", Default = false },
	{ Key = "ReducedMotion", Label = "Reduced Motion", Icon = "settings", Default = false },
	{ Key = "ShowNameplates", Label = "Nameplates", Icon = "star", Default = true },
	{ Key = "AutoDig", Label = "Auto Dig", Icon = "AutoDig", Default = false, NeedsPass = "AutoDig" },
}

local panel: Panel.Panel
local built = false
local toggles: { Toggle } = {}
local codeBox: TextBox

local function refresh()
	if not built then
		return
	end
	for _, toggle in toggles do
		local on = State.GetSetting(toggle.Key, toggle.Default) == true
		toggle.Button:SetColor(if on then C.Success else C.Danger)
		toggle.Button:SetText(if on then "ON" else "OFF")
		if toggle.NeedsPass then
			local owns = State.OwnsPass(toggle.NeedsPass :: string)
			toggle.Row.Visible = owns
		end
	end
end

local function redeem()
	local code = string.gsub(codeBox.Text, "^%s+", "")
	code = string.gsub(code, "%s+$", "")
	if code == "" then
		Toasts.Show("Type a code first! 🎟️", "Info")
		return
	end
	Remotes.Get("RedeemCode"):FireServer(code)
	codeBox.Text = ""
end

local function build()
	if built then
		return
	end
	built = true
	local body = panel.Body
	local list = Panel.Scroller(body)
	Style.List(list, Enum.FillDirection.Vertical, 8)
	for i, def in TOGGLES do
		local card =
			Card.new({ Name = def.Key, Size = UDim2.new(1, -16, 0, 84), LayoutOrder = i, ZIndex = 6, Parent = list })
		AtlasIcon.new({
			Icon = def.Icon,
			Size = UDim2.fromOffset(52, 52),
			Position = UDim2.new(0, 10, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			ZIndex = 8,
			Parent = card.Face,
		})
		Style.Label({
			Text = def.Label,
			Size = UDim2.new(1, -230, 0.6, 0),
			Position = UDim2.new(0, 70, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			StrokeThickness = 2,
			MaxTextSize = 24,
			XAlign = Enum.TextXAlignment.Left,
			ZIndex = 8,
			Parent = card.Face,
		})
		local button = Button.new({
			Text = "ON",
			Size = UDim2.fromOffset(140, 74),
			Position = UDim2.new(1, -10, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Color = C.Success,
			ZIndex = 8,
			Parent = card.Face,
			OnClick = function()
				local on = State.GetSetting(def.Key, def.Default) == true
				State.SetSetting(def.Key, not on)
			end,
		})
		table.insert(
			toggles,
			{ Key = def.Key, Default = def.Default, Button = button, Row = card.Holder, NeedsPass = def.NeedsPass }
		)
	end

	local invite = Card.new({
		Name = "Invite",
		Size = UDim2.new(1, -16, 0, 84),
		LayoutOrder = 90,
		Color = C.NavyCardDark,
		ZIndex = 6,
		Parent = list,
	})
	AtlasIcon.new({
		Icon = "👫",
		Size = UDim2.fromOffset(52, 52),
		Position = UDim2.new(0, 10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 8,
		Parent = invite.Face,
	})
	Style.Label({
		Text = string.format(
			"Dig with friends: +%d%% sand each (up to +%d%%)!",
			math.floor(Config.FRIEND_BONUS_PER_FRIEND * 100 + 0.5),
			math.floor(Config.FRIEND_BONUS_MAX * 100 + 0.5)
		),
		Size = UDim2.new(1, -250, 0.7, 0),
		Position = UDim2.new(0, 70, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		StrokeThickness = 2,
		MaxTextSize = 22,
		Wrapped = true,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 8,
		Parent = invite.Face,
	})
	Button.new({
		Name = "InviteButton",
		Text = "Invite",
		Size = UDim2.fromOffset(160, 74),
		Position = UDim2.new(1, -10, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Color = C.Coral,
		ZIndex = 8,
		Parent = invite.Face,
		OnClick = function()
			SocialHUD.PromptInvite()
		end,
	})

	local codes = Card.new({
		Name = "Codes",
		Size = UDim2.new(1, -16, 0, 136),
		LayoutOrder = 100,
		Color = C.NavyCardDark,
		ZIndex = 6,
		Parent = list,
	})
	Style.Label({
		Text = "Codes",
		Size = UDim2.new(1, -70, 0, 30),
		Position = UDim2.fromOffset(56, 8),
		StrokeThickness = 2,
		MaxTextSize = 24,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 8,
		Parent = codes.Face,
	})
	AtlasIcon.new({
		Icon = "codes",
		Size = UDim2.fromOffset(38, 38),
		Position = UDim2.fromOffset(12, 4),
		AnchorPoint = Vector2.zero,
		ZIndex = 8,
		Parent = codes.Face,
	})
	codeBox = Instance.new("TextBox")
	codeBox.Name = "CodeBox"
	codeBox.PlaceholderText = "Enter code (try SANDY!)"
	codeBox.Text = ""
	codeBox.ClearTextOnFocus = false
	codeBox.Font = Style.Fonts.Title
	codeBox.TextScaled = true
	codeBox.TextColor3 = C.Text
	codeBox.PlaceholderColor3 = C.Disabled
	codeBox.BackgroundColor3 = C.NavyDark
	codeBox.Size = UDim2.new(1, -190, 0, 62)
	codeBox.Position = UDim2.fromOffset(14, 50)
	codeBox.ZIndex = 8
	codeBox.Parent = codes.Face
	Style.Corner(codeBox, Style.Theme.CornerMedium)
	Style.Stroke(codeBox, C.Stroke, 3)
	Style.Padding(codeBox, 8, 12)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 26
	constraint.Parent = codeBox
	codeBox.FocusLost:Connect(function(enterPressed: boolean)
		if enterPressed then
			redeem()
		end
	end)
	Button.new({
		Text = "Redeem",
		Size = UDim2.fromOffset(150, 76),
		Position = UDim2.new(1, -12, 0, 44),
		AnchorPoint = Vector2.new(1, 0),
		Color = C.Palm,
		ZIndex = 8,
		Parent = codes.Face,
		OnClick = redeem,
	})
end

function SettingsPanel.Init()
	panel = Panel.new({
		Name = "Settings",
		Title = "Settings",
		Icon = Icons.Settings,
		Color = C.OceanDark,
		Size = Vector2.new(620, 470),
	})
	panel.Opened:Connect(function()
		build()
		refresh()
	end)
	State.ObserveMany({ "Settings", "Passes" }, refresh)
end

return SettingsPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="155">
              <Properties>
                <string name="Name">ShopPanel</string>
                <string name="Source"><![CDATA[--!strict
--[[
	ShopPanel — Shovels & Backpacks tabs as UPGRADE ROWS (docs/UI_STYLE.md, UpgradeRow):
	  [3D model] name / tag  [ equipped stat ] ➜ [ this item's stat (orange) ]  [ price button ]
	e.g. "Dig 4×4 ➜ Dig 8×8" (+ the deepest layer it digs), "Holds 50 ➜ Holds 120".
	Button states: Equipped (grey) / Equip (blue) / <coins price> (green, affordable) /
	<coins price> (grey, can't afford) / Rebirth N (locked, row dimmed with a lock icon).
	The cheapest useful upgrade gets a "NEXT" tag (also used by the tutorial's shop step and the
	HUD Shop "!" badge via ShopPanel.NextUpgrade). Buying auto-equips the new item once the
	server confirms ownership; a new shovel gets the Reveal popup.
	Open with Panel.Open("Shop", { Tab = "Shovels" | "Backpacks" }).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Components = script.Parent.Parent.Components
local Style = require(Components.Style)
local Panel = require(Components.Panel)
local Button = require(Components.Button)
local UpgradeRow = require(Components.UpgradeRow)
local Icons = require(script.Parent.Parent.Icons)
local ItemStats = require(script.Parent.Parent.ItemStats)
local Reveal = require(script.Parent.Parent.Reveal)
local UIEffects = require(script.Parent.Parent.UIEffects)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local SoundController = require(script.Parent.Parent.Parent.Controllers.SoundController)
local ModelFactory = require(script.Parent.Parent.Parent.Util.ModelFactory)

local ShopPanel = {}

local C = Style.Colors

type Kind = string -- "Shovels" | "Backpacks"

type ItemCard = {
	Id: string,
	Kind: Kind,
	Row: UpgradeRow.UpgradeRow,
	Update: () -> (),
}

local panel: Panel.Panel
local tabs: { [Kind]: Button.Button } = {}
local scrollers: { [Kind]: ScrollingFrame } = {}
local cards: { ItemCard } = {}
local built = false
local currentTab: Kind = "Shovels"
local pendingEquip: { [string]: Kind } = {}
local revealShovel: (id: string, previous: string?) -> ()

local function shovelStat(def: Types.ShovelDef): UpgradeRow.Stat
	return {
		Main = "Dig " .. ItemStats.DigSize(def.Radius),
		Sub = ItemStats.DigsTo(def.Power) .. " · " .. ItemStats.SandMult(def.SandMultiplier) .. " sand",
	}
end

local function capacityOf(def: Types.BackpackDef): number
	local mega = if State.OwnsPass("MegaBackpack") then 2 else 1
	local pockets = Config.RebirthPerks.CapacityFactor(State.Data.RebirthPerks) -- v2.2 Deep Pockets
	return def.Capacity * Config.RebirthMultiplier(State.Data.Rebirths) * mega * pockets
end

local function backpackStat(def: Types.BackpackDef): UpgradeRow.Stat
	return { Main = "Holds " .. Format.Abbreviate(capacityOf(def)), Sub = "sand" }
end

-- Cheapest item (of a kind) that is not owned and not locked: the "next upgrade".
local function nextUpgrade(kind: Kind): string?
	local data = State.Data
	if kind == "Shovels" then
		local equipped = State.GetShovel()
		for _, def in Config.Shovels do
			if
				not data.OwnedShovels[def.Id]
				and def.RebirthsRequired <= data.Rebirths
				and def.Power >= equipped.Power
			then
				return def.Id
			end
		end
	else
		local equipped = State.GetBackpack()
		for _, def in Config.Backpacks do
			if
				not data.OwnedBackpacks[def.Id]
				and def.RebirthsRequired <= data.Rebirths
				and def.Capacity > equipped.Capacity
			then
				return def.Id
			end
		end
	end
	return nil
end

local function makeCard(kind: Kind, id: string, order: number, parent: Instance): ItemCard
	local isShovel = kind == "Shovels"
	local shovel = if isShovel then Config.GetShovel(id) else nil
	local backpack = if not isShovel then Config.GetBackpack(id) else nil
	local name = if shovel then shovel.Name elseif backpack then backpack.Name else id
	local price = if shovel then shovel.Price elseif backpack then backpack.Price else 0
	local rebirths = if shovel then shovel.RebirthsRequired elseif backpack then backpack.RebirthsRequired else 0

	local row = UpgradeRow.new({
		Name = id,
		Title = name,
		LayoutOrder = order,
		Parent = parent,
		-- shovels tilted diagonally so the long tool fills the square; packs from behind-right
		Model = if shovel then ModelFactory.Shovel(id) else ModelFactory.Backpack(id),
		Pitch = if shovel then 10 else 18,
		Yaw = if shovel then 15 else 205,
		Rotation = if shovel then CFrame.Angles(0, 0, math.rad(-50)) else nil,
		OnClick = function()
			local data = State.Data
			local owned = if isShovel then data.OwnedShovels[id] else data.OwnedBackpacks[id]
			if owned then
				Remotes.Get(if isShovel then "EquipShovel" else "EquipBackpack"):FireServer(id)
			else
				pendingEquip[id] = kind
				Remotes.Get(if isShovel then "BuyShovel" else "BuyBackpack"):FireServer(id)
			end
		end,
	})
	local button = row.Button

	return {
		Id = id,
		Kind = kind,
		Row = row,
		Update = function()
			local data = State.Data
			local owned = if isShovel then data.OwnedShovels[id] == true else data.OwnedBackpacks[id] == true
			local equipped = if isShovel then data.Shovel == id else data.Backpack == id
			local current: UpgradeRow.Stat?
			local mine: UpgradeRow.Stat
			if shovel then
				mine = shovelStat(shovel)
				current = if equipped then nil else shovelStat(State.GetShovel())
			elseif backpack then
				mine = backpackStat(backpack)
				current = if equipped then nil else backpackStat(State.GetBackpack())
			else
				mine = { Main = name }
			end
			row:SetStats(current, mine)
			local locked = not owned and data.Rebirths < rebirths
			row:SetLocked(locked)
			if equipped then
				button:SetEnabled(true)
				button:SetColor(C.Disabled)
				button:SetIcon("Check")
				button:SetText("Equipped")
			elseif owned then
				button:SetEnabled(true)
				button:SetColor(C.Ocean)
				button:SetIcon(if isShovel then "shovel" else "Backpack")
				button:SetText("Equip")
			elseif locked then
				button:SetEnabled(false)
				button:SetIcon("Lock")
				button:SetText("Rebirth " .. rebirths)
			else
				button:SetIcon("Coins")
				button:SetText(Format.Abbreviate(price))
				button:SetEnabled(data.Coins >= price)
				button:SetColor(C.Success)
			end
			row.Card:SetHighlight(if equipped then C.Gold else nil)
		end,
	}
end

local function refresh()
	if not built then
		return
	end
	local nextIds = { Shovels = nextUpgrade("Shovels"), Backpacks = nextUpgrade("Backpacks") }
	for _, item in cards do
		item.Update()
		local data = State.Data
		local equipped = if item.Kind == "Shovels" then data.Shovel == item.Id else data.Backpack == item.Id
		if nextIds[item.Kind] == item.Id then
			item.Row:SetTag("NEXT!", C.Coral)
		elseif equipped then
			item.Row:SetTag("EQUIPPED", C.Palm)
		else
			item.Row:SetTag(nil)
		end
	end
end

local function selectTab(kind: Kind)
	currentTab = kind
	for k, button in tabs do
		button:SetColor(if k == kind then C.Sunset else C.NavyCard)
		scrollers[k].Visible = k == kind
	end
end

local function build()
	if built then
		return
	end
	built = true
	local body = panel.Body
	local tabRow = Instance.new("Frame")
	tabRow.Name = "Tabs"
	tabRow.BackgroundTransparency = 1
	tabRow.Size = UDim2.new(1, 0, 0, 58)
	tabRow.ZIndex = 5
	tabRow.Parent = body
	Style.List(tabRow, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left)
	for i, kind in { "Shovels", "Backpacks" } do
		tabs[kind] = Button.new({
			Text = kind,
			Icon = if kind == "Shovels" then "shovel" else "Backpack",
			Size = UDim2.fromOffset(200, 56),
			Color = C.NavyCard,
			LayoutOrder = i,
			ZIndex = 5,
			Parent = tabRow,
			OnClick = function()
				selectTab(kind)
			end,
		})
		local scroller = Panel.Scroller(body, UDim2.new(1, 0, 1, -64), UDim2.fromOffset(0, 64))
		scroller.Name = kind
		Style.List(scroller, Enum.FillDirection.Vertical, 10)
		scrollers[kind] = scroller
		local list = if kind == "Shovels" then Config.Shovels else Config.Backpacks
		for order, def in list :: { any } do
			table.insert(cards, makeCard(kind, def.Id, order, scroller))
		end
	end
	selectTab(currentTab)
	refresh()
end

-- Scroll the active tab so the "next upgrade" card is visible.
local function scrollToNext()
	local id = nextUpgrade(currentTab)
	local scroller = scrollers[currentTab]
	if not id or not scroller then
		return
	end
	for _, item in cards do
		if item.Id == id and item.Kind == currentTab then
			task.defer(function()
				local offset = item.Row.Card.Holder.AbsolutePosition.Y
					- scroller.AbsolutePosition.Y
					+ scroller.CanvasPosition.Y
				scroller.CanvasPosition = Vector2.new(0, math.max(0, offset - 20))
				Style.Pop(item.Row.Card.Holder, 0.08)
			end)
		end
	end
end

-- New shovel: the shared Reveal popup with its dig stats and what it improves over `previous`.
revealShovel = function(id: string, previous: string?)
	local found = Config.GetShovel(id)
	if not found then
		return
	end
	local def = found :: Types.ShovelDef
	Reveal.Show({
		Headline = "NEW SHOVEL!",
		Caption = ItemStats.UpgradeSummary(if previous then Config.GetShovel(previous) else nil, def),
		Color = C.Gold,
		Items = {
			{
				Name = def.Name,
				NameColor = C.Gold,
				Model = ModelFactory.Shovel(id),
				Pitch = 10,
				Yaw = 15,
				Rotation = CFrame.Angles(0, 0, math.rad(-50)),
				Rows = {
					{ Label = "DIG SIZE", Value = ItemStats.DigSize(def.Radius), Color = C.Highlight },
					{ Label = "DIGS", Value = ItemStats.DigsTo(def.Power), Color = C.Time },
					{ Label = "SAND BONUS", Value = ItemStats.SandMult(def.SandMultiplier), Color = C.Money },
					{ Label = "SPEED", Value = ItemStats.Rate(def), Color = C.Time },
				},
			},
		},
		Sound = "",
		Confetti = true,
		Hold = 3.5,
	})
end

function ShopPanel.Init()
	panel = Panel.new({
		Name = "Shop",
		Title = "Shovel Shop",
		Icon = Icons.Shop,
		Color = C.Palm,
		Size = Vector2.new(800, 490),
	})
	panel.Opened:Connect(function(args: any)
		build()
		if typeof(args) == "table" and (args.Tab == "Shovels" or args.Tab == "Backpacks") then
			selectTab(args.Tab)
		end
		refresh()
		scrollToNext()
	end)
	State.ObserveMany(
		{ "Coins", "OwnedShovels", "OwnedBackpacks", "Shovel", "Backpack", "Rebirths", "Passes" },
		refresh
	)
	local function onOwned(kind: Kind)
		return function(owned: any, old: any)
			if typeof(owned) ~= "table" then
				return
			end
			for id, k in pendingEquip do
				if k == kind and owned[id] and not (typeof(old) == "table" and old[id]) then
					pendingEquip[id] = nil
					SoundController.Play("Purchase")
					if kind == "Shovels" then
						-- compare against the best shovel owned before this purchase (the server may
						-- already have auto-equipped the new one)
						local previous: string? = nil
						if typeof(old) == "table" then
							for ownedId in old do
								if
									previous == nil
									or ItemStats.ShovelTier(ownedId) > ItemStats.ShovelTier(previous)
								then
									previous = ownedId
								end
							end
						end
						revealShovel(id, previous)
					else
						UIEffects.Confetti(30)
					end
					local equipped = if kind == "Shovels" then State.Data.Shovel else State.Data.Backpack
					if equipped ~= id then
						Remotes.Get(if kind == "Shovels" then "EquipShovel" else "EquipBackpack"):FireServer(id)
					end
				end
			end
		end
	end
	State.Changed("OwnedShovels"):Connect(onOwned("Shovels"))
	State.Changed("OwnedBackpacks"):Connect(onOwned("Backpacks"))
end

ShopPanel.NextUpgrade = nextUpgrade

return ShopPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="156">
              <Properties>
                <string name="Name">StorePanel</string>
                <string name="Source"><![CDATA[--!strict
--[[
	StorePanel — Robux store from Config.Monetization. Tabs: Game Passes / Boosts & Coins.
	Items with Id 0 are shown greyed out as "Soon" (never prompted). Owned passes show ✅.
	Coin packs show the live amount for your deepest layer (Config.ResolveCoins).
	v2.3: prices come from PurchaseController.GetPrice (live Creator Hub price via GetProductInfo
	once an Id is set, else the config suggestion) and refresh when a live price arrives.
	v2.2 policy: items marked PaidRandom (coin packs, skip rebirth: currency that buys eggs) are
	hidden entirely while State.IsPaidRandomRestricted() (server PolicyService attribute). The grid
	re-flows, and an empty tab says so instead of showing a blank page. The Cooler Pack is gone.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Components = script.Parent.Parent.Components
local Style = require(Components.Style)
local Panel = require(Components.Panel)
local Button = require(Components.Button)
local Card = require(Components.Card)
local AtlasIcon = require(Components.AtlasIcon)
local Icons = require(script.Parent.Parent.Icons)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local PurchaseController = require(script.Parent.Parent.Parent.Controllers.PurchaseController)
local RewardText = require(script.Parent.Parent.Parent.Util.RewardText)

local StorePanel = {}

local C = Style.Colors

local PASS_ORDER =
	{ "DoubleSand", "VIP", "SellAnywhere", "AutoDig", "FastDig", "MegaBackpack", "ExtraPets", "TripleHatch" }
local PASS_ICONS: { [string]: string } = {
	VIP = "trophy|👑",
	DoubleSand = "boost_sand",
	SellAnywhere = "Sell",
	AutoDig = "AutoDig",
	FastDig = "boost_speed",
	TripleHatch = "egg_hatch",
	ExtraPets = "Pets",
	MegaBackpack = "Backpack",
}
local PRODUCT_ORDER = {
	"SandBoost15",
	"CoinsSmall",
	"CoinsMedium",
	"CoinsLarge",
	"CoinsHuge",
	"SkipRebirth",
}

type Item = { Key: string, IsPass: boolean, Button: Button.Button, Detail: TextLabel, Card: Card.Card }

local panel: Panel.Panel
local built = false
local items: { Item } = {}
local tabs: { [string]: Button.Button } = {}
local pages: { [string]: ScrollingFrame } = {}
local emptyNotes: { [string]: TextLabel } = {}

local function refresh()
	if not built then
		return
	end
	local shown: { [string]: number } = {}
	for _, item in items do
		local visible = State.CanBuy(if item.IsPass then "GamePass" else "Product", item.Key)
		item.Card.Holder.Visible = visible
		local page = if item.IsPass then "Passes" else "Boosts & Coins"
		shown[page] = (shown[page] or 0) + (if visible then 1 else 0)
		if not visible then
			continue
		end
		if item.IsPass then
			local pass = Config.Monetization.GamePasses[item.Key]
			if State.OwnsPass(item.Key) then
				item.Button:SetEnabled(true)
				item.Button:SetColor(C.Disabled)
				item.Button:SetText("Owned!")
			elseif pass.Id == 0 then
				item.Button:SetEnabled(false)
				item.Button:SetText("Soon")
			else
				item.Button:SetEnabled(true)
				item.Button:SetColor(C.Robux)
				item.Button:SetText("R$ " .. PurchaseController.GetPrice("GamePass", item.Key))
			end
		else
			local product = Config.Monetization.Products[item.Key]
			item.Detail.Text = product.Description .. "\n" .. RewardText.Describe(product.Grant, State.Data.MaxDepth)
			if product.Id == 0 then
				item.Button:SetEnabled(false)
				item.Button:SetText("Soon")
			else
				item.Button:SetEnabled(true)
				item.Button:SetText("R$ " .. PurchaseController.GetPrice("Product", item.Key))
			end
		end
	end
	for page, note in emptyNotes do
		note.Visible = (shown[page] or 0) == 0
	end
end

local function selectTab(name: string)
	for key, button in tabs do
		button:SetColor(if key == name then C.Sunset else C.NavyCard)
		pages[key].Visible = key == name
	end
end

local function makeItem(page: Instance, key: string, isPass: boolean, order: number)
	local name, description, color, icon
	if isPass then
		local pass = Config.Monetization.GamePasses[key]
		name, description, color, icon = pass.Name, pass.Description, pass.Color, PASS_ICONS[key] or "gem"
	else
		local product = Config.Monetization.Products[key]
		name, description = product.Name, product.Description
		local grant = product.Grant
		if grant.Boost then
			local boost = Config.GetBoost(grant.Boost)
			color = if boost then boost.Color else C.Ocean
			icon = if boost then "BoostKinds." .. boost.Kind else "boost_speed"
		elseif grant.Egg then
			color, icon = C.Gold, "Eggs"
		elseif grant.Rebirth then
			color, icon = C.Purple, "Rebirth"
		else
			color, icon = C.Coins, "Coins"
		end
	end
	local card = Card.new({
		Name = key,
		LayoutOrder = order,
		Gradient = { Style.Darken(color, 0.15), Style.Darken(color, 0.5) },
		ZIndex = 6,
		Parent = page,
	})
	AtlasIcon.new({
		Icon = icon,
		Size = UDim2.fromOffset(60, 60),
		Position = UDim2.fromOffset(6, 4),
		AnchorPoint = Vector2.zero,
		ZIndex = 8,
		Parent = card.Face,
	})
	Style.Label({
		Text = name,
		Size = UDim2.new(1, -76, 0, 30),
		Position = UDim2.fromOffset(68, 10),
		MaxTextSize = 22,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 8,
		Parent = card.Face,
	})
	local detail = Style.Label({
		Text = description,
		Size = UDim2.new(1, -16, 0, 58),
		Position = UDim2.fromOffset(8, 66),
		Font = Style.Fonts.Body,
		StrokeThickness = 2,
		Wrapped = true,
		MaxTextSize = 14,
		XAlign = Enum.TextXAlignment.Left,
		YAlign = Enum.TextYAlignment.Top,
		ZIndex = 8,
		Parent = card.Face,
	})
	local button = Button.new({
		Text = "R$",
		Size = UDim2.new(1, -16, 0, 60),
		Position = UDim2.new(0.5, 0, 1, -6),
		AnchorPoint = Vector2.new(0.5, 1),
		Color = C.Robux,
		MaxTextSize = 22,
		ZIndex = 8,
		Parent = card.Face,
		OnClick = function()
			if isPass then
				PurchaseController.PromptPass(key)
			else
				PurchaseController.PromptProduct(key)
			end
		end,
	})
	table.insert(items, { Key = key, IsPass = isPass, Button = button, Detail = detail, Card = card })
end

local function build()
	if built then
		return
	end
	built = true
	local body = panel.Body
	local tabRow = Instance.new("Frame")
	tabRow.BackgroundTransparency = 1
	tabRow.Size = UDim2.new(1, 0, 0, 50)
	tabRow.ZIndex = 5
	tabRow.Parent = body
	Style.List(tabRow, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left)
	for i, tab in { "Passes", "Boosts & Coins" } do
		tabs[tab] = Button.new({
			Text = tab,
			Size = UDim2.fromOffset(210, 56),
			Color = C.NavyCard,
			LayoutOrder = i,
			ZIndex = 5,
			Parent = tabRow,
			OnClick = function()
				selectTab(tab)
			end,
		})
		local page = Panel.Scroller(body, UDim2.new(1, 0, 1, -58), UDim2.fromOffset(0, 58))
		local grid = Instance.new("UIGridLayout")
		grid.CellSize = UDim2.fromOffset(235, 200)
		grid.CellPadding = UDim2.fromOffset(10, 10)
		grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
		grid.SortOrder = Enum.SortOrder.LayoutOrder
		grid.Parent = page
		pages[tab] = page
		local note = Style.Label({
			Text = "Nothing here right now. Dig, rebirth and finish quests to earn boosts!",
			Size = UDim2.new(1, -40, 0, 60),
			Position = UDim2.new(0.5, 0, 0, 120),
			AnchorPoint = Vector2.new(0.5, 0),
			TextColor = C.Sand,
			StrokeThickness = 2,
			Wrapped = true,
			MaxTextSize = 22,
			ZIndex = 6,
			Parent = page,
		})
		note.Name = "EmptyNote"
		note.Visible = false
		emptyNotes[tab] = note
	end
	for i, key in PASS_ORDER do
		if Config.Monetization.GamePasses[key] then
			makeItem(pages.Passes, key, true, i)
		end
	end
	for i, key in PRODUCT_ORDER do
		if Config.Monetization.Products[key] then
			makeItem(pages["Boosts & Coins"], key, false, i)
		end
	end
	selectTab("Passes")
end

function StorePanel.Init()
	panel = Panel.new({
		Name = "Store",
		Title = "Store",
		Icon = Icons.Store,
		Color = C.Robux,
		Size = Vector2.new(800, 480),
	})
	panel.Opened:Connect(function(args: any)
		build()
		if typeof(args) == "table" and typeof(args.Tab) == "string" and pages[args.Tab] then
			selectTab(args.Tab)
		end
		refresh()
	end)
	State.ObserveMany({ "Passes", "MaxDepth", "PaidRandomRestricted" }, refresh)
	PurchaseController.PriceChanged:Connect(refresh)
end

return StorePanel
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="157">
            <Properties>
              <string name="Name">Reveal</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Reveal — the one "you got something!" popup (docs/UI_STYLE.md) for egg/crate hatches
	(HatchAnimation), treasure finds (TreasurePopup) and new shovels (ShopPanel):
	  - the rarity word in huge outlined letters in the rarity colour ("LEGENDARY!") at the top,
	    popping in with a wobble, over a slowly spinning sparkle burst
	  - a dark navy card per item: name in big outlined text, the 3D model in a viewport on the
	    left (single item) or on top (several items side by side), stat rows on the right
	    (RARITY, SAND BONUS, DIGS <layer>, RIDEABLE ...), optional "NEW!" tag
	  - twinkling sparkles; tap anywhere to close (auto-closes after Hold seconds)
	Compact = true is the non-blocking variant for frequent finds (common treasures): smaller,
	no dim, never eats taps meant for digging (only the card itself closes it).
	Reveals queue, so rapid finds never overlap.

		Reveal.Show({ Headline = "EPIC!", Color = rarity.Color, Items = { {
			Name = "Golden Crab", Model = ModelFactory.Pet(id),
			Rows = { { Label = "RARITY", Value = "Epic", Color = rarity.Color } } } } })
]]
local Root = require(script.Parent.Root)
local Style = require(script.Parent.Components.Style)
local AtlasIcon = require(script.Parent.Components.AtlasIcon)
local Viewport = require(script.Parent.Components.Viewport)
local UIEffects = require(script.Parent.UIEffects)
local SoundController = require(script.Parent.Parent.Controllers.SoundController)
local Signal = require(script.Parent.Parent.Util.Signal)

local Reveal = {}

export type Row = { Label: string, Value: string, Color: Color3? }

export type Item = {
	Name: string,
	Model: Model?,
	Yaw: number?,
	Pitch: number?,
	Rotation: CFrame?,
	Spin: boolean?, -- defaults true; flat finds can keep their recognizable front face
	Rows: { Row },
	Tag: string?, -- "NEW!"
	NameColor: Color3?,
}

export type Spec = {
	Headline: string,
	Color: Color3,
	Gradient: { Color3 }?,
	Caption: string?, -- small line under the headline ("YOU HATCHED", "NEW SHOVEL")
	Items: { Item },
	Compact: boolean?,
	CompactScale: number?, -- discovery cards reserve more room for the item name
	Hold: number?,
	Sound: string?, -- "" = silent
	Confetti: boolean?,
	Flash: boolean?,
	OnClosed: (() -> ())?,
}

Reveal.Opened = Signal.new()
Reveal.Closed = Signal.new()

local C = Style.Colors
local queue: { Spec } = {}
local showing = false

local SINGLE = Vector2.new(540, 230)
local MULTI = Vector2.new(220, 300)

local function starburst(parent: Instance, color: Color3, z: number): Frame
	local burst = Instance.new("Frame")
	burst.Name = "Burst"
	burst.BackgroundTransparency = 1
	burst.AnchorPoint = Vector2.new(0.5, 0.5)
	burst.Position = UDim2.fromScale(0.5, 0.5)
	burst.Size = UDim2.fromOffset(0, 0)
	burst.ZIndex = z
	burst.Parent = parent
	for i = 0, 7 do
		local ray = Instance.new("Frame")
		ray.Name = "Ray"
		ray.AnchorPoint = Vector2.new(0.5, 0.5)
		ray.Position = UDim2.fromScale(0.5, 0.5)
		ray.Size = UDim2.new(1, 0, 0.1, 0)
		ray.Rotation = i * 22.5
		ray.BackgroundColor3 = color
		ray.BorderSizePixel = 0
		ray.ZIndex = z
		ray.Parent = burst
		local gradient = Instance.new("UIGradient")
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.15),
			NumberSequenceKeypoint.new(1, 1),
		})
		gradient.Parent = ray
	end
	Style.Tween(burst, 8, { Rotation = 360 }, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)
	return burst
end

local function sparkles(parent: Frame, z: number)
	local spots = {
		Vector2.new(-0.04, 0.1),
		Vector2.new(1.03, 0.2),
		Vector2.new(0.08, 0.95),
		Vector2.new(0.95, 0.9),
		Vector2.new(0.5, -0.06),
		Vector2.new(-0.06, 0.55),
		Vector2.new(1.06, 0.6),
	}
	for i, spot in spots do
		local star = AtlasIcon.new({
			Name = "Sparkle",
			Icon = "Star",
			Size = UDim2.fromOffset(26 + (i % 3) * 8, 26 + (i % 3) * 8),
			Position = UDim2.fromScale(spot.X, spot.Y),
			ZIndex = z,
			Parent = parent,
		})
		local scale = Style.GetPopScale(star.Frame)
		scale.Scale = 0.2
		task.delay(0.08 * i, function()
			if star.Frame.Parent then
				Style.Tween(
					scale,
					0.5 + (i % 3) * 0.12,
					{ Scale = 1.1 },
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					-1,
					true
				)
				Style.Tween(star.Frame, 3, { Rotation = if i % 2 == 0 then 180 else -180 }, Enum.EasingStyle.Linear)
			end
		end)
	end
end

local function statRows(parent: Frame, rows: { Row }, rowHeight: number, maxText: number, z: number)
	local list = Instance.new("Frame")
	list.Name = "Stats"
	list.BackgroundTransparency = 1
	list.Size = UDim2.fromScale(1, 1)
	list.ZIndex = z
	list.Parent = parent
	Style.List(list, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center)
	for i, row in rows do
		local line = Instance.new("Frame")
		line.Name = row.Label
		line.Size = UDim2.new(1, 0, 0, rowHeight)
		line.BackgroundColor3 = C.NavyCard
		line.BackgroundTransparency = 0.15
		line.LayoutOrder = i
		line.ZIndex = z
		line.Parent = list
		Style.Corner(line, Style.Theme.CornerSmall)
		Style.Stroke(line, C.Stroke, 2)
		Style.Label({
			Name = "Key",
			Text = row.Label,
			Size = UDim2.new(0.46, -8, 0.7, 0),
			Position = UDim2.new(0, 8, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			TextColor = C.Sky,
			MaxTextSize = maxText - 3,
			XAlign = Enum.TextXAlignment.Left,
			ZIndex = z + 1,
			Parent = line,
		})
		Style.Label({
			Name = "Value",
			Text = row.Value,
			Size = UDim2.new(0.54, -8, 0.78, 0),
			Position = UDim2.new(1, -8, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			TextColor = row.Color or C.Text,
			MaxTextSize = maxText,
			XAlign = Enum.TextXAlignment.Right,
			ZIndex = z + 1,
			Parent = line,
		})
	end
end

local function card(parent: Instance, item: Item, spec: Spec, single: boolean, z: number): Frame
	local size = if single then SINGLE else MULTI
	local holder = Instance.new("Frame")
	holder.Name = "Card"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(size.X, size.Y)
	holder.ZIndex = z
	holder.Parent = parent

	local lip = Instance.new("Frame")
	lip.Name = "Shadow"
	lip.Size = UDim2.new(1, 0, 1, -6)
	lip.Position = UDim2.fromOffset(0, 6)
	lip.BackgroundColor3 = C.Stroke
	lip.ZIndex = z
	lip.Parent = holder
	Style.Corner(lip, Style.Theme.CornerLarge)

	local face = Instance.new("Frame")
	face.Name = "Face"
	face.Size = UDim2.new(1, 0, 1, -6)
	face.ZIndex = z + 1
	face.Parent = holder
	Style.Corner(face, Style.Theme.CornerLarge)
	Style.Stroke(face, C.Stroke, 4)
	Style.NavyBody(face)
	-- rarity accent ring just inside the outline
	local ring = Instance.new("Frame")
	ring.Name = "Accent"
	ring.BackgroundTransparency = 1
	ring.Size = UDim2.new(1, -8, 1, -8)
	ring.Position = UDim2.fromOffset(4, 4)
	ring.ZIndex = z + 1
	ring.Parent = face
	Style.Corner(ring, Style.Theme.CornerMedium)
	Style.Stroke(ring, spec.Color, 3)

	local stage = Instance.new("Frame")
	stage.Name = "Stage"
	stage.ZIndex = z + 2
	stage.Parent = face
	if single then
		stage.Size = UDim2.new(0, size.Y - 30, 1, -22)
		stage.Position = UDim2.fromOffset(12, 11)
	else
		stage.Size = UDim2.new(1, -20, 0, 120)
		stage.Position = UDim2.fromOffset(10, 10)
	end
	Style.Corner(stage, Style.Theme.CornerMedium)
	Style.Stroke(stage, C.Stroke, 3)
	stage.BackgroundColor3 = Color3.new(1, 1, 1)
	Style.Gradient(stage, spec.Gradient or { Style.Lighten(spec.Color, 0.45), Style.Darken(spec.Color, 0.25) }, 90)
	local view = Viewport.new({
		Name = "Model",
		Size = UDim2.fromScale(1, 1),
		Spin = item.Spin ~= false,
		SpinSpeed = 1.4,
		Pitch = item.Pitch or 12,
		Yaw = item.Yaw,
		Rotation = item.Rotation,
		ZIndex = z + 3,
		Parent = stage,
	})
	if item.Model then
		view:SetModel(item.Model)
		local scale = Style.GetPopScale(view.Frame)
		scale.Scale = 0
		Style.Tween(scale, 0.7, { Scale = 1 }, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	end

	local right = Instance.new("Frame")
	right.Name = "Info"
	right.BackgroundTransparency = 1
	right.ZIndex = z + 2
	right.Parent = face
	if single then
		right.Size = UDim2.new(1, -(size.Y - 30) - 36, 1, -22)
		right.Position = UDim2.fromOffset(size.Y - 30 + 24, 11)
	else
		right.Size = UDim2.new(1, -20, 1, -140)
		right.Position = UDim2.fromOffset(10, 134)
	end
	local nameHeight = if single then 46 else 34
	Style.Label({
		Name = "ItemName",
		Text = item.Name,
		Size = UDim2.new(1, 0, 0, nameHeight),
		TextColor = item.NameColor or C.Text,
		MaxTextSize = if single then 40 else 26,
		StrokeThickness = 3,
		XAlign = if single then Enum.TextXAlignment.Left else Enum.TextXAlignment.Center,
		ZIndex = z + 3,
		Parent = right,
	})
	local rowsFrame = Instance.new("Frame")
	rowsFrame.Name = "Rows"
	rowsFrame.BackgroundTransparency = 1
	rowsFrame.Size = UDim2.new(1, 0, 1, -nameHeight - 6)
	rowsFrame.Position = UDim2.fromOffset(0, nameHeight + 6)
	rowsFrame.ZIndex = z + 2
	rowsFrame.Parent = right
	-- 5+ rows (hatches add a CHANCE row, v2.2 true odds) get slightly shorter rows to fit the card
	local many = #item.Rows > 4
	local rowHeight = if single then (if many then 30 else 32) else (if many then 23 else 26)
	statRows(
		rowsFrame,
		item.Rows,
		rowHeight,
		if single then (if many then 19 else 20) else (if many then 15 else 16),
		z + 3
	)

	if item.Tag then
		local tag = Style.Label({
			Name = "Tag",
			Text = item.Tag,
			Size = UDim2.fromOffset(84, 30),
			Position = UDim2.fromOffset(-10, -12),
			MaxTextSize = 20,
			ZIndex = z + 6,
			Parent = holder,
		})
		tag.Rotation = -8
		tag.BackgroundTransparency = 0
		tag.BackgroundColor3 = C.Coral
		Style.Corner(tag, Style.Theme.CornerPill)
		Style.Stroke(tag, C.Stroke, 3)
	end
	return holder
end

local pump: () -> ()

local function show(spec: Spec)
	showing = true
	Reveal.Opened:Fire()
	local canvas = Root.Get("Popups")
	local compact = spec.Compact == true
	local items = spec.Items
	local single = #items <= 1
	local cardSize = if single then SINGLE else MULTI
	local count = math.max(#items, 1)
	local rowWidth = if single then cardSize.X else count * cardSize.X + (count - 1) * 14

	-- root: the dim overlay (tap anywhere) or, when compact, an invisible container
	local root: GuiObject
	local closeRequested = false
	if compact then
		local frame = Instance.new("Frame")
		frame.Name = "Reveal"
		frame.BackgroundTransparency = 1
		frame.Size = UDim2.fromScale(1, 1)
		frame.ZIndex = 30
		frame.Parent = canvas
		root = frame
	else
		local overlay = Instance.new("TextButton")
		overlay.Name = "Reveal"
		overlay.Text = ""
		overlay.AutoButtonColor = false
		overlay.Selectable = false
		overlay.BackgroundColor3 = Color3.new(0, 0, 0)
		overlay.BackgroundTransparency = 1
		overlay.Size = UDim2.fromScale(1, 1)
		overlay.ZIndex = 30
		overlay.Parent = canvas
		Style.Tween(overlay, 0.2, { BackgroundTransparency = 0.45 })
		overlay.Activated:Connect(function()
			closeRequested = true
		end)
		root = overlay
	end

	local group = Instance.new("Frame")
	group.Name = "Group"
	group.BackgroundTransparency = 1
	group.AnchorPoint = Vector2.new(0.5, 0.5)
	group.Position = if compact then UDim2.fromScale(0.5, 0.42) else UDim2.fromScale(0.5, 0.52)
	group.Size = UDim2.fromOffset(rowWidth, cardSize.Y + 110)
	group.ZIndex = 31
	group.Parent = root
	local groupScale = Style.GetPopScale(group)
	local fit = 1
	local design = Root.GetDesignSize()
	if design.X > 0 and design.Y > 0 then
		fit = math.min(1, (design.X - 40) / rowWidth, (design.Y - 30) / (cardSize.Y + 110))
	end
	local target = fit * (if compact then math.clamp(spec.CompactScale or 0.62, 0.5, 1) else 1)
	groupScale.Scale = target * 0.6
	Style.Tween(groupScale, 0.35, { Scale = target }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	local burst = starburst(group, spec.Color, 31)
	burst.Position = UDim2.new(0.5, 0, 1, -cardSize.Y / 2)
	Style.Tween(burst, 0.5, { Size = UDim2.fromOffset(rowWidth + 260, rowWidth + 260) }, Enum.EasingStyle.Back)

	-- huge outlined rarity word with pop-in + wobble
	local headline = Style.Label({
		Name = "Headline",
		Text = spec.Headline,
		Size = UDim2.new(1, 120, 0, 84),
		Position = UDim2.new(0.5, 0, 0, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		TextColor = spec.Color,
		MaxTextSize = 80,
		StrokeThickness = 5,
		ZIndex = 40,
		Parent = group,
	})
	if spec.Gradient then
		Style.Gradient(headline, { Style.Lighten(spec.Color, 0.35), spec.Color, Style.Darken(spec.Color, 0.1) }, 90)
	end
	local headScale = Style.GetPopScale(headline)
	headScale.Scale = 0.1
	Style.Tween(headScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	headline.Rotation = -8
	Style.Tween(headline, 0.18, { Rotation = 6 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 5, true)
	task.delay(1.9, function()
		if headline.Parent then
			Style.Tween(headline, 0.2, { Rotation = -3 }, Enum.EasingStyle.Sine)
		end
	end)
	if spec.Caption then
		Style.Label({
			Name = "Caption",
			Text = spec.Caption,
			Size = UDim2.new(1, 0, 0, 26),
			Position = UDim2.new(0.5, 0, 0, 80),
			AnchorPoint = Vector2.new(0.5, 0),
			MaxTextSize = 22,
			ZIndex = 40,
			Parent = group,
		})
	end

	local row = Instance.new("Frame")
	row.Name = "Cards"
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, cardSize.Y)
	row.Position = UDim2.new(0, 0, 1, -cardSize.Y)
	row.ZIndex = 32
	row.Parent = group
	Style.List(row, Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center)
	for i, item in items do
		local c = card(row, item, spec, single, 33)
		c.LayoutOrder = i
		local s = Style.GetPopScale(c)
		s.Scale = 0
		task.delay(0.08 * (i - 1), function()
			Style.Tween(s, 0.45, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end)
	end
	sparkles(group, 41)

	if compact then
		-- only the card itself closes a compact reveal (taps elsewhere keep digging)
		local hit = Instance.new("TextButton")
		hit.Name = "Close"
		hit.Text = ""
		hit.BackgroundTransparency = 1
		hit.Selectable = false
		hit.Size = UDim2.fromScale(1, 1)
		hit.ZIndex = 45
		hit.Parent = group
		hit.Activated:Connect(function()
			closeRequested = true
		end)
	else
		Style.Label({
			Name = "Hint",
			Text = "Tap to close",
			Size = UDim2.fromOffset(200, 24),
			Position = UDim2.new(0.5, 0, 1, 14),
			AnchorPoint = Vector2.new(0.5, 0),
			TextColor = C.Sky,
			MaxTextSize = 18,
			ZIndex = 40,
			Parent = group,
		})
	end

	if spec.Sound ~= "" then
		SoundController.Play(spec.Sound or "Purchase")
	end
	if spec.Flash then
		UIEffects.Flash(spec.Color, 0.6)
	end
	if spec.Confetti then
		UIEffects.Confetti(50, spec.Gradient)
	end

	local hold = spec.Hold or (if compact then 2.4 else 4)
	local start = os.clock()
	task.spawn(function()
		while os.clock() - start < hold and not closeRequested and root.Parent do
			task.wait(0.05)
		end
		if root:IsA("TextButton") then
			Style.Tween(root, 0.2, { BackgroundTransparency = 1 })
		end
		local out = Style.Tween(groupScale, 0.22, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		out.Completed:Once(function()
			root:Destroy()
			showing = false
			if spec.OnClosed then
				task.spawn(spec.OnClosed)
			end
			Reveal.Closed:Fire()
			pump()
		end)
	end)
end

pump = function()
	if showing then
		return
	end
	local spec = table.remove(queue, 1)
	if spec then
		show(spec)
	end
end

function Reveal.Show(spec: Spec)
	if #queue >= 6 then
		-- drop the oldest compact reveal first so big moments are never lost
		for i, queued in queue do
			if queued.Compact then
				table.remove(queue, i)
				break
			end
		end
	end
	table.insert(queue, spec)
	pump()
end

function Reveal.IsShowing(): boolean
	return showing
end

return Reveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="158">
            <Properties>
              <string name="Name">RideButton</string>
              <string name="Source"><![CDATA[--!strict
--[[
	RideButton — "Ride" toggle + mobile "Dig" button for the ride-on vehicle (v2.1, Ride agent).
	Own ScreenGui "Dig_Ride" with the shared responsive scale (Root.Scale), DisplayOrder 2.

	- Ride (Ride / Exit toy button): only shown while the player owns a rideable pet (or is
	  riding). Sits beside the bottom-centre bar (UI/Layout "Ride" region: right of it on wide
	  screens, left of it on narrow ones so it never meets the SurvivalHUD), level with the
	  Surface/Sell/Auto row. Same action as key V / gamepad DPadUp (RideController).
	- Dig (touch devices only, only while riding): hold to scoop. Layout "RideDig": right side,
	  left of the phone jump button and clear of the bottom-centre backpack bar.
]]
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Components = script.Parent.Components
local Style = require(Components.Style)
local Button = require(Components.Button)
local Root = require(script.Parent.Root)
local Layout = require(script.Parent.Layout)
local RideController = require(script.Parent.Parent.Controllers.RideController)

local RideButton = {}

RideButton.Gui = nil :: ScreenGui?
RideButton.Ride = nil :: Button.Button?
RideButton.Dig = nil :: Button.Button?

local initialized = false

function RideButton.Init()
	if initialized then
		return
	end
	initialized = true

	local gui = Instance.new("ScreenGui")
	gui.Name = "Dig_Ride"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 2
	RideButton.Gui = gui

	local canvas = Instance.new("Frame")
	canvas.Name = "Canvas"
	canvas.BackgroundTransparency = 1
	canvas.AnchorPoint = Vector2.new(0.5, 0.5)
	canvas.Position = UDim2.fromScale(0.5, 0.5)
	canvas.Size = UDim2.fromScale(1, 1)
	canvas.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Parent = canvas
	local function applyScale(s: number)
		scale.Scale = s
		canvas.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	applyScale(Root.Scale)
	Root.ScaleChanged:Connect(applyScale)

	local ride = Button.new({
		Name = "RideButton",
		Parent = canvas,
		Icon = "Ride",
		Text = "Ride",
		Vertical = true,
		Color = Style.Colors.Sunset,
		Size = Layout.SizeOf(Layout.Current().Ride),
		MaxTextSize = 18,
		Sound = "",
		OnClick = function()
			RideController.Toggle()
		end,
	})
	RideButton.Ride = ride

	local dig = Button.new({
		Name = "RideDigButton",
		Parent = canvas,
		Icon = "Dig",
		Text = "Dig",
		Vertical = true,
		Color = Style.Colors.Gold,
		Size = Layout.SizeOf(Layout.Current().RideDig),
		Sound = "",
	})
	RideButton.Dig = dig
	local face = dig.Face
	local function isPress(input: InputObject): boolean
		return input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1
	end
	face.InputBegan:Connect(function(input: InputObject)
		if isPress(input) then
			RideController.SetDigHeld(true)
		end
	end)
	face.InputEnded:Connect(function(input: InputObject)
		if isPress(input) then
			RideController.SetDigHeld(false)
		end
	end)
	face.MouseLeave:Connect(function()
		RideController.SetDigHeld(false)
	end)

	Layout.Observe(function(regions: Layout.Regions)
		ride.Holder.Position = Layout.Position(regions.Ride)
		ride.Holder.Size = Layout.SizeOf(regions.Ride)
		dig.Holder.Position = Layout.Position(regions.RideDig)
		dig.Holder.Size = Layout.SizeOf(regions.RideDig)
	end)

	local function refresh()
		local riding = RideController.Riding
		ride:SetVisible(riding or RideController.CanRide())
		ride:SetIcon(if riding then "🚶" else "Ride")
		ride:SetText(if riding then "Exit" else "Ride")
		dig:SetVisible(riding and UserInputService.TouchEnabled)
		if not riding then
			RideController.SetDigHeld(false)
		end
	end
	RideController.RidingChanged:Connect(refresh)
	RideController.CanRideChanged:Connect(refresh)
	refresh()

	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
end

return RideButton
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="159">
            <Properties>
              <string name="Name">Root</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Root — creates the ScreenGuis (one per layer so DisplayOrder keeps popups above panels)
	and a single responsive scale shared by all of them.

	Each layer has a full-screen "Canvas" Frame with a UIScale. The canvas is sized 1/scale so
	after scaling it covers the safe area exactly; children are laid out in "design pixels"
	(reference height ~540, so a 76px button is ~46px on a landscape phone and ~90px on 1080p).
	ScreenInsets = CoreUISafeInsets keeps everything clear of the notch and the Roblox top bar.
]]
local Players = game:GetService("Players")

local Signal = require(script.Parent.Parent.Util.Signal)

local Root = {}

local REFERENCE_WIDTH = 1000
local REFERENCE_HEIGHT = 540
local MIN_SCALE = 0.6
local MAX_SCALE = 1.35

export type Layer = {
	Gui: ScreenGui,
	Canvas: Frame,
	Scale: UIScale,
}

Root.Scale = 1
Root.ScaleChanged = Signal.new()
Root.Layers = {} :: { [string]: Layer }
Root.DesignSize = Vector2.new(REFERENCE_WIDTH, REFERENCE_HEIGHT)

local playerGui: PlayerGui? = nil

local function computeScale(size: Vector2): number
	if size.X <= 0 or size.Y <= 0 then
		return 1
	end
	return math.clamp(math.min(size.X / REFERENCE_WIDTH, size.Y / REFERENCE_HEIGHT), MIN_SCALE, MAX_SCALE)
end

local function applyScale(layer: Layer, scale: number)
	layer.Scale.Scale = scale
	layer.Canvas.Size = UDim2.fromScale(1 / scale, 1 / scale)
end

local function makeLayer(name: string, displayOrder: number): Layer
	local gui = Instance.new("ScreenGui")
	gui.Name = "Dig_" .. name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = displayOrder

	local canvas = Instance.new("Frame")
	canvas.Name = "Canvas"
	canvas.BackgroundTransparency = 1
	-- Centered so the result is correct whether UIScale pivots on the anchor or the centre.
	canvas.AnchorPoint = Vector2.new(0.5, 0.5)
	canvas.Position = UDim2.fromScale(0.5, 0.5)
	canvas.Size = UDim2.fromScale(1, 1)
	canvas.Parent = gui

	local scale = Instance.new("UIScale")
	scale.Parent = canvas

	gui.Parent = playerGui
	return { Gui = gui, Canvas = canvas, Scale = scale }
end

function Root.Get(name: string): Frame
	local layer = Root.Layers[name]
	assert(layer, "UI Root: unknown layer " .. name)
	return layer.Canvas
end

function Root.GetGui(name: string): ScreenGui
	return Root.Layers[name].Gui
end

-- Size of the scaled canvas in design pixels.
function Root.GetDesignSize(): Vector2
	local layer = Root.Layers.HUD
	if not layer then
		return Root.DesignSize
	end
	return layer.Gui.AbsoluteSize / Root.Scale
end

function Root.Init()
	local player = Players.LocalPlayer
	playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

	Root.Layers.World = makeLayer("World", 0) -- tutorial hints anchored to screen positions
	Root.Layers.HUD = makeLayer("HUD", 1)
	Root.Layers.Panels = makeLayer("Panels", 5)
	Root.Layers.Popups = makeLayer("Popups", 8)
	Root.Layers.Toasts = makeLayer("Toasts", 10)

	local reference = Root.Layers.HUD.Gui
	local function update()
		local scale = computeScale(reference.AbsoluteSize)
		Root.Scale = scale
		for _, layer in Root.Layers do
			applyScale(layer, scale)
		end
		Root.ScaleChanged:Fire(scale)
	end
	reference:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	update()
end

return Root
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="160">
            <Properties>
              <string name="Name">SocialHUD</string>
              <string name="Source"><![CDATA[--!strict
--[[
	SocialHUD — co-play reasons on screen (v2.2 SOCIAL, Status & Social agent). Lives in the HUD
	canvas at the UI/Layout "Social" region (wide screens: under the depth meter; narrow: under
	the SurvivalHUD), 200 x 80 design px:
	  GoalBar      "Server goal 12.4K / 50K" progress pill from Workspace attributes
	               ServerGoalProgress / ServerGoalTarget (server: ServerGoalService). While the
	               reward event runs / cools down (ServerGoalResumeAt in the future) it reads
	               "Goal reached! Next in 4:12".
	  FriendsChip  "Friends +10%" when the local player has friends in this server (Player
	               attribute FriendsInServer, same bonus maths as Util/Stats). Hidden otherwise.
	Invite: SocialHUD.PromptInvite() opens Roblox's invite dialog (SocialService, every call
	pcall'd; CanSendGameInviteAsync first). No reward for invites (they can't be verified).
	The Settings panel has the "Invite friends" button.

	API: SocialHUD.PromptInvite(): (boolean, string), SocialHUD.FriendBonusText(n): string?,
	     SocialHUD.GoalText(progress, target, resumeIn): string, SocialHUD.Holder
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Root = require(script.Parent.Root)
local Style = require(script.Parent.Components.Style)
local AtlasIcon = require(script.Parent.Components.AtlasIcon)
local ProgressBar = require(script.Parent.Components.ProgressBar)
local Layout = require(script.Parent.Layout)
local Toasts = require(script.Parent.Toasts)

local SocialHUD = {}

SocialHUD.Holder = nil :: Frame?

local C = Style.Colors
local FRIENDS_ICON = "👫"

-- "Friends +10%" for n friends in the server (nil when none).
function SocialHUD.FriendBonusText(friends: number): string?
	local n = math.max(0, math.floor(friends))
	if n <= 0 then
		return nil
	end
	local bonus = math.min(n * Config.FRIEND_BONUS_PER_FRIEND, Config.FRIEND_BONUS_MAX)
	return string.format("Friends +%d%%", math.floor(bonus * 100 + 0.5))
end

function SocialHUD.GoalText(progress: number, target: number, resumeIn: number): string
	if resumeIn > 0 then
		return "Goal reached! Next in " .. Format.Time(resumeIn)
	end
	return "Server goal " .. Format.Abbreviate(math.floor(progress)) .. " / " .. Format.Abbreviate(target)
end

-- Opens the Roblox invite dialog. Returns (opened, reason).
function SocialHUD.PromptInvite(): (boolean, string)
	local player = Players.LocalPlayer
	local okCan, can = pcall(function(): boolean
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if not okCan or can ~= true then
		Toasts.Show("Invites aren't available right now.", "Info")
		return false, if okCan then "NotAllowed" else "Error"
	end
	local okPrompt = pcall(function()
		SocialService:PromptGameInvite(player)
	end)
	if not okPrompt then
		Toasts.Show("Couldn't open the invite window. Try again!", "Info")
		return false, "Error"
	end
	return true, "Opened"
end

local function numberAttr(instance: Instance, name: string): number
	local value = instance:GetAttribute(name)
	return if typeof(value) == "number" then value else 0
end

function SocialHUD.Init()
	local holder = Instance.new("Frame")
	holder.Name = "Social"
	holder.BackgroundTransparency = 1
	holder.Parent = Root.Get("HUD")
	SocialHUD.Holder = holder
	Layout.Observe(function(regions: Layout.Regions)
		holder.Position = Layout.Position(regions.Social)
		holder.Size = Layout.SizeOf(regions.Social)
	end)
	Style.List(holder, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right)

	local goal = ProgressBar.new({
		Name = "GoalBar",
		Size = UDim2.new(1, -14, 0, 36),
		Color = C.Gold,
		MaxTextSize = 16,
		LayoutOrder = 1,
		ZIndex = 2,
		Parent = holder,
	})
	AtlasIcon.new({
		Name = "GoalIcon",
		Icon = "trophy",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(0, -18, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 5,
		Parent = goal.Frame,
	})

	local chip = Instance.new("Frame")
	chip.Name = "FriendsChip"
	chip.Size = UDim2.new(1, -14, 0, 32)
	chip.LayoutOrder = 2
	chip.Visible = false
	chip.Parent = holder
	Style.Pill(chip, 0.08)
	local ring = chip:FindFirstChildOfClass("UIStroke")
	if ring then
		ring.Color = Style.Darken(C.Coral, 0.2)
	end
	AtlasIcon.new({
		Icon = FRIENDS_ICON,
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.new(0, -8, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 3,
		Parent = chip,
	})
	local chipLabel = Style.Label({
		Name = "Text",
		Size = UDim2.new(1, -40, 0.78, 0),
		Position = UDim2.new(0, 32, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		TextColor = C.Money,
		MaxTextSize = 18,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = chip,
	})

	local function updateGoal()
		local progress = numberAttr(Workspace, "ServerGoalProgress")
		local target = numberAttr(Workspace, "ServerGoalTarget")
		local resumeIn = math.max(0, numberAttr(Workspace, "ServerGoalResumeAt") - Workspace:GetServerTimeNow())
		goal.Frame.Visible = target > 0
		if target > 0 then
			local alpha = if resumeIn > 0 then 1 else math.clamp(progress / target, 0, 1)
			goal:Set(alpha, SocialHUD.GoalText(progress, target, resumeIn))
		end
	end
	local function updateFriends()
		local text = SocialHUD.FriendBonusText(numberAttr(Players.LocalPlayer, "FriendsInServer"))
		local was = chip.Visible
		chip.Visible = text ~= nil
		if text then
			chipLabel.Text = text
			if not was then
				Style.PopIn(chip)
			end
		end
	end
	for _, name in { "ServerGoalProgress", "ServerGoalTarget", "ServerGoalResumeAt" } do
		Workspace:GetAttributeChangedSignal(name):Connect(updateGoal)
	end
	Players.LocalPlayer:GetAttributeChangedSignal("FriendsInServer"):Connect(updateFriends)
	updateGoal()
	updateFriends()
	task.spawn(function()
		while holder.Parent do
			task.wait(1)
			if numberAttr(Workspace, "ServerGoalResumeAt") > 0 then
				updateGoal() -- countdown
			end
		end
	end)
end

return SocialHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="161">
            <Properties>
              <string name="Name">SurvivalHUD</string>
              <string name="Source"><![CDATA[--!strict
--[[
	SurvivalHUD — heat meter, shade indicator, snack quick-slots and the shade placement bar
	(owner: Survival; v3 restyle). Lives in its own ScreenGui "Dig_Survival" (same responsive
	scale as the main HUD) on the right edge, in the UI/Layout "Survival" region (218 x 184
	under the top-right cluster / depth meter, clear of the phone jump button).

	- Thermometer: fill + colour follow the Heat attribute; above it a zone chip
	  (☀️ Sun / ⛱️ Shade / 🕳️ Underground / 🌴 Cool, 🧴 while the new-player grace lasts).
	  Sunburnt: the bulb pulses red, a "SUNBURNT!" tag shows and a toast explains the fix.
	- Quick-slots (1/2/3) in a 2x2 grid of 74 px toy buttons with the shade button (F): the best
	  owned snacks with counts; empty slot -> opens the Snacks tab. The shade button starts
	  placing your best shade (F); without one it opens the Beach Shop.
	- Placement bar (Rotate / Place / Cancel) while PlacementController is active (mobile-friendly).
	- Screen warmth: a client-only ColorCorrectionEffect "HeatTint" in Lighting plus a soft warm
	  edge glow that shimmers when hot. Never touches the World* lighting effects or DepthTint.
]]
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Components = script.Parent.Components
local Style = require(Components.Style)
local Button = require(Components.Button)
local AtlasIcon = require(Components.AtlasIcon)
local Layout = require(script.Parent.Layout)
local Panel = require(Components.Panel)
local Root = require(script.Parent.Root)
local Toasts = require(script.Parent.Toasts)
local State = require(script.Parent.Parent.Controllers.State)
local SurvivalController = require(script.Parent.Parent.Controllers.SurvivalController)
local PlacementController = require(script.Parent.Parent.Controllers.PlacementController)

local SurvivalHUD = {}

local C = Style.Colors
local Heat = Config.Heat

local ZONES: { [string]: { Icon: string, Text: string, Color: Color3 } } = {
	Sun = { Icon = "sun", Text = "SUN", Color = Color3.fromRGB(255, 170, 40) },
	Shade = { Icon = "shade", Text = "SHADE", Color = Color3.fromRGB(60, 170, 255) },
	Underground = { Icon = "depth|🕳️", Text = "COOL", Color = Color3.fromRGB(120, 110, 200) },
	Cool = { Icon = "water|🌴", Text = "COOL", Color = Color3.fromRGB(70, 200, 120) },
}
local GRACE = { Icon = "shade|🧴", Text = "SAFE", Color = Color3.fromRGB(90, 210, 200) }
local BURNT_ZONE = { Icon = "heat|🥵", Text = "BURNT!", Color = Color3.fromRGB(240, 50, 50) }

local COLD = Color3.fromRGB(80, 190, 255)
local WARM = Color3.fromRGB(255, 205, 60)
local HOT = Color3.fromRGB(255, 120, 40)
local BURNT = Color3.fromRGB(240, 50, 50)

local TUBE_HEIGHT = 84
local HUD_HEIGHT = 184 -- Layout.SURVIVAL.Y
local SLOT = 74 -- >= Theme.MinTouchSize

type Slot = { Button: Button.Button, Count: TextLabel, Key: TextLabel }

local gui: ScreenGui
local canvas: Frame
local fill: Frame
local bulb: Frame
local bulbLabel: TextLabel
local zoneChip: Frame
local zoneIcon: AtlasIcon.AtlasIcon
local zoneText: TextLabel
local glow: Frame
local glowGradient: UIGradient
local slots: { Slot } = {}
local shadeButton: Button.Button
local placeBar: Frame
local placeTitle: TextLabel
local tint: ColorCorrectionEffect? = nil
local bulbPulse: Tween? = nil
local glowPulse: Tween? = nil
local warned = false
local wasBurnt = false
local initialized = false

SurvivalHUD.Gui = nil :: ScreenGui?

local function heatColor(alpha: number, burnt: boolean): Color3
	if burnt then
		return BURNT
	end
	if alpha < 0.5 then
		return COLD:Lerp(WARM, alpha / 0.5)
	end
	return WARM:Lerp(HOT, (alpha - 0.5) / 0.5)
end

local function getTint(): ColorCorrectionEffect
	local existing = tint
	if existing and existing.Parent then
		return existing
	end
	local found = Lighting:FindFirstChild("HeatTint")
	local effect: ColorCorrectionEffect
	if found and found:IsA("ColorCorrectionEffect") then
		effect = found
	else
		effect = Instance.new("ColorCorrectionEffect")
		effect.Name = "HeatTint"
		effect.Parent = Lighting
	end
	tint = effect
	return effect
end

-- Build ---------------------------------------------------------------------------------------------

local function makeGui()
	gui = Instance.new("ScreenGui")
	gui.Name = "Dig_Survival"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 2
	SurvivalHUD.Gui = gui

	canvas = Instance.new("Frame")
	canvas.Name = "Canvas"
	canvas.BackgroundTransparency = 1
	canvas.AnchorPoint = Vector2.new(0.5, 0.5)
	canvas.Position = UDim2.fromScale(0.5, 0.5)
	canvas.Size = UDim2.fromScale(1, 1)
	canvas.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Parent = canvas
	local function applyScale(s: number)
		scale.Scale = s
		canvas.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	applyScale(Root.Scale)
	Root.ScaleChanged:Connect(applyScale)

	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function buildGlow()
	-- Warm edge glow (top + bottom), invisible when cool.
	glow = Instance.new("Frame")
	glow.Name = "HeatGlow"
	glow.BackgroundColor3 = Color3.fromRGB(255, 140, 40)
	glow.BackgroundTransparency = 1
	glow.BorderSizePixel = 0
	glow.Size = UDim2.fromScale(1.2, 1.2)
	glow.Position = UDim2.fromScale(0.5, 0.5)
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Active = false
	glow.ZIndex = 0
	glow.Parent = canvas
	glowGradient = Instance.new("UIGradient")
	glowGradient.Rotation = 90
	glowGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(0.2, 1),
		NumberSequenceKeypoint.new(0.8, 1),
		NumberSequenceKeypoint.new(1, 0.45),
	})
	glowGradient.Parent = glow
end

local function buildMeter(holder: Frame)
	local column = Instance.new("Frame")
	column.Name = "Meter"
	column.BackgroundTransparency = 1
	column.Size = UDim2.fromOffset(56, HUD_HEIGHT)
	column.Position = UDim2.new(1, 0, 0, 0)
	column.AnchorPoint = Vector2.new(1, 0)
	column.Parent = holder

	zoneChip = Instance.new("Frame")
	zoneChip.Name = "Zone"
	zoneChip.Size = UDim2.fromOffset(54, 54)
	zoneChip.Position = UDim2.new(0.5, 0, 0, 0)
	zoneChip.AnchorPoint = Vector2.new(0.5, 0)
	zoneChip.BackgroundColor3 = ZONES.Cool.Color
	zoneChip.ZIndex = 2
	zoneChip.Parent = column
	Style.Corner(zoneChip, Style.Theme.CornerPill)
	Style.Stroke(zoneChip, C.Stroke, 3)
	Style.Gloss(zoneChip, Style.Theme.CornerPill, 2)
	zoneIcon = AtlasIcon.new({
		Name = "Icon",
		Icon = ZONES.Cool.Icon,
		Size = UDim2.new(1, -8, 0.66, 0),
		Position = UDim2.new(0.5, 0, 0, 2),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 3,
		Parent = zoneChip,
	})
	zoneText = Style.Label({
		Name = "Text",
		Text = ZONES.Cool.Text,
		Size = UDim2.new(1, -6, 0.3, 0),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		MaxTextSize = 14,
		ZIndex = 4,
		Parent = zoneChip,
	})

	local tube = Instance.new("Frame")
	tube.Name = "Tube"
	tube.Size = UDim2.fromOffset(26, TUBE_HEIGHT)
	tube.Position = UDim2.new(0.5, 0, 0, 58)
	tube.AnchorPoint = Vector2.new(0.5, 0)
	tube.BackgroundColor3 = C.NavyDark
	tube.ClipsDescendants = true
	tube.ZIndex = 2
	tube.Parent = column
	Style.Corner(tube, Style.Theme.CornerPill)
	Style.Stroke(tube, C.Stroke, 3)

	fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(1, 0, 0, 0)
	fill.Position = UDim2.fromScale(0, 1)
	fill.AnchorPoint = Vector2.new(0, 1)
	fill.BackgroundColor3 = COLD
	fill.BorderSizePixel = 0
	fill.ZIndex = 3
	fill.Parent = tube
	Style.Corner(fill, Style.Theme.CornerPill)
	Style.Shine(fill)
	-- tick marks: warning + sunburnt thresholds
	for _, at in { Heat.WarningAt, Heat.SunburntAt * 0.995 } do
		local tick = Instance.new("Frame")
		tick.Name = "Tick"
		tick.Size = UDim2.new(0.5, 0, 0, 3)
		tick.Position = UDim2.new(0, 0, 1 - at / Heat.Max, 0)
		tick.BackgroundColor3 = C.Stroke
		tick.BackgroundTransparency = 0.4
		tick.BorderSizePixel = 0
		tick.ZIndex = 4
		tick.Parent = tube
	end

	bulb = Instance.new("Frame")
	bulb.Name = "Bulb"
	bulb.Size = UDim2.fromOffset(48, 48)
	bulb.Position = UDim2.new(0.5, 0, 0, 58 + TUBE_HEIGHT - 10)
	bulb.AnchorPoint = Vector2.new(0.5, 0)
	bulb.BackgroundColor3 = COLD
	bulb.ZIndex = 4
	bulb.Parent = column
	Style.Corner(bulb, Style.Theme.CornerPill)
	Style.Stroke(bulb, C.Stroke, 3)
	Style.Shine(bulb)
	bulbLabel = Style.Label({
		Name = "Value",
		Text = "0",
		Size = UDim2.fromScale(0.8, 0.6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 20,
		ZIndex = 5,
		Parent = bulb,
	})
end

local function buildSlots(holder: Frame)
	local column = Instance.new("Frame")
	column.Name = "QuickSlots"
	column.BackgroundTransparency = 1
	column.Size = UDim2.fromOffset(SLOT * 2 + 6, SLOT * 2 + 6)
	column.Position = UDim2.new(0, 0, 1, 0)
	column.AnchorPoint = Vector2.new(0, 1)
	column.Parent = holder
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(SLOT, SLOT)
	grid.CellPadding = UDim2.fromOffset(6, 6)
	grid.FillDirectionMaxCells = 2
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = column

	shadeButton = Button.new({
		Name = "PlaceShade",
		Icon = "place_shade|⛱️",
		Text = "F",
		Vertical = true,
		Color = C.Sunset,
		MaxTextSize = 16,
		LayoutOrder = 0,
		ZIndex = 3,
		Parent = column,
		OnClick = function()
			if PlacementController.BestOwnedShade() then
				PlacementController.Toggle()
			else
				Panel.Open("BeachShop", { Tab = "Shade" })
			end
		end,
	})

	for i = 1, SurvivalController.SLOT_COUNT do
		local button = Button.new({
			Name = "Slot" .. i,
			Icon = "➕",
			Text = "",
			Vertical = true,
			Color = C.Ocean,
			MaxTextSize = 14,
			LayoutOrder = i,
			ZIndex = 3,
			Parent = column,
			OnClick = function()
				SurvivalController.UseSlot(i)
			end,
		})
		local count = Style.Label({
			Name = "Count",
			Text = "",
			Size = UDim2.fromOffset(40, 24),
			Position = UDim2.new(1, 2, 1, -4),
			AnchorPoint = Vector2.new(1, 1),
			MaxTextSize = 20,
			StrokeThickness = 3,
			ZIndex = 8,
			Parent = button.Holder,
		})
		local key = Style.Label({
			Name = "Key",
			Text = tostring(i),
			Size = UDim2.fromOffset(22, 22),
			Position = UDim2.fromOffset(-4, -4),
			MaxTextSize = 15,
			ZIndex = 8,
			Parent = button.Holder,
		})
		key.BackgroundTransparency = 0
		key.BackgroundColor3 = C.NavyDark
		Style.Corner(key, Style.Theme.CornerPill)
		Style.Stroke(key, C.Stroke, 2)
		table.insert(slots, { Button = button, Count = count, Key = key })
	end
end

local function buildPlaceBar()
	placeBar = Instance.new("Frame")
	placeBar.Name = "PlacementBar"
	placeBar.BackgroundTransparency = 1
	placeBar.Size = UDim2.fromOffset(440, 120)
	placeBar.Position = UDim2.new(0.5, 0, 1, -196) -- just above the bottom bar (Layout.Bottom)
	placeBar.AnchorPoint = Vector2.new(0.5, 1)
	placeBar.Visible = false
	placeBar.ZIndex = 5
	placeBar.Parent = canvas
	placeTitle = Style.Label({
		Name = "Title",
		Text = "",
		Size = UDim2.new(1, 0, 0, 34),
		MaxTextSize = 24,
		ZIndex = 6,
		Parent = placeBar,
	})
	local row = Instance.new("Frame")
	row.Name = "Row"
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 80)
	row.Position = UDim2.fromOffset(0, 40)
	row.Parent = placeBar
	Style.List(row, Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center)
	Button.new({
		Name = "Rotate",
		Icon = "🔄",
		Text = "Turn",
		Size = UDim2.fromOffset(124, 76),
		Color = C.Ocean,
		LayoutOrder = 1,
		ZIndex = 6,
		Parent = row,
		OnClick = function()
			PlacementController.Rotate()
		end,
	})
	Button.new({
		Name = "Place",
		Icon = "Check",
		Text = "Place",
		Size = UDim2.fromOffset(144, 76),
		Color = C.Success,
		LayoutOrder = 2,
		ZIndex = 6,
		Parent = row,
		OnClick = function()
			PlacementController.Confirm()
		end,
	})
	Button.new({
		Name = "Cancel",
		Icon = "Close",
		Text = "Cancel",
		Size = UDim2.fromOffset(136, 76),
		Color = C.Danger,
		LayoutOrder = 3,
		ZIndex = 6,
		Parent = row,
		OnClick = function()
			PlacementController.Cancel()
		end,
	})
end

-- Refresh -------------------------------------------------------------------------------------------

local function refreshSlots()
	local ids = SurvivalController.GetQuickSlots()
	local counts = State.Data.Consumables or ({} :: { [string]: number })
	for i, slot in slots do
		local id = ids[i]
		local def = if id then Config.GetConsumable(id) else nil
		if def then
			slot.Button:SetIcon(AtlasIcon.Item(def.Id, def.Icon))
			slot.Button:SetColor(C.Ocean)
			slot.Count.Text = "x" .. tostring(counts[def.Id] or 0)
			slot.Count.Visible = true
		else
			slot.Button:SetIcon("➕")
			slot.Button:SetColor(C.SandDark)
			slot.Count.Visible = false
		end
	end
	local hasShade = PlacementController.BestOwnedShade() ~= nil
	shadeButton:SetColor(if PlacementController.Active then C.Danger elseif hasShade then C.Sunset else C.SandDark)
	shadeButton:SetText(if PlacementController.Active then "Stop" else "F")
end

local function refreshPlacement()
	placeBar.Visible = PlacementController.Active
	local id = PlacementController.ShadeId
	local def = if id then Config.GetShade(id) else nil
	placeTitle.Text = if def then "Place your " .. def.Name .. "!" else "Place your shade!"
	refreshSlots()
end

local function refreshHeat()
	local heat = SurvivalController.GetHeat()
	local burnt = SurvivalController.IsSunburnt()
	local alpha = math.clamp(heat / Heat.Max, 0, 1)
	local color = heatColor(alpha, burnt)
	Style.Tween(fill, 0.25, { Size = UDim2.new(1, 0, alpha, 0), BackgroundColor3 = color })
	bulb.BackgroundColor3 = color
	bulbLabel.Text = tostring(math.floor(heat + 0.5))

	local zone = if burnt
		then BURNT_ZONE
		elseif SurvivalController.InGrace() and SurvivalController.GetZone() == "Sun" then GRACE
		else ZONES[SurvivalController.GetZone()] or ZONES.Cool
	zoneChip.BackgroundColor3 = zone.Color
	zoneIcon:Set(zone.Icon)
	zoneText.Text = zone.Text

	-- Sunburnt state + toasts
	if burnt and not wasBurnt then
		bulbPulse = Style.Pulse(bulb, 0.18, 0.7)
		Toasts.Show("Sunburnt! Find shade or drink water 💧", "Error", 5)
	elseif not burnt and wasBurnt then
		Style.StopPulse(bulb, bulbPulse)
		bulbPulse = nil
		Toasts.Show("Cooled down! Back to full speed 😎", "Success", 3)
	end
	wasBurnt = burnt
	if not burnt and heat >= Heat.WarningAt and not warned then
		warned = true
		local tip = if PlacementController.BestOwnedShade()
			then "Getting hot! ☀️ Press F to place your shade, or have a drink."
			else "Getting hot! ☀️ Find shade, go underground or drink at the fountain."
		Toasts.Show(tip, "Info", 4)
	elseif heat < Heat.WarningAt - 15 then
		warned = false
	end

	-- Screen warmth
	local warmth = math.clamp((heat - 45) / (Heat.Max - 45), 0, 1)
	local effect = getTint()
	effect.TintColor = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(255, 226, 196), warmth)
	effect.Saturation = 0.12 * warmth
	effect.Contrast = 0.04 * warmth
	local target = if burnt then 0.35 else 1 - 0.5 * warmth
	if warmth > 0 and not glowPulse then
		glowPulse = Style.Tween(
			glowGradient,
			1.4,
			{ Offset = Vector2.new(0, 0.04) },
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		)
	elseif warmth <= 0 and glowPulse then
		glowPulse:Cancel()
		glowPulse = nil
	end
	Style.Tween(glow, 0.4, { BackgroundTransparency = math.clamp(target, 0, 1) })
end

-- Init ----------------------------------------------------------------------------------------------

function SurvivalHUD.Init()
	if initialized then
		return
	end
	initialized = true
	makeGui()
	buildGlow()

	local holder = Instance.new("Frame")
	holder.Name = "SurvivalHUD"
	holder.BackgroundTransparency = 1
	holder.ZIndex = 2
	holder.Parent = canvas
	Layout.Observe(function(regions: Layout.Regions)
		holder.Position = Layout.Position(regions.Survival)
		holder.Size = Layout.SizeOf(regions.Survival)
	end)
	buildMeter(holder)
	buildSlots(holder)
	buildPlaceBar()

	PlacementController.Hint = function(text: string, kind: string)
		Toasts.Show(text, kind)
	end
	PlacementController.Changed:Connect(refreshPlacement)
	SurvivalController.Changed:Connect(refreshHeat)
	State.ObserveMany({ "Consumables", "OwnedShades" }, refreshSlots)
	refreshPlacement()
	refreshHeat()
end

SurvivalHUD.Refresh = function()
	refreshHeat()
	refreshSlots()
end

return SurvivalHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="162">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Toasts — notification queue: short dark pills (kind-coloured outline, atlas icon overlapping
	the left end, outlined text) stacked under the top-centre objective banner and boost chips
	(UI/Layout "Toasts" region). Server Notify(kind, text) lands here; clients call
	Toasts.Show(text, kind). Max 3 on screen.
	Dedupe: the same message (case/punctuation/emoji-insensitive, and also when one text is just
	a longer version of the other, e.g. the server's "Backpack full! Go sell!" and the client's
	"Backpack full! Go SELL your sand") arriving within DEDUPE_WINDOW seconds of the last one is
	dropped (it only refreshes the visible toast's timer). Repeats after that window, while the
	toast is still visible, are merged into an "x2" counter instead of stacking.
	Kinds: Success, Error, Info, Warning, Reward, Announce (anything else -> Info).
	Routes (v2.2): Toasts.SetRoute(kind, fn) hands every message of that kind to another
	presenter instead (UI/Announcements takes "Announce" -> big gold top banner).
	Excavation: existing and incoming nonurgent notices wait until the rings and final grade
	leave the screen, then resume their remaining reading time without replaying sound.
	Reveals: while a Reveal popup is on screen, new non-urgent toasts (anything but Error and
	Warning) wait in the queue so they never cover its rarity headline; they appear when it
	closes, or after REVEAL_HOLD_MAX seconds if reveals keep chaining.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Root = require(script.Parent.Root)
local Style = require(script.Parent.Components.Style)
local AtlasIcon = require(script.Parent.Components.AtlasIcon)
local Layout = require(script.Parent.Layout)
local SoundController = require(script.Parent.Parent.Controllers.SoundController)
local Reveal = require(script.Parent.Reveal)

local Toasts = {}

local MAX_VISIBLE = 3
local MAX_QUEUED = 7
local excavating = false
local DEFAULT_DURATION = 3.2
local DEDUPE_WINDOW = 2
local MIN_PREFIX = 10 -- normalised chars needed before a prefix counts as "the same message"
local REVEAL_HOLD_MAX = 6 -- seconds a toast may wait behind reveals before it shows anyway

type KindStyle = { Color: Color3, Icon: string, Sound: string? }

local C = Style.Colors
local KINDS: { [string]: KindStyle } = {
	success = { Color = C.Success, Icon = "Check", Sound = "Coin" },
	error = { Color = C.Danger, Icon = "❌", Sound = "Error" },
	info = { Color = C.Ocean, Icon = "info" },
	warning = { Color = C.Warning, Icon = "⚠️", Sound = "DigBlocked" },
	reward = { Color = C.Gold, Icon = "gift", Sound = "Purchase" },
	announce = { Color = C.Purple, Icon = "notify", Sound = "RareTreasure" },
	purchase = { Color = C.Robux, Icon = "Store", Sound = "Purchase" },
	sell = { Color = C.Gold, Icon = "Coins" }, -- the HUD already plays the sell sound + coin rain
	event = { Color = C.Sunset, Icon = "star", Sound = "RareTreasure" },
}

type Entry = { Text: string, Kind: string, Duration: number, Queued: number, Silent: boolean? }
type Active = {
	Kind: string,
	Text: string,
	Key: string,
	Frame: Frame,
	Count: number,
	Label: TextLabel,
	Expires: number,
}

local container: Frame? = nil
local queue: { Entry } = {}
local active: { Active } = {}
local order = 0
local recent: { [string]: number } = {} -- normalised text -> os.clock() it was last shown

-- Lowercase letters and digits only: "Backpack full! Go SELL 💰" -> "backpackfullgosell".
local function normalise(text: string): string
	return (string.gsub(string.lower(text), "[^%w]", ""))
end

local function sameMessage(a: string, b: string): boolean
	if a == b then
		return true
	end
	local shorter, longer = a, b
	if #shorter > #longer then
		shorter, longer = b, a
	end
	return #shorter >= MIN_PREFIX and string.sub(longer, 1, #shorter) == shorter
end

-- Most recent time a message matching `key` was shown, if within the window.
local function recentlyShown(key: string, now: number): boolean
	for other, at in recent do
		if now - at > DEDUPE_WINDOW then
			recent[other] = nil
		elseif sameMessage(key, other) then
			return true
		end
	end
	return false
end

local function getKind(kind: string): KindStyle
	local key = string.lower(kind)
	if KINDS[key] then
		return KINDS[key]
	end
	if string.find(key, "err") or string.find(key, "fail") then
		return KINDS.error
	elseif string.find(key, "warn") then
		return KINDS.warning
	elseif string.find(key, "success") or string.find(key, "ok") then
		return KINDS.success
	elseif string.find(key, "reward") or string.find(key, "claim") or string.find(key, "code") then
		return KINDS.reward
	end
	return KINDS.info
end

local function getContainer(): Frame
	if container then
		return container
	end
	local frame = Instance.new("Frame")
	frame.Name = "Toasts"
	frame.BackgroundTransparency = 1
	frame.Parent = Root.Get("Toasts")
	Layout.Observe(function(regions: Layout.Regions)
		frame.Position = Layout.Position(regions.Toasts)
		frame.Size = Layout.SizeOf(regions.Toasts)
	end)
	Style.List(frame, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
	container = frame
	return frame
end

local pump: () -> ()

local function dismiss(item: Active)
	local index = table.find(active, item)
	if index then
		table.remove(active, index)
	end
	local scale = Style.GetPopScale(item.Frame)
	local tween = Style.Tween(scale, 0.18, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tween.Completed:Once(function()
		item.Frame:Destroy()
		pump()
	end)
end

local function display(entry: Entry)
	local kind = getKind(entry.Kind)
	order += 1
	local frame = Instance.new("Frame")
	frame.Name = "Toast"
	frame.Size = UDim2.new(1, -12, 0, 40)
	frame.LayoutOrder = order
	frame.Parent = getContainer()
	Style.Pill(frame, 0.1)
	local ring = frame:FindFirstChildOfClass("UIStroke")
	if ring then
		ring.Color = Style.Darken(kind.Color, 0.15)
	end

	AtlasIcon.new({
		Name = "IconBg",
		Icon = kind.Icon,
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(0, -10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 3,
		Parent = frame,
	})

	local label = Style.Label({
		Text = entry.Text,
		Size = UDim2.new(1, -54, 0.84, 0),
		Position = UDim2.new(0, 42, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Font = Style.Fonts.Title,
		MaxTextSize = 19,
		XAlign = Enum.TextXAlignment.Left,
		Wrapped = true,
		ZIndex = 2,
		Parent = frame,
	})

	local item: Active = {
		Kind = entry.Kind,
		Text = entry.Text,
		Key = normalise(entry.Text),
		Frame = frame,
		Count = 1,
		Label = label,
		Expires = os.clock() + entry.Duration,
	}
	table.insert(active, item)
	Style.PopIn(frame, 0.3)
	if kind.Sound and not entry.Silent then
		SoundController.Play(kind.Sound, 1, 0.8)
	end
	task.delay(entry.Duration, function()
		while table.find(active, item) and os.clock() < item.Expires do
			task.wait(item.Expires - os.clock())
		end
		if table.find(active, item) then
			dismiss(item)
		end
	end)
end

-- Errors and warnings are about what the player is doing right now: never held back.
function Toasts.IsUrgent(kind: string): boolean
	local style = getKind(kind)
	return style == KINDS.error or style == KINDS.warning
end

local function waitsForReveal(entry: Entry, now: number): boolean
	return not Toasts.IsUrgent(entry.Kind)
		and (excavating or (Reveal.IsShowing() and now - entry.Queued < REVEAL_HOLD_MAX))
end

local holdTimer = false
pump = function()
	local now = os.clock()
	local i = 1
	while i <= #queue and #active < MAX_VISIBLE do
		local entry = queue[i]
		if waitsForReveal(entry, now) then
			i += 1
		else
			display(table.remove(queue, i) :: Entry)
		end
	end
	if #queue > 0 and Reveal.IsShowing() and not holdTimer then
		-- re-check when the hold cap runs out even if the reveals never stop
		holdTimer = true
		task.delay(1, function()
			holdTimer = false
			pump()
		end)
	end
end

-- Excavation pushes presentation state, avoiding a Toasts -> ExcavationGame require cycle.
function Toasts.SetExcavating(value: boolean)
	if excavating == value then
		return
	end
	excavating = value
	if value then
		local now = os.clock()
		for i = #active, 1, -1 do
			local item = active[i]
			if not Toasts.IsUrgent(item.Kind) then
				table.remove(active, i)
				item.Frame:Destroy()
				if #queue >= MAX_QUEUED then
					table.remove(queue)
				end
				table.insert(queue, 1, {
					Text = item.Label.Text,
					Kind = item.Kind,
					Duration = math.max(0.5, item.Expires - now),
					Queued = now,
					Silent = true,
				})
			end
		end
		pump()
	else
		-- A confirmed find reveal may take over during this same event.
		task.defer(pump)
	end
end

local routes: { [string]: (text: string) -> () } = {}

-- Send every message of `kind` (case-insensitive) to `fn` instead of a toast (nil: back to toasts).
function Toasts.SetRoute(kind: string, fn: ((text: string) -> ())?)
	routes[string.lower(kind)] = fn :: any
end

function Toasts.Show(text: string, kind: string?, duration: number?)
	if text == "" then
		return
	end
	local route = routes[string.lower(kind or "Info")]
	if route then
		route(text)
		return
	end
	local key = normalise(text)
	local now = os.clock()
	local isRecent = recentlyShown(key, now)
	if key ~= "" then
		recent[key] = now
	end
	-- merge duplicates that are still on screen
	for _, item in active do
		if item.Text == text or sameMessage(item.Key, key) then
			item.Expires = math.max(item.Expires, now + (duration or DEFAULT_DURATION))
			if isRecent then
				return -- the same notice twice in a row (e.g. server + client): show it once
			end
			item.Count += 1
			item.Label.Text = item.Text .. "  x" .. item.Count
			Style.Pop(item.Frame, 0.06)
			return
		end
	end
	for _, entry in queue do
		if entry.Text == text or sameMessage(normalise(entry.Text), key) then
			return
		end
	end
	if isRecent then
		return -- already shown and dismissed a moment ago
	end
	if #queue >= MAX_QUEUED then
		table.remove(queue, 1)
	end
	table.insert(
		queue,
		{ Text = text, Kind = kind or "Info", Duration = duration or DEFAULT_DURATION, Queued = os.clock() }
	)
	pump()
end

function Toasts.Init()
	getContainer()
	Reveal.Closed:Connect(function()
		-- deferred: Closed fires before Reveal shows the next queued reveal; a chained reveal
		-- must keep holding toasts instead of letting them pop in under its headline
		task.defer(pump)
	end)
	task.spawn(function()
		Remotes.Get("Notify").OnClientEvent:Connect(function(kind: any, text: any)
			if typeof(text) == "string" then
				Toasts.Show(text, if typeof(kind) == "string" then kind else "Info")
			elseif typeof(kind) == "string" and text == nil then
				Toasts.Show(kind, "Info")
			end
		end)
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="163">
            <Properties>
              <string name="Name">TreasurePopup</string>
              <string name="Source"><![CDATA[--!strict
--[[
	TreasurePopup — TreasureFound(treasureId, rarity) through the shared Reveal popup
	(UI/Reveal): rarity word, card with the spinning treasure (Models.Treasure), RARITY / VALUE /
	FOUND IN rows and a "NEW!" tag on first discovery. Common..Epic finds use the compact,
	non-blocking reveal (keeps digging smooth); Legendary/Mythic get the full popup with a
	flash + confetti. Reveals queue so rapid finds never overlap.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local Style = require(script.Parent.Components.Style)
local Reveal = require(script.Parent.Reveal)
local State = require(script.Parent.Parent.Controllers.State)
local ModelFactory = require(script.Parent.Parent.Util.ModelFactory)

local TreasurePopup = {}

type Entry = { Id: string, Rarity: string, IsNew: boolean }

local seen: { [string]: boolean } = {}
local seeded = false

local function seed()
	if seeded or not State.Loaded then
		return
	end
	seeded = true
	for id in State.Data.Index or {} :: { [string]: boolean } do
		seen[id] = true
	end
end

local C = Style.Colors

local function show(entry: Entry)
	local def = Config.GetTreasure(entry.Id)
	local rarity = Config.GetRarity(entry.Rarity) or (if def then Config.GetRarity(def.Rarity) else nil)
	local order = if rarity then rarity.Order else 1
	local color = if rarity then rarity.Color else C.Text
	local rows: { Reveal.Row } = { { Label = "RARITY", Value = entry.Rarity, Color = color } }
	if def then
		table.insert(rows, { Label = "VALUE", Value = Format.Abbreviate(def.SellValue) .. " coins", Color = C.Money })
		local layer = Config.Layers[def.Layer]
		if layer then
			table.insert(rows, { Label = "FOUND IN", Value = layer.Name, Color = C.Time })
		end
	end
	local big = order >= 5
	Reveal.Show({
		Headline = string.upper(entry.Rarity) .. "!",
		Color = color,
		Gradient = if rarity then rarity.Gradient else nil,
		Caption = if entry.IsNew then "NEW TREASURE!" else "TREASURE!",
		Items = {
			{
				Name = if def then def.Name else entry.Id,
				NameColor = color,
				Model = ModelFactory.Treasure(entry.Id),
				Pitch = 20,
				Spin = entry.Id ~= "lost_flip_flop",
				Rows = rows,
				Tag = if entry.IsNew then "NEW!" else nil,
			},
		},
		Compact = not big,
		Hold = if big then 4 elseif entry.IsNew then 3 else 2.2,
		Sound = if big then "RareTreasure" elseif order >= 4 then "RareTreasure" else "Treasure",
		Flash = big,
		Confetti = big,
	})
end

function TreasurePopup.Show(treasureId: string, rarity: string?)
	seed()
	local def = Config.GetTreasure(treasureId)
	local isNew = not seen[treasureId]
	seen[treasureId] = true
	local rarityName: string = rarity or (if def then def.Rarity :: string else "Common")
	show({ Id = treasureId, Rarity = rarityName, IsNew = isNew })
end

function TreasurePopup.Init()
	State.LoadedSignal:Connect(seed)
	task.spawn(function()
		Remotes.Get("TreasureFound").OnClientEvent:Connect(function(treasureId: any, rarity: any)
			if typeof(treasureId) == "string" then
				TreasurePopup.Show(treasureId, if typeof(rarity) == "string" then rarity else nil)
			end
		end)
	end)
end

return TreasurePopup
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="164">
            <Properties>
              <string name="Name">UIEffects</string>
              <string name="Source"><![CDATA[--!strict
-- Screen-space juice: icons flying into a HUD counter (coin rain on sell), screen flash,
-- confetti and floating "+123" numbers next to HUD elements.
local Debris = game:GetService("Debris")

local Root = require(script.Parent.Root)
local Style = require(script.Parent.Components.Style)
local AtlasIcon = require(script.Parent.Components.AtlasIcon)
local State = require(script.Parent.Parent.Controllers.State)

local UIEffects = {}

local function canvas(): Frame
	return Root.Get("Popups")
end

-- Absolute screen position -> design-px position inside the Popups canvas.
local function toCanvas(absolute: Vector2): Vector2
	local c = canvas()
	return (absolute - c.AbsolutePosition) / Root.Scale
end

local function centerOf(gui: GuiObject): Vector2
	return toCanvas(gui.AbsolutePosition + gui.AbsoluteSize / 2)
end

local function lowGraphics(): boolean
	return State.GetSetting("LowGraphics", false) == true or State.GetSetting("ReducedMotion", false) == true
end

-- Icons (AtlasIcon keys) burst out from `from` (design px; default screen centre) and fly
-- into `target`.
function UIEffects.FlyTo(icon: string, target: GuiObject, count: number?, from: Vector2?, onArrive: (() -> ())?)
	if State.GetSetting("ReducedMotion", false) == true then
		if onArrive then
			onArrive()
		end
		return
	end
	local c = canvas()
	local start = from or (c.AbsoluteSize / Root.Scale) / 2
	local finish = centerOf(target)
	local n = if lowGraphics() then math.min(count or 8, 4) else (count or 8)
	for i = 1, n do
		local label = AtlasIcon.new({
			Icon = icon,
			Size = UDim2.fromOffset(44, 44),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(start.X, start.Y),
			ZIndex = 50,
			Parent = c,
		}).Frame
		local angle = math.random() * math.pi * 2
		local radius = 50 + math.random() * 70
		local scatter = start + Vector2.new(math.cos(angle), math.sin(angle)) * radius
		Style.PopIn(label, 0.2)
		local out = Style.Tween(
			label,
			0.3,
			{ Position = UDim2.fromOffset(scatter.X, scatter.Y) },
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		)
		out.Completed:Once(function()
			task.wait(0.04 * i)
			local fly = Style.Tween(
				label,
				0.45,
				{ Position = UDim2.fromOffset(finish.X, finish.Y), Size = UDim2.fromOffset(24, 24) },
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			)
			fly.Completed:Once(function()
				label:Destroy()
				if i == 1 and onArrive then
					onArrive()
				end
				Style.Pop(target, 0.12)
			end)
		end)
		Debris:AddItem(label, 3)
	end
end

-- "+1.2K" rising from a HUD element.
function UIEffects.FloatFrom(target: GuiObject, text: string, color: Color3?)
	local c = canvas()
	local pos = centerOf(target) + Vector2.new(target.AbsoluteSize.X / Root.Scale / 2 + 10, 0)
	local label = Style.Label({
		Text = text,
		Size = UDim2.fromOffset(160, 34),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(pos.X, pos.Y),
		TextColor = color or Style.Colors.Success,
		Font = Style.Fonts.Number,
		MaxTextSize = 28,
		XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 3,
		ZIndex = 40,
		Parent = c,
	})
	Style.PopIn(label, 0.25)
	if State.GetSetting("ReducedMotion", false) ~= true then
		Style.Tween(label, 1.1, { Position = UDim2.fromOffset(pos.X + 6, pos.Y - 40) }, Enum.EasingStyle.Quad)
	end
	task.delay(0.7, function()
		Style.Tween(label, 0.4, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			Style.Tween(stroke, 0.4, { Transparency = 1 })
		end
	end)
	Debris:AddItem(label, 1.4)
end

function UIEffects.Flash(color: Color3?, strength: number?)
	if State.GetSetting("ReducedMotion", false) == true then
		return
	end
	local c = canvas()
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.BackgroundColor3 = color or Color3.new(1, 1, 1)
	flash.BackgroundTransparency = 1 - (strength or 0.6)
	flash.Size = UDim2.fromScale(3, 3)
	flash.Position = UDim2.fromScale(0.5, 0.5)
	flash.AnchorPoint = Vector2.new(0.5, 0.5)
	flash.ZIndex = 60
	flash.Parent = c
	Style.Tween(flash, 0.5, { BackgroundTransparency = 1 })
	Debris:AddItem(flash, 0.6)
end

function UIEffects.Confetti(count: number?, colors: { Color3 }?)
	if State.GetSetting("ReducedMotion", false) == true then
		return
	end
	local c = canvas()
	local size = c.AbsoluteSize / Root.Scale
	local palette: { Color3 } = colors
		or { Style.Colors.Coral, Style.Colors.Gold, Style.Colors.Ocean, Style.Colors.Palm, Style.Colors.Purple }
	local n = if lowGraphics() then 12 else (count or 40)
	for _ = 1, n do
		local piece = Instance.new("Frame")
		piece.Name = "Confetti"
		piece.BorderSizePixel = 0
		piece.BackgroundColor3 = palette[math.random(1, #palette)]
		piece.Size = UDim2.fromOffset(math.random(8, 14), math.random(14, 22))
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		local x = math.random() * size.X
		piece.Position = UDim2.fromOffset(x, -20)
		piece.Rotation = math.random(0, 360)
		piece.ZIndex = 55
		piece.Parent = c
		local duration = 1.4 + math.random() * 1.2
		Style.Tween(piece, duration, {
			Position = UDim2.fromOffset(x + (math.random() - 0.5) * 220, size.Y + 30),
			Rotation = piece.Rotation + math.random(-540, 540),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(piece, duration + 0.1)
	end
end

return UIEffects
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="165">
          <Properties>
            <string name="Name">Util</string>
          </Properties>
          <Item class="ModuleScript" referent="166">
            <Properties>
              <string name="Name">Anchors</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Anchors (v2.3): station positions that are always on the client, even when the station
	itself has streamed out. Written by the server's StreamingService as attributes on
	ReplicatedStorage.WorldAnchors.<Tag> (Count = n, P1..Pn = Vector3). Non-spatial folders always
	replicate, so these are present no matter where the player is.

	API
	  Anchors.Get(tag) -> { Vector3 }               every published position (may be empty)
	  Anchors.Nearest(tag, from?) -> Vector3?       closest published position
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Anchors = {}

Anchors.FOLDER = "WorldAnchors"

function Anchors.Get(tag: string): { Vector3 }
	local list: { Vector3 } = {}
	local root = ReplicatedStorage:FindFirstChild(Anchors.FOLDER)
	local holder = if root then root:FindFirstChild(tag) else nil
	if not holder then
		return list
	end
	local count = holder:GetAttribute("Count")
	if typeof(count) ~= "number" then
		return list
	end
	for i = 1, count do
		local value = holder:GetAttribute("P" .. i)
		if typeof(value) == "Vector3" then
			table.insert(list, value)
		end
	end
	return list
end

function Anchors.Nearest(tag: string, from: Vector3?): Vector3?
	local best: Vector3? = nil
	local bestDistance = math.huge
	for _, position in Anchors.Get(tag) do
		local distance = if from then (position - from).Magnitude else 0
		if distance < bestDistance then
			best = position
			bestDistance = distance
		end
	end
	return best
end

return Anchors
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="167">
            <Properties>
              <string name="Name">Character</string>
              <string name="Source"><![CDATA[--!strict
-- Character lookups shared by controllers.
local Players = game:GetService("Players")

local Character = {}

function Character.GetRoot(player: Player?): BasePart?
	local p = player or Players.LocalPlayer
	local character = p.Character
	if character then
		local root = character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			return root
		end
	end
	return nil
end

function Character.GetHumanoid(player: Player?): Humanoid?
	local p = player or Players.LocalPlayer
	local character = p.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			return humanoid
		end
	end
	return nil
end

function Character.GetTool(player: Player?): Tool?
	local p = player or Players.LocalPlayer
	local character = p.Character
	if character then
		return character:FindFirstChildOfClass("Tool")
	end
	return nil
end

return Character
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="168">
            <Properties>
              <string name="Name">ModelFactory</string>
              <string name="Source"><![CDATA[--!strict
-- Safe wrappers around Shared.Models: the Modeling area may still be in progress, so every
-- builder call is pcall'd and falls back to a simple coloured placeholder from Config.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Models = require(Shared:WaitForChild("Models"))

local ModelFactory = {}

local function placeholder(name: string, color: Color3, size: Vector3, shape: Enum.PartType?): Model
	local model = Instance.new("Model")
	model.Name = name
	local part = Instance.new("Part")
	part.Name = "Root"
	part.Anchored = true
	part.CanCollide = false
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.Shape = shape or Enum.PartType.Block
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	model.PrimaryPart = part
	return model
end

local function build(builder: (string) -> Model, id: string, fallback: () -> Model): Model
	local ok, result = pcall(builder, id)
	if ok and typeof(result) == "Instance" and result:IsA("Model") then
		return result
	end
	if not ok then
		warn("[ModelFactory] builder failed for", id, result)
	end
	return fallback()
end

-- Anchors everything, disables collisions/queries so client-side visuals never interfere.
function ModelFactory.MakeVisualOnly(model: Model, castShadow: boolean?)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = castShadow == true
			d.Massless = true
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
end

function ModelFactory.Shovel(id: string): Model
	return build(Models.Shovel, id, function()
		local def = Config.GetShovel(id)
		return placeholder(id, if def then def.Look.HeadColor else Color3.new(1, 0.5, 0.2), Vector3.new(0.6, 4, 0.6))
	end)
end

function ModelFactory.Pet(id: string): Model
	return build(Models.Pet, id, function()
		local def = Config.GetPet(id)
		local size = if def then def.Look.Size * 1.6 else 1.6
		return placeholder(
			id,
			if def then def.Look.BodyColor else Color3.new(1, 0.5, 0.4),
			Vector3.new(size, size, size),
			Enum.PartType.Ball
		)
	end)
end

-- v2.2 Golden pets (PetInstance.Golden): tint every part toward gold, add a little shine and a
-- gold sparkle on the biggest part. Client-side only (followers and viewports). Idempotent.
local GOLD = Color3.fromRGB(255, 205, 60)

function ModelFactory.MakeGolden(model: Model): Model
	if model:GetAttribute("Golden") == true then
		return model
	end
	model:SetAttribute("Golden", true)
	local biggest: BasePart? = nil
	local biggestVolume = -1
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Color = d.Color:Lerp(GOLD, 0.6)
			d.Reflectance = math.max(d.Reflectance, 0.25)
			local volume = d.Size.X * d.Size.Y * d.Size.Z
			if volume > biggestVolume then
				biggest, biggestVolume = d, volume
			end
		end
	end
	if biggest then
		local sparkles = Instance.new("Sparkles")
		sparkles.Name = "GoldenSparkles"
		sparkles.SparkleColor = GOLD
		sparkles.Parent = biggest
	end
	return model
end

function ModelFactory.Egg(id: string): Model
	return build(Models.Egg, id, function()
		local def = Config.GetEgg(id)
		return placeholder(
			id,
			if def then def.Look.ShellColor else Color3.new(1, 0.95, 0.8),
			Vector3.new(2, 2.6, 2),
			Enum.PartType.Ball
		)
	end)
end

function ModelFactory.Treasure(id: string): Model
	return build(Models.Treasure, id, function()
		local def = Config.GetTreasure(id)
		return placeholder(id, if def then def.Look.Color else Color3.new(1, 0.8, 0.2), Vector3.new(1.2, 1.2, 1.2))
	end)
end

function ModelFactory.Backpack(id: string): Model
	return build(Models.Backpack, id, function()
		local def = Config.GetBackpack(id)
		return placeholder(id, if def then def.Look.Color else Color3.new(0.3, 0.6, 1), Vector3.new(1.6, 1.8, 1))
	end)
end

return ModelFactory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="169">
            <Properties>
              <string name="Name">Progress</string>
              <string name="Source"><![CDATA[--!strict
-- Derived progress for quests / daily rewards / rebirth, mirroring the server rules in Config.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local Progress = {}

function Progress.Now(): number
	return Workspace:GetServerTimeNow()
end

function Progress.Today(): number
	return math.floor(Progress.Now() // 86400)
end

-- (progress, claimed) for a quest, applying the daily reset rule client-side.
function Progress.Quest(quest: Types.QuestDef, data: Types.PlayerData): (number, boolean)
	local entry = data.Quests and data.Quests[quest.Id]
	local progress = 0
	local claimed = false
	if entry then
		if quest.Reset == "Daily" and entry.Day ~= nil and entry.Day ~= Progress.Today() then
			progress = 0
			claimed = false
		else
			progress = entry.Progress or 0
			claimed = entry.Claimed == true
		end
	end
	if quest.Kind == "ReachDepth" then
		progress = math.max(progress, data.MaxDepth or 0)
	elseif quest.Kind == "Rebirth" and quest.Reset == "Once" then
		progress = math.max(progress, data.Rebirths or 0)
	end
	return math.min(progress, quest.Target), claimed
end

function Progress.ClaimableQuests(data: Types.PlayerData): number
	local count = 0
	for _, quest in Config.Quests do
		local progress, claimed = Progress.Quest(quest, data)
		if not claimed and progress >= quest.Target then
			count += 1
		end
	end
	return count
end

function Progress.SecondsToDailyReset(): number
	local now = Progress.Now()
	return 86400 - (now % 86400)
end

export type DailyStatus = {
	CanClaim: boolean,
	NextIn: number, -- seconds until claimable (0 if now)
	NextStreak: number, -- DailyStreak after the next claim
	NextDay: number, -- 1..#DailyRewards reward index of the next claim
	ClaimedThroughDay: number, -- days already claimed in the current 7-day cycle
	Broken: boolean,
}

function Progress.Daily(data: Types.PlayerData): DailyStatus
	local now = Progress.Now()
	local last = data.LastDailyClaim or 0
	local streak = data.DailyStreak or 0
	local elapsed = now - last
	local canClaim = last == 0 or elapsed >= Config.DAILY_COOLDOWN_SECONDS
	local broken = last ~= 0 and elapsed > Config.DAILY_STREAK_GRACE_SECONDS
	local nextStreak = if broken then 1 else streak + 1
	local cycle = #Config.DailyRewards
	local nextDay = ((nextStreak - 1) % cycle) + 1
	return {
		CanClaim = canClaim,
		NextIn = if canClaim then 0 else Config.DAILY_COOLDOWN_SECONDS - elapsed,
		NextStreak = nextStreak,
		NextDay = nextDay,
		ClaimedThroughDay = nextDay - 1,
		Broken = broken,
	}
end

function Progress.CanRebirth(data: Types.PlayerData): boolean
	return (data.Coins or 0) >= Config.RebirthCost(data.Rebirths or 0)
end

-- v2.2: Rebirth Tokens can buy the next level of some Rebirth Perk.
function Progress.CanBuyRebirthPerk(data: Types.PlayerData): boolean
	local tokens = data.RebirthTokens or 0
	for _, def in Config.RebirthPerks.List do
		local cost = Config.RebirthPerks.NextCost(data.RebirthPerks, def.Id)
		if cost and tokens >= cost then
			return true
		end
	end
	return false
end

return Progress
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="170">
            <Properties>
              <string name="Name">RewardText</string>
              <string name="Source"><![CDATA[--!strict
-- Human-readable reward summaries for quests, daily rewards and products.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local RewardText = {}

function RewardText.Parts(reward: Types.Reward, maxDepth: number): { string }
	local parts = {}
	local coins = Config.ResolveCoins(reward, maxDepth)
	if coins > 0 then
		table.insert(parts, "💰 " .. Format.Abbreviate(coins))
	end
	if reward.RebirthTokens and reward.RebirthTokens > 0 then
		table.insert(
			parts,
			"🔷 " .. reward.RebirthTokens .. " Token" .. (if reward.RebirthTokens > 1 then "s" else "")
		)
	end
	if reward.Boost then
		local boost = Config.GetBoost(reward.Boost)
		local minutes = math.floor((reward.BoostSeconds or 0) / 60)
		table.insert(parts, "⚡ " .. (if boost then boost.Name else reward.Boost) .. " " .. minutes .. "m")
	end
	if reward.Pet then
		local pet = Config.GetPet(reward.Pet)
		table.insert(parts, "🐾 " .. (if pet then pet.Name else reward.Pet))
	end
	if reward.Egg then
		local egg = Config.GetEgg(reward.Egg)
		table.insert(parts, "🥚 " .. (if egg then egg.Name else reward.Egg) .. " x" .. (reward.EggCount or 1))
	end
	if reward.Rebirth then
		table.insert(parts, "♻️ Free Rebirth")
	end
	return parts
end

function RewardText.Describe(reward: Types.Reward, maxDepth: number, separator: string?): string
	return table.concat(RewardText.Parts(reward, maxDepth), separator or "  ")
end

return RewardText
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="171">
            <Properties>
              <string name="Name">Signal</string>
              <string name="Source"><![CDATA[--!strict
-- Tiny closure-based signal used by the client store, controllers and UI.
-- Handlers run via task.spawn so one erroring listener never breaks the others.

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	Wait: (self: Signal) -> ...any,
	DisconnectAll: (self: Signal) -> (),
}

local Signal = {}

function Signal.new(): Signal
	local handlers: { [Connection]: (...any) -> () } = {}
	local signal: Signal

	local function connect(_: Signal, fn: (...any) -> ()): Connection
		local connection: Connection
		connection = {
			Connected = true,
			Disconnect = function(self: Connection)
				self.Connected = false
				handlers[connection] = nil
			end,
		}
		handlers[connection] = fn
		return connection
	end

	signal = {
		Connect = connect,
		Once = function(self: Signal, fn: (...any) -> ()): Connection
			local connection: Connection? = nil
			connection = connect(self, function(...)
				if connection then
					connection:Disconnect()
				end
				fn(...)
			end)
			return connection :: Connection
		end,
		Fire = function(_: Signal, ...: any)
			local connections: { Connection } = {}
			local fns: { (...any) -> () } = {}
			for connection, fn in handlers do
				table.insert(connections, connection)
				table.insert(fns, fn)
			end
			for i, connection in connections do
				if connection.Connected then
					task.spawn(fns[i], ...)
				end
			end
		end,
		Wait = function(self: Signal): ...any
			local thread = coroutine.running()
			self:Once(function(...)
				task.spawn(thread, ...)
			end)
			return coroutine.yield()
		end,
		DisconnectAll = function(_: Signal)
			for connection in handlers do
				connection.Connected = false
			end
			table.clear(handlers)
		end,
	}
	return signal
end

return Signal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="172">
            <Properties>
              <string name="Name">Tagged</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Tagged (v2.3): streaming-safe CollectionService watchers for the client.

	With Workspace.StreamingEnabled a tagged part may not exist when a controller starts, may
	stream in later, may stream OUT (the client's copy is removed) and come back as a NEW instance.
	Rules this module enforces:
	  - never assume a tagged instance exists at start: existing + InstanceAdded are both handled;
	  - InstanceRemoved (and Destroying / leaving the DataModel) runs the cleanup, so connections
	    made for a streamed-out instance are disconnected and nothing keeps a dead reference;
	  - lookups (Nearest) only return instances that are currently in the Workspace.

	API
	  Tagged.Watch(tag, onAdded) -> stop()
	      onAdded(inst) may return a cleanup function, called once when inst goes away.
	  Tagged.WatchPrompts(tag, onTriggered) -> stop()
	      onTriggered(inst, prompt) for every ProximityPrompt in or under a tagged instance,
	      including prompts that arrive after the part (streaming order is not guaranteed).
	  Tagged.Nearest(tag, from?) -> BasePart?
	      nearest streamed-in BasePart with the tag (or the PrimaryPart / first part of a tagged
	      Model). For something far away use Util/Anchors, whose positions are always present.
]]
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Tagged = {}

export type Cleanup = () -> ()

function Tagged.Watch(tag: string, onAdded: (inst: Instance) -> Cleanup?): () -> ()
	local cleanups: { [Instance]: Cleanup | boolean } = {}
	local connections: { RBXScriptConnection } = {}

	local function remove(inst: Instance)
		local cleanup = cleanups[inst]
		if cleanup == nil then
			return
		end
		cleanups[inst] = nil
		if type(cleanup) == "function" then
			local fn = cleanup :: Cleanup
			local ok, err = pcall(function()
				fn()
			end)
			if not ok then
				warn("[Tagged] cleanup failed for " .. tag .. ": " .. tostring(err))
			end
		end
	end

	local function add(inst: Instance)
		if cleanups[inst] ~= nil then
			return
		end
		cleanups[inst] = true -- reserve: onAdded may yield
		local ok, result = pcall(onAdded, inst)
		if not ok then
			warn("[Tagged] " .. tag .. " handler failed: " .. tostring(result))
		end
		if cleanups[inst] == nil then
			-- removed while the handler ran
			if ok and type(result) == "function" then
				pcall(result)
			end
			return
		end
		cleanups[inst] = if ok and type(result) == "function" then result else true
	end

	table.insert(connections, CollectionService:GetInstanceAddedSignal(tag):Connect(add))
	table.insert(connections, CollectionService:GetInstanceRemovedSignal(tag):Connect(remove))
	for _, inst in CollectionService:GetTagged(tag) do
		task.spawn(add, inst)
	end

	return function()
		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)
		local list = {}
		for inst in cleanups do
			table.insert(list, inst)
		end
		for _, inst in list do
			remove(inst)
		end
	end
end

function Tagged.WatchPrompts(tag: string, onTriggered: (inst: Instance, prompt: ProximityPrompt) -> ()): () -> ()
	return Tagged.Watch(tag, function(inst: Instance): Cleanup?
		local connections: { RBXScriptConnection } = {}
		local hooked: { [ProximityPrompt]: boolean } = {}
		local function hook(prompt: ProximityPrompt)
			if hooked[prompt] then
				return
			end
			hooked[prompt] = true
			table.insert(
				connections,
				prompt.Triggered:Connect(function()
					onTriggered(inst, prompt)
				end)
			)
		end
		if inst:IsA("ProximityPrompt") then
			hook(inst)
		else
			for _, d in inst:GetDescendants() do
				if d:IsA("ProximityPrompt") then
					hook(d)
				end
			end
			table.insert(
				connections,
				inst.DescendantAdded:Connect(function(d: Instance)
					if d:IsA("ProximityPrompt") then
						hook(d)
					end
				end)
			)
		end
		return function()
			for _, connection in connections do
				connection:Disconnect()
			end
			table.clear(connections)
			table.clear(hooked)
		end
	end)
end

-- The part to aim at for a tagged instance (BasePart, or a tagged Model's PrimaryPart / first part).
function Tagged.PartOf(inst: Instance): BasePart?
	if inst:IsA("BasePart") then
		return inst
	elseif inst:IsA("Model") then
		return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

function Tagged.Nearest(tag: string, from: Vector3?): BasePart?
	local best: BasePart? = nil
	local bestDistance = math.huge
	for _, inst in CollectionService:GetTagged(tag) do
		if not inst:IsDescendantOf(Workspace) then
			continue
		end
		local part = Tagged.PartOf(inst)
		if part then
			local distance = if from then (part.Position - from).Magnitude else 0
			if distance < bestDistance then
				best = part
				bestDistance = distance
			end
		end
	end
	return best
end

return Tagged
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="173">
            <Properties>
              <string name="Name">Track</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Track — fire-and-forget client UI analytics ("Track" remote -> server Analytics.OnTrack,
	which whitelists names/arguments and rate-limits; see docs/ANALYTICS.md).
		Track.Send("panel_opened", "Shop")
		Track.Send("purchase_prompted", "GamePass", "AutoDig")
		Track.Send("menu_unlocked", "Eggs")
	A small client-side budget keeps a stuck UI loop from spamming the remote.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Track = {}

local BUDGET = 6 -- events per WINDOW seconds (server allows 8 per 5 s)
local WINDOW = 5
local windowStart = 0
local used = 0

function Track.Send(name: string, a: string?, b: string?)
	local now = os.clock()
	if now - windowStart >= WINDOW then
		windowStart = now
		used = 0
	end
	if used >= BUDGET then
		return
	end
	used += 1
	task.spawn(function()
		pcall(function()
			Remotes.Get("Track"):FireServer(name, a, b)
		end)
	end)
end

return Track
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
