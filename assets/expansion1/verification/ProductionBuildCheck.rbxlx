      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Models — procedural low-poly model builders (no mesh / texture asset ids).
	Safe to require on server and client (no services). Every call returns a FRESH, unparented
	Model with all parts Anchored and a PrimaryPart. Unknown ids return a pleasant fallback.

	Conventions (see each module header for details):
	- Front is -Z, up is +Y.
	- Shovel: PrimaryPart = Part "Handle" (grip). Other parts WeldConstraint'ed to Handle and
	  Massless. Handle attribute "GripOffset" (CFrame) -> assign to Tool.Grip.
	- Pet / Egg / Prop: PrimaryPart = invisible "Root" at the bottom-centre.
	- Treasure: PrimaryPart = invisible "Root" at the visual centre (for ViewportFrames).
	- Backpack: PrimaryPart = invisible "Root" at the centre of the face touching the torso's
	  back; pack extends to +Z. Weld at torso.CFrame * CFrame.new(0, 0, torso.Size.Z / 2)
	  (Root attribute "AttachOffset" = CFrame.new(0, 0, 0.5)). All parts Massless.
	- Pets, eggs, treasures, backpacks are welded to Root too (inert while anchored).
]]

local Shovels = require(script.Shovels)
local Pets = require(script.Pets)
local Eggs = require(script.Eggs)
local Treasures = require(script.Treasures)
local Backpacks = require(script.Backpacks)
local Props = require(script.Props)
local Shades = require(script.Shades)
local Consumables = require(script.Consumables)
local Diggers = require(script.Diggers)
local Rides = require(script.Rides)

local Models = {}

function Models.Shovel(shovelId: string): Model
	return Shovels.Build(shovelId)
end

function Models.Pet(petId: string): Model
	return Pets.Build(petId)
end

function Models.Egg(eggId: string): Model
	return Eggs.Build(eggId)
end

function Models.Treasure(treasureId: string): Model
	return Treasures.Build(treasureId)
end

-- v3 discovery: a treasure with its size + material variant (Config.Discovery) applied.
function Models.Find(treasureId: string, size: string?, material: string?): Model
	return Treasures.ApplyVariant(Treasures.Build(treasureId), size, material)
end

function Models.Backpack(backpackId: string): Model
	return Backpacks.Build(backpackId)
end

-- `variant` (optional, default 1) deterministically varies colours / shape.
function Models.Prop(name: string, variant: number?): Model
	return Props.Build(name, variant)
end

function Models.ListProps(): { string }
	return Props.List()
end

-- v2 (Survival agent: Shade, Consumable). Models.Digger(id): a vehicle pet id (or vehicle Kind)
-- at full vehicle size (scale 1); Models.Pet(id) draws the same vehicle at pet scale.
function Models.Shade(shadeId: string): Model
	return Shades.Build(shadeId)
end

function Models.Consumable(consumableId: string): Model
	return Consumables.Build(consumableId)
end

function Models.Digger(id: string, scale: number?): Model
	return Diggers.Build(id, scale)
end

-- v2.1 (Ride agent): full-size ride-on vehicle for a rideable pet (unanchor-ready, see Rides.luau)
function Models.RideVehicle(petId: string): Model
	return Rides.Build(petId)
end

return Models
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Backpacks</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Backpacks — worn on the character's back.
	PrimaryPart = invisible "Root" at the centre of the pack's CONTACT face (the face touching
	the torso's back). The pack extends towards +Z (behind the character, who faces -Z);
	shoulder straps reach forward to -Z. Weld Root to the torso at
	    torso.CFrame * CFrame.new(0, 0, torso.Size.Z / 2)
	(Root attribute "AttachOffset" = CFrame.new(0, 0, 0.5) for a 1-stud-deep torso).
	All parts Anchored (server unanchors), Massless, CanCollide false, welded to Root.
	A sand-coloured part named "SandFill" exists on open containers (decorative).
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Backpacks = {}

local V = Vector3.new
local CF = CFrame.new
local Z = Vector3.zAxis
local SAND = Color3.fromRGB(255, 222, 140)
local TIRE = Color3.fromRGB(45, 45, 55)
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon

type Ctx = {
	m: Model,
	id: string,
	c: Color3,
	a: Color3,
	mat: Enum.Material,
	am: Enum.Material,
	glow: boolean,
}

type ShapeBuilder = (x: Ctx) -> BasePart

local shapes: { [string]: ShapeBuilder } = {}

shapes.Bucket = function(x)
	local zc = 0.85
	local main = Build.cyl(x.m, "Body", 1.6, 1.6, CF(0, 0, zc), x.c, x.mat)
	Build.cyl(x.m, "Base", 0.3, 1.4, CF(0, -0.85, zc), Build.darken(x.c, 0.1), x.mat)
	Build.cyl(x.m, "Rim", 0.18, 1.78, CF(0, 0.8, zc), x.a, x.am)
	Build.ellipsoid(x.m, "SandFill", V(1.45, 0.5, 1.45), CF(0, 0.82, zc), SAND, Enum.Material.Sand)
	Build.beam(x.m, "Handle", V(-0.84, 0.6, zc), V(-0.55, 1.25, zc), 0.1, 0.1, x.a, x.am, Z)
	Build.beam(x.m, "Handle", V(-0.6, 1.25, zc), V(0.6, 1.25, zc), 0.1, 0.1, x.a, x.am, Z)
	Build.beam(x.m, "Handle", V(0.55, 1.25, zc), V(0.84, 0.6, zc), 0.1, 0.1, x.a, x.am, Z)
	-- star on the outer side
	local back = CF(0, 0, zc + 0.8) * CFrame.Angles(0, math.pi, 0)
	Build.tri(x.m, "Star", back * CF(0, 0.08, 0), 0.6, 0.5, 0.06, x.a, x.am)
	Build.tri(x.m, "Star", back * CF(0, -0.08, 0) * CFrame.Angles(0, 0, math.pi), 0.6, 0.5, 0.06, x.a, x.am)
	return main
end

shapes.Bag = function(x)
	local sack = string.find(x.id, "sack") ~= nil
	local bc, bs = V(0, -0.05, 0.65), V(1.8, 1.9, 1.2)
	local main = Build.ellipsoid(x.m, "Body", bs, CF(bc), x.c, x.mat)
	Build.ellipsoid(x.m, "Pocket", V(1.0, 0.75, 0.3), Build.surface(bc, bs, V(0, -0.35, 1)), x.a, x.am)
	if sack then
		Build.cyl(x.m, "Rope", 0.3, 0.55, CF(0, 0.95, 0.65), x.a, x.am)
		Build.ellipsoid(x.m, "Top", V(0.95, 0.5, 0.95), CF(0, 1.22, 0.65), x.c, x.mat)
		Build.part(x.m, "Patch", V(0.45, 0.45, 0.1), Build.surface(bc, bs, V(0.6, 0.4, 1)), x.a, x.am)
	else
		Build.ellipsoid(x.m, "Flap", V(1.7, 0.6, 1.1), CF(0, 0.68, 0.66), Build.darken(x.c, 0.12), x.mat)
		Build.ball(x.m, "Button", 0.24, Build.surface(V(0, 0.68, 0.66), V(1.7, 0.6, 1.1), V(0, -0.3, 1)), x.a, x.am)
	end
	return main
end

shapes.Box = function(x)
	local zc = 0.62
	local main = Build.part(x.m, "Body", V(1.9, 1.4, 1.2), CF(0, -0.1, zc), x.c, x.mat)
	Build.part(x.m, "Lid", V(2.0, 0.3, 1.3), CF(0, 0.72, zc), x.a, x.am)
	for side = -1, 1, 2 do
		Build.part(x.m, "HandlePost", V(0.12, 0.25, 0.12), CF(side * 0.5, 0.95, zc), Build.darken(x.a, 0.2))
	end
	Build.part(x.m, "Handle", V(1.12, 0.12, 0.16), CF(0, 1.08, zc), Build.darken(x.a, 0.2))
	Build.part(x.m, "Latch", V(0.3, 0.35, 0.1), CF(0, 0.45, zc + 0.62), x.a, x.am)
	Build.part(x.m, "Stripe", V(1.92, 0.18, 1.22), CF(0, -0.45, zc), x.a, x.am)
	return main
end

shapes.Barrel = function(x)
	local zc = 0.8
	local main = Build.cyl(x.m, "Body", 1.9, 1.5, CF(0, 0, zc), x.c, x.mat)
	Build.cyl(x.m, "Bulge", 1.0, 1.62, CF(0, 0, zc), x.c, x.mat)
	for _, y in { 0.62, -0.62 } do
		Build.cyl(x.m, "Hoop", 0.14, 1.6, CF(0, y, zc), x.a, if x.glow then NEON else Enum.Material.Metal)
	end
	Build.cyl(x.m, "Lid", 0.06, 1.38, CF(0, 0.94, zc), Build.darken(x.c, 0.2), x.mat)
	Build.ellipsoid(x.m, "SandFill", V(1.2, 0.4, 1.2), CF(0, 0.95, zc), SAND, Enum.Material.Sand)
	return main
end

local function wheel(m: Model, pos: Vector3, axis: Vector3, d: number, hub: Color3)
	Build.cylBetween(m, "Wheel", pos - axis * 0.09, pos + axis * 0.09, d, TIRE)
	Build.cylBetween(m, "Hub", pos - axis * 0.11, pos + axis * 0.11, d * 0.45, hub)
end

shapes.Cart = function(x)
	local zc = 0.7
	local main = Build.part(x.m, "Body", V(2.0, 1.0, 1.3), CF(0, 0, zc), x.c, x.mat)
	Build.part(x.m, "Lip", V(2.12, 0.16, 1.42), CF(0, 0.5, zc), x.a, x.am)
	Build.part(x.m, "Band", V(2.04, 0.14, 1.34), CF(0, -0.2, zc), Build.darken(x.c, 0.2), x.mat)
	Build.ellipsoid(x.m, "SandFill", V(1.8, 0.7, 1.1), CF(0, 0.55, zc), SAND, Enum.Material.Sand)
	for _, px in { -0.65, 0.65 } do
		for _, pz in { zc - 0.6, zc + 0.6 } do
			wheel(x.m, V(px, -0.55, pz), Z, 0.5, x.a)
		end
	end
	return main
end

shapes.Vehicle = function(x)
	if string.find(x.id, "ship") then
		local zc = 0.6
		local main = Build.part(x.m, "Hull", V(2.3, 0.7, 1.1), CF(-0.05, -0.5, zc), x.c, x.mat)
		Build.triPts(x.m, "Bow", V(1.1, -0.5, zc), V(1.65, -0.5, zc), Z, 1.1, 0.7, x.c, x.mat)
		Build.part(x.m, "Stripe", V(2.32, 0.15, 1.12), CF(-0.05, -0.22, zc), x.a, x.am)
		local cols = { Color3.fromRGB(230, 60, 60), Color3.fromRGB(255, 200, 40), Color3.fromRGB(60, 190, 100) }
		for i, col in cols do
			Build.part(x.m, "Container", V(0.55, 0.45, 0.9), CF(-0.35 + (i - 1) * 0.6, 0.08, zc), col)
		end
		Build.part(x.m, "Bridge", V(0.45, 0.85, 0.85), CF(-0.95, 0.25, zc), Color3.fromRGB(245, 245, 245))
		Build.part(
			x.m,
			"Windows",
			V(0.47, 0.14, 0.87),
			CF(-0.95, 0.5, zc),
			Color3.fromRGB(120, 210, 255),
			if x.glow then NEON else Enum.Material.Glass
		)
		Build.cyl(x.m, "Funnel", 0.45, 0.3, CF(-0.95, 0.88, zc), x.a, x.am)
		return main
	end
	-- dump / sand truck, length along X, wheels on the ±Z sides
	local zc = 0.65
	local main = Build.part(x.m, "Bed", V(1.5, 0.7, 1.15), CF(0.4, -0.12, zc) * CFrame.Angles(0, 0, 0.15), x.c, x.mat)
	Build.ellipsoid(
		x.m,
		"SandFill",
		V(1.3, 0.55, 1.0),
		CF(0.42, 0.25, zc) * CFrame.Angles(0, 0, 0.15),
		SAND,
		Enum.Material.Sand
	)
	Build.part(x.m, "Chassis", V(2.4, 0.3, 1.2), CF(0, -0.62, zc), x.a, x.am)
	Build.part(x.m, "Cab", V(0.8, 0.95, 1.1), CF(-0.8, -0.1, zc), x.c, x.mat)
	Build.part(
		x.m,
		"Window",
		V(0.5, 0.35, 1.14),
		CF(-0.75, 0.08, zc),
		Color3.fromRGB(140, 210, 255),
		Enum.Material.Glass
	)
	Build.part(
		x.m,
		"Bumper",
		V(0.12, 0.2, 1.2),
		CF(-1.25, -0.55, zc),
		Color3.fromRGB(220, 220, 225),
		Enum.Material.Metal
	)
	for _, px in { -0.8, 0.75 } do
		for _, pz in { zc - 0.62, zc + 0.62 } do
			wheel(x.m, V(px, -0.8, pz), Z, 0.6, Color3.fromRGB(220, 220, 225))
		end
	end
	return main
end

shapes.Orb = function(x)
	local zc = 1.0
	Build.part(x.m, "Harness", V(0.8, 0.8, 0.3), CF(0, 0, 0.15), Color3.fromRGB(60, 55, 75), Enum.Material.Metal)
	local main = Build.ball(x.m, "Orb", 1.7, CF(0, 0.05, zc), x.c, x.mat)
	Build.ball(x.m, "Core", 0.9, CF(0, 0.05, zc), Build.darken(x.c, 0.5), SMOOTH)
	main.Transparency = math.max(main.Transparency, 0.25)
	Build.cyl(x.m, "Ring", 0.06, 2.5, CF(0, 0.05, zc) * CFrame.Angles(0.45, 0, 0.3), x.a, NEON)
	return main
end

local FALLBACK: Types.BackpackLook = {
	Color = Color3.fromRGB(60, 170, 255),
	AccentColor = Color3.fromRGB(255, 230, 60),
	Shape = "Bucket",
	Material = SMOOTH,
	Glow = false,
}

local function build(id: string, look: Types.BackpackLook): Model
	local m = Build.model(id)
	local root = Build.root(m, CFrame.identity, V(0.6, 0.6, 0.1))
	root:SetAttribute("AttachOffset", CF(0, 0, 0.5))
	local ctx: Ctx = {
		m = m,
		id = id,
		c = look.Color,
		a = look.AccentColor,
		mat = look.Material,
		am = if look.Glow then NEON else SMOOTH,
		glow = look.Glow,
	}
	local builder = shapes[look.Shape] or shapes.Bucket
	local main = builder(ctx)

	-- shoulder straps (over the shoulders onto the chest)
	local strap = Build.darken(look.AccentColor, 0.25)
	for side = -1, 1, 2 do
		Build.part(m, "Strap", V(0.25, 0.08, 1.05), CF(side * 0.5, 0.86, -0.48), strap)
		Build.part(m, "Strap", V(0.25, 1.1, 0.08), CF(side * 0.5, 0.33, -1.03), strap)
	end

	if look.Glow then
		Build.glow(main, look.AccentColor, 1.2, 8)
		Build.sparkle(main, look.AccentColor, 4)
	end
	Build.massless(m, root)
	root.Massless = true
	Build.weldAll(m, root)
	return m
end

function Backpacks.Build(backpackId: string): Model
	local def = Config.GetBackpack(backpackId)
	return build(backpackId, if def then def.Look else FALLBACK)
end

function Backpacks.FromLook(name: string, look: Types.BackpackLook): Model
	return build(name, look)
end

return Backpacks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Build — shared procedural-geometry helpers for every model builder.
	Pure Instance construction: no services, safe on server and client.

	Conventions used by all builders:
	- Models are built around the world origin and returned unparented.
	- "Front" is -Z (LookVector), "up" is +Y, exactly like a Roblox character.
	- Every part is Anchored, CanCollide/CanQuery/CanTouch false by default; use Build.solid()
	  for parts players should stand on / bump into.
	- Cylinders: Build.cyl takes a CFrame whose **Y axis** is the cylinder axis (the helper
	  applies the Roblox X-axis correction internally).
	- Triangles: Build.tri builds a flat isosceles triangle (two WedgeParts) in the CFrame's XY
	  plane, apex towards +Y, thickness along Z.
]]

local Build = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local SMOOTH = Enum.Material.SmoothPlastic
local HALF_PI = math.pi / 2

Build.EYE = Color3.fromRGB(25, 22, 35)
Build.MOUTH = Color3.fromRGB(120, 30, 45)
Build.CHEEK = Color3.fromRGB(255, 140, 165)

-- Colour helpers ----------------------------------------------------------------------------

function Build.lighten(c: Color3, t: number): Color3
	return c:Lerp(WHITE, t)
end

function Build.darken(c: Color3, t: number): Color3
	return c:Lerp(BLACK, t)
end

-- Neon renders its colour as emitted light, so pale / near-white Neon blows out to a blinding
-- white blob under Future lighting + bloom (playtest feedback). Every Neon part made through
-- these helpers is clamped: brightness (HSV value) capped and pale colours re-saturated, so
-- glows stay clearly coloured. White highlights (eye shines) become a soft light grey.
local NEON_MAX_V = 0.78
local NEON_MIN_S = 0.45

function Build.neonSafe(c: Color3): Color3
	local h, s, v = c:ToHSV()
	if s > 0.08 then
		s = math.max(s, NEON_MIN_S)
	end
	return Color3.fromHSV(h, s, math.min(v, NEON_MAX_V))
end

-- Deterministic small hash for per-id variation.
function Build.hash(s: string): number
	local h = 7
	for i = 1, #s do
		h = (h * 31 + string.byte(s, i)) % 1000003
	end
	return h
end

-- Part factories ----------------------------------------------------------------------------

local function setup(p: BasePart, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?)
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	local mat = material or SMOOTH
	p.Material = mat
	if mat == Enum.Material.Neon then
		p.Color = Build.neonSafe(color)
	end
	if mat == Enum.Material.Glass then
		p.Transparency = 0.3
	elseif mat == Enum.Material.Ice then
		p.Transparency = 0.15
	elseif mat == Enum.Material.ForceField then
		p.Transparency = 0.1
	end
	if math.max(size.X, size.Y, size.Z) < 0.6 then
		p.CastShadow = false
	end
end

function Build.part(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	setup(p, name, size, cf, color, material)
	p.Parent = parent
	return p
end

function Build.ball(
	parent: Instance,
	name: string,
	diameter: number,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	setup(p, name, Vector3.new(diameter, diameter, diameter), cf, color, material)
	p.Parent = parent
	return p
end

-- Stretched sphere (Part + built-in Sphere SpecialMesh, no asset ids).
function Build.ellipsoid(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	setup(p, name, size, cf, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	p.Parent = parent
	return p
end

-- Cylinder whose axis is the Y axis of `cf`.
function Build.cyl(
	parent: Instance,
	name: string,
	length: number,
	diameter: number,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	setup(p, name, Vector3.new(length, diameter, diameter), cf * CFrame.Angles(0, 0, HALF_PI), color, material)
	p.Parent = parent
	return p
end

function Build.wedge(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): WedgePart
	local p = Instance.new("WedgePart")
	setup(p, name, size, cf, color, material)
	p.Parent = parent
	return p
end

-- Orientation helpers -----------------------------------------------------------------------

-- CFrame at `pos` whose Y axis points along `yDir`; X axis follows `xHint` as closely as possible.
function Build.orient(pos: Vector3, yDir: Vector3, xHint: Vector3?): CFrame
	local y = yDir.Unit
	local hint = xHint
	if hint == nil or math.abs(hint.Unit:Dot(y)) > 0.98 then
		hint = if math.abs(y.Y) < 0.95 then Vector3.yAxis:Cross(y) else Vector3.xAxis
	end
	local h = hint :: Vector3
	local x = (h - y * h:Dot(y)).Unit
	return CFrame.fromMatrix(pos, x, y)
end

-- Cylinder from point a to point b.
function Build.cylBetween(
	parent: Instance,
	name: string,
	a: Vector3,
	b: Vector3,
	diameter: number,
	color: Color3,
	material: Enum.Material?
): Part
	local d = b - a
	return Build.cyl(parent, name, d.Magnitude, diameter, Build.orient(a:Lerp(b, 0.5), d), color, material)
end

-- Block from a to b (Y = length), `width` along xHint, `thick` along the remaining axis.
function Build.beam(
	parent: Instance,
	name: string,
	a: Vector3,
	b: Vector3,
	width: number,
	thick: number,
	color: Color3,
	material: Enum.Material?,
	xHint: Vector3?
): Part
	local d = b - a
	return Build.part(
		parent,
		name,
		Vector3.new(width, d.Magnitude, thick),
		Build.orient(a:Lerp(b, 0.5), d, xHint),
		color,
		material
	)
end

-- Flat isosceles triangle centred on `cf`: apex at +Y (h/2), base at -Y, width along X,
-- thickness along Z. Two WedgeParts.
function Build.tri(
	parent: Instance,
	name: string,
	cf: CFrame,
	w: number,
	h: number,
	t: number,
	color: Color3,
	material: Enum.Material?
): (WedgePart, WedgePart)
	local size = Vector3.new(t, h, w / 2)
	-- Wedge local: full height at +Z (back), zero at -Z (front). Map local +Z to -X / +X.
	local right = cf * CFrame.fromMatrix(Vector3.new(w / 4, 0, 0), Vector3.zAxis, Vector3.yAxis, -Vector3.xAxis)
	local left = cf * CFrame.fromMatrix(Vector3.new(-w / 4, 0, 0), -Vector3.zAxis, Vector3.yAxis, Vector3.xAxis)
	local a = Build.wedge(parent, name, size, right, color, material)
	local b = Build.wedge(parent, name, size, left, color, material)
	return a, b
end

-- Triangle from a base-centre point to an apex point, width along widthDir.
function Build.triPts(
	parent: Instance,
	name: string,
	base: Vector3,
	apex: Vector3,
	widthDir: Vector3,
	w: number,
	t: number,
	color: Color3,
	material: Enum.Material?
)
	local d = apex - base
	Build.tri(parent, name, Build.orient(base:Lerp(apex, 0.5), d, widthDir), w, d.Magnitude, t, color, material)
end

-- Cheap low-poly cone / horn / crystal: two crossed triangles (4 wedges).
function Build.spike(
	parent: Instance,
	name: string,
	base: Vector3,
	apex: Vector3,
	w: number,
	color: Color3,
	material: Enum.Material?
)
	local d = apex - base
	local cf = Build.orient(base:Lerp(apex, 0.5), d)
	local h = d.Magnitude
	Build.tri(parent, name, cf, w, h, w * 0.28, color, material)
	Build.tri(parent, name, cf * CFrame.Angles(0, HALF_PI, 0), w, h, w * 0.28, color, material)
end

-- Point on the surface of an axis-aligned ellipsoid (centre, full size) in direction `dir`,
-- oriented so LookVector is the outward surface normal. Use for spots, plates, patches.
function Build.surface(centre: Vector3, size: Vector3, dir: Vector3): CFrame
	local a, b, c = size.X / 2, size.Y / 2, size.Z / 2
	local d = dir.Unit
	local t = 1 / math.sqrt((d.X / a) ^ 2 + (d.Y / b) ^ 2 + (d.Z / c) ^ 2)
	local p = centre + d * t
	local rel = d * t
	local n = Vector3.new(rel.X / (a * a), rel.Y / (b * b), rel.Z / (c * c)).Unit
	local up = if math.abs(n.Y) > 0.99 then Vector3.zAxis else Vector3.yAxis
	return CFrame.lookAt(p, p + n, up)
end

-- Faces -------------------------------------------------------------------------------------

export type FaceOpts = {
	spacing: number?, -- eye half-distance at scale 1 (default 0.28)
	eye: number?, -- eye diameter at scale 1 (default 0.3)
	mouth: boolean?, -- default true
	cheeks: boolean?, -- default true
	eyeColor: Color3?,
	radius: number?, -- surface curvature radius in studs (features sink to follow it); nil = flat
	eyes: boolean?, -- default true
}

-- Cute face. `cf` sits on the surface, LookVector pointing out of the face.
function Build.face(parent: Instance, cf: CFrame, s: number, opts: FaceOpts?)
	local o: FaceOpts = opts or {}
	local spacing = (o.spacing or 0.28) * s
	local eyeD = (o.eye or 0.3) * s
	local eyeColor = o.eyeColor or Build.EYE
	local radius: number = o.radius or 0 -- 0 = flat
	local function sink(dx: number, dy: number): number
		local r = radius
		if r <= 0 then
			return 0
		end
		local d2 = dx * dx + dy * dy
		local r2 = r * r
		return if d2 < r2 then r - math.sqrt(r2 - d2) else r
	end
	for side = -1, 1, 2 do
		local ex, ey = side * spacing, 0.08 * s
		local eyeCf = cf * CFrame.new(ex, ey, sink(ex, ey) - 0.02 * s)
		if o.eyes ~= false then
			Build.ball(parent, "Eye", eyeD, eyeCf, eyeColor)
			Build.ball(
				parent,
				"EyeShine",
				eyeD * 0.38,
				eyeCf * CFrame.new(0.22 * eyeD, 0.22 * eyeD, -0.36 * eyeD),
				WHITE,
				Enum.Material.Neon
			)
		end
		if o.cheeks ~= false then
			local cx, cy = side * (spacing + 0.2 * s), -0.1 * s
			Build.ellipsoid(
				parent,
				"Cheek",
				Vector3.new(0.22, 0.12, 0.08) * s,
				cf
					* CFrame.new(cx, cy, sink(cx, cy) - 0.005 * s)
					* CFrame.Angles(0, -math.asin(math.clamp(if radius > 0 then cx / radius else 0, -0.9, 0.9)), 0),
				Build.CHEEK
			)
		end
	end
	if o.mouth ~= false then
		local my = -0.14 * s
		Build.ellipsoid(
			parent,
			"Mouth",
			Vector3.new(0.24, 0.12, 0.08) * s,
			cf * CFrame.new(0, my, sink(0, my) - 0.01 * s),
			Build.MOUTH
		)
	end
end

-- Model plumbing ----------------------------------------------------------------------------

function Build.model(name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	return m
end

-- Invisible pivot part (becomes PrimaryPart).
function Build.root(model: Model, cf: CFrame, size: Vector3?): Part
	local r = Build.part(model, "Root", size or Vector3.new(1, 0.2, 1), cf, WHITE)
	r.Transparency = 1
	r.CastShadow = false
	model.PrimaryPart = r
	return r
end

function Build.setPivot(model: Model, primary: BasePart)
	model.PrimaryPart = primary
end

-- Players collide with / stand on this part.
function Build.solid(p: BasePart): BasePart
	p.CanCollide = true
	p.CanQuery = true
	p.CanTouch = true
	return p
end

function Build.glow(p: BasePart, color: Color3, brightness: number?, range: number?): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	-- Scaled down: model glows read as coloured auras, not white hot spots.
	light.Brightness = (brightness or 1.5) * 0.6
	light.Range = range or 8
	light.Shadows = false
	light.Parent = p
	return light
end

-- Texture-less sparkle emitter (uses the engine's default particle).
function Build.sparkle(p: BasePart, color: Color3, rate: number?): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = "Sparkles"
	e.Color = ColorSequence.new(color, WHITE)
	e.LightEmission = 0.45
	e.LightInfluence = 0
	e.Rate = rate or 5
	e.Lifetime = NumberRange.new(0.8, 1.5)
	e.Speed = NumberRange.new(0.4, 1.2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.4, 0.3),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Parent = p
	return e
end

-- Uniformly scale every part about `origin` (call BEFORE weldAll).
function Build.scale(model: Model, origin: CFrame, s: number)
	if math.abs(s - 1) < 1e-4 then
		return
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local rel = origin:ToObjectSpace(d.CFrame)
			d.Size = d.Size * s
			d.CFrame = origin * CFrame.new(rel.Position * s) * rel.Rotation
		elseif d:IsA("PointLight") then
			d.Range = d.Range * s
		end
	end
end

-- Apply a rigid transform (about the world origin) to every part except `except`.
function Build.transform(model: Model, cf: CFrame, except: BasePart?)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= except then
			d.CFrame = cf * d.CFrame
		end
	end
end

-- WeldConstraint every BasePart to `root` (inert while anchored; ready for unanchoring).
function Build.weldAll(model: Model, root: BasePart)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = d
		end
	end
end

-- Mark everything except `root` massless (worn / held models).
function Build.massless(model: Model, root: BasePart)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			d.Massless = true
		end
	end
end

-- Text on a part face (SurfaceGui, no assets). The TextLabel is named "Label".
function Build.label(p: BasePart, face: Enum.NormalId, text: string, textColor: Color3?, strokeColor: Color3?)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "LabelGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.3
	local t = Instance.new("TextLabel")
	t.Name = "Label"
	t.Size = UDim2.fromScale(0.92, 0.86)
	t.Position = UDim2.fromScale(0.04, 0.07)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = textColor or WHITE
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = strokeColor or Color3.fromRGB(35, 30, 60)
	stroke.Parent = t
	t.Parent = gui
	gui.Parent = p
end

-- Count BaseParts (QA / budgets).
function Build.count(model: Model): number
	local n = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Consumables</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Consumables — drinks & snacks (Config.Consumables), ~1.5 studs tall, chunky cartoon style.
	PrimaryPart = invisible "Root" at the VISUAL CENTRE (like treasures) so ViewportFrames and
	hand-held / pop-up effects frame them without offsets. Front is -Z. Everything anchored,
	nothing collides.
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local ConsumableModels = {}

local V = Vector3.new
local CF = CFrame.new
local rgb = Color3.fromRGB
local PI = math.pi
local M = Enum.Material

local WHITE = rgb(255, 255, 255)
local RIND = rgb(60, 160, 70)
local RIND_DARK = rgb(35, 110, 50)
local SEED = rgb(35, 25, 30)

type Builder = (m: Model, color: Color3) -> ()

local builders: { [string]: Builder } = {}

-- All builders work in a box roughly 1.0 x 1.5 x 1.0 centred on the origin.

local function straw(m: Model, from: Vector3, to: Vector3, color: Color3)
	local n = 4
	for i = 0, n - 1 do
		local a = from:Lerp(to, i / n)
		local b = from:Lerp(to, (i + 1) / n)
		Build.cylBetween(m, "Straw", a, b, 0.09, if i % 2 == 0 then WHITE else color)
	end
end

builders.Bottle = function(m, color)
	Build.cyl(m, "Body", 1.0, 0.75, CF(0, -0.2, 0), color, M.Glass)
	Build.cyl(m, "Water", 0.8, 0.62, CF(0, -0.28, 0), Build.lighten(color, 0.3))
	Build.cyl(m, "Label", 0.34, 0.77, CF(0, -0.2, 0), WHITE)
	Build.label(Build.part(m, "LabelFace", V(0.4, 0.3, 0.02), CF(0, -0.2, -0.39), WHITE), Enum.NormalId.Front, "💧")
	Build.cyl(m, "Shoulder", 0.25, 0.55, CF(0, 0.42, 0), color, M.Glass)
	Build.cyl(m, "Neck", 0.2, 0.3, CF(0, 0.6, 0), color, M.Glass)
	Build.cyl(m, "Cap", 0.16, 0.36, CF(0, 0.74, 0), rgb(40, 120, 255))
end

builders.Cup = function(m, color)
	Build.cyl(m, "Cup", 1.1, 0.8, CF(0, -0.2, 0), WHITE)
	Build.cyl(m, "Band", 0.3, 0.82, CF(0, -0.2, 0), color)
	Build.cyl(m, "Drink", 0.06, 0.7, CF(0, 0.33, 0), color)
	-- lemon wheel on the rim
	local wheel = CF(0.32, 0.38, -0.2) * CFrame.Angles(PI / 2, 0, 0.3)
	Build.cyl(m, "Lemon", 0.1, 0.5, wheel, rgb(255, 220, 40))
	Build.cyl(m, "LemonPith", 0.11, 0.38, wheel, rgb(255, 250, 200))
	straw(m, V(-0.12, 0.0, 0.05), V(-0.3, 0.78, 0.15), rgb(255, 90, 120))
end

builders.Coconut = function(m, color)
	Build.ball(m, "Shell", 1.1, CF(0, -0.15, 0), color)
	Build.cyl(m, "Cut", 0.06, 0.62, CF(0, 0.37, 0), rgb(250, 245, 230))
	Build.cyl(m, "Milk", 0.07, 0.5, CF(0, 0.38, 0), WHITE)
	straw(m, V(0.05, 0.2, 0), V(0.3, 0.75, 0.05), rgb(60, 200, 255))
	-- tiny cocktail umbrella
	Build.cylBetween(m, "UmbrellaStick", V(-0.15, 0.3, 0.05), V(-0.35, 0.78, 0.1), 0.05, rgb(230, 200, 140))
	Build.spike(m, "Umbrella", V(-0.37, 0.72, 0.1), V(-0.4, 0.92, 0.11), 0.55, rgb(255, 110, 170))
	-- coconut "eyes"
	for side = -1, 1, 2 do
		Build.ball(m, "Dot", 0.14, CF(side * 0.16, 0.05, -0.5), Build.darken(color, 0.4))
	end
end

builders.Popsicle = function(m, color)
	local top = Build.lighten(color, 0.25)
	Build.part(m, "Pop", V(0.65, 0.85, 0.3), CF(0, 0.05, 0), color)
	Build.cyl(m, "PopTop", 0.3, 0.65, CF(0, 0.475, 0) * CFrame.Angles(PI / 2, 0, 0), color)
	Build.part(m, "Stripe", V(0.67, 0.18, 0.32), CF(0, 0.2, 0), top)
	Build.part(m, "Stripe", V(0.67, 0.18, 0.32), CF(0, -0.15, 0), rgb(255, 230, 90))
	Build.part(m, "Stick", V(0.16, 0.55, 0.08), CF(0, -0.6, 0), rgb(230, 200, 140), M.Wood)
	Build.ball(m, "Drip", 0.14, CF(0.2, -0.38, -0.1), color)
end

builders.ShavedIce = function(m, color)
	-- paper cone (point down)
	Build.spike(m, "Cone", V(0, 0.05, 0), V(0, -0.75, 0), 0.85, WHITE)
	Build.cyl(m, "Rim", 0.12, 0.8, CF(0, 0.08, 0), rgb(255, 120, 160))
	-- rainbow ice dome
	Build.ball(m, "Ice", 0.9, CF(0, 0.38, 0), WHITE, M.Ice)
	Build.ball(m, "Syrup", 0.62, CF(-0.18, 0.5, -0.12), color)
	Build.ball(m, "Syrup", 0.58, CF(0.2, 0.48, 0.1), rgb(255, 90, 140))
	Build.ball(m, "Syrup", 0.5, CF(0.02, 0.66, 0.12), rgb(255, 230, 80))
	Build.cylBetween(m, "Spoon", V(0.15, 0.4, -0.2), V(0.35, 0.9, -0.3), 0.08, rgb(255, 140, 40))
end

builders.Slice = function(m, color)
	local t = 0.45
	-- triangle wedge, apex down
	local flesh = CF(0, 0.05, 0) * CFrame.Angles(0, 0, PI)
	Build.tri(m, "Flesh", flesh, 1.5, 1.2, t, color)
	Build.part(m, "Pith", V(1.55, 0.1, t + 0.02), CF(0, 0.66, 0), rgb(240, 250, 220))
	Build.part(m, "Rind", V(1.6, 0.18, t + 0.04), CF(0, 0.78, 0), RIND)
	for _, p in { V(-0.35, 0.35, 0), V(0.35, 0.35, 0), V(0, 0.1, 0), V(-0.15, -0.2, 0), V(0.15, -0.2, 0) } do
		Build.ellipsoid(m, "Seed", V(0.09, 0.15, t + 0.06), CF(p), SEED)
	end
end

builders.Melon = function(m, color)
	local size = V(1.4, 1.2, 1.6)
	Build.ellipsoid(m, "Melon", size, CF(0, -0.05, 0), color)
	for k = 0, 4 do
		local a = k / 5 * PI
		Build.ellipsoid(
			m,
			"Stripe",
			V(0.16, size.Y * 1.02, size.Z * 1.02),
			CF(0, -0.05, 0) * CFrame.Angles(0, a, 0),
			RIND_DARK
		)
	end
	Build.cylBetween(m, "Stem", V(0, 0.5, 0), V(0.08, 0.72, 0.02), 0.12, rgb(120, 85, 50))
	Build.triPts(m, "Leaf", V(0.05, 0.62, 0), V(0.42, 0.7, -0.1), V(0, 0, 1), 0.3, 0.05, rgb(90, 200, 100))
end

-- Public --------------------------------------------------------------------------------------------

function ConsumableModels.Build(id: string): Model
	local def: Types.ConsumableDef? = Config.GetConsumable(id)
	local m = Build.model(id)
	Build.root(m, CFrame.identity, V(0.2, 0.2, 0.2))
	local look: { [string]: any } = if def then def.Look else {}
	local color: Color3 = if typeof(look.Color) == "Color3" then look.Color else rgb(255, 235, 90)
	local style = if type(look.Style) == "string" then look.Style else "Cup"
	local builder = builders[style] or builders.Cup
	builder(m, color)
	m:SetAttribute("ConsumableId", id)
	return m
end

return ConsumableModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Diggers</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Diggers — chunky cartoon construction vehicles from primitives (no asset ids), one builder per
	vehicle Kind. Roughly 3-6 studs long at scale 1.

	v2.1: the Garage diggers became vehicle PETS (Config/Pets.luau, PetDef.VehicleKind = the Kind
	here, colours from PetDef.Look). Models.Pet(id) draws vehicle pets through Diggers.Build(id,
	Look.Size). The Ride agent may reuse these builders read-only (Diggers.FromLook / Kinds).

	API:
	  Diggers.Build(id, scale?)               id = a vehicle pet id (or a Kind name); scale default 1
	  Diggers.FromLook(name, look, scale?)    look = { Kind, Body: Color3, Accent: Color3, Glow }
	  Diggers.Kinds(): { string }             every Kind with a dedicated builder

	Conventions (Models/Build.luau):
	- PrimaryPart = invisible "Root" at the bottom-centre (pivot on the ground), front = -Z.
	- Every part Anchored, CanCollide / CanQuery / CanTouch false, so a digger never blocks the
	  dig raycasts or players. Static parts are welded to Root (inert while anchored).
	- Moving assemblies are sub-Models with an invisible PrimaryPart "Hinge" (NOT welded) and
	  the attributes the client animator reads:
	      Motion  "Swing"  rotate about the hinge's X axis by Amount * sin(pi * t)  (arms, buckets)
	              "Tip"    same as Swing, slower ease (dump beds)
	              "Spin"   rotate about the hinge's Y axis, Amount radians per second while digging
	              "Drill"  Spin + plunge along the hinge's +Y by Plunge studs * sin(pi * t)
	  Drill / Spin hinges have their Y axis along the bit (pointing where it digs).
	      Amount  number   radians (Swing / Tip) or radians per second (Spin / Drill)
	      Plunge  number?  studs (Drill)
	  Names: "Arm", "Loader", "Bed", "Blade", "Drill", "Cutter".
	- Model attributes "Kind" = Look.Kind and "Scale" = the build scale (Plunge is pre-scaled).
]]

local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Diggers = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis
local Y = Vector3.yAxis
local Z = Vector3.zAxis
local WHITE = Color3.new(1, 1, 1)
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local GLASS = Enum.Material.Glass

local TYRE = Color3.fromRGB(40, 38, 45)
local HUB = Color3.fromRGB(200, 200, 210)
local WINDOW = Color3.fromRGB(150, 220, 255)
local STEEL = Color3.fromRGB(150, 155, 165)
local SAND = Color3.fromRGB(240, 205, 130)

type Ctx = {
	m: Model,
	B: Color3, -- body
	A: Color3, -- accent
	am: Enum.Material, -- accent material (Neon when Glow)
	glow: boolean,
}

type KindBuilder = (c: Ctx) -> BasePart -- returns the main body part (for glow / sparkles)

local kinds: { [string]: KindBuilder } = {}

-- Helpers -----------------------------------------------------------------------------------

-- Moving sub-assembly. Parts built into the returned model are animated around `hinge`.
local function joint(parent: Instance, name: string, hinge: CFrame, motion: string, amount: number): Model
	local j = Instance.new("Model")
	j.Name = name
	local h = Build.part(j, "Hinge", V(0.2, 0.2, 0.2), hinge, WHITE)
	h.Transparency = 1
	h.CastShadow = false
	j.PrimaryPart = h
	j:SetAttribute("Motion", motion)
	j:SetAttribute("Amount", amount)
	j.Parent = parent
	return j
end

local function wheel(parent: Instance, pos: Vector3, diameter: number, width: number, hubColor: Color3?)
	Build.cyl(parent, "Wheel", width, diameter, Build.orient(pos, X), TYRE)
	local side = if pos.X >= 0 then 1 else -1
	Build.cyl(
		parent,
		"Hub",
		0.08,
		diameter * 0.5,
		Build.orient(pos + V(side * width / 2, 0, 0), X),
		hubColor or HUB,
		METAL
	)
end

-- Crawler track along Z at x, bottom on the ground.
local function track(parent: Instance, x: number, length: number, height: number, width: number)
	local y = height / 2
	Build.part(parent, "Track", V(width, height, length - height), CF(x, y, 0), TYRE)
	for _, z in { -(length - height) / 2, (length - height) / 2 } do
		Build.cyl(parent, "Track", width, height, Build.orient(V(x, y, z), X), TYRE)
	end
	local side = if x >= 0 then 1 else -1
	local n = math.max(2, math.floor(length / 1.1))
	for i = 0, n - 1 do
		local z = -(length - height) / 2 + (length - height) * i / (n - 1)
		Build.cyl(parent, "Roller", 0.06, height * 0.55, Build.orient(V(x + side * width / 2, y, z), X), STEEL, METAL)
	end
end

-- Cab box with windows on front and sides and a pair of cartoon eyes on the windshield.
local function cab(parent: Instance, centre: Vector3, size: Vector3, color: Color3, eyes: boolean?)
	Build.part(parent, "Cab", size, CF(centre), color)
	Build.part(parent, "Roof", V(size.X + 0.2, 0.18, size.Z + 0.2), CF(centre + V(0, size.Y / 2 + 0.09, 0)), color)
	local wy = centre.Y + size.Y * 0.12
	local frontZ = centre.Z - size.Z / 2
	Build.part(parent, "Window", V(size.X * 0.8, size.Y * 0.5, 0.06), CF(centre.X, wy, frontZ - 0.02), WINDOW, GLASS)
	for side = -1, 1, 2 do
		Build.part(
			parent,
			"Window",
			V(0.06, size.Y * 0.5, size.Z * 0.7),
			CF(centre.X + side * (size.X / 2 + 0.02), wy, centre.Z),
			WINDOW,
			GLASS
		)
	end
	if eyes ~= false then
		Build.face(parent, CF(centre.X, wy, frontZ - 0.06), math.min(size.X, size.Y) * 0.75, {
			mouth = false,
			cheeks = false,
		})
	end
end

-- Spiral-looking drill bit along the Y axis of `base` (base of the bit at its origin).
local function drillBit(
	parent: Instance,
	base: CFrame,
	length: number,
	diameter: number,
	c1: Color3,
	c2: Color3,
	mat: Enum.Material?
)
	local steps = 4
	local seg = length * 0.75 / steps
	for i = 0, steps - 1 do
		local d = diameter * (1 - i / (steps + 0.6))
		Build.cyl(
			parent,
			"Drill",
			seg,
			d,
			base * CF(0, seg * (i + 0.5), 0) * CFrame.Angles(0, i * 0.6, 0),
			if i % 2 == 0 then c1 else c2,
			if i % 2 == 0 then METAL else mat
		)
	end
	local tipBase = (base * CF(0, length * 0.75, 0)).Position
	local tip = (base * CF(0, length, 0)).Position
	Build.spike(parent, "DrillTip", tipBase, tip, diameter * (1 - steps / (steps + 0.6)) * 1.1, c1, METAL)
end

local function exhaust(parent: Instance, pos: Vector3, height: number)
	Build.cyl(parent, "Exhaust", height, 0.22, CF(pos + V(0, height / 2, 0)), Color3.fromRGB(70, 70, 80), METAL)
	Build.cyl(parent, "Exhaust", 0.08, 0.3, CF(pos + V(0, height, 0)), Color3.fromRGB(40, 40, 45), METAL)
end

local function beacon(parent: Instance, pos: Vector3)
	Build.ball(parent, "Beacon", 0.32, CF(pos), Color3.fromRGB(255, 160, 30), NEON)
end

-- Kinds -------------------------------------------------------------------------------------

kinds.ToyTruck = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.part(m, "Body", V(1.9, 0.5, 3.2), CF(0, 0.75, 0), B)
	for _, z in { -1.05, 1.05 } do
		for side = -1, 1, 2 do
			wheel(m, V(side * 1.0, 0.45, z), 0.9, 0.36)
		end
	end
	cab(m, V(0, 1.45, -0.95), V(1.6, 1.0, 1.1), A)
	Build.part(m, "Bumper", V(1.9, 0.25, 0.2), CF(0, 0.65, -1.65), Color3.fromRGB(255, 255, 255))
	-- tipping bed with a pile of sand, hinge at the rear bottom edge
	local bed = joint(m, "Bed", CF(0, 1.0, 1.55), "Tip", 0.55)
	Build.part(bed, "Bed", V(1.8, 0.12, 1.9), CF(0, 1.06, 0.6), A)
	for side = -1, 1, 2 do
		Build.part(bed, "Bed", V(0.12, 0.55, 1.9), CF(side * 0.84, 1.33, 0.6), A)
	end
	Build.part(bed, "Bed", V(1.8, 0.55, 0.12), CF(0, 1.33, -0.29), A)
	Build.part(bed, "Bed", V(1.8, 0.55, 0.12), CF(0, 1.33, 1.49), A)
	Build.ellipsoid(bed, "Sand", V(1.5, 0.7, 1.5), CF(0, 1.3, 0.6), SAND, Enum.Material.Sand)
	return body
end

kinds.DumpTruck = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.part(m, "Body", V(2.3, 0.55, 4.4), CF(0, 0.95, 0), A)
	for _, z in { -1.5, 0.8, 1.6 } do
		for side = -1, 1, 2 do
			wheel(m, V(side * 1.15, 0.6, z), 1.2, 0.45)
		end
	end
	Build.part(m, "Hood", V(2.1, 0.8, 0.9), CF(0, 1.6, -1.75), B)
	Build.part(m, "Grille", V(1.6, 0.5, 0.06), CF(0, 1.55, -2.22), Color3.fromRGB(60, 60, 70), METAL)
	cab(m, V(0, 2.25, -0.95), V(2.0, 1.2, 1.0), B)
	beacon(m, V(0, 2.98, -0.95))
	local bed = joint(m, "Bed", CF(0, 1.25, 2.15), "Tip", 0.6)
	Build.part(bed, "Bed", V(2.3, 0.16, 2.6), CF(0, 1.33, 0.85), B)
	for side = -1, 1, 2 do
		Build.part(bed, "Bed", V(0.16, 0.95, 2.6), CF(side * 1.07, 1.85, 0.85), B)
	end
	Build.part(bed, "Bed", V(2.3, 1.15, 0.16), CF(0, 1.95, -0.37), B)
	Build.wedge(bed, "Bed", V(2.3, 0.4, 0.6), CF(0, 2.7, -0.6) * CFrame.Angles(0, math.pi, 0), B)
	Build.part(bed, "Bed", V(2.3, 0.85, 0.12), CF(0, 1.8, 2.09), Build.darken(B, 0.15))
	Build.ellipsoid(bed, "Sand", V(1.9, 0.9, 2.2), CF(0, 2.15, 0.85), SAND, Enum.Material.Sand)
	return body
end

kinds.Excavator = function(c)
	local m, B, A = c.m, c.B, c.A
	for side = -1, 1, 2 do
		track(m, side * 0.95, 3.4, 0.75, 0.6)
	end
	Build.part(m, "Turntable", V(1.4, 0.2, 1.4), CF(0, 0.85, 0.1), A, METAL)
	local body = Build.part(m, "Body", V(2.2, 0.9, 2.4), CF(0, 1.4, 0.35), B)
	Build.part(m, "Counterweight", V(2.2, 0.7, 0.5), CF(0, 1.3, 1.65), A)
	cab(m, V(-0.5, 2.35, -0.25), V(1.1, 1.1, 1.1), B)
	exhaust(m, V(0.7, 1.85, 1.0), 0.6)
	-- boom + stick + bucket swing about the boom foot
	local arm = joint(m, "Arm", CF(0.45, 1.7, -0.75), "Swing", -0.5)
	local foot = V(0.45, 1.7, -0.75)
	local elbow = V(0.45, 3.1, -2.1)
	local wrist = V(0.45, 1.3, -3.0)
	Build.beam(arm, "Boom", foot, elbow, 0.45, 0.4, B, SMOOTH, X)
	Build.beam(arm, "Stick", elbow, wrist, 0.35, 0.32, B, SMOOTH, X)
	Build.cylBetween(arm, "Piston", foot + V(0, 0.3, 0.1), elbow + V(0, -0.4, 0.35), 0.16, STEEL, METAL)
	Build.ball(arm, "Elbow", 0.45, CF(elbow), A, METAL)
	local bucket = CF(wrist) * CFrame.Angles(-0.5, 0, 0)
	Build.part(arm, "Bucket", V(0.9, 0.12, 0.8), bucket * CF(0, -0.35, -0.1), A, METAL)
	Build.part(arm, "Bucket", V(0.9, 0.7, 0.12), bucket * CF(0, 0, 0.3), A, METAL)
	for side = -1, 1, 2 do
		Build.part(arm, "Bucket", V(0.1, 0.7, 0.8), bucket * CF(side * 0.45, 0, -0.1), A, METAL)
	end
	for i = -1, 1 do
		Build.spike(
			arm,
			"Tooth",
			(bucket * CF(i * 0.28, -0.4, -0.45)).Position,
			(bucket * CF(i * 0.28, -0.45, -0.75)).Position,
			0.14,
			STEEL,
			METAL
		)
	end
	return body
end

kinds.SkidSteer = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.part(m, "Body", V(1.9, 1.0, 2.4), CF(0, 1.0, 0.3), B)
	for _, z in { -0.55, 1.05 } do
		for side = -1, 1, 2 do
			wheel(m, V(side * 1.1, 0.55, z), 1.1, 0.42)
		end
	end
	cab(m, V(0, 2.1, 0.15), V(1.4, 1.2, 1.3), A)
	Build.part(m, "Engine", V(1.7, 0.5, 0.7), CF(0, 1.75, 1.2), B)
	exhaust(m, V(0.55, 2.0, 1.3), 0.45)
	-- lift arms + bucket pivot behind the cab
	local hinge = V(0, 2.3, 1.1)
	local arm = joint(m, "Arm", CF(hinge), "Swing", -0.35)
	for side = -1, 1, 2 do
		Build.beam(arm, "LiftArm", V(side * 0.95, 2.3, 1.1), V(side * 0.95, 0.85, -1.15), 0.18, 0.3, B, SMOOTH, Z)
	end
	local bucket = CF(0, 0.6, -1.45)
	Build.part(arm, "Bucket", V(2.1, 0.12, 0.8), bucket * CF(0, -0.3, 0), STEEL, METAL)
	Build.part(arm, "Bucket", V(2.1, 0.8, 0.12), bucket * CF(0, 0.05, 0.4), STEEL, METAL)
	for side = -1, 1, 2 do
		Build.part(arm, "Bucket", V(0.1, 0.6, 0.8), bucket * CF(side * 1.05, -0.05, 0), STEEL, METAL)
	end
	Build.ellipsoid(arm, "Sand", V(1.6, 0.45, 0.6), bucket * CF(0, -0.15, 0.05), SAND, Enum.Material.Sand)
	return body
end

kinds.Bulldozer = function(c)
	local m, B, A = c.m, c.B, c.A
	for side = -1, 1, 2 do
		track(m, side * 1.05, 3.8, 0.9, 0.7)
	end
	local body = Build.part(m, "Body", V(1.7, 1.1, 3.0), CF(0, 1.45, 0.2), B)
	Build.part(m, "Hood", V(1.5, 0.35, 1.5), CF(0, 2.15, -0.55), B)
	cab(m, V(0, 2.6, 0.95), V(1.6, 1.2, 1.2), B)
	exhaust(m, V(0.5, 2.3, -0.9), 0.7)
	beacon(m, V(0.55, 3.35, 1.3))
	-- blade on push arms, hinged at the track middle
	local blade = joint(m, "Blade", CF(0, 0.9, 0.2), "Swing", -0.22)
	for side = -1, 1, 2 do
		Build.beam(blade, "PushArm", V(side * 1.5, 0.9, 0.2), V(side * 1.5, 0.75, -2.1), 0.18, 0.28, A, SMOOTH, Z)
	end
	Build.part(blade, "Blade", V(3.4, 1.3, 0.22), CF(0, 0.95, -2.25) * CFrame.Angles(0.15, 0, 0), B)
	Build.part(blade, "BladeEdge", V(3.4, 0.16, 0.3), CF(0, 0.22, -2.35), STEEL, METAL)
	for side = -1, 1, 2 do
		Build.part(blade, "BladeSide", V(0.12, 1.2, 0.5), CF(side * 1.7, 0.95, -2.1), B)
	end
	-- rear ripper
	Build.beam(m, "Ripper", V(0, 1.2, 1.8), V(0, 0.35, 2.3), 0.22, 0.22, A, METAL, X)
	return body
end

kinds.Backhoe = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.part(m, "Body", V(1.9, 0.8, 3.6), CF(0, 1.15, 0), B)
	wheel(m, V(-1.05, 0.55, -1.1), 1.1, 0.45)
	wheel(m, V(1.05, 0.55, -1.1), 1.1, 0.45)
	wheel(m, V(-1.05, 0.8, 1.0), 1.6, 0.5)
	wheel(m, V(1.05, 0.8, 1.0), 1.6, 0.5)
	Build.part(m, "Hood", V(1.5, 0.6, 1.3), CF(0, 1.85, -1.1), B)
	cab(m, V(0, 2.35, 0.55), V(1.7, 1.4, 1.4), B)
	exhaust(m, V(0.5, 2.15, -1.3), 0.6)
	beacon(m, V(0, 3.2, 0.55))
	-- front loader
	local loader = joint(m, "Loader", CF(0, 1.9, -0.3), "Swing", 0.3)
	for side = -1, 1, 2 do
		Build.beam(loader, "LoaderArm", V(side * 1.0, 1.9, -0.3), V(side * 1.0, 0.75, -2.3), 0.16, 0.26, A, SMOOTH, Z)
	end
	Build.part(loader, "Loader", V(2.2, 0.75, 0.14), CF(0, 0.75, -2.5), STEEL, METAL)
	Build.part(loader, "Loader", V(2.2, 0.12, 0.6), CF(0, 0.4, -2.3), STEEL, METAL)
	-- rear arm (the "hoe")
	local arm = joint(m, "Arm", CF(0, 1.5, 1.85), "Swing", 0.45)
	local foot = V(0, 1.5, 1.85)
	local elbow = V(0, 2.9, 2.9)
	local wrist = V(0, 1.0, 3.5)
	Build.beam(arm, "Boom", foot, elbow, 0.35, 0.32, A, SMOOTH, X)
	Build.beam(arm, "Stick", elbow, wrist, 0.3, 0.28, A, SMOOTH, X)
	Build.ball(arm, "Elbow", 0.4, CF(elbow), B, METAL)
	local bucket = CF(wrist) * CFrame.Angles(0.5, math.pi, 0)
	Build.part(arm, "Bucket", V(0.7, 0.1, 0.6), bucket * CF(0, -0.3, -0.1), STEEL, METAL)
	Build.part(arm, "Bucket", V(0.7, 0.6, 0.1), bucket * CF(0, 0, 0.2), STEEL, METAL)
	for side = -1, 1, 2 do
		Build.part(arm, "Bucket", V(0.08, 0.6, 0.6), bucket * CF(side * 0.35, 0, -0.1), STEEL, METAL)
	end
	return body
end

kinds.DrillRig = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.part(m, "Body", V(2.1, 0.6, 3.8), CF(0, 0.95, 0.2), Color3.fromRGB(70, 70, 80))
	for _, z in { -1.2, 0.6, 1.5 } do
		for side = -1, 1, 2 do
			wheel(m, V(side * 1.1, 0.6, z), 1.2, 0.45)
		end
	end
	cab(m, V(0, 1.9, 1.3), V(1.9, 1.3, 1.2), B)
	-- mast
	for side = -1, 1, 2 do
		Build.part(m, "Mast", V(0.18, 4.6, 0.18), CF(side * 0.45, 3.4, -1.5), A, METAL)
	end
	for i = 0, 5 do
		Build.part(m, "Rung", V(0.9, 0.1, 0.1), CF(0, 1.5 + i * 0.75, -1.5), A, METAL)
	end
	Build.part(m, "MastTop", V(1.2, 0.35, 0.6), CF(0, 5.8, -1.5), B)
	beacon(m, V(0, 6.1, -1.5))
	Build.part(m, "Motor", V(0.8, 0.7, 0.7), CF(0, 2.35, -1.5), B)
	local drill = joint(m, "Drill", CFrame.fromMatrix(V(0, 1.95, -1.5), X, -Y), "Drill", 14)
	drill:SetAttribute("Plunge", 0.8)
	Build.cyl(drill, "Shaft", 1.0, 0.25, CF(0, 1.5, -1.5), STEEL, METAL)
	drillBit(drill, CFrame.fromMatrix(V(0, 1.15, -1.5), X, -Y), 1.1, 0.7, STEEL, B)
	return body
end

kinds.MiningDrill = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	-- mine cart body with metal bands on little rail wheels
	local body = Build.part(m, "Body", V(2.0, 1.3, 2.8), CF(0, 1.2, 0.4), B, Enum.Material.WoodPlanks)
	for _, z in { -0.6, 0.4, 1.4 } do
		Build.part(m, "Band", V(2.08, 1.36, 0.14), CF(0, 1.2, z), STEEL, METAL)
	end
	Build.part(m, "Rim", V(2.1, 0.14, 2.9), CF(0, 1.9, 0.4), STEEL, METAL)
	Build.ellipsoid(m, "Ore", V(1.6, 0.8, 2.2), CF(0, 1.9, 0.5), Color3.fromRGB(120, 110, 105), Enum.Material.Slate)
	for _, p in { V(-0.4, 2.2, 0.2), V(0.45, 2.15, 0.9), V(0.1, 2.25, -0.2) } do
		Build.ball(m, "Gem", 0.35, CF(p), A, am)
	end
	for _, z in { -0.5, 1.3 } do
		for side = -1, 1, 2 do
			wheel(m, V(side * 0.85, 0.35, z), 0.7, 0.25, A)
		end
	end
	Build.part(m, "Nose", V(1.6, 1.1, 0.5), CF(0, 1.15, -1.2), STEEL, METAL)
	beacon(m, V(0.7, 2.05, -0.9))
	-- forward drill tilted slightly down
	local axis = V(0, -0.25, -1).Unit
	local drill = joint(m, "Drill", Build.orient(V(0, 1.1, -1.45), axis, X), "Spin", 12)
	drillBit(drill, Build.orient(V(0, 1.1, -1.45), axis, X), 1.6, 1.0, STEEL, A, am)
	return body
end

kinds.TunnelBorer = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	for side = -1, 1, 2 do
		track(m, side * 1.0, 3.6, 0.7, 0.55)
	end
	local body = Build.cyl(m, "Body", 3.4, 2.3, Build.orient(V(0, 1.85, 0.3), Z), B)
	for _, z in { -0.6, 0.6, 1.6 } do
		Build.cyl(m, "Ring", 0.18, 2.45, Build.orient(V(0, 1.85, z), Z), A, am)
	end
	Build.part(m, "Hatch", V(0.9, 0.3, 1.0), CF(0, 3.05, 0.8), Build.darken(B, 0.2))
	beacon(m, V(0, 3.3, 0.8))
	-- round cutter face spinning about the body axis
	local face = Build.orient(V(0, 1.85, -1.5), -Z, X)
	local cutter = joint(m, "Cutter", face, "Spin", 6)
	Build.cyl(cutter, "Cutter", 0.3, 2.6, face, STEEL, METAL)
	Build.cyl(cutter, "Cutter", 0.2, 0.7, face * CF(0, 0.22, 0), A, am)
	for k = 0, 5 do
		local a = k * math.pi / 3
		local dir = (face * CFrame.Angles(0, a, 0)).RightVector
		local base = face.Position + dir * 0.9 - Z * 0.15
		Build.spike(cutter, "Tooth", base, base - Z * 0.45, 0.3, STEEL, METAL)
		Build.beam(cutter, "Spoke", face.Position - Z * 0.17, face.Position + dir * 1.2 - Z * 0.17, 0.18, 0.1, A, am, Z)
	end
	return body
end

kinds.Mole = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	for side = -1, 1, 2 do
		track(m, side * 0.9, 3.2, 0.6, 0.5)
	end
	local body = Build.ellipsoid(m, "Body", V(2.4, 2.0, 3.4), CF(0, 1.6, 0.3), B, METAL)
	Build.ellipsoid(m, "Belly", V(1.8, 1.2, 2.4), CF(0, 1.3, -0.1), Build.lighten(B, 0.25))
	Build.ellipsoid(m, "Head", V(1.6, 1.4, 1.5), CF(0, 1.8, -1.2), B, METAL)
	Build.ball(m, "Nose", 0.45, CF(0, 1.7, -1.98), Color3.fromRGB(255, 130, 170))
	Build.face(m, CF(0, 2.05, -1.86), 0.9, { mouth = false, radius = 0.75 })
	-- Keep the visor above the eye spheres and their highlights; a matte brow avoids neon bloom.
	Build.part(m, "Visor", V(1.2, 0.18, 0.4), CF(0, 2.44, -1.7), Build.darken(A, 0.12), SMOOTH)
	Build.cylBetween(m, "Antenna", V(0.3, 2.5, 0.2), V(0.45, 3.3, 0.4), 0.08, STEEL, METAL)
	Build.ball(m, "AntennaTip", 0.25, CF(0.45, 3.35, 0.4), A, am)
	for side = -1, 1, 2 do
		Build.ellipsoid(m, "Ear", V(0.5, 0.5, 0.2), CF(side * 0.6, 2.5, -1.0), B)
		local axis = V(side * 0.2, -0.3, -1).Unit
		local base = Build.orient(V(side * 1.05, 1.2, -1.3), axis, X)
		local drill = joint(m, "Drill", base, "Spin", 14)
		Build.cyl(drill, "Shoulder", 0.3, 0.6, base, A, am)
		drillBit(drill, base, 1.2, 0.6, STEEL, A, am)
	end
	return body
end

kinds.LavaDrill = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	for side = -1, 1, 2 do
		track(m, side * 1.15, 4.0, 0.9, 0.7)
	end
	local body = Build.part(m, "Body", V(2.0, 1.3, 3.2), CF(0, 1.55, 0.5), B, Enum.Material.Basalt)
	for _, z in { -0.4, 0.5, 1.4 } do
		Build.part(m, "LavaStripe", V(2.06, 0.18, 0.2), CF(0, 1.7, z), A, am)
	end
	Build.part(m, "Tank", V(1.4, 0.9, 1.2), CF(0, 2.6, 1.4), Build.darken(B, 0.2), Enum.Material.CrackedLava)
	cab(m, V(0, 2.75, 0.0), V(1.6, 1.1, 1.1), B)
	exhaust(m, V(-0.6, 2.2, 1.9), 1.0)
	exhaust(m, V(0.6, 2.2, 1.9), 1.0)
	-- frame holding a big downward-angled drill at the front
	for side = -1, 1, 2 do
		Build.beam(m, "Frame", V(side * 0.7, 2.0, -1.0), V(side * 0.7, 2.6, -2.0), 0.22, 0.22, A, am, X)
	end
	Build.part(m, "DrillHead", V(1.6, 0.8, 0.8), CF(0, 2.5, -2.1), B, METAL)
	local base = Build.orient(V(0, 2.1, -2.3), V(0, -1, -0.45).Unit, X)
	local drill = joint(m, "Drill", base, "Drill", 16)
	drill:SetAttribute("Plunge", 0.5)
	drillBit(drill, base, 2.1, 1.1, Color3.fromRGB(90, 80, 80), A, am)
	return body
end

kinds.CoreDriller = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	for side = -1, 1, 2 do
		track(m, side * 1.25, 4.4, 1.0, 0.75)
	end
	local body = Build.part(m, "Body", V(2.2, 1.4, 3.4), CF(0, 1.7, 0.6), B, METAL)
	for side = -1, 1, 2 do
		Build.wedge(m, "Fin", V(0.15, 0.9, 1.4), CF(side * 1.12, 2.8, 1.8), A, am)
	end
	cab(m, V(0, 3.0, 0.4), V(1.7, 1.2, 1.3), B)
	Build.ball(m, "Orb", 0.7, CF(0, 3.9, 1.4), A, am)
	for side = -1, 1, 2 do
		Build.beam(m, "Frame", V(side * 0.8, 2.0, -0.9), V(side * 0.8, 2.6, -2.2), 0.25, 0.25, B, METAL, X)
	end
	Build.cyl(m, "DrillHousing", 0.9, 1.6, Build.orient(V(0, 2.4, -2.2), V(0, -1, -0.5).Unit, X), B, METAL)
	local base = Build.orient(V(0, 2.0, -2.45), V(0, -1, -0.5).Unit, X)
	local drill = joint(m, "Drill", base, "Drill", 18)
	drill:SetAttribute("Plunge", 0.6)
	drillBit(drill, base, 2.4, 1.3, B, A, am)
	for k = 1, 3 do
		Build.cyl(drill, "DrillRing", 0.12, 1.3 * (1 - k * 0.2) + 0.15, base * CF(0, 0.45 * k, 0), A, am)
	end
	return body
end

export type VehicleLook = {
	Kind: string,
	Body: Color3,
	Accent: Color3,
	Glow: boolean,
}

local FALLBACK_LOOK: VehicleLook =
	{ Kind = "ToyTruck", Body = Color3.fromRGB(255, 210, 50), Accent = Color3.fromRGB(240, 70, 70), Glow = false }

-- Builder -----------------------------------------------------------------------------------

function Diggers.FromLook(name: string, look: VehicleLook, scale: number?): Model
	local kind = look.Kind
	local glow = look.Glow == true
	local s = math.clamp(scale or 1, 0.2, 5)

	local m = Build.model(name)
	m:SetAttribute("Kind", kind)
	m:SetAttribute("Scale", s)
	local root = Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local ctx: Ctx = { m = m, B = look.Body, A = look.Accent, am = if glow then NEON else SMOOTH, glow = glow }
	local builder = kinds[kind] or kinds.ToyTruck
	local main = builder(ctx)
	if glow then
		Build.glow(main, look.Accent, 1, 9)
		Build.sparkle(main, look.Accent, 2)
	end
	if math.abs(s - 1) > 1e-4 then
		Build.scale(m, CFrame.identity, s)
		for _, d in m:GetDescendants() do
			if d:IsA("Model") and typeof(d:GetAttribute("Plunge")) == "number" then
				d:SetAttribute("Plunge", (d:GetAttribute("Plunge") :: number) * s)
			end
		end
	end

	-- Weld static parts only: hinge assemblies are re-posed by the client every frame.
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d ~= root and d:FindFirstAncestorWhichIsA("Model") == m then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = d
		end
	end
	return m
end

-- `id` = a vehicle pet id (Config.GetPet(id).VehicleKind, colours from its Look), or a Kind name.
function Diggers.Build(id: string, scale: number?): Model
	local pet = Config.GetPet(id)
	local look: VehicleLook = FALLBACK_LOOK
	if pet and pet.VehicleKind then
		look = {
			Kind = pet.VehicleKind :: string,
			Body = pet.Look.BodyColor,
			Accent = pet.Look.AccentColor,
			Glow = pet.Look.Glow,
		}
	elseif kinds[id] then
		look = { Kind = id, Body = FALLBACK_LOOK.Body, Accent = FALLBACK_LOOK.Accent, Glow = false }
	end
	return Diggers.FromLook(id, look, scale)
end

-- Ids with a dedicated builder (QA / tests).
function Diggers.Kinds(): { string }
	local list = {}
	for kind in kinds do
		table.insert(list, kind)
	end
	table.sort(list)
	return list
end

return Diggers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Eggs</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Eggs — ~3 studs tall, PrimaryPart = invisible "Root" at the bottom-centre, front -Z.
	Pattern (spots or zig-zag band) is picked deterministically from the egg id.
	Glow -> Neon pattern + PointLight + sparkles. Main shell part is named "Shell".

	v2.1: Construction Crates (EggDef.Kind == "Crate") are chunky wooden / metal crates instead:
	~2.8 studs wide, plank box ("Shell", ShellColor) with a dark frame, steel corner brackets and a
	band of hazard tape (SpotColor / black). The lid is a sub-Model "Lid" (PrimaryPart "LidPlate",
	NOT welded to Root) so the hatch animation can pop it off. Model attribute "Crate" = true.
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Eggs = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis

local LOW_C, LOW_S = V(0, 1.2, 0), V(2.3, 2.4, 2.3)
local TOP_C, TOP_S = V(0, 1.65, 0), V(2.05, 2.6, 2.05)

local FALLBACK: Types.EggLook = {
	ShellColor = Color3.fromRGB(255, 245, 220),
	SpotColor = Color3.fromRGB(255, 150, 120),
	Glow = false,
}

-- Width (diameter) of the egg silhouette at height y.
local function widthAt(y: number): number
	local function w(c: Vector3, s: Vector3): number
		local rel = (y - c.Y) / (s.Y / 2)
		if math.abs(rel) >= 1 then
			return 0
		end
		return s.X * math.sqrt(1 - rel * rel)
	end
	return math.max(w(LOW_C, LOW_S), w(TOP_C, TOP_S))
end

local function build(id: string, look: Types.EggLook): Model
	local m = Build.model(id)
	local root = Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local shellMat = Enum.Material.SmoothPlastic
	local shell = Build.ellipsoid(m, "Shell", LOW_S, CF(LOW_C), look.ShellColor, shellMat)
	Build.ellipsoid(m, "ShellTop", TOP_S, CF(TOP_C), look.ShellColor, shellMat)
	local pm = if look.Glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local sc = look.SpotColor

	if Build.hash(id) % 2 == 0 then
		-- Spots
		local dirs = {
			V(0, 0.1, -1),
			V(0.85, 0.45, -0.4),
			V(-0.8, -0.2, -0.55),
			V(0.7, -0.35, 0.6),
			V(-0.6, 0.5, 0.65),
			V(0.1, 0.25, 1),
			V(-0.95, 0.15, 0.1),
			V(0.95, -0.05, 0.15),
		}
		for i, d in dirs do
			local size = if i % 3 == 0 then 0.42 else 0.6
			Build.ellipsoid(m, "Spot", V(size, size * 0.9, 0.14), Build.surface(LOW_C, LOW_S, d), sc, pm)
		end
		Build.ellipsoid(m, "Spot", V(0.5, 0.45, 0.14), Build.surface(TOP_C, TOP_S, V(0.3, 1, -0.35)), sc, pm)
	else
		-- Zig-zag band like a cracked shell
		local y = 1.45
		local d = widthAt(y) + 0.04
		Build.cyl(m, "Band", 0.38, d, CF(0, y, 0), sc, pm)
		local n = 8
		for k = 0, n - 1 do
			local a = (k + 0.5) / n * math.pi * 2
			local dir = V(math.sin(a), 0, -math.cos(a))
			local base = V(0, y + 0.17, 0) + dir * (widthAt(y + 0.17) / 2 - 0.02)
			local apexY = y + 0.55
			local apex = V(0, apexY, 0) + dir * (widthAt(apexY) / 2 - 0.02)
			Build.triPts(m, "Zig", base, apex, V(-dir.Z, 0, dir.X), 0.75, 0.08, sc, pm)
		end
		Build.ellipsoid(m, "Spot", V(0.55, 0.5, 0.14), Build.surface(TOP_C, TOP_S, V(0, 1, -0.2)), sc, pm)
	end

	Build.ellipsoid(
		m,
		"Shine",
		V(0.35, 0.6, 0.1),
		Build.surface(LOW_C, LOW_S, V(-0.55, 0.45, -0.7)),
		Build.lighten(look.ShellColor, 0.7)
	)

	if look.Glow then
		Build.glow(shell, sc, 1.2, 9)
		Build.sparkle(shell, sc, 4)
	end
	Build.weldAll(m, root)
	return m
end

-- Construction Crate ------------------------------------------------------------------------

local CRATE_W, CRATE_H = 2.8, 2.2
local BLACK = Color3.fromRGB(35, 35, 40)
local STEEL = Color3.fromRGB(165, 170, 182)

local function buildCrate(id: string, look: Types.EggLook): Model
	local m = Build.model(id)
	m:SetAttribute("Crate", true)
	local root = Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local metal = look.Glow
	local wood = if metal then Enum.Material.DiamondPlate else Enum.Material.WoodPlanks
	local frame = Build.darken(look.ShellColor, 0.35)
	local stripeMat = if look.Glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local w, h = CRATE_W, CRATE_H

	local shell = Build.part(m, "Shell", V(w, h, w), CF(0, h / 2, 0), look.ShellColor, wood)
	-- frame: vertical posts + top / bottom rims
	local e = 0.28
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Build.part(
				m,
				"Post",
				V(e, h + 0.04, e),
				CF(x * (w / 2 - e / 2 + 0.03), h / 2, z * (w / 2 - e / 2 + 0.03)),
				frame,
				wood
			)
			-- steel corner brackets top and bottom
			for _, y in { 0.2, h - 0.2 } do
				Build.part(
					m,
					"Bracket",
					V(e + 0.12, 0.32, e + 0.12),
					CF(x * (w / 2 - e / 2 + 0.03), y, z * (w / 2 - e / 2 + 0.03)),
					STEEL,
					Enum.Material.Metal
				)
			end
		end
	end
	for _, y in { 0.12, h - 0.12 } do
		for _, z in { -1, 1 } do
			Build.part(m, "Rim", V(w + 0.06, 0.24, e * 0.8), CF(0, y, z * (w / 2 + 0.02)), frame, wood)
			Build.part(m, "Rim", V(e * 0.8, 0.24, w + 0.06), CF(z * (w / 2 + 0.02), y, 0), frame, wood)
		end
	end
	-- diagonal braces on the sides and the back (the front carries the warning sign)
	for _, x in { -1, 1 } do
		local brace = Build.part(m, "Brace", V(0.12, h * 1.15, 0.24), CF(x * (w / 2 + 0.05), h / 2, 0), frame, wood)
		brace.CFrame = brace.CFrame * CFrame.Angles(math.rad(42), 0, 0)
	end
	local back = Build.part(m, "Brace", V(0.24, h * 1.15, 0.12), CF(0, h / 2, w / 2 + 0.05), frame, wood)
	back.CFrame = back.CFrame * CFrame.Angles(0, 0, math.rad(42))
	-- hazard tape band around the middle (alternating SpotColor / black blocks)
	local bandY = h * 0.62
	local n = 6
	local seg = w / n
	for face = 0, 3 do
		local yaw = CFrame.Angles(0, face * math.pi / 2, 0)
		for k = 0, n - 1 do
			local x = -w / 2 + seg * (k + 0.5)
			local color = if k % 2 == 0 then look.SpotColor else BLACK
			local mat = if k % 2 == 0 then stripeMat else Enum.Material.SmoothPlastic
			Build.part(m, "Tape", V(seg, 0.42, 0.08), yaw * CF(x, bandY, -(w / 2 + 0.1)), color, mat)
		end
	end
	-- stencilled warning triangle on the front
	Build.triPts(
		m,
		"Warning",
		V(0, h * 0.18, -(w / 2 + 0.1)),
		V(0, h * 0.46, -(w / 2 + 0.1)),
		X,
		0.6,
		0.06,
		look.SpotColor,
		stripeMat
	)

	-- lid (separate sub-Model so the hatch animation can pop it off)
	local lid = Instance.new("Model")
	lid.Name = "Lid"
	lid.Parent = m
	local plate = Build.part(lid, "LidPlate", V(w + 0.24, 0.3, w + 0.24), CF(0, h + 0.15, 0), frame, wood)
	lid.PrimaryPart = plate
	for _, x in { -0.8, 0, 0.8 } do
		Build.part(lid, "LidPlank", V(0.5, 0.12, w + 0.1), CF(x, h + 0.36, 0), look.ShellColor, wood)
	end
	Build.part(lid, "LidStripe", V(w + 0.1, 0.14, 0.4), CF(0, h + 0.38, 0), look.SpotColor, stripeMat)
	Build.part(lid, "Handle", V(0.9, 0.22, 0.22), CF(0, h + 0.55, 0), STEEL, Enum.Material.Metal)
	for _, d in lid:GetDescendants() do
		if d:IsA("BasePart") and d ~= plate then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = plate
			weld.Part1 = d
			weld.Parent = d
		end
	end

	if look.Glow then
		Build.glow(shell, look.SpotColor, 1.2, 9)
		Build.sparkle(shell, look.SpotColor, 4)
	end
	-- weld the static crate to Root (the Lid stays free)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d ~= root and d:FindFirstAncestorWhichIsA("Model") == m then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = d
			weld.Parent = d
		end
	end
	return m
end

function Eggs.Build(eggId: string): Model
	local def = Config.GetEgg(eggId)
	if def and def.Kind == "Crate" then
		return buildCrate(eggId, def.Look)
	end
	return build(eggId, if def then def.Look else FALLBACK)
end

-- A crate drawn from a look (previews / tests).
function Eggs.CrateFromLook(name: string, look: Types.EggLook): Model
	return buildCrate(name, look)
end

function Eggs.FromLook(name: string, look: Types.EggLook): Model
	return build(name, look)
end

return Eggs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Expansion1</string>
            <string name="Source"><![CDATA[--!strict
-- First-slice visual factories. No services, rewards, terrain edits or external asset IDs.
-- Bottom pivots for scenery; -Z front. Tools retain the existing Handle-space contract.
local Build = require(script.Parent.Build)
local Kit = {}
local V, CF = Vector3.new, CFrame.new
local rgb = Color3.fromRGB
local C = {
	Navy = rgb(29, 42, 68),
	Ink = rgb(27, 27, 36),
	Cream = rgb(255, 250, 232),
	Coral = rgb(255, 95, 125),
	Blue = rgb(40, 190, 245),
	Gold = rgb(255, 205, 40),
	Sand = rgb(255, 222, 140),
	Skin = rgb(222, 168, 118),
	Hair = rgb(80, 48, 35),
}
Kit.Palette = C
Kit.Spec = {
	Ability = { Charge = 0.8, Cooldown = 8, Range = 12, Corridor = V(12, 8, 8) },
	Vault = { Envelope = V(12, 10, 8), Anchors = 3, Gates = 3 },
	BallDiameter = 7.6, -- routine art choice, fits inside the vault; not the Core finale ball
	StandFootprint = V(2, 0, 2),
}

local function part(m: Instance, name: string, size: Vector3, pos: Vector3, color: Color3): Part
	return Build.part(m, name, size, CF(pos), color)
end

local function model(id: string): Model
	local m = Build.model(id)
	Build.root(m, CF())
	m:SetAttribute("EntityId", id)
	m:SetAttribute("VisualKitVersion", 1)
	return m
end

-- Kinematic block actors, deliberately separate from player avatars. Static dialogue poses
-- are factories; animation controller may interpolate limb groups later.
function Kit.NPC(id: string, pose: string?): Model
	assert(id == "npc_mara" or id == "npc_pip", "Unknown first-slice NPC")
	local m = model(id)
	local mara = id == "npc_mara"
	local outfit = if mara then C.Coral else C.Blue
	local p = pose or "Idle"
	assert(p == "Idle" or p == "Point" or p == "Celebrate", "Unknown dialogue pose")
	m:SetAttribute("Pose", p)
	m:SetAttribute("InteractionRange", 10)
	part(m, "Torso", V(2, 2, 1), V(0, 3, 0), if mara then outfit else C.Cream)
	for side = -1, 1, 2 do
		part(m, "Leg", V(0.9, 1.65, 0.9), V(side * 0.52, 1.075, 0), C.Navy)
		part(m, "Shoe", V(0.94, 0.35, 1.15), V(side * 0.52, 0.175, -0.08), C.Cream)
		local arm = Instance.new("Model")
		arm.Name = if side == -1 then "LeftArmPose" else "RightArmPose"
		arm.Parent = m
		local shoulder = V(side * 1.5, 3.75, 0)
		local sleeve =
			part(arm, "Sleeve", V(0.85, 1.2, 0.95), shoulder + V(0, -0.5, 0), if mara then outfit else C.Cream)
		part(arm, "Cuff", V(0.87, 0.16, 0.97), shoulder + V(0, -1.05, 0), C.Cream)
		part(arm, "Hand", V(0.8, 0.65, 0.9), shoulder + V(0, -1.43, 0), C.Skin)
		arm.PrimaryPart = sleeve
		local angle = if p == "Celebrate"
			then side * math.rad(140)
			else if p == "Point" and side == 1 then math.rad(90) else 0
		Build.transform(arm, CF(shoulder) * CFrame.Angles(0, 0, angle) * CF(-shoulder))
	end
	Build.cyl(m, "Head", 1.1, 1.45, CF(0, 4.55, 0), C.Skin)
	Build.face(m, CF(0, 4.6, -0.73), 1, { cheeks = false, eye = 0.2, spacing = 0.3 })
	part(m, "HairCap", V(1.5, 0.35, 1.45), V(0, 5.05, 0), C.Hair)
	if mara then
		Build.ball(m, "HairBun", 0.72, CF(0, 5.05, 0.75), C.Hair)
		for side = -1, 1, 2 do
			Build.beam(m, "Collar", V(side * 0.65, 3.9, -0.56), V(0, 3.45, -0.56), 0.18, 0.1, C.Cream)
			Build.cylBetween(m, "WhistleCord", V(side * 0.25, 3.9, -0.62), V(0, 3.2, -0.64), 0.045, C.Navy)
		end
		part(m, "Whistle", V(0.32, 0.16, 0.22), V(0, 3.16, -0.72), C.Gold)
	else
		part(m, "Apron", V(1.6, 2, 0.08), V(0, 2.85, -0.56), C.Blue)
		part(m, "ApronPocket", V(1.1, 0.55, 0.1), V(0, 2.55, -0.64), C.Navy)
		part(m, "ApronStrap", V(0.22, 0.45, 0.09), V(0, 3.95, -0.59), C.Cream)
		Build.cyl(m, "HugePencil", 1.6, 0.22, CF(0.47, 3.18, -0.74), C.Gold)
		part(m, "PencilEraser", V(0.24, 0.23, 0.24), V(0.47, 4.08, -0.74), C.Coral)
		Build.spike(m, "PencilTip", V(0.47, 2.38, -0.74), V(0.47, 2.08, -0.74), 0.22, C.Ink)
		part(m, "HairSweep", V(0.95, 0.3, 0.65), V(-0.3, 4.88, -0.52), C.Hair)
	end
	return m
end

function Kit.Broadwave(): Model
	local m = Build.model("tool_broadwave")
	m:SetAttribute("EntityId", "tool_broadwave")
	local handle = Build.cyl(m, "Handle", 1, 0.3, CF(0, 0.5, 0), C.Navy)
	Build.cyl(m, "Shaft", 1.15, 0.27, CF(0, 1.575, 0), C.Cream)
	Build.cyl(m, "LeftGrip", 0.55, 0.36, CF(0, 0.75, 0), C.Blue)
	for side = -1, 1, 2 do
		Build.beam(
			m,
			"GripCheek",
			V(side * 0.36, -0.42, 0),
			V(side * 0.08, 0.08, 0),
			0.14,
			0.16,
			C.Navy,
			nil,
			Vector3.zAxis
		)
	end
	Build.cylBetween(m, "GripBar", V(-0.45, -0.42, 0), V(0.45, -0.42, 0), 0.22, C.Navy)
	Build.cyl(m, "Collar", 0.3, 0.42, CF(0, 2.27, 0), C.Gold)
	part(m, "Blade", V(2.25, 1.1, 0.16), V(0, 2.95, 0), C.Blue)
	Build.ellipsoid(m, "BladeTip", V(2.25, 0.75, 0.16), CF(0, 3.46, 0), C.Blue)
	for side = -1, 1, 2 do
		part(m, "CupRim", V(0.14, 1.2, 0.3), V(side * 1.055, 2.99, 0.12), C.Navy)
	end
	-- Three cream crest dots: recognizable at inventory scale without tiny decal art.
	for i = -1, 1 do
		Build.ball(m, "FoamEmblem", 0.21, CF(i * 0.34, 3.12 + i * 0.06, 0.14), C.Cream)
	end
	local hcf = handle.CFrame
	local palm = CFrame.fromMatrix(V(0, -0.42, 0), Vector3.zAxis, -Vector3.xAxis, -Vector3.yAxis)
	handle:SetAttribute("GripOffset", hcf:ToObjectSpace(palm))
	handle:SetAttribute("TwoHanded", true)
	handle:SetAttribute("ShaftAxis", hcf:VectorToObjectSpace(Vector3.yAxis))
	handle:SetAttribute("CupAxis", hcf:VectorToObjectSpace(Vector3.zAxis))
	handle:SetAttribute("LeftHand", hcf:PointToObjectSpace(V(0, 0.75, 0)))
	handle:SetAttribute("BladePoint", hcf:PointToObjectSpace(V(0, 3.15, 0.2)))
	m.PrimaryPart = handle
	Build.massless(m, handle)
	Build.weldAll(m, handle)
	return m
end

-- The lid swings INSIDE the 12x10x8 envelope. Anchor shapes complement color.
function Kit.SpringVault(state: string?): Model
	local stage = state or "Covered"
	assert(stage == "Covered" or stage == "Partial" or stage == "Opened", "Unknown vault state")
	local m = model("landmark_spring_vault")
	m.Name ..= "_" .. stage
	m:SetAttribute("VisualState", stage)
	Build.solid(part(m, "Floor", V(12, 0.5, 8), V(0, 0.25, 0), C.Navy))
	for side = -1, 1, 2 do
		Build.solid(part(m, "SideWall", V(0.4, 4.5, 8), V(side * 5.8, 2.75, 0), C.Blue))
	end
	Build.solid(part(m, "BackWall", V(12, 4.5, 0.4), V(0, 2.75, 3.8), C.Blue))
	Build.solid(
		part(
			m,
			"FrontWall",
			V(12, if stage == "Opened" then 0.5 else 4.5, 0.4),
			V(0, if stage == "Opened" then 0.25 else 2.75, -3.8),
			C.Blue
		)
	)
	part(m, "AnchorRail", V(11.6, 0.3, 1.5), V(0, 5.25, -2.55), C.Navy)
	local lid = Instance.new("Model")
	lid.Name = "Lid"
	lid.Parent = m
	local plate = part(lid, "LidPlate", V(11.6, 0.45, 7.6), V(0, 5.15, 0), C.Coral)
	lid.PrimaryPart = plate
	for side = -1, 1, 2 do
		part(lid, "StripedHandle", V(1.9, 0.4, 0.5), V(side * 3.8, 5.57, -0.6), C.Navy)
		for i = -1, 1 do
			part(lid, "HandleStripe", V(0.3, 0.42, 0.52), V(side * 3.8 + i * 0.48, 5.57, -0.6), C.Cream)
		end
	end
	if stage == "Opened" then
		local hinge = V(0, 5.15, 3.7)
		Build.transform(lid, CF(hinge) * CFrame.Angles(math.rad(35), 0, 0) * CF(-hinge))
	end
	local latch = part(
		m,
		"Latch",
		V(1.3, if stage == "Opened" then 0.3 else 1.2, 0.35),
		V(0, if stage == "Opened" then 0.65 else 4.1, -3.8),
		C.Gold
	)
	latch:SetAttribute("ObjectiveId", "vault_latch")
	local hinge = Instance.new("Attachment")
	hinge.Name = "LidHinge"
	hinge.Position = V(0, 5.15, 3.7)
	hinge.Parent = m.PrimaryPart
	for i, x in { -3.7, 0, 3.7 } do
		local a = model("vault_anchor_" .. i)
		a.Parent = m
		a:SetAttribute("ObjectiveId", "vault_anchor_" .. i)
		a:SetAttribute("WorkRequiredSolo", 6)
		a:SetAttribute("WorkRequiredCrew", 8)
		a:SetAttribute("WorkRange", 12)
		a:SetAttribute("WorkCooldown", 0.5)
		local exposed = stage == "Opened" or (stage == "Partial" and i == 1)
		local base = part(a, "AnchorBase", V(2.5, 0.2, 1.5), V(x, 5.45, -2.55), C.Navy)
		base:SetAttribute("ProtectedGeometry", true)
		if i == 1 then
			Build.tri(
				a,
				"TriangleMarker",
				CF(x, 5.57, -2.55) * CFrame.Angles(-math.pi / 2, 0, 0),
				0.8,
				0.75,
				0.1,
				C.Cream
			)
		elseif i == 2 then
			part(a, "SquareMarker", V(0.65, 0.12, 0.65), V(x, 5.57, -2.55), C.Cream)
		else
			Build.cyl(a, "CircleMarker", 0.12, 0.7, CF(x, 5.57, -2.55), C.Cream)
		end
		if not exposed then
			local sand = part(
				a,
				"SandCover",
				V(2.3, if stage == "Covered" then 1.8 else 0.9, 1.4),
				V(x, if stage == "Covered" then 6.45 else 6, -2.55),
				C.Sand
			)
			sand:SetAttribute("RemovableVisual", true)
			-- Duplicate the marker above sand: players can read their target before uncovering.
			for _, d in a:GetChildren() do
				if d:IsA("BasePart") and string.find(d.Name, "Marker") then
					local top = d:Clone()
					top.Name = "Covered" .. d.Name
					top.CFrame += V(0, if stage == "Covered" then 1.9 else 1, 0)
					top.Parent = a
				end
			end
		end
		a:SetAttribute("VisualProgress", if exposed then 1 else if stage == "Partial" then 0.5 else 0)
	end
	if stage == "Covered" then
		part(m, "BurialSkirt", V(11.4, 3.4, 7.4), V(0, 2.4, 0), C.Sand)
	elseif stage == "Opened" then
		-- A visible toy spring explains the improbable compressed payload.
		for i = 0, 23 do
			local function coil(t: number): Vector3
				local angle = t * math.pi * 6
				return V(math.cos(angle) * 1.1, 0.65 + t * 1.9, math.sin(angle) * 1.1)
			end
			Build.cylBetween(m, "ToySpring", coil(i / 24), coil((i + 1) / 24), 0.16, C.Gold)
		end
	end
	return m
end

-- Anchored kinematic cargo: controller owns route, gate checks and safe resets.
function Kit.BeachBall(): Model
	local m = model("landmark_spring_vault_ball")
	m:SetAttribute("ParentEntityId", "landmark_spring_vault")
	m:SetAttribute("EventId", "event_vault")
	local d = Kit.Spec.BallDiameter
	local center = V(0, d / 2, 0)
	local sphere = Build.ball(m, "ContactSphere", d, CF(center), C.Cream)
	Build.solid(sphere)
	-- Same intersecting ellipsoid panel construction as the existing Props.BeachBall.
	for stripe, color in { C.Blue, C.Coral, C.Gold } do
		Build.ellipsoid(
			m,
			"ColorPanel",
			V(d + 0.06, d + 0.06, d * 0.65),
			CF(center) * CFrame.Angles(0, (stripe - 1) * math.pi / 3, 0),
			color
		)
	end
	Build.ball(m, "Cap", 0.6, CF(0, d - 0.18, 0), C.Cream)
	local a = Instance.new("Attachment")
	a.Name = "RollEffectOrigin"
	a.Parent = sphere
	m:SetAttribute("MovementMode", "ServerKinematic")
	return m
end

function Kit.TrophyStand(): Model
	local m = model("camp_trophy_stand")
	part(m, "Base", V(2, 0.25, 2), V(0, 0.125, 0), C.Navy)
	part(m, "Pedestal", V(1.6, 1.25, 1.6), V(0, 0.875, 0), C.Cream)
	part(m, "Top", V(2, 0.25, 2), V(0, 1.625, 0), C.Cream)
	part(m, "Plaque", V(0.8, 0.35, 0.06), V(0, 0.95, -0.83), C.Gold)
	local slot = Instance.new("Attachment")
	slot.Name = "TrophySlot"
	slot.Position = V(0, 1.75, 0)
	slot.Parent = m.PrimaryPart
	return m
end

-- Presentation-only quarter stages; authoritative work stays with the event service.
function Kit.SetAnchorProgress(anchor: Model, progress: number)
	local t = math.floor(math.clamp(progress, 0, 1) * 4) / 4
	anchor:SetAttribute("VisualProgress", t)
	local cover = anchor:FindFirstChild("SandCover")
	if cover and cover:IsA("BasePart") then
		local pivot = anchor:GetPivot()
		local localPos = pivot:PointToObjectSpace(cover.Position)
		local height = math.max(0.05, 1.8 * (1 - t))
		cover.Size = V(cover.Size.X, height, cover.Size.Z)
		cover.Position = pivot:PointToWorldSpace(V(localPos.X, 5.55 + height / 2, localPos.Z))
		cover.Transparency = if t == 1 then 1 else 0
		for _, d in anchor:GetChildren() do
			if d:IsA("BasePart") and string.sub(d.Name, 1, 7) == "Covered" then
				local markerPos = pivot:PointToObjectSpace(d.Position)
				d.Position = pivot:PointToWorldSpace(V(markerPos.X, 5.67 + height, markerPos.Z))
				d.Transparency = if t == 1 then 1 else 0
			end
		end
	end
end

function Kit.ChargeEffect(progress: number): Model
	local m = model("tool_broadwave_charge")
	local t = math.clamp(progress, 0, 1)
	for i = 1, 3 do
		local dot = Build.ball(m, "ChargeDot", 0.2, CF((i - 2) * 0.34, 3.12, 0.3), C.Cream)
		dot.Transparency = if t >= i / 3 then 0 else 0.7
	end
	return m
end

function Kit.TrophyReplica(): Model
	local m = Kit.BeachBall()
	Build.scale(m, CF(), 0.18)
	m.Name = "landmark_spring_vault_trophy"
	m:SetAttribute("EntityId", "landmark_spring_vault")
	m:SetAttribute("AssetVariant", "trophy_replica")
	m:SetAttribute("DisplayOnly", true)
	m:SetAttribute("MovementMode", "DisplayOnly")
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
		end
	end
	return m
end

-- Local presentation geometry only; caller animates normalized progress and destroys it.
-- Does not carve, award progress, grant sand or push players.
function Kit.AbilityEffect(progress: number, reducedMotion: boolean?): Model
	local m = model("tool_broadwave_effect")
	local t = math.clamp(progress, 0, 1)
	local z = -t * 8
	part(m, "Wave", V(12, if reducedMotion then 0.35 else 1.4, 0.25), V(0, 0.8, z), C.Blue).Transparency = 0.3
	for i = -3, 3 do
		Build.ellipsoid(m, "FoamCrest", V(1.4, 0.35, 0.4), CF(i * 1.65, 1.55, z), C.Cream)
	end
	return m
end

function Kit.BallEffect(reducedMotion: boolean?): Model
	local m = model("landmark_spring_vault_ball_effect")
	for i = 1, if reducedMotion then 4 else 8 do
		local count = if reducedMotion then 4 else 8
		local a = i / count * math.pi * 2
		Build.ellipsoid(m, "BouncePuff", V(0.9, 0.15, 0.5), CF(math.cos(a) * 4.2, 0.1, math.sin(a) * 4.2), C.Cream)
	end
	return m
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Pets</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Pets — cute low-poly creatures, one builder per Types.PetShape.
	Built at unit scale (~2-2.5 studs) then scaled by Look.Size about the bottom-centre.

	PrimaryPart = invisible "Root" at the bottom-centre (pivot), facing -Z (the pet's front).
	All parts Anchored, CanCollide/CanQuery false, welded to Root (client may unanchor).
	Glow -> Neon accents + PointLight. Legendary/Mythic -> "Sparkles" emitter on "Body";
	Mythic also gets a floating halo of neon orbs (parts named "Halo").

	v2.1: vehicle pets (PetDef.VehicleKind) are drawn by Models/Diggers at scale Look.Size
	(~3-5 studs long), with their animated sub-Models ("Arm", "Drill", ... with a "Motion"
	attribute) intact, so the client can play the dig animation. Model attribute "Vehicle" = true.
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)
local Diggers = require(script.Parent.Diggers)

local Pets = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis
local Y = Vector3.yAxis
local Z = Vector3.zAxis
local WHITE = Color3.new(1, 1, 1)
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon

type Ctx = {
	m: Model,
	id: string,
	B: Color3, -- body
	A: Color3, -- accent
	am: Enum.Material, -- accent material (Neon when Glow)
	glow: boolean,
}

-- Each builder returns the main body part and the Y of the top of the head (for the halo).
type ShapeBuilder = (c: Ctx) -> (BasePart, number)

local shapes: { [string]: ShapeBuilder } = {}

shapes.Crab = function(c)
	local m, B, A = c.m, c.B, c.A
	local body = Build.ellipsoid(m, "Body", V(2.0, 1.1, 1.5), CF(0, 0.85, 0), B)
	Build.ellipsoid(m, "Belly", V(1.7, 0.5, 1.3), CF(0, 0.55, 0), A)
	for side = -1, 1, 2 do
		Build.cylBetween(m, "Stalk", V(side * 0.3, 1.25, -0.42), V(side * 0.36, 1.72, -0.48), 0.12, B)
		local eye = CF(side * 0.36, 1.82, -0.5)
		Build.ball(m, "Eye", 0.36, eye, Build.EYE)
		Build.ball(m, "EyeShine", 0.13, eye * CF(0.07, 0.07, -0.13), WHITE, NEON)
		-- claw
		local shoulder = V(side * 0.85, 0.75, -0.35)
		local wrist = V(side * 1.2, 0.95, -0.85)
		Build.cylBetween(m, "Arm", shoulder, wrist, 0.22, B)
		Build.ball(m, "Pincer", 0.62, CF(side * 1.25, 1.0, -0.95), B)
		local jaw = Build.lighten(B, 0.15)
		Build.triPts(m, "Jaw", V(side * 1.25, 1.1, -1.12), V(side * 1.25, 1.2, -1.55), X, 0.36, 0.18, jaw)
		Build.triPts(m, "Jaw", V(side * 1.25, 0.9, -1.12), V(side * 1.25, 0.82, -1.45), X, 0.3, 0.16, jaw)
		-- legs
		for _, z in { -0.1, 0.25, 0.55 } do
			Build.beam(
				m,
				"Leg",
				V(side * 0.8, 0.7, z),
				V(side * 1.3, 0.05, z + 0.1),
				0.16,
				0.16,
				Build.darken(B, 0.1),
				SMOOTH,
				Z
			)
		end
	end
	Build.face(m, CF(0, 0.85, -0.72), 1, { eyes = false, radius = 0.8 })
	return body, 2.0
end

shapes.Bird = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local wing = Build.darken(B, 0.12)
	local body = Build.ellipsoid(m, "Body", V(1.3, 1.35, 1.45), CF(0, 1.05, 0.05), B)
	Build.ellipsoid(
		m,
		"Breast",
		V(0.95, 0.95, 0.3),
		Build.surface(V(0, 1.05, 0.05), V(1.3, 1.35, 1.45), V(0, -0.25, -1)),
		Build.lighten(B, 0.35)
	)
	local headC = V(0, 1.95, -0.3)
	Build.ball(m, "Head", 1.1, CF(headC), B)
	Build.face(m, CF(0, 1.98, -0.84), 0.85, { mouth = false, radius = 0.55 })
	Build.ellipsoid(m, "Beak", V(0.4, 0.24, 0.55), CF(0, 1.8, -0.86), A, am)
	Build.triPts(m, "Crest", V(0, 2.4, -0.35), V(0, 2.85, -0.12), Z, 0.36, 0.12, A, am)
	Build.triPts(m, "Crest", V(0, 2.38, -0.1), V(0, 2.72, 0.22), Z, 0.3, 0.12, A, am)
	for side = -1, 1, 2 do
		Build.ellipsoid(
			m,
			"Wing",
			V(0.22, 0.85, 1.15),
			CF(side * 0.7, 1.15, 0.12) * CFrame.Angles(0.15, 0, -side * 0.28),
			wing
		)
		Build.cylBetween(m, "Leg", V(side * 0.28, 0.06, 0), V(side * 0.28, 0.55, 0.05), 0.12, A)
		Build.ellipsoid(m, "Foot", V(0.3, 0.1, 0.42), CF(side * 0.28, 0.05, -0.1), A)
	end
	Build.triPts(m, "Tail", V(0, 0.95, 0.6), V(0, 0.75, 1.35), X, 0.75, 0.12, if c.glow then A else wing, am)
	return body, 2.9
end

shapes.Star = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local centre = V(0, 1.1, 0)
	local body = Build.ellipsoid(m, "Body", V(1.2, 1.2, 0.6), CF(centre), B)
	for k = 0, 4 do
		local a = math.rad(90 + 72 * k)
		local dir = V(math.cos(a), math.sin(a), 0)
		Build.tri(m, "Arm", CF(centre) * CFrame.Angles(0, 0, a - math.pi / 2) * CF(0, 0.85, 0), 0.8, 1.0, 0.42, B)
		Build.ball(m, "Dot", 0.2, CF(centre + dir * 0.85 + V(0, 0, -0.2)), A, am)
	end
	Build.face(m, CF(0, 1.1, -0.3), 1, { radius = 1.2 })
	return body, 2.4
end

shapes.Turtle = function(c)
	local m, B, A = c.m, c.B, c.A
	local shellC, shellS = V(0, 0.9, 0.1), V(1.9, 1.15, 2.0)
	local body = Build.ellipsoid(m, "Body", shellS, CF(shellC), A)
	Build.cyl(m, "Rim", 0.18, 2.05, CF(0, 0.55, 0.1), Build.lighten(A, 0.25))
	local plate = if c.glow then Build.lighten(A, 0.3) else Build.darken(A, 0.2)
	for _, dir in { V(0, 1, 0), V(0.7, 0.8, 0.5), V(-0.7, 0.8, 0.5), V(0, 0.8, -0.7) } do
		Build.ellipsoid(m, "Plate", V(0.62, 0.62, 0.2), Build.surface(shellC, shellS, dir), plate, c.am)
	end
	Build.ellipsoid(m, "Belly", V(1.7, 0.35, 1.8), CF(0, 0.45, 0.1), Build.lighten(B, 0.35))
	Build.ball(m, "Head", 0.95, CF(0, 1.0, -1.4), B)
	Build.face(m, CF(0, 1.02, -1.87), 0.8, { radius = 0.48 })
	for side = -1, 1, 2 do
		for _, z in { -0.6, 0.75 } do
			Build.ellipsoid(m, "Leg", V(0.5, 0.36, 0.62), CF(side * 0.78, 0.2, z) * CFrame.Angles(0, side * 0.4, 0), B)
		end
	end
	Build.triPts(m, "Tail", V(0, 0.5, 1.0), V(0, 0.4, 1.45), X, 0.3, 0.15, B)
	return body, 1.6
end

shapes.Fish = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local shark = string.find(c.id, "shark") ~= nil
	local fin = Build.lighten(B, 0.15)
	local body = Build.ellipsoid(m, "Body", V(1.2, 1.3, 2.0), CF(0, 1.3, 0), B)
	Build.triPts(m, "Tail", V(0, 1.3, 1.75), V(0, 1.3, 0.85), Y, 1.3, 0.14, fin)
	local dorsalH = if shark then 0.85 else 0.5
	Build.triPts(m, "Dorsal", V(0, 1.85, 0.1), V(0, 1.9 + dorsalH, 0.4), Z, 0.8, 0.12, fin)
	for side = -1, 1, 2 do
		Build.ellipsoid(
			m,
			"Fin",
			V(0.12, 0.35, 0.55),
			CF(side * 0.6, 1.1, -0.05) * CFrame.Angles(0.4, 0, side * 0.6),
			fin
		)
	end
	for _, z in { -0.35, 0.4 } do
		local k = math.sqrt(1 - (z / 1.0) ^ 2) * 1.05
		Build.ellipsoid(m, "Stripe", V(1.2 * k, 1.3 * k, 0.22), CF(0, 1.3, z), A, am)
	end
	Build.face(m, CF(0, 1.36, -0.96), 0.75, { radius = 0.45, cheeks = not shark })
	return body, 1.95 + dorsalH
end

shapes.Squid = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local domeC, domeS = V(0, 1.6, 0), V(1.6, 1.8, 1.6)
	local body = Build.ellipsoid(m, "Body", domeS, CF(domeC), B)
	for _, dir in { V(0.5, 0.6, 0.4), V(-0.6, 0.5, 0.3), V(0.1, 0.9, 0.5) } do
		Build.ellipsoid(m, "Spot", V(0.36, 0.36, 0.1), Build.surface(domeC, domeS, dir), A, am)
	end
	local tent = Build.darken(B, 0.06)
	for k = 0, 5 do
		local a = math.rad(30 + 60 * k)
		local dir = V(math.sin(a), 0, -math.cos(a))
		local p0 = V(0, 0.9, 0) + dir * 0.45
		local p1 = V(0, 0.38, 0) + dir * 0.85
		local p2 = V(0, 0.16, 0) + dir * 1.18
		Build.cylBetween(m, "Tentacle", p0, p1, 0.34, tent)
		Build.cylBetween(m, "Tentacle", p1, p2, 0.26, tent)
		Build.ball(m, "TentacleTip", 0.28, CF(p2 + V(0, 0.08, 0)), A, am)
	end
	Build.face(m, CF(0, 1.4, -0.78), 1, { radius = 0.8 })
	return body, 2.5
end

shapes.Blob = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local puffer = string.find(c.id, "puffer") ~= nil
	local ghost = string.find(c.id, "ghost") ~= nil or string.find(c.id, "spirit") ~= nil
	local bc, bs = V(0, 0.78, 0), V(1.9, 1.55, 1.8)
	local body = Build.ellipsoid(m, "Body", bs, CF(bc), B)
	if c.glow then
		body.Transparency = 0.25
		Build.ball(m, "Core", 0.8, CF(0, 0.8, 0.15), A, NEON)
	end
	Build.ellipsoid(m, "Shine", V(0.4, 0.24, 0.1), Build.surface(bc, bs, V(-0.5, 0.75, -0.45)), WHITE)
	Build.face(m, CF(0, 0.8, -0.9), 1.1, { radius = 0.92 })
	if puffer then
		for k = 0, 7 do
			local a = math.rad(45 * k + 22.5)
			local dir = V(math.cos(a), if k % 2 == 0 then 0.35 else -0.05, math.sin(a))
			local cf = Build.surface(bc, bs, dir)
			local n = cf.LookVector
			Build.triPts(m, "Spike", cf.Position - n * 0.08, cf.Position + n * 0.35, Y:Cross(n), 0.3, 0.1, A)
		end
	else
		if not ghost then
			for side = -1, 1, 2 do
				Build.ellipsoid(m, "Foot", V(0.5, 0.22, 0.55), CF(side * 0.45, 0.1, -0.25), Build.darken(B, 0.15))
			end
		end
		Build.cylBetween(m, "Antenna", V(0, 1.45, 0.05), V(0.15, 1.95, 0.1), 0.08, A)
		Build.ball(m, "Bobble", 0.3, CF(0.17, 2.02, 0.1), A, am)
	end
	return body, 2.1
end

shapes.Mole = function(c)
	local m, B, A = c.m, c.B, c.A
	local bc, bs = V(0, 0.75, 0), V(1.6, 1.5, 1.7)
	local body = Build.ellipsoid(m, "Body", bs, CF(bc), B)
	Build.ellipsoid(m, "Belly", V(0.9, 0.9, 0.16), Build.surface(bc, bs, V(0, -0.35, -1)), Build.lighten(B, 0.35))
	Build.ellipsoid(m, "Snout", V(0.6, 0.42, 0.5), CF(0, 0.66, -0.82), Build.lighten(B, 0.2))
	Build.ball(m, "Nose", 0.3, CF(0, 0.7, -1.1), A)
	Build.face(m, CF(0, 1.0, -0.8), 0.8, { mouth = false, radius = 0.8 })
	for side = -1, 1, 2 do
		Build.ellipsoid(m, "Paw", V(0.5, 0.18, 0.45), CF(side * 0.5, 0.09, -0.68) * CFrame.Angles(0, side * 0.3, 0), A)
	end
	-- mining helmet
	local yellow = Color3.fromRGB(255, 200, 40)
	Build.ellipsoid(m, "Helmet", V(1.3, 0.8, 1.35), CF(0, 1.38, 0.02), yellow)
	Build.cyl(m, "Brim", 0.1, 1.5, CF(0, 1.32, 0.02), Build.darken(yellow, 0.12))
	Build.cyl(m, "Lamp", 0.2, 0.32, CF(0, 1.55, -0.62) * CFrame.Angles(math.pi / 2, 0, 0), Color3.fromRGB(90, 90, 100))
	local bulb = Build.ball(m, "Bulb", 0.24, CF(0, 1.55, -0.73), Color3.fromRGB(255, 250, 200), NEON)
	Build.glow(bulb, Color3.fromRGB(255, 240, 190), 0.8, 6)
	return body, 1.8
end

shapes.Dino = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local steg = string.find(c.id, "steg") ~= nil
	local rex = string.find(c.id, "rex") ~= nil
	local sala = string.find(c.id, "salamander") ~= nil
	local bc, bs = V(0, 1.0, 0.1), V(1.3, 1.2, 1.7)
	local body = Build.ellipsoid(m, "Body", bs, CF(bc), B)
	Build.ellipsoid(m, "Belly", V(0.85, 0.85, 0.2), Build.surface(bc, bs, V(0, -0.3, -1)), Build.lighten(A, 0.1))
	Build.cylBetween(m, "Neck", V(0, 1.2, -0.4), V(0, 1.75, -0.7), 0.55, B)
	local hs = if rex then 1.15 else 1.0
	Build.ellipsoid(m, "Head", V(1.0, 0.9, 1.15) * hs, CF(0, 1.85, -0.78), B)
	Build.face(m, CF(0, 1.9, -0.78 - 0.56 * hs), 0.9 * hs, { radius = 0.5 * hs })
	Build.cylBetween(m, "Tail", V(0, 1.0, 0.8), V(0, 0.7, 1.5), 0.55, B)
	Build.triPts(m, "TailTip", V(0, 0.72, 1.45), V(0, 0.45, 2.1), X, 0.45, 0.3, B)
	for side = -1, 1, 2 do
		Build.ellipsoid(m, "Leg", V(0.45, 0.75, 0.6), CF(side * 0.48, 0.42, 0.3), B)
		Build.ellipsoid(m, "Foot", V(0.42, 0.16, 0.6), CF(side * 0.48, 0.08, 0.15), Build.darken(B, 0.15))
		local armLen = if rex then 0.22 else 0.38
		Build.beam(
			m,
			"Arm",
			V(side * 0.42, 1.05, -0.55),
			V(side * 0.48, 1.05 - armLen, -0.55 - armLen * 0.8),
			0.15,
			0.15,
			B,
			SMOOTH,
			X
		)
	end
	if sala then
		for _, dir in { V(0.5, 0.8, 0.2), V(-0.5, 0.8, -0.1), V(0.1, 0.9, 0.7), V(-0.3, 0.7, 0.8) } do
			Build.ellipsoid(m, "Spot", V(0.3, 0.3, 0.1), Build.surface(bc, bs, dir), A, am)
		end
	else
		local count = if steg then 5 else 3
		local h = if steg then 0.55 else 0.3
		for i = 1, count do
			local z = -0.4 + (i - 1) * (1.1 / (count - 1))
			local rel = math.clamp((z - bc.Z) / (bs.Z / 2), -1, 1)
			local y = bc.Y + bs.Y / 2 * math.sqrt(1 - rel * rel)
			local hh = h * (1 - math.abs(i - (count + 1) / 2) / count)
			Build.triPts(m, "Plate", V(0, y - 0.06, z), V(0, y + hh, z + 0.1), Z, hh * 1.1, 0.12, A, am)
		end
	end
	return body, 1.85 + 0.45 * hs
end

shapes.Dragon = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local bc, bs = V(0, 1.05, 0.1), V(1.4, 1.35, 1.8)
	local body = Build.ellipsoid(m, "Body", bs, CF(bc), B)
	Build.ellipsoid(m, "Belly", V(0.95, 0.95, 0.2), Build.surface(bc, bs, V(0, -0.3, -1)), Build.lighten(A, 0.2))
	Build.cylBetween(m, "Neck", V(0, 1.35, -0.45), V(0, 1.95, -0.7), 0.6, B)
	Build.ellipsoid(m, "Head", V(1.15, 1.0, 1.1), CF(0, 2.2, -0.75), B)
	Build.ellipsoid(m, "Snout", V(0.75, 0.5, 0.6), CF(0, 2.04, -1.25), Build.lighten(B, 0.1))
	Build.face(m, CF(0, 2.42, -1.25), 0.85, { mouth = false, cheeks = false, radius = 0.55 })
	for side = -1, 1, 2 do
		Build.triPts(m, "Horn", V(side * 0.3, 2.58, -0.6), V(side * 0.42, 3.1, -0.3), Z, 0.3, 0.14, A, am)
		Build.triPts(m, "Wing", V(side * 0.62, 1.55, 0.1), V(side * 1.8, 2.4, 0.4), Z, 1.3, 0.1, A, am)
		for _, z in { -0.45, 0.6 } do
			Build.ellipsoid(m, "Leg", V(0.45, 0.6, 0.5), CF(side * 0.5, 0.3, z), B)
		end
	end
	Build.cylBetween(m, "Tail", V(0, 1.0, 0.85), V(0, 0.6, 1.6), 0.5, B)
	Build.triPts(m, "TailTip", V(0, 0.6, 1.55), V(0, 0.68, 2.1), X, 0.55, 0.12, A, am)
	for _, z in { 0.0, 0.5 } do
		local rel = (z - bc.Z) / (bs.Z / 2)
		local y = bc.Y + bs.Y / 2 * math.sqrt(1 - rel * rel)
		Build.triPts(m, "Spine", V(0, y - 0.06, z), V(0, y + 0.32, z + 0.12), Z, 0.32, 0.1, A, am)
	end
	return body, 3.1
end

shapes.Golem = function(c)
	local m, B, A, am = c.m, c.B, c.A, c.am
	local dark = Build.darken(B, 0.12)
	local body = Build.part(m, "Body", V(1.6, 1.3, 1.1), CF(0, 1.3, 0), B)
	Build.part(m, "Head", V(1.0, 0.85, 0.9), CF(0, 2.35, -0.05), B)
	Build.face(m, CF(0, 2.33, -0.5), 0.85)
	for side = -1, 1, 2 do
		Build.part(m, "Arm", V(0.5, 1.1, 0.55), CF(side * 1.08, 1.3, 0) * CFrame.Angles(0, 0, side * 0.12), dark)
		Build.part(m, "Fist", V(0.7, 0.6, 0.7), CF(side * 1.18, 0.55, 0), B)
		Build.part(m, "Leg", V(0.55, 0.65, 0.6), CF(side * 0.42, 0.33, 0), dark)
	end
	Build.spike(m, "Crystal", V(-0.6, 1.85, 0.1), V(-0.95, 2.6, 0.25), 0.38, A, am)
	Build.spike(m, "Crystal", V(0.65, 1.85, 0.05), V(0.98, 2.45, 0.2), 0.32, A, am)
	Build.spike(m, "Crystal", V(0, 1.6, 0.45), V(0, 2.35, 0.95), 0.42, A, am)
	Build.ball(m, "Gem", 0.36, CF(0, 1.45, -0.55), A, am)
	return body, 2.8
end

shapes.Seal = function(c)
	local m, B, A = c.m, c.B, c.A
	local fl = Build.darken(B, 0.1)
	local body = Build.ellipsoid(m, "Body", V(1.5, 1.25, 2.0), CF(0, 0.62, 0.15), B)
	Build.ball(m, "Head", 1.2, CF(0, 1.4, -0.55), B)
	Build.face(m, CF(0, 1.52, -1.13), 0.85, { mouth = false, radius = 0.6 })
	Build.ellipsoid(m, "Snout", V(0.55, 0.32, 0.3), CF(0, 1.28, -1.1), Build.lighten(B, 0.5))
	Build.ball(m, "Nose", 0.2, CF(0, 1.38, -1.24), Build.EYE)
	for side = -1, 1, 2 do
		Build.ellipsoid(
			m,
			"Flipper",
			V(0.2, 0.3, 0.7),
			CF(side * 0.72, 0.3, -0.35) * CFrame.Angles(0.3, 0, side * 0.8),
			fl
		)
		Build.ellipsoid(
			m,
			"TailFlipper",
			V(0.6, 0.15, 0.4),
			CF(side * 0.3, 0.12, 1.15) * CFrame.Angles(0, side * 0.5, 0),
			fl
		)
	end
	-- beach ball balanced on its head
	Build.ball(m, "Ball", 0.6, CF(0, 2.28, -0.6), A, c.am)
	Build.ellipsoid(m, "BallStripe", V(0.63, 0.63, 0.22), CF(0, 2.28, -0.6) * CFrame.Angles(0, 0.6, 0.3), WHITE)
	return body, 2.6
end

local FALLBACK: Types.PetLook = {
	BodyColor = Color3.fromRGB(255, 170, 120),
	AccentColor = Color3.fromRGB(255, 240, 200),
	Shape = "Blob",
	Size = 1,
	Glow = false,
}

local function build(id: string, look: Types.PetLook, rarity: Types.Rarity): Model
	local m = Build.model(id)
	local root = Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local ctx: Ctx = {
		m = m,
		id = id,
		B = look.BodyColor,
		A = look.AccentColor,
		am = if look.Glow then NEON else SMOOTH,
		glow = look.Glow,
	}
	local builder = shapes[look.Shape] or shapes.Blob
	local body, top = builder(ctx)

	if look.Glow then
		Build.glow(body, look.AccentColor, 1, 7)
	end
	if rarity == "Legendary" or rarity == "Mythic" then
		Build.sparkle(body, look.AccentColor, if rarity == "Mythic" then 8 else 4)
	end
	if rarity == "Mythic" then
		for k = 0, 5 do
			local a = math.rad(60 * k)
			Build.ball(
				m,
				"Halo",
				0.2,
				CF(math.cos(a) * 0.55, top + 0.35, math.sin(a) * 0.55),
				Color3.fromRGB(255, 240, 150),
				NEON
			)
		end
	end

	Build.scale(m, CFrame.identity, math.clamp(look.Size, 0.3, 3))
	Build.weldAll(m, root)
	return m
end

local function buildVehicle(def: Types.PetDef): Model
	local m = Diggers.Build(def.Id, def.Look.Size)
	m:SetAttribute("Vehicle", true)
	if def.Rarity == "Legendary" or def.Rarity == "Mythic" then
		local body = m:FindFirstChild("Body")
		if body and body:IsA("BasePart") then
			Build.sparkle(body, def.Look.AccentColor, if def.Rarity == "Mythic" then 8 else 4)
		end
	end
	return m
end

function Pets.Build(petId: string): Model
	local def = Config.GetPet(petId)
	if def and def.VehicleKind then
		return buildVehicle(def)
	end
	if def then
		return build(petId, def.Look, def.Rarity)
	end
	return build(petId, FALLBACK, "Common")
end

function Pets.FromLook(name: string, look: Types.PetLook, rarity: Types.Rarity?): Model
	return build(name, look, rarity or "Common")
end

return Pets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Props — beach scenery at real scale (avatar ~5 studs tall).
	PrimaryPart = invisible "Root" at the bottom-centre (pivot). FRONT faces -Z (towers look
	out along -Z, stall / shack counters open towards -Z, sign text is on the -Z face).
	Main bodies players should stand on / bump into have CanCollide = true; small details don't.
	Optional `variant` (number) picks colours / shape jitter deterministically.
	Signs carry a SurfaceGui whose TextLabel is named "Label" on a part named "SignBoard".
	Names are matched case-, space-, '_' and '-' insensitively ("Lifeguard Tower" works).
]]

local Types = require(script.Parent.Parent.Types)
local Build = require(script.Parent.Build)
local Pets = require(script.Parent.Pets)

local Props = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis
local Y = Vector3.yAxis
local Z = Vector3.zAxis
local rgb = Color3.fromRGB
local PI = math.pi

local WHITE = rgb(255, 255, 255)
local SAND = rgb(255, 222, 140)
local WOOD = rgb(176, 120, 72)
local WOOD_DARK = rgb(130, 85, 50)
local GOLD = rgb(255, 205, 40)
local M = Enum.Material

local solid = Build.solid

local function pick<T>(list: { T }, variant: number): T
	return list[(math.floor(variant) - 1) % #list + 1]
end

type PropBuilder = (m: Model, v: number) -> ()

local builders: { [string]: PropBuilder } = {}

builders.PalmTree = function(m, v)
	local rng = Random.new(v * 7919 + 13)
	local lean = rng:NextNumber() * PI * 2
	local lx, lz = math.cos(lean), math.sin(lean)
	local H = 10.5 + rng:NextNumber() * 1.5
	local function at(t: number): Vector3
		local b = 2.0 * t * t
		return V(lx * b, t * H, lz * b)
	end
	local barkA, barkB = rgb(170, 120, 75), rgb(140, 95, 58)
	local segs = 6
	for i = 0, segs - 1 do
		local a, b = at(i / segs), at((i + 1) / segs)
		solid(
			Build.cylBetween(
				m,
				"Trunk",
				a,
				b + (b - a).Unit * 0.15,
				1.15 - 0.07 * i,
				if i % 2 == 0 then barkA else barkB,
				M.Wood
			)
		)
	end
	local top = at(1)
	Build.ball(m, "Crown", 1.3, CF(top), rgb(60, 150, 70))
	for k = 0, 2 do
		local a = k / 3 * PI * 2 + 0.4
		Build.ball(m, "Coconut", 0.7, CF(top + V(math.cos(a) * 0.55, -0.55, math.sin(a) * 0.55)), rgb(120, 80, 45))
	end
	local greens = { rgb(70, 200, 100), rgb(50, 170, 80), rgb(90, 215, 110) }
	local fronds = 7
	local offset = rng:NextNumber() * PI
	for k = 0, fronds - 1 do
		local a = k / fronds * PI * 2 + offset
		local h = V(math.cos(a), 0, math.sin(a))
		local perp = V(-h.Z, 0, h.X)
		local mid = top + h * 2.2 + V(0, 0.55, 0)
		local tip = top + h * 4.8 + V(0, -1.5, 0)
		local col = greens[k % #greens + 1]
		Build.beam(m, "Frond", top, mid, 1.1, 0.14, col, M.SmoothPlastic, perp)
		Build.triPts(m, "Frond", mid, tip, perp, 1.1, 0.14, col)
	end
end

builders.Umbrella = function(m, v)
	local pairs_ = {
		{ rgb(255, 80, 90), WHITE },
		{ rgb(40, 170, 255), rgb(255, 230, 70) },
		{ rgb(255, 150, 40), WHITE },
		{ rgb(90, 210, 120), rgb(255, 245, 200) },
		{ rgb(170, 100, 255), rgb(255, 200, 230) },
	}
	local cols = pick(pairs_, v)
	local tilt = CFrame.Angles(0.06, 0, 0.04 * ((v % 3) - 1))
	Build.ellipsoid(m, "Mound", V(1.4, 0.45, 1.4), CF(), SAND, M.Sand)
	solid(Build.cylBetween(m, "Pole", V(0, 0, 0), (tilt * CF(0, 7.3, 0)).Position, 0.25, rgb(235, 235, 240)))
	local apex = (tilt * CF(0, 7.45, 0)).Position
	local R = 3.8
	local n = 8
	for k = 0, n - 1 do
		local a = (k + 0.5) / n * PI * 2
		local base = (tilt * CF(R * math.cos(PI / n) * math.cos(a), 6.1, R * math.cos(PI / n) * math.sin(a))).Position
		local tangent = tilt:VectorToWorldSpace(V(-math.sin(a), 0, math.cos(a)))
		Build.triPts(m, "Canopy", base, apex, tangent, 2 * R * math.sin(PI / n) + 0.05, 0.1, cols[k % 2 + 1])
	end
	Build.ball(m, "Finial", 0.4, CF(apex + V(0, 0.1, 0)), cols[1])
end

builders.BeachTowel = function(m, v)
	local cols = pick({
		{ rgb(255, 90, 120), WHITE },
		{ rgb(60, 170, 255), rgb(255, 230, 80) },
		{ rgb(90, 210, 120), rgb(255, 250, 240) },
		{ rgb(255, 160, 50), rgb(140, 90, 230) },
	}, v)
	Build.part(m, "Towel", V(3, 0.1, 5.6), CF(0, 0.14, 0), cols[1], M.Fabric)
	for _, z in { -1.6, 0, 1.6 } do
		Build.part(m, "Stripe", V(2.98, 0.025, 0.5), CF(0, 0.205, z), cols[2], M.Fabric)
	end
	Build.cylBetween(m, "Pillow", V(-1.3, 0.3, -2.45), V(1.3, 0.3, -2.45), 0.6, cols[2], M.Fabric)
end

builders.Sandcastle = function(m, v)
	local mat = M.Sand
	local dark = Build.darken(SAND, 0.12)
	solid(Build.part(m, "Base", V(6, 1.4, 6), CF(0, 0.7, 0), SAND, mat))
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			local c = V(sx * 2.6, 0, sz * 2.6)
			solid(Build.cyl(m, "Tower", 3.2, 1.7, CF(c + V(0, 1.6, 0)), SAND, mat))
			for k = 0, 3 do
				local a = (k + 0.5) / 4 * PI * 2
				Build.part(
					m,
					"Crenel",
					V(0.45, 0.45, 0.45),
					CF(c + V(math.cos(a) * 0.6, 3.42, math.sin(a) * 0.6)),
					SAND,
					mat
				)
			end
		end
	end
	local keep = V(0, 0, 0.4)
	solid(Build.cyl(m, "Keep", 4.6, 2.6, CF(keep + V(0, 2.3, 0)), SAND, mat))
	for k = 0, 5 do
		local a = k / 6 * PI * 2
		Build.part(m, "Crenel", V(0.5, 0.5, 0.5), CF(keep + V(math.cos(a) * 1.05, 4.85, math.sin(a) * 1.05)), SAND, mat)
	end
	Build.part(m, "Door", V(1.1, 1.1, 0.1), CF(0, 0.55, -3.02), dark, mat)
	for side = -1, 1, 2 do
		Build.part(m, "Window", V(0.35, 0.5, 0.1), CF(side * 0.5, 3.2, -0.82), dark, mat)
		Build.ellipsoid(m, "Shell", V(0.45, 0.38, 0.12), CF(side * 1.8, 0.8, -3.03), rgb(255, 170, 180))
	end
	local flag = pick({ rgb(255, 70, 80), rgb(60, 160, 255), rgb(255, 200, 40), rgb(90, 210, 120) }, v)
	Build.cylBetween(m, "FlagPole", V(0, 4.6, 0.4), V(0, 6.5, 0.4), 0.1, WHITE)
	Build.triPts(m, "Flag", V(0.05, 6.05, 0.4), V(1.0, 6.05, 0.4), Y, 0.7, 0.05, flag)
end

builders.Crab = function(m, v)
	local col = pick({ rgb(255, 110, 80), rgb(255, 80, 60), rgb(255, 150, 70), rgb(230, 70, 110) }, v)
	local look: Types.PetLook = {
		BodyColor = col,
		AccentColor = Build.lighten(col, 0.55),
		Shape = "Crab",
		Size = 0.8,
		Glow = false,
	}
	local crab = Pets.FromLook("Crab", look)
	for _, d in crab:GetChildren() do
		if d.Name ~= "Root" then
			d.Parent = m
		end
	end
	crab:Destroy()
	for _, d in m:GetDescendants() do
		if d:IsA("WeldConstraint") then
			d:Destroy()
		end
	end
end

local function trussPart(m: Model, size: Vector3, cf: CFrame, color: Color3): TrussPart
	local t = Instance.new("TrussPart")
	t.Name = "Ladder"
	t.Anchored = true
	t.Size = size
	t.CFrame = cf
	t.Color = color
	t.Material = M.SmoothPlastic
	t.Parent = m
	return t
end

builders.LifeguardTower = function(m, v)
	local wall = pick({ rgb(235, 55, 55), rgb(40, 150, 240), rgb(255, 190, 40) }, v)
	local wood = M.Wood
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			solid(
				Build.beam(m, "Leg", V(sx * 2.0, 0, sz * 2.0), V(sx * 1.75, 6.1, sz * 1.75), 0.4, 0.4, WHITE, wood, X)
			)
		end
		Build.beam(m, "Brace", V(sx * 1.95, 0.6, -1.95), V(sx * 1.8, 5.5, 1.8), 0.22, 0.22, WHITE, wood, Z)
	end
	Build.beam(m, "Brace", V(-1.95, 0.6, 1.95), V(1.8, 5.5, 1.8), 0.22, 0.22, WHITE, wood, X)
	solid(Build.part(m, "Platform", V(4.8, 0.4, 4.8), CF(0, 6.2, 0), WOOD, wood))
	solid(Build.part(m, "BackWall", V(4.4, 3.2, 0.3), CF(0, 8.0, 2.2), wall, wood))
	for side = -1, 1, 2 do
		solid(Build.part(m, "SideWall", V(0.3, 3.2, 2.0), CF(side * 2.2, 8.0, 1.2), wall, wood))
		solid(Build.part(m, "Pillar", V(0.3, 3.2, 0.3), CF(side * 2.2, 8.0, -2.2), WHITE, wood))
		solid(Build.part(m, "Railing", V(1.4, 1.1, 0.2), CF(side * 1.5, 6.95, -2.3), WHITE, wood))
	end
	local roofA, roofB = Build.tri(m, "Roof", CF(0, 10.25, 0) * CFrame.Angles(0, PI / 2, 0), 5.6, 1.3, 5.6, wall, wood)
	solid(roofA)
	solid(roofB)
	Build.part(m, "Eaves", V(5.4, 0.2, 5.6), CF(0, 9.6, 0), WHITE, wood)
	solid(trussPart(m, V(2, 6, 2), CF(0, 3.0, -3.1), WHITE))
	local sign = Build.part(m, "SignBoard", V(3.0, 0.7, 0.15), CF(0, 9.25, -2.35), WHITE)
	Build.label(sign, Enum.NormalId.Front, "LIFEGUARD", rgb(235, 55, 55), WHITE)
	Build.cylBetween(m, "Buoy", V(2.36, 7.8, 1.2), V(2.52, 7.8, 1.2), 1.1, rgb(255, 120, 40))
	Build.cylBetween(m, "BuoyHole", V(2.34, 7.8, 1.2), V(2.54, 7.8, 1.2), 0.5, Build.darken(wall, 0.3))
	Build.cylBetween(m, "FlagPole", V(0, 10.85, 0), V(0, 12.7, 0), 0.12, WHITE)
	Build.triPts(m, "Flag", V(0.05, 12.25, 0), V(1.2, 12.25, 0), Y, 0.8, 0.06, wall)
end

builders.BoardwalkStall = function(m, v)
	local cols = pick({
		{ rgb(255, 80, 100), WHITE },
		{ rgb(40, 170, 255), WHITE },
		{ rgb(255, 170, 40), rgb(255, 250, 220) },
		{ rgb(90, 200, 120), rgb(255, 250, 220) },
	}, v)
	local text = pick({ "SNACKS", "ICE CREAM", "SHELLS", "DRINKS" }, v)
	solid(Build.part(m, "BackWall", V(5, 3.6, 0.25), CF(0, 1.8, 1.6), WOOD, M.Wood))
	solid(Build.part(m, "Counter", V(5, 1.15, 1.0), CF(0, 0.575, -1.2), WOOD, M.Wood))
	solid(Build.part(m, "CounterTop", V(5.3, 0.15, 1.2), CF(0, 1.22, -1.2), WHITE))
	for sx = -1, 1, 2 do
		for _, z in { -1.6, 1.6 } do
			solid(Build.cyl(m, "Post", 3.9, 0.3, CF(sx * 2.4, 1.95, z), WHITE))
		end
	end
	for i = 0, 4 do
		local x = -2.0 + i
		Build.part(
			m,
			"Awning",
			V(1.0, 0.15, 3.9),
			CF(x, 4.0, -0.1) * CFrame.Angles(-0.2, 0, 0),
			cols[i % 2 + 1],
			M.Fabric
		)
		Build.tri(m, "Valance", CF(x, 3.42, -2.03) * CFrame.Angles(0, 0, PI), 1.0, 0.4, 0.06, cols[i % 2 + 1], M.Fabric)
	end
	local sign = Build.part(m, "SignBoard", V(3.2, 0.9, 0.15), CF(0, 4.85, -1.0), cols[1])
	Build.label(sign, Enum.NormalId.Front, text, WHITE)
	for i, col in { rgb(255, 90, 90), rgb(255, 220, 60), rgb(120, 220, 120) } do
		Build.ball(m, "Goods", 0.45, CF(-1.6 + i * 0.55, 1.52, -1.25), col)
	end
	Build.cyl(m, "Goods", 0.6, 0.3, CF(1.4, 1.6, -1.2), rgb(80, 180, 255), M.Glass)
end

builders.Surfboard = function(m, v)
	local cols = pick({
		{ rgb(255, 120, 60), WHITE },
		{ rgb(60, 190, 255), rgb(255, 230, 70) },
		{ rgb(255, 90, 160), WHITE },
		{ rgb(90, 220, 140), rgb(40, 90, 200) },
	}, v)
	local cf = CF(0, 3.45, 0) * CFrame.Angles(0, 0, 0.06 * ((v % 3) - 1))
	solid(Build.ellipsoid(m, "Board", V(1.8, 7, 0.3), cf, cols[1]))
	Build.ellipsoid(m, "Stripe", V(0.35, 6.6, 0.34), cf, cols[2])
	Build.triPts(m, "Fin", (cf * CF(0, -2.1, 0.12)).Position, (cf * CF(0, -2.5, 0.6)).Position, Y, 0.6, 0.08, cols[2])
end

builders.BeachBall = function(m, v)
	local c = V(0, 1, 0)
	Build.ball(m, "Ball", 2, CF(c), WHITE)
	local sets = {
		{ rgb(255, 70, 70), rgb(255, 215, 50), rgb(60, 150, 255) },
		{ rgb(255, 120, 200), rgb(90, 220, 140), rgb(255, 160, 40) },
	}
	for i, col in pick(sets, v) do
		Build.ellipsoid(m, "Stripe", V(2.15, 2.15, 1.4), CF(c) * CFrame.Angles(0, (i - 1) * PI / 3, 0), col)
	end
	Build.ball(m, "Cap", 0.45, CF(c + V(0, 0.9, 0)), WHITE)
end

builders.Rock = function(m, v)
	local rng = Random.new(v * 104729 + 7)
	local specs = {
		{ V(3.2, 2.2, 2.6), V(0, 1.0, 0) },
		{ V(2.2, 1.6, 2.0), V(1.2, 0.7, 0.4) },
		{ V(1.5, 1.2, 1.4), V(-1.3, 0.5, -0.3) },
	}
	for i, s in specs do
		local rot = CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, PI * 2), rng:NextNumber(-0.3, 0.3))
		local g = 120 + rng:NextInteger(-15, 20)
		solid(Build.part(m, "Rock", s[1], CF(s[2]) * rot, rgb(g, g, g + 8), M.Slate))
		if i == 1 then
			Build.ellipsoid(m, "Moss", V(2.0, 0.4, 1.6), CF(s[2] + V(0, 1.0, 0)) * rot, rgb(110, 170, 90), M.Grass)
		end
	end
end

builders.Shell = function(m, v)
	local col = pick({ rgb(255, 190, 170), rgb(255, 150, 180), rgb(200, 170, 255), rgb(255, 240, 220) }, v)
	local hinge = V(0, 0.15, 0.75)
	Build.ellipsoid(m, "Back", V(2.0, 0.25, 1.5), CF(0, 0.13, 0), Build.darken(col, 0.1))
	for _, a in { -0.9, -0.45, 0, 0.45, 0.9 } do
		local dir = V(math.sin(a), 0, -math.cos(a))
		Build.ellipsoid(
			m,
			"Rib",
			V(0.5, 0.35, 1.6),
			CF(hinge + dir * 0.75 + V(0, 0.08, 0)) * CFrame.Angles(0, -a, 0),
			Build.lighten(col, 0.1)
		)
	end
	Build.part(m, "Hinge", V(0.7, 0.25, 0.3), CF(0, 0.13, 0.8), col)
end

builders.Chest = function(m, v)
	local wood = pick({ rgb(150, 95, 45), rgb(120, 75, 40), rgb(170, 110, 60) }, v)
	solid(Build.part(m, "Base", V(3, 1.6, 2), CF(0, 0.8, 0), wood, M.Wood))
	solid(Build.cylBetween(m, "Lid", V(-1.5, 1.6, 0), V(1.5, 1.6, 0), 2.0, Build.lighten(wood, 0.08), M.Wood))
	for _, x in { -1.0, 1.0 } do
		Build.part(m, "Band", V(0.25, 1.64, 2.04), CF(x, 0.8, 0), GOLD, M.Metal)
		Build.cylBetween(m, "Band", V(x - 0.125, 1.6, 0), V(x + 0.125, 1.6, 0), 2.04, GOLD, M.Metal)
	end
	Build.part(m, "Lock", V(0.5, 0.6, 0.15), CF(0, 1.5, -1.05), GOLD, M.Metal)
	Build.ellipsoid(m, "Gold", V(1.4, 0.45, 1.0), CF(1.3, 0.12, -1.6), GOLD, M.Metal)
	for i = 0, 2 do
		Build.cyl(m, "Coin", 0.08, 0.5, CF(0.4 + i * 0.45, 0.05, -1.9 + (i % 2) * 0.3), GOLD, M.Metal)
	end
end

builders.Bucket = function(m, v)
	local cols = pick({
		{ rgb(60, 170, 255), rgb(255, 230, 60) },
		{ rgb(255, 90, 90), rgb(255, 255, 255) },
		{ rgb(255, 200, 40), rgb(60, 170, 255) },
		{ rgb(90, 210, 120), rgb(255, 120, 200) },
	}, v)
	Build.cyl(m, "Body", 1.2, 1.2, CF(0, 0.6, 0), cols[1])
	Build.cyl(m, "Rim", 0.14, 1.32, CF(0, 1.2, 0), cols[2])
	Build.ellipsoid(m, "SandFill", V(1.05, 0.35, 1.05), CF(0, 1.22, 0), SAND, M.Sand)
	Build.beam(m, "Handle", V(-0.62, 1.0, 0), V(-0.45, 1.6, 0), 0.08, 0.08, cols[2], M.SmoothPlastic, Z)
	Build.beam(m, "Handle", V(-0.5, 1.6, 0), V(0.5, 1.6, 0), 0.08, 0.08, cols[2], M.SmoothPlastic, Z)
	Build.beam(m, "Handle", V(0.45, 1.6, 0), V(0.62, 1.0, 0), 0.08, 0.08, cols[2], M.SmoothPlastic, Z)
	Build.cylBetween(m, "Spade", V(0.1, 1.0, 0.05), V(0.45, 2.2, 0.2), 0.12, cols[2])
	Build.ball(m, "SpadeGrip", 0.25, CF(0.47, 2.27, 0.21), cols[2])
end

builders.Sign = function(m, v)
	local text = pick({ "DIG!", "SELL", "SHOP", "EGGS", "DANGER!" }, v)
	solid(Build.part(m, "Post", V(0.35, 4, 0.35), CF(0, 2, 0.12), WOOD_DARK, M.Wood))
	Build.part(m, "Frame", V(3.4, 1.6, 0.14), CF(0, 3.6, 0.1), WOOD_DARK, M.Wood)
	local board = solid(Build.part(m, "SignBoard", V(3.2, 1.4, 0.2), CF(0, 3.6, 0), WOOD, M.Wood))
	Build.label(board, Enum.NormalId.Front, text, WHITE)
end

builders.Lamp = function(m, v)
	local metal = pick({ rgb(85, 110, 125), rgb(85, 90, 105), rgb(55, 135, 145) }, v)
	solid(Build.cyl(m, "Base", 0.4, 1.0, CF(0, 0.2, 0), metal, M.Metal))
	solid(Build.cyl(m, "Pole", 8.1, 0.3, CF(0, 4.45, 0), metal, M.Metal))
	Build.beam(m, "Arm", V(0, 8.3, 0), V(0, 8.6, -1.2), 0.2, 0.2, metal, M.Metal, X)
	Build.part(m, "Shade", V(0.85, 0.3, 0.85), CF(0, 8.6, -1.3), metal, M.Metal)
	local bulb = Build.ball(m, "Bulb", 0.55, CF(0, 8.3, -1.3), rgb(255, 235, 170), M.Neon)
	Build.glow(bulb, rgb(255, 220, 160), 1.5, 18)
	Build.ball(m, "Finial", 0.4, CF(0, 8.6, 0), metal, M.Metal)
end

builders.Bench = function(m, v)
	local wood = pick({ WOOD, rgb(80, 160, 220), rgb(230, 90, 80) }, v)
	local metal = rgb(50, 50, 60)
	for _, z in { -0.5, 0, 0.5 } do
		solid(Build.part(m, "Seat", V(5, 0.18, 0.45), CF(0, 1.5, z), wood, M.Wood))
	end
	for i, y in { 2.2, 2.75 } do
		solid(
			Build.part(m, "Back", V(5, 0.4, 0.15), CF(0, y, 0.78 + i * 0.05) * CFrame.Angles(-0.15, 0, 0), wood, M.Wood)
		)
	end
	for _, x in { -2.2, 2.2 } do
		Build.part(m, "Leg", V(0.2, 1.5, 0.2), CF(x, 0.75, -0.55), metal, M.Metal)
		Build.part(m, "Leg", V(0.2, 3.0, 0.2), CF(x, 1.5, 0.75) * CFrame.Angles(-0.1, 0, 0), metal, M.Metal)
		Build.part(m, "Armrest", V(0.22, 0.15, 1.4), CF(x * 1.08, 2.1, 0.05), metal, M.Metal)
	end
end

builders.Barrel = function(m, v)
	local wood = pick({ rgb(150, 95, 50), rgb(120, 80, 45), rgb(175, 120, 70) }, v)
	solid(Build.cyl(m, "Body", 2.8, 2.2, CF(0, 1.4, 0), wood, M.Wood))
	Build.cyl(m, "Bulge", 1.6, 2.36, CF(0, 1.4, 0), wood, M.Wood)
	for _, y in { 0.55, 2.25 } do
		Build.cyl(m, "Hoop", 0.18, 2.34, CF(0, y, 0), rgb(80, 80, 90), M.Metal)
	end
	Build.cyl(m, "Lid", 0.06, 2.0, CF(0, 2.81, 0), Build.darken(wood, 0.2), M.Wood)
end

builders.Starfish = function(m, v)
	local col = pick({ rgb(255, 150, 60), rgb(255, 90, 120), rgb(170, 100, 255), rgb(255, 210, 60) }, v)
	local dot = Build.lighten(col, 0.5)
	local c = CF(0, 0.15, 0)
	Build.ellipsoid(m, "Body", V(1.0, 0.3, 1.0), c, col)
	for k = 0, 4 do
		local a = k / 5 * PI * 2
		Build.tri(
			m,
			"Arm",
			c * CFrame.Angles(0, a, 0) * CFrame.Angles(-PI / 2, 0, 0) * CF(0, 0.85, 0),
			0.8,
			1.0,
			0.25,
			col
		)
		Build.ball(m, "Dot", 0.16, c * CFrame.Angles(0, a, 0) * CF(0, 0.12, -0.75), dot)
	end
end

builders.Dock = function(m, v)
	local planks = { rgb(175, 125, 80), rgb(160, 110, 70) }
	for i = 0, 9 do
		solid(Build.part(m, "Plank", V(8, 0.4, 1.55), CF(0, 4.4, -7.2 + i * 1.6), planks[i % 2 + 1], M.Wood))
	end
	for _, x in { -3.8, 3.8 } do
		Build.part(m, "Stringer", V(0.4, 0.5, 16), CF(x * 0.8, 3.95, 0), WOOD_DARK, M.Wood)
		for _, z in { -7, 0, 7 } do
			solid(Build.cyl(m, "Post", 5.0, 0.7, CF(x, 2.5, z), WOOD_DARK, M.Wood))
		end
	end
end

builders.Flag = function(m, v)
	local cols = pick({
		{ rgb(235, 50, 50), WHITE },
		{ rgb(40, 140, 255), rgb(255, 220, 50) },
		{ rgb(70, 200, 110), WHITE },
		{ rgb(150, 80, 230), GOLD },
		{ rgb(30, 30, 40), WHITE },
	}, v)
	Build.cyl(m, "Base", 0.3, 0.8, CF(0, 0.15, 0), rgb(200, 200, 210), M.Metal)
	solid(Build.cyl(m, "Pole", 10, 0.25, CF(0, 5, 0), WHITE, M.Metal))
	Build.ball(m, "Finial", 0.45, CF(0, 10.1, 0), GOLD, M.Metal)
	Build.part(m, "Cloth", V(3, 2, 0.08), CF(1.6, 8.9, 0), cols[1], M.Fabric)
	Build.part(m, "ClothStripe", V(3.02, 0.6, 0.1), CF(1.6, 8.9, 0), cols[2], M.Fabric)
end

builders.Cooler = function(m, v)
	local col = pick({ rgb(40, 200, 230), rgb(255, 90, 90), rgb(90, 200, 120), rgb(40, 110, 220) }, v)
	solid(Build.part(m, "Body", V(2.4, 1.4, 1.4), CF(0, 0.7, 0), col))
	solid(Build.part(m, "Lid", V(2.5, 0.35, 1.5), CF(0, 1.57, 0), WHITE))
	for side = -1, 1, 2 do
		Build.part(m, "HandlePost", V(0.14, 0.3, 0.14), CF(side * 0.6, 1.85, 0), rgb(220, 220, 225))
	end
	Build.part(m, "Handle", V(1.34, 0.14, 0.2), CF(0, 2.0, 0), rgb(220, 220, 225))
	Build.part(m, "Latch", V(0.4, 0.4, 0.1), CF(0, 1.35, -0.75), WHITE)
end

builders.SurfShack = function(m, v)
	local wallCol = pick({ rgb(255, 245, 225), rgb(140, 220, 240), rgb(255, 210, 170) }, v)
	local trim = pick({ rgb(40, 150, 240), rgb(255, 110, 90), rgb(60, 180, 120) }, v)
	local W = M.Wood
	solid(Build.part(m, "Floor", V(12, 0.6, 10), CF(0, 0.3, 0), WOOD, W))
	solid(Build.part(m, "BackWall", V(12, 5, 0.4), CF(0, 3.1, 4.8), wallCol, W))
	for side = -1, 1, 2 do
		solid(Build.part(m, "SideWall", V(0.4, 5, 9.6), CF(side * 5.8, 3.1, 0), wallCol, W))
	end
	-- front (-Z): wall left of the door, door gap, then serving window with counter
	solid(Build.part(m, "FrontWall", V(1.8, 5, 0.4), CF(-5.1, 3.1, -4.8), wallCol, W))
	solid(Build.part(m, "DoorHeader", V(1.8, 1.2, 0.4), CF(-3.3, 5.0, -4.8), wallCol, W))
	solid(Build.part(m, "FrontWall", V(8.4, 1.8, 0.4), CF(1.8, 1.5, -4.8), wallCol, W))
	solid(Build.part(m, "FrontHeader", V(8.4, 1.2, 0.4), CF(1.8, 5.0, -4.8), wallCol, W))
	Build.part(m, "WindowPost", V(0.3, 2.0, 0.3), CF(1.8, 3.4, -4.8), trim, W)
	solid(Build.part(m, "Counter", V(8.6, 0.2, 1.0), CF(1.8, 2.5, -5.1), trim, W))
	local ra, rb =
		Build.tri(m, "Roof", CF(0, 7.0, 0) * CFrame.Angles(0, PI / 2, 0), 11.5, 2.8, 13, rgb(225, 185, 105), M.Fabric)
	solid(ra)
	solid(rb)
	local sign = Build.part(m, "SignBoard", V(6, 1.3, 0.3), CF(1.2, 6.25, -5.35), trim, W)
	Build.label(sign, Enum.NormalId.Front, "SURF SHACK", WHITE)
	local boards = { { rgb(255, 120, 60), WHITE }, { rgb(60, 190, 255), rgb(255, 230, 70) } }
	for i, x in { -5.3, 5.3 } do
		local cf = CF(x, 3.4, -5.35) * CFrame.Angles(0.12, 0, 0)
		Build.ellipsoid(m, "Surfboard", V(1.4, 5.5, 0.25), cf, boards[i][1])
		Build.ellipsoid(m, "SurfboardStripe", V(0.3, 5.2, 0.28), cf, boards[i][2])
	end
	solid(Build.part(m, "Step", V(3, 0.3, 1), CF(-3.3, 0.15, -5.4), WOOD_DARK, W))
	local lamp = Build.ball(m, "Lantern", 0.5, CF(-3.3, 4.1, -5.3), rgb(255, 230, 160), M.Neon)
	Build.glow(lamp, rgb(255, 220, 160), 1, 14)
end

local function fallback(m: Model, _v: number)
	solid(Build.part(m, "Crate", V(2, 2, 2), CF(0, 1, 0), WOOD, M.Wood))
	for _, y in { 0.35, 1.65 } do
		Build.part(m, "Band", V(2.04, 0.2, 2.04), CF(0, y, 0), WOOD_DARK, M.Wood)
	end
end

local ORDER = {
	"PalmTree",
	"Umbrella",
	"BeachTowel",
	"Sandcastle",
	"Crab",
	"LifeguardTower",
	"BoardwalkStall",
	"Surfboard",
	"BeachBall",
	"Rock",
	"Shell",
	"Chest",
	"Bucket",
	"Sign",
	"Lamp",
	"Bench",
	"Barrel",
	"Starfish",
	"Dock",
	"Flag",
	"Cooler",
	"SurfShack",
}

local function key(name: string): string
	return (string.gsub(string.lower(name), "[%s_%-]", ""))
end

local byKey: { [string]: string } = {}
for _, name in ORDER do
	byKey[key(name)] = name
end

function Props.Build(name: string, variant: number?): Model
	local canonical = byKey[key(name)]
	local m = Build.model(canonical or name)
	Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local v = math.max(1, math.floor(variant or 1))
	local builder: PropBuilder = if canonical then builders[canonical] else fallback
	builder(m, v)
	return m
end

function Props.List(): { string }
	return table.clone(ORDER)
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Rides</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Rides — the full-size ride-on vehicle for rideable pets (v2.1, Ride agent). Built from
	primitives only (Build.luau style, no asset ids). Currently every rideable pet is drawn as a
	big cartoon excavator (~18 studs nose to tail, tracks 12 long, roof ~10.6 high); VehicleKind
	other than "Excavator" falls back to it.

	Conventions (differ from the other builders because this model is DRIVEN by physics):
	- Front is -Z, up is +Y. PrimaryPart = invisible "Root" at the bottom-centre (pivot on the
	  ground under the tracks). Returned unparented with every part Anchored; RideService
	  unanchors it, so everything is joined: static parts WeldConstraint'ed to Root, moving
	  parts welded to their hinge, hinges joined by Motor6Ds.
	- "Chassis": the ONLY colliding part, an invisible hull (y 0.9..3.5, 8.9 x 11.6) that carries
	  the mass. It sits ~0.9 above the ground so it never drags on the sand. Every visible part is
	  Massless, CanCollide / CanQuery / CanTouch false.
	- "RideSeat" (Seat): CanTouch false so passers-by never sit down by touching it; RideService
	  seats the owner with Seat:Sit(humanoid).
	- Drive constraints in Root: Attachment "RideAttachment", AlignPosition "RideAlignPosition"
	  and AlignOrientation "RideAlignOrientation" (both OneAttachment). RideService sets the
	  initial targets and force; the rider's client (network owner) moves the targets.
	- Animated digging arm (RideController): Root -> Motor6D "BoomMotor" -> Model "Boom"
	  (PrimaryPart "BoomHinge") -> "StickMotor" -> Model "Stick" ("StickHinge") ->
	  "BucketMotor" -> Model "Bucket" ("BucketHinge"). Animate Motor6D.Transform with rotations
	  about the hinge's X axis (positive = raise the front). Part "BucketSand" (Transparency 1)
	  can be shown while the bucket carries a load.
	- Model attributes: "PetId", "VehicleKind".
]]

local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Rides = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis
local SMOOTH = Enum.Material.SmoothPlastic
local METAL = Enum.Material.Metal
local GLASS = Enum.Material.Glass
local NEON = Enum.Material.Neon

local TYRE = Color3.fromRGB(40, 38, 45)
local STEEL = Color3.fromRGB(150, 155, 165)
local DARK = Color3.fromRGB(60, 60, 70)
local SAND = Color3.fromRGB(240, 205, 130)
local DEFAULT_BODY = Color3.fromRGB(255, 190, 20)
local DEFAULT_ACCENT = Color3.fromRGB(255, 90, 160)

-- Geometry the services / controller rely on (studs, model space).
Rides.HULL_SIZE = V(8.9, 2.6, 11.6)
Rides.HULL_Y = 2.2 -- hull centre height above the pivot
Rides.SEAT_POSITION = V(-1.9, 5.7, 0)
Rides.BUCKET_TIP = V(1.6, 2.0, -11.2) -- bucket teeth at rest

-- Weld every BasePart that is a DIRECT child of `group` to `hinge`.
local function weldGroup(group: Instance, hinge: BasePart)
	for _, child in group:GetChildren() do
		if child:IsA("BasePart") and child ~= hinge then
			local w = Instance.new("WeldConstraint")
			w.Part0 = hinge
			w.Part1 = child
			w.Parent = child
		end
	end
end

-- Moving sub-assembly: Model `name` with an invisible hinge part as PrimaryPart.
local function group(parent: Instance, name: string, hinge: CFrame): (Model, Part)
	local g = Instance.new("Model")
	g.Name = name
	local h = Build.part(g, name .. "Hinge", V(0.4, 0.4, 0.4), hinge, Color3.new(1, 1, 1))
	h.Transparency = 1
	h.CastShadow = false
	g.PrimaryPart = h
	g.Parent = parent
	return g, h
end

local function motor(name: string, part0: BasePart, part1: BasePart): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = part0.CFrame:ToObjectSpace(part1.CFrame)
	m.C1 = CFrame.identity
	m.Parent = part1
	return m
end

local function track(parent: Instance, x: number)
	local length, height, width = 12, 2.2, 1.9
	local y = height / 2
	local inner = length - height
	Build.part(parent, "Track", V(width, height, inner), CF(x, y, 0), TYRE)
	for _, z in { -inner / 2, inner / 2 } do
		Build.cyl(parent, "Track", width, height, Build.orient(V(x, y, z), X), TYRE)
	end
	local side = if x >= 0 then 1 else -1
	-- road wheels on the outside + cleats on top
	for i = 0, 4 do
		local z = -inner / 2 + inner * i / 4
		Build.cyl(parent, "Roller", 0.12, 1.3, Build.orient(V(x + side * (width / 2 + 0.04), y, z), X), STEEL, METAL)
	end
	for i = 0, 6 do
		local z = -inner / 2 + inner * i / 6
		Build.part(parent, "Cleat", V(width + 0.06, 0.18, 0.4), CF(x, height + 0.05, z), DARK)
	end
end

local function build(m: Model, root: BasePart, body: Color3, accent: Color3, glow: boolean)
	-- Collision hull (the only colliding part; carries the mass)
	local hull = Build.part(m, "Chassis", Rides.HULL_SIZE, CF(0, Rides.HULL_Y, 0), body)
	hull.Transparency = 1
	hull.CanCollide = true
	hull.CastShadow = false
	hull.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0, 1, 1)

	-- Undercarriage
	for side = -1, 1, 2 do
		track(m, side * 3.5)
	end
	Build.part(m, "Frame", V(5, 1.2, 9), CF(0, 1.6, 0), DARK)
	Build.cyl(m, "Turntable", 0.4, 5, CF(0, 2.4, 0.4), STEEL, METAL)

	-- House: body, accent stripe, counterweight, engine
	local house = Build.part(m, "Body", V(7.2, 2.8, 7.4), CF(0, 4.0, 1.2), body)
	Build.part(m, "Stripe", V(7.3, 0.4, 7.5), CF(0, 4.7, 1.2), accent, if glow then NEON else SMOOTH)
	Build.part(m, "Counterweight", V(7.2, 2.2, 1.4), CF(0, 3.9, 5.6), Build.darken(body, 0.25))
	Build.part(m, "EngineGrille", V(0.1, 1.2, 2.6), CF(3.62, 4.0, 3.2), DARK, METAL)
	Build.cyl(m, "Exhaust", 2.4, 0.45, CF(2.6, 6.6, 4.2), DARK, METAL)
	Build.cyl(m, "Exhaust", 0.2, 0.6, CF(2.6, 7.8, 4.2), Color3.fromRGB(35, 35, 40), METAL)
	Build.face(m, CF(-1.9, 3.9, -2.52) * CFrame.Angles(0, 0, 0), 2.4, { radius = 0 })

	-- Open cab (canopy on four posts) so the rider stays visible
	Build.part(m, "CabFloor", V(3.4, 0.2, 3.8), CF(-1.9, 5.5, -0.5), Build.darken(body, 0.15))
	for _, x in { -3.45, -0.35 } do
		for _, z in { -2.25, 1.25 } do
			Build.cyl(m, "CabPost", 4.6, 0.3, CF(x, 7.9, z), DARK, METAL)
		end
	end
	Build.part(m, "CabRoof", V(3.8, 0.4, 4.2), CF(-1.9, 10.4, -0.5), body)
	Build.part(m, "RoofStripe", V(3.85, 0.15, 1.0), CF(-1.9, 10.6, -0.5), accent)
	local windshield =
		Build.part(m, "Windshield", V(3.0, 2.4, 0.12), CF(-1.9, 8.8, -2.3), Color3.fromRGB(150, 220, 255), GLASS)
	windshield.Transparency = 0.65
	local beacon = Build.ball(m, "Beacon", 0.6, CF(-1.9, 10.85, -0.5), Color3.fromRGB(255, 160, 30), NEON)
	if glow then
		Build.glow(beacon, accent, 1.2, 12)
		Build.sparkle(house, accent, 2)
	end
	-- seat + back + levers
	local seat = Instance.new("Seat")
	seat.Name = "RideSeat"
	seat.Size = V(2.2, 0.5, 2.2)
	seat.CFrame = CF(Rides.SEAT_POSITION)
	seat.Color = DARK
	seat.Material = SMOOTH
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.BottomSurface = Enum.SurfaceType.Smooth
	seat.Anchored = true
	seat.CanCollide = false
	seat.CanQuery = false
	seat.CanTouch = false -- only Seat:Sit(owner) seats anyone
	seat.Parent = m
	Build.part(m, "SeatBack", V(2.2, 2.0, 0.4), CF(-1.9, 6.9, 1.05), DARK)
	for side = -1, 1, 2 do
		Build.cylBetween(
			m,
			"Lever",
			V(-1.9 + side * 0.7, 5.7, -1.6),
			V(-1.9 + side * 0.7, 7.0, -1.3),
			0.14,
			STEEL,
			METAL
		)
		Build.ball(m, "LeverKnob", 0.32, CF(-1.9 + side * 0.7, 7.05, -1.28), accent)
	end

	-- Digging arm: boom -> stick -> bucket
	local foot = V(1.6, 5.0, -2.2)
	local elbow = V(1.6, 10.0, -7.0)
	local wrist = V(1.6, 4.2, -10.0)
	local boom, boomHinge = group(m, "Boom", CF(foot))
	Build.beam(boom, "BoomBeam", foot, elbow, 1.0, 0.9, body, SMOOTH, X)
	Build.cylBetween(boom, "Piston", foot + V(0, -0.8, -0.4), foot:Lerp(elbow, 0.55) + V(0, -0.6, 0), 0.4, STEEL, METAL)
	Build.ball(boom, "BoomFoot", 1.2, CF(foot), accent, METAL)
	local stick, stickHinge = group(boom, "Stick", CF(elbow))
	Build.beam(stick, "StickBeam", elbow, wrist, 0.8, 0.8, body, SMOOTH, X)
	Build.ball(stick, "Elbow", 1.2, CF(elbow), accent, METAL)
	Build.cylBetween(stick, "Piston", elbow + V(0, 0.6, 0.5), wrist + V(0, 1.6, 0.6), 0.32, STEEL, METAL)
	local bucket, bucketHinge = group(stick, "Bucket", CF(wrist))
	local bk = CF(wrist) * CFrame.Angles(-0.35, 0, 0)
	Build.part(bucket, "BucketBottom", V(2.8, 0.2, 2.0), bk * CF(0, -1.7, -0.9), accent, METAL)
	Build.part(bucket, "BucketBack", V(2.8, 1.9, 0.2), bk * CF(0, -0.8, 0.1), accent, METAL)
	for side = -1, 1, 2 do
		Build.part(bucket, "BucketSide", V(0.2, 1.9, 2.0), bk * CF(side * 1.4, -0.8, -0.9), accent, METAL)
	end
	for i = 0, 3 do
		local x = -1.05 + i * 0.7
		local base = (bk * CF(x, -1.7, -1.85)).Position
		local tip = (bk * CF(x, -1.75, -2.45)).Position
		Build.spike(bucket, "Tooth", base, tip, 0.35, STEEL, METAL)
	end
	Build.ball(bucket, "Wrist", 0.9, CF(wrist), accent, METAL)
	local load =
		Build.ellipsoid(bucket, "BucketSand", V(2.4, 1.0, 1.6), bk * CF(0, -1.2, -0.9), SAND, Enum.Material.Sand)
	load.Transparency = 1

	-- Joints: statics -> Root, groups -> their hinge, hinges -> Motor6D chain
	weldGroup(m, root)
	weldGroup(boom, boomHinge)
	weldGroup(stick, stickHinge)
	weldGroup(bucket, bucketHinge)
	motor("BoomMotor", root, boomHinge)
	motor("StickMotor", boomHinge, stickHinge)
	motor("BucketMotor", stickHinge, bucketHinge)

	-- Only the hull has mass; nothing else collides or blocks raycasts.
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d ~= hull then
			d.Massless = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end

	-- Drive constraints (targets + force set by RideService / RideController)
	local attachment = Instance.new("Attachment")
	attachment.Name = "RideAttachment"
	attachment.Parent = root
	local alignPosition = Instance.new("AlignPosition")
	alignPosition.Name = "RideAlignPosition"
	alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPosition.Attachment0 = attachment
	alignPosition.ApplyAtCenterOfMass = true
	alignPosition.Responsiveness = Config.Ride.Responsiveness
	alignPosition.MaxVelocity = Config.Ride.MaxSpeed * 2
	alignPosition.MaxForce = 1e6
	alignPosition.Parent = root
	local alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Name = "RideAlignOrientation"
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.Attachment0 = attachment
	alignOrientation.Responsiveness = Config.Ride.Responsiveness
	alignOrientation.MaxTorque = 1e9
	alignOrientation.MaxAngularVelocity = 6
	alignOrientation.Parent = root
end

function Rides.Build(petId: string): Model
	local def = Config.GetPet(petId)
	if not def then
		for _, candidate in Config.Pets do
			if candidate.Id == petId then
				def = candidate
				break
			end
		end
	end
	local look = if def then def.Look else nil
	local body = if look then look.BodyColor else DEFAULT_BODY
	local accent = if look then look.AccentColor else DEFAULT_ACCENT
	local glow = if look then look.Glow == true else false
	local kind = if def and def.VehicleKind then def.VehicleKind else "Excavator"

	local m = Build.model("Ride_" .. petId)
	m:SetAttribute("PetId", petId)
	m:SetAttribute("VehicleKind", kind)
	local root = Build.root(m, CFrame.identity, V(1, 0.2, 1))
	build(m, root, body, accent, glow)
	return m
end

return Rides
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Shades</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Shades — placeable shade items (Config.Shades), chunky low-poly cartoon style.
	PrimaryPart = invisible "Root" at the bottom-centre (the ground point under the pole).
	Front is -Z. Everything is anchored; only the poles/posts are CanCollide (players walk under
	the canopy and bump into the poles). The canopy underside sits at ShadeDef.Height studs so it
	visibly covers the shaded circle (gameplay Radius is a little wider than the cloth).
	Model attributes: ShadeId, Radius, Height (handy for placement ghosts / owner labels).
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local ShadesModels = {}

local V = Vector3.new
local CF = CFrame.new
local rgb = Color3.fromRGB
local PI = math.pi
local M = Enum.Material

local WHITE = rgb(255, 255, 255)
local SAND = rgb(255, 222, 140)
local WOOD = rgb(176, 120, 72)
local WOOD_DARK = rgb(130, 85, 50)
local METAL = rgb(235, 235, 240)
local GOLD = rgb(255, 205, 40)
local STRAW = rgb(225, 190, 110)

local solid = Build.solid

type Look = { Color: Color3, Accent: Color3 }
type Builder = (m: Model, def: Types.ShadeDef, look: Look) -> ()

-- Faceted cone / pyramid roof: n triangles from the rim (circumradius R at height rimY) to the
-- apex. `offset` rotates the facets (-PI/4 with n = 4 gives an axis-aligned square roof).
local function roof(
	m: Model,
	name: string,
	centre: Vector3,
	rimY: number,
	apexY: number,
	R: number,
	n: number,
	offset: number,
	colors: { Color3 },
	material: Enum.Material?
): { { Base: Vector3, Tangent: Vector3, Width: number } }
	local apex = centre + V(0, apexY, 0)
	local apothem = R * math.cos(PI / n)
	local width = 2 * R * math.sin(PI / n)
	local edges = {}
	for k = 0, n - 1 do
		local a = offset + (k + 0.5) / n * PI * 2
		local base = centre + V(apothem * math.cos(a), rimY, apothem * math.sin(a))
		local tangent = V(-math.sin(a), 0, math.cos(a))
		Build.triPts(m, name, base, apex, tangent, width + 0.06, 0.14, colors[k % #colors + 1], material)
		table.insert(edges, { Base = base, Tangent = tangent, Width = width })
	end
	return edges
end

-- Hanging valance / scallops along every roof edge.
local function valance(
	m: Model,
	edges: { { Base: Vector3, Tangent: Vector3, Width: number } },
	depth: number,
	colors: { Color3 },
	scallops: number,
	material: Enum.Material?
)
	for i, e in edges do
		local strip = e.Width / scallops
		for s = 0, scallops - 1 do
			local along = (s + 0.5) * strip - e.Width / 2
			local pos = e.Base + e.Tangent * along - V(0, depth / 2, 0)
			local col = colors[(i + s) % #colors + 1]
			local cf = CFrame.fromMatrix(pos, e.Tangent, Vector3.yAxis)
			-- little pennant: a block with a downward triangle tip
			Build.part(m, "Valance", V(strip * 0.96, depth * 0.55, 0.1), cf * CF(0, depth * 0.22, 0), col, material)
			Build.tri(
				m,
				"Valance",
				cf * CF(0, -depth * 0.28, 0) * CFrame.Angles(0, 0, PI),
				strip * 0.96,
				depth * 0.45,
				0.1,
				col,
				material
			)
		end
	end
end

local function pole(m: Model, a: Vector3, b: Vector3, d: number, color: Color3, material: Enum.Material?): BasePart
	return solid(Build.cylBetween(m, "Pole", a, b, d, color, material))
end

local function mound(m: Model, size: number)
	Build.ellipsoid(m, "Mound", V(size, size * 0.3, size), CF(), SAND, M.Sand)
end

-- Builders ----------------------------------------------------------------------------------------

local builders: { [string]: Builder } = {}

builders.Umbrella = function(m, def, look)
	local H = def.Height
	local R = def.Radius * 0.75
	mound(m, 1.6)
	pole(m, V(0, 0, 0), V(0, H + 1.6, 0), 0.32, METAL)
	local edges = roof(m, "Canopy", Vector3.zero, H, H + 1.5, R, 10, 0, { look.Color, look.Accent }, M.Fabric)
	valance(m, edges, 0.5, { look.Color, look.Accent }, 1, M.Fabric)
	Build.ball(m, "Finial", 0.5, CF(0, H + 1.75, 0), look.Color)
	-- hub ring + a few ribs under the canopy
	Build.cyl(m, "Hub", 0.35, 0.6, CF(0, H - 0.4, 0), WHITE)
end

builders.Striped = function(m, def, look)
	local H = def.Height
	local R = def.Radius * 0.72
	mound(m, 1.8)
	for i = 0, 3 do
		local y0 = i * (H + 1.6) / 4
		local y1 = (i + 1) * (H + 1.6) / 4
		pole(m, V(0, y0, 0), V(0, y1, 0), 0.36, if i % 2 == 0 then WHITE else look.Color)
	end
	local stripes = { look.Color, WHITE, look.Accent, WHITE }
	local edges = roof(m, "Canopy", Vector3.zero, H, H + 1.8, R, 12, 0, stripes, M.Fabric)
	valance(m, edges, 0.6, { look.Accent, look.Color }, 2, M.Fabric)
	Build.ball(m, "Finial", 0.6, CF(0, H + 2.05, 0), look.Accent)
	Build.cyl(m, "Hub", 0.4, 0.7, CF(0, H - 0.4, 0), WHITE)
end

builders.Tarp = function(m, def, look)
	local H = def.Height
	local sx, sz = def.Radius * 0.6, def.Radius * 0.5
	local corners = { V(-sx, 0, -sz), V(sx, 0, -sz), V(-sx, 0, sz), V(sx, 0, sz) }
	for i, c in corners do
		local top = H + (if c.Z < 0 then 0.9 else 0) -- front edge higher: slanted tarp
		pole(m, c, c + V(0, top + 0.4, 0), 0.5, if i % 2 == 0 then WOOD else WOOD_DARK, M.Wood)
		Build.ball(m, "PoleCap", 0.6, CF(c + V(0, top + 0.45, 0)), WOOD_DARK, M.Wood)
		-- guy rope to a stake outside the corner
		local out = V(math.sign(c.X), 0, math.sign(c.Z))
		local stake = c + out * 2.2
		Build.cylBetween(m, "Rope", c + V(0, top, 0), stake + V(0, 0.4, 0), 0.08, rgb(240, 230, 200))
		Build.part(m, "Stake", V(0.3, 0.8, 0.3), CF(stake + V(0, 0.3, 0)), WOOD_DARK, M.Wood)
	end
	-- tarp sheet, tilted (front higher)
	local front = V(0, H + 0.9, -sz)
	local back = V(0, H, sz)
	local mid = front:Lerp(back, 0.5)
	local depth = (back - front).Magnitude
	local tarpCf = CFrame.lookAt(mid, mid + (back - front), Vector3.yAxis)
	Build.part(m, "Tarp", V(sx * 2 + 1.2, 0.18, depth + 1.2), tarpCf, look.Color, M.Fabric)
	-- two lighter stripes across the sheet
	for _, t in { -0.25, 0.25 } do
		Build.part(
			m,
			"TarpStripe",
			V(sx * 2 + 1.22, 0.2, 0.9),
			tarpCf * CF(0, 0, t * depth),
			Build.lighten(look.Color, 0.45),
			M.Fabric
		)
	end
	-- palm leaves tucked on top for the island look
	for k = 0, 2 do
		local a = k / 3 * PI * 2 + 0.3
		local base = mid + V(0, 0.25, 0)
		local tip = base + V(math.cos(a) * 3.2, 0.3, math.sin(a) * 3.2)
		Build.triPts(m, "Leaf", base, tip, V(-math.sin(a), 0, math.cos(a)), 1.3, 0.12, rgb(70, 190, 95))
	end
end

builders.Canopy = function(m, def, look)
	local H = def.Height
	local s = def.Radius * 0.62
	for _, c in { V(-s, 0, -s), V(s, 0, -s), V(-s, 0, s), V(s, 0, s) } do
		pole(m, c, c + V(0, H + 0.2, 0), 0.4, METAL, M.Metal)
		Build.part(m, "Foot", V(0.9, 0.2, 0.9), CF(c + V(0, 0.1, 0)), rgb(120, 120, 130), M.Metal)
	end
	-- frame
	for _, pair in { { V(-s, H, -s), V(s, H, -s) }, { V(-s, H, s), V(s, H, s) } } do
		Build.cylBetween(m, "Frame", pair[1], pair[2], 0.25, METAL, M.Metal)
	end
	for _, pair in { { V(-s, H, -s), V(-s, H, s) }, { V(s, H, -s), V(s, H, s) } } do
		Build.cylBetween(m, "Frame", pair[1], pair[2], 0.25, METAL, M.Metal)
	end
	local R = s / math.cos(PI / 4)
	local edges = roof(m, "Canopy", Vector3.zero, H + 0.1, H + 2.6, R, 4, -PI / 4, { look.Color }, M.Fabric)
	valance(m, edges, 0.9, { look.Color, look.Accent }, 6, M.Fabric)
	-- bunting between front poles
	local n = 7
	for i = 0, n - 1 do
		local t = (i + 0.5) / n
		local x = -s + t * 2 * s
		local sag = math.sin(t * PI) * 0.7
		local col = ({ rgb(255, 90, 90), rgb(255, 210, 60), rgb(60, 170, 255), rgb(90, 210, 120) })[i % 4 + 1]
		Build.tri(m, "Bunting", CF(x, H - 1.2 - sag, -s - 0.1) * CFrame.Angles(0, 0, PI), 0.8, 0.8, 0.08, col)
	end
	Build.cylBetween(m, "BuntingRope", V(-s, H - 0.75, -s - 0.1), V(s, H - 0.75, -s - 0.1), 0.05, WHITE)
end

builders.Cabana = function(m, def, look)
	local H = def.Height
	local s = def.Radius * 0.55
	for _, c in { V(-s, 0, -s), V(s, 0, -s), V(-s, 0, s), V(s, 0, s) } do
		pole(m, c, c + V(0, H + 0.4, 0), 0.8, WOOD, M.Wood)
		-- tied-back curtain on each post
		local inward = -V(math.sign(c.X), 0, math.sign(c.Z)) * 0.6
		Build.part(
			m,
			"Curtain",
			V(0.9, H - 1.4, 0.9),
			CF(c + inward + V(0, (H - 1.4) / 2 + 0.9, 0)),
			look.Accent,
			M.Fabric
		)
		Build.cyl(m, "Tie", 0.3, 1.05, CF(c + inward + V(0, H * 0.45, 0)), GOLD)
	end
	-- beams
	for _, pair in { { V(-s, H, -s), V(s, H, -s) }, { V(-s, H, s), V(s, H, s) } } do
		Build.beam(m, "Beam", pair[1], pair[2], 0.7, 0.7, WOOD_DARK, M.Wood, Vector3.zAxis)
	end
	-- thatched pyramid roof (two layers for a chunky straw look)
	local R = (s + 1.4) / math.cos(PI / 4)
	local edges =
		roof(m, "Thatch", Vector3.zero, H + 0.3, H + 4, R, 4, -PI / 4, { STRAW, Build.darken(STRAW, 0.1) }, M.Grass)
	roof(m, "Thatch", Vector3.zero, H + 1.6, H + 4.4, R * 0.62, 4, -PI / 4, { Build.lighten(STRAW, 0.1) }, M.Grass)
	valance(m, edges, 0.9, { Build.darken(STRAW, 0.15), STRAW }, 7, M.Grass)
	-- tiki top + rug
	Build.ball(m, "Topper", 0.9, CF(0, H + 4.3, 0), rgb(255, 120, 60))
	Build.part(m, "Rug", V(s * 1.6, 0.08, s * 1.6), CF(0, 0.05, 0), look.Accent, M.Fabric)
	Build.part(m, "RugStripe", V(s * 1.62, 0.09, 0.6), CF(0, 0.06, 0), WHITE, M.Fabric)
end

builders.Tent = function(m, def, look)
	local H = def.Height
	local R = def.Radius * 0.62
	local n = 8
	pole(m, V(0, 0, 0), V(0, H + 3.4, 0), 0.5, GOLD, M.Metal)
	for k = 0, n - 1 do
		local a = (k / n) * PI * 2
		local c = V(math.cos(a) * R, 0, math.sin(a) * R)
		pole(m, c, c + V(0, H, 0), 0.38, GOLD, M.Metal)
		Build.ball(m, "PoleCap", 0.6, CF(c + V(0, H + 0.1, 0)), GOLD, M.Metal)
		-- drapes on alternating poles
		if k % 2 == 0 then
			Build.part(
				m,
				"Drape",
				V(1.1, H - 1, 0.25),
				CFrame.lookAt(c + V(0, (H - 1) / 2 + 0.8, 0), V(0, (H - 1) / 2 + 0.8, 0)) * CF(0, 0, 0.4),
				Build.darken(look.Color, 0.05),
				M.Fabric
			)
		end
	end
	-- the polygon roof: corners at the poles (offset so facets meet at pole tops)
	local edges = roof(
		m,
		"Canopy",
		Vector3.zero,
		H,
		H + 3.2,
		R,
		n,
		-PI / n,
		{ look.Color, Build.darken(look.Color, 0.06) },
		M.Fabric
	)
	valance(m, edges, 0.8, { look.Accent, look.Color }, 3, M.Fabric)
	Build.ball(m, "Finial", 0.9, CF(0, H + 3.6, 0), GOLD, M.Metal)
	Build.part(m, "Flag", V(0.08, 0.7, 1.2), CF(0, H + 4.6, 0.6), rgb(255, 90, 120), M.Fabric)
	Build.cylBetween(m, "FlagPole", V(0, H + 3.6, 0), V(0, H + 5.1, 0), 0.1, GOLD)
end

builders.Pavilion = function(m, def, look)
	local H = def.Height
	local R = def.Radius * 0.58
	local n = 8
	-- low marble-ish base ring (decorative, non-colliding so you can walk on the sand)
	Build.cyl(m, "Base", 0.3, R * 2 + 1.5, CF(0, 0.15, 0), rgb(245, 235, 215), M.Marble)
	for k = 0, n - 1 do
		local a = (k / n) * PI * 2
		local c = V(math.cos(a) * R, 0, math.sin(a) * R)
		pole(m, c, c + V(0, H, 0), 1, rgb(250, 245, 235), M.Marble)
		Build.part(m, "Capital", V(1.6, 0.5, 1.6), CF(c + V(0, H + 0.1, 0)), GOLD, M.Metal)
		Build.part(m, "Plinth", V(1.6, 0.5, 1.6), CF(c + V(0, 0.45, 0)), GOLD, M.Metal)
	end
	-- ring beam
	for k = 0, n - 1 do
		local a0 = (k / n) * PI * 2
		local a1 = ((k + 1) / n) * PI * 2
		local p0 = V(math.cos(a0) * R, H + 0.5, math.sin(a0) * R)
		local p1 = V(math.cos(a1) * R, H + 0.5, math.sin(a1) * R)
		Build.beam(m, "RingBeam", p0, p1, 0.8, 0.8, GOLD, M.Metal)
	end
	-- two-tier roof
	local edges = roof(
		m,
		"Roof",
		Vector3.zero,
		H + 0.8,
		H + 3.4,
		R + 1.4,
		n,
		-PI / n,
		{ look.Color, Build.darken(look.Color, 0.12) },
		M.Fabric
	)
	valance(m, edges, 0.9, { look.Accent, look.Color }, 3, M.Fabric)
	roof(m, "Roof", Vector3.zero, H + 3, H + 5.4, R * 0.55, n, -PI / n, { look.Color }, M.Fabric)
	-- crown
	Build.ball(m, "Orb", 1.4, CF(0, H + 5.8, 0), GOLD, M.Metal)
	for k = 0, 4 do
		local a = (k / 5) * PI * 2
		Build.spike(
			m,
			"CrownSpike",
			V(math.cos(a) * 0.5, H + 6.1, math.sin(a) * 0.5),
			V(math.cos(a) * 0.7, H + 7.1, math.sin(a) * 0.7),
			0.5,
			GOLD,
			M.Metal
		)
	end
	local gem = Build.ball(m, "Gem", 0.5, CF(0, H + 6.6, 0), rgb(255, 80, 200), M.Neon)
	Build.glow(gem, rgb(255, 120, 220), 1, 10)
end

local function fallback(m: Model, def: Types.ShadeDef, look: Look)
	builders.Umbrella(m, def, look)
end

-- Public --------------------------------------------------------------------------------------------

local DEFAULT_DEF: Types.ShadeDef = {
	Id = "unknown",
	Name = "Shade",
	Price = 0,
	Radius = 6,
	Cooling = 1,
	Height = 7.5,
	Description = "",
	Look = {},
}

function ShadesModels.Build(id: string): Model
	local def = Config.GetShade(id) or DEFAULT_DEF
	local m = Build.model(id)
	Build.root(m, CFrame.identity, V(1, 0.1, 1))
	local raw = def.Look
	local look: Look = {
		Color = if typeof(raw.Color) == "Color3" then raw.Color else rgb(255, 80, 90),
		Accent = if typeof(raw.Accent) == "Color3" then raw.Accent else WHITE,
	}
	local style = if type(raw.Style) == "string" then raw.Style else "Umbrella"
	local builder: Builder = builders[style] or fallback
	builder(m, def, look)
	m:SetAttribute("ShadeId", id)
	m:SetAttribute("Radius", def.Radius)
	m:SetAttribute("Height", def.Height)
	return m
end

return ShadesModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Shovels</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Shovels — held tools. Built in "tool space": origin at the top end of the shaft (the end
	away from the head), shaft along +Y towards the head, blade plane = XY. The blade's cupped
	(scooping) face is +Z, its "dig" edge/back is -Z.

	Two sizes (Look.Size, Types.ShovelSize):
	  "Hand"  small one-handed hand spade / trowel (~1.9 studs): short grip, scaled-down head.
	  "Full"  (default) full-size shovel held with BOTH hands: D-grip (Spade/Scoop/Trowel heads)
	          or T-grip (Pick/Claw/Trident/Drill) on top, a foam sleeve on the shaft for the
	          left hand, head at the far end.

	PrimaryPart = Part "Handle" (the top grip section). Every other part is welded to it with a
	WeldConstraint, Massless, CanCollide false, and still Anchored (the server unanchors).

	Handle attributes (all vectors / points in HANDLE space):
	  GripOffset  CFrame   -> Tool.Grip (the right palm frame, see below)
	  TwoHanded   boolean  full-size tool (ShopService copies it onto the Tool)
	  ShaftAxis   Vector3  tool +Y (top grip -> head)
	  CupAxis     Vector3  tool +Z (the blade's cupped face)
	  LeftHand    Vector3  where the left palm grips the shaft (two-handed tools only)
	  BladePoint  Vector3  centre of the blade's cupped face (the client rides a sand clump here)
	The client ShovelPoseController reads these to pose both arms and play the scoop.

	Grip math (verified against the engine's tool weld):
	  When a Tool is equipped the engine makes Weld "RightGrip": Part0 = RightHand (R15) /
	  Right Arm (R6), C0 = RightGripAttachment.CFrame (R15: CFrame.new(0, -0.15, 0) *
	  Angles(-90deg, 0, 0); R6: CFrame.new(0, -1, 0) * the same rotation), Part1 = Handle,
	  C1 = Tool.Grip. Weld rule: Hand * C0 == Handle * Grip, so
	      Handle = (Hand * C0) * Grip:Inverse()          -- call Hand * C0 the palm frame G.
	  G's axes, read on the R15 hand: G.Y = hand -Z (the fist axis, out of the thumb side),
	  G.Z = hand +Y (from the palm back towards the wrist / forearm), G.X = hand +X (the back of
	  the right hand). In the default "toolnone" hold animation (forearm pointing forward)
	  G's axes are the CHARACTER's axes (X right, Y up, Z back). Grip = G expressed in Handle
	  space = Handle:ToObjectSpace(T), with T = the palm frame written in tool space:
	  * Hand tools: T = CFrame.new(0, HAND_PALM_Y, 0) * HoldRotation:Inverse(), HoldRotation =
	    Ry(+INWARD) * Rx(-(90deg + DOWN)): in the plain hold pose the shaft runs down and forward
	    from the fist (DOWN = 55deg below horizontal, yawed INWARD 10deg), cup face up/forward.
	    The pose controller only takes over during a scoop, so this is also the idle look.
	  * Full tools: the right palm wraps the grip crossbar: fist axis G.Y = tool -X (along the
	    crossbar), forearm G.Z = tool -Y (straight in line with the shaft, so the wrist stays
	    straight), back of the hand G.X = tool +Z (overhand grip, knuckles on the cup side).
	    T = CFrame.fromMatrix((0, palmY, 0), +Z, -X, -Y). Without the pose controller (R6
	    avatars) the shovel simply points forward from the fist.
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Shovels = {}

-- Hand tools ------------------------------------------------------------------------------------
local HAND_PALM_Y = 0.38 -- palm on the middle of the short grip
local HAND_GRIP_LEN = 0.75
local HAND_HB = 1.05 -- head base
local HAND_HEAD_SCALE = 0.55 -- head builders are full size; hand tools shrink them
local HOLD_DOWN = math.rad(55) -- shaft angle below horizontal in the plain hold pose
local HOLD_INWARD = math.rad(10) -- yaw towards the body centre
local HOLD_ROTATION = CFrame.Angles(0, HOLD_INWARD, 0) * CFrame.Angles(-(math.pi / 2 + HOLD_DOWN), 0, 0)

-- Full (two-handed) tools -----------------------------------------------------------------------
local FULL_HANDLE_LEN = 1.0 -- Handle part: the shaft's top section
local FULL_SHAFT_TOP = 2.15
local FULL_HB = 2.4 -- head base (top of collar)
local FULL_LEFT_Y = 0.75 -- left hand on the foam sleeve, ~1.2 studs below the right palm
local D_GRIP_Y = -0.42 -- D-grip crossbar (right palm) above the shaft top
local T_GRIP_Y = -0.16 -- T-grip crossbar sits right on the shaft top
local D_GRIP_SHAPES = { Spade = true, Scoop = true, Trowel = true }

local FALLBACK: Types.ShovelLook = {
	HeadColor = Color3.fromRGB(255, 140, 40),
	HandleColor = Color3.fromRGB(255, 220, 80),
	HeadShape = "Spade",
	Material = Enum.Material.SmoothPlastic,
	Glow = false,
}

local V = Vector3.new
local X = Vector3.xAxis

type HeadBuilder = (m: Model, c: Color3, mat: Enum.Material, look: Types.ShovelLook, hb: number) -> BasePart

local function accent(look: Types.ShovelLook): (Color3, Enum.Material)
	if look.Glow then
		-- Saturated accent (not lightened): pale Neon blooms to white. Build clamps it further.
		return Build.lighten(look.HeadColor, 0.1), Enum.Material.Neon
	end
	return Build.darken(look.HeadColor, 0.25), look.Material
end

local heads: { [string]: HeadBuilder } = {}

heads.Scoop = function(m, c, mat, look, hb)
	Build.part(m, "Neck", V(0.42, 0.45, 0.22), CFrame.new(0, hb, 0), c, mat)
	local blade = Build.part(m, "Blade", V(1.3, 1.25, 0.14), CFrame.new(0, hb + 0.72, 0), c, mat)
	Build.ellipsoid(m, "BladeTip", V(1.3, 0.9, 0.14), CFrame.new(0, hb + 1.34, 0), c, mat)
	local rim = Build.darken(c, 0.12)
	for side = -1, 1, 2 do
		Build.part(
			m,
			"Rim",
			V(0.14, 1.35, 0.34),
			CFrame.new(side * 0.6, hb + 0.78, 0.12) * CFrame.Angles(0, 0, side * 0.05),
			rim,
			mat
		)
	end
	Build.part(m, "BackRim", V(1.3, 0.14, 0.34), CFrame.new(0, hb + 0.1, 0.12), rim, mat)
	if look.Glow then
		local ac, am = accent(look)
		Build.part(m, "GlowStrip", V(0.9, 0.12, 0.17), CFrame.new(0, hb + 0.9, 0), ac, am)
	end
	return blade
end

heads.Trowel = function(m, c, mat, look, hb)
	Build.cyl(m, "Neck", 0.5, 0.26, CFrame.new(0, hb, 0), c, mat)
	local blade = Build.part(m, "Blade", V(0.95, 0.8, 0.1), CFrame.new(0, hb + 0.6, 0), c, mat)
	Build.tri(m, "BladeTip", CFrame.new(0, hb + 1.45, 0), 0.95, 0.9, 0.1, c, mat)
	local ac, am = accent(look)
	Build.part(m, "Ridge", V(0.14, 1.45, 0.16), CFrame.new(0, hb + 0.85, 0), ac, am)
	return blade
end

heads.Spade = function(m, c, mat, look, hb)
	Build.cyl(m, "Socket", 0.7, 0.36, CFrame.new(0, hb + 0.2, 0.02), c, mat)
	local blade = Build.part(m, "Blade", V(1.2, 1.2, 0.14), CFrame.new(0, hb + 0.7, 0), c, mat)
	Build.tri(m, "BladeTip", CFrame.new(0, hb + 1.52, 0), 1.2, 0.45, 0.14, c, mat)
	local ac, am = accent(look)
	Build.part(m, "Tread", V(1.28, 0.14, 0.32), CFrame.new(0, hb + 0.13, 0.04), ac, am)
	if look.Glow then
		Build.part(m, "GlowStrip", V(0.14, 1.0, 0.17), CFrame.new(0, hb + 0.85, 0), ac, am)
	end
	return blade
end

heads.Pick = function(m, c, mat, look, hb)
	Build.cyl(m, "ShaftTop", 0.4, 0.3, CFrame.new(0, hb + 0.1, 0), look.HandleColor)
	local socket = Build.part(m, "Socket", V(0.5, 0.55, 0.6), CFrame.new(0, hb + 0.35, 0), c, mat)
	local mid = V(0, hb + 0.35, 0)
	-- Pointed arm towards -Z (down when held), chisel arm towards +Z; both curve back to the grip.
	local frontElbow = V(0, hb + 0.25, -0.9)
	local backElbow = V(0, hb + 0.25, 0.8)
	Build.beam(m, "Arm", mid, frontElbow, 0.34, 0.34, c, mat, X)
	Build.beam(m, "Arm", mid, backElbow, 0.34, 0.34, c, mat, X)
	Build.spike(m, "Point", frontElbow, V(0, hb - 0.15, -1.55), 0.38, c, mat)
	Build.triPts(m, "Chisel", backElbow, V(0, hb, 1.3), X, 0.5, 0.18, c, mat)
	local ac, am = accent(look)
	Build.part(m, "Band", V(0.56, 0.18, 0.66), CFrame.new(0, hb + 0.35, 0), ac, am)
	return socket
end

heads.Claw = function(m, c, mat, look, hb)
	local palm = Build.ellipsoid(m, "Palm", V(1.05, 0.6, 0.6), CFrame.new(0, hb + 0.2, 0), c, mat)
	local ac, am = accent(look)
	for i = -1, 1 do
		local x = i * 0.36
		local len = if i == 0 then 1.15 else 0.95
		local knuckle = V(x, hb + 0.25, 0)
		local bend = V(x * 1.1, hb + len, -0.12)
		Build.cylBetween(m, "Finger", knuckle, bend, 0.26, c, mat)
		Build.triPts(m, "Talon", bend - V(0, 0.05, 0), V(x * 1.15, hb + len + 0.55, -0.6), X, 0.3, 0.2, ac, am)
	end
	return palm
end

heads.Trident = function(m, c, mat, look, hb)
	Build.cyl(m, "Socket", 0.5, 0.3, CFrame.new(0, hb + 0.05, 0), c, mat)
	local bar = Build.beam(m, "Crossbar", V(-0.68, hb + 0.35, 0), V(0.68, hb + 0.35, 0), 0.24, 0.22, c, mat)
	local ac, am = accent(look)
	Build.cylBetween(m, "Tine", V(0, hb + 0.2, 0), V(0, hb + 1.35, 0), 0.2, c, mat)
	Build.tri(m, "Barb", CFrame.new(0, hb + 1.55, 0), 0.46, 0.5, 0.14, ac, am)
	for side = -1, 1, 2 do
		local x = side * 0.6
		Build.cylBetween(m, "Tine", V(x, hb + 0.3, 0), V(x * 1.05, hb + 1.05, 0), 0.18, c, mat)
		Build.triPts(m, "Barb", V(x * 1.05, hb + 1.0, 0), V(x * 1.1, hb + 1.42, 0), X, 0.36, 0.12, ac, am)
	end
	return bar
end

heads.Drill = function(m, c, mat, look, hb)
	local housing = Build.cyl(m, "Housing", 0.8, 0.9, CFrame.new(0, hb + 0.35, 0), look.HandleColor)
	local ac, am = accent(look)
	local tiers = { 1.0, 0.8, 0.6, 0.4 }
	for i, d in tiers do
		local col = if i % 2 == 1 then c else Build.lighten(c, 0.2)
		Build.cyl(m, "Bit", 0.36, d, CFrame.new(0, hb + 0.45 + i * 0.33, 0) * CFrame.Angles(0, i * 0.4, 0), col, mat)
	end
	Build.spike(m, "Tip", V(0, hb + 1.95, 0), V(0, hb + 2.4, 0), 0.32, ac, am)
	Build.cyl(m, "Band", 0.12, 0.94, CFrame.new(0, hb + 0.35, 0), ac, am)
	return housing
end

-- Builds the head at base height `hb`, scaled by `s` about the head base. Returns the main part.
local function addHead(m: Model, look: Types.ShovelLook, hb: number, s: number): BasePart
	local builder = heads[look.HeadShape] or heads.Spade
	local temp = Build.model("Head")
	local main = builder(temp, look.HeadColor, look.Material, look, hb)
	Build.scale(temp, CFrame.new(0, hb, 0), s)
	for _, child in temp:GetChildren() do
		child.Parent = m
	end
	temp:Destroy()
	if look.Glow then
		Build.glow(main, look.HeadColor, 1.2 * s, 8 * s)
	end
	return main
end

-- Shared finish: attributes, PrimaryPart, massless, welds.
local function finish(
	m: Model,
	handle: BasePart,
	palm: CFrame,
	twoHanded: boolean,
	leftHand: Vector3?,
	bladePoint: Vector3
): Model
	local hcf = handle.CFrame
	handle.CanTouch = true
	handle:SetAttribute("GripOffset", hcf:ToObjectSpace(palm))
	handle:SetAttribute("TwoHanded", twoHanded)
	handle:SetAttribute("ShaftAxis", hcf:VectorToObjectSpace(Vector3.yAxis))
	handle:SetAttribute("CupAxis", hcf:VectorToObjectSpace(Vector3.zAxis))
	if leftHand then
		handle:SetAttribute("LeftHand", hcf:PointToObjectSpace(leftHand))
	end
	handle:SetAttribute("BladePoint", hcf:PointToObjectSpace(bladePoint))
	m.PrimaryPart = handle
	Build.massless(m, handle)
	Build.weldAll(m, handle)
	return m
end

local function buildHand(id: string, look: Types.ShovelLook): Model
	local m = Build.model(id)
	local hc = look.HandleColor
	local trim = Build.darken(hc, 0.25)
	local handle = Build.cyl(m, "Handle", HAND_GRIP_LEN, 0.34, CFrame.new(0, HAND_GRIP_LEN / 2, 0), hc)
	Build.ellipsoid(m, "GripKnob", V(0.42, 0.24, 0.42), CFrame.new(0, 0, 0), trim)
	Build.cyl(m, "GripRing", 0.1, 0.38, CFrame.new(0, HAND_GRIP_LEN, 0), trim)
	Build.cyl(m, "Shaft", HAND_HB - HAND_GRIP_LEN, 0.22, CFrame.new(0, (HAND_HB + HAND_GRIP_LEN) / 2, 0), hc)
	local ac, am = accent(look)
	Build.cyl(m, "Collar", 0.16, 0.28, CFrame.new(0, HAND_HB - 0.06, 0), ac, am)
	addHead(m, look, HAND_HB, HAND_HEAD_SCALE)
	local palm = CFrame.new(0, HAND_PALM_Y, 0) * HOLD_ROTATION:Inverse()
	return finish(m, handle, palm, false, nil, V(0, HAND_HB + 0.75 * HAND_HEAD_SCALE, 0.1))
end

local function buildFull(id: string, look: Types.ShovelLook): Model
	local m = Build.model(id)
	local hc = look.HandleColor
	local trim = Build.darken(hc, 0.25)
	local ac, am = accent(look)

	local handle = Build.cyl(m, "Handle", FULL_HANDLE_LEN, 0.3, CFrame.new(0, FULL_HANDLE_LEN / 2, 0), hc)
	Build.cyl(
		m,
		"Shaft",
		FULL_SHAFT_TOP - FULL_HANDLE_LEN,
		0.27,
		CFrame.new(0, (FULL_SHAFT_TOP + FULL_HANDLE_LEN) / 2, 0),
		hc
	)
	-- Foam sleeve where the left hand grips.
	Build.cyl(m, "LeftGrip", 0.55, 0.36, CFrame.new(0, FULL_LEFT_Y, 0), trim)
	Build.cyl(m, "Collar", 0.3, 0.4, CFrame.new(0, FULL_SHAFT_TOP + 0.12, 0), ac, am)

	-- Top grip: crossbar along X (the right fist wraps it).
	local palmY = T_GRIP_Y
	if D_GRIP_SHAPES[look.HeadShape] then
		palmY = D_GRIP_Y
		for side = -1, 1, 2 do
			Build.beam(
				m,
				"GripCheek",
				V(side * 0.36, palmY, 0),
				V(side * 0.08, 0.08, 0),
				0.14,
				0.16,
				hc,
				nil,
				Vector3.zAxis
			)
		end
		Build.cyl(m, "GripCap", 0.12, 0.34, CFrame.new(0, 0.02, 0), trim)
	else
		for side = -1, 1, 2 do
			Build.ellipsoid(m, "GripKnob", V(0.26, 0.26, 0.26), CFrame.new(side * 0.47, palmY, 0), trim)
		end
	end
	Build.cylBetween(m, "GripBar", V(-0.45, palmY, 0), V(0.45, palmY, 0), 0.22, trim)

	addHead(m, look, FULL_HB, 1)
	local palm = CFrame.fromMatrix(V(0, palmY, 0), Vector3.zAxis, -Vector3.xAxis, -Vector3.yAxis)
	return finish(m, handle, palm, true, V(0, FULL_LEFT_Y, 0), V(0, FULL_HB + 0.75, 0.12))
end

local function build(id: string, look: Types.ShovelLook): Model
	if look.Size == "Hand" then
		return buildHand(id, look)
	end
	return buildFull(id, look)
end

function Shovels.Build(shovelId: string): Model
	local def = Config.GetShovel(shovelId)
	return build(shovelId, if def then def.Look else FALLBACK)
end

function Shovels.FromLook(name: string, look: Types.ShovelLook): Model
	return build(name, look)
end

return Shovels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Treasures</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Treasures — ~1.5 stud trinkets for reveal pop-ups and ViewportFrames.
	PrimaryPart = invisible "Root" at the visual centre (pivot), front -Z, each shape given a
	slight three-quarter tilt so it reads well from a camera placed in front (at -Z) looking at +Z.
	One builder per Types.TreasureShape plus a few id-specific specials (flip-flop, sunglasses,
	map, spyglass, ...). Glow -> Neon accents + PointLight; Legendary/Mythic -> sparkles.
]]

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Treasures = {}

local V = Vector3.new
local CF = CFrame.new
local X = Vector3.xAxis
local Y = Vector3.yAxis
local Z = Vector3.zAxis
local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(35, 30, 45)
local GOLD = Color3.fromRGB(255, 205, 40)
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local FACE_Z = CFrame.Angles(math.pi / 2, 0, 0) -- cylinder axis Y -> Z (disc facing the camera)

type Ctx = {
	m: Model,
	id: string,
	c: Color3,
	mat: Enum.Material,
	ac: Color3, -- accent colour
	am: Enum.Material, -- accent material
	glow: boolean,
}

-- Returns the main part and an optional display tilt.
type ShapeBuilder = (x: Ctx) -> (BasePart, CFrame?)

local shapes: { [string]: ShapeBuilder } = {}
local specials: { [string]: ShapeBuilder } = {}

shapes.Coin = function(x)
	local main = Build.cyl(x.m, "Coin", 0.22, 1.4, FACE_Z, x.c, x.mat)
	Build.cyl(x.m, "Inner", 0.28, 1.0, FACE_Z, Build.lighten(x.c, 0.18), x.mat)
	Build.tri(x.m, "Emblem", CF(0, 0.02, -0.15), 0.5, 0.5, 0.06, x.ac, x.am)
	Build.tri(x.m, "Emblem", CF(0, -0.06, -0.15) * CFrame.Angles(0, 0, math.pi), 0.5, 0.5, 0.06, x.ac, x.am)
	return main, CFrame.Angles(0, 0.4, 0)
end

shapes.Cap = function(x)
	local main = Build.cyl(x.m, "Cap", 0.3, 1.2, FACE_Z, x.c, x.mat)
	Build.cyl(x.m, "Top", 0.32, 0.85, FACE_Z, Build.lighten(x.c, 0.2), x.mat)
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		local dir = V(math.cos(a), math.sin(a), 0)
		Build.part(
			x.m,
			"Crimp",
			V(0.2, 0.22, 0.3),
			CF(dir * 0.62) * CFrame.Angles(0, 0, a),
			Build.darken(x.c, 0.1),
			x.mat
		)
	end
	return main, CFrame.Angles(0.35, 0.35, 0)
end

shapes.Shell = function(x)
	local hinge = V(0, -0.6, 0)
	local main = Build.ellipsoid(x.m, "Back", V(1.5, 1.15, 0.24), CF(0, 0.02, 0.08), Build.darken(x.c, 0.1), x.mat)
	for _, a in { -0.9, -0.45, 0, 0.45, 0.9 } do
		local dir = V(-math.sin(a), math.cos(a), 0)
		Build.ellipsoid(
			x.m,
			"Rib",
			V(0.38, 1.25, 0.3),
			CF(hinge + dir * 0.6) * CFrame.Angles(0, 0, a),
			Build.lighten(x.c, 0.12),
			x.mat
		)
	end
	Build.part(x.m, "Hinge", V(0.6, 0.25, 0.22), CF(0, -0.62, 0), x.c, x.mat)
	if x.glow then
		Build.ball(x.m, "Pearl", 0.35, CF(0, -0.35, -0.2), WHITE, NEON)
	end
	return main, CFrame.Angles(-0.25, 0.35, 0)
end

shapes.Bottle = function(x)
	local main = Build.cyl(x.m, "Bottle", 0.9, 0.7, CF(0, -0.25, 0), x.c, x.mat)
	Build.ball(x.m, "Shoulder", 0.7, CF(0, 0.2, 0), x.c, x.mat)
	Build.cyl(x.m, "Neck", 0.45, 0.3, CF(0, 0.55, 0), x.c, x.mat)
	Build.cyl(x.m, "Cork", 0.22, 0.32, CF(0, 0.85, 0), Color3.fromRGB(170, 120, 70), Enum.Material.Wood)
	Build.cyl(x.m, "Scroll", 0.7, 0.3, CF(0, -0.2, 0), Color3.fromRGB(245, 225, 175))
	return main, CFrame.Angles(0, 0, -0.35)
end

shapes.Chest = function(x)
	local main = Build.part(x.m, "Base", V(1.4, 0.75, 0.9), CF(0, -0.25, 0), x.c, x.mat)
	Build.cylBetween(x.m, "Lid", V(-0.7, 0.12, 0), V(0.7, 0.12, 0), 0.9, Build.lighten(x.c, 0.08), x.mat)
	for _, px in { -0.42, 0.42 } do
		Build.part(x.m, "Band", V(0.14, 0.78, 0.94), CF(px, -0.25, 0), GOLD, Enum.Material.Metal)
		Build.cylBetween(x.m, "Band", V(px - 0.07, 0.12, 0), V(px + 0.07, 0.12, 0), 0.94, GOLD, Enum.Material.Metal)
	end
	Build.part(x.m, "Lock", V(0.25, 0.3, 0.1), CF(0, 0.02, -0.47), GOLD, Enum.Material.Metal)
	Build.ball(x.m, "Gem", 0.2, CF(0.25, 0.5, -0.2), Color3.fromRGB(255, 60, 90), NEON)
	return main, CFrame.Angles(0.25, 0.5, 0)
end

shapes.Gem = function(x)
	local main = Build.cyl(x.m, "Girdle", 0.22, 1.1, CF(0, 0.1, 0), x.c, x.mat)
	Build.cyl(x.m, "Crown", 0.3, 0.78, CF(0, 0.35, 0), Build.lighten(x.c, 0.25), x.mat)
	local pav = Build.darken(x.c, 0.08)
	local pcf = CFrame.new(0, -0.37, 0) * CFrame.Angles(math.pi, 0, 0)
	for k = 0, 3 do
		Build.tri(x.m, "Pavilion", pcf * CFrame.Angles(0, k * math.pi / 4, 0), 1.05, 0.78, 0.14, pav, x.mat)
	end
	if x.glow then
		Build.ball(x.m, "Glint", 0.3, CF(0, 0.05, 0), Build.lighten(x.c, 0.5), NEON)
	end
	return main, CFrame.Angles(0.3, math.pi / 4, 0)
end

shapes.Bone = function(x)
	local main = Build.cylBetween(x.m, "Shaft", V(-0.55, 0, 0), V(0.55, 0, 0), 0.3, x.c, x.mat)
	for sx = -1, 1, 2 do
		for sy = -1, 1, 2 do
			Build.ball(x.m, "Knob", 0.42, CF(sx * 0.62, sy * 0.14, 0), x.c, x.mat)
		end
	end
	return main, CFrame.Angles(0.2, 0.3, 0.5)
end

shapes.Skull = function(x)
	local main = Build.ball(x.m, "Cranium", 1.2, CF(0, 0.15, 0), x.c, x.mat)
	Build.part(x.m, "Jaw", V(0.75, 0.38, 0.65), CF(0, -0.38, -0.12), x.c, x.mat)
	local eye = if x.glow then Build.lighten(x.c, 0.4) else DARK
	local em = if x.glow then NEON else SMOOTH
	for side = -1, 1, 2 do
		Build.ball(x.m, "Socket", 0.34, CF(side * 0.24, 0.08, -0.47), eye, em)
	end
	Build.tri(x.m, "Nose", CF(0, -0.12, -0.53), 0.18, 0.18, 0.06, DARK)
	for i = -1, 1 do
		Build.part(x.m, "Tooth", V(0.14, 0.16, 0.08), CF(i * 0.18, -0.32, -0.45), Build.lighten(x.c, 0.3))
	end
	return main, CFrame.Angles(0.1, 0.35, 0)
end

shapes.Orb = function(x)
	local main = Build.ball(x.m, "Orb", 1.2, CF(), x.c, x.mat)
	if x.glow and x.mat ~= NEON then
		Build.ball(x.m, "Core", 0.55, CF(), Build.lighten(x.c, 0.5), NEON)
	end
	Build.ellipsoid(
		x.m,
		"Shine",
		V(0.3, 0.2, 0.08),
		Build.surface(Vector3.zero, V(1.2, 1.2, 1.2), V(-0.5, 0.55, -0.7)),
		WHITE
	)
	return main, nil
end

shapes.Crown = function(x)
	local main = Build.cyl(x.m, "Band", 0.45, 1.3, CF(0, -0.25, 0), x.c, x.mat)
	Build.cyl(x.m, "Inside", 0.04, 1.16, CF(0, -0.02, 0), Build.darken(x.c, 0.45))
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		local dir = V(math.sin(a), 0, -math.cos(a))
		local tangent = V(-dir.Z, 0, dir.X)
		Build.triPts(
			x.m,
			"Point",
			dir * 0.6 + V(0, -0.05, 0),
			dir * 0.62 + V(0, 0.5, 0),
			tangent,
			0.55,
			0.1,
			x.c,
			x.mat
		)
		local gem = if k % 2 == 0 then Color3.fromRGB(255, 60, 90) else Color3.fromRGB(60, 140, 255)
		Build.ball(x.m, "Jewel", 0.2, CF(dir * 0.66 + V(0, -0.25, 0)), gem, if x.glow then NEON else SMOOTH)
	end
	return main, CFrame.Angles(0.35, 0.2, 0)
end

shapes.Tablet = function(x)
	local main = Build.part(x.m, "Slab", V(1.0, 1.1, 0.2), CF(0, -0.15, 0), x.c, x.mat)
	Build.cyl(x.m, "Arch", 0.2, 1.0, CF(0, 0.4, 0) * FACE_Z, x.c, x.mat)
	for i, y in { 0.35, 0.1, -0.15, -0.4 } do
		local w = if i % 2 == 0 then 0.5 else 0.66
		Build.part(x.m, "Glyph", V(w, 0.08, 0.05), CF(0, y, -0.11), x.ac, x.am)
	end
	return main, CFrame.Angles(0, 0.35, 0)
end

shapes.Egg = function(x)
	local main = Build.ellipsoid(x.m, "Egg", V(0.95, 1.0, 0.95), CF(0, -0.15, 0), x.c, x.mat)
	Build.ellipsoid(x.m, "EggTop", V(0.8, 1.0, 0.8), CF(0, 0.1, 0), x.c, x.mat)
	for _, d in { V(0.2, 0.2, -1), V(-0.8, -0.2, -0.6), V(0.8, -0.4, -0.3) } do
		Build.ellipsoid(
			x.m,
			"Spot",
			V(0.25, 0.25, 0.08),
			Build.surface(V(0, -0.15, 0), V(0.95, 1.0, 0.95), d),
			x.ac,
			x.am
		)
	end
	return main, CFrame.Angles(0, 0, -0.2)
end

shapes.Anchor = function(x)
	local main = Build.part(x.m, "Shank", V(0.2, 1.2, 0.2), CF(0, 0.05, 0), x.c, x.mat)
	Build.cyl(x.m, "Ring", 0.14, 0.44, CF(0, 0.75, 0) * FACE_Z, x.c, x.mat)
	Build.cyl(x.m, "Hole", 0.16, 0.2, CF(0, 0.75, 0) * FACE_Z, DARK)
	Build.part(x.m, "Stock", V(0.8, 0.15, 0.16), CF(0, 0.45, 0), Build.darken(x.c, 0.1), x.mat)
	for side = -1, 1, 2 do
		Build.beam(x.m, "Arm", V(0, -0.55, 0), V(side * 0.5, -0.25, 0), 0.18, 0.18, x.c, x.mat, Z)
		Build.triPts(x.m, "Fluke", V(side * 0.48, -0.32, 0), V(side * 0.62, 0.05, 0), X, 0.3, 0.14, x.c, x.mat)
	end
	Build.ball(x.m, "Crown", 0.26, CF(0, -0.55, 0), x.c, x.mat)
	return main, CFrame.Angles(0, 0.4, 0.15)
end

shapes.Wheel = function(x)
	local R = 0.6
	local seg = 2 * R * math.tan(math.pi / 8) + 0.04
	for k = 0, 7 do
		local a = (k + 0.5) / 8 * math.pi * 2
		Build.part(
			x.m,
			"Rim",
			V(seg, 0.14, 0.16),
			CFrame.Angles(0, 0, a) * CF(0, R * math.cos(math.pi / 8), 0),
			x.c,
			x.mat
		)
	end
	for k = 0, 3 do
		local a = k / 8 * math.pi * 2
		local dir = V(math.cos(a), math.sin(a), 0)
		Build.beam(x.m, "Spoke", -dir * 0.72, dir * 0.72, 0.1, 0.1, Build.darken(x.c, 0.1), x.mat, Z)
	end
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		Build.ball(x.m, "Knob", 0.17, CF(math.cos(a) * 0.78, math.sin(a) * 0.78, 0), x.ac, x.am)
	end
	local hub = Build.cyl(x.m, "Hub", 0.22, 0.32, FACE_Z, x.ac, x.am)
	return hub, CFrame.Angles(0, 0.35, 0)
end

shapes.Shard = function(x)
	local main = Build.ellipsoid(
		x.m,
		"Base",
		V(0.9, 0.3, 0.7),
		CF(0, -0.58, 0),
		Color3.fromRGB(110, 100, 115),
		Enum.Material.Slate
	)
	Build.spike(x.m, "Crystal", V(0, -0.6, 0), V(0, 0.72, 0), 0.55, x.c, x.mat)
	Build.spike(x.m, "Crystal", V(-0.1, -0.55, 0), V(-0.55, 0.25, 0), 0.38, Build.lighten(x.c, 0.15), x.mat)
	Build.spike(x.m, "Crystal", V(0.1, -0.55, 0.05), V(0.5, 0.1, -0.1), 0.34, Build.darken(x.c, 0.1), x.mat)
	return main, CFrame.Angles(0, 0.3, 0)
end

shapes.Box = function(x)
	local main = Build.part(x.m, "Box", V(1.1, 1.1, 1.1), CF(), x.c, x.mat)
	Build.part(x.m, "Ribbon", V(1.12, 1.12, 0.22), CF(), x.ac, x.am)
	Build.part(x.m, "Ribbon", V(0.22, 1.12, 1.12), CF(), x.ac, x.am)
	for side = -1, 1, 2 do
		Build.ellipsoid(
			x.m,
			"Bow",
			V(0.4, 0.25, 0.25),
			CF(side * 0.18, 0.66, 0) * CFrame.Angles(0, 0, side * 0.5),
			x.ac,
			x.am
		)
	end
	return main, CFrame.Angles(0.3, 0.6, 0)
end

-- Specials keyed by treasure id ---------------------------------------------------------------

specials.lost_flip_flop = function(x)
	local main = Build.ellipsoid(x.m, "Sole", V(0.65, 1.5, 0.14), CF(), x.c, x.mat)
	local strap = Build.lighten(x.c, 0.5)
	Build.ball(x.m, "ToePost", 0.14, CF(0, 0.4, -0.08), strap)
	for side = -1, 1, 2 do
		Build.beam(x.m, "Strap", V(0, 0.4, -0.1), V(side * 0.28, -0.12, -0.08), 0.1, 0.08, strap, SMOOTH, Z)
	end
	return main, CFrame.Angles(-0.3, 0.3, 0.25)
end

specials.cool_sunglasses = function(x)
	local frame = Build.part(x.m, "Bridge", V(0.3, 0.1, 0.1), CF(0, 0.1, 0), x.c, x.mat)
	for side = -1, 1, 2 do
		Build.cyl(
			x.m,
			"Lens",
			0.1,
			0.6,
			CF(side * 0.38, 0, 0) * FACE_Z,
			Color3.fromRGB(40, 50, 90),
			Enum.Material.Glass
		)
		Build.cyl(x.m, "Frame", 0.08, 0.68, CF(side * 0.38, 0, 0.05) * FACE_Z, x.c, x.mat)
		Build.part(x.m, "Arm", V(0.06, 0.08, 0.9), CF(side * 0.7, 0.1, 0.45), x.c, x.mat)
		Build.ellipsoid(x.m, "Shine", V(0.18, 0.1, 0.04), CF(side * 0.38 - 0.1, 0.12, -0.06), WHITE)
	end
	return frame, CFrame.Angles(0.15, 0.45, 0)
end

specials.frozen_fish = function(x)
	local ice = Build.part(x.m, "Ice", V(1.3, 0.95, 0.7), CF(), x.c, Enum.Material.Ice)
	ice.Transparency = 0.45
	local fish = Color3.fromRGB(255, 140, 60)
	Build.ellipsoid(x.m, "Fish", V(0.85, 0.45, 0.25), CF(-0.08, 0, 0), fish)
	Build.triPts(x.m, "Tail", V(0.55, 0, 0), V(0.25, 0, 0), Y, 0.4, 0.06, fish)
	Build.ball(x.m, "Eye", 0.1, CF(-0.36, 0.06, -0.12), DARK)
	return ice, CFrame.Angles(0.2, 0.4, 0)
end

specials.treasure_map = function(x)
	local main = Build.part(x.m, "Paper", V(1.25, 1.0, 0.05), CF(), x.c, x.mat)
	for _, y in { 0.5, -0.5 } do
		Build.cylBetween(x.m, "Roll", V(-0.66, y, 0), V(0.66, y, 0), 0.18, Build.darken(x.c, 0.1), x.mat)
	end
	local red = Color3.fromRGB(220, 40, 40)
	Build.part(x.m, "X", V(0.4, 0.08, 0.04), CF(0.3, -0.15, -0.04) * CFrame.Angles(0, 0, 0.785), red)
	Build.part(x.m, "X", V(0.4, 0.08, 0.04), CF(0.3, -0.15, -0.04) * CFrame.Angles(0, 0, -0.785), red)
	for i = 0, 2 do
		Build.part(x.m, "Path", V(0.12, 0.05, 0.04), CF(-0.4 + i * 0.2, 0.15 - i * 0.1, -0.04), Build.darken(x.c, 0.5))
	end
	return main, CFrame.Angles(0.2, 0.3, 0.05)
end

specials.captains_spyglass = function(x)
	local main = Build.cylBetween(x.m, "Tube", V(-0.75, 0, 0), V(-0.1, 0, 0), 0.42, x.c, x.mat)
	Build.cylBetween(x.m, "Tube", V(-0.15, 0, 0), V(0.35, 0, 0), 0.34, Build.darken(x.c, 0.15), x.mat)
	Build.cylBetween(x.m, "Tube", V(0.3, 0, 0), V(0.75, 0, 0), 0.26, x.c, x.mat)
	Build.cylBetween(x.m, "Ring", V(-0.12, 0, 0), V(-0.04, 0, 0), 0.46, Color3.fromRGB(90, 55, 30), Enum.Material.Wood)
	Build.cylBetween(
		x.m,
		"Lens",
		V(-0.77, 0, 0),
		V(-0.74, 0, 0),
		0.36,
		Color3.fromRGB(150, 220, 255),
		Enum.Material.Glass
	)
	return main, CFrame.Angles(0.2, 0.5, 0.35)
end

specials.pocket_watch = function(x)
	local main = Build.cyl(x.m, "Case", 0.24, 1.2, FACE_Z, x.c, x.mat)
	Build.cyl(x.m, "Dial", 0.26, 0.95, FACE_Z, Color3.fromRGB(255, 250, 235))
	Build.part(x.m, "Hand", V(0.06, 0.38, 0.04), CF(0, 0.17, -0.14), DARK)
	Build.part(x.m, "Hand", V(0.06, 0.28, 0.04), CF(0.11, 0.05, -0.14) * CFrame.Angles(0, 0, -1.2), DARK)
	Build.cyl(x.m, "Crown", 0.16, 0.2, CF(0, 0.66, 0), x.c, x.mat)
	Build.cyl(x.m, "Bow", 0.06, 0.32, CF(0, 0.82, 0) * FACE_Z, x.c, x.mat)
	return main, CFrame.Angles(0, 0.35, 0)
end

specials.sun_mask = function(x)
	local main = Build.cyl(x.m, "Mask", 0.24, 1.05, FACE_Z, x.c, x.mat)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local dir = V(math.cos(a), math.sin(a), 0)
		Build.triPts(x.m, "Ray", dir * 0.48, dir * 0.85, V(-dir.Y, dir.X, 0), 0.32, 0.12, Build.lighten(x.c, 0.2), x.am)
	end
	Build.face(x.m, CF(0, 0.02, -0.12), 1.0, { cheeks = true })
	return main, CFrame.Angles(0, 0.3, 0)
end

specials.beach_ball_of_creation = function(x)
	local main = Build.ball(x.m, "Ball", 1.3, CF(), WHITE)
	local stripes = { Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 215, 50), Color3.fromRGB(60, 150, 255) }
	for i, col in stripes do
		Build.ellipsoid(x.m, "Stripe", V(1.4, 1.4, 0.9), CFrame.Angles(0, (i - 1) * math.pi / 3, 0), col, NEON)
	end
	Build.ball(x.m, "Cap", 0.3, CF(0, 0.62, 0), WHITE, NEON)
	return main, CFrame.Angles(0.3, 0.2, 0)
end

specials.trex_tooth = function(x)
	local main = Build.ellipsoid(x.m, "Tooth", V(0.62, 0.95, 0.5), CF(0, -0.2, 0), x.c, x.mat)
	Build.ellipsoid(x.m, "Tooth", V(0.42, 0.85, 0.36), CF(0.07, 0.3, 0) * CFrame.Angles(0, 0, -0.18), x.c, x.mat)
	Build.ellipsoid(x.m, "Tip", V(0.22, 0.4, 0.2), CF(0.16, 0.66, 0) * CFrame.Angles(0, 0, -0.3), x.c, x.mat)
	Build.ellipsoid(x.m, "Root", V(0.5, 0.3, 0.42), CF(0, -0.62, 0), Build.darken(x.c, 0.2), x.mat)
	return main, CFrame.Angles(0, 0.4, -0.1)
end

specials.mammoth_tusk = function(x)
	local pts = {}
	for i = 0, 4 do
		local a = math.rad(200 - i * 30)
		table.insert(pts, V(math.cos(a) * 0.7 + 0.1, math.sin(a) * 0.7 + 0.25, 0))
	end
	local main: BasePart = Build.cylBetween(x.m, "Tusk", pts[1], pts[2], 0.42, Build.darken(x.c, 0.1), x.mat)
	for i = 2, #pts - 1 do
		Build.ball(x.m, "Joint", 0.42 - (i - 1) * 0.07, CF(pts[i]), x.c, x.mat)
		Build.cylBetween(x.m, "Tusk", pts[i], pts[i + 1], 0.42 - (i - 1) * 0.07, x.c, x.mat)
	end
	Build.ball(x.m, "Tip", 0.16, CF(pts[#pts]), x.c, x.mat)
	return main, CFrame.Angles(0, 0.3, 0)
end

-- Relics have unique silhouettes; they must never read as the common coin/orb fallback.
specials.sun_compass = function(x)
	local brass = Color3.fromRGB(204, 149, 63)
	local main = Build.cyl(x.m, "CompassCase", 0.24, 1.45, FACE_Z, brass, Enum.Material.Metal)
	Build.cyl(x.m, "Dial", 0.035, 1.18, CF(0, 0, -0.145) * FACE_Z, Color3.fromRGB(28, 47, 66))
	for k = 0, 7 do
		local a = k * math.pi / 4
		local p = V(math.sin(a) * 0.48, math.cos(a) * 0.48, -0.18)
		Build.part(x.m, "DialMark", V(0.045, 0.13, 0.035), CF(p) * CFrame.Angles(0, 0, -a), brass, Enum.Material.Metal)
	end
	Build.tri(x.m, "DownNeedle", CF(0, -0.17, -0.22) * CFrame.Angles(0, 0, math.pi), 0.28, 0.62, 0.07, x.c, NEON)
	Build.tri(x.m, "Counterweight", CF(0, 0.17, -0.21), 0.2, 0.35, 0.06, Color3.fromRGB(222, 90, 72))
	Build.ball(x.m, "Axle", 0.16, CF(0, 0, -0.25), brass, Enum.Material.Metal)
	Build.cyl(x.m, "Crown", 0.2, 0.26, CF(0, 0.8, 0), brass, Enum.Material.Metal)
	for side = -1, 1, 2 do
		Build.cylBetween(
			x.m,
			"ChainLoop",
			V(side * 0.15, 0.82, 0),
			V(side * 0.12, 1.03, 0),
			0.07,
			brass,
			Enum.Material.Metal
		)
	end
	Build.cylBetween(x.m, "ChainLoop", V(-0.12, 1.03, 0), V(0.12, 1.03, 0), 0.07, brass, Enum.Material.Metal)
	return main, CFrame.Angles(0, 0.15, -0.12)
end

specials.tide_heart = function(x)
	local pearl = Color3.fromRGB(226, 242, 226)
	local teal = Color3.fromRGB(43, 121, 128)
	local main = Build.ellipsoid(x.m, "ShellHeart", V(1.35, 1.1, 0.8), CF(), pearl)
	-- Raised spiral follows a stylized shell face, with enough contrast to read at icon size.
	local last: Vector3? = nil
	for k = 0, 13 do
		local t = k / 13
		local a = t * math.pi * 3.3
		local r = 0.08 + t * 0.5
		local p = V(math.cos(a) * r, math.sin(a) * r * 0.8, -0.4 - 0.035 * (1 - t))
		if last then
			Build.cylBetween(x.m, "ShellSpiral", last, p, 0.07, teal)
		end
		last = p
	end
	Build.ellipsoid(x.m, "TidePearl", V(0.42, 0.5, 0.25), CF(0, 0, -0.46), x.c, NEON)
	Build.tri(x.m, "ShellLip", CF(0, -0.58, -0.1) * CFrame.Angles(0, 0, math.pi), 0.65, 0.5, 0.28, pearl)
	return main, CFrame.Angles(0, 0.25, 0.15)
end

local RAINBOW_GLOW = Color3.fromRGB(255, 230, 160)

local FALLBACK: Types.TreasureLook = {
	Color = Color3.fromRGB(255, 205, 60),
	Shape = "Coin",
	Material = Enum.Material.Metal,
	Glow = false,
}

local function build(id: string, look: Types.TreasureLook, rarity: Types.Rarity): Model
	local m = Build.model(id)
	local root = Build.root(m, CFrame.identity, V(0.2, 0.2, 0.2))
	local ctx: Ctx = {
		m = m,
		id = id,
		c = look.Color,
		mat = look.Material,
		ac = if look.Glow then Build.lighten(look.Color, 0.45) else Build.darken(look.Color, 0.3),
		am = if look.Glow then NEON else look.Material,
		glow = look.Glow,
	}
	local builder = specials[id] or shapes[look.Shape] or shapes.Coin
	local main, tilt = builder(ctx)
	if tilt then
		Build.transform(m, tilt, root)
	end
	if look.Glow then
		Build.glow(main, if id == "beach_ball_of_creation" then RAINBOW_GLOW else look.Color, 1.3, 7)
	end
	if rarity == "Legendary" or rarity == "Mythic" or rarity == "Relic" then
		Build.sparkle(main, Build.lighten(look.Color, 0.3), if rarity == "Mythic" then 10 else 5)
	end
	Build.weldAll(m, root)
	return m
end

function Treasures.Build(treasureId: string): Model
	local def = Config.GetTreasure(treasureId)
	if def then
		return build(treasureId, def.Look, def.Rarity)
	end
	return build(treasureId, FALLBACK, "Common")
end

-- v3 discovery: size + material variants of a built treasure (Config.Discovery). Scales about
-- the pivot and re-skins every visible part: Golden = gold metal, Fossilized = stone,
-- Crystal = tinted glass with a soft glow. Returns the same model.
local VARIANT_SKINS: { [string]: { Color: Color3, Material: Enum.Material, Transparency: number } } = {
	Golden = { Color = Color3.fromRGB(255, 200, 45), Material = Enum.Material.Metal, Transparency = 0 },
	Fossilized = { Color = Color3.fromRGB(150, 128, 104), Material = Enum.Material.Slate, Transparency = 0 },
	Crystal = { Color = Color3.fromRGB(130, 225, 255), Material = Enum.Material.Glass, Transparency = 0.25 },
}

function Treasures.ApplyVariant(model: Model, size: string?, material: string?): Model
	local sizeDef = nil
	for _, v in Config.Discovery.SIZES do
		if v.Id == size then
			sizeDef = v
		end
	end
	local scale = if sizeDef and sizeDef.Scale then sizeDef.Scale else 1
	Build.scale(model, model:GetPivot(), scale)
	local skin = if material then VARIANT_SKINS[material] else nil
	if skin then
		local root = model.PrimaryPart
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and d ~= root and d.Transparency < 1 then
				local keepNeon = d.Material == NEON
				d.Color = if keepNeon
					then Build.neonSafe(Build.lighten(skin.Color, 0.2))
					else skin.Color:Lerp(d.Color, 0.15)
				if not keepNeon then
					d.Material = skin.Material
					d.Transparency = math.max(d.Transparency, skin.Transparency)
				end
			end
		end
		if material == "Crystal" or material == "Golden" then
			local main = root or model:FindFirstChildWhichIsA("BasePart")
			if main then
				Build.sparkle(main, skin.Color, 4)
			end
		end
	end
	model:SetAttribute("Size", size or "Normal")
	model:SetAttribute("Material", material or "None")
	return model
end

function Treasures.FromLook(name: string, look: Types.TreasureLook, rarity: Types.Rarity?): Model
	return build(name, look, rarity or "Common")
end

return Treasures
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Single source of truth for network endpoints. The server creates them on first access;
-- clients wait for them. Names must match docs/ARCHITECTURE.md.
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.Events = table.freeze({
	-- client -> server
	"Dig",
	"ReturnToSurface",
	"BuyShovel",
	"EquipShovel",
	"BuyBackpack",
	"EquipBackpack",
	"HatchEgg",
	"EquipPet",
	"UnequipPet",
	"DeletePet",
	"Rebirth",
	"ClaimDailyReward",
	"ClaimQuest",
	"RedeemCode",
	"SetSetting",
	"PromptPurchase",
	-- v2 survival
	"BuyShade",
	"PlaceShade", -- (shadeId: string, position: Vector3, yaw: number)
	"PickUpShade",
	"BuyConsumable", -- (id: string, count: number)
	"UseConsumable", -- (id: string)
	"DrinkFountain",
	-- v2.1 ride-on excavator (RideService)
	"ToggleRide", -- () spawn + sit in your rideable pet, or get out
	"RideDig", -- () scoop in front of your vehicle (server picks the point)
	-- v2.2 duplicate fusion: (uid: string) fuse Config.GOLDEN_FUSE_COUNT copies into a Golden pet
	"FusePets",
	-- v2.2 analytics: (name: string, a: any?, b: any?) whitelisted UI events (Analytics.OnTrack)
	"Track",
	-- v2.2 rebirth perks: (perkId: string) buy the next level with Rebirth Tokens (RebirthService)
	"BuyRebirthPerk",
	-- v3 discovery (DiscoveryService): () start a detector scan; (id: string, errors: {number})
	-- answer an excavation with per-ring timing errors in seconds (-1 = no tap)
	"Scan",
	"Excavate",
	-- server -> client
	"DataChanged",
	"Notify",
	"DigResult",
	"TreasureFound",
	"EggHatched", -- (petIds: {string}, info: { EggId, Chances: {number}, Pity: {boolean} }?) v2.2 info
	"EventChanged",
	-- v2.2 offline earnings (OfflineService): (info: { Seconds, Sand, Coins, CapSeconds, Capped, PetId })
	"OfflineEarnings",
	-- v2.1 companions: a digging pet dug. server -> all clients:
	-- (player: Player, slot: number, petId: string, position: Vector3, sandGained: number)
	-- slot = 1-based index into the owner's "EquippedPets" attribute list.
	"PetDug",
	"Scoop", -- server -> other clients: (player: Player) a successful shovel dig (scoop animation)
	"RideDug", -- server -> all clients: (player: Player, position: Vector3, success: boolean, layerIndex: number)
	-- v3 discovery, server -> owner: Types.DetectorPing / Types.ExcavationInfo / Types.FindInfo
	"DetectorPing",
	"ExcavationStart",
	"FindRevealed",
})

Remotes.Functions = table.freeze({
	"GetData",
	"GetOwnedPasses",
})

local FOLDER_NAME = "Net"
local isServer = RunService:IsServer()

local function getFolder(): Folder
	local existing = script:FindFirstChild(FOLDER_NAME)
	if existing then
		return existing :: Folder
	end
	if isServer then
		local folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = script
		return folder
	end
	return script:WaitForChild(FOLDER_NAME) :: Folder
end

local function getOrCreate(name: string, className: string): Instance
	local folder = getFolder()
	local existing = folder:FindFirstChild(name)
	if existing then
		return existing
	end
	if isServer then
		local remote = Instance.new(className)
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	return folder:WaitForChild(name)
end

function Remotes.Get(name: string): RemoteEvent
	assert(table.find(Remotes.Events, name), "Unknown RemoteEvent: " .. name)
	return getOrCreate(name, "RemoteEvent") :: RemoteEvent
end

function Remotes.GetFunction(name: string): RemoteFunction
	assert(table.find(Remotes.Functions, name), "Unknown RemoteFunction: " .. name)
	return getOrCreate(name, "RemoteFunction") :: RemoteFunction
end

-- Server calls this once at boot so every remote exists before clients look for them.
function Remotes.CreateAll()
	assert(isServer, "Remotes.CreateAll is server-only")
	for _, name in Remotes.Events do
		Remotes.Get(name)
	end
	for _, name in Remotes.Functions do
		Remotes.GetFunction(name)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Types — shared exported Luau types for Dig the Beach.
	Owner: Game design. Other areas code against these; do not change field names without
	updating docs/ARCHITECTURE.md.

	Units:
	- Depth is always in STUDS BELOW THE SURFACE (positive number, 0 = beach surface).
	- Prices / values are in Coins unless stated otherwise. Robux prices are suggestions only.
	- Multipliers are plain factors (1 = no bonus). Pet multipliers combine ADDITIVELY:
	  total = 1 + sum(pet.Multiplier - 1) (see Config.PetMultiplier).
]]

-- Rarity ---------------------------------------------------------------------------------

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic" | "Relic" -- v3: Relic (finds only)

export type RarityDef = {
	Name: Rarity,
	Order: number, -- 1 = Common ... 6 = Mythic, 7 = Relic (v3 discovery slice, finds only)
	Color: Color3, -- main text / frame colour
	Gradient: { Color3 }, -- 2+ colours for UIGradient on cards
	Announce: boolean, -- server-wide chat/toast when someone finds/hatches this rarity
}

-- Rewards (quests, daily, codes, products) -------------------------------------------------

export type Reward = {
	Coins: number?, -- flat coins
	-- "seconds of income": multiplied by the RewardScale of the layer at the player's MaxDepth,
	-- so rewards stay meaningful all game. Resolve with Config.ResolveCoins(reward, maxDepth).
	ScaledCoins: number?,
	RebirthTokens: number?,
	Boost: string?, -- BoostDef.Id
	BoostSeconds: number?,
	Pet: string?, -- PetDef.Id granted directly
	Egg: string?, -- EggDef.Id hatched for free
	EggCount: number?, -- default 1
	Rebirth: boolean?, -- grant one rebirth without paying its coin cost (Skip Rebirth product)
	Consumables: { [string]: number }?, -- v2 survival: consumable id -> count (granted by SurvivalService)
}

-- World ------------------------------------------------------------------------------------

export type LootEntry = {
	TreasureId: string,
	Weight: number,
}

export type LayerDef = {
	Id: string,
	Name: string,
	DepthStart: number, -- studs below surface (inclusive)
	DepthEnd: number, -- studs below surface (exclusive)
	Material: Enum.Material, -- terrain material; unique per layer (colour override is global per material)
	Color: Color3, -- Terrain:SetMaterialColor(Material, Color)
	Hardness: number, -- equipped shovel Power must be >= Hardness
	SandValue: number, -- sand per dig before multipliers
	TreasureChance: number, -- 0..1 chance per successful dig to roll LootTable (before luck)
	LootTable: { LootEntry },
	RewardScale: number, -- ~coins/second a typical player earns here; scales ScaledCoins rewards
	FlavorText: string,
	AmbientColor: Color3, -- suggested Lighting tint / fog colour while the camera is in this layer
}

-- Equipment --------------------------------------------------------------------------------

export type ShovelShape = "Scoop" | "Trowel" | "Spade" | "Pick" | "Claw" | "Trident" | "Drill"

-- "Hand": small one-handed hand tool (~2 studs). "Full" (default when nil): full-size tool held
-- with both hands (client ShovelPoseController).
export type ShovelSize = "Hand" | "Full"

export type ShovelLook = {
	HeadColor: Color3,
	HandleColor: Color3,
	HeadShape: ShovelShape,
	Material: Enum.Material, -- Part material for the head
	Glow: boolean, -- add PointLight / Neon accents
	Size: ShovelSize?, -- nil = "Full"
}

export type ShovelDef = {
	Id: string,
	Name: string,
	Price: number, -- coins
	Power: number, -- compared against LayerDef.Hardness
	Cooldown: number, -- seconds between digs
	Radius: number, -- dig size: half the edge of the voxel cube a dig removes (see Shovels.luau)
	SandMultiplier: number,
	RebirthsRequired: number,
	Description: string,
	Look: ShovelLook,
}

export type BackpackShape = "Bucket" | "Bag" | "Box" | "Barrel" | "Cart" | "Vehicle" | "Orb"

export type BackpackLook = {
	Color: Color3,
	AccentColor: Color3,
	Shape: BackpackShape,
	Material: Enum.Material,
	Glow: boolean,
}

export type BackpackDef = {
	Id: string,
	Name: string,
	Price: number,
	Capacity: number, -- sand (multiplied by rebirth multiplier & Mega Backpack pass)
	RebirthsRequired: number,
	Description: string,
	Look: BackpackLook,
}

-- Pets & eggs ------------------------------------------------------------------------------

export type PetShape =
	"Crab"
	| "Bird"
	| "Star"
	| "Turtle"
	| "Fish"
	| "Squid"
	| "Blob"
	| "Mole"
	| "Dino"
	| "Dragon"
	| "Golem"
	| "Seal"
	| "Vehicle" -- v2.1: vehicle pet, drawn by Models/Diggers (PetDef.VehicleKind)

export type PetLook = {
	BodyColor: Color3,
	AccentColor: Color3,
	Shape: PetShape,
	Size: number, -- overall scale factor, ~1 (Common) .. 1.6 (Mythic)
	Glow: boolean,
}

export type PetDef = {
	Id: string,
	Name: string,
	Rarity: Rarity,
	Multiplier: number, -- sand multiplier (additive with other pets, see Config.PetMultiplier)
	Exclusive: boolean, -- not in any egg (daily reward / code / event)
	Look: PetLook,
	-- v2.1: digging companions (vehicles from Construction Crates, some creatures).
	Dig: PetDigDef?,
	Rideable: boolean?, -- v2.1: the player can ride it (see Services/RideService)
	VehicleKind: string?, -- v2.1: Models/Diggers builder kind for vehicle pets (e.g. "Excavator")
}

export type PetDigDef = {
	Power: number, -- digs layers with Hardness <= Power
	Interval: number, -- seconds between digs
	Radius: number, -- same scale as shovel Radius
	SandMultiplier: number, -- replaces the shovel factor for this pet's digs
}

export type PetInstance = {
	Id: string, -- PetDef.Id
	Equipped: boolean,
	-- v2.2: fused from Config.GOLDEN_FUSE_COUNT identical copies (PetService "FusePets"):
	-- x Config.GOLDEN_SAND_BONUS on its sand bonus, digs Config.GOLDEN_DIG_SPEED x as often.
	Golden: boolean?,
}

export type EggCurrency = "Coins" | "Tokens" | "Robux"

export type EggEntry = {
	PetId: string,
	Weight: number,
}

export type EggLook = {
	ShellColor: Color3,
	SpotColor: Color3,
	Glow: boolean,
}

export type EggDef = {
	Id: string,
	Name: string,
	Currency: EggCurrency,
	Price: number, -- coins / tokens per hatch; for Robux eggs the Robux suggestion (see ProductKey)
	ProductKey: string?, -- Robux eggs: key into Config.Monetization.Products for a single hatch
	UnlockLayer: number, -- index into Config.Layers; requires MaxDepth >= that layer's DepthStart
	Pets: { EggEntry },
	Look: EggLook,
	Kind: ("Egg" | "Crate")?, -- v2.1: Construction Crates hatch vehicle pets; default "Egg"
	-- v2.2 pity: after this many hatches in a row without a Rare-or-better pet, the next hatch is
	-- guaranteed Rare+ (Stats.GetHatchOdds). nil = no pity (every entry is already Rare+).
	PityAt: number?,
}

-- Treasure ---------------------------------------------------------------------------------

export type TreasureShape =
	"Coin"
	| "Cap"
	| "Shell"
	| "Bottle"
	| "Chest"
	| "Gem"
	| "Bone"
	| "Skull"
	| "Orb"
	| "Crown"
	| "Tablet"
	| "Egg"
	| "Anchor"
	| "Wheel"
	| "Shard"
	| "Box"

export type TreasureLook = {
	Color: Color3,
	Shape: TreasureShape,
	Material: Enum.Material,
	Glow: boolean,
}

export type TreasureDef = {
	Id: string,
	Name: string,
	Layer: number, -- index into Config.Layers where it is found
	Rarity: Rarity,
	SellValue: number, -- coins when sold
	FlavorText: string,
	Look: TreasureLook,
	-- v3 Relics: value = ScaledValue seconds of income (RewardScale of the player's deepest layer)
	-- instead of SellValue; findable in any deposit of layer >= Layer (Config.Discovery).
	ScaledValue: number?,
}

-- v3 discovery slice (docs/design/Discovery.md) ------------------------------------------------

export type FindSize = "Tiny" | "Normal" | "Large" | "Giant"
export type FindMaterial = "None" | "Golden" | "Fossilized" | "Crystal"
export type FindQuality = "Damaged" | "Good" | "Pristine"
-- Presentation tier: Pop (float text) < Beam (coloured beam) < Card (Reveal card + camera)
-- < Server (announce + beam for everyone) < Spectacle (Relic).
export type FindTier = "Pop" | "Beam" | "Card" | "Server" | "Spectacle"
export type DetectorSignal = "White" | "Gold" | "Purple"

-- server -> owner "DetectorPing": coarse info only (never positions or the deposit list).
export type DetectorPing = {
	Band: number, -- 0 = nothing in range, 1 = hot (closest) .. 4 = edge of range
	Sector: number, -- 0..SECTORS-1 compass sector (0 = +Z, clockwise towards +X); -1 = none
	Vertical: string, -- "Down" | "Level" | "Up" | ""
	Signal: string, -- DetectorSignal or ""
	Remaining: number, -- seconds left in this scan
	Overhead: boolean?, -- true: the find is (nearly) straight below / above, dig vertically here
}

-- server -> owner "ExcavationStart"
export type ExcavationInfo = {
	Id: string,
	Position: Vector3, -- where the find emerges (visible ground)
	Signal: string, -- DetectorSignal of the find (ring colour)
	Rings: number,
	RingSeconds: number,
	RingGap: number,
	PerfectWindow: number,
	GoodWindow: number,
	Timeout: number,
}

-- server -> owner "FindRevealed"
export type FindInfo = {
	Id: string, -- excavation id ("" for ambient finds)
	TreasureId: string,
	Rarity: string,
	Size: string,
	Material: string,
	Quality: string,
	Value: number, -- coins at sell time (before coin boosts)
	Tier: string, -- FindTier
	IsNew: boolean, -- first time this treasure is in the Index
	NewVariants: { string }, -- variant ids seen for the first time on this treasure
	Perfect: boolean, -- every ring Perfect
	Ambient: boolean, -- popcorn find straight from a dig (no excavation)
	Position: Vector3,
}

-- Progression ------------------------------------------------------------------------------

export type RebirthConfig = {
	BaseCost: number,
	CostGrowth: number,
	MultiplierPerRebirth: number,
	BaseTokens: number,
	Resets: { string }, -- PlayerData keys reset on rebirth
	Keeps: { string }, -- PlayerData keys explicitly kept (documentation)
	Cost: (rebirths: number) -> number, -- coins for the NEXT rebirth when you have `rebirths`
	Multiplier: (rebirths: number) -> number, -- permanent sand & capacity multiplier
	Tokens: (rebirths: number) -> number, -- tokens granted for the NEXT rebirth
}

export type QuestKind =
	"DigTimes"
	| "SellTimes"
	| "FindTreasures"
	| "FindRarity" -- Target treasures of Rarity or rarer
	| "HatchEggs"
	| "PlayMinutes"
	| "BuyUpgrade" -- buy any shovel or backpack
	| "ReachDepth" -- Target = studs below surface (compare with MaxDepth)
	| "Rebirth"

export type QuestReset = "Daily" | "Once"

export type QuestDef = {
	Id: string,
	Name: string,
	Description: string,
	Kind: QuestKind,
	Target: number,
	Rarity: Rarity?, -- FindRarity only
	Reset: QuestReset,
	Reward: Reward,
}

export type QuestProgress = {
	Progress: number,
	Claimed: boolean,
	Day: number?, -- UTC day number (os.time() // 86400) this progress belongs to (Daily quests)
}

export type DailyRewardDef = {
	Day: number, -- 1..7
	Label: string,
	Reward: Reward,
}

export type CodeDef = {
	Code: string, -- matched case-insensitively
	Reward: Reward,
	Enabled: boolean,
	Expires: number?, -- unix time; nil = never
	GroupOnly: boolean?, -- requires membership of Config.GROUP_ID
	Note: string,
}

-- Boosts & events --------------------------------------------------------------------------

export type BoostKind = "Sand" | "Luck" | "Coins" | "Speed"

export type BoostDef = {
	Id: string,
	Name: string,
	Kind: BoostKind,
	Multiplier: number, -- Speed: cooldown is divided by this
	Description: string,
	Color: Color3,
}

export type EventDef = {
	Id: string,
	Name: string,
	Description: string,
	Kind: BoostKind,
	Multiplier: number,
	IntervalSeconds: number, -- event is active while (os.time() + OffsetSeconds) % IntervalSeconds < DurationSeconds
	DurationSeconds: number,
	OffsetSeconds: number,
	Color: Color3,
}

-- Monetization -----------------------------------------------------------------------------

export type GamePassDef = {
	Id: number, -- 0 = not created yet (owner pastes Creator Hub id)
	Name: string,
	Price: number, -- suggested Robux
	Description: string,
	Color: Color3,
	SandMultiplier: number?,
	LuckMultiplier: number?, -- v2.3: must stay nil on every pass (no paid luck; Config asserts)
	CoinMultiplier: number?, -- v2.3: sell coins factor (VIP), Stats.GetCoinFactors
	CapacityMultiplier: number?,
	ExtraPetSlots: number?,
	SpeedMultiplier: number?,
	-- v2.2: changes the odds of a random outcome (luck): hidden + refused for players whose
	-- PolicyService says ArePaidRandomItemsRestricted (Services/PolicyService).
	PaidRandom: boolean?,
}

export type ProductDef = {
	Id: number, -- 0 = not created yet
	Name: string,
	Price: number, -- suggested Robux
	Description: string,
	Grant: Reward,
	-- v2.2: buys a random item, a luck modifier, or currency that buys random items (eggs and
	-- crates): hidden + refused for PolicyService-restricted players (Services/PolicyService).
	PaidRandom: boolean?,
}

export type PremiumPerks = {
	SandMultiplier: number,
	DailyRewardMultiplier: number,
	ChatTag: string,
}

export type MonetizationConfig = {
	GamePasses: { [string]: GamePassDef },
	Products: { [string]: ProductDef },
	Premium: PremiumPerks,
}

-- Presentation -----------------------------------------------------------------------------

export type SoundDef = {
	Id: string, -- "rbxasset://..." built-in, or "" = not set yet (skip playing)
	Volume: number,
	PlaybackSpeed: number,
	Looped: boolean,
}

export type ThemeColors = {
	Sand: Color3,
	SandDark: Color3,
	Ocean: Color3,
	OceanDark: Color3,
	Sky: Color3,
	Sunset: Color3,
	Coral: Color3,
	Palm: Color3,
	Gold: Color3,
	Purple: Color3,
	Panel: Color3,
	PanelAlt: Color3,
	Text: Color3,
	TextDark: Color3,
	Stroke: Color3,
	Success: Color3,
	Danger: Color3,
	Warning: Color3,
	Disabled: Color3,
	Coins: Color3,
	Tokens: Color3,
	Robux: Color3,
	-- v3 restyle (docs/UI_STYLE.md): ocean-navy panel bodies, meaning colours for text
	Navy: Color3, -- panel body top
	NavyDark: Color3, -- panel body bottom
	NavyCard: Color3, -- inner cards on a navy body
	NavyCardDark: Color3,
	Money: Color3, -- coins / money text
	Time: Color3, -- boosts / timers text
	Highlight: Color3, -- "next" stat box, current-step accents
}

export type ThemeFonts = {
	Title: Enum.Font,
	Body: Enum.Font,
	Number: Enum.Font,
}

export type ThemeDef = {
	Colors: ThemeColors,
	Fonts: ThemeFonts,
	CornerSmall: UDim,
	CornerMedium: UDim,
	CornerLarge: UDim,
	CornerPill: UDim,
	StrokeThickness: number,
	MinTouchSize: number, -- px; never make a tappable button smaller than this
	TweenTime: number,
}

export type TutorialStep = {
	Id: string,
	Text: string, -- short, kid-friendly, big font
	Target: string?, -- CollectionService tag the 3D arrow / beam points at ("Sand" = nearest dig-zone sand)
	Complete: string, -- event that completes the step (see Config.TUTORIAL_STEPS)
}

-- Persistence & networking -----------------------------------------------------------------

-- v2: survival (heat / shade / consumables) ---------------------------------------------------
-- Owned by the Survival agent; may add fields, must keep these.

export type HeatConfig = {
	Max: number, -- heat meter range 0..Max
	SunRisePerSecond: number, -- standing in the sun on the surface
	DigRisePerDig: number, -- extra heat per dig while in the sun
	ShadeFallPerSecond: number, -- base cooling while in shade (scaled by the shade's Cooling)
	UndergroundDepth: number, -- studs below surface where it counts as underground (cool)
	UndergroundFallPerSecond: number,
	SunburntAt: number, -- heat at which the player becomes Sunburnt
	RecoverAt: number, -- Sunburnt clears when heat drops to this
	SunburntCooldownMultiplier: number, -- dig cooldown multiplier while Sunburnt (e.g. 2)
	NewPlayerGraceSeconds: number, -- no heat gain for brand-new players' first minutes
	-- Survival agent additions
	TickSeconds: number, -- server heat tick interval
	DigRiseMaxPerSecond: number, -- cap on dig heat per second (fast shovels / diggers)
	OffSandFallPerSecond: number, -- cooling anywhere off the hot sand (boardwalk, hub, sea)
	WarningAt: number, -- "getting hot" hint threshold
	EventSunMultipliers: { [string]: number }, -- Config.Events id -> multiplier on sun heat
	FountainCooldownSeconds: number,
	ConsumableMaxStack: number, -- max count of one consumable in PlayerData.Consumables
	ConsumableBoostCapSeconds: number, -- consumable boosts stack time up to this many seconds
	ShadeSlots: number, -- placed shades per player
	ShadeSlotsVip: number, -- placed shades with the VIP pass
	ShadePlaceRange: number, -- max horizontal studs from the player to the placement point
	ShadeMinSpacing: number, -- min studs between two shade poles
	ShadeHubClearance: number, -- min studs from hub stations (tagged parts)
}

export type ShadeDef = {
	Id: string,
	Name: string,
	Price: number,
	RebirthsRequired: number?,
	Radius: number, -- studs (horizontal) of shade
	Cooling: number, -- multiplier on HeatConfig.ShadeFallPerSecond
	Height: number, -- studs from the ground to the underside of the canopy (shade check + model)
	Description: string,
	Look: { [string]: any },
}

export type ConsumableDef = {
	Id: string,
	Name: string,
	Price: number, -- coins; 0 = free (e.g. water fountain only)
	Cooling: number, -- heat removed instantly
	Boost: string?, -- Config.Boosts id granted on use
	BoostSeconds: number?,
	Icon: string, -- emoji/text icon
	Description: string,
	Look: { [string]: any },
}

-- v2 digger companions were folded into pets in v2.1 (vehicle pets from Construction Crates).
-- DiggerInstance stays only so old saves' PlayerData.Diggers can be read by the DataService
-- migration (v1 -> v2), which converts them to pets and leaves the table empty.
export type DiggerInstance = {
	Level: number,
	Equipped: boolean,
}

export type PlayerData = {
	Coins: number,
	Sand: number, -- sand currently in backpack
	TotalSandDug: number,
	Rebirths: number,
	RebirthTokens: number,
	MaxDepth: number, -- studs below surface
	Shovel: string,
	OwnedShovels: { [string]: boolean },
	Backpack: string,
	OwnedBackpacks: { [string]: boolean },
	Pets: { [string]: PetInstance }, -- key = uid
	PetSlots: number,
	Treasures: { [string]: number }, -- legacy (v3: emptied by the migration into Finds, never written)
	-- v3 discovery: unsold finds, key "treasureId|Size|Material|Quality" -> count (Util/Finds.Key)
	Finds: { [string]: number },
	-- v3 discovery: variants seen per treasure, key "treasureId/VariantId" (never reset)
	FindVariants: { [string]: boolean },
	Index: { [string]: boolean }, -- discovered treasures (collection), never reset
	DailyStreak: number,
	LastDailyClaim: number, -- unix
	Quests: { [string]: QuestProgress },
	RedeemedCodes: { [string]: boolean },
	Settings: { [string]: any },
	Boosts: { [string]: number }, -- boostId -> expires unix
	Consumables: { [string]: number }, -- v2: consumable id -> count
	OwnedShades: { [string]: boolean }, -- v2
	Diggers: { [string]: DiggerInstance }, -- v2 (legacy): emptied by the v2.1 migration, never written
	Pity: { [string]: number }, -- v2.2: eggId -> hatches in a row without a Rare+ pet (EggDef.PityAt)
	LastOnline: number, -- v2.2: unix time last seen online (OfflineService), 0 = never
	RebirthPerks: { [string]: number }, -- v2.2: Config.RebirthPerks id -> level (never reset)
	PlayTime: number, -- seconds
	FirstJoin: number, -- unix
	Version: number,
}

-- v2 (Beach): DigService.DigAt(player, position, opts). Shovel/Auto digs use the equipped
-- shovel's stats; Digger / Pet (PetDigService) / Ride digs pass their own.
export type DigSource = "Shovel" | "Digger" | "Auto" | "Pet" | "Ride"

export type DigOptions = {
	Power: number, -- compared against LayerDef.Hardness
	Radius: number, -- same scale as ShovelDef.Radius
	SandMultiplier: number, -- replaces the shovel's SandMultiplier in Stats
	Source: DigSource,
	Silent: boolean?, -- true: no DigResult is sent to the player
	Origin: Vector3?, -- "Ride": server-side vehicle position the range check measures from
}

export type DigFailReason = "Cooldown" | "TooHard" | "BackpackFull" | "OutOfZone" | "TooFar" | "Bottom"

export type DigResult = {
	Success: boolean,
	Reason: DigFailReason?,
	Position: Vector3,
	Radius: number,
	SandGained: number,
	Sand: number, -- backpack total after the dig
	Capacity: number, -- effective backpack capacity
	Depth: number, -- studs below surface of the dig point
	LayerIndex: number,
	NewMaxDepth: boolean, -- true if this dig set a personal record
	NewLayer: boolean, -- true if this is the first time the player reached this layer
	TreasureId: string?,
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="45">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Finds</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Finds (v3 discovery slice) — pure functions shared by the server (authoritative) and the client
	(Index odds, reveal presentation, detector UI). Numbers live in Config.Discovery; the design
	is docs/design/Discovery.md.

	Value of a find = base x size x material x quality, where base = TreasureDef.SellValue, or for
	Relics ScaledValue x RewardScale of the player's deepest layer (seconds of income).

	Odds: Finds.VariantOdds(group, luck) is the ONE odds function. The server rolls with
	Finds.RollVariant (= Weighted.Pick over the same list) and the Index shows the same list with
	the player's current luck (Stats.GetLuck), so displayed odds are the true odds.

	Unsold finds are stored in PlayerData.Finds as "treasureId|Size|Material|Quality" -> count.
	Variants seen are in PlayerData.FindVariants as "treasureId/VariantId" -> true.
]]

local Shared = script.Parent.Parent
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Weighted = require(script.Parent.Weighted)

local D = Config.Discovery

export type VariantOdd = { Id: string, Chance: number }
export type Grade = "Perfect" | "Good" | "Miss"
export type VariantDef = typeof(Config.Discovery.SIZES[1])
export type QualityDef = typeof(Config.Discovery.QUALITIES[1])

local Finds = {}

Finds.TIERS = table.freeze({ "Pop", "Beam", "Card", "Server", "Spectacle" })

local sizeById: { [string]: VariantDef } = {}
for _, v in D.SIZES do
	sizeById[v.Id] = v
end
local materialById: { [string]: VariantDef } = {}
for _, v in D.MATERIALS do
	materialById[v.Id] = v
end
local qualityById: { [string]: QualityDef } = {}
for _, q in D.QUALITIES do
	qualityById[q.Id] = q
end
local tierOrder: { [string]: number } = {}
for i, t in Finds.TIERS do
	tierOrder[t] = i
end

-- Relics by unlock layer (any deposit of layer >= def.Layer may hold one).
local relics: { Types.TreasureDef } = {}
for _, def in Config.Treasures do
	if def.Rarity == "Relic" then
		table.insert(relics, def)
	end
end

function Finds.GetSize(id: string): VariantDef?
	return sizeById[id]
end

function Finds.GetMaterial(id: string): VariantDef?
	return materialById[id]
end

function Finds.GetQuality(id: string): QualityDef?
	return qualityById[id]
end

function Finds.IsSize(id: any): boolean
	return type(id) == "string" and sizeById[id] ~= nil
end

function Finds.IsMaterial(id: any): boolean
	return type(id) == "string" and materialById[id] ~= nil
end

-- Keys ------------------------------------------------------------------------------------------

function Finds.Key(treasureId: string, size: string, material: string, quality: string): string
	return treasureId .. "|" .. size .. "|" .. material .. "|" .. quality
end

-- (treasureId, size, material, quality) or nil for a malformed / unknown key.
function Finds.ParseKey(key: string): (string?, string?, string?, string?)
	local id, size, material, quality = string.match(key, "^([^|]+)|([^|]+)|([^|]+)|([^|]+)$")
	if not id or not size or not material or not quality then
		return nil, nil, nil, nil
	end
	local i, sz, m, q = id :: string, size :: string, material :: string, quality :: string
	if not Config.GetTreasure(i) or not sizeById[sz] or not materialById[m] or not qualityById[q] then
		return nil, nil, nil, nil
	end
	return i, sz, m, q
end

function Finds.VariantKey(treasureId: string, variantId: string): string
	return treasureId .. "/" .. variantId
end

-- Odds -------------------------------------------------------------------------------------------

local function sanitizeLuck(luck: number?): number
	local l = luck or 1
	if l ~= l or l == math.huge or l < 1 then
		return 1
	end
	return l
end

-- True odds of a variant group ("Size" | "Material") at this luck: luck multiplies the weight of
-- every Lucky (rarer-than-default) variant. Returns { {Id, Chance} } in config order, sums to 1.
function Finds.VariantOdds(group: string, luck: number?): { VariantOdd }
	local list: { VariantDef } = if group == "Size" then D.SIZES else D.MATERIALS
	local l = sanitizeLuck(luck)
	local total = 0
	for _, v in list do
		total += v.Weight * (if v.Lucky then l else 1)
	end
	local out: { VariantOdd } = {}
	for _, v in list do
		table.insert(out, { Id = v.Id, Chance = v.Weight * (if v.Lucky then l else 1) / total })
	end
	return out
end

function Finds.RollVariant(group: string, luck: number?, roll: number): string
	local odds = Finds.VariantOdds(group, luck)
	local picked = Weighted.Pick(odds, function(o: VariantOdd): number
		return o.Chance
	end, roll)
	return if picked then picked.Id else (if group == "Size" then "Normal" else "None")
end

-- Deposit contents: a Relic with D.RELIC_CHANCE (when one is unlocked at this layer), else the
-- layer's LootTable at base weights. relicRoll / lootRoll in [0, 1).
function Finds.RollTreasure(layerIndex: number, relicRoll: number, lootRoll: number): string?
	local index = math.clamp(math.floor(layerIndex), 1, #Config.Layers)
	if relicRoll < D.RELIC_CHANCE then
		local eligible: { Types.TreasureDef } = {}
		for _, def in relics do
			if def.Layer <= index then
				table.insert(eligible, def)
			end
		end
		if #eligible > 0 then
			return eligible[math.clamp(math.floor(lootRoll * #eligible) + 1, 1, #eligible)].Id
		end
	end
	local entry = Weighted.Pick(Config.Layers[index].LootTable, function(e: Types.LootEntry): number
		return e.Weight
	end, lootRoll)
	return if entry then entry.TreasureId else nil
end

function Finds.Relics(): { Types.TreasureDef }
	return relics
end

-- Expected deposits per chunk at a layer (fraction = chance of one more).
function Finds.Density(layerIndex: number): number
	return D.DENSITY[math.clamp(math.floor(layerIndex), 1, #D.DENSITY)]
end

-- Excavation scoring ---------------------------------------------------------------------------------

-- One ring: absolute timing error in seconds (negative / NaN / non-number = no tap).
function Finds.Grade(err: any): Grade
	if type(err) ~= "number" or err ~= err or err < 0 then
		return "Miss"
	end
	if err <= D.PERFECT_WINDOW then
		return "Perfect"
	elseif err <= D.GOOD_WINDOW then
		return "Good"
	end
	return "Miss"
end

-- Scores a client report (clamped: at most D.RINGS entries count). Returns (score, perfects).
function Finds.Score(errors: any): (number, number)
	if type(errors) ~= "table" then
		return 0, 0
	end
	local score, perfects = 0, 0
	for i = 1, D.RINGS do
		local grade = Finds.Grade((errors :: { any })[i])
		if grade == "Perfect" then
			score += 2
			perfects += 1
		elseif grade == "Good" then
			score += 1
		end
	end
	return score, perfects
end

function Finds.QualityForScore(score: number): Types.FindQuality
	local best: Types.FindQuality = "Damaged"
	for _, q in D.QUALITIES do
		if score >= q.MinScore then
			best = q.Id
		end
	end
	return best
end

-- Value -----------------------------------------------------------------------------------------

function Finds.BaseValue(def: Types.TreasureDef, maxDepth: number): number
	if def.ScaledValue then
		return def.ScaledValue * Config.GetLayerAtDepth(maxDepth).RewardScale
	end
	return def.SellValue
end

-- Coins for one find (before coin boosts / events), rounded down, at least 1.
function Finds.Value(treasureId: string, size: string, material: string, quality: string, maxDepth: number): number
	local found = Config.GetTreasure(treasureId)
	if not found then
		return 0
	end
	local def = found :: Types.TreasureDef
	local s = sizeById[size]
	local m = materialById[material]
	local q = qualityById[quality]
	local mult = (if s then s.ValueMultiplier else 1)
		* (if m then m.ValueMultiplier else 1)
		* (if q then q.ValueMultiplier else 1)
	return math.max(1, math.floor(Finds.BaseValue(def, maxDepth) * mult))
end

-- Total coins of a PlayerData.Finds table (unknown keys ignored).
function Finds.TotalValue(finds: { [string]: number }?, maxDepth: number): number
	local total = 0
	local list: { [string]: number } = finds or {}
	for key, count in list do
		if type(key) == "string" and type(count) == "number" and count > 0 then
			local id, size, material, quality = Finds.ParseKey(key)
			if id and size and material and quality then
				total += Finds.Value(id, size, material, quality, maxDepth) * count
			end
		end
	end
	return total
end

function Finds.Count(finds: { [string]: number }?): number
	local n = 0
	local list: { [string]: number } = finds or {}
	for _, count in list do
		if type(count) == "number" and count > 0 then
			n += count
		end
	end
	return n
end

-- Presentation --------------------------------------------------------------------------------------

function Finds.TierOrder(tier: string): number
	return tierOrder[tier] or 1
end

-- Tier by rarity; a Giant or any material variant lifts a Pop to a Beam (variants feel special).
function Finds.Tier(rarity: string, size: string?, material: string?): Types.FindTier
	local tier: Types.FindTier = D.TIER_BY_RARITY[rarity] or "Pop"
	if tier == "Pop" and (size == "Giant" or (material ~= nil and material ~= "None")) then
		tier = "Beam"
	end
	return tier
end

function Finds.Signal(rarity: string): Types.DetectorSignal
	return D.SIGNAL_BY_RARITY[rarity] or "White"
end

-- "Giant Golden Bottle Cap" (default variants add nothing).
function Finds.DisplayName(treasureId: string, size: string?, material: string?): string
	local def = Config.GetTreasure(treasureId)
	local parts = {}
	local s = if size then sizeById[size] else nil
	local m = if material then materialById[material] else nil
	if s and s.Name ~= "" then
		table.insert(parts, s.Name)
	end
	if m and m.Name ~= "" then
		table.insert(parts, m.Name)
	end
	table.insert(parts, if def then def.Name else treasureId)
	return table.concat(parts, " ")
end

-- Detector --------------------------------------------------------------------------------------------

-- 1 (hot) .. #BANDS + 1 (edge of range), 0 = out of range.
function Finds.Band(distance: number, range: number?): number
	if distance ~= distance or distance > (range or D.DETECTOR_RANGE) then
		return 0
	end
	for i, limit in D.BANDS do
		if distance < limit then
			return i
		end
	end
	return #D.BANDS + 1
end

-- Compass sector of a horizontal offset: 0 = +Z, increasing towards +X. -1 for ~zero offset.
function Finds.Sector(dx: number, dz: number): number
	if math.abs(dx) < 0.5 and math.abs(dz) < 0.5 then
		return -1
	end
	local angle = math.atan2(dx, dz) -- 0 at +Z, +pi/2 at +X
	return math.floor(angle / (2 * math.pi) * D.SECTORS + 0.5) % D.SECTORS
end

-- Unit horizontal world direction of a sector (inverse of Finds.Sector).
function Finds.SectorDirection(sector: number): Vector3
	local angle = sector / D.SECTORS * 2 * math.pi
	return Vector3.new(math.sin(angle), 0, math.cos(angle))
end

function Finds.Vertical(dy: number): string
	if dy <= -D.VERTICAL_LEVEL then
		return "Down"
	elseif dy >= D.VERTICAL_LEVEL then
		return "Up"
	end
	return "Level"
end

-- True when the find at `offset` is (nearly) straight below / above: digging vertically from here
-- reaches it, while the compass sector of a tiny horizontal offset would only send you wandering.
function Finds.Overhead(offset: Vector3): boolean
	if Finds.Vertical(offset.Y) == "Level" then
		return false
	end
	local horizontal = Vector3.new(offset.X, 0, offset.Z).Magnitude
	return horizontal <= math.max(D.OVERHEAD_MIN, math.abs(offset.Y) * D.OVERHEAD_SLOPE)
end

-- The coarse ping for a deposit at `offset` (deposit - player) of this rarity.
function Finds.Ping(offset: Vector3?, rarity: string?, remaining: number, range: number?): Types.DetectorPing
	if not offset or not rarity then
		return { Band = 0, Sector = -1, Vertical = "", Signal = "", Remaining = remaining }
	end
	local o = offset :: Vector3
	local band = Finds.Band(o.Magnitude, range)
	if band == 0 then
		return { Band = 0, Sector = -1, Vertical = "", Signal = "", Remaining = remaining }
	end
	return {
		Band = band,
		Sector = Finds.Sector(o.X, o.Z),
		Vertical = Finds.Vertical(o.Y),
		Signal = Finds.Signal(rarity :: string),
		Remaining = remaining,
		Overhead = Finds.Overhead(o),
	}
end

-- Seconds between detector beeps for a band (client sound pacing).
function Finds.BeepInterval(band: number): number
	if band <= 0 then
		return 0
	end
	return ({ 0.12, 0.25, 0.45, 0.8 })[math.clamp(band, 1, 4)]
end

return Finds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Number/time formatting shared by UI, leaderboards and notifications.
local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234 -> "1.23K", 15 -> "15", 1e15 -> "1Qa"
function Format.Abbreviate(n: number): string
	if n ~= n then
		return "0"
	end
	local sign = if n < 0 then "-" else ""
	n = math.abs(n)
	if n < 1000 then
		return sign .. tostring(math.floor(n))
	end
	local tier = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
	local scaled = n / 10 ^ (tier * 3)
	local text = if scaled >= 100
		then string.format("%d", math.floor(scaled))
		elseif scaled >= 10 then string.format("%.1f", math.floor(scaled * 10) / 10)
		else string.format("%.2f", math.floor(scaled * 100) / 100)
	text = (text:gsub("%.?0+$", ""))
	return sign .. text .. SUFFIXES[tier + 1]
end

-- v2.2 odds display: probability (0..1) -> "60%", "12.5%", "1.9%", "0.5%", "0.05%", "0.012%".
-- >= 10%: one decimal; >= 1%: two; below that two significant digits. Trailing zeros dropped.
function Format.Chance(probability: number): string
	if probability ~= probability or probability <= 0 then
		return "0%"
	end
	local pct = math.min(probability, 1) * 100
	local decimals = if pct >= 10 then 1 elseif pct >= 1 then 2 else math.ceil(-math.log10(pct)) + 1
	local text = string.format("%." .. math.clamp(decimals, 0, 8) .. "f", pct)
	if string.find(text, ".", 1, true) then
		text = (text:gsub("0+$", ""):gsub("%.$", ""))
	end
	return text .. "%"
end

-- 1234567 -> "1,234,567"
function Format.Commas(n: number): string
	local s = tostring(math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (if n < 0 then "-" else "") .. out
end

-- 125 -> "2:05", 3725 -> "1:02:05"
function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

function Format.Depth(studs: number): string
	return Format.Commas(math.floor(studs)) .. "m"
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RateLimiter — token bucket per key (usually a Player). Pure: the clock is injectable so it
	can be unit-tested outside Roblox.

		local limiter = RateLimiter.new(10, 1) -- burst of 10, refills 10 per second
		if not limiter:Check(player) then return end
]]

export type RateLimiter = {
	Check: (self: RateLimiter, key: any, cost: number?) -> boolean,
	Remove: (self: RateLimiter, key: any) -> (),
}

type Bucket = { Tokens: number, Last: number }

local RateLimiter = {}

function RateLimiter.new(capacity: number, windowSeconds: number, clock: (() -> number)?): RateLimiter
	assert(capacity > 0 and windowSeconds > 0, "RateLimiter: capacity and window must be > 0")
	local now: () -> number = clock or os.clock
	local refillPerSecond = capacity / windowSeconds
	local buckets: { [any]: Bucket } = {}

	local self = {} :: RateLimiter

	function self.Check(_: RateLimiter, key: any, cost: number?): boolean
		local price = cost or 1
		local t = now()
		local bucket = buckets[key]
		if not bucket then
			bucket = { Tokens = capacity, Last = t }
			buckets[key] = bucket
		end
		bucket.Tokens = math.min(capacity, bucket.Tokens + (t - bucket.Last) * refillPerSecond)
		bucket.Last = t
		if bucket.Tokens >= price then
			bucket.Tokens -= price
			return true
		end
		return false
	end

	function self.Remove(_: RateLimiter, key: any)
		buckets[key] = nil
	end

	return self
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">RideMath</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RideMath — ride-on vehicle geometry shared by RideService (server) and RideController
	(client) so both agree on the allowed area and the ground height (Config.Ride).

	- Bounds(zoneCFrame, zoneSize): the rectangle the vehicle PIVOT may occupy: the dig zone
	  (minus EdgeMargin) plus the boardwalk up to InlandMaxZ.
	- Clamp(position, bounds): position clamped into the rectangle (Y unchanged).
	- Inside(position, bounds, slack): horizontal containment test.
	- GroundY(pivot): height for the pivot (bottom of the tracks) at `pivot`: the highest of the
	  track samples, where each sample is the boardwalk deck top (z >= DeckSeaEdgeZ) or the terrain
	  surface from a raycast, floored at SURFACE_Y so the vehicle rides OVER dug holes at surface
	  level instead of falling in.
]]

local Workspace = game:GetService("Workspace")

local Config = require(script.Parent.Parent.Config)

local RideMath = {}

export type Bounds = { MinX: number, MaxX: number, MinZ: number, MaxZ: number }

local R = Config.Ride
local S = Config.SURFACE_Y

local terrainOnly = RaycastParams.new()
terrainOnly.FilterType = Enum.RaycastFilterType.Include
terrainOnly.FilterDescendantsInstances = { Workspace.Terrain }
terrainOnly.IgnoreWater = true

function RideMath.Bounds(zoneCFrame: CFrame, zoneSize: Vector3): Bounds
	local c = zoneCFrame.Position
	return {
		MinX = c.X - zoneSize.X / 2 + R.EdgeMargin,
		MaxX = c.X + zoneSize.X / 2 - R.EdgeMargin,
		MinZ = c.Z - zoneSize.Z / 2 + R.EdgeMargin,
		MaxZ = R.InlandMaxZ,
	}
end

function RideMath.Clamp(position: Vector3, b: Bounds): Vector3
	return Vector3.new(math.clamp(position.X, b.MinX, b.MaxX), position.Y, math.clamp(position.Z, b.MinZ, b.MaxZ))
end

function RideMath.Inside(position: Vector3, b: Bounds, slack: number?): boolean
	local s = slack or 0
	return position.X >= b.MinX - s
		and position.X <= b.MaxX + s
		and position.Z >= b.MinZ - s
		and position.Z <= b.MaxZ + s
end

-- Ground height at one world (x, z) point.
function RideMath.GroundAt(x: number, z: number): number
	if z >= R.DeckSeaEdgeZ then
		return S + R.DeckTop
	end
	local hit = Workspace:Raycast(Vector3.new(x, S + 12, z), Vector3.new(0, -24, 0), terrainOnly)
	if hit then
		return math.max(hit.Position.Y, S)
	end
	return S
end

-- Pivot height for a vehicle whose pivot is at `pivot` (only position + yaw are used).
function RideMath.GroundY(pivot: CFrame): number
	local best = -math.huge
	for _, sample in R.TrackSamples do
		local p = pivot * Vector3.new(sample.X, 0, sample.Y)
		best = math.max(best, RideMath.GroundAt(p.X, p.Z))
	end
	return best + R.HoverHeight
end

return RideMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Signal — tiny typed event object (no Instances, works on server and client).

		local changed = Signal.new() :: Signal.Signal<Player, number>
		local conn = changed:Connect(function(player, value) ... end)
		changed:Fire(player, 5)
		conn:Disconnect()

	Handlers run in their own thread (task.spawn), so a yielding or erroring handler never
	blocks the caller or other handlers.
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal<T...> = {
	Connect: (self: Signal<T...>, handler: (T...) -> ()) -> Connection,
	Once: (self: Signal<T...>, handler: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	Wait: (self: Signal<T...>) -> T...,
	DisconnectAll: (self: Signal<T...>) -> (),
}

local Signal = {}

function Signal.new<T...>(): Signal<T...>
	type Entry = { Handler: (T...) -> (), Connection: Connection }
	local entries: { Entry } = {}

	local function remove(connection: Connection)
		for i, entry in entries do
			if entry.Connection == connection then
				table.remove(entries, i)
				return
			end
		end
	end

	local self = {} :: Signal<T...>

	function self.Connect(_: Signal<T...>, handler: (T...) -> ()): Connection
		local connection = {} :: Connection
		connection.Connected = true
		function connection.Disconnect(c: Connection)
			if c.Connected then
				c.Connected = false
				remove(c)
			end
		end
		table.insert(entries, { Handler = handler, Connection = connection })
		return connection
	end

	function self.Once(s: Signal<T...>, handler: (T...) -> ()): Connection
		local connection: Connection
		connection = s:Connect(function(...: T...)
			connection:Disconnect()
			handler(...)
		end)
		return connection
	end

	function self.Fire(_: Signal<T...>, ...: T...)
		-- Snapshot so handlers may connect/disconnect while we iterate.
		local snapshot = table.clone(entries)
		for _, entry in snapshot do
			if entry.Connection.Connected then
				task.spawn(entry.Handler, ...)
			end
		end
	end

	function self.Wait(s: Signal<T...>): T...
		local thread = coroutine.running()
		s:Once(function(...: T...)
			task.spawn(thread, ...)
		end)
		return coroutine.yield()
	end

	function self.DisconnectAll(_: Signal<T...>)
		for _, entry in entries do
			entry.Connection.Connected = false
		end
		table.clear(entries)
	end

	return self
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Stats</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Stats — the ONE place the multiplier stack is computed. Pure functions of a Context, used by
	the server (authoritative) and safe for the client to mirror for UI ("x12.5 sand", odds...).

	Building a Context on the client:
		{
			Data = <PlayerData from DataChanged/GetData>,
			Passes = <GetOwnedPasses() result>,
			IsPremium = player.MembershipType == Enum.MembershipType.Premium,
			InGroup = player:GetAttribute("InGroup") == true,
			FriendsInServer = player:GetAttribute("FriendsInServer") or 0,
			ActiveEvents = <EventChanged ids>,
			Now = os.time(),
		}
	(The server also publishes the results as Player attributes — see MultiplierService.)

	Sand per dig = layer.SandValue x shovel x rebirth x pets x passes x premium x group x friends
	               x index x Sand boosts x Sand events
	Capacity     = backpack.Capacity x rebirth x pass CapacityMultiplier (Mega Backpack) x Deep Pockets perk
	Luck         = Luck boosts x Luck events (v2.3: no pass sells luck; LuckMultiplier stays
	               supported but Config rejects it on passes)
	Coins (sell) = Golden Touch perk x pass CoinMultiplier (VIP, v2.3) x Coins boosts x Coins events
	(v2.2 Rebirth perks, Config.RebirthPerks: Pet Den adds pet slots, Lucky Digger multiplies the
	treasure chance only.)
	Speed        = pass SpeedMultiplier x Speed boosts x Speed events (cooldown is divided by it)

	v2.2 TRUE ODDS (Roblox policy: paid random items show their real, modified odds):
	Stats.GetHatchOdds(egg, luck, pityCount?) -> ({ [petId]: probability }, pityActive)
	Stats.GetHatchOddsList(egg, luck, pityCount?) -> ({ { PetId, Chance } } in egg order, pityActive)
	Stats.RollHatch(egg, luck, pityCount, roll) -> petId?
	The server rolls with RollHatch (= Weighted.Pick over GetHatchOddsList) and the egg panel
	displays GetHatchOddsList with the same luck (Stats.GetLuck) and pity counter
	(PlayerData.Pity[egg.Id]), so what players see is exactly what the server rolls.
]]

local Shared = script.Parent.Parent
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Finds = require(script.Parent.Finds) -- v3 discovery slice
local Weighted = require(script.Parent.Weighted)

export type Context = {
	Data: Types.PlayerData,
	Passes: { [string]: boolean },
	IsPremium: boolean,
	InGroup: boolean,
	FriendsInServer: number,
	ActiveEvents: { string },
	Now: number,
}

export type Factor = {
	Name: string, -- short label for UI breakdowns ("Shovel", "Rebirth", "2x Sand"...)
	Value: number,
}

local Stats = {}

local PASS_KEYS: { string } = {}
for key in Config.Monetization.GamePasses do
	table.insert(PASS_KEYS, key)
end
table.sort(PASS_KEYS)

function Stats.Product(factors: { Factor }): number
	local total = 1
	for _, factor in factors do
		total *= factor.Value
	end
	return total
end

function Stats.GetShovel(data: Types.PlayerData): Types.ShovelDef
	return Config.GetShovel(data.Shovel) or Config.Shovels[1]
end

function Stats.GetBackpack(data: Types.PlayerData): Types.BackpackDef
	return Config.GetBackpack(data.Backpack) or Config.Backpacks[1]
end

-- Equip slots: PlayerData.PetSlots + ExtraPets pass.
function Stats.GetPetSlots(ctx: Context): number
	local slots = ctx.Data.PetSlots + Config.RebirthPerks.ExtraPetSlots(ctx.Data.RebirthPerks) -- v2.2 Pet Den
	for _, key in PASS_KEYS do
		local pass = Config.Monetization.GamePasses[key]
		if ctx.Passes[key] and pass.ExtraPetSlots then
			slots += pass.ExtraPetSlots
		end
	end
	return slots
end

-- Equipped pet ids, capped at `maxSlots` (sorted by uid so the cap is deterministic).
-- v2.2: second result golden[i] = true when ids[i] is a Golden pet (Config.PetMultiplier).
function Stats.GetEquippedPetIds(data: Types.PlayerData, maxSlots: number): ({ string }, { [number]: boolean })
	local uids = {}
	for uid, pet in data.Pets do
		if pet.Equipped then
			table.insert(uids, uid)
		end
	end
	table.sort(uids)
	local ids = {}
	local golden: { [number]: boolean } = {}
	for i, uid in uids do
		if i > maxSlots then
			break
		end
		table.insert(ids, data.Pets[uid].Id)
		if data.Pets[uid].Golden == true then
			golden[#ids] = true
		end
	end
	return ids, golden
end

-- v2.2: equipped pets (valid ids) in the order of the "EquippedPets" attribute: by Id, normal
-- before Golden. PetService (attributes), PetDigService (slots) and the client all use this.
function Stats.SortEquipped(pets: { [string]: Types.PetInstance }): { Types.PetInstance }
	local list: { Types.PetInstance } = {}
	for _, pet in pets do
		if pet.Equipped and Config.GetPet(pet.Id) then
			table.insert(list, pet)
		end
	end
	table.sort(list, function(a: Types.PetInstance, b: Types.PetInstance): boolean
		if a.Id ~= b.Id then
			return a.Id < b.Id
		end
		return a.Golden ~= true and b.Golden == true
	end)
	return list
end

function Stats.IsBoostActive(data: Types.PlayerData, boostId: string, now: number): boolean
	local expires = data.Boosts[boostId]
	return expires ~= nil and expires > now
end

-- Seconds left on a boost (0 when inactive).
function Stats.GetBoostRemaining(data: Types.PlayerData, boostId: string, now: number): number
	local expires = data.Boosts[boostId]
	if expires == nil then
		return 0
	end
	return math.max(0, expires - now)
end

-- Appends boost + event factors of a given kind.
local function addTimed(ctx: Context, kind: Types.BoostKind, factors: { Factor })
	local boostIds = {}
	for boostId, expires in ctx.Data.Boosts do
		if expires > ctx.Now then
			table.insert(boostIds, boostId)
		end
	end
	table.sort(boostIds)
	for _, boostId in boostIds do
		local def = Config.GetBoost(boostId)
		if def and def.Kind == kind then
			table.insert(factors, { Name = def.Name, Value = def.Multiplier })
		end
	end
	for _, eventId in ctx.ActiveEvents do
		local event = Config.GetEvent(eventId)
		if event and event.Kind == kind then
			table.insert(factors, { Name = event.Name, Value = event.Multiplier })
		end
	end
end

local function addPasses(ctx: Context, field: string, factors: { Factor })
	for _, key in PASS_KEYS do
		if ctx.Passes[key] then
			local pass = Config.Monetization.GamePasses[key] :: any
			local value = pass[field]
			if type(value) == "number" and value ~= 1 then
				table.insert(factors, { Name = pass.Name, Value = value })
			end
		end
	end
end

-- Sand ----------------------------------------------------------------------------------------

-- Additive pet bonus of the equipped pets (Golden pets count x GOLDEN_SAND_BONUS).
function Stats.GetPetMultiplier(ctx: Context): number
	local ids, golden = Stats.GetEquippedPetIds(ctx.Data, Stats.GetPetSlots(ctx))
	return Config.PetMultiplier(ids, golden)
end

function Stats.GetSandFactors(ctx: Context): { Factor }
	local data = ctx.Data
	local factors: { Factor } = {
		{ Name = "Shovel", Value = Stats.GetShovel(data).SandMultiplier },
		{ Name = "Rebirth", Value = Config.RebirthMultiplier(data.Rebirths) },
		{ Name = "Pets", Value = Stats.GetPetMultiplier(ctx) },
	}
	addPasses(ctx, "SandMultiplier", factors)
	if ctx.IsPremium then
		table.insert(factors, { Name = "Premium", Value = Config.Monetization.Premium.SandMultiplier })
	end
	if ctx.InGroup and Config.GROUP_ID ~= 0 then
		table.insert(factors, { Name = "Group", Value = Config.GROUP_SAND_MULTIPLIER })
	end
	local friends = math.max(0, math.floor(ctx.FriendsInServer))
	if friends > 0 then
		local bonus = math.min(friends * Config.FRIEND_BONUS_PER_FRIEND, Config.FRIEND_BONUS_MAX)
		table.insert(factors, { Name = "Friends", Value = 1 + bonus })
	end
	local completed = Config.CountCompletedIndexLayers(data.Index)
	if completed > 0 then
		table.insert(factors, { Name = "Index", Value = 1 + completed * Config.INDEX_LAYER_BONUS })
	end
	addTimed(ctx, "Sand", factors)
	return factors
end

function Stats.GetSandMultiplier(ctx: Context): number
	return Stats.Product(Stats.GetSandFactors(ctx))
end

function Stats.GetSandPerDig(ctx: Context, layerIndex: number): number
	local layer = Config.Layers[math.clamp(layerIndex, 1, #Config.Layers)]
	return layer.SandValue * Stats.GetSandMultiplier(ctx)
end

-- Capacity ------------------------------------------------------------------------------------

function Stats.GetCapacity(ctx: Context): number
	local factors: { Factor } = {
		{ Name = "Rebirth", Value = Config.RebirthMultiplier(ctx.Data.Rebirths) },
	}
	addPasses(ctx, "CapacityMultiplier", factors)
	local pockets = Config.RebirthPerks.CapacityFactor(ctx.Data.RebirthPerks) -- v2.2 Deep Pockets perk
	if pockets ~= 1 then
		table.insert(factors, { Name = "Deep Pockets", Value = pockets })
	end
	return math.floor(Stats.GetBackpack(ctx.Data).Capacity * Stats.Product(factors))
end

-- Luck ----------------------------------------------------------------------------------------

function Stats.GetLuckFactors(ctx: Context): { Factor }
	local factors: { Factor } = {}
	addPasses(ctx, "LuckMultiplier", factors)
	addTimed(ctx, "Luck", factors)
	return factors
end

function Stats.GetLuck(ctx: Context): number
	return Stats.Product(Stats.GetLuckFactors(ctx))
end

-- Chance (0..MAX_TREASURE_CHANCE) that a successful dig in this layer finds a treasure.
function Stats.GetTreasureChance(ctx: Context, layerIndex: number): number
	local layer = Config.Layers[math.clamp(layerIndex, 1, #Config.Layers)]
	-- v2.2 Lucky Digger perk: treasure chance only (egg odds are untouched by it)
	local perk = Config.RebirthPerks.TreasureFactor(ctx.Data.RebirthPerks)
	return math.min(layer.TreasureChance * Stats.GetLuck(ctx) * perk, Config.MAX_TREASURE_CHANCE)
end

-- Luck multiplies the weight of every non-Common entry (loot tables and eggs).
function Stats.LuckWeight(baseWeight: number, rarity: Types.Rarity?, luck: number): number
	if rarity == nil or rarity == "Common" then
		return baseWeight
	end
	return baseWeight * luck
end

-- Hatch odds + pity (v2.2) -----------------------------------------------------------------------

export type HatchOdd = { PetId: string, Chance: number }

local function rarityOrderOf(petId: string): number
	local pet = Config.GetPet(petId)
	local rarity = if pet then Config.GetRarity(pet.Rarity) else nil
	return if rarity then rarity.Order else 0
end

-- Does this pet count as "Rare or better" for pity?
function Stats.IsPityRarity(petId: string): boolean
	return rarityOrderOf(petId) >= Config.PITY_MIN_RARITY_ORDER
end

-- Pity is active (the next hatch is guaranteed Rare+) after egg.PityAt hatches without one.
function Stats.IsPityActive(egg: Types.EggDef, pityCount: number?): boolean
	local at = egg.PityAt
	return at ~= nil and (pityCount or 0) >= at
end

-- Which upcoming hatch is guaranteed Rare+: 1 = the next one. nil when the egg has no pity.
function Stats.HatchesUntilPity(egg: Types.EggDef, pityCount: number?): number?
	local at = egg.PityAt
	if at == nil then
		return nil
	end
	return math.max(1, (at :: number) + 1 - (pityCount or 0))
end

-- The pity counter after hatching petId (reset by a Rare+ pet, otherwise +1).
function Stats.NextPityCount(egg: Types.EggDef, pityCount: number?, petId: string): number
	if egg.PityAt == nil or Stats.IsPityRarity(petId) then
		return 0
	end
	return (pityCount or 0) + 1
end

local function sanitizeLuck(luck: number): number
	if luck ~= luck or luck <= 0 or luck == math.huge then
		return 1
	end
	return luck
end

-- THE odds function. Probability of each pet for ONE hatch of `egg` with this luck (Stats.GetLuck)
-- and pity counter (PlayerData.Pity[egg.Id]); in egg order. Luck multiplies the weight of every
-- non-Common pet (Stats.LuckWeight). When pity is active only Rare+ pets keep their (luck)
-- weight. Returns (list, pityActive). Chances sum to 1.
function Stats.GetHatchOddsList(egg: Types.EggDef, luck: number, pityCount: number?): ({ HatchOdd }, boolean)
	local l = sanitizeLuck(luck)
	local pity = Stats.IsPityActive(egg, pityCount)
	local weights: { number } = {}
	for i, entry in egg.Pets do
		local pet = Config.GetPet(entry.PetId)
		local w = Stats.LuckWeight(entry.Weight, if pet then pet.Rarity else nil, l)
		if pity and not Stats.IsPityRarity(entry.PetId) then
			w = 0
		end
		weights[i] = w
	end
	local indices: { number } = {}
	for i in egg.Pets do
		indices[i] = i
	end
	local probabilities = Weighted.Odds(indices, function(i: number): number
		return weights[i]
	end)
	local list: { HatchOdd } = {}
	for i, entry in egg.Pets do
		list[i] = { PetId = entry.PetId, Chance = probabilities[i] }
	end
	return list, pity
end

-- Same odds keyed by pet id (an egg lists each pet once).
function Stats.GetHatchOdds(egg: Types.EggDef, luck: number, pityCount: number?): ({ [string]: number }, boolean)
	local list, pity = Stats.GetHatchOddsList(egg, luck, pityCount)
	local map: { [string]: number } = {}
	for _, odd in list do
		map[odd.PetId] = (map[odd.PetId] or 0) + odd.Chance
	end
	return map, pity
end

-- Server roll: `roll` in [0, 1) (Random:NextNumber()). Picks from GetHatchOddsList, so the
-- shown odds and the real roll can never diverge.
function Stats.RollHatch(egg: Types.EggDef, luck: number, pityCount: number?, roll: number): string?
	local list = Stats.GetHatchOddsList(egg, luck, pityCount)
	local odd = Weighted.Pick(list, function(o: HatchOdd): number
		return o.Chance
	end, roll)
	return if odd then odd.PetId else nil
end

-- Coins & speed -------------------------------------------------------------------------------

function Stats.GetCoinFactors(ctx: Context): { Factor }
	local factors: { Factor } = {}
	local touch = Config.RebirthPerks.CoinFactor(ctx.Data.RebirthPerks) -- v2.2 Golden Touch perk
	if touch ~= 1 then
		table.insert(factors, { Name = "Golden Touch", Value = touch })
	end
	addPasses(ctx, "CoinMultiplier", factors) -- v2.3: VIP +10% sell coins
	addTimed(ctx, "Coins", factors)
	return factors
end

function Stats.GetCoinMultiplier(ctx: Context): number
	return Stats.Product(Stats.GetCoinFactors(ctx))
end

function Stats.GetSpeedMultiplier(ctx: Context): number
	local factors: { Factor } = {}
	addPasses(ctx, "SpeedMultiplier", factors)
	addTimed(ctx, "Speed", factors)
	return math.max(Stats.Product(factors), 0.01)
end

-- Seconds between digs with the equipped shovel (before server latency leniency).
function Stats.GetCooldown(ctx: Context): number
	return Stats.GetShovel(ctx.Data).Cooldown / Stats.GetSpeedMultiplier(ctx)
end

-- Coins a full sell would pay right now (sand + unsold treasures + v3 finds, coin multipliers
-- applied). Finds: Util/Finds.TotalValue (base x size x material x quality).
function Stats.GetSellValue(ctx: Context): number
	local data = ctx.Data
	local total = math.max(data.Sand, 0) * Config.SELL_RATE
	for treasureId, count in data.Treasures do
		local def = Config.GetTreasure(treasureId)
		if def and count > 0 then
			total += def.SellValue * count
		end
	end
	total += Finds.TotalValue(data.Finds, data.MaxDepth)
	return math.floor(total * Stats.GetCoinMultiplier(ctx))
end

return Stats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">TableUtil</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TableUtil — pure table helpers used by persistence.
]]

local TableUtil = {}

function TableUtil.DeepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value :: any do
		copy[TableUtil.DeepCopy(k)] = TableUtil.DeepCopy(v)
	end
	return (copy :: any) :: T
end

--[[
	Fill every key that exists in `template` but is missing (or has the wrong type) in `target`,
	recursing into nested tables. Keys that only exist in `target` are kept. Mutates and
	returns `target`. NaN / infinite numbers are treated as corrupt and replaced.
]]
function TableUtil.Reconcile(target: { [any]: any }, template: { [any]: any }): { [any]: any }
	for key, default in template do
		local current = target[key]
		if current == nil or type(current) ~= type(default) then
			target[key] = TableUtil.DeepCopy(default)
		elseif type(current) == "number" and (current ~= current or math.abs(current) == math.huge) then
			target[key] = default
		elseif type(default) == "table" then
			TableUtil.Reconcile(current, default)
		end
	end
	return target
end

function TableUtil.Count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

return TableUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Week</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Week — ISO-8601 week numbers (UTC) for weekly leaderboards. Weeks start on Monday; week 1 is
	the week holding the year's first Thursday, so 29 Dec .. 3 Jan can belong to either year.

		Week.Iso(unix): (isoYear, isoWeek)
		Week.Key(unix): "W2026_41"   (week zero-padded; used in OrderedDataStore names)
		Week.SecondsLeft(unix): seconds until the next Monday 00:00 UTC
]]

local Week = {}

local DAY = 86400

function Week.Iso(unix: number): (number, number)
	local days = math.floor(unix / DAY)
	local weekday = (days + 3) % 7 + 1 -- 1970-01-01 was a Thursday; Monday = 1 .. Sunday = 7
	local thursday = days - weekday + 4 -- the Thursday of this ISO week decides the year
	local t = os.date("!*t", thursday * DAY) :: any
	local year: number = t.year
	local yday: number = t.yday
	return year, math.floor((yday - 1) / 7) + 1
end

function Week.Key(unix: number): string
	local year, week = Week.Iso(unix)
	return string.format("W%d_%02d", year, week)
end

function Week.SecondsLeft(unix: number): number
	local days = math.floor(unix / DAY)
	local weekday = (days + 3) % 7 + 1
	return (days - weekday + 8) * DAY - unix
end

return Week
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Weighted</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Weighted — pure weighted random selection (loot tables, eggs).
	`roll` is a number in [0, 1) supplied by the caller (Random:NextNumber()), which keeps this
	module deterministic and unit-testable. Entries with a non-positive or non-finite weight are
	skipped. Returns nil when no entry has weight.
]]

local Weighted = {}

local function validWeight(w: number): boolean
	return w == w and w > 0 and w ~= math.huge
end

function Weighted.Total<T>(entries: { T }, weightOf: (T) -> number): number
	local total = 0
	for _, entry in entries do
		local w = weightOf(entry)
		if validWeight(w) then
			total += w
		end
	end
	return total
end

function Weighted.Pick<T>(entries: { T }, weightOf: (T) -> number, roll: number): T?
	local total = Weighted.Total(entries, weightOf)
	if total <= 0 then
		return nil
	end
	local target = math.clamp(roll, 0, 1) * total
	local last: T? = nil
	for _, entry in entries do
		local w = weightOf(entry)
		if validWeight(w) then
			last = entry
			if target < w then
				return entry
			end
			target -= w
		end
	end
	-- Floating point slack (roll ~= 1): return the last valid entry.
	return last
end

-- Probability (0..1) of each entry, in input order (UI odds display).
function Weighted.Odds<T>(entries: { T }, weightOf: (T) -> number): { number }
	local total = Weighted.Total(entries, weightOf)
	local odds = {}
	for i, entry in entries do
		local w = weightOf(entry)
		odds[i] = if total > 0 and validWeight(w) then w / total else 0
	end
	return odds
end

return Weighted
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="55">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="56">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="57">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
	Server entry point — Dig to the Core! Beach Simulator.

	Boot order:
	  1. Remotes.CreateAll()  (every remote exists before clients look for them)
	  2. World.Build()        (map, dig zone, tagged parts)
	  3. Service Init() in dependency order (connect remotes, read config), then Start() (loops)
	  4. Player lifecycle: OnPlayerAdded in service order, OnPlayerRemoving in reverse order (so
	     DataService saves last, after every other service is done with the player's data).
	  5. Players who joined before this script finished (Studio Play Solo) are handled too.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local sharedState = shared :: any
if sharedState.DigToTheCoreServer then
	warn("[Main] Duplicate server script ignored: " .. script:GetFullName() .. ". Delete the extra copy.")
	return
end
sharedState.DigToTheCoreServer = script:GetFullName()

local Remotes = require(ReplicatedStorage.Shared.Remotes)
Remotes.CreateAll()

local World = require(script.Parent.World)
local okWorld, worldErr = pcall(function(): any
	World.Build()
	return nil
end)
if not okWorld then
	warn("[Main] World.Build failed: " .. tostring(worldErr))
end

local Services = script.Parent.Services
local DataService = require(Services.DataService)
local PolicyService = require(Services.PolicyService)
local Analytics = require(Services.Analytics)
local MonetizationService = require(Services.MonetizationService)
local EventService = require(Services.EventService)
local MultiplierService = require(Services.MultiplierService)
local SettingsService = require(Services.SettingsService)
local BeachService = require(Services.BeachService)
local ShopService = require(Services.ShopService)
local PetService = require(Services.PetService)
local EconomyService = require(Services.EconomyService)
local DigService = require(Services.DigService)
local DiscoveryService = require(Services.DiscoveryService) -- v3 buried finds / detector / excavation
local RebirthService = require(Services.RebirthService)
local RewardsService = require(Services.RewardsService)
local LeaderboardService = require(Services.LeaderboardService)
local StatusService = require(Services.StatusService) -- v2.2 nameplate attributes + worn backpack
local ServerGoalService = require(Services.ServerGoalService) -- v2.2 server-wide dig goal
local BadgeAwardService = require(Services.BadgeAwardService)
local DevCommands = require(Services.DevCommands)
local SurvivalService = require(Services.SurvivalService)
local PetDigService = require(Services.PetDigService)
local RideService = require(Services.RideService)
local OfflineService = require(Services.OfflineService)
local StreamingService = require(Services.StreamingService) -- v2.3 world anchors + streaming modes
local Net = require(Services.Net)

type Service = {
	Init: (() -> ())?,
	Start: (() -> ())?,
	OnPlayerAdded: ((Player) -> ())?,
	OnPlayerRemoving: ((Player) -> ())?,
}

-- Dependency order (each service only requires services listed before it).
local ordered: { { Name: string, Module: Service } } = {
	{ Name = "DataService", Module = DataService :: any },
	{ Name = "StreamingService", Module = StreamingService :: any }, -- v2.3: needs only the World
	{ Name = "PolicyService", Module = PolicyService :: any }, -- v2.2: paid random item policy
	{ Name = "Analytics", Module = Analytics :: any },
	{ Name = "MonetizationService", Module = MonetizationService :: any },
	{ Name = "EventService", Module = EventService :: any },
	{ Name = "MultiplierService", Module = MultiplierService :: any },
	{ Name = "SettingsService", Module = SettingsService :: any },
	{ Name = "BeachService", Module = BeachService :: any },
	{ Name = "ShopService", Module = ShopService :: any },
	{ Name = "PetService", Module = PetService :: any },
	{ Name = "EconomyService", Module = EconomyService :: any },
	{ Name = "DigService", Module = DigService :: any },
	{ Name = "DiscoveryService", Module = DiscoveryService :: any }, -- v3 discovery slice
	{ Name = "RebirthService", Module = RebirthService :: any },
	{ Name = "RewardsService", Module = RewardsService :: any },
	{ Name = "LeaderboardService", Module = LeaderboardService :: any },
	{ Name = "StatusService", Module = StatusService :: any },
	{ Name = "ServerGoalService", Module = ServerGoalService :: any },
	{ Name = "BadgeAwardService", Module = BadgeAwardService :: any },
	{ Name = "SurvivalService", Module = SurvivalService :: any },
	{ Name = "PetDigService", Module = PetDigService :: any },
	{ Name = "RideService", Module = RideService :: any },
	{ Name = "OfflineService", Module = OfflineService :: any }, -- v2.2 offline pet earnings
	{ Name = "DevCommands", Module = DevCommands :: any },
}

local function run(name: string, phase: string, fn: (...any) -> ...any, ...: any)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn(string.format("[Main] %s.%s failed: %s", name, phase, tostring(err)))
	end
end

for _, entry in ordered do
	local init = entry.Module.Init
	if init then
		run(entry.Name, "Init", init)
	end
end

-- Developer products are granted through RewardsService (coins, boosts, eggs, skip rebirth).
MonetizationService.SetGrantHandler(function(player: Player, reward, source: string): boolean
	local granted = RewardsService.Grant(player, reward, source)
	-- v2 survival: consumables (rewards with Consumables) are granted by SurvivalService.
	if granted and reward.Consumables then
		SurvivalService.GrantConsumables(player, reward.Consumables, source)
	end
	return granted
end)

for _, entry in ordered do
	local start = entry.Module.Start
	if start then
		run(entry.Name, "Start", start)
	end
end

-- Owner placeholders still to fill in before launch (docs/LAUNCH.md); never changes gameplay.
local LaunchCheck = require(Services.LaunchCheck)
pcall(LaunchCheck.Run)

local handled: { [Player]: boolean } = {}

local function onPlayerAdded(player: Player)
	if handled[player] then
		return
	end
	handled[player] = true
	for _, entry in ordered do
		local fn = entry.Module.OnPlayerAdded
		if fn then
			run(entry.Name, "OnPlayerAdded", fn, player)
		end
	end
end

local function onPlayerRemoving(player: Player)
	for i = #ordered, 1, -1 do
		local entry = ordered[i]
		local fn = entry.Module.OnPlayerRemoving
		if fn then
			run(entry.Name, "OnPlayerRemoving", fn, player)
		end
	end
	Net.OnPlayerRemoving(player)
	handled[player] = nil
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="58">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Analytics</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Analytics — thin, safe wrappers around AnalyticsService (docs/ANALYTICS.md lists every event,
	when it fires and which Creator Analytics dashboard shows it).

	Only the AnalyticsService methods in our typed API (luau-lsp defs) are used:
	  LogOnboardingFunnelStepEvent  the onboarding funnel (Analytics.Funnel)
	  LogFunnelStepEvent            recurring funnels: the "Shop" purchase funnel and our
	                                single-step "custom events" (Analytics.Custom)
	  LogProgressionStart/CompleteEvent  layers reached, rebirths (Analytics.Progression)
	  LogEconomyEvent               coin / token sources and sinks (Analytics.Source / Sink)
	(LogCustomEvent is not in the typed API we build against; Analytics.Custom is the one place
	to switch over when it is.)

	- Funnel(player, step): onboarding funnel, logged at most once per player ever, in the order
	  of Analytics.Steps. Completion flags persist in PlayerData.Settings["FTUE_<StepName>"]
	  (reserved prefix: SetSetting can't write FTUE_ keys).
	  Most steps are detected here from ServerSignals / player attributes / a light per-player
	  state poll, so gameplay services need at most a one-line call.
	- Economy(...): LogEconomyEvent. SKU convention "<Kind>:<id>" (Shovel:, Backpack:, Egg:,
	  Shade:, Consumable:, Sell:, Quest:, Code:, Product:) or a bare word (Daily, Rebirth).
	- Custom(player, name, fields): single-step recurring funnel named after the event.
	- Track remote (client -> server): a strict whitelist of UI events (panel opens, purchase
	  prompts, menu unlocks) with argument validation and a per-player rate limit.
	Every AnalyticsService call is pcall'd and runs in its own thread; analytics never breaks
	gameplay.
]]

local AnalyticsService = game:GetService("AnalyticsService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)

local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)
local ServerSignals = require(script.Parent.ServerSignals)
local World = require(script.Parent.Parent.World)

local Analytics = {}

-- Onboarding funnel, in order. Numbers must only ever grow; never renumber a shipped step
-- (append new ones or retire old ones instead). See docs/ANALYTICS.md.
Analytics.Steps = table.freeze({
	Joined = 1,
	AtSand = 2,
	FirstDig = 3,
	BackpackFull = 4,
	FirstSell = 5,
	FirstShovel = 6,
	SecondShovel = 7,
	FirstBackpack = 8,
	Layer2 = 9,
	FirstEgg = 10,
	FirstPet = 11,
	Layer3 = 12,
	FirstShadeOrSnack = 13,
	FirstQuestClaim = 14,
	FirstCrate = 15,
	FirstPetDig = 16,
	Layer5 = 17,
	FirstRebirth = 18,
	-- v3 discovery slice (DiscoveryService)
	FirstFind = 19,
	FirstRareFind = 20, -- Rare or better
	FirstPerfectExcavation = 21,
})

local STEP_NAMES: { [number]: string } = {}
for name: string, number: number in Analytics.Steps :: { [string]: number } do
	STEP_NAMES[number] = name
end
Analytics.StepCount = #STEP_NAMES

-- Layer index -> funnel step (layers 2, 3 and 5 are onboarding milestones).
local LAYER_STEPS: { [number]: number } = {
	[2] = Analytics.Steps.Layer2,
	[3] = Analytics.Steps.Layer3,
	[5] = Analytics.Steps.Layer5,
}

-- Track remote whitelist ---------------------------------------------------------------------

Analytics.TRACK_RATE = 8 -- events per TRACK_WINDOW seconds per player (burst)
Analytics.TRACK_WINDOW = 5

-- Panels the client may report as opened (Panel.new names).
Analytics.TRACK_PANELS = table.freeze({
	Shop = true,
	BeachShop = true,
	Eggs = true,
	Pets = true,
	Index = true,
	Quests = true,
	Rebirth = true,
	Store = true,
	Daily = true,
	Settings = true,
})
-- Panels that sell something: opening one starts a "Shop" funnel session.
local SHOP_PANELS: { [string]: boolean } = { Shop = true, BeachShop = true, Eggs = true, Store = true, Rebirth = true }
-- HUD menu buttons the client may report as unlocked (progressive disclosure).
Analytics.TRACK_MENU = table.freeze({
	Shop = true,
	Beach = true,
	Eggs = true,
	Pets = true,
	Index = true,
	Quests = true,
	Rebirth = true,
	Store = true,
	Daily = true,
})

-- Custom field keys (Enum.AnalyticsCustomFieldKeys.CustomField01..03 by name).
local F1 = "CustomField01"
local F2 = "CustomField02"
local F3 = "CustomField03"
local function fields(a: string?, b: string?, c: string?): { [string]: string }
	local t: { [string]: string } = {}
	if a then
		t[F1] = string.sub(a, 1, 50)
	end
	if b then
		t[F2] = string.sub(b, 1, 50)
	end
	if c then
		t[F3] = string.sub(c, 1, 50)
	end
	return t
end

local function safeCall(fn: () -> ...any)
	task.spawn(function()
		for attempt = 1, 2 do
			local ok, err = pcall(fn)
			if ok then
				return
			end
			if attempt == 2 then
				warn("[Analytics] " .. tostring(err))
			else
				task.wait(1)
			end
		end
	end)
end

-- Onboarding funnel ----------------------------------------------------------------------------

function Analytics.Funnel(player: Player, step: number)
	local name = STEP_NAMES[step]
	local maybeData = DataService.Get(player)
	if not name or not maybeData then
		return
	end
	local data = maybeData :: Types.PlayerData
	local flag = "FTUE_" .. name
	if data.Settings[flag] then
		return
	end
	data.Settings[flag] = true
	DataService.MarkDirty(player, "Settings")
	safeCall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, name)
	end)
end

function Analytics.HasStep(player: Player, step: number): boolean
	local data = DataService.Get(player)
	local name = STEP_NAMES[step]
	return data ~= nil and name ~= nil and data.Settings["FTUE_" .. name] == true
end

-- Progression ---------------------------------------------------------------------------------

-- status "Start" | "Complete". level >= 1.
function Analytics.Progression(
	player: Player,
	path: string,
	status: "Start" | "Complete",
	level: number,
	levelName: string?,
	custom: { [string]: string }?
)
	if level ~= level or level < 1 then
		return
	end
	local lvl = math.floor(level)
	safeCall(function()
		if status == "Start" then
			AnalyticsService:LogProgressionStartEvent(player, path, lvl, levelName, custom)
		else
			AnalyticsService:LogProgressionCompleteEvent(player, path, lvl, levelName, custom)
		end
	end)
end

-- Custom events + the Shop funnel ----------------------------------------------------------------

-- A one-step recurring funnel named after the event (each call = one occurrence).
function Analytics.Custom(player: Player, name: string, a: string?, b: string?, c: string?)
	local custom = fields(a, b, c)
	local session = HttpService:GenerateGUID(false)
	safeCall(function()
		AnalyticsService:LogFunnelStepEvent(player, name, session, 1, name, custom)
	end)
end

-- "Shop" funnel: 1 Opened (a selling panel) -> 2 Prompted (Robux prompt) -> 3 Purchased.
local SHOP_SESSION_SECONDS = 600
local shopSessions: { [Player]: { Id: string, Panel: string, At: number } } = {}

type ShopSession = { Id: string, Panel: string, At: number }

local function shopSession(player: Player, panel: string?): ShopSession
	local existing = shopSessions[player]
	local now = os.clock()
	if existing and now - existing.At <= SHOP_SESSION_SECONDS then
		return existing
	end
	local session: ShopSession = { Id = HttpService:GenerateGUID(false), Panel = panel or "None", At = now }
	shopSessions[player] = session
	return session
end

local function shopStep(
	player: Player,
	step: number,
	stepName: string,
	session: { Id: string, Panel: string },
	key: string?
)
	local custom = fields(session.Panel, key)
	safeCall(function()
		AnalyticsService:LogFunnelStepEvent(player, "Shop", session.Id, step, stepName, custom)
	end)
end

function Analytics.PanelOpened(player: Player, panel: string)
	Analytics.Custom(player, "PanelOpened", panel)
	if SHOP_PANELS[panel] then
		shopSessions[player] = nil
		shopStep(player, 1, "Opened", shopSession(player, panel))
	end
end

-- key: "Pass:<key>" | "Product:<key>"
function Analytics.PurchasePrompted(player: Player, key: string)
	local session = shopSession(player)
	session.At = os.clock()
	shopStep(player, 2, "Prompted", session, key)
end

-- Server-confirmed (receipt granted / pass purchase finished).
function Analytics.PurchaseCompleted(player: Player, key: string)
	local session = shopSession(player)
	shopStep(player, 3, "Purchased", session, key)
	Analytics.Custom(player, "PurchaseCompleted", key)
	shopSessions[player] = nil
end

-- Economy ----------------------------------------------------------------------------------------

-- currency: "Coins" | "Tokens". amount > 0. sku: what was bought / why it was earned.
function Analytics.Economy(
	player: Player,
	flow: Enum.AnalyticsEconomyFlowType,
	currency: string,
	amount: number,
	endingBalance: number,
	transaction: Enum.AnalyticsEconomyTransactionType,
	sku: string?
)
	if amount ~= amount or amount <= 0 or math.abs(amount) == math.huge then
		return
	end
	safeCall(function()
		AnalyticsService:LogEconomyEvent(
			player,
			flow,
			currency,
			math.floor(amount),
			math.floor(endingBalance),
			transaction.Name,
			sku
		)
	end)
end

function Analytics.Source(
	player: Player,
	currency: string,
	amount: number,
	endingBalance: number,
	transaction: Enum.AnalyticsEconomyTransactionType,
	sku: string?
)
	Analytics.Economy(player, Enum.AnalyticsEconomyFlowType.Source, currency, amount, endingBalance, transaction, sku)
	if sku and string.sub(sku, 1, 6) == "Quest:" then
		Analytics.Funnel(player, Analytics.Steps.FirstQuestClaim)
	end
end

function Analytics.Sink(
	player: Player,
	currency: string,
	amount: number,
	endingBalance: number,
	transaction: Enum.AnalyticsEconomyTransactionType,
	sku: string?
)
	Analytics.Economy(player, Enum.AnalyticsEconomyFlowType.Sink, currency, amount, endingBalance, transaction, sku)
	if sku and (string.sub(sku, 1, 6) == "Shade:" or string.sub(sku, 1, 11) == "Consumable:") then
		Analytics.Funnel(player, Analytics.Steps.FirstShadeOrSnack)
	end
end

-- Gameplay hooks ---------------------------------------------------------------------------------

-- PetService.hatch: one call per hatch (eggId, the pet ids rolled).
function Analytics.Hatched(player: Player, eggId: string, petIds: { string })
	local egg = Config.GetEgg(eggId)
	local isCrate = egg ~= nil and egg.Kind == "Crate"
	Analytics.Funnel(player, if isCrate then Analytics.Steps.FirstCrate else Analytics.Steps.FirstEgg)
	for _, petId in petIds do
		local pet = Config.GetPet(petId)
		Analytics.Custom(player, "Hatch", eggId, if pet then pet.Rarity else "Unknown", petId)
	end
end

local function count(t: { [any]: any }?): number
	local n = 0
	if t then
		for _ in t do
			n += 1
		end
	end
	return n
end

local lastLayer: { [Player]: number } = {}

local function onDepthReached(player: Player, maxDepth: number)
	local index = Config.GetLayerIndexAtDepth(maxDepth)
	local previous = lastLayer[player]
	if previous == nil then
		previous = 1
	end
	if index <= previous then
		return
	end
	lastLayer[player] = index
	local data = DataService.Get(player)
	local rebirths = if data then tostring(data.Rebirths) else "0"
	for i = previous + 1, index do
		local layer = Config.Layers[i]
		local prior = Config.Layers[i - 1]
		if prior then
			Analytics.Progression(player, "Layers", "Complete", i - 1, prior.Name, fields(rebirths))
		end
		if layer then
			Analytics.Progression(player, "Layers", "Start", i, layer.Name, fields(rebirths))
		end
		local step = LAYER_STEPS[i]
		if step then
			Analytics.Funnel(player, step)
		end
	end
end

-- Cheap state checks for steps without a dedicated signal (every POLL_SECONDS per player).
local POLL_SECONDS = 3

local function poll(player: Player)
	local maybeData = DataService.Get(player)
	if not maybeData then
		return
	end
	local data = maybeData :: Types.PlayerData
	local steps = Analytics.Steps
	if not Analytics.HasStep(player, steps.AtSand) then
		local root = Net.GetRoot(player)
		if root and World.IsInDigZone(root.Position) then
			Analytics.Funnel(player, steps.AtSand)
		end
	end
	if not Analytics.HasStep(player, steps.FirstPet) then
		for _, pet in data.Pets do
			if pet.Equipped then
				Analytics.Funnel(player, steps.FirstPet)
				break
			end
		end
	end
	if not Analytics.HasStep(player, steps.FirstQuestClaim) then
		for _, quest in data.Quests do
			if quest.Claimed then
				Analytics.Funnel(player, steps.FirstQuestClaim)
				break
			end
		end
	end
	if not Analytics.HasStep(player, steps.FirstShadeOrSnack) and count(data.OwnedShades) > 0 then
		Analytics.Funnel(player, steps.FirstShadeOrSnack)
	end
end

-- Track remote (client -> server UI events) --------------------------------------------------------

-- Returns true when the event was accepted (tests use this).
function Analytics.OnTrack(player: Player, name: any, a: any, b: any): boolean
	if not Net.IsString(name, 32) then
		return false
	end
	if name == "panel_opened" then
		if not Net.IsString(a, 32) or not Analytics.TRACK_PANELS[a] then
			return false
		end
		Analytics.PanelOpened(player, a)
		return true
	elseif name == "purchase_prompted" then
		if not Net.IsString(b, 40) then
			return false
		end
		if a == "GamePass" and Config.Monetization.GamePasses[b] then
			Analytics.PurchasePrompted(player, "Pass:" .. b)
			return true
		elseif a == "Product" and Config.Monetization.Products[b] then
			Analytics.PurchasePrompted(player, "Product:" .. b)
			return true
		end
		return false
	elseif name == "menu_unlocked" then
		if not Net.IsString(a, 16) or not Analytics.TRACK_MENU[a] then
			return false
		end
		Analytics.Custom(player, "MenuUnlocked", a)
		return true
	end
	return false
end

-- Lifecycle ----------------------------------------------------------------------------------------

function Analytics.Init()
	Net.On("Track", function(player: Player, name: any, a: any, b: any)
		Analytics.OnTrack(player, name, a, b)
	end, { Rate = Analytics.TRACK_RATE, Window = Analytics.TRACK_WINDOW })

	ServerSignals.Dug:Connect(function(player: Player, _depth: number, _gained: number, source: string)
		Analytics.Funnel(player, Analytics.Steps.AtSand) -- digging implies standing on the sand
		Analytics.Funnel(player, Analytics.Steps.FirstDig)
		if source == "Pet" then
			Analytics.Funnel(player, Analytics.Steps.FirstPetDig)
		end
	end)
	ServerSignals.BackpackFull:Connect(function(player: Player)
		Analytics.Funnel(player, Analytics.Steps.BackpackFull)
	end)
	ServerSignals.Sold:Connect(function(player: Player)
		Analytics.Funnel(player, Analytics.Steps.FirstSell)
	end)
	ServerSignals.UpgradeBought:Connect(function(player: Player, kind: string)
		local maybeData = DataService.Get(player)
		if not maybeData then
			return
		end
		local data = maybeData :: Types.PlayerData
		if kind == "Shovel" then
			Analytics.Funnel(player, Analytics.Steps.FirstShovel)
			if count(data.OwnedShovels) >= 3 then
				Analytics.Funnel(player, Analytics.Steps.SecondShovel)
			end
		elseif kind == "Backpack" then
			Analytics.Funnel(player, Analytics.Steps.FirstBackpack)
		end
	end)
	ServerSignals.DepthReached:Connect(onDepthReached)
	ServerSignals.Rebirthed:Connect(function(player: Player, rebirths: number)
		Analytics.Funnel(player, Analytics.Steps.FirstRebirth)
		Analytics.Progression(player, "Rebirth", "Complete", rebirths, "Rebirth " .. rebirths)
	end)
end

function Analytics.Start()
	task.spawn(function()
		while true do
			task.wait(POLL_SECONDS)
			for _, player in DataService.GetLoadedPlayers() do
				local ok, err = pcall(function()
					poll(player)
				end)
				if not ok then
					warn("[Analytics] poll: " .. tostring(err))
				end
			end
		end
	end)
end

function Analytics.OnPlayerAdded(player: Player)
	-- Sunburnt / ride starts come from player attributes (SurvivalService / RideService).
	player:GetAttributeChangedSignal("Sunburnt"):Connect(function()
		if player:GetAttribute("Sunburnt") == true then
			local depth = player:GetAttribute("Depth")
			local layer = Config.GetLayerIndexAtDepth(if type(depth) == "number" then depth else 0)
			Analytics.Custom(player, "Sunburnt", tostring(layer))
		end
	end)
	player:GetAttributeChangedSignal("Riding"):Connect(function()
		local riding = player:GetAttribute("Riding")
		if type(riding) == "string" and riding ~= "" then
			Analytics.Custom(player, "RideStarted", riding)
		end
	end)
	task.spawn(function()
		local data = DataService.WaitForData(player, 60)
		if data and player.Parent then
			lastLayer[player] = Config.GetLayerIndexAtDepth(data.MaxDepth)
		end
	end)
end

function Analytics.OnPlayerRemoving(player: Player)
	lastLayer[player] = nil
	shopSessions[player] = nil
end

return Analytics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">BadgeAwardService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BadgeAwardService — awards Roblox badges from Config.Badges when PlayerData crosses a
	milestone (first dig, first pet, reaching a layer, rebirths, a Mythic+ find, a completed
	layer Index, a daily streak). Badges with Id 0 are skipped.
	Each badge is awarded at most once per player per session; BadgeService itself ignores
	repeat awards across sessions. A failed BadgeService call (throttling, outage) is retried
	on the next relevant change after RETRY_DELAYS[n] seconds, up to #RETRY_DELAYS times.
]]

local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)

local DataService = require(script.Parent.DataService)

local BadgeAwardService = {}

local RELEVANT_KEYS =
	{ TotalSandDug = true, Pets = true, MaxDepth = true, Rebirths = true, Index = true, DailyStreak = true }

BadgeAwardService.RETRY_DELAYS = { 30, 120, 600 }

local attempted: { [Player]: { [string]: boolean } } = {}
local failures: { [Player]: { [string]: { Count: number, RetryAt: number } } } = {}

local function layerDepth(name: string?): number?
	for _, layer in Config.Layers do
		if layer.Name == name then
			return layer.DepthStart
		end
	end
	return nil
end

-- Treasures per layer, excluding Relics (matches the Index panel's "x / y found").
local layerTreasures: { [number]: { string } } = {}
for _, treasure in Config.Treasures do
	if treasure.Rarity ~= "Relic" then
		layerTreasures[treasure.Layer] = layerTreasures[treasure.Layer] or {}
		table.insert(layerTreasures[treasure.Layer], treasure.Id)
	end
end

local function rarityOrder(name: string?): number
	local rarity = if name then Config.GetRarity(name) else nil
	return if rarity then rarity.Order else math.huge
end

local function foundRarity(data: Types.PlayerData, minOrder: number): boolean
	for _, treasure in Config.Treasures do
		if data.Index[treasure.Id] and rarityOrder(treasure.Rarity) >= minOrder then
			return true
		end
	end
	return false
end

local function completedAnyLayer(data: Types.PlayerData): boolean
	for _, ids in layerTreasures do
		local all = true
		for _, id in ids do
			if not data.Index[id] then
				all = false
				break
			end
		end
		if all then
			return true
		end
	end
	return false
end

local function earned(badge: any, data: Types.PlayerData): boolean
	if badge.Kind == "FirstDig" then
		return data.TotalSandDug > 0
	elseif badge.Kind == "FirstPet" then
		return next(data.Pets) ~= nil
	elseif badge.Kind == "ReachLayer" then
		local depth = layerDepth(badge.Layer)
		return depth ~= nil and data.MaxDepth >= depth
	elseif badge.Kind == "Rebirth" then
		return data.Rebirths >= (badge.Count or 1)
	elseif badge.Kind == "FindRarity" then
		return foundRarity(data, rarityOrder(badge.Rarity))
	elseif badge.Kind == "CompleteLayer" then
		return completedAnyLayer(data)
	elseif badge.Kind == "DailyStreak" then
		return data.DailyStreak >= (badge.Count or 7)
	end
	return false
end

local function check(player: Player)
	local data = DataService.Get(player)
	local tried = attempted[player]
	local failed = failures[player]
	if not data or not tried or not failed then
		return
	end
	local now = os.clock()
	for _, badge in Config.Badges do
		local failure = failed[badge.Key]
		local waiting = failure ~= nil and now < failure.RetryAt
		if badge.Id ~= 0 and not tried[badge.Key] and not waiting and earned(badge, data :: Types.PlayerData) then
			tried[badge.Key] = true
			task.spawn(function()
				local ok, err = pcall(function()
					if not BadgeService:UserHasBadgeAsync(player.UserId, badge.Id) then
						BadgeService:AwardBadge(player.UserId, badge.Id)
					end
				end)
				if ok then
					if failures[player] then
						failures[player][badge.Key] = nil
					end
					return
				end
				local count = (if failure then failure.Count else 0) + 1
				local delay = BadgeAwardService.RETRY_DELAYS[count]
				warn(
					"[BadgeAwardService] "
						.. badge.Key
						.. ": "
						.. tostring(err)
						.. (if delay then " (retrying in " .. delay .. " s)" else " (giving up this session)")
				)
				if delay and attempted[player] and failures[player] then
					attempted[player][badge.Key] = nil
					failures[player][badge.Key] = { Count = count, RetryAt = os.clock() + delay }
				end
			end)
		end
	end
end

function BadgeAwardService.OnPlayerAdded(player: Player)
	attempted[player] = {}
	failures[player] = {}
end

function BadgeAwardService.OnPlayerRemoving(player: Player)
	attempted[player] = nil
	failures[player] = nil
end

function BadgeAwardService.Start()
	DataService.PlayerLoaded:Connect(function(player: Player)
		attempted[player] = attempted[player] or {}
		failures[player] = failures[player] or {}
		check(player)
	end)
	DataService.Changed:Connect(function(player: Player, keys: { string })
		for _, key in keys do
			if RELEVANT_KEYS[key] then
				check(player)
				return
			end
		end
	end)
	for _, player in Players:GetPlayers() do
		attempted[player] = attempted[player] or {}
		failures[player] = failures[player] or {}
		check(player)
	end
end

return BadgeAwardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">BeachService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BeachService — the shared open beach (replaces v1 PlotService). See docs/V2.md.

	- Spawning: every character (re)spawns on the boardwalk (World.GetSpawnCFrame), facing the
	  sand. There are no plots, so there is no join queue (Config.MAX_PLAYERS = 16).
	- ReturnToSurface(): teleports to World.GetSurfacePoint(near the character) (cooldown).
	- Depth: every DEPTH_TICK the character's feet depth is published as the Player attribute
	  "Depth" (studs below the surface; 0 outside the dig zone or above the surface).
	- MaxDepth anti-cheat: depth only counts where terrain was actually dug. Dug terrain is
	  tracked on a coarse grid of CELL x CELL stud columns ("cells") with the deepest dug point;
	  standing depth is capped at the deepest dug point of the cell under the feet.
	- Tide: a cell refills (bottom-up, layer materials, throttled per frame) once no player was
	  within Config.TIDE_CLEAR_RADIUS studs (horizontally) for Config.TIDE_REFILL_SECONDS.
	  High Tide (workspace attribute ActiveEvents contains "HighTide") lifts everyone standing
	  in a dug column to the surface and then smooths every dug cell. Never buries a player:
	  anyone inside a column is lifted out before each refill step.

	Public API:
		BeachService.TeleportToSurface(player)
		BeachService.RecordCarve(min: Vector3, max: Vector3)   -- DigService after every carve
		BeachService.ReportDig(player, depth): (newRecord, newLayer)
		BeachService.GetCurrentDepth(player): number
		BeachService.GetDugDepthAt(position): number   -- deepest dug point of that cell (studs)
		BeachService.CountDugCells(): number
		BeachService.TideStep(force: boolean?)          -- one tide pass now (tests / dev)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)

local World = require(script.Parent.Parent.World)
local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)
local Analytics = require(script.Parent.Analytics)
local ServerSignals = require(script.Parent.ServerSignals)

local RETURN_COOLDOWN = 3
local DEPTH_TICK = 0.5
local TIDE_TICK = 1
local CELL = 8 -- tide / anti-cheat grid (studs); dig zone edges are multiples of this
local CHUNK = 128 -- studs of column refilled per FillBlock step
local VOXELS_PER_FRAME = 4096 -- refill budget before yielding a frame
local LIFT_MARGIN = 3 -- studs around a column that still count as "inside" it
local DEPTH_SLACK = 4 -- standing depth may exceed the deepest dug point by this much

local S = Config.SURFACE_Y
local BOTTOM_Y = S - Config.TOTAL_DEPTH

type Cell = {
	CX: number,
	CZ: number,
	Deepest: number, -- studs below the surface of the deepest carve in this column
	LastActive: number, -- os.clock() of the last dig in / player near this column
	Version: number, -- bumped by every carve (a refill in progress notices new digs)
}

local BeachService = {}

local cells: { [number]: Cell } = {}
local lastReturn: { [Player]: number } = {}
local currentDepth: { [Player]: number } = {}
local highTidePending = false
local highTideActive = false
local tideBusy = false

local function cellKey(cx: number, cz: number): number
	return (cx + 4096) * 8192 + (cz + 4096)
end

local function cellAt(position: Vector3): Cell?
	return cells[cellKey(math.floor(position.X / CELL), math.floor(position.Z / CELL))]
end

-- Horizontal distance from `pos` to the cell's rectangle (0 inside).
local function cellDistance(cell: Cell, pos: Vector3): number
	local x0, z0 = cell.CX * CELL, cell.CZ * CELL
	local dx = math.max(x0 - pos.X, 0, pos.X - (x0 + CELL))
	local dz = math.max(z0 - pos.Z, 0, pos.Z - (z0 + CELL))
	return math.sqrt(dx * dx + dz * dz)
end

local function getRoots(): { BasePart }
	local roots = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			table.insert(roots, root)
		end
	end
	return roots
end

local function liftRoot(root: BasePart)
	local character = root.Parent
	if character and character:IsA("Model") then
		character:PivotTo(World.GetSurfacePoint(root.Position))
	end
end

-- Lift anyone whose character is inside the column (below the surface).
local function liftFromCell(cell: Cell)
	for _, root in getRoots() do
		if root.Position.Y < S + 1 and cellDistance(cell, root.Position) <= LIFT_MARGIN then
			liftRoot(root)
		end
	end
end

local function anyoneNear(cell: Cell, radius: number): boolean
	for _, root in getRoots() do
		if cellDistance(cell, root.Position) <= radius then
			return true
		end
	end
	return false
end

-- Refill one cell bottom-up. Normal tide aborts as soon as someone comes near or digs in it;
-- `force` (High Tide) lifts people out and carries on. Returns true when the cell is solid.
-- Return a value so strict pcall typing includes its failure result as well.
local function fillLayeredForProfile(minV: Vector3, maxV: Vector3): boolean
	World.FillLayered(minV, maxV)
	return true
end

local function refillCell(cell: Cell, force: boolean): boolean
	local key = cellKey(cell.CX, cell.CZ)
	local x0, z0 = cell.CX * CELL, cell.CZ * CELL
	local version = cell.Version
	local y = math.max(BOTTOM_Y, math.floor((S - cell.Deepest) / 4) * 4 - 4)
	local budget = VOXELS_PER_FRAME
	while y < S do
		if cells[key] ~= cell then
			return false
		end
		if not force and (cell.Version ~= version or anyoneNear(cell, Config.TIDE_CLEAR_RADIUS)) then
			cell.LastActive = os.clock()
			return false
		end
		liftFromCell(cell)
		local top = math.min(S, y + CHUNK)
		debug.profilebegin("DigTheBeach.Tide.FillChunk")
		local ok, err = pcall(fillLayeredForProfile, Vector3.new(x0, y, z0), Vector3.new(x0 + CELL, top, z0 + CELL))
		debug.profileend()
		if not ok then
			error(err, 0)
		end
		if cell.Version == version then
			cell.Deepest = math.max(0, S - top)
		end
		budget -= (CELL / 4) * (CELL / 4) * ((top - y) / 4)
		y = top
		if budget <= 0 then
			budget = VOXELS_PER_FRAME
			task.wait()
		end
	end
	if cell.Version ~= version then
		return false -- dug again while refilling (High Tide): keep it for the next pass
	end
	if cells[key] == cell then
		cells[key] = nil
	end
	return true
end

local function inDugColumn(pos: Vector3): boolean
	if pos.Y >= S + 1 or not World.IsInDigZone(pos) then
		return false
	end
	for dx = -1, 1 do
		for dz = -1, 1 do
			local cell = cells[cellKey(math.floor(pos.X / CELL) + dx, math.floor(pos.Z / CELL) + dz)]
			if cell and cell.Deepest > 0 and cellDistance(cell, pos) <= LIFT_MARGIN then
				return true
			end
		end
	end
	return false
end

local function liftAllFromHoles()
	for _, root in getRoots() do
		if inDugColumn(root.Position) then
			liftRoot(root)
		end
	end
end

function BeachService.TideStep(force: boolean?)
	if tideBusy then
		return
	end
	tideBusy = true
	local now = os.clock()
	local roots = getRoots()
	local smoothing = force == true or highTidePending
	highTidePending = false
	if smoothing then
		liftAllFromHoles()
	end
	local due: { Cell } = {}
	for _, cell in cells do
		if not smoothing then
			for _, root in roots do
				if cellDistance(cell, root.Position) <= Config.TIDE_CLEAR_RADIUS then
					cell.LastActive = now
					break
				end
			end
		end
		if smoothing or now - cell.LastActive >= Config.TIDE_REFILL_SECONDS then
			table.insert(due, cell)
		end
	end
	for _, cell in due do
		local ok, err = pcall(refillCell, cell, smoothing)
		if not ok then
			warn("[BeachService] tide refill failed: " .. tostring(err))
		end
	end
	tideBusy = false
end

-- Depth -----------------------------------------------------------------------------------------

local function updateMaxDepth(player: Player, depth: number): (boolean, boolean)
	local maybeData = DataService.Get(player)
	if not maybeData then
		return false, false
	end
	local data = maybeData :: Types.PlayerData
	local newDepth = math.floor(math.clamp(depth, 0, Config.TOTAL_DEPTH))
	if newDepth <= data.MaxDepth then
		return false, false
	end
	local oldLayer = Config.GetLayerIndexAtDepth(data.MaxDepth)
	local newLayer = Config.GetLayerIndexAtDepth(newDepth)
	DataService.Set(player, "MaxDepth", newDepth)
	ServerSignals.DepthReached:Fire(player, newDepth)
	return true, newLayer > oldLayer
end

local function measureDepth(player: Player): (number, Vector3?)
	local maybeRoot = Net.GetRoot(player)
	if not maybeRoot then
		return 0, nil
	end
	local root = maybeRoot :: BasePart
	local character = root.Parent
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hip = if humanoid then humanoid.HipHeight else 2
	local feet = root.Position - Vector3.new(0, root.Size.Y / 2 + hip, 0)
	if not World.IsInDigZone(feet) then
		return 0, feet
	end
	return math.clamp(S - feet.Y, 0, Config.TOTAL_DEPTH), feet
end

local function depthTick()
	for _, player in Players:GetPlayers() do
		local depth, feet = measureDepth(player)
		currentDepth[player] = depth
		local rounded = math.floor(depth)
		if player:GetAttribute("Depth") ~= rounded then
			player:SetAttribute("Depth", rounded)
		end
		if feet and depth > 0 then
			-- Record only what the dug terrain allows (anti fly / noclip).
			local cell = cellAt(feet)
			local dug = if cell then cell.Deepest + DEPTH_SLACK else 0
			updateMaxDepth(player, math.min(depth, dug))
		end
	end
end

-- Public API ------------------------------------------------------------------------------------

function BeachService.GetCurrentDepth(player: Player): number
	return currentDepth[player] or 0
end

function BeachService.TeleportToSurface(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local model = character :: Model
	local root = model:FindFirstChild("HumanoidRootPart")
	local near = if root and root:IsA("BasePart") then root.Position else model:GetPivot().Position
	model:PivotTo(World.GetSurfacePoint(near))
end

-- Called after every carve (DigService, dev commands): marks the overlapped cells as dug.
function BeachService.RecordCarve(minV: Vector3, maxV: Vector3)
	local now = os.clock()
	local deepest = math.clamp(S - minV.Y, 0, Config.TOTAL_DEPTH)
	for cx = math.floor(minV.X / CELL), math.ceil(maxV.X / CELL) - 1 do
		for cz = math.floor(minV.Z / CELL), math.ceil(maxV.Z / CELL) - 1 do
			local key = cellKey(cx, cz)
			local cell = cells[key]
			if not cell then
				cell = { CX = cx, CZ = cz, Deepest = 0, LastActive = now, Version = 0 }
				cells[key] = cell
			end
			local c = cell :: Cell
			c.Deepest = math.max(c.Deepest, deepest)
			c.LastActive = now
			c.Version += 1
		end
	end
end

-- After a successful dig at `depth` studs. Returns (newMaxDepthRecord, reachedNewLayer).
function BeachService.ReportDig(player: Player, depth: number): (boolean, boolean)
	return updateMaxDepth(player, depth)
end

function BeachService.GetDugDepthAt(position: Vector3): number
	local cell = cellAt(position)
	return if cell then cell.Deepest else 0
end

function BeachService.CountDugCells(): number
	local n = 0
	for _ in cells do
		n += 1
	end
	return n
end

-- Lifecycle -------------------------------------------------------------------------------------

local function hasHighTide(): boolean
	local raw = Workspace:GetAttribute("ActiveEvents")
	if typeof(raw) ~= "string" then
		return false
	end
	for id in string.gmatch(raw, "[^,%s]+") do
		if id == "HighTide" then
			return true
		end
	end
	return false
end

function BeachService.Init()
	Net.On("ReturnToSurface", function(player: Player)
		local now = os.clock()
		local last = lastReturn[player]
		if last and now - last < RETURN_COOLDOWN then
			Net.NotifyThrottled(player, "Error", "Wait a moment...", "ReturnCooldown", 1)
			return
		end
		lastReturn[player] = now
		BeachService.TeleportToSurface(player)
	end, { Rate = 3, Window = 1, RequireData = false })

	highTideActive = hasHighTide()
	Workspace:GetAttributeChangedSignal("ActiveEvents"):Connect(function()
		local active = hasHighTide()
		if active and not highTideActive then
			highTidePending = true
			liftAllFromHoles() -- lift first, the smoothing pass follows within a tick
		end
		highTideActive = active
	end)
end

function BeachService.Start()
	task.spawn(function()
		while true do
			task.wait(DEPTH_TICK)
			depthTick()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(TIDE_TICK)
			local ok, err = pcall(function(): boolean
				BeachService.TideStep(false)
				return true
			end)
			if not ok then
				tideBusy = false
				warn("[BeachService] tide error: " .. tostring(err))
			end
		end
	end)
end

function BeachService.OnPlayerAdded(player: Player)
	player:SetAttribute("Depth", 0)
	local function onCharacter(character: Model)
		task.defer(function()
			character:WaitForChild("HumanoidRootPart", 5)
			if character.Parent and player.Character == character then
				character:PivotTo(World.GetSpawnCFrame())
			end
		end)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end

	task.spawn(function()
		if DataService.WaitForData(player, 60) then
			Analytics.Funnel(player, Analytics.Steps.Joined)
		end
	end)
end

function BeachService.OnPlayerRemoving(player: Player)
	lastReturn[player] = nil
	currentDepth[player] = nil
end

return BeachService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService — session-locked player persistence + client replication.

	Storage record (DataStore Config.DATASTORE_NAME, key "Player_<UserId>"):
		{ Data = PlayerData, Lock = { Owner = <session id>, Time = unix }?, SavedAt = unix }
	- Load takes the lock with UpdateAsync. A lock held by another live server is respected
	  (retry with backoff, then kick); a lock older than Config.SESSION_LOCK_SECONDS is stolen.
	- Every save refreshes the lock; the final save on leave releases it. A save that finds the
	  lock owned by someone else aborts (the other server owns the truth now).
	- Studio without API access: in-memory store (warns once).

	Replication: every mutation marks top-level keys dirty; once per resumption cycle the service
	fires DataChanged(delta) with delta = { [TopLevelKey] = <full current value of that key> }.
	The first DataChanged after load is the full PlayerData. Clients just merge top-level keys.

	Public API:
		DataService.Get(player): PlayerData?
		DataService.IsLoaded(player): boolean
		DataService.WaitForData(player, timeout?): PlayerData?
		DataService.Update(player, key, fn(old) -> new): any
		DataService.Set(player, key, value)
		DataService.Increment(player, key, amount): number
		DataService.Mutate(player, keys, fn(data))   -- in-place edit of several keys
		DataService.MarkDirty(player, ...keys)
		DataService.SaveAsync(player): boolean
		DataService.IsMock(): boolean
		DataService.PlayerLoaded: Signal<Player, PlayerData>
		DataService.Changed: Signal<Player, { string }>  (batched keys, after replication)
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Remotes = require(Shared.Remotes)
local Format = require(Shared.Util.Format)
local Signal = require(Shared.Util.Signal)
local TableUtil = require(Shared.Util.TableUtil)

type PlayerData = Types.PlayerData

type Session = {
	Player: Player,
	Key: string,
	Data: PlayerData,
	Dirty: { [string]: boolean },
	FlushScheduled: boolean,
	Released: boolean,
	Saving: boolean,
	Leaderstats: {
		Coins: StringValue,
		Depth: IntValue,
		Rebirths: IntValue,
	}?,
}

local LOAD_ATTEMPTS = 6
local SAVE_ATTEMPTS = 4
local SHUTDOWN_TIMEOUT = 25

local DataService = {}

DataService.PlayerLoaded = Signal.new() :: Signal.Signal<Player, PlayerData>
DataService.Changed = Signal.new() :: Signal.Signal<Player, { string }>

local SESSION_ID = (if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false))
	.. ":"
	.. tostring(os.time())

local store: DataStore? = nil
local useMock = false
local mockStore: { [string]: any } = {}

local sessions: { [Player]: Session } = {}
local releasing: { [number]: boolean } = {} -- userId -> final save in flight
local activeSaves = 0
local shuttingDown = false

-- v1 -> v2 (v2.1 companions merge): every owned Garage digger becomes ONE vehicle pet with the
-- same id (Config/Pets.luau keeps the old digger ids). Upgrade levels do not carry over (pets have
-- no levels). A digger that was equipped is equipped as a pet while the save's base PetSlots
-- allow (pass slots are unknown at load; PetService trims/fills later). Converted pets may push
-- the inventory over PET_INVENTORY_LIMIT: nothing a player bought is lost. data.Diggers is
-- emptied (the field stays so old code paths and Reconcile see a table).
local function migrateDiggersToPets(data: { [string]: any })
	local diggers = data.Diggers
	if type(diggers) ~= "table" then
		data.Diggers = {}
		return
	end
	if type(data.Pets) ~= "table" then
		data.Pets = {}
	end
	local pets = data.Pets :: { [string]: any }
	local slots = if type(data.PetSlots) == "number" then data.PetSlots else Config.MAX_EQUIPPED_PETS
	local equipped = 0
	for _, pet in pets do
		if type(pet) == "table" and pet.Equipped == true then
			equipped += 1
		end
	end
	-- most valuable first (Config order = crate order = old Garage price order), so the best
	-- converted vehicles get the free equip slots
	local ids = {}
	for id in diggers do
		if type(id) == "string" and Config.GetPet(id) and Config.GetPetDig(id) then
			table.insert(ids, id)
		end
	end
	local order: { [string]: number } = {}
	for i, def in Config.Pets do
		order[def.Id] = i
	end
	table.sort(ids, function(a: string, b: string): boolean
		return order[a] > order[b]
	end)
	for _, id in ids do
		local inst = diggers[id]
		local wasEquipped = type(inst) == "table" and inst.Equipped == true
		local equip = wasEquipped and equipped < slots
		if equip then
			equipped += 1
		end
		pets[HttpService:GenerateGUID(false)] = { Id = id, Equipped = equip }
	end
	data.Diggers = {}
end

-- v2 -> v3 (discovery slice): unsold treasures (data.Treasures, id -> count) become plain finds
-- (Normal size, no material, Good quality = exactly the old SellValue each), and every treasure
-- already in the Index gets its default variants (Normal, None) ticked in FindVariants.
-- data.Treasures is emptied (the field stays for Reconcile / old code paths).
local function migrateTreasuresToFinds(data: { [string]: any })
	local finds = if type(data.Finds) == "table" then data.Finds else {}
	data.Finds = finds
	local variants = if type(data.FindVariants) == "table" then data.FindVariants else {}
	data.FindVariants = variants
	if type(data.Treasures) == "table" then
		for id, count in data.Treasures do
			if type(id) == "string" and Config.GetTreasure(id) and type(count) == "number" and count >= 1 then
				local key = id .. "|Normal|None|Good"
				finds[key] = (if type(finds[key]) == "number" then finds[key] else 0) + math.floor(count)
			end
		end
	end
	data.Treasures = {}
	if type(data.Index) == "table" then
		for id, found in data.Index do
			if type(id) == "string" and found == true and Config.GetTreasure(id) then
				variants[id .. "/Normal"] = true
				variants[id .. "/None"] = true
			end
		end
	end
end

-- Migrations: MIGRATIONS[v] upgrades a save from version v to v + 1.
local MIGRATIONS: { [number]: (data: { [string]: any }) -> ...any } = {
	[1] = migrateDiggersToPets,
	[2] = migrateTreasuresToFinds,
}

DataService._MigrateDiggersToPets = migrateDiggersToPets -- tests
DataService._MigrateTreasuresToFinds = migrateTreasuresToFinds -- tests

local dataChanged: RemoteEvent
local getDataFunction: RemoteFunction

-- Helpers ---------------------------------------------------------------------------------------

local function keyFor(userId: number): string
	return "Player_" .. tostring(userId)
end

local function backoff(attempt: number): number
	return math.min(2 ^ attempt, 15) + math.random()
end

local function migrate(raw: { [string]: any }): { [string]: any }
	local version = if type(raw.Version) == "number" then raw.Version else 0
	while version < Config.DATA_VERSION do
		local step = MIGRATIONS[version]
		if step then
			local ok, err = pcall(step, raw)
			if not ok then
				warn(string.format("[DataService] migration %d failed: %s", version, tostring(err)))
			end
		end
		version += 1
	end
	raw.Version = math.max(version, Config.DATA_VERSION)
	return raw
end

-- Make a loaded save safe to use: fill missing fields, repair invalid equipment refs.
local function sanitize(raw: any): PlayerData
	local template = Config.NewPlayerData()
	if type(raw) ~= "table" then
		return template
	end
	migrate(raw)
	TableUtil.Reconcile(raw, template :: any)
	local data = raw :: PlayerData

	if not Config.GetShovel(data.Shovel) or not data.OwnedShovels[data.Shovel] then
		data.Shovel = template.Shovel
	end
	if not Config.GetBackpack(data.Backpack) or not data.OwnedBackpacks[data.Backpack] then
		data.Backpack = template.Backpack
	end
	for uid, pet in data.Pets do
		if type(pet) ~= "table" or type(pet.Id) ~= "string" or not Config.GetPet(pet.Id) then
			data.Pets[uid] = nil
		elseif type(pet.Equipped) ~= "boolean" then
			pet.Equipped = false
		end
	end
	for _, field in { "Coins", "Sand", "TotalSandDug", "RebirthTokens", "MaxDepth" } do
		local value = (data :: any)[field]
		if value < 0 then
			(data :: any)[field] = 0
		end
	end
	data.Rebirths = math.max(0, math.floor(data.Rebirths))
	return data
end

-- Leaderstats -----------------------------------------------------------------------------------

local function createLeaderstats(session: Session)
	local player = session.Player
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	local coins = Instance.new("StringValue")
	coins.Name = "Coins"
	coins.Parent = folder

	local depth = Instance.new("IntValue")
	depth.Name = "Depth"
	depth.Parent = folder

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = folder

	session.Leaderstats = { Coins = coins, Depth = depth, Rebirths = rebirths }
	folder.Parent = player
end

local function updateLeaderstats(session: Session)
	local stats = session.Leaderstats
	if not stats then
		return
	end
	local values = stats :: { Coins: StringValue, Depth: IntValue, Rebirths: IntValue }
	local data = session.Data
	values.Coins.Value = Format.Abbreviate(data.Coins)
	values.Depth.Value = Config.DepthToMeters(data.MaxDepth)
	values.Rebirths.Value = data.Rebirths
end

-- Replication -----------------------------------------------------------------------------------

local function flush(session: Session)
	session.FlushScheduled = false
	local delta: { [string]: any } = {}
	local keys: { string } = {}
	for key in session.Dirty do
		delta[key] = (session.Data :: any)[key]
		table.insert(keys, key)
	end
	table.clear(session.Dirty)
	if #keys == 0 then
		return
	end
	if session.Player.Parent and sessions[session.Player] == session then
		dataChanged:FireClient(session.Player, delta)
	end
	if delta.Coins ~= nil or delta.MaxDepth ~= nil or delta.Rebirths ~= nil then
		updateLeaderstats(session)
	end
	DataService.Changed:Fire(session.Player, keys)
end

local function markDirty(session: Session, key: string)
	session.Dirty[key] = true
	if not session.FlushScheduled then
		session.FlushScheduled = true
		task.defer(flush, session)
	end
end

-- Storage ---------------------------------------------------------------------------------------

local function detectStore()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if not ok then
		useMock = RunService:IsStudio()
		warn(
			"[DataService] DataStores unavailable ("
				.. tostring(result)
				.. (if useMock then "); using in-memory data." else "); refusing player loads.")
		)
		return
	end
	if RunService:IsStudio() then
		local probeOk, err = pcall(function()
			return (result :: DataStore):GetAsync("__probe")
		end)
		if not probeOk then
			useMock = true
			warn("[DataService] Studio has no DataStore access (" .. tostring(err) .. "); using in-memory data.")
			return
		end
	end
	store = result
end

-- Returns (data, failReason). failReason is "locked" or "error" when data is nil.
local function loadAsync(player: Player): (PlayerData?, string?)
	local key = keyFor(player.UserId)
	if useMock then
		return sanitize(TableUtil.DeepCopy(mockStore[key])), nil
	end
	if not store then
		return nil, "error"
	end
	local dataStore = store :: DataStore
	local lastReason = "error"
	for attempt = 1, LOAD_ATTEMPTS do
		local lockedBy: string? = nil
		local ok, result = pcall(function()
			return dataStore:UpdateAsync(key, function(old: any)
				lockedBy = nil
				local record = if type(old) == "table" then old else {}
				local lock = record.Lock
				local now = os.time()
				if
					type(lock) == "table"
					and lock.Owner ~= SESSION_ID
					and type(lock.Time) == "number"
					and now - lock.Time < Config.SESSION_LOCK_SECONDS
				then
					lockedBy = tostring(lock.Owner)
					return nil -- abort: another live server owns this save
				end
				record.Lock = { Owner = SESSION_ID, Time = now }
				return record, { player.UserId }
			end)
		end)
		if ok and lockedBy == nil and type(result) == "table" then
			return sanitize(result.Data), nil
		elseif ok then
			lastReason = "locked"
		else
			lastReason = "error"
			warn(string.format("[DataService] load %s attempt %d failed: %s", key, attempt, tostring(result)))
		end
		if player.Parent == nil then
			return nil, "left"
		end
		task.wait(backoff(attempt))
	end
	return nil, lastReason
end

-- Writes the session's data. Returns false if the write failed or the lock was stolen.
local function saveAsync(session: Session, release: boolean): boolean
	-- UpdateAsync yields. Serialize snapshots and writes so an old autosave cannot
	-- overwrite the final save or recreate its released lock after the player leaves.
	while session.Saving do
		task.wait(0.05)
	end
	if session.Released and not release then
		return false
	end
	session.Saving = true
	local payload = TableUtil.DeepCopy(session.Data)
	if useMock then
		mockStore[session.Key] = payload
		session.Saving = false
		return true
	end
	if not store then
		session.Saving = false
		return false
	end
	local dataStore = store :: DataStore
	activeSaves += 1
	local success = false
	for attempt = 1, SAVE_ATTEMPTS do
		local stolen = false
		local ok, err = pcall(function()
			dataStore:UpdateAsync(session.Key, function(old: any)
				stolen = false
				local record = if type(old) == "table" then old else {}
				local lock = record.Lock
				if type(lock) == "table" and lock.Owner ~= SESSION_ID then
					stolen = true
					return nil
				end
				record.Data = payload
				record.SavedAt = os.time()
				record.Lock = if release then nil else { Owner = SESSION_ID, Time = os.time() }
				return record, { session.Player.UserId }
			end)
		end)
		if ok then
			if stolen then
				warn("[DataService] session lock for " .. session.Key .. " was taken by another server; not saving")
				if not release and session.Player.Parent then
					session.Player:Kick("Your data was opened on another server. Please rejoin.")
				end
			else
				success = true
			end
			break
		end
		warn(string.format("[DataService] save %s attempt %d failed: %s", session.Key, attempt, tostring(err)))
		if attempt < SAVE_ATTEMPTS then
			task.wait(if shuttingDown then 1 else backoff(attempt))
		end
	end
	activeSaves -= 1
	session.Saving = false
	return success
end

local function release(player: Player)
	local session = sessions[player]
	if not session or session.Released then
		return
	end
	session.Released = true
	sessions[player] = nil
	releasing[player.UserId] = true
	saveAsync(session, true)
	releasing[player.UserId] = nil
end

-- Lifecycle -------------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	-- Same-server rejoin while the previous session is still saving: wait for it.
	local waitUntil = os.clock() + 30
	while releasing[player.UserId] and os.clock() < waitUntil do
		task.wait(0.25)
	end
	if releasing[player.UserId] then
		if player.Parent then
			player:Kick("Your previous session is still saving. Please rejoin in a minute!")
		end
		return
	end

	local data, reason = loadAsync(player)
	if not data then
		if reason ~= "left" and player.Parent then
			player:Kick(
				if reason == "locked"
					then "Your save is still in use by another server. Please rejoin in a minute!"
					else "We couldn't load your save (Roblox data servers are busy). Please rejoin!"
			)
		end
		return
	end
	local loaded = data :: PlayerData

	local session: Session = {
		Player = player,
		Key = keyFor(player.UserId),
		Data = loaded,
		Dirty = {},
		FlushScheduled = false,
		Released = false,
		Saving = false,
		Leaderstats = nil,
	}

	if player.Parent == nil then
		-- Left while loading: give the lock back without keeping a session.
		releasing[player.UserId] = true
		saveAsync(session, true)
		releasing[player.UserId] = nil
		return
	end

	sessions[player] = session
	createLeaderstats(session)
	updateLeaderstats(session)
	dataChanged:FireClient(player, loaded)
	DataService.PlayerLoaded:Fire(player, loaded)
end

-- Public API ------------------------------------------------------------------------------------

function DataService.Get(player: Player): PlayerData?
	local session = sessions[player]
	return if session then session.Data else nil
end

function DataService.IsLoaded(player: Player): boolean
	return sessions[player] ~= nil
end

function DataService.IsMock(): boolean
	return useMock
end

function DataService.WaitForData(player: Player, timeout: number?): PlayerData?
	local deadline = os.clock() + (timeout or 30)
	while player.Parent and os.clock() < deadline do
		local session = sessions[player]
		if session then
			return session.Data
		end
		task.wait(0.1)
	end
	local session = sessions[player]
	return if session then session.Data else nil
end

function DataService.MarkDirty(player: Player, ...: string)
	local session = sessions[player]
	if not session then
		return
	end
	for i = 1, select("#", ...) do
		markDirty(session, (select(i, ...)))
	end
end

function DataService.Update(player: Player, key: string, fn: (any) -> any): any
	local session = sessions[player]
	if not session then
		return nil
	end
	local data = session.Data :: any
	local value = fn(data[key])
	data[key] = value
	markDirty(session, key)
	return value
end

function DataService.Set(player: Player, key: string, value: any)
	DataService.Update(player, key, function()
		return value
	end)
end

-- Adds `amount` to a numeric field (never below 0). Returns the new value.
function DataService.Increment(player: Player, key: string, amount: number): number
	if amount ~= amount or math.abs(amount) == math.huge then
		return DataService.Get(player) and (DataService.Get(player) :: any)[key] or 0
	end
	return DataService.Update(player, key, function(old: any)
		local current = if type(old) == "number" then old else 0
		return math.max(0, current + amount)
	end) or 0
end

-- In-place edit of several keys at once: DataService.Mutate(player, {"Coins","Sand"}, function(d) ... end)
function DataService.Mutate(player: Player, keys: { string }, fn: (PlayerData) -> ()): boolean
	local session = sessions[player]
	if not session then
		return false
	end
	fn(session.Data)
	for _, key in keys do
		markDirty(session, key)
	end
	return true
end

function DataService.SaveAsync(player: Player): boolean
	local session = sessions[player]
	if not session then
		return false
	end
	return saveAsync(session, false)
end

-- Service lifecycle -----------------------------------------------------------------------------

function DataService.Init()
	dataChanged = Remotes.Get("DataChanged")
	getDataFunction = Remotes.GetFunction("GetData")
	detectStore()

	getDataFunction.OnServerInvoke = function(player: Player): any
		return DataService.WaitForData(player, 20)
	end
end

function DataService.Start()
	-- Autosave: each player every AUTOSAVE_SECONDS, staggered across the interval.
	task.spawn(function()
		while true do
			local list = {}
			for player in sessions do
				table.insert(list, player)
			end
			local gap = Config.AUTOSAVE_SECONDS / math.max(#list, 1)
			for _, player in list do
				local session = sessions[player]
				if session and not session.Released then
					task.spawn(saveAsync, session, false)
				end
				task.wait(gap)
			end
			if #list == 0 then
				task.wait(Config.AUTOSAVE_SECONDS)
			end
		end
	end)

	game:BindToClose(function()
		shuttingDown = true
		local pending = 0
		for player in sessions do
			pending += 1
			task.spawn(function()
				release(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + SHUTDOWN_TIMEOUT
		while (pending > 0 or activeSaves > 0) and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

function DataService.OnPlayerAdded(player: Player)
	task.spawn(onPlayerAdded, player)
end

function DataService.OnPlayerRemoving(player: Player)
	task.spawn(release, player)
end

-- For other services: all currently loaded players.
function DataService.GetLoadedPlayers(): { Player }
	local list = {}
	for player in sessions do
		table.insert(list, player)
	end
	return list
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">DevCommands</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DevCommands — chat commands for playtesting. Only active in Roblox Studio; does nothing in
	live servers.

		/coins <n>     add coins
		/max           own and equip the best shovel and backpack, plus lots of coins
		/dig <depth>   carve a shaft at your position (inside the dig zone) down to <depth> studs
		               and drop you at the bottom
		/rebirths <n>  set your rebirth count
		/wipe          reset your save to a brand-new player (replays the tutorial)
		/surface       return to the surface (boardwalk)
		/tide          run the tide now: refill every dug column (like High Tide)
		/stress [n] [fx] | /stress stop   v2.3 load test: n digging bots + pets (docs/PERFORMANCE.md)
]]

local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)
local BeachService = require(script.Parent.BeachService)
local PetService = require(script.Parent.PetService)
local ShopService = require(script.Parent.ShopService)
local World = require(script.Parent.Parent.World)
-- v2.3 /stress
local Types = require(ReplicatedStorage.Shared.Types)
local Stats = require(ReplicatedStorage.Shared.Util.Stats)
local Models = require(ReplicatedStorage.Shared.Models)
local DigService = require(script.Parent.DigService)
local MultiplierService = require(script.Parent.MultiplierService)

local DevCommands = {}

local SHAFT_WIDTH = 12

local function number(arg: string?): number?
	local n = tonumber(arg or "")
	if n and n == n and math.abs(n) ~= math.huge then
		return n
	end
	return nil
end

local handlers: { [string]: (Player, { string }) -> () } = {}

handlers["/coins"] = function(player, args)
	local amount = number(args[1]) or 1e6
	DataService.Increment(player, "Coins", amount)
	Net.Notify(player, "Success", "[Dev] +" .. tostring(amount) .. " coins")
end

handlers["/max"] = function(player)
	local bestShovel = Config.Shovels[#Config.Shovels].Id
	local bestBackpack = Config.Backpacks[#Config.Backpacks].Id
	DataService.Mutate(player, { "OwnedShovels", "OwnedBackpacks", "Coins" }, function(data)
		for _, def in Config.Shovels do
			data.OwnedShovels[def.Id] = true
		end
		for _, def in Config.Backpacks do
			data.OwnedBackpacks[def.Id] = true
		end
		data.Coins = math.max(data.Coins, 1e15)
	end)
	ShopService.Equip(player, "Shovel", bestShovel)
	ShopService.Equip(player, "Backpack", bestBackpack)
	Net.Notify(player, "Success", "[Dev] Best gear unlocked")
end

handlers["/dig"] = function(player, args)
	local character = player.Character
	if not character then
		Net.Notify(player, "Error", "[Dev] No character yet")
		return
	end
	assert(character) -- refine for the type checker (guarded above)
	local zone = World.GetDigZone()
	local depth = math.clamp(number(args[1]) or 100, 8, zone.Size.Y - 4)
	-- Shaft at the player's XZ, snapped to the voxel grid and kept inside the dig zone.
	local here = World.ClampToDigZone(character:GetPivot().Position, SHAFT_WIDTH / 2)
	local x = math.floor(here.X / 4 + 0.5) * 4
	local z = math.floor(here.Z / 4 + 0.5) * 4
	local top = Config.SURFACE_Y
	local bottom = math.floor((top - depth) / 4) * 4
	local minV = Vector3.new(x - SHAFT_WIDTH / 2, bottom, z - SHAFT_WIDTH / 2)
	local maxV = Vector3.new(x + SHAFT_WIDTH / 2, top, z + SHAFT_WIDTH / 2)
	local size = maxV - minV + Vector3.new(0, 4, 0)
	Workspace.Terrain:FillBlock(CFrame.new(minV + size / 2), size, Enum.Material.Air)
	BeachService.RecordCarve(minV, maxV)
	BeachService.ReportDig(player, depth)
	character:PivotTo(CFrame.new(x, bottom + 4, z))
	Net.Notify(player, "Success", "[Dev] Dropped to " .. Config.GetLayerAtDepth(depth).Name)
end

handlers["/tide"] = function(player)
	BeachService.TideStep(true)
	Net.Notify(player, "Success", "[Dev] Tide refilled every hole")
end

handlers["/rebirths"] = function(player, args)
	DataService.Set(player, "Rebirths", math.max(0, math.floor(number(args[1]) or 1)))
	Net.Notify(player, "Success", "[Dev] Rebirths set")
end

handlers["/wipe"] = function(player)
	local fresh = Config.NewPlayerData() :: any
	local keys = {}
	for key in fresh do
		table.insert(keys, key)
	end
	DataService.Mutate(player, keys, function(data)
		for key, value in fresh do
			(data :: any)[key] = value
		end
	end)
	ShopService.GiveShovelTool(player)
	BeachService.TeleportToSurface(player)
	Net.Notify(player, "Success", "[Dev] Save wiped. Rejoin to replay the tutorial.")
end

handlers["/pet"] = function(player, args)
	local id = args[1] or "mega_excavator"
	if not Config.GetPet(id) then
		Net.Notify(player, "Error", "[Dev] Unknown pet id: " .. id)
		return
	end
	PetService.GrantPet(player, id, true)
	Net.Notify(player, "Success", "[Dev] Gave pet " .. id)
end

handlers["/surface"] = function(player)
	BeachService.TeleportToSurface(player)
end

function DevCommands.Start()
	if not RunService:IsStudio() then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "DevCommands"
	folder.Parent = TextChatService
	for name, handler in handlers do
		local command = Instance.new("TextChatCommand")
		command.Name = name
		command.PrimaryAlias = name
		command.Parent = folder
		command.Triggered:Connect(function(source: TextSource, text: string)
			local player = game:GetService("Players"):GetPlayerByUserId(source.UserId)
			if not player or not DataService.Get(player) then
				return
			end
			local args = string.split(text, " ")
			table.remove(args, 1)
			task.spawn(handler, player, args) -- errors print to Output with a stack trace
		end)
	end
	print("[DevCommands] Studio dev commands ready: /coins /max /dig /rebirths /wipe /surface /tide /pet /stress")
end

-- v3 discovery slice (Discovery agent) ---------------------------------------------------------
--   /find [treasureId] [size] [material]  uncover a find at your feet right now (excavation)
--   /deposits                             how many buried deposits are near you / on the server
-- (registered before Start runs; Start only runs in Studio)
handlers["/find"] = function(player, args)
	local Discovery = require(script.Parent.DiscoveryService) :: any
	local maybeRoot = Net.GetRoot(player)
	if not maybeRoot then
		return
	end
	local root = maybeRoot :: BasePart
	local depth = math.max(Config.SURFACE_Y - root.Position.Y, 0)
	local layer = Config.Layers[Config.GetLayerIndexAtDepth(depth)]
	local id = args[1] or layer.LootTable[#layer.LootTable].TreasureId
	if not Config.GetTreasure(id) then
		Net.Notify(player, "Error", "[Dev] Unknown treasure id: " .. id)
		return
	end
	local pos = World.ClampToDigZone(root.Position - Vector3.new(0, 5, 0), 2)
	local deposit = Discovery.AddDeposit(pos, id)
	if deposit then
		Discovery.Uncover(player, deposit, nil, nil, args[2], args[3])
	end
end

handlers["/deposits"] = function(player)
	local Discovery = require(script.Parent.DiscoveryService) :: any
	local root = Net.GetRoot(player)
	local near = if root
		then #Discovery.DepositsNear((root :: BasePart).Position, Config.Discovery.DETECTOR_RANGE)
		else 0
	Net.Notify(
		player,
		"Info",
		string.format("[Dev] %d deposits within range, %d on the server", near, Discovery.CountDeposits())
	)
end

-- v2.3 /stress (Platform agent) ------------------------------------------------------------------
--   /stress [n] [fx]  spawn n (default 15) digging bots "StressBot_i" across the dig zone. Each
--                     digs with the top shovel at its real rate and has 3 top digging pets that
--                     dig like PetDigService. "fx" adds a particle stream per bot.
--   /stress stop      remove the bots, print the final summary and refill every hole (tide)
-- Every 10 s it prints: digs/s (bot + pet), terrain edits/s, server Heartbeat ms (avg / max),
-- memory (Stats:GetTotalMemoryUsageMb) and data send kbps. docs/PERFORMANCE.md explains how to
-- use it with the MicroProfiler.
-- How it digs: bots are not Players, and DigAt needs a real player's data, so every bot dig is a
-- real DigService.DigAt for the player who ran /stress, with Source "Ride" (companion rules: no
-- shovel cooldown, range measured from opts.Origin = the bot) and Silent = true. Validation,
-- voxel reads, carving, tide bookkeeping, sand, MaxDepth, quests and treasure rolls all run as
-- for a real digger. Side effects land on the dev's save (Studio only): sand is emptied whenever
-- the backpack is 90% full, MaxDepth / quests advance, and treasure finds still pop up for you.

local STRESS_FOLDER = "StressBots"
local STRESS_REPORT_SECONDS = 10
local STRESS_PET_RING = { 6, 12 } -- studs from the bot, like PetDigService
local STRESS_RELOCATE_AFTER = 6 -- consecutive failed digs before the bot moves to a new column

type StressPet = { Id: string, Model: Model, Dig: any, Next: number }
type StressBot = {
	Model: Model,
	Root: BasePart,
	Column: Vector3, -- surface point of its column
	FeetY: number,
	NextDig: number,
	Fails: number,
	Pets: { StressPet },
}
type StressCounters = { Digs: number, Edits: number, Attempts: number, Beats: number, BeatSum: number, BeatMax: number }

local stress: {
	Player: Player?,
	Bots: { StressBot },
	Folder: Folder?,
	Connection: RBXScriptConnection?,
	Window: StressCounters,
	Total: StressCounters,
	Started: number,
	WindowStart: number,
	Rng: Random,
} =
	{
		Player = nil,
		Bots = {},
		Folder = nil,
		Connection = nil,
		Window = { Digs = 0, Edits = 0, Attempts = 0, Beats = 0, BeatSum = 0, BeatMax = 0 },
		Total = { Digs = 0, Edits = 0, Attempts = 0, Beats = 0, BeatSum = 0, BeatMax = 0 },
		Started = 0,
		WindowStart = 0,
		Rng = Random.new(20261006),
	}

local function newCounters(): StressCounters
	return { Digs = 0, Edits = 0, Attempts = 0, Beats = 0, BeatSum = 0, BeatMax = 0 }
end

local function stressPart(model: Model, name: string, size: Vector3, offset: Vector3, color: Color3): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Color = color
	part.CFrame = CFrame.new(offset)
	part.Parent = model
	return part
end

local function anchorAll(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
end

-- The 3 strongest digging pets (Dig.Power, then the shortest Interval).
local function topDiggingPets(): { Types.PetDef }
	local list: { Types.PetDef } = {}
	for _, def in Config.Pets do
		if def.Dig and not def.Rideable then
			table.insert(list, def)
		end
	end
	table.sort(list, function(a: Types.PetDef, b: Types.PetDef): boolean
		local da, db = a.Dig :: Types.PetDigDef, b.Dig :: Types.PetDigDef
		if da.Power ~= db.Power then
			return da.Power > db.Power
		end
		return da.Interval < db.Interval
	end)
	return { list[1], list[2] or list[1], list[3] or list[1] }
end

local function randomColumn(): Vector3
	local zone = World.GetDigZone()
	local c = zone.CFrame.Position
	local hx, hz = zone.Size.X / 2 - 8, zone.Size.Z / 2 - 8
	return Vector3.new(c.X + stress.Rng:NextNumber(-hx, hx), Config.SURFACE_Y, c.Z + stress.Rng:NextNumber(-hz, hz))
end

local function placeBot(bot: StressBot)
	bot.Model:PivotTo(CFrame.new(bot.Column.X, bot.FeetY + 3, bot.Column.Z))
end

local function newBot(index: number, folder: Folder, pets: { Types.PetDef }, fx: boolean): StressBot
	local model = Instance.new("Model")
	model.Name = "StressBot_" .. index
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local skin = Color3.fromRGB(255, 205, 160)
	local shirt = Color3.fromHSV((index * 0.13) % 1, 0.6, 0.9)
	local root = stressPart(model, "HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.zero, shirt)
	stressPart(model, "Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.6, 0), skin)
	stressPart(model, "LeftArm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 0, 0), skin)
	stressPart(model, "RightArm", Vector3.new(1, 2, 1), Vector3.new(1.5, 0, 0), skin)
	stressPart(model, "LeftLeg", Vector3.new(1, 2, 1), Vector3.new(-0.5, -2, 0), Color3.fromRGB(40, 60, 140))
	stressPart(model, "RightLeg", Vector3.new(1, 2, 1), Vector3.new(0.5, -2, 0), Color3.fromRGB(40, 60, 140))
	model.PrimaryPart = root
	local okShovel, shovel = pcall(Models.Shovel, Config.Shovels[#Config.Shovels].Id)
	if okShovel and shovel then
		anchorAll(shovel)
		shovel:PivotTo(root.CFrame * CFrame.new(1.8, 0, -1))
		shovel.Parent = model
	end
	if fx then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "DigBurst"
		emitter.Rate = 30
		emitter.Lifetime = NumberRange.new(0.4, 0.8)
		emitter.Speed = NumberRange.new(6, 12)
		emitter.SpreadAngle = Vector2.new(40, 40)
		emitter.Color = ColorSequence.new(Color3.fromRGB(230, 200, 140))
		emitter.Parent = root
	end
	local bot: StressBot = {
		Model = model,
		Root = root,
		Column = randomColumn(),
		FeetY = Config.SURFACE_Y,
		NextDig = os.clock() + stress.Rng:NextNumber(0, 0.5),
		Fails = 0,
		Pets = {},
	}
	for i, def in pets do
		local okPet, petModel = pcall(Models.Pet, def.Id)
		local pm: Model = if okPet and petModel then petModel else Instance.new("Model")
		anchorAll(pm)
		pm.Name = "Pet" .. i .. "_" .. def.Id
		pm.Parent = model
		table.insert(bot.Pets, {
			Id = def.Id,
			Model = pm,
			Dig = def.Dig,
			Next = os.clock() + stress.Rng:NextNumber(0, (def.Dig :: Types.PetDigDef).Interval),
		})
	end
	placeBot(bot)
	model.Parent = folder
	return bot
end

local function relocate(bot: StressBot)
	bot.Column = randomColumn()
	bot.FeetY = Config.SURFACE_Y
	bot.Fails = 0
	placeBot(bot)
end

local function keepBackpackRoom(player: Player)
	local data = DataService.Get(player)
	local ctx = MultiplierService.GetContext(player)
	if data and ctx and data.Sand >= Stats.GetCapacity(ctx) * 0.9 then
		DataService.Set(player, "Sand", 0) -- stands in for selling
	end
end

local function stressDig(player: Player, bot: StressBot, at: Vector3, opts: Types.DigOptions): Types.DigResult?
	keepBackpackRoom(player)
	stress.Window.Attempts += 1
	stress.Total.Attempts += 1
	local ok, result = pcall(DigService.DigAt, player, at, opts)
	if ok and result and result.Success then
		stress.Window.Digs += 1
		stress.Total.Digs += 1
		stress.Window.Edits += 1
		stress.Total.Edits += 1
		return result
	end
	return nil
end

local function stressStep(dt: number)
	local ms = dt * 1000
	for _, c in { stress.Window, stress.Total } do
		c.Beats += 1
		c.BeatSum += ms
		c.BeatMax = math.max(c.BeatMax, ms)
	end
	local maybePlayer = stress.Player
	if not maybePlayer or maybePlayer.Parent == nil or not Net.GetRoot(maybePlayer) then
		return
	end
	local player = maybePlayer :: Player
	local now = os.clock()
	local top = Config.Shovels[#Config.Shovels]
	debug.profilebegin("DigTheBeach.Stress.BotStep")
	for _, bot in stress.Bots do
		if now >= bot.NextDig then
			bot.NextDig = now + top.Cooldown
			local offset = Vector3.new(stress.Rng:NextNumber(-3, 3), 0, stress.Rng:NextNumber(-3, 3))
			local at = Vector3.new(bot.Column.X, bot.FeetY, bot.Column.Z) + offset
			local result = stressDig(player, bot, at, {
				Power = top.Power,
				Radius = top.Radius,
				SandMultiplier = top.SandMultiplier,
				Source = "Ride",
				Origin = bot.Root.Position,
				Silent = true,
			})
			if result then
				bot.Fails = 0
				-- stand on the floor of the cube just carved (16-stud cube for the top shovel)
				bot.FeetY = math.max(
					Config.SURFACE_Y - result.Depth - top.Radius * 2 + 4,
					Config.SURFACE_Y - Config.TOTAL_DEPTH + 8
				)
				placeBot(bot)
			else
				bot.Fails += 1
				if bot.Fails >= STRESS_RELOCATE_AFTER then
					relocate(bot)
				end
			end
		end
		for _, pet in bot.Pets do
			if now >= pet.Next then
				local dig = pet.Dig :: Types.PetDigDef
				pet.Next = now + dig.Interval
				local angle = stress.Rng:NextNumber(0, math.pi * 2)
				local r = stress.Rng:NextNumber(STRESS_PET_RING[1], STRESS_PET_RING[2])
				local spot =
					Vector3.new(bot.Column.X + math.cos(angle) * r, bot.FeetY, bot.Column.Z + math.sin(angle) * r)
				pet.Model:PivotTo(CFrame.new(spot + Vector3.new(0, 1, 0)))
				stressDig(player, bot, spot, {
					Power = dig.Power,
					Radius = dig.Radius,
					SandMultiplier = dig.SandMultiplier,
					Source = "Ride",
					Origin = spot,
					Silent = true,
				})
			end
		end
	end
	debug.profileend()
end

local function stressSummary(c: StressCounters, seconds: number): string
	local statsService = game:GetService("Stats")
	local memory = 0
	pcall(function()
		memory = statsService:GetTotalMemoryUsageMb()
	end)
	local sendKbps = 0
	pcall(function()
		sendKbps = statsService.DataSendKbps
	end)
	local s = math.max(seconds, 1e-3)
	return string.format(
		"[Stress] %d bots | %.1f digs/s (%.0f%% ok) | %.1f terrain edits/s | heartbeat %.1f ms avg / %.1f ms max | memory %.0f MB | send %.0f kbps",
		#stress.Bots,
		c.Digs / s,
		if c.Attempts > 0 then c.Digs / c.Attempts * 100 else 0,
		c.Edits / s,
		if c.Beats > 0 then c.BeatSum / c.Beats else 0,
		c.BeatMax,
		memory,
		sendKbps
	)
end

function DevCommands.StopStress(): string?
	if stress.Connection then
		(stress.Connection :: RBXScriptConnection):Disconnect()
		stress.Connection = nil
	end
	if not stress.Folder then
		return nil
	end
	local summary = stressSummary(stress.Total, os.clock() - stress.Started) .. " (whole run)"
	print(summary)
	local folder = stress.Folder :: Folder
	folder:Destroy()
	stress.Folder = nil
	stress.Bots = {}
	stress.Player = nil
	BeachService.TideStep(true)
	return summary
end

function DevCommands.StartStress(player: Player, count: number?, fx: boolean?): number
	DevCommands.StopStress()
	local n = math.clamp(math.floor(count or 15), 1, 64)
	local folder = Instance.new("Folder")
	folder.Name = STRESS_FOLDER
	folder.Parent = Workspace
	stress.Folder = folder
	stress.Player = player
	stress.Bots = {}
	stress.Window = newCounters()
	stress.Total = newCounters()
	stress.Started = os.clock()
	stress.WindowStart = os.clock()
	local pets = topDiggingPets()
	debug.profilebegin("DigTheBeach.Stress.CreateBots")
	for i = 1, n do
		table.insert(stress.Bots, newBot(i, folder, pets, fx == true))
	end
	debug.profileend()
	stress.Connection = RunService.Heartbeat:Connect(stressStep)
	local runFolder = folder
	task.spawn(function()
		while stress.Folder == runFolder do
			task.wait(STRESS_REPORT_SECONDS)
			if stress.Folder ~= runFolder then
				break
			end
			local now = os.clock()
			local line = stressSummary(stress.Window, now - stress.WindowStart)
			print(line)
			stress.Window = newCounters()
			stress.WindowStart = now
		end
	end)
	return n
end

-- Tests: totals of the current / last run.
function DevCommands.GetStressStats(): { Bots: number, Digs: number, Attempts: number }
	return { Bots = #stress.Bots, Digs = stress.Total.Digs, Attempts = stress.Total.Attempts }
end

handlers["/stress"] = function(player, args)
	if args[1] == "stop" then
		local summary = DevCommands.StopStress()
		Net.Notify(
			player,
			"Success",
			if summary then "[Dev] Stress bots removed, holes refilled" else "[Dev] No stress run"
		)
		return
	end
	local n = number(args[1]) or 15
	local fx = table.find(args, "fx") ~= nil
	local started = DevCommands.StartStress(player, n, fx)
	Net.Notify(
		player,
		"Success",
		string.format("[Dev] %d stress bots digging. Summary every 10 s in Output. /stress stop", started)
	)
end

return DevCommands
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">DigService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DigService — every terrain dig goes through DigService.DigAt (docs/V2.md).

	DigAt(player, position, opts) — opts = Types.DigOptions { Power, Radius, SandMultiplier,
	Source = "Shovel" | "Digger" | "Pet" | "Ride" | "Auto", Silent? }. Validation, in order (first failure ->
	DigResult{Success=false,Reason}):
	  Cooldown     Shovel/Auto only: shovel cooldown / speed (x COOLDOWN_LENIENCY for Shovel)
	               x Config.Heat.SunburntCooldownMultiplier while the player is "Sunburnt"
	  OutOfZone    point is not inside the dig zone (World.GetDigZone)
	  Bottom       point is at the very bottom of the world (The Core floor is indestructible)
	  TooFar       Shovel: further than Config.REACH (+ slack) from HumanoidRootPart;
	               Digger/Pet: further than DIGGER_RANGE from the owner (Auto: never);
	               Ride: further than RIDE_RANGE from opts.Origin (the vehicle, RideService)
	  TooHard      opts.Power < Hardness of the layer at that depth
	  BackpackFull Sand >= effective capacity
	Points with no solid terrain near them are ignored silently (no result).
	The dig point is re-resolved on the server (Shovel: re-raycast from the character; others:
	3 studs below the given point) and a voxel-aligned cube is carved: edge = Radius * 2 rounded
	to whole 4-stud voxels (min 1 voxel), centred horizontally on the target and going DOWN
	from the target voxel; a dig at the surface also clears the voxel above the surface. The
	cube is clamped to the dig zone so the zone walls and the floor never break.
	Success: sand (Stats; opts.SandMultiplier replaces the shovel factor) into the backpack
	(capped at capacity), tide/anti-cheat bookkeeping (BeachService.RecordCarve), MaxDepth via
	BeachService.ReportDig, ServerSignals.Carved(player, min, max, source, layerIndex) (v3: the
	DiscoveryService uncovers buried finds from it; there is no per-dig treasure roll any more),
	ServerSignals.Dug(player, depth, gained, source) and a DigResult unless opts.Silent.

	Messages: the CLIENT shows every dig hint (too hard, backpack full, bottom...) from the
	DigResult it receives, so the server sends no Notify for dig failures (no duplicates).
	Failed Digger digs send nothing (the caller gets the result).

	AutoDig pass: SetSetting("AutoDig", true|false). While on (and the pass is owned) the server
	digs straight down below the character's feet at the shovel's normal cooldown (Source "Auto").

	Public API:
		DigService.DigAt(player, position, opts): Types.DigResult?
		DigService.ShovelOptions(player, source?): Types.DigOptions?   -- equipped shovel stats
		DigService.TryDig(player, position, isAuto)   -- v1 compatibility: DigAt with the shovel
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Stats = require(Shared.Util.Stats)

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local MonetizationService = require(script.Parent.MonetizationService)
local MultiplierService = require(script.Parent.MultiplierService)
local Net = require(script.Parent.Net)
local BeachService = require(script.Parent.BeachService)
local ServerSignals = require(script.Parent.ServerSignals)
local SettingsService = require(script.Parent.SettingsService)
local World = require(script.Parent.Parent.World)

local REACH_SLACK = 2 -- studs of latency slack on top of Config.REACH
local DIGGER_RANGE = 16 -- Digger digs must be this close to the owner's character
-- v2.1: pet ("Pet") and ride-on ("Ride") digs follow the "Digger" rules (own stats, no shovel
-- cooldown, DIGGER_RANGE instead of REACH, no failure DigResult).
local COMPANION_SOURCES: { [string]: boolean } = { Digger = true, Pet = true, Ride = true }
local DIGGER_SLACK = 2
local RIDE_RANGE = 64 -- "Ride": max studs from the vehicle (opts.Origin) to the dig point
local SURFACE_SLACK = 4 -- how far above the surface a dig point may be
local BOTTOM_FLOOR = 2 -- studs of indestructible floor kept at the bottom of the world
local EDGE_SLACK = 1 -- dig points may be this far outside the footprint (surface rounding)
local AUTO_TICK = 0.05
local FAIL_RESULT_INTERVAL = 0.2 -- Shovel: min seconds between failure DigResults
local AUTO_FAIL_INTERVAL = 1.5 -- Auto: min seconds between failure DigResults

local S = Config.SURFACE_Y
local ZONE = World.GetDigZone()
local ZONE_CENTER = ZONE.CFrame.Position
local ZONE_HALF_X = ZONE.Size.X / 2
local ZONE_HALF_Z = ZONE.Size.Z / 2
local TOTAL_DEPTH = ZONE.Size.Y

local DigService = {}

local terrain = Workspace.Terrain

local lastDig: { [Player]: number } = {}
local lastFailResult: { [Player]: number } = {}

local function baseResult(position: Vector3): Types.DigResult
	return {
		Success = false,
		Reason = nil,
		Position = position,
		Radius = 0,
		SandGained = 0,
		Sand = 0,
		Capacity = 0,
		Depth = 0,
		LayerIndex = 1,
		NewMaxDepth = false,
		NewLayer = false,
		TreasureId = nil,
	}
end

local VOXEL = 4 -- terrain resolution; carving whole voxels makes every dig visible

-- Prints why a dig was silently ignored. Studio only, at most once per reason per 5 seconds.
local debugThrottle: { [string]: number } = {}
local function studioDebug(player: Player, reason: string, detail: string)
	if not RunService:IsStudio() then
		return
	end
	local key = player.Name .. reason
	local now = os.clock()
	if (debugThrottle[key] or 0) + 5 > now then
		return
	end
	debugThrottle[key] = now
	print(string.format("[DigService] %s dig ignored: %s", player.Name, detail))
end

-- Removes a voxel-aligned cube of terrain at the dig point and returns the carved box (min, max).
-- Edge = radius * 2 rounded to whole voxels (radius 2 = one 4-stud voxel, radius 8 = 4x4x4
-- voxels). Horizontally centred on the target, going down from the target voxel. Clamped to
-- voxels fully inside the dig zone so its walls and the floor never break. A dig whose top
-- reaches the surface also clears the voxel above it (the partially filled surface voxel).
-- Hand-spade tiers (Radius <= DENT_MAX_RADIUS) carve a rounded dent instead of a whole voxel:
-- terrain voxels are 4 studs, so anything "smaller than a block" has to come from lowering
-- voxel occupancy with a ball. Playtest asked for ~2x2x2 scoops at the start.
local DENT_MAX_RADIUS = 2.2
local DENT_BALL_RADIUS = 2.6
local DENT_RISE = 1.5 -- ball centre sits this far above the resolved target (≈1.5 under the surface)

local function carveDent(target: Vector3): (Vector3, Vector3)
	local r = DENT_BALL_RADIUS
	local margin = r + 0.5
	local center = Vector3.new(
		math.clamp(target.X, ZONE_CENTER.X - ZONE_HALF_X + margin, ZONE_CENTER.X + ZONE_HALF_X - margin),
		math.max(target.Y + DENT_RISE, S - TOTAL_DEPTH + BOTTOM_FLOOR + margin),
		math.clamp(target.Z, ZONE_CENTER.Z - ZONE_HALF_Z + margin, ZONE_CENTER.Z + ZONE_HALF_Z - margin)
	)
	debug.profilebegin("DigTheBeach.Dig.FillBall")
	local ok, err = pcall(terrain.FillBall, terrain, center, r, Enum.Material.Air)
	debug.profileend()
	if not ok then
		error(err, 0)
	end
	local half = Vector3.new(r, r, r)
	local max = center + half
	return center - half, Vector3.new(max.X, math.min(max.Y, S), max.Z)
end

local function carve(target: Vector3, radius: number): (Vector3, Vector3)
	if radius <= DENT_MAX_RADIUS then
		return carveDent(target)
	end
	local cells = math.max(1, math.floor(radius * 2 / VOXEL + 0.5))
	local function axisStart(value: number, minEdge: number, maxEdge: number): number
		local lo = math.ceil(minEdge / VOXEL)
		local hi = math.floor(maxEdge / VOXEL) - cells
		local start = math.floor(value / VOXEL) - math.floor((cells - 1) / 2)
		return if hi < lo then lo else math.clamp(start, lo, hi)
	end
	local sx = axisStart(target.X, ZONE_CENTER.X - ZONE_HALF_X, ZONE_CENTER.X + ZONE_HALF_X)
	local sz = axisStart(target.Z, ZONE_CENTER.Z - ZONE_HALF_Z, ZONE_CENTER.Z + ZONE_HALF_Z)
	local floorY = S - TOTAL_DEPTH + BOTTOM_FLOOR
	local topCell = math.min(math.floor(target.Y / VOXEL), S // VOXEL - 1)
	local sy = math.max(topCell - (cells - 1), math.ceil(floorY / VOXEL))
	local size = Vector3.new(cells, cells, cells) * VOXEL
	local min = Vector3.new(sx, sy, sz) * VOXEL
	local max = min + size
	local clearTop = if max.Y >= S then S + VOXEL else max.Y
	local box = Vector3.new(size.X, clearTop - min.Y, size.Z)
	debug.profilebegin("DigTheBeach.Dig.FillBlock")
	local ok, err = pcall(terrain.FillBlock, terrain, CFrame.new(min + box / 2), box, Enum.Material.Air)
	debug.profileend()
	if not ok then
		error(err, 0)
	end
	return min, Vector3.new(max.X, math.min(max.Y, S), max.Z)
end

-- The smooth-terrain surface a player clicks is not on voxel boundaries, so the raw hit point can
-- sit in the empty voxel above the ground. Re-cast from the digger toward the click and step 2
-- studs into the surface along its normal. 3 studs (not 2) so a hit exactly on a voxel boundary
-- still lands in the solid voxel below rather than the partially filled one above.
local terrainOnly = RaycastParams.new()
terrainOnly.FilterType = Enum.RaycastFilterType.Include
terrainOnly.FilterDescendantsInstances = { terrain }

local function resolveTarget(position: Vector3, root: BasePart?): Vector3
	if root then
		local offset = position - root.Position
		if offset.Magnitude > 0.01 then
			local hit = Workspace:Raycast(root.Position, offset.Unit * (offset.Magnitude + 6), terrainOnly)
			if hit then
				return hit.Position - hit.Normal * 3
			end
		end
	end
	return position - Vector3.new(0, 3, 0)
end

local function hasSolidTerrainNear(position: Vector3): boolean
	local half = Vector3.new(2, 2, 2)
	local region = Region3.new(position - half, position + half):ExpandToGrid(4)
	debug.profilebegin("DigTheBeach.Dig.ReadVoxels")
	local ok, materials, occupancies = pcall(function()
		return terrain:ReadVoxels(region, 4)
	end)
	debug.profileend()
	if not ok then
		return true -- don't block digging on an engine hiccup
	end
	assert(ok) -- refine for the type checker (guarded above)
	local size: Vector3 = materials.Size
	for x = 1, size.X do
		for y = 1, size.Y do
			for z = 1, size.Z do
				local material = materials[x][y][z]
				if material ~= Enum.Material.Air and material ~= Enum.Material.Water and occupancies[x][y][z] > 0 then
					return true
				end
			end
		end
	end
	return false
end

local function fail(
	player: Player,
	result: Types.DigResult,
	reason: Types.DigFailReason,
	opts: Types.DigOptions
): Types.DigResult
	result.Reason = reason
	-- No Notify here: the client turns the DigResult into one hint. Throttle failure replies so
	-- spamming the remote can't flood the client back.
	if opts.Silent or COMPANION_SOURCES[opts.Source] or (opts.Source == "Auto" and reason == "Cooldown") then
		return result
	end
	local interval = if opts.Source == "Auto" then AUTO_FAIL_INTERVAL else FAIL_RESULT_INTERVAL
	local now = os.clock()
	local last = lastFailResult[player]
	if last == nil or now - last >= interval then
		lastFailResult[player] = now
		Net.FireClient("DigResult", player, result)
	end
	return result
end

local function cooldownFor(player: Player, ctx: Stats.Context, source: string): number
	local cooldown = Stats.GetCooldown(ctx) * (if source == "Shovel" then Config.COOLDOWN_LENIENCY else 1)
	if player:GetAttribute("Sunburnt") == true then
		cooldown *= Config.Heat.SunburntCooldownMultiplier
	end
	return cooldown
end

-- Dig options from the player's equipped shovel.
function DigService.ShovelOptions(player: Player, source: Types.DigSource?): Types.DigOptions?
	local data = DataService.Get(player)
	if not data then
		return nil
	end
	assert(data) -- refine for the type checker (guarded above)
	local shovel = Stats.GetShovel(data)
	return {
		Power = shovel.Power,
		Radius = shovel.Radius,
		SandMultiplier = shovel.SandMultiplier,
		Source = source or "Shovel",
	}
end

function DigService.DigAt(player: Player, position: Vector3, opts: Types.DigOptions): Types.DigResult?
	local data = DataService.Get(player)
	local ctx = MultiplierService.GetContext(player)
	if not data or not ctx then
		return nil
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(ctx) -- refine for the type checker (guarded above)
	local source = opts.Source
	local companion = COMPANION_SOURCES[source] == true
	local result = baseResult(position)
	local now = os.clock()

	if not companion then
		local cooldown = cooldownFor(player, ctx, source)
		local last = lastDig[player]
		if last and now - last < cooldown then
			studioDebug(player, "Cooldown", string.format("cooldown %.2fs not elapsed", cooldown))
			return fail(player, result, "Cooldown", opts)
		end
	end

	-- Zone bounds (zone-local: origin = surface centre, -Y = down).
	local rel = position - ZONE_CENTER
	if
		math.abs(rel.X) > ZONE_HALF_X + EDGE_SLACK
		or math.abs(rel.Z) > ZONE_HALF_Z + EDGE_SLACK
		or rel.Y > SURFACE_SLACK
		or rel.Y < -TOTAL_DEPTH - EDGE_SLACK
	then
		return fail(player, result, "OutOfZone", opts)
	end

	local root = Net.GetRoot(player)
	if source == "Shovel" then
		if not root or (root.Position - position).Magnitude > Config.REACH + REACH_SLACK then
			return fail(player, result, "TooFar", opts)
		end
	elseif source == "Ride" then
		-- Ride: measured from the vehicle (opts.Origin, server-side; the rider sits in its cab).
		local origin = opts.Origin or (if root then root.Position else nil)
		if not root or not origin or (origin - position).Magnitude > RIDE_RANGE then
			return fail(player, result, "TooFar", opts)
		end
	elseif companion then
		if not root or (root.Position - position).Magnitude > DIGGER_RANGE + DIGGER_SLACK then
			return fail(player, result, "TooFar", opts)
		end
	end

	local target = resolveTarget(position, if source == "Shovel" then root else nil)
	local trel = target - ZONE_CENTER
	if math.abs(trel.X) > ZONE_HALF_X + EDGE_SLACK or math.abs(trel.Z) > ZONE_HALF_Z + EDGE_SLACK then
		return fail(player, result, "OutOfZone", opts)
	end
	local depth = math.clamp(S - target.Y, 0, TOTAL_DEPTH)
	if depth >= TOTAL_DEPTH - BOTTOM_FLOOR then
		return fail(player, result, "Bottom", opts)
	end
	local layerIndex = Config.GetLayerIndexAtDepth(depth)
	local layer = Config.Layers[layerIndex]
	result.Radius = opts.Radius
	result.Depth = depth
	result.LayerIndex = layerIndex

	if not hasSolidTerrainNear(target) then
		studioDebug(player, "NoTerrain", "no solid terrain at " .. tostring(target))
		return nil
	end

	if opts.Power < layer.Hardness then
		return fail(player, result, "TooHard", opts)
	end

	local capacity = Stats.GetCapacity(ctx)
	result.Capacity = capacity
	result.Sand = data.Sand
	if data.Sand >= capacity then
		return fail(player, result, "BackpackFull", opts)
	end

	-- Success ------------------------------------------------------------------------------------
	if not companion then
		lastDig[player] = now
	end
	local carvedMin, carvedMax = carve(target, opts.Radius)
	BeachService.RecordCarve(carvedMin, carvedMax)

	-- opts.SandMultiplier replaces the shovel's factor in the multiplier stack.
	local shovelFactor = Stats.GetShovel(data).SandMultiplier
	local sandMultiplier = Stats.GetSandMultiplier(ctx)
	if shovelFactor > 0 then
		sandMultiplier = sandMultiplier / shovelFactor * opts.SandMultiplier
	end
	local gained = math.min(layer.SandValue * sandMultiplier, capacity - data.Sand)
	DataService.Mutate(player, { "Sand", "TotalSandDug" }, function(d)
		d.Sand += gained
		d.TotalSandDug += gained
	end)
	local newRecord, newLayer = BeachService.ReportDig(player, depth)

	-- v3 discovery: finds come from buried deposits (DiscoveryService listens to Carved: uncover,
	-- ownership, excavation, plus a tiny ambient junk chance). No per-dig treasure roll here.
	-- Silent digs (pets, /stress bots) never produce finds or popups for the player.
	if not opts.Silent then
		ServerSignals.Carved:Fire(player, carvedMin, carvedMax, source, layerIndex)
	end

	result.Success = true
	result.SandGained = gained
	result.Sand = data.Sand
	result.NewMaxDepth = newRecord
	result.NewLayer = newLayer
	if not opts.Silent then
		Net.FireClient("DigResult", player, result)
	end

	ServerSignals.Dug:Fire(player, depth, gained, source)
	Analytics.Funnel(player, Analytics.Steps.FirstDig)
	if data.Sand >= capacity then
		ServerSignals.BackpackFull:Fire(player)
	end
	return result
end

-- v1 compatibility: a dig with the equipped shovel (isAuto -> Source "Auto").
function DigService.TryDig(player: Player, position: Vector3, isAuto: boolean): Types.DigResult?
	local opts = DigService.ShovelOptions(player, if isAuto then "Auto" else "Shovel")
	if not opts then
		return nil
	end
	return DigService.DigAt(player, position, opts :: Types.DigOptions)
end

-- AutoDig ---------------------------------------------------------------------------------------

local function autoDigEnabled(player: Player): boolean
	return SettingsService.Get(player, "AutoDig") == true and MonetizationService.OwnsPass(player, "AutoDig")
end

local function autoDigStep(player: Player)
	local root = Net.GetRoot(player)
	if not root then
		return
	end
	assert(root) -- refine for the type checker (guarded above)
	local data = DataService.Get(player)
	local ctx = MultiplierService.GetContext(player)
	if not data or not ctx then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(ctx) -- refine for the type checker (guarded above)
	if os.clock() - (lastDig[player] or 0) < cooldownFor(player, ctx, "Auto") then
		return
	end
	if data.Sand >= Stats.GetCapacity(ctx) then
		return -- the client shows the "Backpack full" hint
	end
	local humanoid = (root.Parent :: Instance):FindFirstChildOfClass("Humanoid")
	local hip = if humanoid then humanoid.HipHeight else 2
	local below = root.Position - Vector3.new(0, root.Size.Y / 2 + hip + 0.5, 0)
	local result = DigService.TryDig(player, below, true)
	if result and not result.Success and result.Reason == "TooHard" then
		lastDig[player] = os.clock() -- back off; the notify is already throttled
	end
end

function DigService.Init()
	Net.On("Dig", function(player: Player, position: any)
		if not Net.IsVector3(position) then
			return
		end
		local opts = DigService.ShovelOptions(player, "Shovel")
		if opts then
			DigService.DigAt(player, position :: Vector3, opts :: Types.DigOptions)
		end
	end, { Rate = 20, Window = 1 })

	SettingsService.RegisterValidator("AutoDig", function(player: Player, value: any): (boolean, any)
		if type(value) ~= "boolean" then
			return false, nil
		end
		if value and not MonetizationService.OwnsPass(player, "AutoDig") then
			Net.Notify(player, "Error", "Get the Auto Dig pass to dig automatically!")
			return false, nil
		end
		return true, value
	end)
end

function DigService.Start()
	task.spawn(function()
		while true do
			task.wait(AUTO_TICK)
			for _, player in DataService.GetLoadedPlayers() do
				if autoDigEnabled(player) then
					local ok, err = pcall(function(): any
						autoDigStep(player)
						return nil
					end)
					if not ok then
						warn("[DigService] auto dig error: " .. tostring(err))
					end
				end
			end
		end
	end)
end

function DigService.OnPlayerRemoving(player: Player)
	lastDig[player] = nil
	lastFailResult[player] = nil
end

return DigService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">DiscoveryService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DiscoveryService (v3 discovery slice) — buried finds, the detector and the excavation moment.
	Design + numbers: docs/design/Discovery.md. Balance: Config.Discovery. Pure math: Util/Finds.

	DEPOSITS are pure server data (no parts): the dig zone is split into chunks of
	CHUNK x CHUNK_Y x CHUNK studs, keyed in a hash. A chunk is seeded lazily the first time a dig,
	a scan or a test looks at it: Finds.Density(layer) deposits (fraction = chance of one more,
	never more than CHUNK_CAP), each at a random point in solid, undug sand at least MIN_DEPTH
	below the surface, holding a treasure rolled from the layer's LootTable (or a Relic). Chunks
	below their target regrow one deposit every RESPAWN_SECONDS; chunks nobody touched for
	EVICT_SECONDS (and no player near) are forgotten and re-seeded fresh later (the tide refilled
	them anyway). The whole server never holds more than SERVER_CAP deposits (oldest chunks go).

	UNCOVERING: DigService fires ServerSignals.Carved(player, min, max, source, layer) after every
	successful non-Silent carve; only Shovel / Auto digs (the player's own) uncover anything, so
	pets, the ride-on excavator and /stress bots never trigger finds or popups. The deposit nearest to the carve within UNCOVER_RADIUS of the carved box is
	uncovered and removed from the hash: the digging player OWNS its excavation (others only see
	it). One excavation per player at a time (more deposits wait for the next dig). The variant
	(size + material) is rolled now, with the owner's luck (Finds.VariantOdds = true odds shown
	in the Index). A brand-new player's FTUE_FIND_DIG-th dig always uncovers a Common find, and
	when nothing was uncovered a tiny AMBIENT chance gives a plain Common find with no minigame.

	EXCAVATION: the server spawns the find model half-buried at the dug floor (tag "DiscoveryFind",
	attributes FindId / TreasureId / Rarity / Size / Material / OwnerId / Stage / Rise / Tier) and
	sends the owner ExcavationStart(Types.ExcavationInfo). The client plays RINGS timed taps and
	answers Excavate(id, errors) with each ring's timing error. The server grades the errors itself
	(Finds.Score), caps the quality at Good when the answer came faster than
	MIN_EXCAVATION_SECONDS, ignores answers for anything but the owner's current excavation, and
	resolves on its own after EXCAVATION_TIMEOUT (no hits = Damaged; a find is never lost).
	Quality only changes value (x0.6 / x1 / x1.5), so a cheating client gains at most +50% on a
	find it would have got anyway.

	REVEAL: the find goes to PlayerData.Finds (sold with sand) + Index + FindVariants, the owner
	gets FindRevealed(Types.FindInfo), the model's Stage becomes "Revealed" (every client animates
	it rising with effects by Tier; Mythic / Relic models are ModelStreamingMode Persistent so
	their sky beam is visible to the whole server) and is removed after REVEAL_SECONDS
	(SPECTACLE_SECONDS for Server / Spectacle tiers). Rarities with Announce brag to the server.

	DETECTOR: Scan() starts a SCAN_SECONDS scan (SCAN_COOLDOWN between starts). Every
	PING_INTERVAL the owner gets DetectorPing(Types.DetectorPing) for the nearest deposit within
	DETECTOR_RANGE: a distance band, a compass sector, Down/Level/Up and the signal colour only.
	Positions and the deposit list never leave the server.

	Public API (tests / dev):
		DiscoveryService.Seed(position): number          -- seed / touch the chunk there, deposit count
		DiscoveryService.DepositsNear(position, radius): { Deposit }
		DiscoveryService.CountDeposits(): number
		DiscoveryService.ChunkCount(): number
		DiscoveryService.AddDeposit(position, treasureId): Deposit?
		DiscoveryService.Uncover(player, deposit, near?): string?   -- starts an excavation (id)
		DiscoveryService.GetExcavation(player): Excavation?
		DiscoveryService.Resolve(player, id, errors?): Types.FindInfo?
		DiscoveryService.Maintain(now?)                  -- respawn / evict pass
		DiscoveryService.PingFor(player): Types.DetectorPing
		DiscoveryService.SetSeed(seed)                   -- deterministic rolls (tests)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Models = require(Shared.Models)
local Stats = require(Shared.Util.Stats)
local Finds = require(Shared.Util.Finds)

local Analytics = require(script.Parent.Analytics)
local BeachService = require(script.Parent.BeachService)
local DataService = require(script.Parent.DataService)
local MultiplierService = require(script.Parent.MultiplierService)
local Net = require(script.Parent.Net)
local ServerSignals = require(script.Parent.ServerSignals)
local World = require(script.Parent.Parent.World)

local D = Config.Discovery

export type Deposit = {
	Id: number,
	Position: Vector3,
	TreasureId: string,
	Rarity: string,
	ChunkKey: number,
}

type Chunk = {
	Key: number,
	CX: number,
	CY: number,
	CZ: number,
	Min: Vector3,
	Max: Vector3,
	Target: number,
	Deposits: { Deposit },
	LastTouched: number,
	LastRespawn: number,
}

export type Excavation = {
	Id: string,
	Player: Player,
	TreasureId: string,
	Rarity: string,
	Size: string,
	Material: string,
	Position: Vector3,
	Started: number,
	Model: Model?,
	Resolved: boolean,
}

local TAG = "DiscoveryFind"
local MAINTAIN_INTERVAL = 5
local BOTTOM_FLOOR = 4 -- studs above the bottom of the world kept clear of deposits
local SEED_TRIES = 6

local S = Config.SURFACE_Y
local ZONE = World.GetDigZone()
local ZONE_MIN = ZONE.CFrame.Position - Vector3.new(ZONE.Size.X / 2, 0, ZONE.Size.Z / 2)
local ZONE_MAX = ZONE.CFrame.Position + Vector3.new(ZONE.Size.X / 2, 0, ZONE.Size.Z / 2)
local TOTAL_DEPTH = ZONE.Size.Y
local NX = math.ceil(ZONE.Size.X / D.CHUNK)
local NZ = math.ceil(ZONE.Size.Z / D.CHUNK)
local NY = math.ceil(TOTAL_DEPTH / D.CHUNK_Y)

local DiscoveryService = {}

local rng = Random.new()
local chunks: { [number]: Chunk } = {}
local chunkCount = 0
local depositTotal = 0
local nextDepositId = 0
local nextExcavationId = 0
local excavations: { [Player]: Excavation } = {}
local scans: { [Player]: { Started: number, Until: number } } = {}
local sessionDigs: { [Player]: number } = {}
local folder: Folder? = nil

local terrainOnly = RaycastParams.new()
terrainOnly.FilterType = Enum.RaycastFilterType.Include
terrainOnly.FilterDescendantsInstances = { Workspace.Terrain }

-- Chunks ---------------------------------------------------------------------------------------

local function chunkKey(cx: number, cy: number, cz: number): number
	return (cy * 64 + cz) * 4096 + cx
end

local function chunkCoords(position: Vector3): (number, number, number)
	return math.floor((position.X - ZONE_MIN.X) / D.CHUNK),
		math.floor((S - position.Y) / D.CHUNK_Y),
		math.floor((position.Z - ZONE_MIN.Z) / D.CHUNK)
end

local function validCoords(cx: number, cy: number, cz: number): boolean
	return cx >= 0 and cx < NX and cz >= 0 and cz < NZ and cy >= 0 and cy < NY
end

local function depthOf(position: Vector3): number
	return S - position.Y
end

local function randomIn(lo: number, hi: number): number
	return if hi <= lo then lo else lo + rng:NextNumber() * (hi - lo)
end

-- A random deposit spot in the chunk: solid, undug sand, spaced from the others.
local function pickSpot(chunk: Chunk): Vector3?
	for _ = 1, SEED_TRIES do
		local m = D.EDGE_MARGIN
		local pos = Vector3.new(
			randomIn(chunk.Min.X + m, chunk.Max.X - m),
			randomIn(chunk.Min.Y + m, chunk.Max.Y - m),
			randomIn(chunk.Min.Z + m, chunk.Max.Z - m)
		)
		local ok = BeachService.GetDugDepthAt(pos) < depthOf(pos) - 1
		if ok then
			for _, other in chunk.Deposits do
				if (other.Position - pos).Magnitude < D.MIN_SPACING then
					ok = false
					break
				end
			end
		end
		if ok then
			return pos
		end
	end
	return nil
end

local function addTo(chunk: Chunk, pos: Vector3, treasureId: string): Deposit?
	local found = Config.GetTreasure(treasureId)
	if not found then
		return nil
	end
	local def = found :: Types.TreasureDef
	nextDepositId += 1
	local deposit: Deposit = {
		Id = nextDepositId,
		Position = pos,
		TreasureId = treasureId,
		Rarity = def.Rarity,
		ChunkKey = chunk.Key,
	}
	table.insert(chunk.Deposits, deposit)
	depositTotal += 1
	return deposit
end

local function growOne(chunk: Chunk): Deposit?
	if #chunk.Deposits >= D.CHUNK_CAP or depositTotal >= D.SERVER_CAP then
		return nil
	end
	local pos = pickSpot(chunk)
	if not pos then
		return nil
	end
	local layerIndex = Config.GetLayerIndexAtDepth(depthOf(pos :: Vector3))
	local treasureId = Finds.RollTreasure(layerIndex, rng:NextNumber(), rng:NextNumber())
	return if treasureId then addTo(chunk, pos :: Vector3, treasureId) else nil
end

local function forget(chunk: Chunk)
	if chunks[chunk.Key] == chunk then
		chunks[chunk.Key] = nil
		chunkCount -= 1
		depositTotal -= #chunk.Deposits
	end
end

-- Frees room for `needed` deposits by forgetting the least recently touched chunks.
local function makeRoom(needed: number, keep: Chunk?)
	while depositTotal + needed > D.SERVER_CAP do
		local oldest: Chunk? = nil
		for _, chunk in chunks do
			if chunk ~= keep and #chunk.Deposits > 0 and (oldest == nil or chunk.LastTouched < oldest.LastTouched) then
				oldest = chunk
			end
		end
		if not oldest then
			return
		end
		forget(oldest :: Chunk)
	end
end

local function getChunk(cx: number, cy: number, cz: number): Chunk?
	if not validCoords(cx, cy, cz) then
		return nil
	end
	local key = chunkKey(cx, cy, cz)
	local now = os.clock()
	local existing = chunks[key]
	if existing then
		existing.LastTouched = now
		return existing
	end
	local min = Vector3.new(
		ZONE_MIN.X + cx * D.CHUNK,
		S - math.min((cy + 1) * D.CHUNK_Y, TOTAL_DEPTH - BOTTOM_FLOOR),
		ZONE_MIN.Z + cz * D.CHUNK
	)
	local max = Vector3.new(
		math.min(ZONE_MIN.X + (cx + 1) * D.CHUNK, ZONE_MAX.X),
		S - math.max(cy * D.CHUNK_Y, D.MIN_DEPTH),
		math.min(ZONE_MIN.Z + (cz + 1) * D.CHUNK, ZONE_MAX.Z)
	)
	local centreDepth = S - (min.Y + max.Y) / 2
	local density = Finds.Density(Config.GetLayerIndexAtDepth(centreDepth))
	-- scale by the chunk's real volume (edge chunks are thinner)
	local volume = (max.X - min.X) * (max.Y - min.Y) * (max.Z - min.Z)
	density *= math.clamp(volume / (D.CHUNK * D.CHUNK * D.CHUNK_Y), 0, 1)
	local target = math.floor(density) + (if rng:NextNumber() < density % 1 then 1 else 0)
	local chunk: Chunk = {
		Key = key,
		CX = cx,
		CY = cy,
		CZ = cz,
		Min = min,
		Max = max,
		Target = math.min(target, D.CHUNK_CAP),
		Deposits = {},
		LastTouched = now,
		LastRespawn = now,
	}
	chunks[key] = chunk
	chunkCount += 1
	makeRoom(chunk.Target, chunk)
	for _ = 1, chunk.Target do
		growOne(chunk)
	end
	return chunk
end

-- Every chunk overlapping the box [min, max] (seeded on first touch).
local function chunksIn(minV: Vector3, maxV: Vector3): { Chunk }
	local ax, ay, az = chunkCoords(Vector3.new(minV.X, maxV.Y, minV.Z))
	local bx, by, bz = chunkCoords(Vector3.new(maxV.X, minV.Y, maxV.Z))
	local list = {}
	for cy = math.max(ay, 0), math.min(by, NY - 1) do
		for cz = math.max(az, 0), math.min(bz, NZ - 1) do
			for cx = math.max(ax, 0), math.min(bx, NX - 1) do
				local chunk = getChunk(cx, cy, cz)
				if chunk then
					table.insert(list, chunk)
				end
			end
		end
	end
	return list
end

local function boxDistance(p: Vector3, minV: Vector3, maxV: Vector3): number
	local dx = math.max(minV.X - p.X, 0, p.X - maxV.X)
	local dy = math.max(minV.Y - p.Y, 0, p.Y - maxV.Y)
	local dz = math.max(minV.Z - p.Z, 0, p.Z - maxV.Z)
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function removeDeposit(deposit: Deposit): boolean
	local chunk = chunks[deposit.ChunkKey]
	if not chunk then
		return false
	end
	local index = table.find(chunk.Deposits, deposit)
	if not index then
		return false
	end
	table.remove(chunk.Deposits, index)
	depositTotal -= 1
	chunk.LastRespawn = os.clock()
	return true
end

-- Deposits ----------------------------------------------------------------------------------------

function DiscoveryService.Seed(position: Vector3): number
	local chunk = getChunk(chunkCoords(position))
	return if chunk then #chunk.Deposits else 0
end

function DiscoveryService.DepositsNear(position: Vector3, radius: number): { Deposit }
	local r = Vector3.new(radius, radius, radius)
	local list = {}
	for _, chunk in chunksIn(position - r, position + r) do
		for _, deposit in chunk.Deposits do
			if (deposit.Position - position).Magnitude <= radius then
				table.insert(list, deposit)
			end
		end
	end
	return list
end

function DiscoveryService.CountDeposits(): number
	return depositTotal
end

function DiscoveryService.ChunkCount(): number
	return chunkCount
end

function DiscoveryService.ChunkCap(position: Vector3): (number, number)
	local chunk = getChunk(chunkCoords(position))
	return if chunk then #chunk.Deposits else 0, if chunk then chunk.Target else 0
end

-- Tests / dev: put a deposit with this treasure at `position` (in its chunk, ignoring the cap).
function DiscoveryService.AddDeposit(position: Vector3, treasureId: string): Deposit?
	local chunk = getChunk(chunkCoords(position))
	if not chunk then
		return nil
	end
	return addTo(chunk :: Chunk, position, treasureId)
end

function DiscoveryService.SetSeed(seed: number)
	rng = Random.new(seed)
end

-- Respawn + eviction pass (every MAINTAIN_INTERVAL seconds).
function DiscoveryService.Maintain(nowArg: number?)
	local now = nowArg or os.clock()
	local roots: { Vector3 } = {}
	for _, player in Players:GetPlayers() do
		local root = Net.GetRoot(player)
		if root then
			table.insert(roots, root.Position)
		end
	end
	local evict: { Chunk } = {}
	for _, chunk in chunks do
		local near = false
		for _, pos in roots do
			if boxDistance(pos, chunk.Min, chunk.Max) <= D.DETECTOR_RANGE then
				near = true
				chunk.LastTouched = now
				break
			end
		end
		if not near and now - chunk.LastTouched >= D.EVICT_SECONDS then
			table.insert(evict, chunk)
		elseif #chunk.Deposits < chunk.Target and now - chunk.LastRespawn >= D.RESPAWN_SECONDS then
			chunk.LastRespawn = now
			growOne(chunk)
		end
	end
	for _, chunk in evict do
		forget(chunk)
	end
end

-- Find models -----------------------------------------------------------------------------------

local function getFolder(): Folder
	local current = folder
	if current and current.Parent then
		return current
	end
	local f = Instance.new("Folder")
	f.Name = "DiscoveryFinds"
	f.Parent = Workspace
	folder = f
	return f
end

-- Where a find emerges: the dug floor inside the carved box, nearest the deposit (raycast for the
-- VISIBLE terrain surface, standing rule 1). Falls back to the carve floor.
local function emergePoint(deposit: Vector3, minV: Vector3?, maxV: Vector3?): Vector3
	if not minV or not maxV then
		local hit = Workspace:Raycast(deposit + Vector3.new(0, 6, 0), Vector3.new(0, -12, 0), terrainOnly)
		return if hit then hit.Position else deposit
	end
	local lo, hi = minV :: Vector3, maxV :: Vector3
	local x = math.clamp(deposit.X, lo.X + 1, math.max(lo.X + 1, hi.X - 1))
	local z = math.clamp(deposit.Z, lo.Z + 1, math.max(lo.Z + 1, hi.Z - 1))
	local top = hi.Y + 2
	local hit = Workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, -(top - lo.Y) - 6, 0), terrainOnly)
	return if hit then hit.Position else Vector3.new(x, lo.Y + 1, z)
end

local function spawnModel(ex: Excavation, tier: Types.FindTier): Model?
	local ok, result = pcall(function(): Model
		return Models.Find(ex.TreasureId, ex.Size, ex.Material)
	end)
	if not ok then
		warn("[DiscoveryService] find model failed: " .. tostring(result))
		return nil
	end
	local model = result :: Model
	local size = Finds.GetSize(ex.Size)
	local scale = if size and size.Scale then size.Scale else 1
	local rise = 1.2 * scale + 0.4
	model.Name = "Find_" .. ex.Id
	model:PivotTo(CFrame.new(ex.Position + Vector3.new(0, 0.75 * scale - rise, 0)))
	model:SetAttribute("FindId", ex.Id)
	model:SetAttribute("TreasureId", ex.TreasureId)
	model:SetAttribute("Rarity", ex.Rarity)
	model:SetAttribute("Size", ex.Size)
	model:SetAttribute("Material", ex.Material)
	model:SetAttribute("OwnerId", ex.Player.UserId)
	model:SetAttribute("Stage", "Excavating")
	model:SetAttribute("Rise", rise)
	model:SetAttribute("Tier", tier)
	-- Mythic / Relic: the sky beam is for the whole server, so never stream the model out.
	model.ModelStreamingMode = if Finds.TierOrder(tier) >= Finds.TierOrder("Server")
		then Enum.ModelStreamingMode.Persistent
		else Enum.ModelStreamingMode.Atomic
	model.Parent = getFolder()
	CollectionService:AddTag(model, TAG)
	return model
end

-- Excavation ---------------------------------------------------------------------------------------

local function luckOf(player: Player): number
	local ctx = MultiplierService.GetContext(player)
	return if ctx then Stats.GetLuck(ctx :: Stats.Context) else 1
end

local function startExcavation(
	player: Player,
	treasureId: string,
	position: Vector3,
	forceSize: string?,
	forceMaterial: string?
): string?
	if excavations[player] then
		return nil
	end
	local found = Config.GetTreasure(treasureId)
	if not found then
		return nil
	end
	local def = found :: Types.TreasureDef
	local luck = luckOf(player)
	nextExcavationId += 1
	local ex: Excavation = {
		Id = "x" .. nextExcavationId,
		Player = player,
		TreasureId = treasureId,
		Rarity = def.Rarity,
		Size = if forceSize and Finds.IsSize(forceSize)
			then forceSize :: string
			else Finds.RollVariant("Size", luck, rng:NextNumber()),
		Material = if forceMaterial and Finds.IsMaterial(forceMaterial)
			then forceMaterial :: string
			else Finds.RollVariant("Material", luck, rng:NextNumber()),
		Position = position,
		Started = os.clock(),
		Model = nil,
		Resolved = false,
	}
	excavations[player] = ex
	ex.Model = spawnModel(ex, Finds.Tier(ex.Rarity, ex.Size, ex.Material))
	local info: Types.ExcavationInfo = {
		Id = ex.Id,
		Position = position,
		Signal = Finds.Signal(ex.Rarity),
		Rings = D.RINGS,
		RingSeconds = D.RING_SECONDS,
		RingGap = D.RING_GAP,
		PerfectWindow = D.PERFECT_WINDOW,
		GoodWindow = D.GOOD_WINDOW,
		Timeout = D.EXCAVATION_TIMEOUT,
	}
	Net.FireClient("ExcavationStart", player, info)
	task.delay(D.EXCAVATION_TIMEOUT, function()
		if excavations[player] == ex and not ex.Resolved then
			DiscoveryService.Resolve(player, ex.Id, nil)
		end
	end)
	return ex.Id
end

-- Award a find to the player's data. Returns (isNew, newVariants, value).
local function award(
	player: Player,
	treasureId: string,
	size: string,
	material: string,
	quality: string
): (boolean, { string }, number)
	local data = DataService.Get(player)
	if not data then
		return false, {}, 0
	end
	local d0 = data :: Types.PlayerData
	local isNew = d0.Index[treasureId] ~= true
	local newVariants: { string } = {}
	for _, variant in { size, material } do
		if d0.FindVariants[Finds.VariantKey(treasureId, variant)] ~= true then
			table.insert(newVariants, variant)
		end
	end
	local value = Finds.Value(treasureId, size, material, quality, d0.MaxDepth)
	DataService.Mutate(player, { "Finds", "Index", "FindVariants" }, function(d)
		local key = Finds.Key(treasureId, size, material, quality)
		d.Finds[key] = (d.Finds[key] or 0) + 1
		d.Index[treasureId] = true
		d.FindVariants[Finds.VariantKey(treasureId, size)] = true
		d.FindVariants[Finds.VariantKey(treasureId, material)] = true
	end)
	return isNew, newVariants, value
end

local function afterFind(player: Player, info: Types.FindInfo)
	local rarity = Config.GetRarity(info.Rarity)
	Analytics.Funnel(player, Analytics.Steps.FirstFind)
	if rarity and rarity.Order >= 3 then
		Analytics.Funnel(player, Analytics.Steps.FirstRareFind)
	end
	if info.Perfect then
		Analytics.Funnel(player, Analytics.Steps.FirstPerfectExcavation)
	end
	Analytics.Custom(player, "Find", info.Rarity, info.Size .. "/" .. info.Material, info.Quality)
	if rarity and rarity.Announce then
		Net.NotifyAll(
			"Announce",
			string.format(
				"%s found a %s %s!",
				player.DisplayName,
				string.upper(info.Rarity),
				Finds.DisplayName(info.TreasureId, info.Size, info.Material)
			)
		)
	end
	ServerSignals.TreasureFound:Fire(player, info.TreasureId)
end

function DiscoveryService.GetExcavation(player: Player): Excavation?
	return excavations[player]
end

-- Resolve the player's excavation `id` with the client's ring timing errors (nil = no answer).
function DiscoveryService.Resolve(player: Player, id: string, errors: any): Types.FindInfo?
	local ex = excavations[player]
	if not ex or ex.Id ~= id or ex.Resolved then
		return nil
	end
	ex.Resolved = true
	excavations[player] = nil
	local score, perfects = Finds.Score(errors)
	local quality = Finds.QualityForScore(score)
	if os.clock() - ex.Started < D.MIN_EXCAVATION_SECONDS and quality == "Pristine" then
		quality = "Good" -- impossibly fast answer: no Pristine
	end
	local perfect = perfects >= D.RINGS and quality == "Pristine"
	local isNew, newVariants, value = award(player, ex.TreasureId, ex.Size, ex.Material, quality)
	local tier = Finds.Tier(ex.Rarity, ex.Size, ex.Material)
	local info: Types.FindInfo = {
		Id = ex.Id,
		TreasureId = ex.TreasureId,
		Rarity = ex.Rarity,
		Size = ex.Size,
		Material = ex.Material,
		Quality = quality,
		Value = value,
		Tier = tier,
		IsNew = isNew,
		NewVariants = newVariants,
		Perfect = perfect,
		Ambient = false,
		Position = ex.Position,
	}
	Net.FireClient("FindRevealed", player, info)
	local model = ex.Model
	if model and model.Parent then
		model:SetAttribute("Quality", quality)
		model:SetAttribute("Stage", "Revealed")
		local hold = if Finds.TierOrder(tier) >= Finds.TierOrder("Server")
			then D.SPECTACLE_SECONDS
			else D.REVEAL_SECONDS
		task.delay(hold, function()
			if model.Parent then
				model:Destroy()
			end
		end)
	end
	afterFind(player, info)
	return info
end

-- Uncover `deposit` for `player` (removes it from the hash). Returns the excavation id.
-- forceSize / forceMaterial: dev command / tests only.
function DiscoveryService.Uncover(
	player: Player,
	deposit: Deposit,
	carvedMin: Vector3?,
	carvedMax: Vector3?,
	forceSize: string?,
	forceMaterial: string?
): string?
	if excavations[player] then
		return nil
	end
	if not removeDeposit(deposit) then
		return nil
	end
	local at = emergePoint(deposit.Position, carvedMin, carvedMax)
	return startExcavation(player, deposit.TreasureId, at, forceSize, forceMaterial)
end

-- Ambient popcorn: a plain Common find from the layer, straight into Finds (no excavation).
local function ambientFind(player: Player, layerIndex: number, position: Vector3)
	local layer = Config.Layers[layerIndex]
	local commons = {}
	for _, entry in layer.LootTable do
		local def = Config.GetTreasure(entry.TreasureId)
		if def and def.Rarity == "Common" then
			table.insert(commons, def.Id)
		end
	end
	if #commons == 0 then
		return
	end
	local id = commons[rng:NextInteger(1, #commons)]
	local isNew, newVariants, value = award(player, id, "Normal", "None", "Good")
	local info: Types.FindInfo = {
		Id = "",
		TreasureId = id,
		Rarity = "Common",
		Size = "Normal",
		Material = "None",
		Quality = "Good",
		Value = value,
		Tier = "Pop",
		IsNew = isNew,
		NewVariants = newVariants,
		Perfect = false,
		Ambient = true,
		Position = position,
	}
	Net.FireClient("FindRevealed", player, info)
	afterFind(player, info)
end

local function hasEverFound(data: Types.PlayerData): boolean
	return next(data.Index) ~= nil or next(data.FindVariants) ~= nil
end

-- Only the player's own digging finds things: companion / bot digs (Pet, Digger, Ride, and any
-- Silent dig, which DigService does not even report) never uncover, roll ambient finds or pop UI.
local FINDING_SOURCES: { [string]: boolean } = { Shovel = true, Auto = true }

local function onCarved(player: Player, minV: Vector3, maxV: Vector3, source: string, layerIndex: number)
	if not FINDING_SOURCES[source] then
		return
	end
	local data = DataService.Get(player)
	if not data then
		return
	end
	sessionDigs[player] = (sessionDigs[player] or 0) + 1
	if excavations[player] then
		return -- one excavation at a time; deposits wait for the next dig
	end
	local centre = (minV + maxV) / 2
	-- nearest deposit within UNCOVER_RADIUS of the carved box
	local r = Vector3.new(D.UNCOVER_RADIUS, D.UNCOVER_RADIUS, D.UNCOVER_RADIUS)
	local best: Deposit? = nil
	local bestDistance = math.huge
	for _, chunk in chunksIn(minV - r, maxV + r) do
		for _, deposit in chunk.Deposits do
			if boxDistance(deposit.Position, minV, maxV) <= D.UNCOVER_RADIUS then
				local dist = (deposit.Position - centre).Magnitude
				if dist < bestDistance then
					best = deposit
					bestDistance = dist
				end
			end
		end
	end
	if best then
		DiscoveryService.Uncover(player, best :: Deposit, minV, maxV)
		return
	end
	-- FTUE: the first find is guaranteed early (a Common from this layer, right here)
	if sessionDigs[player] == D.FTUE_FIND_DIG and not hasEverFound(data :: Types.PlayerData) then
		for _, entry in Config.Layers[layerIndex].LootTable do
			local def = Config.GetTreasure(entry.TreasureId)
			if def and def.Rarity == "Common" then
				startExcavation(player, def.Id, emergePoint(centre, minV, maxV))
				return
			end
		end
	end
	local ctx = MultiplierService.GetContext(player)
	if ctx and rng:NextNumber() < Stats.GetTreasureChance(ctx :: Stats.Context, layerIndex) * D.AMBIENT_FACTOR then
		ambientFind(player, layerIndex, centre)
	end
end

-- Detector -------------------------------------------------------------------------------------------

function DiscoveryService.PingFor(player: Player): Types.DetectorPing
	local scan = scans[player]
	local remaining = if scan then math.max(0, scan.Until - os.clock()) else 0
	local root = Net.GetRoot(player)
	if not root then
		return Finds.Ping(nil, nil, remaining)
	end
	local pos = (root :: BasePart).Position
	local best: Deposit? = nil
	local bestDistance = math.huge
	if World.IsInDigZone(pos) or (pos.Y > S - 2 and World.IsInDigZone(World.ClampToDigZone(pos))) then
		local range = D.DETECTOR_RANGE
		local r = Vector3.new(range, range, range)
		for _, chunk in chunksIn(pos - r, pos + r) do
			for _, deposit in chunk.Deposits do
				local dist = (deposit.Position - pos).Magnitude
				if dist < bestDistance then
					best = deposit
					bestDistance = dist
				end
			end
		end
	end
	if not best then
		return Finds.Ping(nil, nil, remaining)
	end
	local b = best :: Deposit
	return Finds.Ping(b.Position - pos, b.Rarity, remaining)
end

local function onScan(player: Player)
	local now = os.clock()
	local scan = scans[player]
	if scan and now - scan.Started < D.SCAN_COOLDOWN then
		return
	end
	scans[player] = { Started = now, Until = now + D.SCAN_SECONDS }
	Net.FireClient("DetectorPing", player, DiscoveryService.PingFor(player))
end

local function pingTick()
	local now = os.clock()
	for player, scan in scans do
		if now >= scan.Until + D.PING_INTERVAL then
			continue
		end
		Net.FireClient("DetectorPing", player, DiscoveryService.PingFor(player))
	end
end

-- Lifecycle ------------------------------------------------------------------------------------------

function DiscoveryService.Init()
	ServerSignals.Carved:Connect(function(player: Player, minV: Vector3, maxV: Vector3, source: string, layer: number)
		local ok, err = pcall(function(): any
			onCarved(player, minV, maxV, source, layer)
			return nil
		end)
		if not ok then
			warn("[DiscoveryService] carve error: " .. tostring(err))
		end
	end)
	Net.On("Scan", onScan, { Rate = 3, Window = 1 })
	Net.On("Excavate", function(player: Player, id: any, errors: any)
		if not Net.IsString(id, 16) then
			return
		end
		if errors ~= nil and type(errors) ~= "table" then
			return
		end
		DiscoveryService.Resolve(player, id :: string, errors)
	end, { Rate = 4, Window = 1 })
end

function DiscoveryService.Start()
	task.spawn(function()
		while true do
			task.wait(D.PING_INTERVAL)
			local ok, err = pcall(function(): any
				pingTick()
				return nil
			end)
			if not ok then
				warn("[DiscoveryService] ping error: " .. tostring(err))
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(MAINTAIN_INTERVAL)
			local ok, err = pcall(function(): any
				DiscoveryService.Maintain(nil)
				return nil
			end)
			if not ok then
				warn("[DiscoveryService] maintain error: " .. tostring(err))
			end
		end
	end)
end

function DiscoveryService.OnPlayerRemoving(player: Player)
	local ex = excavations[player]
	if ex and not ex.Resolved then
		DiscoveryService.Resolve(player, ex.Id, nil) -- a find is never lost (saved as Damaged)
	end
	excavations[player] = nil
	scans[player] = nil
	sessionDigs[player] = nil
end

return DiscoveryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EconomyService — selling sand (and unsold treasures) for Coins.

	Sources of a sell:
	  - touching any part tagged "SellZone" (CollectionService; debounced per player, distance
	    checked against the part so spoofed touches from far away are ignored),
	  - SetSetting("SellNow", true) — the Sell Anywhere pass OR the Sell Anywhere rebirth perk
	    (v2.2, Config.RebirthPerks; EconomyService.CanSellAnywhere).
	Coins = floor((Sand * SELL_RATE + sum(treasure SellValue * count) + v3 finds value) * coin multiplier)
	(finds: Util/Finds.TotalValue = base x size x material x quality, see docs/design/Discovery.md)
	(coin multiplier = CoinBoost x Golden Hour, see Stats.GetCoinMultiplier).
	Client feedback: Notify("Sell", "+1.2K Coins!") + DataChanged.

	Public API:
		EconomyService.Sell(player, source): number   (coins earned; source "Zone" | "Anywhere")
		EconomyService.CanSellAnywhere(player): boolean (pass or perk)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Stats = require(Shared.Util.Stats)

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local MonetizationService = require(script.Parent.MonetizationService)
local MultiplierService = require(script.Parent.MultiplierService)
local Net = require(script.Parent.Net)
local ServerSignals = require(script.Parent.ServerSignals)
local SettingsService = require(script.Parent.SettingsService)

local ZONE_DEBOUNCE = 1
local SELL_ANYWHERE_COOLDOWN = 1
local ZONE_DISTANCE_SLACK = 12

local EconomyService = {}

local lastZoneSell: { [Player]: number } = {}
local lastAnywhereSell: { [Player]: number } = {}
local connectedZones: { [BasePart]: boolean } = {}

function EconomyService.Sell(player: Player, source: string): number
	local data = DataService.Get(player)
	local ctx = MultiplierService.GetContext(player)
	if not data or not ctx then
		return 0
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(ctx) -- refine for the type checker (guarded above)
	local hasTreasure = false
	for _, count in data.Treasures do
		if count > 0 then
			hasTreasure = true
			break
		end
	end
	for _, count in data.Finds do -- v3 discovery finds
		if count > 0 then
			hasTreasure = true
			break
		end
	end
	if data.Sand <= 0 and not hasTreasure then
		return 0
	end

	local coins = Stats.GetSellValue(ctx)
	local sand = data.Sand
	DataService.Mutate(player, { "Coins", "Sand", "Treasures", "Finds" }, function(d)
		d.Coins += coins
		d.Sand = 0
		d.Treasures = {}
		d.Finds = {}
	end)

	Net.Notify(player, "Sell", "+" .. Format.Abbreviate(coins) .. " Coins!")
	Analytics.Source(
		player,
		"Coins",
		coins,
		data.Coins,
		Enum.AnalyticsEconomyTransactionType.Gameplay,
		"Sell:" .. source
	)
	Analytics.Funnel(player, Analytics.Steps.FirstSell)
	ServerSignals.Sold:Fire(player, coins, sand)
	return coins
end

local function onZoneTouched(zone: BasePart, hit: BasePart)
	local player = Net.GetPlayerFromPart(hit)
	if not player then
		return
	end
	assert(player) -- refine for the type checker (guarded above)
	local now = os.clock()
	local last = lastZoneSell[player]
	if last and now - last < ZONE_DEBOUNCE then
		return
	end
	local root = Net.GetRoot(player)
	if not root then
		return
	end
	assert(root) -- refine for the type checker (guarded above)
	-- Reject touches reported far from the zone (exploit: firetouchinterest from anywhere).
	local maxDistance = zone.Size.Magnitude / 2 + ZONE_DISTANCE_SLACK
	if (root.Position - zone.Position).Magnitude > maxDistance then
		return
	end
	lastZoneSell[player] = now
	EconomyService.Sell(player, "Zone")
end

local function connectZone(instance: Instance)
	if not instance:IsA("BasePart") or connectedZones[instance] then
		return
	end
	local zone = instance :: BasePart
	connectedZones[zone] = true
	zone.Touched:Connect(function(hit: BasePart)
		onZoneTouched(zone, hit)
	end)
	zone.Destroying:Connect(function()
		connectedZones[zone] = nil
	end)
end

-- v2.2: the game pass (early shortcut) or the earned Sell Anywhere rebirth perk.
function EconomyService.CanSellAnywhere(player: Player): boolean
	if MonetizationService.OwnsPass(player, "SellAnywhere") then
		return true
	end
	local data = DataService.Get(player)
	return data ~= nil and Config.RebirthPerks.HasSellAnywhere(data.RebirthPerks)
end

local function onSellNow(player: Player, _value: any)
	if not EconomyService.CanSellAnywhere(player) then
		Net.NotifyThrottled(player, "Error", "Get Sell Anywhere to sell from here!", "SellAnywhere", 2)
		return
	end
	local now = os.clock()
	local last = lastAnywhereSell[player]
	if last and now - last < SELL_ANYWHERE_COOLDOWN then
		return
	end
	lastAnywhereSell[player] = now
	if EconomyService.Sell(player, "Anywhere") == 0 then
		Net.NotifyThrottled(player, "Info", "Nothing to sell yet - go dig!", "NothingToSell", 2)
	end
end

function EconomyService.Init()
	SettingsService.RegisterAction("SellNow", onSellNow)
end

-- Touched is unreliable when the pad sits at or under the smooth-terrain surface, so also sell
-- to anyone standing over a zone (checked a few times per second).
local POLL_INTERVAL = 0.25
local function isOverZone(zone: BasePart, position: Vector3): boolean
	local rel = zone.CFrame:PointToObjectSpace(position)
	return math.abs(rel.X) <= zone.Size.X / 2 + 1
		and math.abs(rel.Z) <= zone.Size.Z / 2 + 1
		and rel.Y > -3
		and rel.Y < 8
end

local function pollZones()
	for _, player in Players:GetPlayers() do
		local root = Net.GetRoot(player)
		if root then
			for zone in connectedZones do
				if isOverZone(zone, root.Position) then
					onZoneTouched(zone, root)
					break
				end
			end
		end
	end
end

function EconomyService.Start()
	task.spawn(function()
		while true do
			task.wait(POLL_INTERVAL)
			pollZones()
		end
	end)
	for _, instance in CollectionService:GetTagged("SellZone") do
		connectZone(instance)
	end
	CollectionService:GetInstanceAddedSignal("SellZone"):Connect(connectZone)
end

function EconomyService.OnPlayerRemoving(player: Player)
	lastZoneSell[player] = nil
	lastAnywhereSell[player] = nil
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EventService — server-wide timed events (Config.Events: High Tide, Golden Hour).
	Events are deterministic from os.time() (Config.GetActiveEvents), so every server agrees.
	When the active set changes the service:
	  - sets Workspace attribute "ActiveEvents" = comma separated ids ("" when none),
	  - fires EventChanged(activeIds) to all clients (and to each player on join),
	  - notifies everyone ("Event" kind) when an event starts,
	  - fires EventService.Changed for server consumers (MultiplierService).

	Public API:
		EventService.GetActiveIds(): { string }
		EventService.IsActive(eventId): boolean
		EventService.Changed: Signal<{ string }>
		EventService.StartEarly(eventId, seconds): boolean
			Starts an event now for `seconds` on THIS server (server dig goal, v2.2), on top of
			the deterministic schedule. Sets Workspace attribute "EventEnds_<id>" = unix end time
			(cleared when it ends) so clients count down the real remaining time. If the event
			is already running it is extended to last at least `seconds` more. Returns false for
			an unknown id or a non-positive duration.
		EventService.GetSecondsLeft(eventId): number   (0 when inactive)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Signal = require(Shared.Util.Signal)

local Net = require(script.Parent.Net)

local EventService = {}

EventService.Changed = Signal.new() :: Signal.Signal<{ string }>

local activeIds: { string } = {}
local activeKey = ""
local forcedUntil: { [string]: number } = {} -- event id -> unix end time (StartEarly)

local function compute(): ({ string }, string)
	local now = os.time()
	local ids = {}
	for _, event in Config.GetActiveEvents(now) do
		table.insert(ids, event.Id)
	end
	for id, ends in forcedUntil do
		if ends <= now then
			forcedUntil[id] = nil
			Workspace:SetAttribute("EventEnds_" .. id, nil)
		elseif not table.find(ids, id) then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	return ids, table.concat(ids, ",")
end

local function update(announce: boolean)
	local ids, key = compute()
	if key == activeKey then
		return
	end
	local previous = {}
	for _, id in activeIds do
		previous[id] = true
	end
	activeIds = ids
	activeKey = key
	Workspace:SetAttribute("ActiveEvents", key)
	Net.FireAll("EventChanged", table.clone(ids))
	if announce then
		for _, id in ids do
			local def = Config.GetEvent(id)
			if def and not previous[id] then
				Net.NotifyAll("Event", string.upper(def.Name) .. "! " .. def.Description)
			end
		end
	end
	EventService.Changed:Fire(table.clone(ids))
end

function EventService.GetActiveIds(): { string }
	return table.clone(activeIds)
end

function EventService.IsActive(eventId: string): boolean
	return table.find(activeIds, eventId) ~= nil
end

function EventService.GetSecondsLeft(eventId: string): number
	if not EventService.IsActive(eventId) then
		return 0
	end
	local now = os.time()
	local forced = forcedUntil[eventId]
	local scheduled = 0
	local def = Config.GetEvent(eventId)
	if def and Config.GetSecondsUntilEvent(eventId, now) == 0 then
		scheduled = def.DurationSeconds - (now + def.OffsetSeconds) % def.IntervalSeconds
	end
	return math.max(scheduled, if forced then forced - now else 0)
end

function EventService.StartEarly(eventId: string, seconds: number): boolean
	if not Config.GetEvent(eventId) or not (seconds > 0) then
		return false
	end
	local now = os.time()
	local ends = math.max(now + math.floor(seconds), now + EventService.GetSecondsLeft(eventId))
	forcedUntil[eventId] = ends
	Workspace:SetAttribute("EventEnds_" .. eventId, ends)
	update(true)
	return true
end

function EventService.Init()
	Workspace:SetAttribute("ActiveEvents", "")
	update(false)
end

function EventService.Start()
	task.spawn(function()
		while true do
			task.wait(1)
			update(true)
		end
	end)
end

function EventService.OnPlayerAdded(player: Player)
	Net.FireClient("EventChanged", player, table.clone(activeIds))
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">LaunchCheck</string>
            <string name="Source"><![CDATA[--!strict
--[[
	LaunchCheck — lists what still needs the owner's Creator Hub ids or assets before launch
	(docs/LAUNCH.md). Pure read of Config, so tools/preflight.sh prints the same report.

	Blocking: things that would be wrong in a live server (a Studio-only switch left on).
	Missing:  placeholders the game tolerates (id 0 = hidden/skipped, "" = silent), listed so
	          nothing is forgotten.
	Live servers warn once at boot with a one-line summary (visible in the Developer Console);
	Studio prints it as info. Nothing here changes gameplay.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local IconAtlas = require(ReplicatedStorage.Shared.Config.IconAtlas) :: any
local MonetizationService = require(script.Parent.MonetizationService)

local LaunchCheck = {}

export type Report = { Blocking: { string }, Missing: { string } }

local function sortedKeys(t: { [string]: any }): { string }
	local keys = {}
	for key in t do
		table.insert(keys, key)
	end
	table.sort(keys)
	return keys
end

function LaunchCheck.Report(): Report
	local blocking: { string } = {}
	local missing: { string } = {}

	if MonetizationService.STUDIO_GRANT_ALL_PASSES then
		table.insert(blocking, "MonetizationService.STUDIO_GRANT_ALL_PASSES is true (set it back to false)")
	end

	local monetization = Config.Monetization :: any
	for _, group in { "GamePasses", "Products" } do
		local unset = {}
		for _, key in sortedKeys(monetization[group]) do
			if monetization[group][key].Id == 0 then
				table.insert(unset, key)
			end
		end
		if #unset > 0 then
			table.insert(missing, ("%s ids (%d): %s"):format(group, #unset, table.concat(unset, ", ")))
		end
	end

	local badges = {}
	for _, badge in Config.Badges do
		if badge.Id == 0 then
			table.insert(badges, badge.Key)
		end
	end
	if #badges > 0 then
		table.insert(missing, ("Badge ids (%d): %s"):format(#badges, table.concat(badges, ", ")))
	end

	if Config.GROUP_ID == 0 then
		local groupCodes = {}
		for _, code in Config.Codes do
			if code.Enabled and code.GroupOnly then
				table.insert(groupCodes, code.Code)
			end
		end
		table.insert(
			missing,
			"GROUP_ID (group sand bonus off"
				.. (if #groupCodes > 0 then "; group-only codes unusable: " .. table.concat(groupCodes, ", ") else "")
				.. ")"
		)
	end

	local sounds = {}
	for _, key in sortedKeys(Config.Sounds :: any) do
		if (Config.Sounds :: any)[key].Id == "" then
			table.insert(sounds, key)
		end
	end
	if #sounds > 0 then
		table.insert(missing, ("Owned audio ids: %s"):format(table.concat(sounds, ", ")))
	end

	if IconAtlas.AssetId == "" then
		table.insert(missing, "IconAtlas.AssetId (UI falls back to emoji icons)")
	end

	return { Blocking = blocking, Missing = missing }
end

function LaunchCheck.Format(report: Report): string
	local lines = {}
	for _, line in report.Blocking do
		table.insert(lines, "BLOCKING  " .. line)
	end
	for _, line in report.Missing do
		table.insert(lines, "missing   " .. line)
	end
	if #lines == 0 then
		return "everything configured"
	end
	return table.concat(lines, "\n")
end

function LaunchCheck.Run()
	local report = LaunchCheck.Report()
	if #report.Blocking == 0 and #report.Missing == 0 then
		return
	end
	if RunService:IsStudio() then
		print("[LaunchCheck] not configured yet (docs/LAUNCH.md):\n" .. LaunchCheck.Format(report))
	else
		warn(
			("[LaunchCheck] %d blocking, %d placeholders not configured (docs/LAUNCH.md): %s"):format(
				#report.Blocking,
				#report.Missing,
				table.concat(report.Blocking, "; ")
			)
		)
	end
end

return LaunchCheck
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	LeaderboardService — the two in-world boards (parts tagged "LeaderboardCoins" /
	"LeaderboardDepth", SurfaceGui on the Front face, cartoon styling from Config.Theme).

	v2.2 scopes: both boards flip every Config.Social.Leaderboard.CycleSeconds between
	  ALL TIME     OrderedDataStores Config.LEADERBOARD_COINS_STORE (Coins) /
	               Config.LEADERBOARD_DEPTH_STORE (MaxDepth)
	  THIS WEEK    OrderedDataStores "<WeeklyPrefix>_W<ISO year>_<ISO week>" (Util/Week), e.g.
	               "Leaderboard_Sand_W2026_41" (sand dug this week, IncrementAsync of the
	               unwritten delta) and "Leaderboard_Depth_W2026_41" (deepest dig this week,
	               UpdateAsync keeping the max). A new week = a new key, so it resets by itself.
	  THIS SERVER  live, from in-memory session counters of the players in this server (sand dug
	               and deepest dig since they joined). No DataStore at all.
	The weekly and server metrics are things a brand-new player can win.

	Request budget: everything DataStore-related runs on the old cadence, once every
	Config.LEADERBOARD_REFRESH_SECONDS (60 s): per player at most 4 sorted-store writes (2 all-time
	SetAsync, 1 IncrementAsync, 1 UpdateAsync; skipped when unchanged) against a budget of
	60 + 10 x players per minute, plus 4 GetSortedAsync reads (budget 5 + 2 x players). Writes
	also check GetRequestBudgetForRequestType when available. Every call is pcall'd with one
	retry; a store that keeps failing is skipped with exponential backoff (30 s .. WriteBackoffMax).
	Scope cycling only redraws from cached entries. In Studio without DataStore access (or if a
	read fails) the board shows the players in this server instead.

	Public API (tests / other services):
		LeaderboardService.GetScope(): "AllTime" | "Week" | "Server"
		LeaderboardService.SetScope(scope)           redraw both boards in that scope now
		LeaderboardService.GetEntries(tag, scope): { { UserId, Name, Value } }
		LeaderboardService.GetSession(player): { WeekKey, WeekSand, WeekDepth, SessionSand, SessionDepth }?
		LeaderboardService.WeeklyStoreName(kind, unix?): string   (kind "Coins" | "Depth")
		LeaderboardService.Refresh()                 one write + fetch + redraw pass (yields)
]]

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Format = require(Shared.Util.Format)
local Week = require(Shared.Util.Week)

local DataService = require(script.Parent.DataService)
local ServerSignals = require(script.Parent.ServerSignals)

export type Scope = string -- "AllTime" | "Week" | "Server"
type Entry = { UserId: number, Name: string, Value: number }

type Session = {
	WeekKey: string,
	WeekSand: number, -- sand dug this ISO week in this session
	WeekSandWritten: number, -- part of WeekSand already added to the weekly store
	WeekDepth: number, -- deepest dig this week in this session
	WeekDepthWritten: number,
	SessionSand: number, -- since joining this server
	SessionDepth: number,
}

type Board = {
	Tag: string,
	Kind: "Coins" | "Depth",
	Titles: { [string]: string },
	Units: { [string]: string },
	AllTimeStoreName: string,
	AllTimeStore: OrderedDataStore?,
	AllTimeValue: (data: Types.PlayerData) -> number,
	WeekValue: (session: Session) -> number,
	ServerValue: (session: Session) -> number,
	FormatValue: (value: number) -> string,
	LastWritten: { [number]: number },
	Entries: { [string]: { Entry } },
}

local SCOPES: { Scope } = { "AllTime", "Week", "Server" }
local SCOPE_LABELS: { [string]: string } = { AllTime = "ALL TIME", Week = "THIS WEEK", Server = "THIS SERVER" }
local DISPLAY_ROWS = math.min(Config.LEADERBOARD_SIZE, 10)
local MAX_ORDERED_VALUE = 2 ^ 53
local PIXELS_PER_STUD = 50
local LB = Config.Social.Leaderboard

local LeaderboardService = {}

local nameCache: { [number]: string } = {}
local surfaces: { [BasePart]: { List: Frame, Title: TextLabel, Scope: TextLabel, ScopeBar: Frame } } = {}
local sessions: { [Player]: Session } = {}
local weeklyStores: { [string]: OrderedDataStore } = {}
type Backoff = { Until: number, Seconds: number }
local backoff: { [string]: Backoff } = {}
local storesEnabled = false
local scopeIndex = 1

local function sandFormat(value: number): string
	return Format.Abbreviate(value)
end

local boards: { Board } = {
	{
		Tag = "LeaderboardCoins",
		Kind = "Coins",
		Titles = { AllTime = "RICHEST DIGGERS", Week = "TOP SAND DIGGERS", Server = "TOP SAND DIGGERS" },
		Units = { AllTime = "coins", Week = "sand dug", Server = "sand dug" },
		AllTimeStoreName = Config.LEADERBOARD_COINS_STORE,
		AllTimeStore = nil,
		AllTimeValue = function(data: Types.PlayerData): number
			return data.Coins
		end,
		WeekValue = function(session: Session): number
			return session.WeekSand
		end,
		ServerValue = function(session: Session): number
			return session.SessionSand
		end,
		FormatValue = sandFormat,
		LastWritten = {},
		Entries = { AllTime = {}, Week = {}, Server = {} },
	},
	{
		Tag = "LeaderboardDepth",
		Kind = "Depth",
		Titles = { AllTime = "DEEPEST DIGGERS", Week = "DEEPEST DIGGERS", Server = "DEEPEST DIGGERS" },
		Units = { AllTime = "record depth", Week = "deepest dig", Server = "deepest dig" },
		AllTimeStoreName = Config.LEADERBOARD_DEPTH_STORE,
		AllTimeStore = nil,
		AllTimeValue = function(data: Types.PlayerData): number
			return data.MaxDepth
		end,
		WeekValue = function(session: Session): number
			return session.WeekDepth
		end,
		ServerValue = function(session: Session): number
			return session.SessionDepth
		end,
		FormatValue = function(value: number): string
			return Format.Depth(value)
		end,
		LastWritten = {},
		Entries = { AllTime = {}, Week = {}, Server = {} },
	},
}

local function getBoard(tag: string): Board?
	for _, board in boards do
		if board.Tag == tag then
			return board
		end
	end
	return nil
end

function LeaderboardService.WeeklyStoreName(kind: "Coins" | "Depth", unix: number?): string
	local prefix = if kind == "Coins" then LB.WeeklyPrefix.Coins else LB.WeeklyPrefix.Depth
	return prefix .. "_" .. Week.Key(unix or os.time())
end

-- Requests ------------------------------------------------------------------------------------------

local function retry<T>(attempts: number, fn: () -> T): (boolean, T?)
	for attempt = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		if attempt == attempts then
			warn("[LeaderboardService] " .. tostring(result))
		else
			task.wait(attempt * 2)
		end
	end
	return false, nil
end

-- Exponential backoff per store: true when the store may be called now.
local function available(storeName: string): boolean
	local state = backoff[storeName]
	return state == nil or os.clock() >= state.Until
end

local function record(storeName: string, ok: boolean)
	if ok then
		backoff[storeName] = nil
		return
	end
	local state: Backoff = backoff[storeName] or { Until = 0, Seconds = 15 }
	state.Seconds = math.min(state.Seconds * 2, LB.WriteBackoffMax)
	state.Until = os.clock() + state.Seconds
	backoff[storeName] = state
end

-- Remaining sorted-store write budget (math.huge when the engine can't tell us).
local function writeBudget(): number
	local ok, budget = pcall(function(): number
		return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.SetIncrementSortedAsync)
	end)
	return if ok and type(budget) == "number" then budget else math.huge
end

local function call<T>(storeName: string, fn: () -> T): (boolean, T?)
	if not available(storeName) then
		return false, nil
	end
	local ok, result = retry(2, fn)
	record(storeName, ok)
	return ok, result
end

local function weeklyStore(storeName: string): OrderedDataStore?
	if not storesEnabled then
		return nil
	end
	local cached = weeklyStores[storeName]
	if cached then
		return cached
	end
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(storeName)
	end)
	if ok and store then
		weeklyStores[storeName] = store
		return store
	end
	return nil
end

local function resolveName(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and type(name) == "string" then name else "Digger"
	nameCache[userId] = result
	return result
end

local function clampValue(value: number): number
	if value ~= value then
		return 0
	end
	return math.clamp(math.floor(value), 0, MAX_ORDERED_VALUE)
end

-- Sessions ----------------------------------------------------------------------------------------

local function newSession(): Session
	return {
		WeekKey = Week.Key(os.time()),
		WeekSand = 0,
		WeekSandWritten = 0,
		WeekDepth = 0,
		WeekDepthWritten = 0,
		SessionSand = 0,
		SessionDepth = 0,
	}
end

local function getSession(player: Player): Session
	local session = sessions[player]
	if not session then
		session = newSession()
		sessions[player] = session
	end
	return session
end

function LeaderboardService.GetSession(player: Player): Session?
	return sessions[player]
end

local function onDug(player: Player, depth: number, gained: number, _source: string)
	if type(gained) ~= "number" or gained ~= gained or player.Parent == nil then
		return
	end
	local session = getSession(player)
	local sand = math.max(gained, 0)
	session.WeekSand += sand
	session.SessionSand += sand
	if type(depth) == "number" and depth == depth then
		local d = math.max(math.floor(depth), 0)
		session.WeekDepth = math.max(session.WeekDepth, d)
		session.SessionDepth = math.max(session.SessionDepth, d)
	end
end

-- Writes ------------------------------------------------------------------------------------------

local function writeAllTime(board: Board, player: Player)
	local store = board.AllTimeStore
	local data = DataService.Get(player)
	if not store or not data then
		return
	end
	assert(store) -- refine for the type checker (guarded above)
	assert(data) -- refine for the type checker (guarded above)
	local value = clampValue(board.AllTimeValue(data))
	if board.LastWritten[player.UserId] == value or value <= 0 then
		return
	end
	local ok = call(board.AllTimeStoreName, function()
		store:SetAsync(tostring(player.UserId), value)
		return true
	end)
	if ok then
		board.LastWritten[player.UserId] = value
	end
end

-- Flush this player's weekly counters into the stores of the week they were earned in.
local function writeWeekly(player: Player, session: Session)
	local key = tostring(player.UserId)
	local delta = clampValue(session.WeekSand - session.WeekSandWritten)
	if delta > 0 then
		local name = LB.WeeklyPrefix.Coins .. "_" .. session.WeekKey
		local store = weeklyStore(name)
		if store then
			local ok = call(name, function()
				return store:IncrementAsync(key, delta)
			end)
			if ok then
				session.WeekSandWritten += delta
			end
		end
	end
	local depth = clampValue(session.WeekDepth)
	if depth > session.WeekDepthWritten then
		local name = LB.WeeklyPrefix.Depth .. "_" .. session.WeekKey
		local store = weeklyStore(name)
		if store then
			local ok = call(name, function()
				return store:UpdateAsync(key, function(old: any): any
					if type(old) == "number" and old >= depth then
						return nil -- keep the better value already stored
					end
					return depth
				end)
			end)
			if ok then
				session.WeekDepthWritten = depth
			end
		end
	end
end

-- New ISO week: start the weekly counters again (call after writeWeekly flushed the old week).
local function rollWeek(session: Session, now: number)
	local key = Week.Key(now)
	if key ~= session.WeekKey then
		session.WeekKey = key
		session.WeekSand = 0
		session.WeekSandWritten = 0
		session.WeekDepth = 0
		session.WeekDepthWritten = 0
	end
end

-- Reads -------------------------------------------------------------------------------------------

local function localEntries(valueOf: (Player) -> number?): { Entry }
	local entries = {}
	for _, player in DataService.GetLoadedPlayers() do
		local value = valueOf(player)
		if value and value > 0 then
			table.insert(entries, { UserId = player.UserId, Name = player.DisplayName, Value = clampValue(value) })
		end
	end
	table.sort(entries, function(a: Entry, b: Entry)
		return a.Value > b.Value
	end)
	return entries
end

local function allTimeLocal(board: Board): { Entry }
	return localEntries(function(player: Player): number?
		local data = DataService.Get(player)
		return if data then board.AllTimeValue(data) else nil
	end)
end

local function weekLocal(board: Board): { Entry }
	return localEntries(function(player: Player): number?
		local session = sessions[player]
		return if session then board.WeekValue(session) else nil
	end)
end

local function serverEntries(board: Board): { Entry }
	return localEntries(function(player: Player): number?
		local session = sessions[player]
		return if session then board.ServerValue(session) else nil
	end)
end

local function fetchSorted(storeName: string, store: OrderedDataStore?): { Entry }?
	if not store then
		return nil
	end
	assert(store) -- refine for the type checker (guarded above)
	local ok, page = call(storeName, function()
		local pages = store:GetSortedAsync(false, math.clamp(Config.LEADERBOARD_SIZE, 1, 100))
		return pages:GetCurrentPage()
	end)
	if not ok or type(page) ~= "table" then
		return nil
	end
	local entries = {}
	for _, item in page :: { any } do
		local userId = tonumber(item.key)
		local value = tonumber(item.value)
		if userId and value and value > 0 then
			table.insert(entries, { UserId = userId, Name = resolveName(userId), Value = value })
		end
	end
	return entries
end

function LeaderboardService.GetEntries(tag: string, scope: Scope): { Entry }
	local found = getBoard(tag)
	if found == nil then
		return {}
	end
	local board = found :: Board
	if scope == "Server" then
		return serverEntries(board)
	end
	return board.Entries[scope]
end

-- Rendering ---------------------------------------------------------------------------------------

local Theme = Config.Theme
local RANK_COLORS = {
	Theme.Colors.Gold,
	Color3.fromRGB(215, 220, 230),
	Color3.fromRGB(230, 150, 90),
}
local SCOPE_COLORS: { [string]: Color3 } = {
	AllTime = Theme.Colors.Purple,
	Week = Theme.Colors.Coral,
	Server = Theme.Colors.Palm,
}

local function corner(parent: Instance, radius: UDim)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius
	c.Parent = parent
end

local function stroke(parent: Instance, thickness: number)
	local s = Instance.new("UIStroke")
	s.Color = Theme.Colors.Stroke
	s.Thickness = thickness
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Parent = parent
end

local function label(parent: Instance, name: string, text: string, font: Enum.Font, color: Color3): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Text = text
	l.Font = font
	l.TextColor3 = color
	l.TextScaled = true
	l.Parent = parent
	return l
end

local function scopeText(scope: Scope, board: Board): string
	local text = SCOPE_LABELS[scope] .. "  -  " .. board.Units[scope]
	if scope == "Week" then
		text ..= "  (new week in " .. Format.Time(Week.SecondsLeft(os.time())) .. ")"
	end
	return text
end

local function buildSurface(part: BasePart, board: Board)
	local existing = part:FindFirstChild("LeaderboardGui")
	if existing then
		existing:Destroy()
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "LeaderboardGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = PIXELS_PER_STUD
	gui.LightInfluence = 0
	gui.Brightness = 1.5
	gui.ResetOnSpawn = false
	gui.Adornee = part

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Theme.Colors.OceanDark
	root.Parent = gui
	corner(root, Theme.CornerLarge)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.03, 0)
	padding.PaddingBottom = UDim.new(0.03, 0)
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.Parent = root

	local title = Instance.new("Frame")
	title.Name = "Title"
	title.Size = UDim2.fromScale(1, 0.12)
	title.BackgroundColor3 = Theme.Colors.Gold
	title.Parent = root
	corner(title, Theme.CornerMedium)
	stroke(title, Theme.StrokeThickness * 2)
	local titleText = label(title, "Text", board.Titles.AllTime, Theme.Fonts.Title, Theme.Colors.Text)
	titleText.Size = UDim2.fromScale(0.94, 0.8)
	titleText.Position = UDim2.fromScale(0.03, 0.1)
	stroke(titleText, Theme.StrokeThickness * 2)

	-- scope strip: "THIS WEEK - sand dug (new week in 2d 4h)" in the scope colour
	local scopeBar = Instance.new("Frame")
	scopeBar.Name = "Scope"
	scopeBar.Position = UDim2.fromScale(0.06, 0.135)
	scopeBar.Size = UDim2.fromScale(0.88, 0.07)
	scopeBar.BackgroundColor3 = SCOPE_COLORS.AllTime
	scopeBar.Parent = root
	corner(scopeBar, Theme.CornerPill)
	stroke(scopeBar, Theme.StrokeThickness * 1.5)
	local scopeLabel = label(scopeBar, "Text", scopeText("AllTime", board), Theme.Fonts.Title, Theme.Colors.Text)
	scopeLabel.Size = UDim2.fromScale(0.94, 0.78)
	scopeLabel.Position = UDim2.fromScale(0.03, 0.11)
	stroke(scopeLabel, Theme.StrokeThickness)

	local list = Instance.new("Frame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromScale(0, 0.22)
	list.Size = UDim2.fromScale(1, 0.78)
	list.Parent = root
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.01, 0)
	layout.Parent = list

	gui.Parent = part
	surfaces[part] = { List = list, Title = titleText, Scope = scopeLabel, ScopeBar = scopeBar }
end

local function renderRows(part: BasePart, board: Board, scope: Scope)
	local surface = surfaces[part]
	if not surface then
		return
	end
	surface.Title.Text = board.Titles[scope]
	surface.Scope.Text = scopeText(scope, board)
	surface.ScopeBar.BackgroundColor3 = SCOPE_COLORS[scope]
	surface.ScopeBar:SetAttribute("Scope", scope)
	local list = surface.List
	for _, child in list:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local entries = LeaderboardService.GetEntries(board.Tag, scope)
	local rowHeight = 1 / DISPLAY_ROWS - 0.01
	if #entries == 0 then
		local row = Instance.new("Frame")
		row.Name = "Empty"
		row.BackgroundTransparency = 1
		row.Size = UDim2.fromScale(1, rowHeight * 2)
		row.Parent = list
		local message = if scope == "AllTime"
			then "Start digging to get on the board!"
			else "Nobody yet - dig now to take #1!"
		local text = label(row, "Text", message, Theme.Fonts.Body, Theme.Colors.Text)
		text.Size = UDim2.fromScale(1, 1)
		stroke(text, Theme.StrokeThickness)
		return
	end
	for rank = 1, math.min(#entries, DISPLAY_ROWS) do
		local entry = entries[rank]
		local row = Instance.new("Frame")
		row.Name = "Row" .. rank
		row.LayoutOrder = rank
		row.Size = UDim2.fromScale(1, rowHeight)
		row.BackgroundColor3 = if rank % 2 == 1 then Theme.Colors.Panel else Theme.Colors.PanelAlt
		row.Parent = list
		corner(row, Theme.CornerSmall)

		local rankColor = RANK_COLORS[rank] or Theme.Colors.Ocean
		local badge = Instance.new("Frame")
		badge.Name = "Rank"
		badge.Size = UDim2.fromScale(0.12, 0.84)
		badge.Position = UDim2.fromScale(0.01, 0.08)
		badge.BackgroundColor3 = rankColor
		badge.Parent = row
		corner(badge, Theme.CornerPill)
		local rankText = label(badge, "Text", "#" .. rank, Theme.Fonts.Number, Theme.Colors.Text)
		rankText.Size = UDim2.fromScale(0.9, 0.8)
		rankText.Position = UDim2.fromScale(0.05, 0.1)
		stroke(rankText, Theme.StrokeThickness)

		local nameText = label(row, "Name", entry.Name, Theme.Fonts.Title, Theme.Colors.TextDark)
		nameText.Size = UDim2.fromScale(0.5, 0.7)
		nameText.Position = UDim2.fromScale(0.16, 0.15)
		nameText.TextXAlignment = Enum.TextXAlignment.Left

		local valueText = label(row, "Value", board.FormatValue(entry.Value), Theme.Fonts.Number, Theme.Colors.Coins)
		valueText.Size = UDim2.fromScale(0.3, 0.7)
		valueText.Position = UDim2.fromScale(0.68, 0.15)
		valueText.TextXAlignment = Enum.TextXAlignment.Right
		stroke(valueText, Theme.StrokeThickness)
	end
end

local function attach(board: Board, instance: Instance)
	if not instance:IsA("BasePart") or surfaces[instance] then
		return
	end
	local part = instance :: BasePart
	buildSurface(part, board)
	renderRows(part, board, SCOPES[scopeIndex])
	part.Destroying:Connect(function()
		surfaces[part] = nil
	end)
end

local function redraw()
	local scope = SCOPES[scopeIndex]
	for _, board in boards do
		for _, instance in CollectionService:GetTagged(board.Tag) do
			if instance:IsA("BasePart") then
				if surfaces[instance] then
					renderRows(instance :: BasePart, board, scope)
				else
					attach(board, instance)
				end
			end
		end
	end
end

function LeaderboardService.GetScope(): Scope
	return SCOPES[scopeIndex]
end

function LeaderboardService.SetScope(scope: Scope)
	scopeIndex = table.find(SCOPES, scope) or 1
	redraw()
end

-- Refresh (DataStore cadence) -------------------------------------------------------------------

function LeaderboardService.Refresh()
	local now = os.time()
	local players = DataService.GetLoadedPlayers()
	-- writes: all-time values, then weekly deltas (only what changed), within the budget
	local budget = writeBudget()
	for _, player in players do
		if budget < 4 then
			break
		end
		for _, board in boards do
			writeAllTime(board, player)
		end
		local session = sessions[player]
		if session then
			writeWeekly(player, session)
			rollWeek(session, now)
		end
		budget = writeBudget()
	end
	-- reads: all-time + this week's stores (fallback: players in this server)
	for _, board in boards do
		board.Entries.AllTime = fetchSorted(board.AllTimeStoreName, board.AllTimeStore) or allTimeLocal(board)
		local weekName = LeaderboardService.WeeklyStoreName(board.Kind, now)
		board.Entries.Week = fetchSorted(weekName, weeklyStore(weekName)) or weekLocal(board)
	end
	redraw()
end

-- Lifecycle ---------------------------------------------------------------------------------------

function LeaderboardService.Init()
	ServerSignals.Dug:Connect(onDug)
	if DataService.IsMock() then
		return
	end
	storesEnabled = true
	for _, board in boards do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(board.AllTimeStoreName)
		end)
		if ok then
			board.AllTimeStore = store
		else
			warn("[LeaderboardService] no OrderedDataStore " .. board.AllTimeStoreName .. ": " .. tostring(store))
		end
	end
end

function LeaderboardService.Start()
	for _, board in boards do
		for _, instance in CollectionService:GetTagged(board.Tag) do
			attach(board, instance)
		end
		CollectionService:GetInstanceAddedSignal(board.Tag):Connect(function(instance: Instance)
			attach(board, instance)
		end)
	end
	task.spawn(function()
		task.wait(5) -- let the first players load
		while true do
			local ok, err = pcall(function(): any
				LeaderboardService.Refresh()
				return nil
			end)
			if not ok then
				warn("[LeaderboardService] refresh failed: " .. tostring(err))
			end
			task.wait(Config.LEADERBOARD_REFRESH_SECONDS)
		end
	end)
	-- scope cycling: redraw only (cached entries + live server scope), no requests
	task.spawn(function()
		while true do
			task.wait(LB.CycleSeconds)
			scopeIndex = scopeIndex % #SCOPES + 1
			local ok, err = pcall(function(): any
				redraw()
				return nil
			end)
			if not ok then
				warn("[LeaderboardService] redraw failed: " .. tostring(err))
			end
		end
	end)
end

function LeaderboardService.OnPlayerAdded(player: Player)
	getSession(player)
end

function LeaderboardService.OnPlayerRemoving(player: Player)
	-- Final writes while data is still in memory (DataService releases after us).
	for _, board in boards do
		task.spawn(writeAllTime, board, player)
	end
	local session = sessions[player]
	sessions[player] = nil
	if session then
		task.spawn(writeWeekly, player, session)
	end
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MonetizationService — game passes, developer products, Premium.

	- Pass ownership is cached per player (UserOwnsGamePassAsync with retries on join, updated by
	  PromptGamePassPurchaseFinished). Never persisted in PlayerData. Passes with Id 0 are
	  "not configured" and always read as not owned; we never prompt id 0.
	- Replicated to the client via GetOwnedPasses() and Player attributes "Pass_<Key>" (bool),
	  plus "Premium" (bool) and "VIP" (bool, for chat tags / name colour).
	- ProcessReceipt: idempotent via the PurchaseHistory DataStore (key = PurchaseId) plus an
	  in-server guard; grants Config.Monetization.Products[key].Grant through the grant handler
	  (RewardsService.Grant, wired by Main) and saves the player's data before acknowledging.
	- v2.2 policy: PromptPass / PromptProduct refuse PaidRandom items (Config.IsPaidRandom) for
	  players PolicyService marks ArePaidRandomItemsRestricted. ProcessReceipt never checks the
	  policy: a purchase that already completed is always granted.

	Public API:
		MonetizationService.OwnsPass(player, key): boolean
		MonetizationService.GetOwnedPasses(player): { [key]: boolean }
		MonetizationService.IsPremium(player): boolean
		MonetizationService.PromptPass(player, key) / PromptProduct(player, key)
		MonetizationService.SetGrantHandler(fn)
		MonetizationService.PassesChanged: Signal<Player, string?>  (key, or nil for "all refreshed")
		MonetizationService.STUDIO_GRANT_ALL_PASSES (dev toggle, Studio only)
]]

local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Signal = require(Shared.Util.Signal)

local DataService = require(script.Parent.DataService)
local Analytics = require(script.Parent.Analytics)
local Net = require(script.Parent.Net)
local PolicyService = require(script.Parent.PolicyService)

export type GrantHandler = (player: Player, reward: Types.Reward, source: string) -> boolean

local PURCHASE_HISTORY_STORE = "PurchaseHistory_v1"

local MonetizationService = {}

-- Studio-only convenience for testing pass features. Never affects live servers.
MonetizationService.STUDIO_GRANT_ALL_PASSES = false

MonetizationService.PassesChanged = Signal.new() :: Signal.Signal<Player, string?>

local owned: { [Player]: { [string]: boolean } } = {}
local grantHandler: GrantHandler? = nil
local historyStore: DataStore? = nil
local mockHistory: { [string]: boolean } = {}
local grantedThisServer: { [string]: boolean } = {}
local processing: { [string]: boolean } = {}

local function passKeys(): { string }
	local keys = {}
	for key in Config.Monetization.GamePasses do
		table.insert(keys, key)
	end
	table.sort(keys)
	return keys
end

local PASS_KEYS = passKeys()

local function withRetries<T>(attempts: number, fn: () -> T): (boolean, T?)
	for attempt = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		if attempt < attempts then
			task.wait(attempt)
		else
			warn("[MonetizationService] " .. tostring(result))
		end
	end
	return false, nil
end

local function publish(player: Player)
	local map = owned[player]
	if not map or player.Parent == nil then
		return
	end
	for _, key in PASS_KEYS do
		player:SetAttribute("Pass_" .. key, map[key] == true)
	end
	player:SetAttribute("VIP", map.VIP == true)
end

local function refreshPremium(player: Player)
	player:SetAttribute("Premium", player.MembershipType == Enum.MembershipType.Premium)
end

local function loadPasses(player: Player)
	local map: { [string]: boolean } = {}
	owned[player] = map
	local grantAll = MonetizationService.STUDIO_GRANT_ALL_PASSES and RunService:IsStudio()
	for _, key in PASS_KEYS do
		local pass = Config.Monetization.GamePasses[key]
		if grantAll then
			map[key] = true
		elseif pass.Id ~= 0 then
			local ok, result = withRetries(3, function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and result == true and owned[player] == map then
				map[key] = true
			end
		end
	end
	publish(player)
	MonetizationService.PassesChanged:Fire(player, nil)
end

-- Public API ------------------------------------------------------------------------------------

function MonetizationService.OwnsPass(player: Player, key: string): boolean
	local map = owned[player]
	return map ~= nil and map[key] == true
end

function MonetizationService.GetOwnedPasses(player: Player): { [string]: boolean }
	local map: { [string]: boolean } = owned[player] or {}
	local result: { [string]: boolean } = {}
	for _, key in PASS_KEYS do
		result[key] = map[key] == true
	end
	return result
end

function MonetizationService.IsPremium(player: Player): boolean
	return player.MembershipType == Enum.MembershipType.Premium
end

function MonetizationService.SetGrantHandler(handler: GrantHandler)
	grantHandler = handler
end

function MonetizationService.PromptPass(player: Player, key: string): boolean
	local pass = Config.Monetization.GamePasses[key]
	if not pass then
		return false
	end
	if pass.Id == 0 then
		Net.Notify(player, "Info", pass.Name .. " is coming soon!")
		return false
	end
	if not PolicyService.CanBuy(player, "GamePass", key) then
		Net.Notify(player, "Info", pass.Name .. " isn't available for your account.")
		return false
	end
	if MonetizationService.OwnsPass(player, key) then
		Net.Notify(player, "Info", "You already own " .. pass.Name .. "!")
		return false
	end
	local ok = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	end)
	if ok then
		Analytics.PurchasePrompted(player, "Pass:" .. key)
	end
	return ok
end

function MonetizationService.PromptProduct(player: Player, key: string): boolean
	local product = Config.Monetization.Products[key]
	if not product then
		return false
	end
	if product.Id == 0 then
		Net.Notify(player, "Info", product.Name .. " is coming soon!")
		return false
	end
	if not PolicyService.CanBuy(player, "Product", key) then
		Net.Notify(player, "Info", product.Name .. " isn't available for your account.")
		return false
	end
	local ok = pcall(function()
		MarketplaceService:PromptProductPurchase(player, product.Id)
	end)
	if ok then
		Analytics.PurchasePrompted(player, "Product:" .. key)
	end
	return ok
end

-- Receipts --------------------------------------------------------------------------------------

local function isRecorded(purchaseId: string): (boolean, boolean)
	-- returns (lookupOk, alreadyGranted)
	if grantedThisServer[purchaseId] then
		return true, true
	end
	if not historyStore then
		return true, mockHistory[purchaseId] == true
	end
	local store = historyStore :: DataStore
	local ok, value = withRetries(3, function()
		return store:GetAsync(purchaseId)
	end)
	return ok, ok and value ~= nil
end

local function record(purchaseId: string, info: { [any]: any }, key: string): boolean
	if not historyStore then
		mockHistory[purchaseId] = true
		return true
	end
	local store = historyStore :: DataStore
	local ok = withRetries(4, function()
		store:SetAsync(purchaseId, {
			UserId = info.PlayerId,
			ProductId = info.ProductId,
			Key = key,
			Time = os.time(),
		}, { info.PlayerId })
		return true
	end)
	return ok
end

local function processReceipt(info: { [any]: any }): Enum.ProductPurchaseDecision
	local userId = info.PlayerId
	local productId = info.ProductId
	local purchaseId = tostring(info.PurchaseId)
	if type(userId) ~= "number" or type(productId) ~= "number" then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local key = Config.GetProductKeyById(productId)
	local product = if key then Config.Monetization.Products[key] else nil
	if not key or not product then
		warn("[MonetizationService] receipt for unknown product id " .. tostring(productId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local productKey = key :: string
	local grant = (product :: Types.ProductDef).Grant

	local player = Players:GetPlayerByUserId(userId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Roblox retries when they rejoin
	end
	if not DataService.WaitForData(player, 20) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if processing[purchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	processing[purchaseId] = true

	local decision = Enum.ProductPurchaseDecision.NotProcessedYet
	local lookupOk, already = isRecorded(purchaseId)
	if lookupOk and already then
		decision = Enum.ProductPurchaseDecision.PurchaseGranted
	elseif lookupOk then
		local granted = false
		if grantHandler then
			local ok, result = pcall(grantHandler :: GrantHandler, player, grant, "Product:" .. productKey)
			granted = ok and result == true
			if not ok then
				warn("[MonetizationService] grant failed: " .. tostring(result))
			end
		else
			warn("[MonetizationService] no grant handler registered")
		end
		if granted then
			grantedThisServer[purchaseId] = true
			Analytics.PurchaseCompleted(player, "Product:" .. productKey)
			DataService.SaveAsync(player)
			if record(purchaseId, info, productKey) then
				decision = Enum.ProductPurchaseDecision.PurchaseGranted
			end
			-- If recording failed we answer NotProcessedYet; grantedThisServer prevents a second
			-- grant when Roblox retries on this server.
		end
	end

	processing[purchaseId] = nil
	return decision
end

-- Lifecycle -------------------------------------------------------------------------------------

function MonetizationService.Init()
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(PURCHASE_HISTORY_STORE)
	end)
	if ok and not DataService.IsMock() then
		historyStore = store
	end

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(
		function(player: Player, passId: number, purchased: boolean)
			if not purchased then
				return
			end
			local key = Config.GetGamePassKeyById(passId)
			if not key then
				return
			end
			local passKey = key :: string
			local map = owned[player]
			if not map then
				map = {}
				owned[player] = map
			end
			map[passKey] = true
			publish(player)
			Net.Notify(player, "Success", "Thanks! " .. Config.Monetization.GamePasses[passKey].Name .. " unlocked!")
			Analytics.PurchaseCompleted(player, "Pass:" .. passKey)
			MonetizationService.PassesChanged:Fire(player, passKey)
		end
	)

	Players.PlayerMembershipChanged:Connect(function(player: Player)
		refreshPremium(player)
		MonetizationService.PassesChanged:Fire(player, nil)
	end)

	Net.OnInvoke("GetOwnedPasses", function(player: Player)
		return MonetizationService.GetOwnedPasses(player)
	end, {}, { Rate = 5, Window = 1 })

	Net.On("PromptPurchase", function(player: Player, kind: any, key: any)
		if not Net.IsString(key, 40) then
			return
		end
		if kind == "GamePass" then
			MonetizationService.PromptPass(player, key)
		elseif kind == "Product" then
			MonetizationService.PromptProduct(player, key)
		end
	end, { Rate = 3, Window = 2, RequireData = false })
end

function MonetizationService.Start() end

function MonetizationService.OnPlayerAdded(player: Player)
	refreshPremium(player)
	task.spawn(loadPasses, player)
end

function MonetizationService.OnPlayerRemoving(player: Player)
	owned[player] = nil
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">MultiplierService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MultiplierService — builds the authoritative Stats.Context for a player and publishes the
	results as Player attributes so the UI never has to re-derive them:
		"SandMultiplier"   number  total sand multiplier (Stats.GetSandMultiplier)
		"Capacity"         number  effective backpack capacity
		"Luck"             number  luck multiplier
		"CoinMultiplier"   number  sell multiplier (Coin boosts / Golden Hour)
		"SpeedMultiplier"  number  dig speed multiplier (cooldown divided by this)
		"PetSlots"         number  equip slots incl. ExtraPets pass
	(Player attributes "InGroup" / "FriendsInServer" are set by RewardsService, "Premium" and
	"Pass_<Key>" by MonetizationService.)

	Public API:
		MultiplierService.GetContext(player): Stats.Context?
		MultiplierService.Refresh(player)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Stats = require(Shared.Util.Stats)
local Types = require(Shared.Types)

local DataService = require(script.Parent.DataService)
local EventService = require(script.Parent.EventService)
local MonetizationService = require(script.Parent.MonetizationService)

local MultiplierService = {}

function MultiplierService.GetContext(player: Player): Stats.Context?
	local data = DataService.Get(player)
	if not data then
		return nil
	end
	local loaded = data :: Types.PlayerData
	local friends = player:GetAttribute("FriendsInServer")
	return {
		Data = loaded,
		Passes = MonetizationService.GetOwnedPasses(player),
		IsPremium = MonetizationService.IsPremium(player),
		InGroup = player:GetAttribute("InGroup") == true,
		FriendsInServer = if type(friends) == "number" then friends else 0,
		ActiveEvents = EventService.GetActiveIds(),
		Now = os.time(),
	}
end

local function setIfChanged(player: Player, name: string, value: number)
	-- Round for display stability (avoids attribute churn from float noise).
	local rounded = math.floor(value * 1000 + 0.5) / 1000
	if player:GetAttribute(name) ~= rounded then
		player:SetAttribute(name, rounded)
	end
end

function MultiplierService.Refresh(player: Player)
	local maybeCtx = MultiplierService.GetContext(player)
	if not maybeCtx or player.Parent == nil then
		return
	end
	local ctx = maybeCtx :: Stats.Context
	setIfChanged(player, "SandMultiplier", Stats.GetSandMultiplier(ctx))
	setIfChanged(player, "Capacity", Stats.GetCapacity(ctx))
	setIfChanged(player, "Luck", Stats.GetLuck(ctx))
	setIfChanged(player, "CoinMultiplier", Stats.GetCoinMultiplier(ctx))
	setIfChanged(player, "SpeedMultiplier", Stats.GetSpeedMultiplier(ctx))
	setIfChanged(player, "PetSlots", Stats.GetPetSlots(ctx))
end

local RELEVANT_KEYS = {
	Shovel = true,
	Backpack = true,
	Pets = true,
	PetSlots = true,
	Rebirths = true,
	Boosts = true,
	Index = true,
	RebirthPerks = true, -- v2.2 perks change capacity, coins and pet slots
}

function MultiplierService.Init() end

function MultiplierService.Start()
	DataService.PlayerLoaded:Connect(function(player: Player)
		MultiplierService.Refresh(player)
	end)
	DataService.Changed:Connect(function(player: Player, keys: { string })
		for _, key in keys do
			if RELEVANT_KEYS[key] then
				MultiplierService.Refresh(player)
				return
			end
		end
	end)
	MonetizationService.PassesChanged:Connect(function(player: Player)
		MultiplierService.Refresh(player)
	end)
	EventService.Changed:Connect(function()
		for _, player in DataService.GetLoadedPlayers() do
			MultiplierService.Refresh(player)
		end
	end)
	-- Boost expiry and social attribute changes: cheap periodic refresh.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in DataService.GetLoadedPlayers() do
				MultiplierService.Refresh(player)
			end
		end
	end)
end

return MultiplierService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Net — server-side remote plumbing shared by every service.
	- Net.On(name, handler, opts): connects a client -> server RemoteEvent with a per-player rate
	  limit, an optional "data must be loaded" gate and error isolation (pcall + warn).
	- Argument validators (exploiters send garbage: wrong types, NaN, huge strings).
	- Notify helpers (RemoteEvent Notify(kind, text)), with optional per-key throttling.

	Notify kinds (client contract):
		"Info"     neutral hint / tip
		"Success"  something worked (purchase, equip)
		"Error"    action refused ("Need a better shovel!", "Not enough coins!")
		"Reward"   rewards granted (daily, quest, code, product)
		"Sell"     sand sold ("+1.2K Coins!") — client plays coin rain
		"Announce" server-wide brag (Legendary/Mythic find or hatch)
		"Event"    a timed server event started (High Tide / Golden Hour)
]]

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Remotes)
local RateLimiter = require(Shared.Util.RateLimiter)

local DataService = require(script.Parent.DataService)

export type NotifyKind = "Info" | "Success" | "Error" | "Reward" | "Sell" | "Announce" | "Event"

export type HandlerOptions = {
	Rate: number?, -- max calls per Window (burst); default 10
	Window: number?, -- seconds; default 1
	RequireData: boolean?, -- default true: ignore calls until the player's data is loaded
}

local Net = {}

local limiters: { RateLimiter.RateLimiter } = {}
local notifyThrottle: { [Player]: { [string]: number } } = {}

-- Validators ------------------------------------------------------------------------------------

function Net.IsString(value: any, maxLength: number?): boolean
	return type(value) == "string" and #value > 0 and #value <= (maxLength or 64)
end

function Net.IsNumber(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) ~= math.huge
end

function Net.IsInteger(value: any, min: number?, max: number?): boolean
	if not Net.IsNumber(value) or value % 1 ~= 0 then
		return false
	end
	return (min == nil or value >= min) and (max == nil or value <= max)
end

function Net.IsVector3(value: any): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end
	local v = value :: Vector3
	return Net.IsNumber(v.X) and Net.IsNumber(v.Y) and Net.IsNumber(v.Z)
end

-- Handlers --------------------------------------------------------------------------------------

function Net.On(name: string, handler: (Player, ...any) -> ...any, options: HandlerOptions?)
	local opts: HandlerOptions = options or {}
	local limiter = RateLimiter.new(opts.Rate or 10, opts.Window or 1)
	table.insert(limiters, limiter)
	local requireData = opts.RequireData ~= false
	Remotes.Get(name).OnServerEvent:Connect(function(player: Player, ...: any)
		if not limiter:Check(player) then
			return
		end
		if requireData and not DataService.IsLoaded(player) then
			if RunService:IsStudio() then
				print(string.format("[Net] %s from %s ignored: data not loaded yet", name, player.Name))
			end
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[Net] %s handler error for %s: %s", name, player.Name, tostring(err)))
		end
	end)
end

-- Remote function with the same protections. Returns `fallback` when throttled / failing.
function Net.OnInvoke(name: string, handler: (Player, ...any) -> any, fallback: any, options: HandlerOptions?)
	local opts: HandlerOptions = options or {}
	local limiter = RateLimiter.new(opts.Rate or 10, opts.Window or 1)
	table.insert(limiters, limiter)
	Remotes.GetFunction(name).OnServerInvoke = function(player: Player, ...: any): any
		if not limiter:Check(player) then
			return fallback
		end
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[Net] %s invoke error for %s: %s", name, player.Name, tostring(result)))
			return fallback
		end
		return result
	end
end

-- Notify ----------------------------------------------------------------------------------------

function Net.Notify(player: Player, kind: NotifyKind, text: string)
	if player.Parent then
		Remotes.Get("Notify"):FireClient(player, kind, text)
	end
end

-- Same as Notify, but at most once per `interval` seconds for a given throttle key.
function Net.NotifyThrottled(player: Player, kind: NotifyKind, text: string, throttleKey: string, interval: number)
	local perPlayer = notifyThrottle[player]
	if not perPlayer then
		perPlayer = {}
		notifyThrottle[player] = perPlayer
	end
	local now = os.clock()
	local last = perPlayer[throttleKey]
	if last and now - last < interval then
		return
	end
	perPlayer[throttleKey] = now
	Net.Notify(player, kind, text)
end

function Net.NotifyAll(kind: NotifyKind, text: string)
	Remotes.Get("Notify"):FireAllClients(kind, text)
end

function Net.FireClient(name: string, player: Player, ...: any)
	if player.Parent then
		Remotes.Get(name):FireClient(player, ...)
	end
end

function Net.FireAll(name: string, ...: any)
	Remotes.Get(name):FireAllClients(...)
end

function Net.OnPlayerRemoving(player: Player)
	notifyThrottle[player] = nil
	for _, limiter in limiters do
		limiter:Remove(player)
	end
end

-- Character helpers -----------------------------------------------------------------------------

function Net.GetRoot(player: Player): BasePart?
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not character or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	local root = (character :: Model):FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

function Net.GetPlayerFromPart(part: BasePart): Player?
	local current: Instance? = part:FindFirstAncestorOfClass("Model")
	while current do
		local model = current :: Instance
		if model:IsA("Model") then
			local player = Players:GetPlayerFromCharacter(model)
			if player then
				return player
			end
		end
		current = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">OfflineService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	OfflineService — digging pets keep digging while you are away (v2.2, docs/design/Rebirth.md).

	LastOnline: PlayerData.LastOnline is stamped with the server's os.time() every STAMP_SECONDS
	while the player is in the game and once more when they leave (OnPlayerRemoving runs before
	DataService's final save), so every save carries it. The client never sends a time.

	On join (DataService.PlayerLoaded), with away = os.time() - LastOnline:
	  - ignored when LastOnline is 0 (new save), away < OFFLINE_MIN_SECONDS (5 min), away < 0
	    (clock went backwards / another server's clock ahead), away > OFFLINE_MAX_GAP_SECONDS
	    (broken stamp), or LastOnline is older than FirstJoin,
	  - seconds = min(away, cap), cap = (OFFLINE_CAP_HOURS 2 + Long Nap hours) h,
	  - sand/s  = sum over the equipped digging pets (same slots and order rule as live digging) of
	              layer.SandValue x (sand multiplier / shovel factor x Dig.SandMultiplier) / Dig.Interval
	              — exactly DigService's pet-dig formula — where layer = the deepest layer the pet can
	              dig that the player has reached (MaxDepth). The sand multiplier is the permanent part
	              of the stack: no boosts, events or friends (they were not there while you slept),
	  - sand    = sand/s x efficiency (40% + Long Nap) x seconds,
	  - coins   = floor(sand x SELL_RATE x permanent coin factors (Golden Touch)).
	Coins go straight to the wallet (never the backpack). The client gets
	OfflineEarnings({ Seconds, Sand, Coins, CapSeconds, Capped, PetId }) for the welcome-back popup.
	No digging pets equipped -> one hint toast instead.

	Public API:
		OfflineService.Estimate(ctx, awaySeconds): Estimate     (pure; tests)
		OfflineService.TakeAway(player, now?): number?           (join: seconds away, stamps LastOnline)
		OfflineService.Pay(player, away): Estimate?              (grant coins + popup)
		OfflineService.Grant(player, now?): Estimate?            (TakeAway + Pay; tests)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Stats = require(Shared.Util.Stats)
local Types = require(Shared.Types)

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local MultiplierService = require(script.Parent.MultiplierService)
local Net = require(script.Parent.Net)

local Perks = Config.RebirthPerks

local STAMP_SECONDS = 15
local PAY_DELAY = 3 -- pass ownership + client UI settle first

export type Estimate = {
	Seconds: number, -- counted (capped) offline seconds
	Away: number, -- real seconds away
	CapSeconds: number,
	Capped: boolean,
	SandPerSecond: number, -- live rate of the digging pets (before efficiency)
	Efficiency: number,
	Sand: number,
	Coins: number,
	PetId: string?, -- the best digging pet (popup picture)
}

local OfflineService = {}

-- Pure: what `awaySeconds` of offline digging is worth for this context.
function OfflineService.Estimate(ctx: Stats.Context, awaySeconds: number): Estimate
	local data = ctx.Data
	-- the permanent part of the multiplier stack only
	local calm: Stats.Context = {
		Data = table.clone(data),
		Passes = ctx.Passes,
		IsPremium = ctx.IsPremium,
		InGroup = ctx.InGroup,
		FriendsInServer = 0,
		ActiveEvents = {},
		Now = ctx.Now,
	}
	calm.Data.Boosts = {}
	local shovelFactor = Stats.GetShovel(calm.Data).SandMultiplier
	local sandMultiplier = Stats.GetSandMultiplier(calm)
	local reached = Config.GetLayerIndexAtDepth(data.MaxDepth)

	local rate = 0
	local bestId: string? = nil
	local bestRate = -1
	local ids, golden = Stats.GetEquippedPetIds(data, Stats.GetPetSlots(calm))
	for i, id in ids do
		local dig = Config.GetPetDig(id)
		if dig then
			local interval = Config.GetPetDigInterval(id, golden[i]) or dig.Interval
			local layerIndex = math.min(Config.GetMaxLayerIndexForPower(dig.Power), reached)
			local layer = Config.Layers[layerIndex]
			local perDig = layer.SandValue * sandMultiplier / shovelFactor * dig.SandMultiplier
			local perSecond = perDig / interval
			rate += perSecond
			if perSecond > bestRate then
				bestRate = perSecond
				bestId = id
			end
		end
	end

	local cap = Perks.OfflineCapSeconds(data.RebirthPerks)
	local away = math.max(0, awaySeconds)
	local seconds = math.min(away, cap)
	local efficiency = Perks.OfflineEfficiency(data.RebirthPerks)
	local sand = rate * efficiency * seconds
	local coins = math.floor(sand * Config.SELL_RATE * Stats.GetCoinMultiplier(calm))
	return {
		Seconds = seconds,
		Away = away,
		CapSeconds = cap,
		Capped = away > cap,
		SandPerSecond = rate,
		Efficiency = efficiency,
		Sand = math.floor(sand),
		Coins = coins,
		PetId = bestId,
	}
end

-- Is this LastOnline stamp usable at `now`? Returns the seconds away, or nil.
local function awayFrom(data: Types.PlayerData, now: number): number?
	local last = data.LastOnline
	if type(last) ~= "number" or last ~= last or last <= 0 then
		return nil
	end
	if type(data.FirstJoin) == "number" and last < data.FirstJoin - 60 then
		return nil -- stamped before the save existed: corrupt
	end
	local away = now - last
	if away < Perks.OFFLINE_MIN_SECONDS or away > Perks.OFFLINE_MAX_GAP_SECONDS then
		return nil -- too short, clock went backwards, or absurd
	end
	return away
end

-- Ends the absence: returns the usable seconds away (or nil) and stamps LastOnline = now.
function OfflineService.TakeAway(player: Player, now: number?): number?
	local data = DataService.Get(player)
	if not data then
		return nil
	end
	assert(data) -- refine for the type checker (guarded above)
	local t = now or os.time()
	local away = awayFrom(data, t)
	data.LastOnline = t
	return away
end

-- Pays `away` seconds of offline digging (coins) and tells the client. nil = nothing to pay.
function OfflineService.Pay(player: Player, away: number?): Estimate?
	local data = DataService.Get(player)
	local ctx = MultiplierService.GetContext(player)
	if not data or not ctx or not away or player.Parent == nil then
		return nil
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(ctx) -- refine for the type checker (guarded above)
	local estimate = OfflineService.Estimate(ctx, away :: number)
	if estimate.Coins <= 0 then
		if estimate.SandPerSecond <= 0 then
			Net.Notify(player, "Info", "Equip a digging pet and it will earn coins while you're away!")
		end
		return estimate
	end
	DataService.Mutate(player, { "Coins" }, function(d)
		d.Coins += estimate.Coins
	end)
	Analytics.Source(
		player,
		"Coins",
		estimate.Coins,
		data.Coins,
		Enum.AnalyticsEconomyTransactionType.TimedReward,
		"Offline"
	)
	Net.FireClient("OfflineEarnings", player, {
		Seconds = estimate.Seconds,
		Away = estimate.Away,
		Sand = estimate.Sand,
		Coins = estimate.Coins,
		CapSeconds = estimate.CapSeconds,
		Capped = estimate.Capped,
		PetId = estimate.PetId,
	})
	return estimate
end

-- TakeAway + Pay in one go (tests / tools).
function OfflineService.Grant(player: Player, now: number?): Estimate?
	return OfflineService.Pay(player, OfflineService.TakeAway(player, now))
end

local function stamp(player: Player)
	local data = DataService.Get(player)
	if data then
		-- No MarkDirty: the client does not need it; every save copies the whole PlayerData.
		(data :: Types.PlayerData).LastOnline = os.time()
	end
end

function OfflineService.Init() end

function OfflineService.Start()
	DataService.PlayerLoaded:Connect(function(player: Player)
		-- stamp now (before the stamp loop can), pay a moment later: game passes are checked
		-- asynchronously after join and the client needs a moment to build its UI
		local away = OfflineService.TakeAway(player)
		if away then
			task.delay(PAY_DELAY, OfflineService.Pay, player, away)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(STAMP_SECONDS)
			for _, player in DataService.GetLoadedPlayers() do
				stamp(player)
			end
		end
	end)
	game:BindToClose(function()
		for _, player in DataService.GetLoadedPlayers() do
			stamp(player)
		end
	end)
end

-- Runs before DataService.OnPlayerRemoving (reverse service order), so the final save has it.
function OfflineService.OnPlayerRemoving(player: Player)
	stamp(player)
end

return OfflineService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">PetDigService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PetDigService — digging pets (docs/V2.md "v2.1", docs/design/Companions.md).

	Every equipped pet with a Dig ability (vehicle pets from Construction Crates, a few creatures)
	digs ITS OWN spot on a ring around its owner, every Dig.Interval seconds:
	  - Ring: RING_MIN..RING_MAX studs (horizontal) from the owner's feet, wider for pets whose dig
	    carves a bigger cube. Pet k of n sits at angle k * 2pi / n plus a slow drift, so pets spread
	    around the owner instead of piling up.
	  - The spot is STABLE: a pet keeps digging the same spot (its own little pit) until the spot
	    gets too deep (more than MAX_BELOW studs under the owner's feet), too hard (TooHard), leaves
	    the ring (the owner walked off), leaves the dig zone, or comes near another player. Then it
	    re-picks (Shift += golden angle).
	  - NEVER under the owner: the dig point is >= RING_MIN (6) studs from the owner's feet, and the
	    voxel cube DigService would carve there (predicted with the same grid maths) must stay
	    OWNER_CLEARANCE studs away from the owner and from every other player. Points are also
	    >= OTHER_PLAYER_CLEARANCE (5) studs from other players.
	  - Deep in a hole the ring sits inside the hole wall: the pet digs the wall at the owner's foot
	    level (widens the hole around them at the owner's layer).
	  DigService.DigAt(player, point, { Power, Radius, SandMultiplier, Source = "Pet", Silent = true })
	Pets idle while the owner has no character, stands outside the dig zone (hub / boardwalk), or
	the backpack is full (one gentle Info notify per full backpack). Pet digs add no heat.
	Success -> PetDug(player, slot, petId, position, sandGained) to all clients, where slot is the
	pet's 1-based index in the owner's "EquippedPets" attribute (PetService: sorted equipped ids).

	Public API:
		PetDigService.GetDiggers(player): { { Slot: number, Id: string, Golden: boolean? } }   active digging pets
	v2.2: Golden pets (PetInstance.Golden) dig every Config.GetPetDigInterval (Interval / 1.25).
		PetDigService.GetSpot(player, slot): Vector3?    current spot of that pet (tests / debug)
		PetDigService.Step(player)                        one dig-loop tick for a player (tests)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Stats = require(Shared.Util.Stats)
local Types = require(Shared.Types)

local DataService = require(script.Parent.DataService)
local DigService = require(script.Parent.DigService)
local MultiplierService = require(script.Parent.MultiplierService)
local Net = require(script.Parent.Net)
local PetService = require(script.Parent.PetService)
local World = require(script.Parent.Parent.World)

export type ActiveDigger = { Slot: number, Id: string, Golden: boolean? }

local TICK = 0.1
local VOXEL = 4 -- DigService carves whole 4-stud voxels
local DENT_MAX_RADIUS = 2.2 -- DigService: radius <= this carves a ball instead of voxels
local DENT_BALL_RADIUS = 2.6
local RING_MIN = 6 -- studs from the owner's feet (horizontal): never closer
local RING_WIDTH = 5 -- ring = RING_MIN .. RING_MIN + RING_WIDTH (+ extra for big cubes)
local OWNER_CLEARANCE = 1.5 -- the carved cube keeps this far from the owner / other players
local OTHER_PLAYER_CLEARANCE = 5 -- dig points stay this far (horizontal) from other players
local MAX_BELOW = 6 -- a spot deeper than this below the owner's feet is "too deep"
local ABOVE_CHECK = 8 -- the down-ray starts this far above the owner's feet
local WALL_ABOVE = 3 -- ground higher than this above the feet = we are inside the hole wall
local DRIFT = 0.02 -- radians / second: the ring turns slowly so spots wander over time
local GOLDEN = 2.39996
local ATTEMPTS = 6
local TOO_HARD_NOTIFY_SECONDS = 60

local PetDigService = {}

type PetState = {
	NextDig: number?,
	Spot: Vector3?, -- XZ of the spot (Y ignored)
	Shift: number,
}

type PlayerState = {
	Pets: { [string]: PetState },
	FullNotified: boolean,
	LastTooHard: number,
}

local states: { [Player]: PlayerState } = {}
local rng = Random.new()
local loopStarted = false
local lastLoopWarn = -math.huge

local terrainOnly = RaycastParams.new()
terrainOnly.FilterType = Enum.RaycastFilterType.Include
terrainOnly.FilterDescendantsInstances = { Workspace.Terrain }

local function getState(player: Player): PlayerState
	local state = states[player]
	if not state then
		state = { Pets = {}, FullNotified = false, LastTooHard = -math.huge }
		states[player] = state
	end
	return state :: PlayerState
end

-- Active digging pets -------------------------------------------------------------------------------

-- Equipped pets in the same order as the "EquippedPets" attribute (Stats.SortEquipped).
local function equippedPets(data: Types.PlayerData): { Types.PetInstance }
	return Stats.SortEquipped(data.Pets)
end

function PetDigService.GetDiggers(player: Player): { ActiveDigger }
	local data = DataService.Get(player)
	if not data then
		return {}
	end
	assert(data) -- refine for the type checker (guarded above)
	local pets = equippedPets(data)
	local slots = PetService.GetSlots(player)
	local list: { ActiveDigger } = {}
	for i, pet in pets do
		if i > slots then
			break -- more equipped than slots (pass refund pending): only the first `slots` dig
		end
		if Config.GetPetDig(pet.Id) then
			table.insert(list, { Slot = i, Id = pet.Id, Golden = pet.Golden == true })
		end
	end
	return list
end

function PetDigService.GetSpot(player: Player, slot: number): Vector3?
	local state = states[player]
	if not state then
		return nil
	end
	for key, pet in (state :: PlayerState).Pets do
		if string.match(key, "^(%d+):") == tostring(slot) then
			return pet.Spot
		end
	end
	return nil
end

-- Geometry ------------------------------------------------------------------------------------------

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function cellsFor(radius: number): number
	return math.max(1, math.floor(radius * 2 / VOXEL + 0.5))
end

-- Ring bounds for a dig radius: bigger cubes reach further, so they stay further out.
local function ringFor(radius: number): (number, number)
	local extra = if radius <= DENT_MAX_RADIUS then 0 else (cellsFor(radius) - 1) * VOXEL * 0.75
	local lo = RING_MIN + extra
	return lo, lo + RING_WIDTH
end

-- Horizontal box (min X, max X, min Z, max Z) DigService would carve for a dig at `point`
-- (same grid maths as DigService.carve, ignoring the zone-edge clamp which only moves it inward).
local function carveBox(point: Vector3, radius: number): (number, number, number, number)
	if radius <= DENT_MAX_RADIUS then
		local r = DENT_BALL_RADIUS
		return point.X - r, point.X + r, point.Z - r, point.Z + r
	end
	local cells = cellsFor(radius)
	local back = math.floor((cells - 1) / 2)
	local sx = (math.floor(point.X / VOXEL) - back) * VOXEL
	local sz = (math.floor(point.Z / VOXEL) - back) * VOXEL
	return sx, sx + cells * VOXEL, sz, sz + cells * VOXEL
end

local function boxNear(point: Vector3, radius: number, other: Vector3): boolean
	local x0, x1, z0, z1 = carveBox(point, radius)
	local c = OWNER_CLEARANCE
	return other.X > x0 - c and other.X < x1 + c and other.Z > z0 - c and other.Z < z1 + c
end

local function feetOf(root: BasePart): Vector3
	local humanoid = (root.Parent :: Instance):FindFirstChildOfClass("Humanoid")
	local hip = if humanoid then humanoid.HipHeight else 2
	return root.Position - Vector3.new(0, root.Size.Y / 2 + hip, 0)
end

-- True if the spot is fine for this owner right now (ring, zone, clearances).
local function spotOk(owner: Player, feet: Vector3, spot: Vector3, radius: number): boolean
	local lo, hi = ringFor(radius)
	local d = flat(spot - feet).Magnitude
	if d < lo - 0.01 or d > hi + 1.5 then
		return false
	end
	if not World.IsInDigZone(Vector3.new(spot.X, feet.Y, spot.Z)) then
		return false
	end
	if boxNear(spot, radius, feet) then
		return false
	end
	for _, other in Players:GetPlayers() do
		if other ~= owner then
			local root = Net.GetRoot(other)
			if root then
				local p = (root :: BasePart).Position
				if flat(p - spot).Magnitude < OTHER_PLAYER_CLEARANCE or boxNear(spot, radius, p) then
					return false
				end
			end
		end
	end
	return true
end

local function newSpot(
	owner: Player,
	feet: Vector3,
	slot: number,
	count: number,
	pet: PetState,
	radius: number
): Vector3?
	local lo, hi = ringFor(radius)
	local base = (slot - 1) * (2 * math.pi / math.max(count, 1)) + os.clock() * DRIFT + pet.Shift
	for attempt = 0, ATTEMPTS - 1 do
		local angle = base + attempt * 0.9
		local t = ((slot * 0.37) + pet.Shift * 0.13 + attempt * 0.29) % 1
		local r = lo + t * (hi - lo)
		local spot = feet + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
		if spotOk(owner, feet, spot, radius) then
			return spot
		end
	end
	return nil
end

-- True if the 4-stud terrain voxel containing `pos` holds solid ground (not air / water).
local function solidAt(pos: Vector3): boolean
	local cell = Vector3.new(math.floor(pos.X / VOXEL), math.floor(pos.Y / VOXEL), math.floor(pos.Z / VOXEL)) * VOXEL
	local ok, materials, occupancies = pcall(function()
		return Workspace.Terrain:ReadVoxels(Region3.new(cell, cell + Vector3.new(VOXEL, VOXEL, VOXEL)), VOXEL)
	end)
	if not ok then
		return false
	end
	assert(ok) -- refine for the type checker (guarded above)
	local material = materials[1][1][1]
	return material ~= Enum.Material.Air and material ~= Enum.Material.Water and occupancies[1][1][1] > 0
end

-- The point to dig at the pet's spot, or nil when the spot is used up (its pit is too deep).
-- DigService digs ~3 studs below the point it gets (non-shovel sources).
local function digPointAt(spot: Vector3, feet: Vector3): Vector3?
	local origin = Vector3.new(spot.X, feet.Y + ABOVE_CHECK, spot.Z)
	local hit = Workspace:Raycast(origin, Vector3.new(0, -(ABOVE_CHECK + MAX_BELOW), 0), terrainOnly)
	if hit and hit.Position.Y <= feet.Y + WALL_ABOVE then
		return hit.Position -- open ground (or the floor of the pet's own pit) near the owner's level
	end
	-- Ground far above the feet (the ring is inside the owner's hole wall) or no hit (the ray began
	-- inside solid wall, or the pit is deeper than MAX_BELOW): dig the wall at the owner's foot
	-- level, then one voxel lower; nothing solid there means the spot is used up.
	for _, dy in { 1, 1 - VOXEL } do
		local point = Vector3.new(spot.X, feet.Y + dy, spot.Z)
		if solidAt(point - Vector3.new(0, 3, 0)) then
			return point
		end
	end
	return nil
end

-- Dig loop ------------------------------------------------------------------------------------------

local function repick(pet: PetState)
	pet.Spot = nil
	pet.Shift += GOLDEN
end

function PetDigService.Step(player: Player)
	local data = DataService.Get(player)
	local root = Net.GetRoot(player)
	if not data or not root then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(root) -- refine for the type checker (guarded above)
	local diggers = PetDigService.GetDiggers(player)
	local state = getState(player)
	if #diggers == 0 then
		table.clear(state.Pets)
		return
	end
	local now = os.clock()
	local feet = feetOf(root)

	-- forget pets that are no longer equipped in that slot
	local live: { [string]: boolean } = {}
	for _, a in diggers do
		live[a.Slot .. ":" .. a.Id] = true
	end
	for key in state.Pets do
		if not live[key] then
			state.Pets[key] = nil
		end
	end

	if not World.IsInDigZone(feet) then
		-- idle in the hub / on the boardwalk; start digging soon after stepping onto the sand
		for _, pet in state.Pets do
			pet.NextDig = math.max(pet.NextDig or 0, now + 0.5)
			pet.Spot = nil
		end
		return
	end
	local ctx = MultiplierService.GetContext(player)
	if not ctx then
		return
	end
	assert(ctx) -- refine for the type checker (guarded above)
	if data.Sand >= Stats.GetCapacity(ctx) then
		if not state.FullNotified then
			state.FullNotified = true
			Net.Notify(player, "Info", "Your pets stopped digging: backpack full! Sell to wake them up.")
		end
		return
	end
	state.FullNotified = false

	local riding = player:GetAttribute("Riding") -- RideService: id of the pet being ridden
	for _, a in diggers do
		local def = Config.GetPet(a.Id)
		local dig = Config.GetPetDig(a.Id)
		if not def or not dig or a.Id == riding then
			continue -- the ridden pet digs through RideService instead
		end
		assert(def) -- refine for the type checker (guarded above)
		assert(dig) -- refine for the type checker (guarded above)
		-- v2.2: Golden pets dig Config.GOLDEN_DIG_SPEED x as often
		local interval = Config.GetPetDigInterval(a.Id, a.Golden) or dig.Interval
		local key = a.Slot .. ":" .. a.Id
		local pet = state.Pets[key]
		if not pet then
			-- stagger freshly equipped pets so several never fire on the same frame
			state.Pets[key] = {
				NextDig = now + interval * (0.3 + 0.7 * rng:NextNumber()),
				Spot = nil,
				Shift = 0,
			}
			continue
		end
		local p = pet :: PetState
		if p.NextDig and now < (p.NextDig :: number) then
			continue
		end
		p.NextDig = now + interval

		local spot = p.Spot
		if spot and not spotOk(player, feet, spot :: Vector3, dig.Radius) then
			repick(p)
			spot = nil
		end
		if not spot then
			spot = newSpot(player, feet, a.Slot, #diggers, p, dig.Radius)
			if not spot then
				p.Shift += GOLDEN
				continue
			end
			p.Spot = spot
		end
		local point = digPointAt(spot :: Vector3, feet)
		if not point then
			repick(p)
			continue
		end
		local result = DigService.DigAt(player, point :: Vector3, {
			Power = dig.Power,
			Radius = dig.Radius,
			SandMultiplier = dig.SandMultiplier,
			Source = "Pet",
			Silent = true,
		})
		if result == nil then
			repick(p) -- no terrain there any more: the pit is too deep
			p.NextDig = now + 0.3
		elseif result.Success then
			Net.FireAll("PetDug", player, a.Slot, a.Id, result.Position, result.SandGained)
		elseif result.Reason == "TooHard" then
			repick(p)
			p.NextDig = now + interval * 3
			if now - state.LastTooHard > TOO_HARD_NOTIFY_SECONDS then
				state.LastTooHard = now
				Net.Notify(player, "Info", def.Name .. " can't dig this layer. Hatch a stronger digging pet!")
			end
		elseif result.Reason == "BackpackFull" then
			break
		else
			repick(p) -- OutOfZone / TooFar / Bottom
		end
	end
end

-- Lifecycle -----------------------------------------------------------------------------------------

function PetDigService.Start()
	if loopStarted then
		return
	end
	loopStarted = true
	task.spawn(function()
		while true do
			task.wait(TICK)
			for _, player in DataService.GetLoadedPlayers() do
				local ok, err = pcall(function(): any
					PetDigService.Step(player)
					return nil
				end)
				if not ok and os.clock() - lastLoopWarn > 10 then
					lastLoopWarn = os.clock()
					warn("[PetDigService] dig loop error: " .. tostring(err))
				end
			end
		end
	end)
end

function PetDigService.OnPlayerRemoving(player: Player)
	states[player] = nil
end

return PetDigService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PetService — eggs and pets.

	HatchEgg(eggId, count): count 1, or Config.TRIPLE_HATCH_COUNT with the TripleHatch pass.
	Coins/Tokens eggs only (Robux eggs are granted through their developer product; asking to
	hatch one prompts the product). Egg must be unlocked (Config.IsEggUnlocked by MaxDepth),
	inventory must have room (Config.PET_INVENTORY_LIMIT). Luck (LuckBoost,
	High Tide) multiplies the weight of non-Common pets. New pets auto-equip while slots are free.
	Fires EggHatched({petId...}) to the hatcher; Legendary/Mythic hatches are announced.

	Equip/Unequip/Delete by uid; equip slots = PlayerData.PetSlots + ExtraPets pass.

	v2.2:
	  - TRUE ODDS: every roll is Stats.RollHatch(egg, Stats.GetLuck(ctx), data.Pity[egg.Id], r),
	    which picks from Stats.GetHatchOddsList, the same function the egg panel displays.
	    EggHatched(results, { EggId, Chances = {probability of each result}, Pity = {bool} }).
	  - PITY: data.Pity[eggId] counts hatches in a row without a Rare+ pet; at EggDef.PityAt the
	    next hatch rolls only among the Rare+ pets. Every hatch of the egg counts (paid, free,
	    rewards).
	  - FUSION: FusePets(uid) turns Config.GOLDEN_FUSE_COUNT (5) identical non-golden copies (the
	    selected one + unequipped copies first) into ONE Golden pet (PetInstance.Golden), which
	    stays equipped if any fused copy was. Golden: sand bonus x GOLDEN_SAND_BONUS, digs
	    GOLDEN_DIG_SPEED x as often. Golden pets can't be fused again.
	  - Attributes: "EquippedPets" (ids in Stats.SortEquipped order) and "EquippedGolden"
	    (comma-separated 1-based slots of Golden pets in that list).

	Public API:
		PetService.GrantPet(player, petId, autoEquip?): string?  (uid)
		PetService.HatchFree(player, eggId, count): { string }   (rewards/products; no cost/unlock/limit)
		PetService.GetSlots(player): number
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Format = require(Shared.Util.Format)
local Stats = require(Shared.Util.Stats)
local TableUtil = require(Shared.Util.TableUtil)

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local MonetizationService = require(script.Parent.MonetizationService)
local MultiplierService = require(script.Parent.MultiplierService)
local Net = require(script.Parent.Net)
local ServerSignals = require(script.Parent.ServerSignals)

local PetService = {}

local rng = Random.new()

function PetService.GetSlots(player: Player): number
	local ctx = MultiplierService.GetContext(player)
	return if ctx then Stats.GetPetSlots(ctx) else Config.MAX_EQUIPPED_PETS
end

local function countEquipped(data: Types.PlayerData): number
	local n = 0
	for _, pet in data.Pets do
		if pet.Equipped then
			n += 1
		end
	end
	return n
end

local function roll(egg: Types.EggDef, luck: number, pityCount: number?): string?
	return Stats.RollHatch(egg, luck, pityCount, rng:NextNumber())
end

-- Tests: the exact server roll (same rng path as a real hatch).
PetService._Roll = roll

local function announce(player: Player, petId: string)
	local pet = Config.GetPet(petId)
	local rarity = pet and Config.GetRarity(pet.Rarity)
	if pet and rarity and rarity.Announce then
		Net.NotifyAll(
			"Announce",
			string.format("%s hatched a %s %s!", player.DisplayName, string.upper(pet.Rarity), pet.Name)
		)
	end
end

function PetService.GrantPet(player: Player, petId: string, autoEquip: boolean?): string?
	local data = DataService.Get(player)
	if not data or not Config.GetPet(petId) then
		return nil
	end
	assert(data) -- refine for the type checker (guarded above)
	local uid = HttpService:GenerateGUID(false)
	local equip = autoEquip ~= false and countEquipped(data) < PetService.GetSlots(player)
	data.Pets[uid] = { Id = petId, Equipped = equip }
	DataService.MarkDirty(player, "Pets")
	return uid
end

-- Rolls `count` pets from an egg and grants them. No cost / unlock / inventory checks.
local function hatch(player: Player, egg: Types.EggDef, count: number): { string }
	local ctx = MultiplierService.GetContext(player)
	local luck = if ctx then Stats.GetLuck(ctx) else 1
	local data = DataService.Get(player)
	local pityTable: { [string]: number } = if data then data.Pity else {}
	local results = {}
	local chances = {}
	local pityHits = {}
	for _ = 1, count do
		local pityCount = pityTable[egg.Id] or 0
		local odds, pityActive = Stats.GetHatchOdds(egg, luck, pityCount)
		local petId = roll(egg, luck, pityCount)
		if petId and PetService.GrantPet(player, petId) then
			table.insert(results, petId)
			table.insert(chances, odds[petId] or 0)
			table.insert(pityHits, pityActive)
			if egg.PityAt then
				pityTable[egg.Id] = Stats.NextPityCount(egg, pityCount, petId)
			end
		end
	end
	if data and egg.PityAt and #results > 0 then
		DataService.MarkDirty(player, "Pity")
	end
	if #results > 0 then
		Net.FireClient("EggHatched", player, results, { EggId = egg.Id, Chances = chances, Pity = pityHits })
		for _, petId in results do
			announce(player, petId)
		end
		ServerSignals.Hatched:Fire(player, #results, egg.Id)
		Analytics.Hatched(player, egg.Id, results)
	end
	return results
end

function PetService.HatchFree(player: Player, eggId: string, count: number): { string }
	local egg = Config.GetEgg(eggId)
	if not egg or not DataService.Get(player) then
		return {}
	end
	assert(egg) -- refine for the type checker (guarded above)
	return hatch(player, egg, math.clamp(math.floor(count), 1, 10))
end

local function onHatchEgg(player: Player, eggId: any, count: any)
	if not Net.IsString(eggId, 64) then
		return
	end
	if count == nil then
		count = 1
	end
	if count ~= 1 and count ~= Config.TRIPLE_HATCH_COUNT then
		return
	end
	local data = DataService.Get(player)
	local egg = Config.GetEgg(eggId)
	if not data or not egg then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(egg) -- refine for the type checker (guarded above)
	if count > 1 and not MonetizationService.OwnsPass(player, "TripleHatch") then
		Net.Notify(player, "Error", "Get Triple Hatch to open 3 at once!")
		return
	end
	if egg.Currency == "Robux" then
		if egg.ProductKey then
			MonetizationService.PromptProduct(player, egg.ProductKey)
		end
		return
	end
	if not Config.IsEggUnlocked(egg.Id, data.MaxDepth) then
		local layer = Config.Layers[egg.UnlockLayer]
		Net.Notify(player, "Error", "Dig to " .. (if layer then layer.Name else "deeper") .. " to unlock this egg!")
		return
	end
	if TableUtil.Count(data.Pets) + count > Config.PET_INVENTORY_LIMIT then
		Net.Notify(player, "Error", "Your pet inventory is full! Delete some pets.")
		return
	end

	local cost = egg.Price * count
	local isTokens = egg.Currency == "Tokens"
	local balance = if isTokens then data.RebirthTokens else data.Coins
	if balance < cost then
		Net.Notify(
			player,
			"Error",
			if isTokens
				then "Not enough Rebirth Tokens!"
				else "Not enough coins! Need " .. Format.Abbreviate(cost - balance) .. " more."
		)
		return
	end

	local currencyKey = if isTokens then "RebirthTokens" else "Coins"
	DataService.Increment(player, currencyKey, -cost)
	Analytics.Sink(
		player,
		if isTokens then "Tokens" else "Coins",
		cost,
		(data :: any)[currencyKey],
		Enum.AnalyticsEconomyTransactionType.Shop,
		"Egg:" .. egg.Id
	)
	hatch(player, egg, count)
end

local function findPet(player: Player, uid: any): (Types.PlayerData?, Types.PetInstance?)
	if not Net.IsString(uid, 64) then
		return nil, nil
	end
	local data = DataService.Get(player)
	if not data then
		return nil, nil
	end
	assert(data) -- refine for the type checker (guarded above)
	return data, data.Pets[uid]
end

local function onEquip(player: Player, uid: any)
	local data, pet = findPet(player, uid)
	if not data or not pet or pet.Equipped then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(pet) -- refine for the type checker (guarded above)
	if countEquipped(data) >= PetService.GetSlots(player) then
		Net.Notify(player, "Error", "All pet slots are full! Unequip a pet first.")
		return
	end
	pet.Equipped = true
	DataService.MarkDirty(player, "Pets")
end

local function onUnequip(player: Player, uid: any)
	local data, pet = findPet(player, uid)
	if not data or not pet or not pet.Equipped then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(pet) -- refine for the type checker (guarded above)
	pet.Equipped = false
	DataService.MarkDirty(player, "Pets")
end

local function onDelete(player: Player, uid: any)
	local data, pet = findPet(player, uid)
	if not data or not pet then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(pet) -- refine for the type checker (guarded above)
	data.Pets[uid :: string] = nil
	DataService.MarkDirty(player, "Pets")
end

-- v2.2 duplicate fusion: GOLDEN_FUSE_COUNT identical non-golden copies -> one Golden pet.
local function onFuse(player: Player, uid: any)
	local data, pet = findPet(player, uid)
	if not data or not pet then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(pet) -- refine for the type checker (guarded above)
	local maybeDef = Config.GetPet(pet.Id)
	if not maybeDef or pet.Golden == true then
		Net.Notify(player, "Error", "Golden pets can't be fused again.")
		return
	end
	local def = maybeDef :: Types.PetDef
	-- the selected pet first, then unequipped copies, then equipped ones (stable by uid)
	local copies: { string } = {}
	for otherUid, other in data.Pets do
		if otherUid ~= uid and other.Id == pet.Id and other.Golden ~= true then
			table.insert(copies, otherUid)
		end
	end
	if #copies + 1 < Config.GOLDEN_FUSE_COUNT then
		Net.Notify(
			player,
			"Error",
			string.format("You need %d %s to fuse a Golden one!", Config.GOLDEN_FUSE_COUNT, def.Name)
		)
		return
	end
	table.sort(copies, function(a: string, b: string): boolean
		local ea, eb = data.Pets[a].Equipped, data.Pets[b].Equipped
		if ea ~= eb then
			return not ea
		end
		return a < b
	end)
	local fused: { string } = { uid :: string }
	for i = 1, Config.GOLDEN_FUSE_COUNT - 1 do
		table.insert(fused, copies[i])
	end
	local wasEquipped = false
	for _, fusedUid in fused do
		wasEquipped = wasEquipped or data.Pets[fusedUid].Equipped
		data.Pets[fusedUid] = nil
	end
	local newUid = HttpService:GenerateGUID(false)
	data.Pets[newUid] = { Id = def.Id, Equipped = wasEquipped, Golden = true }
	DataService.MarkDirty(player, "Pets")
	Net.Notify(player, "Success", string.format("Fused %d %s into a GOLDEN %s!", #fused, def.Name, def.Name))
end

-- If slots shrank (e.g. pass refunded), unequip extras so the stored state matches the stats.
local function trimEquipped(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	local slots = PetService.GetSlots(player)
	local equipped = {}
	for uid, pet in data.Pets do
		if pet.Equipped then
			table.insert(equipped, uid)
		end
	end
	if #equipped <= slots then
		return
	end
	table.sort(equipped)
	for i = slots + 1, #equipped do
		data.Pets[equipped[i]].Equipped = false
	end
	DataService.MarkDirty(player, "Pets")
end

function PetService.Init()
	Net.On("HatchEgg", onHatchEgg, { Rate = 3, Window = 1 })
	Net.On("EquipPet", onEquip, { Rate = 10, Window = 1 })
	Net.On("UnequipPet", onUnequip, { Rate = 10, Window = 1 })
	Net.On("DeletePet", onDelete, { Rate = 10, Window = 1 })
	Net.On("FusePets", onFuse, { Rate = 4, Window = 1 })
end

-- Mirror equipped pet ids onto a Player attribute so every client can render followers
-- (PetFollowController reads "EquippedPets" as comma-separated PetDef ids).
local function publishEquipped(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	local ids = {}
	local golden = {}
	for i, pet in Stats.SortEquipped(data.Pets) do
		table.insert(ids, pet.Id)
		if pet.Golden == true then
			table.insert(golden, tostring(i))
		end
	end
	player:SetAttribute("EquippedPets", table.concat(ids, ","))
	player:SetAttribute("EquippedGolden", table.concat(golden, ","))
end

function PetService.Start()
	DataService.PlayerLoaded:Connect(function(player: Player)
		publishEquipped(player)
	end)
	DataService.Changed:Connect(function(player: Player, keys: { string })
		if table.find(keys, "Pets") then
			publishEquipped(player)
		end
	end)
	for _, player in DataService.GetLoadedPlayers() do
		publishEquipped(player)
	end
	-- Pass ownership arrives asynchronously after load; trim only once it settled.
	MonetizationService.PassesChanged:Connect(function(player: Player)
		trimEquipped(player)
	end)
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">PolicyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PolicyService — per-player Roblox policy (PolicyService:GetPolicyInfoForPlayerAsync).

	Roblox requires that players for whom ArePaidRandomItemsRestricted is true can't buy random
	items with Robux, or with anything bought with Robux. In this game Coins and Rebirth Tokens can
	be bought with Robux, so every egg and crate counts. For these players we hide and refuse every
	item marked PaidRandom in Config.Monetization:
	  CoinsSmall..CoinsHuge and SkipRebirth (it grants Rebirth Tokens, which buy the Rebirth and
	  Golden Eggs). v2.3: no Robux item sells a random outcome or luck directly any more (the
	  Golden Egg products, 2x Luck and the Lucky pass were removed), so these currency items are
	  the only paid random items left, and only indirectly.
	Coin eggs stay playable with coins earned in game. Purchases that already completed are always
	honoured in ProcessReceipt, because the player has already paid.
	We never branch on country or locale. Only the policy flags are read.

	Fetching: on join, in its own thread, with 3 tries (1 s, 2 s back-off). The result is cached
	per player and published as Player attributes:
	  "PaidRandomRestricted" (bool)  the client hides PaidRandom items unless this is false
	  "PolicyLoaded" (bool)          true once a real answer arrived (false = fallback default)
	FAILURE / PENDING DEFAULT (documented choice):
	  - live servers: treat the player as RESTRICTED (the safe side for compliance). They only lose
	    access to the PaidRandom items until a later rejoin succeeds. We retry once more after
	    60 s in case the failure was transient.
	  - Studio: NOT restricted, so developers can test purchases without policy access.

	Public API:
		PolicyService.IsPaidRandomRestricted(player): boolean
		PolicyService.CanBuy(player, kind: "GamePass" | "Product", key): boolean
		PolicyService.GetInfo(player): { [string]: any }?   (raw policy table, nil until loaded)
		PolicyService.Changed: Signal<Player>
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local RobloxPolicyService = game:GetService("PolicyService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Signal = require(Shared.Util.Signal)

local PolicyService = {}

PolicyService.Changed = Signal.new() :: Signal.Signal<Player>

local ATTEMPTS = 3
local LATE_RETRY_SECONDS = 60

type Entry = { Loaded: boolean, Restricted: boolean, Info: { [string]: any }? }

local cache: { [Player]: Entry } = {}

local function fallbackRestricted(): boolean
	return not RunService:IsStudio()
end

local function publish(player: Player, entry: Entry)
	if player.Parent == nil then
		return
	end
	player:SetAttribute("PaidRandomRestricted", entry.Restricted)
	player:SetAttribute("PolicyLoaded", entry.Loaded)
end

local function fetch(player: Player): (boolean, { [string]: any }?)
	for attempt = 1, ATTEMPTS do
		local ok, result = pcall(function(): any
			return RobloxPolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		if ok and type(result) == "table" then
			return true, result :: { [string]: any }
		end
		if attempt < ATTEMPTS then
			task.wait(attempt)
		else
			warn("[PolicyService] policy lookup failed for " .. player.Name .. ": " .. tostring(result))
		end
	end
	return false, nil
end

local function load(player: Player, isRetry: boolean)
	local ok, info = fetch(player)
	if cache[player] == nil or player.Parent == nil then
		return -- left while we were waiting
	end
	local entry: Entry
	if ok and info then
		entry = { Loaded = true, Restricted = info.ArePaidRandomItemsRestricted == true, Info = info }
	else
		entry = { Loaded = false, Restricted = fallbackRestricted(), Info = nil }
	end
	cache[player] = entry
	publish(player, entry)
	PolicyService.Changed:Fire(player)
	if not entry.Loaded and not isRetry and entry.Restricted then
		task.delay(LATE_RETRY_SECONDS, function()
			local current = cache[player]
			if current and not current.Loaded then
				load(player, true)
			end
		end)
	end
end

-- Public API ---------------------------------------------------------------------------------------

function PolicyService.IsPaidRandomRestricted(player: Player): boolean
	local entry = cache[player]
	if not entry then
		return fallbackRestricted() -- not fetched yet: same as a failed lookup
	end
	return entry.Restricted
end

-- Can this player be offered this pass / product? false only for PaidRandom items when restricted.
function PolicyService.CanBuy(player: Player, kind: string, key: string): boolean
	if not Config.IsPaidRandom(kind, key) then
		return true
	end
	return not PolicyService.IsPaidRandomRestricted(player)
end

function PolicyService.GetInfo(player: Player): { [string]: any }?
	local entry = cache[player]
	return if entry then entry.Info else nil
end

-- Lifecycle ----------------------------------------------------------------------------------------

function PolicyService.Init() end

function PolicyService.Start() end

function PolicyService.OnPlayerAdded(player: Player)
	if cache[player] then
		return
	end
	-- pending: publish the fallback right away so the client never shows a PaidRandom item early
	local pending: Entry = { Loaded = false, Restricted = fallbackRestricted(), Info = nil }
	cache[player] = pending
	publish(player, pending)
	task.spawn(load, player, false)
end

function PolicyService.OnPlayerRemoving(player: Player)
	cache[player] = nil
end

-- Tests: re-run the lookup for a player (e.g. after changing the mock's policy answer).
function PolicyService._Reload(player: Player)
	if cache[player] and Players:GetPlayerByUserId(player.UserId) then
		load(player, true)
	end
end

return PolicyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RebirthService — reset for a permanent multiplier (Config.Rebirths) + the Rebirth Perk shop
	(Config.RebirthPerks, docs/design/Rebirth.md).

	Rebirth(): costs Config.RebirthCost(Rebirths) coins. Resets every key in
	Config.Rebirths.Resets to its Config.NewPlayerData() default, Rebirths += 1,
	RebirthTokens += Config.RebirthTokens(previous rebirths). Then the perks apply:
	  - Head Start: start with Shovels[ShovelIndex] (owned + equipped) and +Coins,
	  - Keep Backpack: the backpack you had stays (owned + equipped) up to Backpacks[KeepIndex].
	The player is sent to the surface and the shovel tool is given back. (No plot to reset any
	more: the tide refills holes.)

	Perk shop: remote BuyRebirthPerk(perkId) buys the next level for RebirthTokens. Perks are
	permanent (PlayerData.RebirthPerks, never reset). On load and on purchase the Head Start
	shovel is made owned (and equipped if it beats the current one), so a perk bought mid-run is
	felt right away. Capacity / coins / luck / pet slots come from Stats; Sell Anywhere from
	EconomyService; Long Nap from OfflineService.

	Public API:
		RebirthService.DoRebirth(player, free): boolean   (free = Skip Rebirth product)
		RebirthService.BuyPerk(player, perkId): boolean
		RebirthService.HasSellAnywhere(player): boolean  (the Sell Anywhere perk)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local TableUtil = require(Shared.Util.TableUtil)
local Types = require(Shared.Types)

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)
local BeachService = require(script.Parent.BeachService)
local ServerSignals = require(script.Parent.ServerSignals)
local ShopService = require(script.Parent.ShopService)

local Perks = Config.RebirthPerks

local RebirthService = {}

local busy: { [Player]: boolean } = {}

-- Drop unknown perk ids and clamp levels (old / edited saves).
local function sanitizePerks(data: Types.PlayerData)
	local raw = (data :: any).RebirthPerks
	local clean: { [string]: number } = {}
	if type(raw) == "table" then
		for id, level in raw do
			if type(id) == "string" and Perks.Get(id) then
				local l = Perks.Level(raw, id)
				if l > 0 then
					clean[id] = l
				end
			end
		end
	end
	data.RebirthPerks = clean
end

-- Head Start shovel: owned, and equipped when it is better than the equipped one.
-- Returns true when the equipped shovel changed.
local function applyHeadStartShovel(player: Player, data: Types.PlayerData): boolean
	local index = Perks.Effect(data.RebirthPerks, "HeadStart").ShovelIndex
	local def = if index then Config.Shovels[index] else nil
	if not def or def.RebirthsRequired > data.Rebirths then
		return false
	end
	assert(def) -- refine for the type checker (guarded above)
	local current = Config.GetShovel(data.Shovel)
	local equip = current == nil or (current :: Types.ShovelDef).Power < def.Power
	if data.OwnedShovels[def.Id] and not equip then
		return false
	end
	DataService.Mutate(player, { "OwnedShovels", "Shovel" }, function(d)
		d.OwnedShovels[def.Id] = true
		if equip then
			d.Shovel = def.Id
		end
	end)
	return equip
end

function RebirthService.HasSellAnywhere(player: Player): boolean
	local data = DataService.Get(player)
	return data ~= nil and Perks.HasSellAnywhere((data :: Types.PlayerData).RebirthPerks)
end

function RebirthService.DoRebirth(player: Player, free: boolean): boolean
	local data = DataService.Get(player)
	if not data or busy[player] then
		return false
	end
	assert(data) -- refine for the type checker (guarded above)
	local previous = data.Rebirths
	local cost = Config.RebirthCost(previous)
	if not free and data.Coins < cost then
		Net.Notify(player, "Error", "You need " .. Format.Abbreviate(cost) .. " coins to rebirth!")
		return false
	end
	busy[player] = true

	local tokens = Config.RebirthTokens(previous)
	local template = Config.NewPlayerData() :: any
	local oldBackpack = data.Backpack
	DataService.Mutate(player, { "Rebirths", "RebirthTokens" }, function(d)
		local raw = d :: any
		for _, key in Config.Rebirths.Resets do
			raw[key] = TableUtil.DeepCopy(template[key])
		end
		d.Rebirths = previous + 1
		d.RebirthTokens += tokens

		-- Perks (v2.2): Head Start coins, Keep Backpack. (The shovel is applied below.)
		local head = Perks.Effect(d.RebirthPerks, "HeadStart")
		d.Coins += head.Coins or 0
		local keepIndex = Perks.Effect(d.RebirthPerks, "KeepBackpack").KeepIndex or 0
		local oldIndex = Config.GetBackpackIndex(oldBackpack)
		if oldIndex and oldIndex > 1 and oldIndex <= keepIndex then
			d.Backpack = oldBackpack
			d.OwnedBackpacks[oldBackpack] = true
		end
	end)
	DataService.MarkDirty(player, table.unpack(Config.Rebirths.Resets))
	applyHeadStartShovel(player, data)

	if not free then
		Analytics.Sink(player, "Coins", cost, 0, Enum.AnalyticsEconomyTransactionType.Gameplay, "Rebirth")
	end
	Analytics.Source(
		player,
		"Tokens",
		tokens,
		data.RebirthTokens,
		Enum.AnalyticsEconomyTransactionType.Gameplay,
		"Rebirth"
	)
	Analytics.Funnel(player, Analytics.Steps.FirstRebirth)

	BeachService.TeleportToSurface(player)
	ShopService.GiveShovelTool(player)
	Net.Notify(
		player,
		"Reward",
		string.format(
			"REBIRTH %d! x%s sand forever, +%d Rebirth Token%s!",
			data.Rebirths,
			tostring(Config.RebirthMultiplier(data.Rebirths)),
			tokens,
			if tokens == 1 then "" else "s"
		)
	)
	ServerSignals.Rebirthed:Fire(player, data.Rebirths)
	busy[player] = nil
	return true
end

function RebirthService.BuyPerk(player: Player, perkId: string): boolean
	local data = DataService.Get(player)
	local def = Perks.Get(perkId)
	if not data or not def then
		return false
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(def) -- refine for the type checker (guarded above)
	local cost = Perks.NextCost(data.RebirthPerks, perkId)
	if not cost then
		Net.Notify(player, "Info", def.Name .. " is already maxed!")
		return false
	end
	assert(cost) -- refine for the type checker (guarded above)
	if data.RebirthTokens < cost then
		Net.Notify(
			player,
			"Error",
			string.format("You need %d Rebirth Token%s for %s!", cost, if cost == 1 then "" else "s", def.Name)
		)
		return false
	end
	local level = Perks.Level(data.RebirthPerks, perkId) + 1
	DataService.Mutate(player, { "RebirthTokens", "RebirthPerks" }, function(d)
		d.RebirthTokens -= cost
		local perks = table.clone(d.RebirthPerks)
		perks[perkId] = level
		d.RebirthPerks = perks
	end)
	Analytics.Sink(
		player,
		"Tokens",
		cost,
		data.RebirthTokens,
		Enum.AnalyticsEconomyTransactionType.Shop,
		"Perk:" .. perkId .. ":" .. level
	)
	if perkId == "HeadStart" and applyHeadStartShovel(player, data) then
		ShopService.GiveShovelTool(player)
	end
	Net.Notify(
		player,
		"Success",
		if #def.Costs == 1 then def.Name .. " unlocked!" else string.format("%s level %d!", def.Name, level)
	)
	return true
end

function RebirthService.Init()
	Net.On("Rebirth", function(player: Player)
		RebirthService.DoRebirth(player, false)
	end, { Rate = 1, Window = 2 })
	Net.On("BuyRebirthPerk", function(player: Player, perkId: any)
		if not Net.IsString(perkId, 40) then
			return
		end
		RebirthService.BuyPerk(player, perkId)
	end, { Rate = 4, Window = 2 })
end

function RebirthService.Start()
	-- Apply perks on load: clean the table, make sure the Head Start shovel is owned.
	DataService.PlayerLoaded:Connect(function(player: Player, data: Types.PlayerData)
		sanitizePerks(data)
		if applyHeadStartShovel(player, data) then
			ShopService.GiveShovelTool(player)
		end
	end)
end

function RebirthService.OnPlayerRemoving(player: Player)
	busy[player] = nil
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">RewardsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RewardsService — rewards, daily streak, quests, codes and social bonuses.

	Grant(player, reward, source, coinMultiplier?) applies a Types.Reward (coins via
	Config.ResolveCoins, tokens, boosts that stack duration, pets, free egg hatches, free
	rebirth). Used by daily rewards, quests, codes and developer products (wired by Main).

	Daily: claimable Config.DAILY_COOLDOWN_SECONDS after the last claim; the streak resets to 1
	if more than Config.DAILY_STREAK_GRACE_SECONDS passed. Premium x DailyRewardMultiplier coins.
	Quests: progress hooks from ServerSignals; Daily quests reset per UTC day (QuestProgress.Day).
	Codes: RedeemCode(code) — case-insensitive, Enabled / Expires checked, once per player.
	Group bonus: Player attribute "InGroup" (re-checked every GROUP_RECHECK seconds; GROUP_ID 0
	disables). Friends bonus: Player attribute "FriendsInServer".
	PlayTime: +60 every minute online (also drives PlayMinutes quests).

	Public API:
		RewardsService.Grant(player, reward, source, coinMultiplier?): boolean
		RewardsService.AddQuestProgress(player, kind, amount, rarity?)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Format = require(Shared.Util.Format)

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local MonetizationService = require(script.Parent.MonetizationService)
local Net = require(script.Parent.Net)
local PetService = require(script.Parent.PetService)
local RebirthService = require(script.Parent.RebirthService)
local ServerSignals = require(script.Parent.ServerSignals)

local GROUP_RECHECK = 300
local CODE_MAX_LENGTH = 32

local RewardsService = {}

local friendCache: { [Player]: { [number]: boolean } } = {}

local function today(): number
	return os.time() // 86400
end

local function transactionFor(source: string): Enum.AnalyticsEconomyTransactionType
	if string.sub(source, 1, 8) == "Product:" then
		return Enum.AnalyticsEconomyTransactionType.IAP
	elseif source == "Daily" then
		return Enum.AnalyticsEconomyTransactionType.TimedReward
	end
	return Enum.AnalyticsEconomyTransactionType.Gameplay
end

-- Grant -----------------------------------------------------------------------------------------

function RewardsService.Grant(player: Player, reward: Types.Reward, source: string, coinMultiplier: number?): boolean
	local data = DataService.Get(player)
	if not data then
		return false
	end
	assert(data) -- refine for the type checker (guarded above)
	local parts: { string } = {}

	local coins = math.floor(Config.ResolveCoins(reward, data.MaxDepth) * (coinMultiplier or 1))
	if coins > 0 then
		DataService.Increment(player, "Coins", coins)
		table.insert(parts, "+" .. Format.Abbreviate(coins) .. " Coins")
		Analytics.Source(player, "Coins", coins, data.Coins, transactionFor(source), source)
	end

	local tokens = reward.RebirthTokens or 0
	if tokens > 0 then
		DataService.Increment(player, "RebirthTokens", tokens)
		table.insert(parts, "+" .. tostring(tokens) .. " Rebirth Token" .. (if tokens == 1 then "" else "s"))
		Analytics.Source(player, "Tokens", tokens, data.RebirthTokens, transactionFor(source), source)
	end

	if reward.Boost then
		local def = Config.GetBoost(reward.Boost)
		local seconds = reward.BoostSeconds or 0
		if def and seconds > 0 then
			local now = os.time()
			data.Boosts[def.Id] = math.max(data.Boosts[def.Id] or 0, now) + seconds
			DataService.MarkDirty(player, "Boosts")
			table.insert(parts, def.Name .. " (" .. Format.Time(seconds) .. ")")
		end
	end

	if reward.Pet then
		local pet = Config.GetPet(reward.Pet)
		if pet and PetService.GrantPet(player, pet.Id) then
			table.insert(parts, pet.Name .. " pet")
		end
	end

	if reward.Egg then
		local hatched = PetService.HatchFree(player, reward.Egg, reward.EggCount or 1)
		if #hatched > 0 then
			table.insert(parts, tostring(#hatched) .. " egg" .. (if #hatched == 1 then "" else "s") .. " hatched")
		end
	end

	if reward.Rebirth then
		if not RebirthService.DoRebirth(player, true) then
			-- Only a concurrent rebirth can fail here; still report the grant failed.
			return false
		end
	end

	if #parts > 0 then
		Net.Notify(player, "Reward", table.concat(parts, ", ") .. "!")
	end
	return true
end

-- Daily -----------------------------------------------------------------------------------------

local function dailyReady(data: Types.PlayerData, now: number): boolean
	return now - data.LastDailyClaim >= Config.DAILY_COOLDOWN_SECONDS
end

local function onClaimDaily(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	local now = os.time()
	if not dailyReady(data, now) then
		Net.Notify(
			player,
			"Error",
			"Next reward in " .. Format.Time(Config.DAILY_COOLDOWN_SECONDS - (now - data.LastDailyClaim)) .. "!"
		)
		return
	end
	local streak = data.DailyStreak + 1
	if data.LastDailyClaim > 0 and now - data.LastDailyClaim > Config.DAILY_STREAK_GRACE_SECONDS then
		streak = 1
	end
	DataService.Mutate(player, { "DailyStreak", "LastDailyClaim" }, function(d)
		d.DailyStreak = streak
		d.LastDailyClaim = now
	end)
	local def = Config.GetDailyReward(streak)
	local multiplier = if MonetizationService.IsPremium(player)
		then Config.Monetization.Premium.DailyRewardMultiplier
		else 1
	RewardsService.Grant(player, def.Reward, "Daily", multiplier)
end

-- Quests ----------------------------------------------------------------------------------------

local function questState(data: Types.PlayerData, def: Types.QuestDef, day: number): Types.QuestProgress
	local existing = data.Quests[def.Id]
	local fresh = existing == nil or (def.Reset == "Daily" and existing.Day ~= day)
	if existing and not fresh then
		return existing
	end
	local state: Types.QuestProgress = {
		Progress = 0,
		Claimed = false,
		Day = if def.Reset == "Daily" then day else nil,
	}
	data.Quests[def.Id] = state
	return state
end

local function rarityOrder(rarity: string?): number
	local def = if rarity then Config.GetRarity(rarity) else nil
	return if def then def.Order else 0
end

-- kind: Types.QuestKind. For "ReachDepth" amount is the new MaxDepth (absolute, not added).
function RewardsService.AddQuestProgress(player: Player, kind: Types.QuestKind, amount: number, rarity: string?)
	local data = DataService.Get(player)
	if not data then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	local day = today()
	local changed = false
	for _, def in Config.Quests do
		if def.Kind == kind then
			if kind == "FindRarity" and rarityOrder(rarity) < rarityOrder(def.Rarity) then
				continue
			end
			local state = questState(data, def, day)
			if state.Claimed then
				continue
			end
			local before = state.Progress
			if kind == "ReachDepth" then
				state.Progress = math.max(state.Progress, amount)
			else
				state.Progress += amount
			end
			state.Progress = math.min(state.Progress, def.Target)
			if state.Progress ~= before then
				changed = true
				if before < def.Target and state.Progress >= def.Target then
					Net.Notify(player, "Info", "Quest complete: " .. def.Name .. "! Claim your reward.")
				end
			end
		end
	end
	if changed then
		DataService.MarkDirty(player, "Quests")
	end
end

local function onClaimQuest(player: Player, questId: any)
	if not Net.IsString(questId, 64) then
		return
	end
	local data = DataService.Get(player)
	local def = Config.GetQuest(questId)
	if not data or not def then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(def) -- refine for the type checker (guarded above)
	local state = questState(data, def, today())
	if state.Claimed then
		Net.Notify(player, "Error", "Already claimed!")
		return
	end
	if state.Progress < def.Target then
		Net.Notify(player, "Error", "Not finished yet!")
		return
	end
	state.Claimed = true
	DataService.MarkDirty(player, "Quests")
	RewardsService.Grant(player, def.Reward, "Quest:" .. def.Id)
end

-- Codes -----------------------------------------------------------------------------------------

local function onRedeemCode(player: Player, code: any)
	if not Net.IsString(code, CODE_MAX_LENGTH) then
		return
	end
	local data = DataService.Get(player)
	if not data then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	local def = Config.GetCode(code)
	if not def or not def.Enabled or (def.Expires ~= nil and os.time() > def.Expires) then
		Net.Notify(player, "Error", "That code doesn't work.")
		return
	end
	assert(def) -- refine for the type checker (guarded above)
	if def.GroupOnly and player:GetAttribute("InGroup") ~= true then
		Net.Notify(player, "Error", "Join our Roblox group to use this code!")
		return
	end
	local key = string.upper(def.Code)
	if data.RedeemedCodes[key] then
		Net.Notify(player, "Error", "You already used that code!")
		return
	end
	data.RedeemedCodes[key] = true
	DataService.MarkDirty(player, "RedeemedCodes")
	RewardsService.Grant(player, def.Reward, "Code:" .. key)
end

-- Social ----------------------------------------------------------------------------------------

local function checkGroup(player: Player)
	if Config.GROUP_ID == 0 then
		player:SetAttribute("InGroup", false)
		return
	end
	local ok, inGroup = pcall(function()
		return player:IsInGroup(Config.GROUP_ID)
	end)
	if ok and player.Parent then
		player:SetAttribute("InGroup", inGroup == true)
	end
end

local function recountFriends(player: Player)
	local cache = friendCache[player]
	if not cache or player.Parent == nil then
		return
	end
	assert(cache) -- refine for the type checker (guarded above)
	local count = 0
	for _, other in Players:GetPlayers() do
		if other ~= player and cache[other.UserId] then
			count += 1
		end
	end
	player:SetAttribute("FriendsInServer", count)
end

local function onSocialJoin(player: Player)
	friendCache[player] = {}
	player:SetAttribute("FriendsInServer", 0)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local ok, isFriend = pcall(function()
				return player:IsFriendsWith(other.UserId)
			end)
			if ok and isFriend then
				local mine = friendCache[player]
				local theirs = friendCache[other]
				if mine then
					mine[other.UserId] = true
				end
				if theirs then
					theirs[player.UserId] = true
				end
				recountFriends(other)
				if other.Parent then
					Net.Notify(other, "Info", "Your friend " .. player.DisplayName .. " joined! Friend sand bonus up!")
				end
			end
		end
	end
	recountFriends(player)
end

-- Lifecycle -------------------------------------------------------------------------------------

function RewardsService.Init()
	Net.On("ClaimDailyReward", onClaimDaily, { Rate = 2, Window = 2 })
	Net.On("ClaimQuest", onClaimQuest, { Rate = 5, Window = 1 })
	Net.On("RedeemCode", onRedeemCode, { Rate = 3, Window = 5 })
end

function RewardsService.Start()
	ServerSignals.Dug:Connect(function(player: Player)
		RewardsService.AddQuestProgress(player, "DigTimes", 1)
	end)
	ServerSignals.Sold:Connect(function(player: Player)
		RewardsService.AddQuestProgress(player, "SellTimes", 1)
	end)
	ServerSignals.TreasureFound:Connect(function(player: Player, treasureId: string)
		RewardsService.AddQuestProgress(player, "FindTreasures", 1)
		local def = Config.GetTreasure(treasureId)
		RewardsService.AddQuestProgress(player, "FindRarity", 1, if def then def.Rarity else nil)
	end)
	ServerSignals.Hatched:Connect(function(player: Player, count: number)
		RewardsService.AddQuestProgress(player, "HatchEggs", count)
	end)
	ServerSignals.UpgradeBought:Connect(function(player: Player)
		RewardsService.AddQuestProgress(player, "BuyUpgrade", 1)
	end)
	ServerSignals.DepthReached:Connect(function(player: Player, maxDepth: number)
		RewardsService.AddQuestProgress(player, "ReachDepth", maxDepth)
	end)
	ServerSignals.Rebirthed:Connect(function(player: Player)
		RewardsService.AddQuestProgress(player, "Rebirth", 1)
	end)

	DataService.PlayerLoaded:Connect(function(player: Player, data: Types.PlayerData)
		-- Milestones already reached before (e.g. quests added in an update) catch up.
		RewardsService.AddQuestProgress(player, "ReachDepth", data.MaxDepth)
		if data.Rebirths > 0 then
			for _, def in Config.Quests do
				if def.Kind == "Rebirth" then
					local state = questState(data, def, today())
					if not state.Claimed and state.Progress < math.min(data.Rebirths, def.Target) then
						state.Progress = math.min(data.Rebirths, def.Target)
						DataService.MarkDirty(player, "Quests")
					end
				end
			end
		end
		if dailyReady(data, os.time()) then
			task.delay(5, function()
				if player.Parent then
					Net.Notify(player, "Info", "Your daily reward is ready!")
				end
			end)
		end
	end)

	-- Play time + PlayMinutes quests.
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in DataService.GetLoadedPlayers() do
				DataService.Increment(player, "PlayTime", 60)
				RewardsService.AddQuestProgress(player, "PlayMinutes", 1)
			end
		end
	end)

	-- Group membership is "checked live".
	task.spawn(function()
		while true do
			task.wait(GROUP_RECHECK)
			for _, player in Players:GetPlayers() do
				task.spawn(checkGroup, player)
			end
		end
	end)
end

function RewardsService.OnPlayerAdded(player: Player)
	task.spawn(checkGroup, player)
	task.spawn(onSocialJoin, player)
end

function RewardsService.OnPlayerRemoving(player: Player)
	friendCache[player] = nil
	for other, cache in friendCache do
		if cache[player.UserId] then
			cache[player.UserId] = nil
			task.defer(recountFriends, other)
		end
	end
end

return RewardsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">RideService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RideService — ride-on vehicles for rideable pets (v2.1, docs/V2.md "ride-on excavator").

	A player who owns any pet with PetDef.Rideable = true (Config.FindRideablePet over
	data.Pets; the best one by Dig.Power) fires "ToggleRide" to spawn its full-size vehicle
	(Models.RideVehicle, see Models/Rides.luau) on the sand next to them and get seated in it
	(Seat:Sit). "ToggleRide" again, jumping out of the seat, dying, respawning or leaving
	despawns it. One vehicle per player, in Workspace.Rides, named "Ride_<UserId>", with
	attributes OwnerUserId, PetId, DigInterval. Player attribute "Riding" = pet id while riding.

	Physics (chosen for robustness):
	- The vehicle is an UNANCHORED assembly (statics welded to Root, digging arm on Motor6Ds)
	  whose network owner is the rider, so driving has no input latency. Only the invisible hull
	  "Chassis" collides and has mass; every visible part is Massless and non-colliding, so the
	  arm / bucket can never bury, trap or fling a player.
	- It is driven by constraints, not BodyMovers: AlignPosition + AlignOrientation
	  (OneAttachment). The rider's RideController integrates throttle / steering into a target
	  pivot (yaw only, always level), clamps it to the ride area (RideMath.Bounds: dig zone +
	  boardwalk) and puts it on the ground (RideMath.GroundY). The server only sets the spawn
	  target and the force limit (assembly weight x Config.Ride.ForceGravities).
	- Holes: the vehicle stays at SURFACE level. Ground samples under the tracks never go below
	  Config.SURFACE_Y, so it drives OVER dug holes and trenches (bridging them) instead of
	  falling in. The bucket digs ahead and down (up to Config.Ride.MaxDigDepth below the
	  surface); deeper than that the player has to drive on.

	Digging: "RideDig" (no arguments; the client only says "scoop now"). Rate-limited to the
	pet's Dig.Interval (x IntervalLeniency). The server picks the point itself: DigAhead studs
	in front of the vehicle's SERVER-side pivot, on the terrain surface found by a downward
	raycast, then DigService.DigAt(player, point, { Source = "Ride", Power, Radius =
	max(Dig.Radius, Ride.MinRadius), SandMultiplier, Origin = vehicle position }). Sand goes to
	the backpack (capacity respected); failures are silent in DigService, so this service sends
	gentle throttled Notifies (backpack full / too hard / out of the zone / can't reach).
	Every scoop is broadcast with "RideDug"(player, position, success, layerIndex) so every
	client animates the bucket and bursts sand.

	Anti-cheat: every ValidateInterval the server samples the pivot. Faster than
	MaxSpeed x SpeedTolerance (+ SpeedSlack), outside the ride area (+ slack) or outside
	[SURFACE_Y + MinY, SURFACE_Y + MaxY] -> the vehicle is put back at the last valid pivot;
	MaxStrikes such resets in a row despawn it. Never seated within SeatTimeout -> despawn.

	Public API:
		RideService.IsRiding(player): boolean
		RideService.GetVehicle(player): Model?
		RideService.Despawn(player)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Models = require(Shared.Models)
local RideMath = require(Shared.Util.RideMath)

local DataService = require(script.Parent.DataService)
local DigService = require(script.Parent.DigService)
local Net = require(script.Parent.Net)
local World = require(script.Parent.Parent.World)

local R = Config.Ride
local S = Config.SURFACE_Y
local TOGGLE_DEBOUNCE = 0.75
local BOUNDS_SLACK = 4

type Ride = {
	Player: Player,
	Def: Types.PetDef,
	Model: Model,
	Root: BasePart,
	Seat: Seat,
	Humanoid: Humanoid,
	AlignPosition: AlignPosition,
	AlignOrientation: AlignOrientation,
	Seated: boolean,
	SpawnedAt: number,
	LastDig: number,
	LastValid: CFrame,
	LastCheck: number,
	Strikes: number,
	Connections: { RBXScriptConnection },
}

local RideService = {}

local rides: { [Player]: Ride } = {}
local lastToggle: { [Player]: number } = {}
local folder: Folder? = nil
local zone = World.GetDigZone()
local bounds = RideMath.Bounds(zone.CFrame, zone.Size)

local terrainOnly = RaycastParams.new()
terrainOnly.FilterType = Enum.RaycastFilterType.Include
terrainOnly.FilterDescendantsInstances = { Workspace.Terrain }
terrainOnly.IgnoreWater = true

local function getFolder(): Folder
	local existing = folder
	if existing and existing.Parent then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = "Rides"
	f.Parent = Workspace
	folder = f
	return f
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid and humanoid.Health > 0 then
		return humanoid
	end
	return nil
end

-- Level pivot (yaw only) at `position`, facing `look` flattened.
local function levelPivot(position: Vector3, look: Vector3): CFrame
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.05 then
		flat = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(position, position + flat.Unit)
end

function RideService.IsRiding(player: Player): boolean
	return rides[player] ~= nil
end

function RideService.GetVehicle(player: Player): Model?
	local ride = rides[player]
	return if ride then ride.Model else nil
end

function RideService.Despawn(player: Player)
	local ride = rides[player]
	if not ride then
		return
	end
	rides[player] = nil
	for _, connection in ride.Connections do
		connection:Disconnect()
	end
	-- Leave the seat first so the rider lands on their feet next to the vehicle.
	local humanoid = ride.Humanoid
	if ride.Seat.Occupant == humanoid and humanoid.Parent then
		humanoid.Sit = false
	end
	ride.Model:Destroy()
	player:SetAttribute("Riding", nil)
end

local function setTarget(ride: Ride, pivot: CFrame)
	ride.AlignPosition.Position = pivot.Position
	ride.AlignOrientation.CFrame = pivot.Rotation
end

local function spawnRide(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	local def = Config.FindRideablePet(data.Pets)
	if not def then
		Net.NotifyThrottled(player, "Error", "You need a rideable pet to ride! 🚜", "RideNoPet", 3)
		return
	end
	assert(def) -- refine for the type checker (guarded above)
	local humanoid = getHumanoid(player)
	local root = Net.GetRoot(player)
	if not humanoid or not root then
		return
	end
	assert(humanoid and root) -- refine for the type checker (guarded above)
	local spot = RideMath.Clamp(root.Position, bounds)
	local offset = Vector3.new(spot.X - root.Position.X, 0, spot.Z - root.Position.Z)
	if offset.Magnitude > R.SpawnMaxDistance then
		Net.NotifyThrottled(
			player,
			"Info",
			"Head down to the beach to ride your " .. def.Name .. "! 🏖️",
			"RideFar",
			3
		)
		return
	end

	local model = Models.RideVehicle(def.Id)
	model.Name = "Ride_" .. player.UserId
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("DigInterval", if def.Dig then def.Dig.Interval else 1)
	local vehicleRoot = model.PrimaryPart
	local seat = model:FindFirstChild("RideSeat")
	local chassis = model:FindFirstChild("Chassis")
	local alignPosition = vehicleRoot and vehicleRoot:FindFirstChild("RideAlignPosition")
	local alignOrientation = vehicleRoot and vehicleRoot:FindFirstChild("RideAlignOrientation")
	if
		not vehicleRoot
		or not seat
		or not seat:IsA("Seat")
		or not chassis
		or not chassis:IsA("BasePart")
		or not alignPosition
		or not alignPosition:IsA("AlignPosition")
		or not alignOrientation
		or not alignOrientation:IsA("AlignOrientation")
	then
		warn("[RideService] ride model is missing parts for " .. def.Id)
		model:Destroy()
		return
	end
	assert(vehicleRoot) -- refine for the type checker (guarded above)
	local rideSeat = seat :: Seat
	local hull = chassis :: BasePart
	local align = alignPosition :: AlignPosition

	local pivot = levelPivot(spot, root.CFrame.LookVector)
	pivot = pivot + Vector3.new(0, RideMath.GroundY(pivot) - pivot.Position.Y, 0)
	model:PivotTo(pivot)
	-- v2.3 streaming: the rider always has the whole vehicle (it owns its physics); everyone else
	-- streams it in and out as one unit.
	model.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	model:AddPersistentPlayer(player)
	model.Parent = getFolder()

	local ride: Ride = {
		Player = player,
		Def = def,
		Model = model,
		Root = vehicleRoot,
		Seat = rideSeat,
		Humanoid = humanoid,
		AlignPosition = align,
		AlignOrientation = alignOrientation :: AlignOrientation,
		Seated = false,
		SpawnedAt = os.clock(),
		LastDig = 0,
		LastValid = pivot,
		LastCheck = os.clock(),
		Strikes = 0,
		Connections = {},
	}
	setTarget(ride, pivot)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
		end
	end
	align.MaxForce = math.max(hull.AssemblyMass, hull:GetMass()) * Workspace.Gravity * R.ForceGravities
	pcall(function()
		hull:SetNetworkOwner(player)
	end)
	rides[player] = ride
	player:SetAttribute("Riding", def.Id)

	table.insert(
		ride.Connections,
		rideSeat:GetPropertyChangedSignal("Occupant"):Connect(function()
			if rideSeat.Occupant == humanoid then
				ride.Seated = true
			elseif ride.Seated and rides[player] == ride then
				RideService.Despawn(player) -- jumped out
			end
		end)
	)
	table.insert(
		ride.Connections,
		humanoid.Died:Connect(function()
			if rides[player] == ride then
				RideService.Despawn(player)
			end
		end)
	)
	table.insert(
		ride.Connections,
		player.CharacterRemoving:Connect(function()
			if rides[player] == ride then
				RideService.Despawn(player)
			end
		end)
	)

	humanoid:UnequipTools()
	rideSeat:Sit(humanoid)
	if rideSeat.Occupant == humanoid then
		ride.Seated = true
	end
end

local function onToggle(player: Player)
	local now = os.clock()
	if lastToggle[player] and now - lastToggle[player] < TOGGLE_DEBOUNCE then
		return
	end
	lastToggle[player] = now
	if rides[player] then
		RideService.Despawn(player)
	else
		spawnRide(player)
	end
end

local FAIL_TEXT: { [string]: { Kind: Net.NotifyKind, Text: string, Every: number } } = {
	BackpackFull = { Kind = "Info", Text = "Backpack full! Sell your sand, then scoop on 🚜", Every = 6 },
	TooHard = { Kind = "Error", Text = "Too hard for this bucket here! 🪨", Every = 5 },
	OutOfZone = { Kind = "Info", Text = "Scoop the sand by the water! 🏖️", Every = 4 },
	Bottom = { Kind = "Info", Text = "You reached the bottom of the world! 🌟", Every = 10 },
}

local function onRideDig(player: Player)
	local ride = rides[player]
	if not ride or not ride.Seated or ride.Model.Parent == nil then
		return
	end
	local dig = ride.Def.Dig
	if not dig then
		Net.NotifyThrottled(player, "Info", ride.Def.Name .. " can't dig.", "RideNoDig", 10)
		return
	end
	assert(dig) -- refine for the type checker (guarded above)
	local now = os.clock()
	if now - ride.LastDig < dig.Interval * R.IntervalLeniency then
		return
	end
	ride.LastDig = now

	-- The server decides where the bucket lands: in front of the vehicle, on the terrain.
	local pivot = ride.Root.CFrame
	local look = Vector3.new(pivot.LookVector.X, 0, pivot.LookVector.Z)
	look = if look.Magnitude > 0.05 then look.Unit else Vector3.new(0, 0, -1)
	local ahead = Vector3.new(pivot.Position.X, S, pivot.Position.Z) + look * R.DigAhead
	local hit = Workspace:Raycast(
		Vector3.new(ahead.X, S + 8, ahead.Z),
		Vector3.new(0, -(8 + R.MaxDigDepth + 4), 0),
		terrainOnly
	)
	if not hit or hit.Position.Y < S - R.MaxDigDepth then
		Net.NotifyThrottled(player, "Info", "The bucket can't reach deeper here, drive on! 🚜", "RideReach", 4)
		return
	end
	local point = hit.Position
	local result = DigService.DigAt(player, point, {
		Power = dig.Power,
		Radius = math.max(dig.Radius, R.MinRadius),
		SandMultiplier = dig.SandMultiplier,
		Source = "Ride",
		Origin = pivot.Position,
	})
	if not result then
		return
	end
	assert(result) -- refine for the type checker (guarded above)
	Net.FireAll("RideDug", player, point, result.Success, result.LayerIndex)
	local reason: string? = result.Reason
	if not result.Success and reason then
		local text = FAIL_TEXT[reason]
		if text then
			Net.NotifyThrottled(player, text.Kind, text.Text, "Ride" .. reason, text.Every)
		end
	end
end

-- Anti-cheat ------------------------------------------------------------------------------------

local function validate(ride: Ride, now: number)
	local player = ride.Player
	if ride.Model.Parent == nil or ride.Root.Parent == nil then
		RideService.Despawn(player)
		return
	end
	if not ride.Seated and now - ride.SpawnedAt > R.SeatTimeout then
		RideService.Despawn(player)
		return
	end
	local pivot = ride.Root.CFrame
	local pos = pivot.Position
	local dt = math.max(now - ride.LastCheck, 1e-3)
	ride.LastCheck = now
	local last = ride.LastValid.Position
	local moved = Vector3.new(pos.X - last.X, 0, pos.Z - last.Z).Magnitude
	local allowed = R.MaxSpeed * R.SpeedTolerance * dt + R.SpeedSlack
	local ok = moved <= allowed
		and RideMath.Inside(pos, bounds, BOUNDS_SLACK)
		and pos.Y >= S + R.MinY
		and pos.Y <= S + R.MaxY
	if ok then
		ride.Strikes = 0
		ride.LastValid = levelPivot(pos, pivot.LookVector)
		return
	end
	ride.Strikes += 1
	if ride.Strikes >= R.MaxStrikes then
		Net.NotifyThrottled(player, "Error", "Your ride went off the beach and was parked.", "RideReset", 5)
		RideService.Despawn(player)
		return
	end
	ride.Model:PivotTo(ride.LastValid)
	ride.Root.AssemblyLinearVelocity = Vector3.zero
	setTarget(ride, ride.LastValid)
end

-- Lifecycle -------------------------------------------------------------------------------------

function RideService.Init()
	Net.On("ToggleRide", function(player: Player)
		onToggle(player)
	end, { Rate = 4, Window = 2 })
	Net.On("RideDig", function(player: Player)
		onRideDig(player)
	end, { Rate = 12, Window = 1 })
end

function RideService.Start()
	task.spawn(function()
		while true do
			task.wait(R.ValidateInterval)
			local now = os.clock()
			for _, ride in rides do
				local ok, err = pcall(function(): any
					validate(ride, now)
					return nil
				end)
				if not ok then
					warn("[RideService] validate error: " .. tostring(err))
				end
			end
		end
	end)
end

function RideService.OnPlayerRemoving(player: Player)
	RideService.Despawn(player)
	lastToggle[player] = nil
end

return RideService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">ServerGoalService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ServerGoalService — a server-wide co-op dig goal (v2.2 SOCIAL, Status & Social agent).
	"Server dig goal: 12.4K / 50K sand": every player's dug sand (ServerSignals.Dug, any source:
	shovel, pets, ride) counts. When the bar fills, Config.Social.ServerGoal.EventId (Golden
	Hour) starts early on this server for EventSeconds (EventService.StartEarly) and everyone gets
	an "Announce" banner. Counting pauses while that event runs plus CooldownSeconds, then a new
	round starts from 0.

	Target: Config.ServerGoalTarget(MaxDepth of every loaded player): scales with the player count
	and with how deep the server is. Recomputed on join / leave and every few seconds while
	counting (progress is never reset mid-round).

	Replicated state (Workspace attributes, the client draws the bar from these):
		"ServerGoalProgress"  number  sand dug this round (floored)
		"ServerGoalTarget"    number  sand needed
		"ServerGoalResumeAt"  number  unix time counting resumes (0 while counting)

	Public API:
		ServerGoalService.Add(sand)        count sand (DigService path calls this via ServerSignals)
		ServerGoalService.GetState(): { Progress, Target, ResumeAt, Completed }
		ServerGoalService.Recompute()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)

local DataService = require(script.Parent.DataService)
local EventService = require(script.Parent.EventService)
local Net = require(script.Parent.Net)
local ServerSignals = require(script.Parent.ServerSignals)

local GOAL = Config.Social.ServerGoal
local PUBLISH_INTERVAL = 1 -- seconds between attribute updates (dig spam is coalesced)

local ServerGoalService = {}

local progress = 0
local target = GOAL.MinSand
local resumeAt = 0
local completed = 0 -- goals reached on this server
local dirty = false

local function publish()
	dirty = false
	Workspace:SetAttribute("ServerGoalProgress", math.floor(progress))
	Workspace:SetAttribute("ServerGoalTarget", target)
	Workspace:SetAttribute("ServerGoalResumeAt", resumeAt)
end

function ServerGoalService.Recompute()
	local depths = {}
	for _, player in DataService.GetLoadedPlayers() do
		local data = DataService.Get(player)
		if data then
			table.insert(depths, data.MaxDepth)
		end
	end
	local newTarget = Config.ServerGoalTarget(depths)
	if newTarget ~= target then
		target = newTarget
		dirty = true
	end
end

local function reached()
	completed += 1
	local def = Config.GetEvent(GOAL.EventId)
	EventService.StartEarly(GOAL.EventId, GOAL.EventSeconds)
	resumeAt = os.time() + EventService.GetSecondsLeft(GOAL.EventId) + GOAL.CooldownSeconds
	local eventName = if def then string.upper(def.Name) else "BONUS"
	Net.NotifyAll(
		"Announce",
		string.format(
			"SERVER GOAL REACHED! %s sand dug together: %s for everyone!",
			Format.Abbreviate(target),
			eventName
		)
	)
	progress = 0
	publish()
end

function ServerGoalService.Add(sand: number)
	if type(sand) ~= "number" or sand ~= sand or sand <= 0 or sand == math.huge then
		return
	end
	if resumeAt > 0 then
		if os.time() < resumeAt then
			return -- the reward event is running / cooling down
		end
		resumeAt = 0
		ServerGoalService.Recompute()
	end
	progress += sand
	dirty = true
	if progress >= target then
		reached()
	end
end

function ServerGoalService.GetState(): { Progress: number, Target: number, ResumeAt: number, Completed: number }
	return { Progress = progress, Target = target, ResumeAt = resumeAt, Completed = completed }
end

function ServerGoalService.Init()
	publish()
	ServerSignals.Dug:Connect(function(_player: Player, _depth: number, gained: number, _source: string)
		ServerGoalService.Add(gained)
	end)
end

function ServerGoalService.Start()
	DataService.PlayerLoaded:Connect(function()
		ServerGoalService.Recompute()
		publish()
	end)
	task.spawn(function()
		local sinceRecompute = 0
		while true do
			task.wait(PUBLISH_INTERVAL)
			sinceRecompute += PUBLISH_INTERVAL
			if sinceRecompute >= 10 then
				sinceRecompute = 0
				ServerGoalService.Recompute()
			end
			if resumeAt > 0 and os.time() >= resumeAt then
				resumeAt = 0
				ServerGoalService.Recompute()
				dirty = true
			end
			if dirty then
				publish()
			end
			if resumeAt == 0 and progress >= target then
				reached() -- a player left and the target dropped below the progress
			end
		end
	end)
end

function ServerGoalService.OnPlayerRemoving(_player: Player)
	-- DataService still lists the leaving player; recompute once they are gone.
	task.delay(1, function()
		ServerGoalService.Recompute()
	end)
end

return ServerGoalService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">ServerSignals</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ServerSignals — server-internal gameplay events. Producers (Dig/Economy/Pet/Shop/Rebirth/Beach
	services) fire; consumers (quests, analytics, leaderboards) subscribe. Keeps services
	decoupled and the require graph acyclic.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local ServerSignals = {
	-- player, dig depth (studs), sand gained, source ("Shovel" | "Auto" | "Digger" | "Pet" | "Ride")
	Dug = Signal.new() :: Signal.Signal<Player, number, number, string>,
	-- player, coins earned, sand sold
	Sold = Signal.new() :: Signal.Signal<Player, number, number>,
	-- player, treasureId
	TreasureFound = Signal.new() :: Signal.Signal<Player, string>,
	-- player, number of eggs hatched, eggId
	Hatched = Signal.new() :: Signal.Signal<Player, number, string>,
	-- player, "Shovel" | "Backpack", item id
	UpgradeBought = Signal.new() :: Signal.Signal<Player, string, string>,
	-- player, new MaxDepth (studs)
	DepthReached = Signal.new() :: Signal.Signal<Player, number>,
	-- player, total rebirths after this one
	Rebirthed = Signal.new() :: Signal.Signal<Player, number>,
	-- v3 discovery: player, carved box min, carved box max, dig source, layer index (DigService)
	Carved = Signal.new() :: Signal.Signal<Player, Vector3, Vector3, string, number>,
	-- player
	BackpackFull = Signal.new() :: Signal.Signal<Player>,
}

return ServerSignals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">SettingsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SettingsService — owns the SetSetting(key, value) remote.

	Three kinds of keys:
	  1. Actions (not persisted), registered by other services:  RegisterAction(key, fn)
	       "SellNow"  (EconomyService) sell from anywhere — needs the SellAnywhere pass or rebirth perk
	  2. Validated settings, registered by other services:        RegisterValidator(key, fn)
	       "AutoDig"  (DigService) boolean — needs the AutoDig pass to turn on
	  3. Generic client preferences (persisted in PlayerData.Settings): any key matching
	     ^[A-Za-z][A-Za-z0-9_]*$ up to 32 chars, value = boolean | finite number | string (<= 64
	     chars) | nil (clears). At most MAX_CLIENT_KEYS keys. Reserved prefixes "FTUE_" and
	     "Server_" are server-only. Examples the UI may use: Music, Sounds, TutorialStep,
	     TutorialDone, HidePets, LowGraphics.

	Public API:
		SettingsService.RegisterAction(key, fn(player, value))
		SettingsService.RegisterValidator(key, fn(player, value) -> (ok, storedValue))
		SettingsService.Get(player, key): any
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Types = require(Shared.Types)

local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)

export type Action = (player: Player, value: any) -> ()
export type Validator = (player: Player, value: any) -> (boolean, any)

local MAX_CLIENT_KEYS = 40
local RESERVED_PREFIXES = { "FTUE_", "Server_" }

local SettingsService = {}

local actions: { [string]: Action } = {}
local validators: { [string]: Validator } = {}

function SettingsService.RegisterAction(key: string, fn: Action)
	actions[key] = fn
end

function SettingsService.RegisterValidator(key: string, fn: Validator)
	validators[key] = fn
end

function SettingsService.Get(player: Player, key: string): any
	local data = DataService.Get(player)
	return if data then data.Settings[key] else nil
end

local function isReserved(key: string): boolean
	for _, prefix in RESERVED_PREFIXES do
		if string.sub(key, 1, #prefix) == prefix then
			return true
		end
	end
	return false
end

-- Only client keys count toward MAX_CLIENT_KEYS (server FTUE_ / Server_ flags don't).
local function clientKeyCount(settings: { [string]: any }): number
	local n = 0
	for key in settings do
		if not isReserved(key) then
			n += 1
		end
	end
	return n
end

local function genericValue(value: any): (boolean, any)
	local t = type(value)
	if value == nil or t == "boolean" then
		return true, value
	elseif t == "number" then
		return Net.IsNumber(value), value
	elseif t == "string" then
		return #value <= 64, value
	end
	return false, nil
end

local function onSetSetting(player: Player, key: any, value: any)
	if not Net.IsString(key, 32) then
		return
	end
	local action = actions[key]
	if action then
		action(player, value)
		return
	end

	local maybeData = DataService.Get(player)
	if not maybeData then
		return
	end
	local data = maybeData :: Types.PlayerData

	local ok, stored
	local validator = validators[key]
	if validator then
		ok, stored = validator(player, value)
	else
		if not string.match(key, "^[%a][%w_]*$") or isReserved(key) then
			return
		end
		ok, stored = genericValue(value)
		if ok and data.Settings[key] == nil and stored ~= nil and clientKeyCount(data.Settings) >= MAX_CLIENT_KEYS then
			ok = false
		end
	end
	if not ok or data.Settings[key] == stored then
		return
	end
	data.Settings[key] = stored
	DataService.MarkDirty(player, "Settings")
end

function SettingsService.Init()
	Net.On("SetSetting", onSetSetting, { Rate = 15, Window = 1 })
end

function SettingsService.Start() end

return SettingsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ShopService — shovels & backpacks.

	Rules (GDD §4): any shovel/backpack can be bought once the player has the coins and
	RebirthsRequired; tiers may be skipped (no "must own previous" rule — after a rebirth coins
	reset anyway, so skipping only matters for rich players and costs them more). Buying equips.
	Equipping requires ownership.

	The equipped shovel is given as a Tool built from Models.Shovel(id): the model's PrimaryPart
	becomes "Handle", every part is unanchored, non-colliding, massless and welded to the handle.
	If the model carries a CFrame attribute "Grip" it is used as Tool.Grip. The tool is re-given on
	every respawn (no StarterGear needed) and the old one is removed on equip. Tools carry the
	attributes "ShovelId" and "TwoHanded" (full-size shovel, posed with both hands on clients).
	Every successful Shovel/Auto dig fires "Scoop"(player) to the other clients (animation only).

	Public API:
		ShopService.GiveShovelTool(player)
		ShopService.Buy(player, kind, id) / ShopService.Equip(player, kind, id)  (kind = "Shovel" | "Backpack")
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Models = require(Shared.Models)

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)
local ServerSignals = require(script.Parent.ServerSignals)

export type ItemKind = "Shovel" | "Backpack"

type ItemDef = {
	Id: string,
	Name: string,
	Price: number,
	RebirthsRequired: number,
}

local ShopService = {}

local function getDef(kind: ItemKind, id: string): ItemDef?
	if kind == "Shovel" then
		return Config.GetShovel(id)
	end
	return Config.GetBackpack(id)
end

local function ownedKey(kind: ItemKind): string
	return if kind == "Shovel" then "OwnedShovels" else "OwnedBackpacks"
end

-- Tool ------------------------------------------------------------------------------------------

local function buildTool(shovelId: string): Tool?
	local def = Config.GetShovel(shovelId)
	if not def then
		return nil
	end
	assert(def) -- refine for the type checker (guarded above)
	local ok, model = pcall(Models.Shovel, shovelId)
	if not ok or typeof(model) ~= "Instance" or not (model :: Instance):IsA("Model") then
		warn("[ShopService] Models.Shovel failed for " .. shovelId .. ": " .. tostring(model))
		return nil
	end
	assert(ok) -- refine for the type checker (guarded above)
	local shovelModel = model :: Model

	local tool = Instance.new("Tool")
	tool.Name = def.Name
	tool.ToolTip = def.Name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("ShovelId", shovelId)

	local handle = shovelModel.PrimaryPart or shovelModel:FindFirstChildWhichIsA("BasePart", true)
	if not handle then
		local part = Instance.new("Part")
		part.Size = Vector3.new(0.4, 4, 0.4)
		part.Color = def.Look.HandleColor
		handle = part
	end
	local handlePart = handle :: BasePart

	for _, descendant in shovelModel:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Massless = true
			if descendant ~= handlePart then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = handlePart
				weld.Part1 = descendant
				weld.Parent = handlePart
			end
		end
	end
	handlePart.Anchored = false
	handlePart.CanCollide = false
	handlePart.Massless = true

	-- Models.Shovel stores the grip on the Handle as "GripOffset"; "Grip" on the model also works.
	local grip = handlePart:GetAttribute("GripOffset") or shovelModel:GetAttribute("Grip")
	if typeof(grip) == "CFrame" then
		tool.Grip = grip
	end
	-- Full-size shovels are posed with both hands by the client ShovelPoseController.
	tool:SetAttribute("TwoHanded", handlePart:GetAttribute("TwoHanded") == true)

	handlePart.Name = "Handle"
	handlePart.Parent = tool
	shovelModel.PrimaryPart = nil
	shovelModel.Name = "Look"
	shovelModel.Parent = tool
	return tool
end

local function removeShovelTools(container: Instance?)
	if not container then
		return
	end
	assert(container) -- refine for the type checker (guarded above)
	for _, child in container:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("ShovelId") ~= nil then
			child:Destroy()
		end
	end
end

function ShopService.GiveShovelTool(player: Player)
	local data = DataService.Get(player)
	if not data or player.Parent == nil then
		return
	end
	assert(data) -- refine for the type checker (guarded above)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	local wasEquipped = false
	if character then
		for _, child in character:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("ShovelId") ~= nil then
				wasEquipped = true
			end
		end
	end
	removeShovelTools(backpack)
	removeShovelTools(character)

	local tool = buildTool(data.Shovel)
	if not tool or not backpack then
		if tool then
			tool:Destroy()
		end
		return
	end
	assert(tool) -- refine for the type checker (guarded above)
	assert(backpack) -- refine for the type checker (guarded above)
	tool.Parent = backpack

	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and (wasEquipped or humanoid:GetAttribute("ShovelAutoEquipped") ~= true) then
		humanoid:SetAttribute("ShovelAutoEquipped", true)
		humanoid:EquipTool(tool)
	end
end

-- Purchases -------------------------------------------------------------------------------------

function ShopService.Equip(player: Player, kind: ItemKind, id: string): boolean
	local data = DataService.Get(player)
	local def = getDef(kind, id)
	if not data or not def then
		return false
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(def) -- refine for the type checker (guarded above)
	local owned = (data :: any)[ownedKey(kind)] :: { [string]: boolean }
	if not owned[id] then
		Net.Notify(player, "Error", "You don't own that yet!")
		return false
	end
	local current = if kind == "Shovel" then data.Shovel else data.Backpack
	if current == id then
		return true
	end
	DataService.Set(player, kind, id)
	if kind == "Shovel" then
		ShopService.GiveShovelTool(player)
	end
	Net.Notify(player, "Success", def.Name .. " equipped!")
	return true
end

function ShopService.Buy(player: Player, kind: ItemKind, id: string): boolean
	local data = DataService.Get(player)
	local def = getDef(kind, id)
	if not data or not def then
		return false
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(def) -- refine for the type checker (guarded above)
	local key = ownedKey(kind)
	local owned = (data :: any)[key] :: { [string]: boolean }
	if owned[id] then
		return ShopService.Equip(player, kind, id)
	end
	if data.Rebirths < def.RebirthsRequired then
		Net.Notify(player, "Error", string.format("Needs %d rebirths!", def.RebirthsRequired))
		return false
	end
	if data.Coins < def.Price then
		Net.Notify(player, "Error", "Not enough coins! Need " .. Format.Abbreviate(def.Price - data.Coins) .. " more.")
		return false
	end

	DataService.Mutate(player, { "Coins", key, kind }, function(d)
		d.Coins -= def.Price
		owned[id] = true
		if kind == "Shovel" then
			d.Shovel = id
		else
			d.Backpack = id
		end
	end)
	if kind == "Shovel" then
		ShopService.GiveShovelTool(player)
		Analytics.Funnel(player, Analytics.Steps.FirstShovel)
	end
	if def.Price > 0 then
		Analytics.Sink(
			player,
			"Coins",
			def.Price,
			data.Coins,
			Enum.AnalyticsEconomyTransactionType.Shop,
			kind .. ":" .. id
		)
	end
	Net.Notify(player, "Success", "You got the " .. def.Name .. "!")
	ServerSignals.UpgradeBought:Fire(player, kind, id)
	return true
end

-- Lifecycle -------------------------------------------------------------------------------------

local function idHandler(kind: ItemKind, buy: boolean): (Player, any) -> ()
	return function(player: Player, id: any)
		if not Net.IsString(id, 64) then
			return
		end
		if buy then
			ShopService.Buy(player, kind, id)
		else
			ShopService.Equip(player, kind, id)
		end
	end
end

function ShopService.Init()
	Net.On("BuyShovel", idHandler("Shovel", true), { Rate = 4, Window = 1 })
	Net.On("EquipShovel", idHandler("Shovel", false), { Rate = 4, Window = 1 })
	Net.On("BuyBackpack", idHandler("Backpack", true), { Rate = 4, Window = 1 })
	Net.On("EquipBackpack", idHandler("Backpack", false), { Rate = 4, Window = 1 })
end

function ShopService.Start()
	DataService.PlayerLoaded:Connect(function(player: Player)
		if player.Character then
			ShopService.GiveShovelTool(player)
		end
	end)
	-- Scoop broadcast: every successful shovel dig plays the scoop animation on that character
	-- for everyone else (the digger's own client already played it on click). Server AutoDig
	-- digs have no click, so those go to the digger too. Pet/digger/ride digs never scoop.
	ServerSignals.Dug:Connect(function(player: Player, _depth: number, _gained: number, source: string)
		if source ~= "Shovel" and source ~= "Auto" then
			return
		end
		for _, other in Players:GetPlayers() do
			if other ~= player or source == "Auto" then
				Net.FireClient("Scoop", other, player)
			end
		end
	end)
end

function ShopService.OnPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character: Model)
		-- Wait for the Backpack/Humanoid of the new character before giving the tool.
		character:WaitForChild("Humanoid", 5)
		player:WaitForChild("Backpack", 5)
		if character.Parent and DataService.IsLoaded(player) then
			ShopService.GiveShovelTool(player)
		end
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">StatusService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	StatusService — what other players can SEE about you (v2.2 B6a / B6b, Status & Social agent).

	Nameplates are rendered on every CLIENT (NameplateController) from replicated Player
	attributes, so each viewer can turn them off ("ShowNameplates" setting) and the server sends
	no GUI. This service keeps the attributes current:
		"TitleLayer"    number  layer index of the deepest layer ever reached (PlayerData.MaxDepth,
		                        kept through rebirths) -> Config.GetTitle(index)
		"RebirthCount"  number  PlayerData.Rebirths (overhead stars)
		"BackpackFill"  number  Sand / Capacity, 0..1 in steps of 0.1 (worn pack's sand level)
	"VIP" / "Premium" are set by MonetizationService.

	Worn backpack: the equipped backpack model (Models.Backpack(id)) is welded to every
	character's UpperTorso (R15) or Torso (R6) at torso * CFrame.new(0, 0, torso.Size.Z / 2)
	(the model's Root sits on the torso's back face, see Models/Backpacks). Every part is
	unanchored, Massless, CanCollide/CanQuery/CanTouch false (never blocks digs, clicks or
	physics). Rebuilt on equip (DataService.Changed "Backpack") and on every respawn. The model is
	named "WornBackpack" and carries attribute "BackpackId".

	Public API:
		StatusService.AttachBackpack(player): Model?   (re)build the worn pack now
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Models = require(Shared.Models)
local Types = require(Shared.Types)

local DataService = require(script.Parent.DataService)

local StatusService = {}

local WORN_NAME = "WornBackpack"
local TORSO_NAMES = { "UpperTorso", "Torso" }

local function findTorso(character: Model): BasePart?
	for _, name in TORSO_NAMES do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	return nil
end

local function setIfChanged(player: Player, name: string, value: any)
	if player:GetAttribute(name) ~= value then
		player:SetAttribute(name, value)
	end
end

local function refreshAttributes(player: Player)
	local data = DataService.Get(player)
	if not data or player.Parent == nil then
		return
	end
	local loaded = data :: Types.PlayerData
	setIfChanged(player, "TitleLayer", Config.GetLayerIndexAtDepth(loaded.MaxDepth))
	setIfChanged(player, "RebirthCount", loaded.Rebirths)
	local capacity = player:GetAttribute("Capacity")
	local cap = if type(capacity) == "number" and capacity > 0
		then capacity
		else (Config.GetBackpack(loaded.Backpack) or Config.Backpacks[1]).Capacity
	local fill = math.clamp(math.floor(loaded.Sand / cap * 10 + 0.5) / 10, 0, 1)
	setIfChanged(player, "BackpackFill", fill)
end

function StatusService.AttachBackpack(player: Player): Model?
	local maybeCharacter = player.Character
	local data = DataService.Get(player)
	if maybeCharacter == nil or data == nil then
		return nil
	end
	local character = maybeCharacter :: Model
	local maybeTorso = findTorso(character)
	if maybeTorso == nil then
		return nil
	end
	local torso = maybeTorso :: BasePart
	local backpackId = (data :: Types.PlayerData).Backpack
	local existing = character:FindFirstChild(WORN_NAME)
	if existing and existing:GetAttribute("BackpackId") == backpackId then
		return existing :: Model
	end
	if existing then
		existing:Destroy()
	end
	local model = Models.Backpack(backpackId)
	model.Name = WORN_NAME
	model:SetAttribute("BackpackId", backpackId)
	local root = model.PrimaryPart
	if not root then
		model:Destroy()
		return nil
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.Massless = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	local offset = CFrame.new(0, 0, torso.Size.Z / 2)
	model:PivotTo(torso.CFrame * offset)
	local weld = Instance.new("Weld")
	weld.Name = "BackpackWeld"
	weld.Part0 = torso
	weld.Part1 = root
	weld.C0 = offset
	weld.C1 = CFrame.identity
	weld.Parent = root
	model.Parent = character
	return model
end

local function onCharacter(player: Player, character: Model)
	if StatusService.AttachBackpack(player) then
		return
	end
	-- the torso (or the data) may arrive after the character: retry when a torso shows up
	local connection: RBXScriptConnection? = nil
	connection = character.ChildAdded:Connect(function(child: Instance)
		if table.find(TORSO_NAMES, child.Name) and child:IsA("BasePart") then
			-- deferred: the rig may still be sizing / jointing the new part this frame
			task.defer(function()
				if StatusService.AttachBackpack(player) and connection then
					connection:Disconnect()
				end
			end)
		end
	end)
	character.Destroying:Once(function()
		if connection then
			connection:Disconnect()
		end
	end)
end

function StatusService.Init() end

function StatusService.Start()
	DataService.PlayerLoaded:Connect(function(player: Player)
		refreshAttributes(player)
		StatusService.AttachBackpack(player)
	end)
	DataService.Changed:Connect(function(player: Player, keys: { string })
		local attrs, pack = false, false
		for _, key in keys do
			if key == "MaxDepth" or key == "Rebirths" or key == "Sand" then
				attrs = true
			elseif key == "Backpack" then
				attrs = true
				pack = true
			end
		end
		if attrs then
			refreshAttributes(player)
		end
		if pack then
			StatusService.AttachBackpack(player)
		end
	end)
end

function StatusService.OnPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character: Model)
		onCharacter(player, character)
	end)
	if player.Character then
		onCharacter(player, player.Character)
	end
	player:GetAttributeChangedSignal("Capacity"):Connect(function()
		refreshAttributes(player)
	end)
end

return StatusService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">StreamingService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	StreamingService (v2.3, Platform agent): server half of Workspace.StreamingEnabled.

	With streaming on, a client only has the parts near its character (StreamingTargetRadius 320,
	at least StreamingMinRadius 64; see default.project.json and docs/PERFORMANCE.md). A player at
	the bottom of a 1000-stud hole, or at the far end of the 768-stud beach, does NOT have the
	hub stations. So:

	1. World anchors. For every station tag (ANCHOR_TAGS) the server publishes the world
	   positions of all tagged instances as attributes on a non-spatial folder that always
	   replicates:
	     ReplicatedStorage.WorldAnchors.<Tag>   attributes  Count = n, P1..Pn = Vector3
	   (BasePart: top-centre, the same point GuideController aims at; Model: its pivot.)
	   Clients read them through Client/Util/Anchors, for example to aim a guide beam at a
	   station that has streamed out. They are rebuilt when tagged instances are added or removed.
	   StreamingService.Track(tag) adds another tag (e.g. a new v3 station).

	2. Station models stream atomically. The closest ancestor Model of every tagged station
	   gets ModelStreamingMode = Atomic (only when still Default), so a station's part, its
	   ProximityPrompt, its billboard and attributes like EggId arrive and leave together.
	   Nothing is Persistent: no client system needs a far station anymore (guides use anchors,
	   the sell pad is detected on the server, leaderboards are server-rendered SurfaceGuis).

	Other streaming modes are set where the models are created: ride vehicles
	(RideService) and placed shades (SurvivalShades) are PersistentPerPlayer, kept for their
	owner and Atomic for everyone else.

	API: StreamingService.Init(), StreamingService.Track(tag), StreamingService.GetAnchors(tag)
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local StreamingService = {}

StreamingService.FOLDER = "WorldAnchors"
StreamingService.ANCHOR_TAGS = {
	"SellZone",
	"ShovelShop",
	"BackpackShop",
	"EggShop",
	"CrateShop",
	"RebirthStatue",
	"WaterFountain",
	"BeachShop",
	"LeaderboardCoins",
	"LeaderboardDepth",
	"SpawnLocation",
}
-- Tags whose ancestor Model must not be made Atomic (spawns are loose parts in the Hub folder).
local NO_ATOMIC: { [string]: boolean } = { SpawnLocation = true }

local folder: Folder? = nil
local tracked: { [string]: boolean } = {}
local pending: { [string]: boolean } = {}

local function getFolder(): Folder
	local current = folder
	if current and current.Parent then
		return current
	end
	local existing = ReplicatedStorage:FindFirstChild(StreamingService.FOLDER)
	if existing and existing:IsA("Folder") then
		folder = existing
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = StreamingService.FOLDER
	f.Parent = ReplicatedStorage
	folder = f
	return f
end

local function anchorOf(inst: Instance): Vector3?
	if inst:IsA("BasePart") then
		return inst.Position + Vector3.new(0, inst.Size.Y / 2, 0)
	elseif inst:IsA("Model") then
		return inst:GetPivot().Position
	end
	return nil
end

local function makeAtomic(tag: string, inst: Instance)
	if NO_ATOMIC[tag] or not inst:IsDescendantOf(Workspace) then
		return
	end
	local model = if inst:IsA("Model") then inst else inst:FindFirstAncestorWhichIsA("Model")
	if model and model.ModelStreamingMode == Enum.ModelStreamingMode.Default then
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end
end

function StreamingService.GetAnchors(tag: string): { Vector3 }
	local list: { Vector3 } = {}
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsDescendantOf(Workspace) then
			local position = anchorOf(inst)
			if position then
				table.insert(list, position)
			end
		end
	end
	return list
end

local function rebuild(tag: string)
	pending[tag] = nil
	local root = getFolder()
	local holder = root:FindFirstChild(tag)
	if not holder then
		local f = Instance.new("Folder")
		f.Name = tag
		f.Parent = root
		holder = f
	end
	local target = holder :: Instance
	local old = target:GetAttribute("Count")
	local list = StreamingService.GetAnchors(tag)
	for i, position in list do
		target:SetAttribute("P" .. i, position)
	end
	if typeof(old) == "number" then
		for i = #list + 1, old do
			target:SetAttribute("P" .. i, nil)
		end
	end
	target:SetAttribute("Count", #list)
end

-- Tests only: the headless client mock shares ONE instance tree between "server" and client, so a
-- simulated client stream-out looks like a server removal. Frozen = keep the published anchors.
local frozen = false
function StreamingService._Freeze(value: boolean)
	frozen = value
end

local function schedule(tag: string)
	if pending[tag] or frozen then
		return
	end
	pending[tag] = true
	task.defer(rebuild, tag)
end

function StreamingService.Track(tag: string)
	if tracked[tag] then
		return
	end
	tracked[tag] = true
	for _, inst in CollectionService:GetTagged(tag) do
		makeAtomic(tag, inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst: Instance)
		makeAtomic(tag, inst)
		schedule(tag)
	end)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function()
		schedule(tag)
	end)
	rebuild(tag)
end

function StreamingService.Init()
	getFolder()
	for _, tag in StreamingService.ANCHOR_TAGS do
		StreamingService.Track(tag)
	end
end

return StreamingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">SurvivalService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SurvivalService — heat, shade and snacks (owner: Survival). Soft and kid-friendly: heat only
	ever slows digging down (Sunburnt), never damages. See docs/design/Survival.md and
	Config/Heat.luau for the numbers.

	Heat (server-authoritative, not persisted, ticked every Heat.TickSeconds):
	  underground (attribute Depth >= UndergroundDepth)  falls
	  under any placed shade (SurvivalShades.GetCoverAt) falls x shade Cooling
	  on the hot sand in the sun                          rises (+ per dig via ServerSignals.Dug),
	                                                      x event multiplier (Golden Hour / High Tide)
	  anywhere else (boardwalk, hub, swimming)            falls slowly
	New players (PlayerData.PlayTime < NewPlayerGraceSeconds) never heat up.
	Sunburnt at SunburntAt until heat <= RecoverAt (DigService reads the attribute).

	Player attributes set here:
	  Heat (number 0..Max), Sunburnt (bool), InShade (bool),
	  HeatZone ("Sun" | "Shade" | "Underground" | "Cool"), HeatGrace (bool)

	Remotes: BuyShade, PlaceShade, PickUpShade (SurvivalShades), BuyConsumable(id, count),
	UseConsumable(id), DrinkFountain() (near a part tagged "WaterFountain").
	Products: Reward.Consumables is granted by SurvivalService.GrantConsumables (Main's grant
	handler calls it after RewardsService.Grant).

	Public API:
		SurvivalService.GetHeat(player): number
		SurvivalService.SetHeat(player, heat)          -- dev / tests
		SurvivalService.Cool(player, amount)
		SurvivalService.IsSunburnt(player): boolean
		SurvivalService.BuyConsumable(player, id, count): boolean
		SurvivalService.UseConsumable(player, id): boolean
		SurvivalService.DrinkFountain(player): boolean
		SurvivalService.GrantConsumables(player, map, source?): boolean
		SurvivalService.Shades -> SurvivalShades
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Format = require(Shared.Util.Format)

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local EventService = require(script.Parent.EventService)
local Net = require(script.Parent.Net)
local ServerSignals = require(script.Parent.ServerSignals)
local SurvivalShades = require(script.Parent.SurvivalShades)
local World = require(script.Parent.Parent.World)

type HeatState = {
	Heat: number,
	Sunburnt: boolean,
	PendingDig: number, -- dig heat queued since the last tick
	OnSand: boolean, -- last known "standing on hot sand" (kept while airborne)
	LastFountain: number,
}

export type Zone = "Sun" | "Shade" | "Underground" | "Cool"

local Heat = Config.Heat

local FOUNTAIN_REACH = 22
local MAX_BUY_COUNT = 50

local SurvivalService = {}
SurvivalService.Shades = SurvivalShades

local states: { [Player]: HeatState } = {}

-- Floors that count as "the hot sand" (top layers of the beach).
local HOT_FLOORS: { [Enum.Material]: boolean } = {
	[Enum.Material.Sand] = true,
	[Config.Layers[1].Material] = true,
}
if Config.Layers[2] then
	HOT_FLOORS[Config.Layers[2].Material] = true
end

local function getState(player: Player): HeatState
	local state = states[player]
	if not state then
		state = {
			Heat = 0,
			Sunburnt = false,
			PendingDig = 0,
			OnSand = false,
			LastFountain = -math.huge,
		}
		states[player] = state
	end
	return state
end

local function setAttr(player: Player, name: string, value: any)
	if player:GetAttribute(name) ~= value then
		player:SetAttribute(name, value)
	end
end

local function publish(player: Player, state: HeatState)
	if player.Parent == nil then
		return
	end
	if state.Sunburnt and state.Heat <= Heat.RecoverAt then
		state.Sunburnt = false
	elseif not state.Sunburnt and state.Heat >= Heat.SunburntAt then
		state.Sunburnt = true
	end
	setAttr(player, "Heat", math.floor(state.Heat * 10 + 0.5) / 10)
	setAttr(player, "Sunburnt", state.Sunburnt)
end

local function inGrace(player: Player): boolean
	local data = DataService.Get(player)
	return data ~= nil and data.PlayTime < Heat.NewPlayerGraceSeconds
end

local function sunMultiplier(): number
	local multiplier = 1
	for _, id in EventService.GetActiveIds() do
		local m = Heat.EventSunMultipliers[id]
		if m then
			multiplier *= m
		end
	end
	return multiplier
end

local function onHotSand(state: HeatState, root: BasePart, humanoid: Humanoid, depth: number): boolean
	if humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		state.OnSand = false
		return false
	end
	if depth > 0 or World.IsInDigZone(root.Position) and root.Position.Y >= Config.SURFACE_Y - 2 then
		state.OnSand = true
		return true
	end
	local floor = humanoid.FloorMaterial
	if floor == Enum.Material.Air then
		return state.OnSand -- jumping / falling: keep the last answer
	end
	state.OnSand = HOT_FLOORS[floor] == true
	return state.OnSand
end

-- One heat step for one player. Returns the zone used (for the HUD).
local function step(player: Player, state: HeatState, dt: number, sun: number): Zone?
	local maybeRoot = Net.GetRoot(player)
	local character = player.Character
	local maybeHumanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not maybeRoot or not maybeHumanoid then
		state.PendingDig = 0
		return nil
	end
	local root = maybeRoot :: BasePart
	local humanoid = maybeHumanoid :: Humanoid
	local depthAttr = player:GetAttribute("Depth")
	local depth = if type(depthAttr) == "number" then depthAttr else 0
	local digHeat = math.min(state.PendingDig, Heat.DigRiseMaxPerSecond * dt)
	state.PendingDig = 0

	local zone: Zone
	local delta: number
	local cover = SurvivalShades.GetCoverAt(root.Position)
	if depth >= Heat.UndergroundDepth then
		zone = "Underground"
		delta = -Heat.UndergroundFallPerSecond * dt
	elseif cover then
		zone = "Shade"
		delta = -Heat.ShadeFallPerSecond * cover.Cooling * dt
	elseif onHotSand(state, root, humanoid, depth) then
		zone = "Sun"
		delta = if inGrace(player) then 0 else Heat.SunRisePerSecond * sun * dt + digHeat * sun
	else
		zone = "Cool"
		delta = -Heat.OffSandFallPerSecond * dt
	end
	state.Heat = math.clamp(state.Heat + delta, 0, Heat.Max)
	setAttr(player, "InShade", cover ~= nil)
	setAttr(player, "HeatZone", zone)
	setAttr(player, "HeatGrace", inGrace(player))
	publish(player, state)
	return zone
end

-- Public API ----------------------------------------------------------------------------------------

function SurvivalService.GetHeat(player: Player): number
	local state = states[player]
	return if state then state.Heat else 0
end

function SurvivalService.SetHeat(player: Player, heat: number)
	local state = getState(player)
	state.Heat = math.clamp(heat, 0, Heat.Max)
	publish(player, state)
end

function SurvivalService.Cool(player: Player, amount: number)
	local state = getState(player)
	state.Heat = math.clamp(state.Heat - amount, 0, Heat.Max)
	publish(player, state)
end

function SurvivalService.IsSunburnt(player: Player): boolean
	local state = states[player]
	return state ~= nil and state.Sunburnt
end

local function applyBoost(player: Player, data: Types.PlayerData, boostId: string, seconds: number)
	local def = Config.GetBoost(boostId)
	if not def or seconds <= 0 then
		return
	end
	local now = os.time()
	local current = data.Boosts[boostId] or 0
	local extended = math.min(math.max(current, now) + seconds, now + Heat.ConsumableBoostCapSeconds)
	data.Boosts[boostId] = math.max(current, extended)
	DataService.MarkDirty(player, "Boosts")
end

function SurvivalService.BuyConsumable(player: Player, id: string, count: number): boolean
	local data = DataService.Get(player)
	local def = Config.GetConsumable(id)
	if not data or not def then
		return false
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(def) -- refine for the type checker (guarded above)
	if def.Price <= 0 then
		Net.Notify(player, "Info", def.Name .. " is free at the fountain!")
		return false
	end
	local have = data.Consumables[id] or 0
	local n = math.min(count, Heat.ConsumableMaxStack - have)
	if n <= 0 then
		Net.Notify(player, "Error", "Your cooler is full of " .. def.Name .. "!")
		return false
	end
	local cost = def.Price * n
	if data.Coins < cost then
		Net.Notify(player, "Error", "Not enough coins! Need " .. Format.Abbreviate(cost - data.Coins) .. " more.")
		return false
	end
	DataService.Mutate(player, { "Coins", "Consumables" }, function(d)
		d.Coins -= cost
		d.Consumables[id] = have + n
	end)
	Analytics.Sink(player, "Coins", cost, data.Coins, Enum.AnalyticsEconomyTransactionType.Shop, "Consumable:" .. id)
	Net.Notify(player, "Success", "+" .. n .. " " .. def.Icon .. " " .. def.Name .. "!")
	return true
end

function SurvivalService.UseConsumable(player: Player, id: string): boolean
	local data = DataService.Get(player)
	local def = Config.GetConsumable(id)
	if not data or not def then
		return false
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(def) -- refine for the type checker (guarded above)
	local have = data.Consumables[id] or 0
	if have <= 0 then
		Net.Notify(player, "Error", "You don't have any " .. def.Name .. "! Get some at the Beach Shop.")
		return false
	end
	local state = getState(player)
	if def.Boost == nil and state.Heat < 1 then
		Net.NotifyThrottled(player, "Info", "You're already nice and cool! 😎", "AlreadyCool", 3)
		return false
	end
	DataService.Mutate(player, { "Consumables" }, function(d)
		if have > 1 then
			d.Consumables[id] = have - 1
		else
			d.Consumables[id] = nil
		end
	end)
	SurvivalService.Cool(player, def.Cooling)
	if def.Boost and def.BoostSeconds then
		applyBoost(player, data, def.Boost, def.BoostSeconds)
	end
	return true
end

function SurvivalService.DrinkFountain(player: Player): boolean
	local maybeRoot = Net.GetRoot(player)
	if not maybeRoot then
		return false
	end
	local root = maybeRoot :: BasePart
	local near = false
	for _, inst in CollectionService:GetTagged("WaterFountain") do
		local position = if inst:IsA("BasePart")
			then inst.Position
			elseif inst:IsA("Model") then inst:GetPivot().Position
			else nil
		if position and (position - root.Position).Magnitude <= FOUNTAIN_REACH then
			near = true
			break
		end
	end
	if not near then
		return false
	end
	local state = getState(player)
	local now = os.clock()
	if now - state.LastFountain < Heat.FountainCooldownSeconds then
		return false
	end
	state.LastFountain = now
	local water = Config.GetConsumable("water")
	SurvivalService.Cool(player, if water then water.Cooling else 70)
	Net.NotifyThrottled(player, "Success", "Ahh, refreshing! 💧", "Fountain", 4)
	return true
end

-- Grants consumables from a product / reward. Unknown ids are ignored. Always returns true when
-- the player's data is loaded (so a receipt can be acknowledged).
function SurvivalService.GrantConsumables(player: Player, items: { [string]: number }, _source: string?): boolean
	local data = DataService.Get(player)
	if not data then
		return false
	end
	local parts: { string } = {}
	DataService.Mutate(player, { "Consumables" }, function(d)
		for id, count in items do
			local def = Config.GetConsumable(id)
			if def and type(count) == "number" and count > 0 then
				-- products may exceed the shop stack cap a little; never above 2x
				local current = d.Consumables[id] or 0
				local new = math.min(current + math.floor(count), Heat.ConsumableMaxStack * 2)
				d.Consumables[id] = new
				if new > current then
					table.insert(parts, "+" .. (new - current) .. " " .. def.Icon .. " " .. def.Name)
				end
			end
		end
	end)
	if #parts > 0 then
		table.sort(parts)
		Net.Notify(player, "Reward", table.concat(parts, ", ") .. "!")
	end
	return true
end

-- Lifecycle -----------------------------------------------------------------------------------------

function SurvivalService.Init()
	SurvivalShades.Init()

	Net.On("BuyConsumable", function(player: Player, id: any, count: any)
		if not Net.IsString(id, 64) then
			return
		end
		if Net.IsInteger(count, 1, MAX_BUY_COUNT) then
			SurvivalService.BuyConsumable(player, id, count)
		end
	end, { Rate = 4, Window = 1 })

	Net.On("UseConsumable", function(player: Player, id: any)
		if Net.IsString(id, 64) then
			SurvivalService.UseConsumable(player, id)
		end
	end, { Rate = 4, Window = 1 })

	Net.On("DrinkFountain", function(player: Player)
		SurvivalService.DrinkFountain(player)
	end, { Rate = 2, Window = 1 })
end

function SurvivalService.Start()
	ServerSignals.Dug:Connect(function(player: Player, _depth: number, _gained: number, source: string?)
		local state = states[player]
		-- Diggers dig while their owner stands still: only the player's own swings heat them up.
		if state and source ~= "Digger" and source ~= "Pet" and source ~= "Ride" then
			state.PendingDig += Heat.DigRisePerDig
		end
	end)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(Heat.TickSeconds)
			local now = os.clock()
			local dt = math.min(now - last, 1)
			last = now
			local sun = sunMultiplier()
			for player, state in states do
				if player.Parent == nil then
					continue
				end
				local ok, err = pcall(step, player, state, dt, sun)
				if not ok then
					warn("[SurvivalService] heat tick failed for " .. player.Name .. ": " .. tostring(err))
				end
			end
		end
	end)
end

function SurvivalService.OnPlayerAdded(player: Player)
	local state = getState(player)
	player:SetAttribute("Heat", 0)
	player:SetAttribute("Sunburnt", false)
	player:SetAttribute("InShade", false)
	player:SetAttribute("HeatZone", "Cool")
	publish(player, state)
end

function SurvivalService.OnPlayerRemoving(player: Player)
	SurvivalShades.RemoveAll(player)
	states[player] = nil
end

return SurvivalService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">SurvivalShades</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SurvivalShades — buying, placing and picking up shade items (part of SurvivalService).

	Placement rules (server-authoritative; the client only sends shadeId, a raycast hit point and
	a yaw — the server resolves the ground itself from the terrain voxels):
	  - the shade is owned (PlayerData.OwnedShades),
	  - the point is within Heat.ShadePlaceRange studs (horizontal) of the player,
	  - it is on the beach surface: inside the dig zone, or on Sand / a layer material,
	    not in the sea, not deep in a hole,
	  - there is solid ground right under it (not floating over a hole),
	  - it keeps Heat.ShadeHubClearance studs from hub stations and Heat.ShadeMinSpacing studs
	    from other shades, and nothing solid stands in the way.
	Each player has Heat.ShadeSlots active shades (VIP pass: ShadeSlotsVip); placing one more
	replaces the oldest. Shades despawn when the owner leaves. If the sand under a shade is dug
	away later, it simply stays where it is (anchored).

	Placed shades live in Workspace.Shades as Models (Models.Shade) with attributes
	OwnerUserId, OwnerName, ShadeId, Radius, Cooling, Height and the CollectionService tag
	"PlacedShade".

	API (used by SurvivalService and tests):
		SurvivalShades.Buy(player, shadeId): boolean
		SurvivalShades.Place(player, shadeId, position, yaw): (boolean, string?)
		SurvivalShades.PickUp(player, shadeId?): number      -- shades removed
		SurvivalShades.RemoveAll(player)
		SurvivalShades.GetPlaced(player?): { Placed }
		SurvivalShades.GetCoverAt(position): Placed?         -- best-cooling shade covering it
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Types = require(Shared.Types)
local Format = require(Shared.Util.Format)
local Models = require(Shared.Models)

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local MonetizationService = require(script.Parent.MonetizationService)
local Net = require(script.Parent.Net)
local World = require(script.Parent.Parent.World)

export type Placed = {
	Model: Model,
	Owner: Player,
	ShadeId: string,
	Position: Vector3,
	Radius: number,
	Cooling: number,
	Height: number,
	PlacedAt: number,
}

local Heat = Config.Heat
local terrain = Workspace.Terrain

local SurvivalShades = {}

SurvivalShades.TAG = "PlacedShade"
-- Stations players gather at: no shades on top of them.
SurvivalShades.HUB_TAGS = {
	"SellZone",
	"ShovelShop",
	"BackpackShop",
	"EggShop",
	"RebirthStatue",
	"WaterFountain",
	"BeachShop",
	"Garage",
	"SpawnLocation",
	"LeaderboardCoins",
	"LeaderboardDepth",
}

local SURFACE_BELOW = 6 -- placement may not be more than this many studs below SURFACE_Y
local SURFACE_ABOVE = 30
local MAX_GROUND_GAP = 4 -- client point may sit at most this far above the solid voxel top
local MAX_GROUND_SINK = 3 -- ...or this far below it (smooth-terrain surface rounding)
local VERTICAL_RANGE = 24
local COVER_BELOW = 6 -- a player this far below the shade's ground still counts (shallow holes)

local placed: { Placed } = {}
local folder: Folder? = nil
local placeCounter = 0

local beachMaterials: { [Enum.Material]: boolean } = { [Enum.Material.Sand] = true }
for _, layer in Config.Layers do
	beachMaterials[layer.Material] = true
end

local function getFolder(): Folder
	local existing = folder
	if existing and existing.Parent then
		return existing
	end
	local f = Workspace:FindFirstChild("Shades")
	if not (f and f:IsA("Folder")) then
		f = Instance.new("Folder")
		f.Name = "Shades"
		f.Parent = Workspace
	end
	folder = f :: Folder
	return f :: Folder
end

local function horizontal(a: Vector3, b: Vector3): number
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

local function positionOf(inst: Instance): Vector3?
	if inst:IsA("BasePart") then
		return inst.Position
	elseif inst:IsA("Model") then
		return inst:GetPivot().Position
	elseif inst:IsA("Attachment") then
		return inst.WorldPosition
	end
	return nil
end

-- Top of the solid terrain in the 4-stud voxel column under `position` (scans from 8 studs above
-- to 12 below). Returns (topY, material) or nil when there is no ground there.
local function groundAt(position: Vector3): (number?, Enum.Material?)
	local lo = Vector3.new(position.X - 0.5, position.Y - 12, position.Z - 0.5)
	local hi = Vector3.new(position.X + 0.5, position.Y + 8, position.Z + 0.5)
	local region = Region3.new(lo, hi):ExpandToGrid(4)
	local ok, materials, occupancies = pcall(function()
		return terrain:ReadVoxels(region, 4)
	end)
	if not ok then
		return nil, nil
	end
	local size: Vector3 = materials.Size
	local minY = region.CFrame.Position.Y - region.Size.Y / 2
	for y = size.Y, 1, -1 do
		for x = 1, size.X do
			for z = 1, size.Z do
				local material = materials[x][y][z]
				local occ = occupancies[x][y][z]
				if material ~= Enum.Material.Air and occ > 0.3 then
					return minY + (y - 1) * 4 + occ * 4, material
				end
			end
		end
	end
	return nil, nil
end

local function shadeSlots(player: Player): number
	if MonetizationService.OwnsPass(player, "VIP") then
		return Heat.ShadeSlotsVip
	end
	return Heat.ShadeSlots
end

local function blocked(position: Vector3): boolean
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = { getFolder() }
	for _, other in game:GetService("Players"):GetPlayers() do
		if other.Character then
			table.insert(exclude, other.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	local parts =
		Workspace:GetPartBoundsInBox(CFrame.new(position + Vector3.new(0, 3, 0)), Vector3.new(2, 4, 2), params)
	for _, part in parts do
		if not part:IsA("Terrain") and part.CanCollide and part.Transparency < 1 then
			return true
		end
	end
	return false
end

-- Validates and resolves the final ground point. Returns (position, nil) or (nil, reason).
local function resolvePlacement(player: Player, position: Vector3): (Vector3?, string?)
	local maybeRoot = Net.GetRoot(player)
	if not maybeRoot then
		return nil, "Respawn first!"
	end
	local root = maybeRoot :: BasePart
	if
		horizontal(root.Position, position) > Heat.ShadePlaceRange
		or math.abs(root.Position.Y - position.Y) > VERTICAL_RANGE
	then
		return nil, "Too far away! Get closer."
	end
	if position.Y < Config.SURFACE_Y - SURFACE_BELOW or position.Y > Config.SURFACE_Y + SURFACE_ABOVE then
		return nil, "Put it on the beach surface, not down a hole!"
	end
	local groundTop, groundMaterial = groundAt(position)
	if groundTop == nil or groundMaterial == nil then
		return nil, "Can't place it over a hole!"
	end
	local top = groundTop :: number
	local material = groundMaterial :: Enum.Material
	if material == Enum.Material.Water then
		return nil, "Not in the water! Put it on the sand."
	end
	if position.Y - top > MAX_GROUND_GAP then
		return nil, "Can't place it over a hole!"
	end
	if top - position.Y > MAX_GROUND_SINK then
		return nil, "Can't place it there!"
	end
	if not (World.IsInDigZone(position) or beachMaterials[material]) then
		return nil, "Place it on the beach sand!"
	end
	for _, tag in SurvivalShades.HUB_TAGS do
		for _, inst in CollectionService:GetTagged(tag) do
			local p = positionOf(inst)
			if p and horizontal(p, position) < Heat.ShadeHubClearance and math.abs(p.Y - position.Y) < 30 then
				return nil, "Too close to the shops! Find a sunny spot on the sand."
			end
		end
	end
	for _, other in placed do
		if horizontal(other.Position, position) < Heat.ShadeMinSpacing then
			return nil, "Too close to another shade!"
		end
	end
	if blocked(position) then
		return nil, "Something is in the way!"
	end
	-- Sit on the visible surface: trust the client's raycast height only within the voxel bounds.
	local y = math.clamp(position.Y, top - MAX_GROUND_SINK, top + MAX_GROUND_GAP)
	return Vector3.new(position.X, y, position.Z), nil
end

local function ownerLabel(model: Model, player: Player, def: Types.ShadeDef)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "OwnerLabel"
	gui.Size = UDim2.fromOffset(220, 34)
	gui.StudsOffset = Vector3.new(0, def.Height + 4, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = "⛱️ " .. player.DisplayName .. "'s " .. def.Name
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(40, 30, 50)
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = root
end

local function destroy(entry: Placed)
	local i = table.find(placed, entry)
	if i then
		table.remove(placed, i)
	end
	if entry.Model.Parent then
		entry.Model:Destroy()
	end
end

-- Public --------------------------------------------------------------------------------------------

function SurvivalShades.GetPlaced(player: Player?): { Placed }
	local list = {}
	for _, entry in placed do
		if player == nil or entry.Owner == player then
			table.insert(list, entry)
		end
	end
	return list
end

-- Best-cooling shade whose circle covers `position` (horizontal), with the player roughly at or
-- above the shade's ground and below its canopy.
function SurvivalShades.GetCoverAt(position: Vector3): Placed?
	local best: Placed? = nil
	for _, entry in placed do
		local dy = position.Y - entry.Position.Y
		if dy >= -COVER_BELOW and dy <= entry.Height + 2 and horizontal(position, entry.Position) <= entry.Radius then
			if best == nil or entry.Cooling > (best :: Placed).Cooling then
				best = entry
			end
		end
	end
	return best
end

function SurvivalShades.Buy(player: Player, shadeId: string): boolean
	local data = DataService.Get(player)
	local def = Config.GetShade(shadeId)
	if not data or not def then
		return false
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(def) -- refine for the type checker (guarded above)
	if data.OwnedShades[shadeId] then
		Net.Notify(player, "Info", "You already own the " .. def.Name .. "! Tap Place to put it down.")
		return false
	end
	local rebirths = def.RebirthsRequired or 0
	if data.Rebirths < rebirths then
		Net.Notify(player, "Error", string.format("Needs %d rebirth%s!", rebirths, if rebirths == 1 then "" else "s"))
		return false
	end
	if data.Coins < def.Price then
		Net.Notify(player, "Error", "Not enough coins! Need " .. Format.Abbreviate(def.Price - data.Coins) .. " more.")
		return false
	end
	DataService.Mutate(player, { "Coins", "OwnedShades" }, function(d)
		d.Coins -= def.Price
		d.OwnedShades[shadeId] = true
	end)
	Analytics.Sink(
		player,
		"Coins",
		def.Price,
		data.Coins,
		Enum.AnalyticsEconomyTransactionType.Shop,
		"Shade:" .. shadeId
	)
	Net.Notify(player, "Success", "You got the " .. def.Name .. "! Place it on the sand for shade.")
	return true
end

function SurvivalShades.Place(player: Player, shadeId: string, position: Vector3, yaw: number): (boolean, string?)
	local data = DataService.Get(player)
	local def = Config.GetShade(shadeId)
	if not data or not def then
		return false, "Unknown shade"
	end
	assert(data) -- refine for the type checker (guarded above)
	assert(def) -- refine for the type checker (guarded above)
	if not data.OwnedShades[shadeId] then
		return false, "You don't own that shade yet!"
	end
	-- Moving your own shade: ignore its current spot for the spacing check.
	local mine = SurvivalShades.GetPlaced(player)
	local moving: Placed? = nil
	for _, entry in mine do
		if entry.ShadeId == shadeId then
			moving = entry
			break
		end
	end
	local movingIndex = if moving then table.find(placed, moving) else nil
	if movingIndex then
		table.remove(placed, movingIndex)
	end
	local ground, reason = resolvePlacement(player, position)
	if movingIndex and moving then
		table.insert(placed, movingIndex, moving)
	end
	if not ground then
		return false, reason
	end
	local at = ground :: Vector3

	if moving then
		destroy(moving)
	end
	-- Slot limit: drop the oldest.
	mine = SurvivalShades.GetPlaced(player)
	table.sort(mine, function(a: Placed, b: Placed)
		return a.PlacedAt < b.PlacedAt
	end)
	local slots = shadeSlots(player)
	while #mine >= slots and #mine > 0 do
		destroy(table.remove(mine, 1) :: Placed)
	end

	local model = Models.Shade(shadeId)
	model.Name = player.Name .. "_" .. shadeId
	model:PivotTo(CFrame.new(at) * CFrame.Angles(0, yaw % (math.pi * 2), 0))
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("OwnerName", player.DisplayName)
	model:SetAttribute("ShadeId", shadeId)
	model:SetAttribute("Radius", def.Radius)
	model:SetAttribute("Cooling", def.Cooling)
	model:SetAttribute("Height", def.Height)
	ownerLabel(model, player, def)
	CollectionService:AddTag(model, SurvivalShades.TAG)
	-- v2.3 streaming: the owner always has their shade (BeachShop "placed" state, GetMyShades);
	-- everyone else streams it in and out as one unit.
	model.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	model:AddPersistentPlayer(player)
	model.Parent = getFolder()

	placeCounter += 1
	table.insert(placed, {
		Model = model,
		Owner = player,
		ShadeId = shadeId,
		Position = at,
		Radius = def.Radius,
		Cooling = def.Cooling,
		Height = def.Height,
		PlacedAt = placeCounter,
	})
	return true, nil
end

function SurvivalShades.PickUp(player: Player, shadeId: string?): number
	local removed = 0
	for _, entry in SurvivalShades.GetPlaced(player) do
		if shadeId == nil or entry.ShadeId == shadeId then
			destroy(entry)
			removed += 1
		end
	end
	return removed
end

function SurvivalShades.RemoveAll(player: Player)
	SurvivalShades.PickUp(player, nil)
end

-- Remotes -------------------------------------------------------------------------------------------

function SurvivalShades.Init()
	getFolder()
	Net.On("BuyShade", function(player: Player, shadeId: any)
		if Net.IsString(shadeId, 64) then
			SurvivalShades.Buy(player, shadeId)
		end
	end, { Rate = 4, Window = 1 })

	Net.On("PlaceShade", function(player: Player, shadeId: any, position: any, yaw: any)
		if not Net.IsString(shadeId, 64) or not Net.IsVector3(position) then
			return
		end
		local angle = if Net.IsNumber(yaw) then yaw else 0
		local ok, reason = SurvivalShades.Place(player, shadeId, position, angle)
		if ok then
			local def = Config.GetShade(shadeId)
			Net.Notify(
				player,
				"Success",
				(if def then def.Name else "Shade") .. " placed! Stand under it to cool down."
			)
		else
			Net.Notify(player, "Error", reason or "Can't place it there!")
		end
	end, { Rate = 3, Window = 1 })

	Net.On("PickUpShade", function(player: Player, shadeId: any)
		local id: string? = if Net.IsString(shadeId, 64) then shadeId else nil
		if SurvivalShades.PickUp(player, id) > 0 then
			Net.Notify(player, "Info", "Shade picked up.")
		end
	end, { Rate = 3, Window = 1 })
end

return SurvivalShades
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!strict
--[[
	World — procedural beach map (owner: Beach). Everything is built in code at server start,
	deterministically (fixed Random seed). See docs/MAP.md for the layout and coordinates.

	API (docs/V2.md "Interfaces between agents"):
	  World.Build()                              -- build once (idempotent)
	  World.GetDigZone(): { CFrame, Size }       -- CFrame at the centre of the flat dig surface
	                                             -- (Y = SURFACE_Y, axis-aligned); Size = X/Z
	                                             -- footprint, Y = total depth
	  World.IsInDigZone(position): boolean       -- inside the footprint, between the bottom of
	                                             -- the world and a little above the surface
	  World.GetSurfacePoint(near): CFrame        -- safe standing pivot on the boardwalk nearest
	                                             -- to `near`, facing the sand (spawn / return)
	Extras:
	  World.GetSpawnCFrame(index?): CFrame       -- one of the boardwalk spawn pivots
	  World.ClampToDigZone(position, margin?)    -- nearest point inside the footprint
	  World.FillLayered(min, max)                -- refill a box with the layer materials (sync)
	  World.ApplyEvent(eventIds)                 -- HighTide / GoldenHour visuals (also driven by
	                                             -- the workspace attribute "ActiveEvents")
	  World.IsReady(): boolean                   -- true once the deep layers finished filling
	                                             -- (workspace attribute "WorldReady" mirrors it)
	Workspace attributes for clients: "DigZoneCFrame" (CFrame), "DigZoneSize" (Vector3).
]]

local Workspace = game:GetService("Workspace")

local Layout = require(script.Layout)
local Util = require(script.Util)
local TerrainBuilder = require(script.Terrain)
local Hub = require(script.Hub)
local Boardwalk = require(script.Boardwalk)
local Decor = require(script.Decor)
local LightingBuilder = require(script.Lighting)
local Underground = require(script.Underground)

export type DigZone = { CFrame: CFrame, Size: Vector3 }

local World = {}

local built = false
local ready = false
local spawnCounter = 0

local ZONE_CFRAME = CFrame.new(Layout.DIG_CENTER)
local ZONE_SIZE = Layout.DIG_SIZE
local ABOVE_SURFACE = 16 -- IsInDigZone accepts points up to this far above the surface
local STAND_HEIGHT = 3.5 -- HumanoidRootPart height above the floor it stands on

local function step(name: string, fn: () -> ())
	local err = Util.Try(fn)
	if err ~= nil then
		warn("[World] build step failed:", name, err)
	end
end

function World.Build()
	if built then
		return
	end
	built = true
	local started = os.clock()
	local rng = Random.new(Layout.SEED)
	Workspace:SetAttribute("WorldReady", false)
	Workspace:SetAttribute("DigZoneCFrame", ZONE_CFRAME)
	Workspace:SetAttribute("DigZoneSize", ZONE_SIZE)

	local map = Util.Folder("Map", Workspace)
	local hubFolder = Util.Folder("Hub", map)
	local boardwalkFolder = Util.Folder("Boardwalk", map)
	local decorFolder = Util.Folder("Decor", map)
	local fxFolder = Util.Folder("Effects", map)

	-- Terrain first so nothing spawns over the void: surface slab, then the layered strip tops.
	step("terrain colours", TerrainBuilder.ApplyColors)
	step("surface", function()
		TerrainBuilder.BuildSurface(rng)
	end)
	step("strip tops", TerrainBuilder.BuildStripTops)
	-- Core floor under the whole dig zone: nothing can fall out of the bottom of a hole.
	Util.Part({
		Name = "CoreFloor",
		Size = Vector3.new(Layout.STRIP_HALF_X * 2, 4, Layout.STRIP_Z_INLAND - Layout.STRIP_Z_SEA),
		CFrame = CFrame.new(0, Layout.BOTTOM_Y - 2, (Layout.STRIP_Z_INLAND + Layout.STRIP_Z_SEA) / 2),
		Color = Color3.fromRGB(200, 150, 45),
		Material = Enum.Material.SmoothPlastic,
		CastShadow = false,
		Parent = map,
	})

	step("hub", function()
		Hub.Build(hubFolder)
	end)
	step("boardwalk", function()
		Boardwalk.Build(boardwalkFolder)
	end)
	step("decor", function()
		Decor.Build(decorFolder, rng)
	end)
	step("lighting", function()
		LightingBuilder.Build(fxFolder)
	end)

	-- Deep layers fill in the background (~100 frames) so Build returns quickly.
	task.spawn(function()
		local err = Util.Try(TerrainBuilder.BuildStripsDeep)
		if err ~= nil then
			warn("[World] deep terrain fill failed:", err)
		end
		step("underground alcoves", function()
			Underground.Build(Util.Folder("Underground", map))
		end)
		ready = true
		Workspace:SetAttribute("WorldReady", true)
		print(string.format("[World] map ready in %.2fs", os.clock() - started))
	end)
end

function World.GetDigZone(): DigZone
	return { CFrame = ZONE_CFRAME, Size = ZONE_SIZE }
end

function World.IsInDigZone(position: Vector3): boolean
	local rel = position - Layout.DIG_CENTER
	return math.abs(rel.X) <= ZONE_SIZE.X / 2
		and math.abs(rel.Z) <= ZONE_SIZE.Z / 2
		and rel.Y <= ABOVE_SURFACE
		and rel.Y >= -ZONE_SIZE.Y
end

-- Nearest point inside the footprint (shrunk by `margin` studs), same Y.
function World.ClampToDigZone(position: Vector3, margin: number?): Vector3
	local m = margin or 0
	local c = Layout.DIG_CENTER
	local hx = math.max(0, ZONE_SIZE.X / 2 - m)
	local hz = math.max(0, ZONE_SIZE.Z / 2 - m)
	return Vector3.new(
		math.clamp(position.X, c.X - hx, c.X + hx),
		position.Y,
		math.clamp(position.Z, c.Z - hz, c.Z + hz)
	)
end

-- A pivot standing on the boardwalk deck (never dug, never refilled) as close to `near` as
-- possible, looking out over the sand.
function World.GetSurfacePoint(near: Vector3): CFrame
	local limit = Layout.BOUND_HALF_X - 10
	local x = math.clamp(near.X, -limit, limit)
	local z = (Layout.BOARDWALK_Z0 + Layout.BOARDWALK_Z1) / 2
	local pos = Vector3.new(x, Layout.DECK_TOP + STAND_HEIGHT, z)
	return CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1))
end

-- Boardwalk spawn pivots (round-robin when no index is given).
function World.GetSpawnCFrame(index: number?): CFrame
	local i = index
	if i == nil then
		spawnCounter += 1
		i = spawnCounter
	end
	local spawns = Layout.SPAWNS
	local p = spawns[((i :: number) - 1) % #spawns + 1]
	local pos = p + Vector3.new(0, 1 + STAND_HEIGHT, 0) -- SpawnLocation pad is 1 stud thick
	return CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1))
end

function World.FillLayered(minV: Vector3, maxV: Vector3)
	TerrainBuilder.FillLayered(minV, maxV)
end

function World.ApplyEvent(eventIds: { string })
	LightingBuilder.ApplyEvent(eventIds)
end

function World.IsReady(): boolean
	return ready
end

return World
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">Boardwalk</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Boardwalk — the wooden promenade between the dig zone and the hub (players spawn on it), the
	"dig anywhere" signs and zone-end flags, the big title sign with a giant shovel in the dunes,
	the photo-spot pier running from the wet sand out to sea, and the invisible boundary walls.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(script.Parent.Layout)
local Util = require(script.Parent.Util)

local C = Config.Theme.Colors
local rgb = Color3.fromRGB
local S = Layout.SURFACE_Y

local WOOD_A = rgb(184, 132, 86)
local WOOD_B = rgb(168, 118, 74)
local WOOD_DARK = rgb(120, 82, 52)
local WHITE = Color3.new(1, 1, 1)

local Boardwalk = {}

local HUB_GAP = 96 -- no inland railing within this |x| (the way up to the hub)

local function lamp(parent: Instance, ground: Vector3)
	Util.Part({
		Name = "LampPost",
		Size = Vector3.new(0.8, 10, 0.8),
		CFrame = CFrame.new(ground + Vector3.new(0, 5, 0)),
		Color = rgb(60, 70, 90),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	Util.Ball(
		parent,
		"LampGlobe",
		ground + Vector3.new(0, 10.6, 0),
		1.8,
		rgb(230, 170, 100),
		Enum.Material.SmoothPlastic
	)
end

local function buildPromenade(parent: Instance)
	local S = Layout.DECK_TOP - 1 -- deck base: everything below is built relative to it
	local m = Util.Model("Promenade", parent)
	local z0, z1 = Layout.BOARDWALK_Z0, Layout.BOARDWALK_Z1
	local zc, depth = (z0 + z1) / 2, z1 - z0
	local half = Layout.BOUND_HALF_X - 4
	local seg = 16
	local x = -half
	local i = 0
	while x < half do
		local x1 = math.min(x + seg, half)
		i += 1
		Util.Part({
			Name = "Deck",
			Size = Vector3.new(x1 - x, 1, depth),
			CFrame = CFrame.new((x + x1) / 2, S + 0.5, zc),
			Color = if i % 2 == 0 then WOOD_A else WOOD_B,
			Material = Enum.Material.WoodPlanks,
			Parent = m,
		})
		-- Railing post on the inland edge (open in front of the hub)
		if math.abs(x) >= HUB_GAP then
			Util.Part({
				Name = "RailPost",
				Size = Vector3.new(0.7, 3.4, 0.7),
				CFrame = CFrame.new(x, S + 2.7, z1 - 0.4),
				Color = WHITE,
				Parent = m,
			})
		end
		x = x1
	end
	for _, sx in { -1, 1 } do
		local len = half - HUB_GAP
		Util.Part({
			Name = "Rail",
			Size = Vector3.new(len, 0.5, 0.6),
			CFrame = CFrame.new(sx * (HUB_GAP + len / 2), S + 4.2, z1 - 0.4),
			Color = WHITE,
			Parent = m,
		})
	end
	Util.Part({
		Name = "Trim",
		Size = Vector3.new(half * 2, 1.2, 0.8),
		CFrame = CFrame.new(0, S + 0.4, z0 - 0.4),
		Color = C.Ocean,
		Decor = true,
		Parent = m,
	})
	-- Lamps every 32 studs along the sand-side edge, skipping the spawns
	local lx = -half + 8
	while lx < half do
		if math.abs(lx) > 24 then
			lamp(m, Vector3.new(lx, S + 1, z0 + 1.2))
		end
		lx += 32
	end
end

local function buildTitle(parent: Instance)
	local m = Util.Model("TitleSign", parent)
	local p = Layout.TITLE_SIGN
	local base = Util.Facing(p, Vector3.new(p.X, p.Y, 0))
	for _, x in { -20, 20 } do
		Util.Part({
			Name = "Post",
			Size = Vector3.new(1.6, 26, 1.6),
			CFrame = base * CFrame.new(x, 13, 0.8),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
			Parent = m,
		})
	end
	local board = Util.Sign(m, "DIG TO THE CORE!", Vector3.new(46, 11, 1.2), base * CFrame.new(0, 21, 0), {
		Name = "TitleBoard",
		BoardColor = C.Ocean,
		SubText = "BEACH SIMULATOR",
	})
	board.CastShadow = true
	Util.Part({
		Name = "TitleFrame",
		Size = Vector3.new(48, 13, 0.8),
		CFrame = base * CFrame.new(0, 21, 0.8),
		Color = C.Gold,
		Parent = m,
	})

	-- Giant shovel stuck in the dunes next to the sign
	local sp = p + Vector3.new(34, 0, 2)
	local tilt = CFrame.new(sp) * CFrame.Angles(0, math.rad(-20), math.rad(-14))
	Util.Part({
		Name = "GiantShovelHandle",
		Size = Vector3.new(1.4, 22, 1.4),
		CFrame = tilt * CFrame.new(0, 14, 0),
		Color = rgb(170, 110, 60),
		Material = Enum.Material.Wood,
		Parent = m,
	})
	Util.Part({
		Name = "GiantShovelGrip",
		Size = Vector3.new(5, 1.4, 1.4),
		CFrame = tilt * CFrame.new(0, 25.5, 0),
		Color = C.Coral,
		Parent = m,
	})
	Util.Part({
		Name = "GiantShovelBlade",
		Size = Vector3.new(7, 8, 1),
		CFrame = tilt * CFrame.new(0, 1.5, 0),
		Color = rgb(200, 210, 225),
		Material = Enum.Material.Metal,
		Reflectance = 0.2,
		Parent = m,
	})
end

local function buildPier(parent: Instance)
	local S = Layout.DECK_TOP - 1 -- deck base (same height as the promenade)
	local m = Util.Model("Pier", parent)
	local hw = Layout.PIER_HALF_W
	local z0, z1 = Layout.PIER_Z0, Layout.PIER_Z1
	local deckY = S + 0.5 -- top at S + 1 = DECK_TOP
	-- Deck segments
	local z = z0
	local i = 0
	while z > z1 do
		local zn = math.max(z - 8, z1)
		i += 1
		Util.Part({
			Name = "Deck",
			Size = Vector3.new(hw * 2, 1, z - zn),
			CFrame = CFrame.new(0, deckY, (z + zn) / 2),
			Color = if i % 2 == 0 then WOOD_A else WOOD_B,
			Material = Enum.Material.WoodPlanks,
			Parent = m,
		})
		z = zn
	end
	-- Pilings every 16 studs and rails
	local postBottom = Layout.SEABED_Y - 4
	z = z0 - 8
	while z > z1 do
		for _, sx in { -1, 1 } do
			local h = S - postBottom
			Util.Cylinder(
				m,
				"Piling",
				Vector3.new(sx * (hw - 0.6), postBottom + h / 2, z),
				h,
				1.6,
				WOOD_DARK,
				Enum.Material.Wood
			)
		end
		z -= 16
	end
	z = z0 - 4
	while z >= z1 do
		for _, sx in { -1, 1 } do
			Util.Part({
				Name = "RailPost",
				Size = Vector3.new(0.6, 3, 0.6),
				CFrame = CFrame.new(sx * (hw - 0.3), S + 2.5, z),
				Color = WHITE,
				Parent = m,
			})
		end
		z -= 8
	end
	local railLen = (z0 - 4) - z1
	for _, sx in { -1, 1 } do
		Util.Part({
			Name = "Rail",
			Size = Vector3.new(0.5, 0.5, railLen),
			CFrame = CFrame.new(sx * (hw - 0.3), S + 4, (z0 - 4 + z1) / 2),
			Color = WHITE,
			Parent = m,
		})
	end

	-- End platform (photo spot)
	local eh, ed = Layout.PIER_END_HALF, Layout.PIER_END_DEPTH
	local ec = Vector3.new(0, S, z1 - ed / 2)
	Util.Part({
		Name = "Platform",
		Size = Vector3.new(eh * 2, 1, ed),
		CFrame = CFrame.new(ec.X, deckY, ec.Z),
		Color = WOOD_A,
		Material = Enum.Material.WoodPlanks,
		Parent = m,
	})
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local p = Vector3.new(sx * (eh - 0.6), 0, ec.Z + sz * (ed / 2 - 0.6))
			local h = S - postBottom
			Util.Cylinder(m, "Piling", Vector3.new(p.X, postBottom + h / 2, p.Z), h, 2, WOOD_DARK, Enum.Material.Wood)
			Util.Part({
				Name = "CornerPost",
				Size = Vector3.new(0.9, 3.4, 0.9),
				CFrame = CFrame.new(p.X, S + 2.7, p.Z),
				Color = WHITE,
				Parent = m,
			})
		end
	end
	-- Rails on the three open sides
	Util.Part({
		Name = "Rail",
		Size = Vector3.new(eh * 2, 0.5, 0.5),
		CFrame = CFrame.new(0, S + 4, ec.Z - ed / 2 + 0.6),
		Color = WHITE,
		Parent = m,
	})
	for _, sx in { -1, 1 } do
		Util.Part({
			Name = "Rail",
			Size = Vector3.new(0.5, 0.5, ed),
			CFrame = CFrame.new(sx * (eh - 0.6), S + 4, ec.Z),
			Color = WHITE,
			Parent = m,
		})
	end

	-- Gazebo
	local gz = ec + Vector3.new(0, 1, -2)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Util.Part({
				Name = "GazeboPost",
				Size = Vector3.new(0.9, 10, 0.9),
				CFrame = CFrame.new(gz + Vector3.new(sx * 6, 5, sz * 6)),
				Color = WHITE,
				Parent = m,
			})
		end
	end
	Util.Part({
		Name = "GazeboRoof",
		Size = Vector3.new(15, 1, 15),
		CFrame = CFrame.new(gz + Vector3.new(0, 10.5, 0)),
		Color = C.Coral,
		Parent = m,
	})
	Util.Part({
		Name = "GazeboRoofTop",
		Size = Vector3.new(9, 1.2, 9),
		CFrame = CFrame.new(gz + Vector3.new(0, 11.6, 0)),
		Color = WHITE,
		Parent = m,
	})
	Util.Ball(m, "GazeboFinial", gz + Vector3.new(0, 12.8, 0), 1.6, C.Gold, Enum.Material.SmoothPlastic)
	Util.Sign(
		m,
		"SUNSET PIER",
		Vector3.new(11, 2.2, 0.5),
		CFrame.lookAt(gz + Vector3.new(0, 8.6, 6.4), gz + Vector3.new(0, 8.6, 20)),
		{
			Name = "PierSign",
			BoardColor = C.Sunset,
		}
	)
	-- Benches facing the sea
	for _, sx in { -1, 1 } do
		local b = gz + Vector3.new(sx * 3.2, 0, -3)
		Util.Part({
			Name = "BenchSeat",
			Size = Vector3.new(4.5, 0.5, 1.6),
			CFrame = CFrame.new(b + Vector3.new(0, 1.6, 0)),
			Color = C.Ocean,
			Parent = m,
		})
		Util.Part({
			Name = "BenchBack",
			Size = Vector3.new(4.5, 1.6, 0.4),
			CFrame = CFrame.new(b + Vector3.new(0, 2.6, 0.8)),
			Color = C.Ocean,
			Parent = m,
		})
		Util.Part({
			Name = "BenchLegs",
			Size = Vector3.new(4, 1.4, 1.2),
			CFrame = CFrame.new(b + Vector3.new(0, 0.7, 0)),
			Color = WHITE,
			Parent = m,
		})
	end
	-- Telescope at the tip
	local tp = Vector3.new(eh - 3, S + 1, ec.Z - ed / 2 + 3)
	Util.Part({
		Name = "TelescopeStand",
		Size = Vector3.new(0.5, 3.4, 0.5),
		CFrame = CFrame.new(tp + Vector3.new(0, 1.7, 0)),
		Color = rgb(60, 70, 90),
		Material = Enum.Material.Metal,
		Parent = m,
	})
	Util.Part({
		Name = "Telescope",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.6, 0.9, 0.9),
		CFrame = CFrame.new(tp + Vector3.new(0, 3.7, 0)) * CFrame.Angles(0, math.rad(90), math.rad(15)),
		Color = C.Gold,
		Material = Enum.Material.Metal,
		Decor = true,
		Parent = m,
	})
	-- Pier lamps
	for _, sx in { -1, 1 } do
		lamp(m, Vector3.new(sx * (eh - 1.5), S + 1, ec.Z + ed / 2 - 2))
		lamp(m, Vector3.new(sx * (hw - 0.8), S + 1, (z0 + z1) / 2))
	end
end

local function buildBoundaries(parent: Instance)
	local f = Util.Folder("Boundaries", parent)
	local hx, zn, zs = Layout.BOUND_HALF_X, Layout.BOUND_NORTH_Z, Layout.BOUND_SOUTH_Z
	local y0, y1 = Layout.SEABED_Y - 10, S + 90
	local h, yc = y1 - y0, (y0 + y1) / 2
	local walls: { { Vector3 } } = {
		{ Vector3.new(4, h, zn - zs), Vector3.new(-hx - 2, yc, (zn + zs) / 2) },
		{ Vector3.new(4, h, zn - zs), Vector3.new(hx + 2, yc, (zn + zs) / 2) },
		{ Vector3.new(hx * 2 + 8, h, 4), Vector3.new(0, yc, zn + 2) },
		{ Vector3.new(hx * 2 + 8, h, 4), Vector3.new(0, yc, zs - 2) },
	}
	for _, w in walls do
		local p = Util.Part({
			Name = "Boundary",
			Size = w[1],
			CFrame = CFrame.new(w[2]),
			Transparency = 1,
			CastShadow = false,
			Parent = f,
		})
		p.CanQuery = false
	end
end

-- "Dig anywhere" signs on the deck and flags marking both ends of the dig zone.
local function buildDigMarkers(parent: Instance)
	local m = Util.Model("DigMarkers", parent)
	local z = Layout.BOARDWALK_Z0 + 2
	for _, x in { -40, 40, -200, 200 } do
		local p = Vector3.new(x, Layout.DECK_TOP, z)
		Util.Part({
			Name = "SignPost",
			Size = Vector3.new(0.8, 5, 0.8),
			CFrame = CFrame.new(p + Vector3.new(0, 2.5, 0.6)),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
			Parent = m,
		})
		-- Faces inland so it reads while walking down from the hub.
		Util.Sign(
			m,
			"DIG ANYWHERE!",
			Vector3.new(9, 2.6, 0.4),
			CFrame.lookAt(p + Vector3.new(0, 5.4, 0.6), p + Vector3.new(0, 5.4, 10)),
			{
				Name = "DigSign",
				BoardColor = C.Gold,
				SubText = "ON THE SAND",
			}
		)
	end
	-- Striped flags at the four corners of the dig zone
	for _, sx in { -1, 1 } do
		for _, zEdge in { Layout.DIG_Z_INLAND, Layout.DIG_Z_SEA } do
			local p = Vector3.new(sx * (Layout.DIG_HALF_X + 2), S, zEdge)
			Util.Part({
				Name = "ZoneFlagPole",
				Size = Vector3.new(0.5, 9, 0.5),
				CFrame = CFrame.new(p + Vector3.new(0, 4.5, 0)),
				Color = WHITE,
				Parent = m,
			})
			Util.Wedge({
				Name = "ZoneFlag",
				Size = Vector3.new(0.2, 2.2, 3.4),
				CFrame = CFrame.new(p + Vector3.new(0, 7.6, -sx * 1.7)),
				Color = C.Coral,
				Decor = true,
				Parent = m,
			})
		end
	end
end

function Boardwalk.Build(parent: Instance)
	buildPromenade(parent)
	buildDigMarkers(parent)
	buildTitle(parent)
	buildPier(parent)
	buildBoundaries(parent)
end

return Boardwalk
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">Decor</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Decor — Models.Prop scenery: palms, umbrellas + towels, lifeguard towers, sandcastles, crabs,
	surfboards, beach balls, rocks, shells, boardwalk stalls and chests. Deterministic (seeded
	Random passed in by World). Small props are non-colliding & shadowless (Util.Prop).

	Nothing is placed inside the dig zone (props would float over holes): beach props stand on
	the wet sand between the dig zone and the shoreline, the rest around the hub and dunes.
]]

local Layout = require(script.Parent.Layout)
local Util = require(script.Parent.Util)
local Vistas = require(script.Parent.Vistas)

local S = Layout.SURFACE_Y

local Decor = {}

-- Random point on the wet sand strip seaward of the dig zone, avoiding the pier corridor.
local function beachPoint(rng: Random, zMin: number, zMax: number): Vector3
	local x
	repeat
		x = rng:NextNumber(-Layout.BOUND_HALF_X + 6, Layout.BOUND_HALF_X - 6)
	until math.abs(x) > Layout.PIER_HALF_W + 6
	local z = rng:NextNumber(zMin, zMax)
	return Vector3.new(x, Layout.GroundY(z), z)
end

function Decor.Build(parent: Instance, rng: Random)
	Vistas.Build(parent)
	local prop = function(name: string, pos: Vector3, yaw: number, scale: number?)
		Util.Prop(name, parent, pos, yaw, scale)
	end
	local wetZ0, wetZ1 = Layout.BEACH_FLAT_END_Z + 2, Layout.DIG_Z_SEA - 4 -- -78 .. -68
	local hub = Layout.HUB_CENTER
	local B = Layout.BOUND_HALF_X

	-- Palms: a row behind the hub (dunes edge), along the boardwalk's inland edge away from the
	-- hub, framing the title sign and at the beach ends.
	local px = -B + 10
	while px < B do
		if math.abs(px) > 30 then
			prop(
				"PalmTree",
				Vector3.new(px + rng:NextNumber(-4, 4), S, 108 + rng:NextNumber(-3, 5)),
				rng:NextNumber(0, 360)
			)
		end
		if math.abs(px) > 110 then
			prop(
				"PalmTree",
				Vector3.new(px + rng:NextNumber(-5, 5), S, Layout.BOARDWALK_Z1 + 8 + rng:NextNumber(0, 6)),
				rng:NextNumber(0, 360)
			)
		end
		px += 34
	end
	for _, p in
		{
			Vector3.new(-28, S, 112),
			Vector3.new(28, S, 112),
			Vector3.new(-B + 8, S, -74),
			Vector3.new(B - 8, S, -76),
			Vector3.new(-16, S, -72),
			Vector3.new(16, S, -72),
			Vector3.new(-32, S, 62),
			Vector3.new(32, S, 60),
		}
	do
		prop("PalmTree", p, rng:NextNumber(0, 360))
	end
	-- Scenic palms outside the boundary (dunes / far beach)
	for _ = 1, 16 do
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		local x = side * rng:NextNumber(B + 10, Layout.TERRAIN_HALF_X - 30)
		prop("PalmTree", Vector3.new(x, S, rng:NextNumber(10, 100)), rng:NextNumber(0, 360), rng:NextNumber(0.9, 1.3))
	end

	-- Umbrella + towel pairs on the wet sand, facing the sea
	local ux = -B + 30
	local i = 0
	while ux < B - 20 do
		if math.abs(ux) > 30 then
			i += 1
			local u = Vector3.new(ux + rng:NextNumber(-6, 6), S, if i % 2 == 0 then -71 else -75)
			prop("Umbrella", u, rng:NextNumber(0, 360))
			prop("BeachTowel", u + Vector3.new(3.5, 0, -2), rng:NextNumber(-15, 15))
		end
		ux += 46
	end

	-- Lifeguard towers looking out to sea, surfboards leaning nearby
	for _, x in { -260, -110, 120, 270 } do
		local p = Vector3.new(x, S, -76)
		prop("Lifeguard Tower", p, 0) -- -Z = looking out to sea
		prop("Surfboard", p + Vector3.new(7, 0, 2), rng:NextNumber(0, 360))
		prop("Surfboard", p + Vector3.new(9, 0, 3), rng:NextNumber(0, 360))
	end

	-- Sandcastles on the wet sand
	for _, x in { -330, -190, -48, 52, 180, 320 } do
		local p = Vector3.new(x, S, -70)
		prop("Sandcastle", p, Util.YawTowards(p, hub))
	end

	-- Crabs, beach balls and shells scattered over the wet sand / shallows
	for _ = 1, 16 do
		prop("Crab", beachPoint(rng, wetZ0 - 8, wetZ1), rng:NextNumber(0, 360))
	end
	for _ = 1, 8 do
		prop("BeachBall", beachPoint(rng, wetZ0, wetZ1), rng:NextNumber(0, 360))
	end
	for _ = 1, 28 do
		prop("Shell", beachPoint(rng, wetZ0 - 10, wetZ1), rng:NextNumber(0, 360))
	end

	-- Rocks along the shoreline (half in the water) and at the boundary corners
	for _ = 1, 22 do
		local p = beachPoint(rng, -98, -88)
		prop("Rock", p + Vector3.new(0, -1.5, 0), rng:NextNumber(0, 360), rng:NextNumber(0.8, 1.6))
	end
	for _, p in
		{
			Vector3.new(-B + 4, S, 120),
			Vector3.new(B - 4, S, 120),
			Vector3.new(-B + 4, S, -78),
			Vector3.new(B - 4, S, -78),
		}
	do
		prop("Rock", p, rng:NextNumber(0, 360), 1.8)
	end

	-- Boardwalk stalls (on the deck, away from the hub, facing the sand)
	local deckZ = (Layout.BOARDWALK_Z0 + Layout.BOARDWALK_Z1) / 2 + 3
	for _, x in { -130, -250, -350, 130, 250, 350 } do
		Util.Prop("Boardwalk Stall", parent, Vector3.new(x, Layout.DECK_TOP, deckZ), 0, nil, true)
	end

	-- Chests: next to the rebirth shrine and on the pier end platform
	prop("Chest", Layout.REBIRTH + Vector3.new(9, 0, -4), Util.YawTowards(Layout.REBIRTH, hub))
	Util.Prop(
		"Chest",
		parent,
		Vector3.new(-9, Layout.DECK_TOP, Layout.PIER_Z1 - Layout.PIER_END_DEPTH + 4),
		0,
		nil,
		true
	)
end

return Decor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">Hub</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Hub — the plaza inland of the boardwalk: spawns (on the boardwalk deck), Sell stand,
	Shovel & Backpack huts, Egg incubator, Rebirth shrine, two leaderboards, the free Water
	Fountain, the Construction Crate yard (v2.1, where the Garage stood) and the Beach Shop stall.
	Hero structures are built from Parts in a local frame whose -Z (front) faces the boardwalk spawns.

	Tags placed: SpawnLocation, SellZone, ShovelShop, BackpackShop, EggShop (one per egg, with
	attribute EggId on the part and on its ProximityPrompt), CrateShop (one per Construction Crate,
	same EggId attribute; EggPanel hooks its "Open" prompt), RebirthStatue, LeaderboardCoins,
	LeaderboardDepth, WaterFountain (prompt "Drink"), BeachShop (prompt "Shop"). Survival /
	Companions clients handle those prompts.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Models = require(ReplicatedStorage.Shared.Models)
local Build = require(ReplicatedStorage.Shared.Models.Build)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Types = require(ReplicatedStorage.Shared.Types)
local Layout = require(script.Parent.Layout)
local Util = require(script.Parent.Util)

local Theme = Config.Theme
local C = Theme.Colors
local rgb = Color3.fromRGB
local S = Layout.SURFACE_Y

local WOOD = rgb(176, 122, 76)
local WOOD_DARK = rgb(124, 84, 52)
local THATCH = rgb(226, 182, 96)
local THATCH_DARK = rgb(196, 148, 70)
local WHITE = Color3.new(1, 1, 1)
local MARBLE = rgb(246, 242, 255)

local Hub = {}

-- Part in a local frame (front = -Z).
local function lp(
	parent: Instance,
	base: CFrame,
	name: string,
	size: Vector3,
	offset: Vector3,
	color: Color3,
	material: Enum.Material?,
	decor: boolean?
): Part
	return Util.Part({
		Name = name,
		Size = size,
		CFrame = base * CFrame.new(offset),
		Color = color,
		Material = material,
		Decor = decor,
		Parent = parent,
	})
end

-- A Layout position (Y = voxel-grid height) moved up onto the visible sand. v2.2 playtest: the
-- rebirth shrine's steps (and every station built at grid height) were partly under the sand.
local function onSand(pos: Vector3): Vector3
	return Vector3.new(pos.X, Util.TerrainY(pos), pos.Z)
end

local function hubFacing(pos: Vector3): CFrame
	return Util.Facing(onSand(pos), Layout.HUB_LOOK_TARGET)
end

-- Spawns --------------------------------------------------------------------------------------

local function buildSpawns(parent: Instance)
	local colors = { C.Coral, C.Ocean, C.Gold }
	for i, pos in Layout.SPAWNS do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "Spawn" .. i
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = 0
		spawn.Size = Vector3.new(8, 1, 8)
		-- On the boardwalk deck, facing the sand / ocean (-Z)
		spawn.CFrame = CFrame.lookAt(pos + Vector3.new(0, 0.5, 0), pos + Vector3.new(0, 0.5, -10))
		spawn.Color = colors[(i - 1) % #colors + 1]
		spawn.Material = Enum.Material.SmoothPlastic
		spawn.TopSurface = Enum.SurfaceType.Smooth
		spawn.BottomSurface = Enum.SurfaceType.Smooth
		spawn.Parent = parent
		Util.Tag(spawn, "SpawnLocation")
		-- White rim
		Util.Part({
			Name = "SpawnRim",
			Size = Vector3.new(9, 0.6, 9),
			CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0)),
			Color = WHITE,
			Decor = true,
			Parent = parent,
		})
	end
end

-- Sell stand ----------------------------------------------------------------------------------

local function buildSell(parent: Instance)
	local m = Util.Model("SellStand", parent)
	-- Faces the beach so players walking up from the sand see it first.
	local base = Util.Facing(onSand(Layout.SELL), Layout.SELL + Vector3.new(0, 0, -10))

	lp(m, base, "Counter", Vector3.new(16, 3.6, 4), Vector3.new(0, 1.8, 0), C.Coral)
	lp(m, base, "CounterTop", Vector3.new(17, 0.5, 5), Vector3.new(0, 3.85, 0), WOOD, Enum.Material.WoodPlanks)
	for i = -2, 2 do
		lp(m, base, "CounterStripe", Vector3.new(1.2, 3.6, 0.2), Vector3.new(i * 3.2, 1.8, -2.05), WHITE, nil, true)
	end
	lp(m, base, "BackWall", Vector3.new(18, 10, 1), Vector3.new(0, 5, 4), C.PanelAlt)
	for _, x in { -8.5, 8.5 } do
		for _, z in { -2.2, 4 } do
			lp(m, base, "Post", Vector3.new(1, 12, 1), Vector3.new(x, 6, z), WHITE)
		end
	end
	-- Striped awning
	for i = 0, 5 do
		local color = if i % 2 == 0 then C.Coral else WHITE
		local awning = lp(m, base, "Awning", Vector3.new(3.2, 0.6, 9.5), Vector3.new(-8 + i * 3.2, 12.3, 0.9), color)
		awning.CFrame = base * CFrame.new(-8 + i * 3.2, 12.3, 0.9) * CFrame.Angles(math.rad(-10), 0, 0)
	end
	-- Sand pile + bucket on the counter
	Util.Ball(m, "SandPile", (base * CFrame.new(-4, 4.4, 1.2)).Position, 3, rgb(255, 224, 150), Enum.Material.Sand)
	Util.Cylinder(m, "Bucket", (base * CFrame.new(4, 5, 0.5)).Position, 2, 2, C.Ocean, nil, true)

	-- Big SELL sign on its own posts
	for _, x in { -7, 7 } do
		lp(m, base, "SignPost", Vector3.new(0.8, 9, 0.8), Vector3.new(x, 14, 3.4), WOOD_DARK, Enum.Material.Wood)
	end
	Util.Sign(m, "SELL", Vector3.new(20, 7, 1), base * CFrame.new(0, 17.5, 2.6), {
		Name = "SellSign",
		BoardColor = C.Gold,
		SubText = "SAND = COINS!",
	})
	for _, x in { -12.5, 12.5 } do
		local coin = Util.Part({
			Name = "Coin",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.8, 5, 5),
			CFrame = base * CFrame.new(x, 17.5, 2.6) * CFrame.Angles(0, math.rad(90), 0),
			Color = C.Gold,
			Reflectance = 0.25,
			Decor = true,
			Parent = m,
		})
		coin.CastShadow = true
	end

	-- Touch pad in front of the counter
	local pad = lp(
		m,
		base,
		"SellZone",
		Vector3.new(16, 1, 8),
		Vector3.new(0, 0.2, -6.5), -- base is on the visible sand now (was 2.2 above the grid)
		rgb(50, 170, 75),
		Enum.Material.SmoothPlastic
	)
	pad.Transparency = 0.3
	pad.CanCollide = false
	pad.CanQuery = false
	pad.CanTouch = true
	pad.CastShadow = false
	Util.Tag(pad, "SellZone")
	local gui = Util.SurfaceGui(pad, Enum.NormalId.Top)
	Util.Label(gui, "SELL HERE!", WHITE, UDim2.fromScale(0.05, 0.1), UDim2.fromScale(0.9, 0.8))
end

-- Shop huts -----------------------------------------------------------------------------------

local function buildHut(
	parent: Instance,
	name: string,
	pos: Vector3,
	title: string,
	accent: Color3,
	tag: string,
	objectText: string
): Model
	local m = Util.Model(name, parent)
	local base = hubFacing(pos)

	lp(m, base, "Floor", Vector3.new(16, 1, 13), Vector3.new(0, 0.5, 0), WOOD, Enum.Material.WoodPlanks)
	for _, x in { -7, 7 } do
		for _, z in { -5.5, 5.5 } do
			lp(m, base, "Post", Vector3.new(1, 10, 1), Vector3.new(x, 6, z), WOOD_DARK, Enum.Material.Wood)
		end
	end
	lp(m, base, "BackWall", Vector3.new(14, 8, 0.8), Vector3.new(0, 5, 5.6), accent:Lerp(WHITE, 0.55))
	for _, x in { -7.3, 7.3 } do
		lp(m, base, "SideWall", Vector3.new(0.6, 4, 10), Vector3.new(x, 3, 0.5), accent:Lerp(WHITE, 0.3))
	end
	local counter = lp(m, base, tag, Vector3.new(13, 3.5, 2.4), Vector3.new(0, 2.75, -4.5), accent)
	lp(m, base, "CounterTop", Vector3.new(14, 0.5, 3), Vector3.new(0, 4.75, -4.5), WOOD, Enum.Material.WoodPlanks)
	Util.Tag(counter, tag)
	Util.Prompt(counter, "Shop", objectText, 14)

	-- Tiered thatch roof
	local tiers: { { Size: Vector3, Y: number, Color: Color3 } } = {
		{ Size = Vector3.new(19, 1.4, 16), Y = 11.2, Color = THATCH },
		{ Size = Vector3.new(14, 1.4, 11.5), Y = 12.6, Color = THATCH_DARK },
		{ Size = Vector3.new(8.5, 1.4, 7), Y = 14, Color = THATCH },
		{ Size = Vector3.new(3, 1.6, 2.6), Y = 15.5, Color = accent },
	}
	for _, t in tiers do
		lp(m, base, "Roof", t.Size, Vector3.new(0, t.Y, 0), t.Color, Enum.Material.Fabric)
	end
	Util.Sign(m, title, Vector3.new(13, 3.4, 0.6), base * CFrame.new(0, 8.4, -6.9), {
		Name = "ShopSign",
		BoardColor = accent,
	})
	return m
end

local function buildShops(parent: Instance)
	local shovel = buildHut(parent, "ShovelShop", Layout.SHOVEL_SHOP, "SHOVELS", C.Ocean, "ShovelShop", "Shovels")
	local backpack =
		buildHut(parent, "BackpackShop", Layout.BACKPACK_SHOP, "BACKPACKS", C.Palm, "BackpackShop", "Backpacks")

	-- Shovel display on the counter (Models.Shovel of the 2nd shovel, leaning)
	local display = Config.Shovels[math.min(2, #Config.Shovels)]
	if display then
		local ok, result = pcall(Models.Shovel, display.Id)
		if ok and typeof(result) == "Instance" and result:IsA("Model") then
			local model = result :: Model
			Util.Finish(model, true)
			local base = hubFacing(Layout.SHOVEL_SHOP)
			Util.Ground(model, base * CFrame.new(4, 5, -4.5) * CFrame.Angles(0, 0, math.rad(-20)))
			model.Parent = shovel
		end
	end
	-- Bucket-and-bag display on the backpack counter
	local base = hubFacing(Layout.BACKPACK_SHOP)
	Util.Cylinder(backpack, "DisplayBucket", (base * CFrame.new(-4, 6, -4.5)).Position, 2.4, 2.2, C.Coral, nil, true)
	Util.Part({
		Name = "DisplayBag",
		Size = Vector3.new(2.4, 2.8, 1.6),
		CFrame = base * CFrame.new(4, 6.4, -4.5),
		Color = C.Purple,
		Material = Enum.Material.Fabric,
		Decor = true,
		Parent = backpack,
	})
end

-- Leaderboards --------------------------------------------------------------------------------

local function buildLeaderboard(
	parent: Instance,
	name: string,
	pos: Vector3,
	tag: string,
	title: string,
	accent: Color3
)
	local m = Util.Model(name, parent)
	local base = Util.Facing(onSand(pos), Layout.SPAWNS[1])
	for _, x in { -6, 6 } do
		lp(m, base, "Leg", Vector3.new(1.2, 4, 1.2), Vector3.new(x, 2, 0.6), WOOD_DARK, Enum.Material.Wood)
	end
	local board = lp(m, base, "Board", Vector3.new(14, 18, 1), Vector3.new(0, 13, 0), rgb(35, 30, 60))
	Util.Tag(board, tag)
	-- Frame
	lp(m, base, "FrameTop", Vector3.new(15.6, 1, 1.4), Vector3.new(0, 22.4, 0.3), accent)
	lp(m, base, "FrameBottom", Vector3.new(15.6, 1, 1.4), Vector3.new(0, 3.6, 0.3), accent)
	for _, x in { -7.4, 7.4 } do
		lp(m, base, "FrameSide", Vector3.new(1, 19.8, 1.4), Vector3.new(x, 13, 0.3), accent)
	end
	Util.Sign(m, title, Vector3.new(15.6, 3, 1), base * CFrame.new(0, 24.4, 0.2), {
		Name = "Header",
		BoardColor = accent,
	})
end

-- Egg incubator ------------------------------------------------------------------------------

local function priceText(egg: Types.EggDef): string
	if egg.Currency == "Robux" then
		return "R$ " .. Format.Commas(egg.Price)
	elseif egg.Currency == "Tokens" then
		return Format.Abbreviate(egg.Price) .. " Tokens"
	end
	return Format.Abbreviate(egg.Price) .. " Coins"
end

local function buildEggs(parent: Instance)
	local m = Util.Model("EggIncubator", parent)
	local center = Layout.EGG_ARC_CENTER
	-- The arc bulges towards the plaza; `dir` points from the arc centre to the plaza.
	local toHub = Layout.HUB_CENTER - center
	local dir = Vector3.new(toHub.X, 0, toHub.Z).Unit
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local function arcPoint(a: number, r: number): Vector3
		return center + (right * math.sin(a) + dir * math.cos(a)) * r
	end
	local eggs: { Types.EggDef } = {}
	for _, egg in Config.Eggs do
		if egg.Kind ~= "Crate" then -- crates get their own yard (buildCrateYard)
			table.insert(eggs, egg)
		end
	end
	local n = #eggs
	local arc = Layout.EGG_ARC_DEGREES
	for i, egg in eggs do
		local t = if n > 1 then (i - 1) / (n - 1) else 0.5
		local a = math.rad(-arc / 2 + arc * t)
		-- +2: smooth terrain's visible surface sits ~2 studs above the voxel grid, so pedestals
		-- placed at the grid height looked sunk and their labels ended up in the sand.
		local pos = arcPoint(a, Layout.EGG_ARC_RADIUS) + Vector3.new(0, 2, 0)
		local out = (pos - center) * Vector3.new(1, 0, 1)
		out = out.Unit

		local pedestal = Util.Cylinder(m, "EggPedestal_" .. egg.Id, pos + Vector3.new(0, 0.5, 0), 5, 4.4, MARBLE) -- 2 studs sunk into the sand
		pedestal:SetAttribute("EggId", egg.Id)
		Util.Tag(pedestal, "EggShop")
		local prompt = Util.Prompt(pedestal, "Hatch", egg.Name, 8)
		prompt:SetAttribute("EggId", egg.Id)

		local ring = Util.Cylinder(
			m,
			"Ring",
			pos + Vector3.new(0, 3.1, 0),
			0.4,
			4.8,
			Build.neonSafe(egg.Look.ShellColor),
			Enum.Material.Neon,
			true
		)
		ring.Parent = pedestal

		local ok, result = pcall(Models.Egg, egg.Id)
		if ok and typeof(result) == "Instance" and result:IsA("Model") then
			local eggModel = result :: Model
			Util.Finish(eggModel, true)
			Util.Ground(eggModel, CFrame.lookAt(pos + Vector3.new(0, 3.3, 0), pos + Vector3.new(0, 3.3, 0) + out))
			eggModel.Parent = pedestal
		else
			warn("[World] Models.Egg failed for", egg.Id, result)
		end

		local bb = Instance.new("BillboardGui")
		bb.Name = "EggInfo"
		bb.Size = UDim2.fromScale(6, 2.4)
		-- Anchor to an unrotated attachment above the pedestal, not the pedestal itself: the
		-- pedestal is a cylinder rotated 90° about Z, and its rotation turned the billboard's
		-- "+Y" offset sideways, so the labels sat at pedestal-centre height in the sand, next to
		-- the wrong eggs. Pedestals are ~4.6 studs apart and labels 6 wide, so every other one is
		-- raised by more than a label's height to keep neighbours from overlapping.
		local anchor = Instance.new("Attachment")
		anchor.Name = "EggInfoAnchor"
		anchor.Parent = pedestal
		local labelHeight = if i % 2 == 0 then 10.6 else 8
		anchor.Position = pedestal.CFrame:PointToObjectSpace(pedestal.Position + Vector3.new(0, labelHeight, 0))
		bb.Adornee = anchor
		bb.MaxDistance = 40
		bb.LightInfluence = 0
		bb.Parent = pedestal
		Util.Label(bb, egg.Name, egg.Look.ShellColor:Lerp(WHITE, 0.25), UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.45))
		local price = Util.Label(
			bb,
			priceText(egg),
			C.Gold,
			UDim2.fromScale(0.1, 0.45),
			UDim2.fromScale(0.8, 0.3),
			Theme.Fonts.Number
		)
		price.Name = "Price"
		local layer = Config.Layers[egg.UnlockLayer]
		if layer and layer.DepthStart > 0 then
			local unlock = Util.Label(
				bb,
				"Unlocks at " .. Format.Depth(layer.DepthStart),
				WHITE,
				UDim2.fromScale(0.15, 0.76),
				UDim2.fromScale(0.7, 0.22),
				Theme.Fonts.Body
			)
			unlock.Name = "Unlock"
		end
	end

	-- Backdrop: "EGGS" sign behind the arc, facing the plaza
	local signPos = center + dir * 9
	local base = Util.Facing(signPos, signPos + dir)
	for _, x in { -7, 7 } do
		lp(m, base, "SignPost", Vector3.new(0.9, 13, 0.9), Vector3.new(x, 6.5, 0.6), WOOD_DARK, Enum.Material.Wood)
	end
	Util.Sign(m, "PET EGGS", Vector3.new(17, 4.6, 0.8), base * CFrame.new(0, 11, 0), {
		Name = "EggSign",
		BoardColor = C.Purple,
		SubText = "Hatch pets for more sand!",
	})
	-- Incubator heat lamps (neon domes on posts) at the arc ends
	for _, sx in { -1, 1 } do
		local p = arcPoint(math.rad(sx * (arc / 2 + 14)), Layout.EGG_ARC_RADIUS + 1)
		Util.Part({
			Name = "LampPost",
			Size = Vector3.new(0.8, 7, 0.8),
			CFrame = CFrame.new(p + Vector3.new(0, 3.5, 0)),
			Color = WHITE,
			Parent = m,
		})
		Util.Ball(m, "Lamp", p + Vector3.new(0, 7.4, 0), 2.2, rgb(210, 145, 40), Enum.Material.Neon)
	end
end

-- Rebirth shrine ------------------------------------------------------------------------------

local function buildRebirth(parent: Instance)
	local m = Util.Model("RebirthShrine", parent)
	local base = hubFacing(Layout.REBIRTH)
	lp(m, base, "Step1", Vector3.new(14, 1, 14), Vector3.new(0, 0.5, 0), MARBLE, Enum.Material.Marble)
	lp(
		m,
		base,
		"Step2",
		Vector3.new(11, 1, 11),
		Vector3.new(0, 1.5, 0),
		C.Purple:Lerp(WHITE, 0.55),
		Enum.Material.Marble
	)
	lp(m, base, "Step3", Vector3.new(8, 1, 8), Vector3.new(0, 2.5, 0), MARBLE, Enum.Material.Marble)
	local pedestal = lp(m, base, "Pedestal", Vector3.new(4, 5, 4), Vector3.new(0, 5.5, 0), MARBLE, Enum.Material.Marble)
	Util.Tag(pedestal, "RebirthStatue")
	Util.Prompt(pedestal, "Rebirth", "Rebirth Shrine", 14)
	local light = Instance.new("PointLight")
	light.Color = C.Purple
	light.Range = 18
	light.Brightness = 0.9
	light.Parent = pedestal

	Util.Cylinder(
		m,
		"GlowDisc",
		(base * CFrame.new(0, 3.05, 0)).Position,
		0.2,
		9,
		rgb(130, 75, 200),
		Enum.Material.Neon,
		true
	)

	-- Golden digger statue holding a shovel up high
	local gold = C.Gold
	local function g(name: string, size: Vector3, offset: Vector3)
		local p = lp(m, base, name, size, offset, gold, nil, true)
		p.Reflectance = 0.25
		p.CastShadow = true
	end
	g("Legs", Vector3.new(2.4, 2.4, 1.4), Vector3.new(0, 9.2, 0))
	g("Torso", Vector3.new(3, 3, 1.6), Vector3.new(0, 11.9, 0))
	g("ArmL", Vector3.new(0.9, 2.8, 0.9), Vector3.new(-1.95, 11.8, 0))
	g("ArmR", Vector3.new(0.9, 3.4, 0.9), Vector3.new(1.95, 14.6, 0))
	g("Handle", Vector3.new(0.4, 6, 0.4), Vector3.new(1.95, 18.5, 0))
	g("Blade", Vector3.new(1.8, 2.4, 0.4), Vector3.new(1.95, 22.4, 0))
	local head = Util.Ball(m, "Head", (base * CFrame.new(0, 14.7, 0)).Position, 2.6, gold)
	head.Reflectance = 0.25
	-- Floating orbs
	for _, x in { -5, 5 } do
		Util.Ball(m, "Orb", (base * CFrame.new(x, 9, 2)).Position, 1.4, rgb(130, 75, 200), Enum.Material.Neon)
	end
	Util.Sign(m, "REBIRTH", Vector3.new(8.6, 2.4, 0.5), base * CFrame.new(0, 4.3, -4.35), {
		Name = "RebirthSign",
		BoardColor = C.Purple,
	})
end

-- Water fountain (free drinks; Survival handles the "Drink" prompt) -------------------------

local function buildFountain(parent: Instance)
	local m = Util.Model("WaterFountain", parent)
	local p = Vector3.new(Layout.FOUNTAIN.X, Util.TerrainY(Layout.FOUNTAIN), Layout.FOUNTAIN.Z)
	local water = rgb(70, 196, 240)
	local basin = Util.Cylinder(m, "Basin", p + Vector3.new(0, 1, 0), 2, 16, MARBLE, Enum.Material.Marble)
	Util.Tag(basin, "WaterFountain")
	Util.Prompt(basin, "Drink", "Water Fountain", 12)
	local pool = Util.Cylinder(m, "Water", p + Vector3.new(0, 2.05, 0), 0.2, 14, water, Enum.Material.Glass, true)
	pool.Transparency = 0.25
	Util.Cylinder(m, "Pillar", p + Vector3.new(0, 4, 0), 4, 2.4, MARBLE, Enum.Material.Marble)
	Util.Cylinder(m, "Bowl", p + Vector3.new(0, 6.3, 0), 0.8, 7, C.Ocean)
	local top = Util.Cylinder(m, "BowlWater", p + Vector3.new(0, 6.75, 0), 0.15, 6.2, water, Enum.Material.Glass, true)
	top.Transparency = 0.25
	Util.Ball(m, "Spout", p + Vector3.new(0, 8.2, 0), 2.2, water, Enum.Material.Glass)
	-- Little splashing "jets" around the bowl
	for k = 0, 5 do
		local a = math.rad(k * 60)
		Util.Ball(
			m,
			"Splash",
			p + Vector3.new(math.cos(a) * 4.4, 3.4, math.sin(a) * 4.4),
			1,
			water,
			Enum.Material.Glass
		)
	end
	local base = Util.Facing(p + Vector3.new(0, 0, -9.5), Layout.HUB_LOOK_TARGET)
	Util.Sign(m, "FREE WATER", Vector3.new(8, 2, 0.4), base * CFrame.new(0, 2.6, 0), {
		Name = "FountainSign",
		BoardColor = C.Ocean,
		TextColor = WHITE,
	})
	for _, x in { -3.4, 3.4 } do
		lp(m, base, "SignPost", Vector3.new(0.5, 2, 0.5), Vector3.new(x, 1, 0.3), WOOD_DARK, Enum.Material.Wood)
	end
end

-- Construction Crate yard (v2.1, Companions): where the Digger Garage stood --------------------
-- A small arc of wooden pallets, one per Config.Eggs entry with Kind = "Crate", facing the plaza.
-- Each pallet: tag "CrateShop", attribute EggId (part + prompt), "Open" prompt -> EggPanel.

local CRATE_YARD = Layout.GARAGE
local CRATE_ARC_RADIUS = 16
local CRATE_ARC_DEGREES = 80

local function buildCrateYard(parent: Instance)
	local crates: { Types.EggDef } = {}
	for _, egg in Config.Eggs do
		if egg.Kind == "Crate" then
			table.insert(crates, egg)
		end
	end
	if #crates == 0 then
		return
	end
	local m = Util.Model("CrateYard", parent)
	local toHub = Layout.HUB_CENTER - CRATE_YARD
	local dir = Vector3.new(toHub.X, 0, toHub.Z).Unit
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local center = CRATE_YARD - dir * 10
	local function arcPoint(a: number, r: number): Vector3
		return center + (right * math.sin(a) + dir * math.cos(a)) * r
	end
	local hazard = rgb(255, 200, 40)
	local black = rgb(40, 40, 46)
	local n = #crates
	for i, egg in crates do
		local t = if n > 1 then (i - 1) / (n - 1) else 0.5
		local a = math.rad(-CRATE_ARC_DEGREES / 2 + CRATE_ARC_DEGREES * t)
		-- +2: smooth terrain's visible surface sits ~2 studs above the voxel grid (see buildEggs)
		local pos = arcPoint(a, CRATE_ARC_RADIUS) + Vector3.new(0, 2, 0)
		local out = ((pos - center) * Vector3.new(1, 0, 1)).Unit
		local base = CFrame.lookAt(pos, pos + out)

		-- pallet (2 studs sunk into the sand, top at pos.Y + 1)
		local pallet = lp(
			m,
			base,
			"CratePallet_" .. egg.Id,
			Vector3.new(6, 3, 6),
			Vector3.new(0, -0.5, 0),
			WOOD,
			Enum.Material.WoodPlanks
		)
		pallet:SetAttribute("EggId", egg.Id)
		Util.Tag(pallet, "CrateShop")
		local prompt = Util.Prompt(pallet, "Open", egg.Name, 8)
		prompt:SetAttribute("EggId", egg.Id)
		for k = -1, 1 do
			lp(
				m,
				base,
				"PalletSlat",
				Vector3.new(6.2, 0.3, 1.2),
				Vector3.new(0, 1.1, k * 2.3),
				WOOD_DARK,
				Enum.Material.Wood,
				true
			).Parent =
				pallet
		end
		-- hazard stripes around the pallet edge
		for k = 0, 5 do
			local color = if k % 2 == 0 then hazard else black
			lp(m, base, "HazardStripe", Vector3.new(1, 0.5, 0.2), Vector3.new(-2.5 + k, 0.4, -3.05), color, nil, true).Parent =
				pallet
		end

		local ok, result = pcall(Models.Egg, egg.Id)
		if ok and typeof(result) == "Instance" and result:IsA("Model") then
			local crateModel = result :: Model
			Util.Finish(crateModel, true)
			Util.Ground(crateModel, CFrame.lookAt(pos + Vector3.new(0, 1.3, 0), pos + Vector3.new(0, 1.3, 0) + out))
			crateModel.Parent = pallet
		else
			warn("[World] Models.Egg failed for", egg.Id, result)
		end

		local bb = Instance.new("BillboardGui")
		bb.Name = "CrateInfo"
		bb.Size = UDim2.fromScale(6, 2.4)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 7.5, 0)
		bb.MaxDistance = 40
		bb.LightInfluence = 0
		bb.Parent = pallet
		Util.Label(bb, egg.Name, egg.Look.SpotColor:Lerp(WHITE, 0.2), UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.45))
		local price = Util.Label(
			bb,
			priceText(egg),
			C.Gold,
			UDim2.fromScale(0.1, 0.45),
			UDim2.fromScale(0.8, 0.3),
			Theme.Fonts.Number
		)
		price.Name = "Price"
		local layer = Config.Layers[egg.UnlockLayer]
		if layer and layer.DepthStart > 0 then
			local unlock = Util.Label(
				bb,
				"Unlocks at " .. Format.Depth(layer.DepthStart),
				WHITE,
				UDim2.fromScale(0.15, 0.76),
				UDim2.fromScale(0.7, 0.22),
				Theme.Fonts.Body
			)
			unlock.Name = "Unlock"
		end
	end

	-- Sign behind the arc, facing the plaza
	local signPos = center - dir * 1
	local base = Util.Facing(signPos, signPos + dir)
	for _, x in { -8, 8 } do
		lp(m, base, "SignPost", Vector3.new(0.9, 13, 0.9), Vector3.new(x, 6.5, 0.6), black, Enum.Material.Metal)
	end
	Util.Sign(m, "CONSTRUCTION CRATES", Vector3.new(19, 4.6, 0.8), base * CFrame.new(0, 11, 0), {
		Name = "CrateSign",
		BoardColor = rgb(240, 160, 30),
		SubText = "Pets that DIG for you!",
	})
	-- Traffic cones at the arc ends (decor)
	for _, sx in { -1, 1 } do
		local p = arcPoint(math.rad(sx * (CRATE_ARC_DEGREES / 2 + 16)), CRATE_ARC_RADIUS)
		local y = Util.TerrainY(p)
		local coneBase = CFrame.new(p.X, y, p.Z)
		lp(m, coneBase, "ConeBase", Vector3.new(2.4, 0.3, 2.4), Vector3.new(0, 0.15, 0), rgb(255, 120, 30), nil, true)
		Util.Cylinder(m, "Cone", (coneBase * CFrame.new(0, 1.4, 0)).Position, 2.4, 1.4, rgb(255, 120, 30), nil, true)
		Util.Cylinder(m, "ConeStripe", (coneBase * CFrame.new(0, 1.6, 0)).Position, 0.4, 1.45, WHITE, nil, true)
	end
end

-- Beach shop stall: shade + snacks (Survival opens its panel from the "Shop" prompt) ----------

local function buildBeachShop(parent: Instance)
	local m = Util.Model("BeachShop", parent)
	local base = hubFacing(Layout.BEACH_SHOP)
	local lime = rgb(150, 220, 80)

	lp(m, base, "Floor", Vector3.new(16, 1, 12), Vector3.new(0, 0.5, 0), WOOD, Enum.Material.WoodPlanks)
	local counter = lp(m, base, "Counter", Vector3.new(14, 3.6, 3), Vector3.new(0, 2.8, -3.5), lime)
	lp(m, base, "CounterTop", Vector3.new(15, 0.5, 3.6), Vector3.new(0, 4.85, -3.5), WOOD, Enum.Material.WoodPlanks)
	Util.Tag(counter, "BeachShop")
	Util.Prompt(counter, "Shop", "Beach Shop", 14)
	lp(m, base, "BackWall", Vector3.new(16, 9, 0.8), Vector3.new(0, 5, 5.6), C.Ocean:Lerp(WHITE, 0.5))
	for _, x in { -7.6, 7.6 } do
		for _, z in { -5.4, 5.4 } do
			lp(m, base, "Post", Vector3.new(0.8, 11, 0.8), Vector3.new(x, 6, z), WHITE)
		end
	end
	-- Striped awning (lime / white)
	for k = 0, 5 do
		local color = if k % 2 == 0 then lime else WHITE
		local awning = lp(m, base, "Awning", Vector3.new(2.8, 0.5, 13), Vector3.new(-7 + k * 2.8, 11.6, 0), color)
		awning.CFrame = base * CFrame.new(-7 + k * 2.8, 11.6, 0) * CFrame.Angles(math.rad(-8), 0, 0)
	end
	-- Display: lemonade jug, coconuts, folded umbrella
	Util.Cylinder(
		m,
		"Lemonade",
		(base * CFrame.new(-4.5, 6.2, -3.5)).Position,
		2.2,
		1.8,
		rgb(255, 236, 90),
		Enum.Material.Glass,
		true
	)
	for k = 0, 2 do
		Util.Ball(m, "Coconut", (base * CFrame.new(-0.8 + k * 1.5, 5.7, -3.3)).Position, 1.4, rgb(120, 80, 50))
	end
	Util.Cylinder(m, "UmbrellaPole", (base * CFrame.new(4.8, 7.4, -3.5)).Position, 4.6, 0.3, WHITE, nil, true)
	Util.Part({
		Name = "UmbrellaTop",
		Size = Vector3.new(1.4, 2.4, 1.4),
		CFrame = base * CFrame.new(4.8, 8.6, -3.5),
		Color = C.Coral,
		Material = Enum.Material.Fabric,
		Decor = true,
		Parent = m,
	})
	Util.Sign(m, "BEACH SHOP", Vector3.new(14, 3.2, 0.6), base * CFrame.new(0, 14.2, -5.6), {
		Name = "BeachShopSign",
		BoardColor = lime,
		SubText = "SHADE & SNACKS",
	})
end

function Hub.Build(parent: Instance)
	buildSpawns(parent)
	buildSell(parent)
	buildShops(parent)
	buildLeaderboard(parent, "LeaderboardCoins", Layout.LEADERBOARD_COINS, "LeaderboardCoins", "TOP DIGGERS", C.Gold)
	buildLeaderboard(parent, "LeaderboardDepth", Layout.LEADERBOARD_DEPTH, "LeaderboardDepth", "DEEPEST", C.Ocean)
	buildEggs(parent)
	buildRebirth(parent)

	buildFountain(parent)
	buildCrateYard(parent)
	buildBeachShop(parent)

	-- Bunting flag poles around the plaza
	local flagColors = { C.Coral, C.Ocean, C.Gold, C.Palm }
	local i = 0
	for _, x in { -22, 22 } do
		for _, dz in { -12, 14 } do
			i += 1
			local p = Vector3.new(x, S, Layout.HUB_CENTER.Z + dz)
			Util.Part({
				Name = "FlagPole",
				Size = Vector3.new(0.6, 14, 0.6),
				CFrame = CFrame.new(p + Vector3.new(0, 7, 0)),
				Color = WHITE,
				Parent = parent,
			})
			Util.Wedge({
				Name = "Flag",
				Size = Vector3.new(0.2, 2.6, 4),
				CFrame = CFrame.new(p + Vector3.new(0, 12.4, 2)),
				Color = flagColors[i],
				Decor = true,
				Parent = parent,
			})
		end
	end
end

return Hub
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">Layout</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Layout — every map coordinate in one place (see docs/MAP.md for the top-down drawing).

	Axes: +X = east, -X = west, +Z = inland (boardwalk / hub / dunes), -Z = ocean.
	One long shared DIG ZONE runs along the shoreline on the water side. Inland of it sits the
	boardwalk (spawns), then the hub plaza with every station, then the dunes. The pier leaves
	from the wet sand beyond the dig zone out into the sea.

	All dig-zone edges sit on the 8-stud tide-cell grid (and therefore the 4-stud voxel grid).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local S = Config.SURFACE_Y

local Layout = {}

Layout.SURFACE_Y = S
Layout.BOTTOM_Y = S - Config.TOTAL_DEPTH -- 24 (never below 0)
Layout.WATER_Y = S - 4 -- terrain water surface
Layout.SEABED_Y = S - 20
Layout.SEED = 20261005

-- Dig zone (the diggable sand strip). X/Z footprint, surface at S, bottom at BOTTOM_Y.
Layout.DIG_HALF_X = 384 -- 768 studs of diggable coastline
Layout.DIG_Z_INLAND = -8 -- inland edge (towards the boardwalk)
Layout.DIG_Z_SEA = -64 -- seaward edge
Layout.DIG_CENTER = Vector3.new(0, S, (Layout.DIG_Z_INLAND + Layout.DIG_Z_SEA) / 2) -- z -36
Layout.DIG_SIZE = Vector3.new(Layout.DIG_HALF_X * 2, Config.TOTAL_DEPTH, Layout.DIG_Z_INLAND - Layout.DIG_Z_SEA)

-- Underground layered block = dig zone + solid layered walls around it (never diggable).
Layout.WALL = 8
Layout.STRIP_HALF_X = Layout.DIG_HALF_X + Layout.WALL -- 392
Layout.STRIP_Z_INLAND = Layout.DIG_Z_INLAND + Layout.WALL -- 0
Layout.STRIP_Z_SEA = Layout.DIG_Z_SEA - Layout.WALL -- -72

-- Beach / ocean (south, -Z)
Layout.BEACH_FLAT_END_Z = -80 -- wet sand stays at surface height until here
Layout.BEACH_SLOPE_END_Z = -136 -- then slopes down to the seabed
Layout.OCEAN_FAR_Z = -460
Layout.TERRAIN_HALF_X = 520

-- Boardwalk (inland edge of the dig zone; spawns stand on it)
Layout.BOARDWALK_Z0 = -4 -- seaward edge
Layout.BOARDWALK_Z1 = 12 -- inland edge
-- Smooth terrain's visible surface sits ~2 studs above the 4-stud voxel grid that S is on
-- (CHANGELOG: v1/v2 playtests and the v2.2 playtest). Decks and stations are lifted by it.
Layout.VISIBLE_SURFACE_OFFSET = 2
-- Deck top 1 stud above the VISIBLE sand. v2.2 playtest: at S + 1 the deck, the spawn pads and
-- their rims were half under the sand.
Layout.DECK_TOP = S + Layout.VISIBLE_SURFACE_OFFSET + 1

-- Hub (north of the boardwalk)
Layout.HUB_CENTER = Vector3.new(0, S, 50)
Layout.HUB_RADIUS = 30
Layout.DUNES_Z0 = 120
Layout.TERRAIN_NORTH_Z = 170

-- Kept for Lighting.luau (High Tide sheet starts at z = -ROW_FAR - 3 = the dig zone's inland edge).
Layout.ROW_FAR = -Layout.DIG_Z_INLAND - 3 -- 5

-- Pier (from the wet sand beyond the dig zone out to sea)
Layout.PIER_HALF_W = 6
Layout.PIER_Z0 = Layout.DIG_Z_SEA - 4 -- -68
Layout.PIER_Z1 = -200
Layout.PIER_END_HALF = 14 -- end platform half-size (x), spans z PIER_Z1 .. PIER_Z1 - 24
Layout.PIER_END_DEPTH = 24

-- Invisible boundary
Layout.BOUND_HALF_X = 400
Layout.BOUND_NORTH_Z = 130
Layout.BOUND_SOUTH_Z = -232

-- Hub stations (surface positions). Spawns stand on the boardwalk deck, facing the sand.
Layout.SPAWNS = {
	Vector3.new(0, Layout.DECK_TOP, 4),
	Vector3.new(-14, Layout.DECK_TOP, 4),
	Vector3.new(14, Layout.DECK_TOP, 4),
}
Layout.HUB_LOOK_TARGET = Vector3.new(0, S, 4) -- hub stations face the boardwalk spawns
Layout.SELL = Vector3.new(0, S, 28)
Layout.FOUNTAIN = Vector3.new(0, S, 54)
Layout.SHOVEL_SHOP = Vector3.new(-36, S, 34)
Layout.BACKPACK_SHOP = Vector3.new(36, S, 34)
Layout.GARAGE = Vector3.new(-78, S, 44)
Layout.BEACH_SHOP = Vector3.new(76, S, 40)
Layout.LEADERBOARD_COINS = Vector3.new(-14, S, 92)
Layout.LEADERBOARD_DEPTH = Vector3.new(14, S, 92)
Layout.REBIRTH = Vector3.new(44, S, 72)
Layout.EGG_ARC_CENTER = Vector3.new(-50, S, 92)
Layout.EGG_ARC_RADIUS = 19
Layout.EGG_ARC_DEGREES = 110
Layout.TITLE_SIGN = Vector3.new(0, S, 118)

-- Terrain surface height at `z` on the beach side (flat, then linear slope to the seabed).
function Layout.GroundY(z: number): number
	if z >= Layout.BEACH_FLAT_END_Z then
		return S
	end
	local seabedTop = Layout.SEABED_Y + 4
	local t = math.clamp((Layout.BEACH_FLAT_END_Z - z) / (Layout.BEACH_FLAT_END_Z - Layout.BEACH_SLOPE_END_Z), 0, 1)
	return S + (seabedTop - S) * t
end

-- Snap a Y value to the 4-stud terrain voxel grid.
function Layout.SnapY(y: number): number
	return math.floor(y / 4 + 0.5) * 4
end

return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">Lighting</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Lighting — sunny cartoon look (Atmosphere, Sky, ColorCorrection, Bloom, SunRays) and
	the visual side of timed events:
	  HighTide   -> a translucent "tide sheet" floods the lower beach, bigger waves, deeper water.
	  GoldenHour -> ClockTime 17.8, warm tint and haze.
	Driven by World.ApplyEvent(ids) and by the workspace attribute "ActiveEvents"
	(comma-separated event ids, set by the server).

	Exposure budget (playtest: "anything that glows / white gets hard to see"): Future lighting
	+ pale sand + white parts blew out. Values below keep the sand mid-bright: low exposure,
	low environment diffuse/specular, no atmosphere glare, and a high bloom threshold so only
	genuinely emissive Neon blooms (and only softly). Golden Hour dims instead of brightening.

	Effects are named "World*" so the client depth-tint controller can add its own instances
	(or tweak these) without fighting the server.
]]

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Layout = require(script.Parent.Layout)
local Util = require(script.Parent.Util)

local rgb = Color3.fromRGB
local S = Layout.SURFACE_Y

local LightingBuilder = {}

local BASE = {
	ClockTime = 14,
	Brightness = 2,
	Exposure = -0.3,
	Tint = Color3.new(1, 1, 1),
	Saturation = 0.15,
	AtmosphereColor = rgb(190, 222, 245),
	AtmosphereDecay = rgb(110, 170, 215),
	AtmosphereHaze = 0.4,
	BloomIntensity = 0.22,
	WaterColor = rgb(24, 178, 226),
	WaveSize = 0.3,
}
local GOLDEN = {
	ClockTime = 17.8,
	Brightness = 1.6,
	Exposure = -0.4,
	Tint = rgb(255, 236, 214),
	Saturation = 0.2,
	AtmosphereColor = rgb(240, 196, 160),
	AtmosphereDecay = rgb(220, 135, 100),
	AtmosphereHaze = 1.1,
	BloomIntensity = 0.28,
}
local HIGH_TIDE = {
	WaterColor = rgb(14, 140, 214),
	WaveSize = 0.65,
	SheetY = S - 0.6, -- floods the flat beach up to just below the plot frames
}
local TIDE_LOW_Y = Layout.WATER_Y - 1.5

local atmosphere: Atmosphere? = nil
local colorCorrection: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil
local tideSheet: Part? = nil
local current = { HighTide = false, GoldenHour = false }

local function getOrCreate(className: string, name: string, parent: Instance): Instance
	local existing = parent:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = parent
	return inst
end

local function tween(inst: Instance, seconds: number, goals: { [string]: any })
	TweenService:Create(inst, TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), goals):Play()
end

function LightingBuilder.Build(parent: Instance)
	pcall(function()
		(Lighting :: any).Technology = Enum.Technology.Future
	end)
	Lighting.ClockTime = BASE.ClockTime
	Lighting.Brightness = BASE.Brightness
	Lighting.GeographicLatitude = 23
	Lighting.Ambient = rgb(95, 95, 110)
	Lighting.OutdoorAmbient = rgb(128, 128, 142)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.3
	Lighting.ExposureCompensation = BASE.Exposure

	local atm = getOrCreate("Atmosphere", "WorldAtmosphere", Lighting) :: Atmosphere
	atm.Density = 0.24
	atm.Offset = 0.15
	atm.Color = BASE.AtmosphereColor
	atm.Decay = BASE.AtmosphereDecay
	atm.Glare = 0 -- glare = a blinding halo around the sun
	atm.Haze = BASE.AtmosphereHaze
	atmosphere = atm

	local sky = getOrCreate("Sky", "WorldSky", Lighting) :: Sky
	sky.SunAngularSize = 11
	sky.MoonAngularSize = 9
	sky.StarCount = 1500

	local cc = getOrCreate("ColorCorrectionEffect", "WorldColorCorrection", Lighting) :: ColorCorrectionEffect
	cc.Brightness = -0.02
	cc.Contrast = 0.04
	cc.Saturation = BASE.Saturation
	cc.TintColor = BASE.Tint
	colorCorrection = cc

	local bl = getOrCreate("BloomEffect", "WorldBloom", Lighting) :: BloomEffect
	bl.Intensity = BASE.BloomIntensity
	bl.Size = 12
	bl.Threshold = 2.4 -- only true emitters bloom; lit white plastic / sand never does
	bloom = bl

	local rays = getOrCreate("SunRaysEffect", "WorldSunRays", Lighting) :: SunRaysEffect
	rays.Intensity = 0.025
	rays.Spread = 0.7

	-- High-tide sheet over the lower beach and shallows (invisible when the tide is low).
	local zTop = -Layout.ROW_FAR - 3
	local zBottom = Layout.BOUND_SOUTH_Z - 40
	tideSheet = Util.Part({
		Name = "TideSheet",
		Size = Vector3.new(Layout.TERRAIN_HALF_X * 2, 0.4, zTop - zBottom),
		CFrame = CFrame.new(0, TIDE_LOW_Y, (zTop + zBottom) / 2),
		Color = rgb(70, 196, 240),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 1,
		Reflectance = 0.15,
		Decor = true,
		Parent = parent,
	})

	-- React to the server's event attribute.
	local function fromAttribute()
		local raw = Workspace:GetAttribute("ActiveEvents")
		local ids = {}
		if typeof(raw) == "string" then
			for id in string.gmatch(raw, "[^,%s]+") do
				table.insert(ids, id)
			end
		end
		LightingBuilder.ApplyEvent(ids)
	end
	Workspace:GetAttributeChangedSignal("ActiveEvents"):Connect(fromAttribute)
	fromAttribute()
end

function LightingBuilder.ApplyEvent(eventIds: { string })
	local golden = table.find(eventIds, "GoldenHour") ~= nil
	local high = table.find(eventIds, "HighTide") ~= nil
	local t = 4

	if golden ~= current.GoldenHour then
		current.GoldenHour = golden
		local g = if golden then GOLDEN else BASE
		tween(
			Lighting,
			t * 2,
			{ ClockTime = g.ClockTime, Brightness = g.Brightness, ExposureCompensation = g.Exposure }
		)
		if colorCorrection then
			tween(colorCorrection, t * 2, { TintColor = g.Tint, Saturation = g.Saturation })
		end
		if atmosphere then
			tween(atmosphere, t * 2, { Color = g.AtmosphereColor, Decay = g.AtmosphereDecay, Haze = g.AtmosphereHaze })
		end
		if bloom then
			tween(bloom, t * 2, { Intensity = g.BloomIntensity })
		end
	end

	if high ~= current.HighTide then
		current.HighTide = high
		local terrain = Workspace.Terrain
		tween(terrain, t, {
			WaterColor = if high then HIGH_TIDE.WaterColor else BASE.WaterColor,
			WaterWaveSize = if high then HIGH_TIDE.WaveSize else BASE.WaveSize,
		})
		local sheet = tideSheet
		if sheet then
			local cf = sheet.CFrame
			local y = if high then HIGH_TIDE.SheetY else TIDE_LOW_Y
			tween(sheet, t, {
				CFrame = CFrame.new(cf.X, y, cf.Z),
				Transparency = if high then 0.45 else 1,
			})
		end
	end
end

return LightingBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">Terrain</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Terrain — material colours, the beach surface, the ocean and the layered underground block
	under the dig zone. Layer bands come from Config.Layers (snapped to the 4-stud voxel grid).

	Underground: one layered block, X in [-STRIP_HALF_X, STRIP_HALF_X], Z in
	[STRIP_Z_SEA, STRIP_Z_INLAND], Y from BOTTOM_Y to SURFACE_Y. It is the dig zone plus a WALL of
	solid layers on every side; the server clamps all carving to the dig zone, so the walls (and
	the hub / ocean beyond them) never break.

	FillLayered(min, max) refills any box with the right layer materials (tide refills).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(script.Parent.Layout)

local terrain = Workspace.Terrain
local S = Layout.SURFACE_Y
local rgb = Color3.fromRGB

local TerrainBuilder = {}

export type Band = { Top: number, Bottom: number, Material: Enum.Material }

-- Layer bands in world Y, top to bottom, snapped to the voxel grid.
local function computeBands(): { Band }
	local bands: { Band } = {}
	for i, layer in Config.Layers do
		local top = if i == 1 then S else Layout.SnapY(S - layer.DepthStart)
		local bottom = if i == #Config.Layers then Layout.BOTTOM_Y else Layout.SnapY(S - layer.DepthEnd)
		if top > bottom then
			table.insert(bands, { Top = top, Bottom = bottom, Material = layer.Material })
		end
	end
	return bands
end

TerrainBuilder.Bands = computeBands()

local function fillBox(minV: Vector3, maxV: Vector3, material: Enum.Material)
	local size = maxV - minV
	if size.X <= 0 or size.Y <= 0 or size.Z <= 0 then
		return
	end
	terrain:FillBlock(CFrame.new((minV + maxV) / 2), size, material)
end

function TerrainBuilder.ApplyColors()
	for _, layer in Config.Layers do
		terrain:SetMaterialColor(layer.Material, layer.Color)
	end
	-- Scenery-only materials (no layer uses these).
	terrain:SetMaterialColor(Enum.Material.Grass, rgb(110, 214, 92))
	terrain:SetMaterialColor(Enum.Material.LeafyGrass, rgb(86, 196, 88))
	terrain:SetMaterialColor(Enum.Material.Cobblestone, rgb(236, 206, 156))
	terrain:SetMaterialColor(Enum.Material.Concrete, rgb(250, 236, 206))

	terrain.WaterColor = rgb(24, 178, 226)
	terrain.WaterTransparency = 0.55
	terrain.WaterReflectance = 0.45
	terrain.WaterWaveSize = 0.3
	terrain.WaterWaveSpeed = 12
	-- (Terrain.Decoration is NotScriptable: setting it errors at runtime. Leave it to the place.)
end

-- Beach, path, plaza, dunes and ocean. Synchronous (cheap).
function TerrainBuilder.BuildSurface(rng: Random)
	local hx = Layout.TERRAIN_HALF_X
	local sand = Enum.Material.Sand
	local seabedTop = Layout.SEABED_Y + 4 -- 1008

	-- Ocean water first; sand written afterwards overwrites it where solid.
	fillBox(
		Vector3.new(-hx, Layout.SEABED_Y, Layout.OCEAN_FAR_Z),
		Vector3.new(hx, Layout.WATER_Y, Layout.BEACH_FLAT_END_Z + 4),
		Enum.Material.Water
	)
	-- Seabed
	fillBox(
		Vector3.new(-hx, Layout.SEABED_Y - 8, Layout.OCEAN_FAR_Z),
		Vector3.new(hx, seabedTop, Layout.BEACH_SLOPE_END_Z),
		sand
	)
	-- Flat beach / land slab at surface height
	fillBox(Vector3.new(-hx, S - 16, Layout.BEACH_FLAT_END_Z), Vector3.new(hx, S, Layout.TERRAIN_NORTH_Z), sand)
	-- Beach slope: 4-stud slices whose height falls linearly (smooth terrain blends the steps).
	local z = Layout.BEACH_FLAT_END_Z
	local span = Layout.BEACH_FLAT_END_Z - Layout.BEACH_SLOPE_END_Z
	while z > Layout.BEACH_SLOPE_END_Z do
		local t = (Layout.BEACH_FLAT_END_Z - (z - 2)) / span
		local top = S + (seabedTop - S) * t
		fillBox(Vector3.new(-hx, Layout.SEABED_Y - 8, z - 4), Vector3.new(hx, top, z), sand)
		z -= 4
	end

	-- Path from the boardwalk to the hub (cobblestone) and the round hub plaza (concrete),
	-- painted into the top voxels.
	local hub = Layout.HUB_CENTER
	fillBox(Vector3.new(-8, S - 4, Layout.BOARDWALK_Z1), Vector3.new(8, S, hub.Z), Enum.Material.Cobblestone)
	terrain:FillCylinder(CFrame.new(hub.X, S - 2, hub.Z), 4, Layout.HUB_RADIUS, Enum.Material.Concrete)

	-- Grassy dunes behind the hub
	fillBox(Vector3.new(-hx, S - 4, Layout.DUNES_Z0), Vector3.new(hx, S, Layout.TERRAIN_NORTH_Z), Enum.Material.Grass)
	for _ = 1, 34 do
		local x = rng:NextNumber(-hx + 20, hx - 20)
		local dz = rng:NextNumber(Layout.DUNES_Z0 + 14, Layout.TERRAIN_NORTH_Z - 4)
		local r = rng:NextNumber(10, 22)
		local mat = if rng:NextNumber() < 0.5 then Enum.Material.Grass else Enum.Material.LeafyGrass
		terrain:FillBall(Vector3.new(x, S - r * 0.55, dz), r, mat)
	end
	-- Sandy dunes on the far east/west beach (outside the playable boundary)
	for _ = 1, 10 do
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		local x = side * rng:NextNumber(Layout.BOUND_HALF_X + 20, hx - 20)
		local dz = rng:NextNumber(Layout.STRIP_Z_INLAND + 20, 100)
		local r = rng:NextNumber(10, 18)
		terrain:FillBall(Vector3.new(x, S - r * 0.6, dz), r, sand)
	end
end

-- Fill the layered materials into the box [minV, maxV] (Y clamped to the layer range).
-- Synchronous: callers chunk large boxes themselves.
function TerrainBuilder.FillLayered(minV: Vector3, maxV: Vector3)
	for _, band in TerrainBuilder.Bands do
		local y0 = math.max(minV.Y, band.Bottom)
		local y1 = math.min(maxV.Y, band.Top)
		if y1 > y0 then
			fillBox(Vector3.new(minV.X, y0, minV.Z), Vector3.new(maxV.X, y1, maxV.Z), band.Material)
		end
	end
end

local function stripBand(band: Band, x0: number, x1: number)
	fillBox(
		Vector3.new(x0, band.Bottom, Layout.STRIP_Z_SEA),
		Vector3.new(x1, band.Top, Layout.STRIP_Z_INLAND),
		band.Material
	)
end

-- Top bands (layers 1-2) synchronously, so the surface is solid immediately.
function TerrainBuilder.BuildStripTops()
	local hx = Layout.STRIP_HALF_X
	for i = 1, math.min(2, #TerrainBuilder.Bands) do
		stripBand(TerrainBuilder.Bands[i], -hx, hx)
	end
end

-- The remaining bands, chunked along X with a yield per chunk (call in a task).
function TerrainBuilder.BuildStripsDeep()
	local hx = Layout.STRIP_HALF_X
	local chunk = 112
	for i = 3, #TerrainBuilder.Bands do
		local band = TerrainBuilder.Bands[i]
		local x = -hx
		while x < hx do
			local x1 = math.min(x + chunk, hx)
			stripBand(band, x, x1)
			x = x1
			task.wait()
		end
	end
end

return TerrainBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">Underground</string>
            <string name="Source"><![CDATA[--!strict
-- Authored wall alcoves. All air and geometry stay inland of the dig/refill footprint.
-- Open only AFTER deep terrain has finished, otherwise its fill would bury the scenery.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)
local Build = require(ReplicatedStorage.Shared.Models.Build)
local Layout = require(script.Parent.Layout)
local Util = require(script.Parent.Util)

local Underground = {}
local V = Vector3.new
local rgb = Color3.fromRGB

export type Pocket = { Layer: string, Min: Vector3, Max: Vector3 }
Underground.Pockets = {} :: { Pocket }

for index, layer: Types.LayerDef in Config.Layers do
	-- Four-stud margins keep even the shallowest pocket within its own layer.
	local height = math.min(24, math.floor((layer.DepthEnd - layer.DepthStart - 8) / 4) * 4)
	local floor = Layout.SnapY(Layout.SURFACE_Y - (layer.DepthStart + layer.DepthEnd) / 2 - height / 2)
	local positions: { number } = if index % 2 == 1 then { -192, 0, 192 } else { -288, -96, 96 }
	-- Preserve the already reviewed crystal placement.
	if layer.Id == "crystal_caverns" then
		positions = { -288, -96, 96 }
	end
	for _, x in positions do
		table.insert(Underground.Pockets, {
			Layer = layer.Id,
			Min = V(x - 16, floor, Layout.DIG_Z_INLAND),
			Max = V(x + 16, floor + height, Layout.STRIP_Z_INLAND),
		})
	end
end

-- Large, supported silhouettes rather than collectible-sized treasure props.
local function landmark(model: Model, origin: Vector3, id: string)
	local cream, stone, dark = rgb(236, 215, 171), rgb(130, 139, 151), rgb(65, 57, 79)
	local function block(name: string, size: Vector3, at: Vector3, color: Color3, material: Enum.Material?)
		return Build.part(model, name, size, CFrame.new(origin + at), color, material)
	end
	local function beam(name: string, a: Vector3, b: Vector3, width: number, color: Color3)
		Build.beam(model, name, origin + a, origin + b, width, 0.7, color)
	end
	if id == "dry_sand" then
		Build.cyl(model, "Bucket", 4, 5, CFrame.new(origin + V(-6, 5, -4)), rgb(70, 169, 180))
		beam("SpadeHandle", V(-2, 3, -4), V(1, 9, -4), 0.6, cream)
		block("SpadeBlade", V(2.2, 2, 0.5), V(-2, 4, -4), rgb(216, 119, 95))
		block("CastleWall", V(10, 3, 3), V(7, 4.5, -4), cream)
		for _, x in { 3, 11 } do
			Build.cyl(model, "CastleTurret", 5, 3, CFrame.new(origin + V(x, 5.5, -4)), cream)
			block("Battlement", V(3, 1, 3), V(x, 8.5, -4), cream)
		end
	elseif id == "wet_sand" then
		for _, x in { -10, 10 } do
			Build.ellipsoid(model, "TideStone", V(5, 5, 4), CFrame.new(origin + V(x, 4.5, -4)), stone)
		end
		beam("Driftwood", V(-10, 7, -4), V(9, 10, -4), 2, rgb(161, 116, 78))
		block("TideBasin", V(13, 0.5, 4), V(0, 3.25, -4), rgb(77, 156, 172))
		for i = -2, 2 do
			Build.ellipsoid(model, "BasinShell", V(2, 1, 1.5), CFrame.new(origin + V(i * 2.6, 3.7, -6)), cream)
		end
	elseif id == "shell_bed" then
		for side = -1, 1, 2 do
			for i = -2, 2 do
				beam("ClamFan", V(0, 3, -4), V(i * 3, 8 + side * 3, -4 + side * 1.2), 2, rgb(232, 174, 180))
			end
		end
		Build.ball(model, "Pearl", 4, CFrame.new(origin + V(0, 5, -5)), cream)
	elseif id == "tidal_clay" then
		beam("DinghyKeel", V(-12, 3.5, -4), V(2, 5, -4), 2, rgb(143, 101, 69))
		for i = 0, 3 do
			block("DinghyRib", V(1, 5 + i, 4), V(-10 + i * 3, 6, -4), cream)
		end
		beam("AnchorShaft", V(8, 3, -4), V(8, 16, -4), 1.2, stone)
		beam("AnchorStock", V(4, 13, -4), V(12, 13, -4), 1, stone)
		beam("AnchorFluke", V(8, 4, -4), V(3, 7, -4), 1.2, stone)
		beam("AnchorFluke", V(8, 4, -4), V(13, 7, -4), 1.2, stone)
	elseif id == "shipwreck" then
		local wood = rgb(146, 96, 58)
		for _, x in { -9, 3 } do
			block("DoorPost", V(2, 14, 3), V(x, 10, -4), wood)
		end
		block("DoorLintel", V(14, 2, 3), V(-3, 17, -4), cream)
		for i = 0, 3 do
			block("DeckStep", V(15, 0.8, 1), V(-3, 3.4 + i * 0.8, -6 + i), wood)
		end
		for _, y in { 5, 9 } do
			Build.cyl(model, "Barrel", 4, 4, CFrame.new(origin + V(10, y, -4)), wood)
			Build.cyl(model, "BarrelBand", 0.4, 4.2, CFrame.new(origin + V(10, y + 1, -4)), stone)
		end
	elseif id == "fossil_bed" then
		beam("FossilSpine", V(-11, 7, -3), V(10, 7, -3), 1.5, cream)
		for i = -2, 2 do
			for side = -1, 1, 2 do
				beam("FossilRib", V(i * 4, 7, -3), V(i * 4 + side, 4, -5), 1, cream)
			end
		end
		block("FossilJaw", V(8, 1.5, 3), V(6, 3.75, -4), cream)
		for i = 0, 3 do
			Build.tri(model, "FossilTooth", CFrame.new(origin + V(3 + i * 2, 5.5, -4)), 1.3, 2, 0.8, cream)
		end
	elseif id == "bedrock" then
		for i = -2, 2 do
			block("FaultSlab", V(4, 7 + (i + 2) * 2, 4), V(i * 5, 6.5 + i + 2, -4), stone, Enum.Material.Slate)
			block("OreSeam", V(1, 5, 0.4), V(i * 5, 6, -6.2), rgb(176, 112, 68), Enum.Material.Metal)
		end
	elseif id == "frozen_abyss" then
		Build.ellipsoid(
			model,
			"FrozenMass",
			V(13, 8, 4),
			CFrame.new(origin + V(0, 7, -3.5)),
			rgb(152, 206, 217),
			Enum.Material.Ice
		)
		for side = -1, 1, 2 do
			beam("TuskBase", V(side * 4, 3, -5), V(side * 8, 10, -5), 1.5, cream)
			beam("TuskTip", V(side * 8, 10, -5), V(side * 4, 16, -5), 1, cream)
		end
		for _, x in { -11, 11 } do
			Build.spike(
				model,
				"IceBlade",
				origin + V(x, 3, -4),
				origin + V(x, 12, -4),
				3,
				rgb(127, 189, 216),
				Enum.Material.Ice
			)
		end
	elseif id == "ancient_ruins" then
		for side = -1, 1, 2 do
			for i = 0, 2 do
				block("RuinsPillar", V(4 - i * 0.4, 4, 3), V(side * 9, 5 + i * 4, -4), cream)
			end
			block("BrokenLintel", V(7, 2, 3), V(side * 6, 16, -4), cream)
		end
		block("StoneTablet", V(7, 7, 1), V(0, 6.5, -4), rgb(191, 157, 95))
		for i = 0, 2 do
			block("TabletGlyph", V(4 - i, 0.5, 0.3), V(0, 5 + i * 2, -4.7), dark)
		end
	elseif id == "magma_chamber" then
		for i = -2, 2 do
			local h = 9 - math.abs(i) * 2
			block("BasaltVent", V(4, h, 4), V(i * 4.5, 3 + h / 2, -4), dark, Enum.Material.Basalt)
			block("VentSeam", V(0.5, h - 1, 0.3), V(i * 4.5, 3 + h / 2, -6.2), rgb(239, 110, 45), Enum.Material.Neon)
		end
		block("LavaBasin", V(18, 0.6, 3), V(0, 3.3, -4), rgb(228, 111, 43), Enum.Material.Neon)
	elseif id == "obsidian_depths" then
		for i = -1, 1 do
			block(
				"ObsidianMonolith",
				V(5, 14 + i * 3, 3),
				V(i * 8, 10 + i * 1.5, -3),
				dark,
				Enum.Material.SmoothPlastic
			)
			block("VioletInset", V(0.7, 8, 0.3), V(i * 8, 10, -4.7), rgb(144, 97, 189))
		end
		for i = -2, 2 do
			Build.ellipsoid(
				model,
				"StrangeFootprint",
				V(2.3, 0.3, 1.3),
				CFrame.new(origin + V(i * 4, 3.1, -5.5)),
				rgb(140, 109, 163)
			)
		end
	elseif id == "alien_hive" then
		for i = -1, 1 do
			Build.ellipsoid(
				model,
				"HivePod",
				V(6, 9 + i * 2, 4),
				CFrame.new(origin + V(i * 8, 7.5 + i, -4)),
				rgb(101, 176, 123)
			)
			block("PodWindow", V(2, 3, 0.4), V(i * 8, 8, -6.2), rgb(109, 204, 139), Enum.Material.Neon)
		end
		beam("HiveConduit", V(-8, 5, -4), V(8, 5, -4), 1.3, rgb(73, 135, 97))
		block("CrashedHull", V(9, 2, 3), V(5, 14, -3), stone, Enum.Material.Metal)
	elseif id == "the_core" then
		for i = 0, 2 do
			block("CoreFoundation", V(22 - i * 5, 1, 4), V(0, 3.5 + i, -4), rgb(195, 148, 64))
		end
		local center = V(0, 12, -3)
		Build.cyl(
			model,
			"CoreRelief",
			1,
			8,
			CFrame.new(origin + center) * CFrame.Angles(math.pi / 2, 0, 0),
			rgb(237, 185, 65),
			Enum.Material.Metal
		)
		beam("CoreSupport", V(0, 5, -3), V(0, 12, -3), 2, cream)
		for i = 0, 7 do
			local a = i * math.pi / 4
			local radial = V(math.sin(a), math.cos(a), 0)
			beam("CoreRay", center + radial * 3, center + radial * 7, 1, rgb(245, 202, 102))
		end
	else
		error("Missing underground landmark: " .. id)
	end
end

local function pirate(model: Model, origin: Vector3)
	local wood = rgb(126, 78, 47)
	local pale = rgb(208, 157, 94)
	local metal = rgb(172, 128, 54)
	-- A broken fishing hull: keel, rising ribs and staggered planks read before small details.
	Build.part(model, "Keel", V(21, 1.2, 3), CFrame.new(origin + V(0, 2.6, -4)), wood, Enum.Material.Wood)
	for i = -2, 2 do
		local x = i * 4
		Build.part(model, "HullRib", V(0.9, 6, 3.6), CFrame.new(origin + V(x, 5.2, -4)), pale, Enum.Material.Wood)
	end
	for i = 1, 3 do
		Build.part(
			model,
			"HullPlank",
			V(22 - i * 2, 1, 0.7),
			CFrame.new(origin + V(-1, 3 + i * 1.5, -6)),
			wood,
			Enum.Material.Wood
		)
	end
	Build.part(model, "BrokenMast", V(1.1, 13, 1.1), CFrame.new(origin + V(-5, 8, -3)), pale, Enum.Material.Wood)
	Build.part(model, "Crossbar", V(9, 0.7, 0.8), CFrame.new(origin + V(-5, 13, -3)), wood, Enum.Material.Wood)
	Build.tri(model, "TornSail", CFrame.new(origin + V(-2.5, 10.5, -3)), 5, 5, 0.25, rgb(239, 211, 158))
	-- Brass helm mounted against the back rock, distinct from collectible treasure chests.
	local centre = origin + V(8, 13, -1.5)
	Build.cyl(
		model,
		"HelmHub",
		0.7,
		1.4,
		CFrame.new(centre) * CFrame.Angles(math.pi / 2, 0, 0),
		metal,
		Enum.Material.Metal
	)
	for i = 0, 7 do
		local a = i * math.pi / 4
		local radial = V(math.sin(a), math.cos(a), 0)
		local nextRadial = V(math.sin(a + math.pi / 4), math.cos(a + math.pi / 4), 0)
		Build.beam(model, "HelmSpoke", centre, centre + radial * 3.4, 0.35, 0.35, metal, Enum.Material.Metal)
		Build.beam(
			model,
			"HelmRim",
			centre + radial * 2.6,
			centre + nextRadial * 2.6,
			0.4,
			0.4,
			pale,
			Enum.Material.Wood
		)
	end
end

local function crystal(model: Model, origin: Vector3)
	local rock = rgb(57, 56, 86)
	for i, height in { 6, 11, 16, 9, 5 } do
		local x = (i - 3) * 4.5
		local base = origin + V(x, 2.4, -4)
		Build.ellipsoid(model, "GeodeBase", V(6, 2, 5), CFrame.new(base), rock, Enum.Material.Slate)
		local tip = base + V(if i % 2 == 0 then 1.2 else -0.8, height, 0.4)
		Build.spike(
			model,
			"CrystalSpire",
			base,
			tip,
			3,
			if i % 2 == 0 then rgb(82, 184, 205) else rgb(157, 110, 211),
			Enum.Material.SmoothPlastic
		)
		-- Small emissive nodes support the silhouette without particles or whole-neon spires.
		Build.ball(model, "CrystalTip", 0.45, CFrame.new(tip), rgb(86, 193, 215), Enum.Material.Neon)
	end
end

function Underground.Build(parent: Instance)
	for i, pocket in Underground.Pockets do
		local size = pocket.Max - pocket.Min
		Workspace.Terrain:FillBlock(CFrame.new((pocket.Min + pocket.Max) / 2), size, Enum.Material.Air)
		local model = Util.Model(pocket.Layer .. "_" .. i, parent)
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		model:SetAttribute("SceneryLayer", pocket.Layer)
		model:SetAttribute("PocketMin", pocket.Min)
		model:SetAttribute("PocketMax", pocket.Max)
		local origin = V((pocket.Min.X + pocket.Max.X) / 2, pocket.Min.Y, 0)
		local isPirate = pocket.Layer == "pirate_cove"
		local isCrystal = pocket.Layer == "crystal_caverns"
		local palette = rgb(130, 139, 151)
		for _, layer in Config.Layers do
			if layer.Id == pocket.Layer then
				palette = layer.Color
				break
			end
		end
		local back = if isPirate
			then rgb(78, 62, 50)
			elseif isCrystal then rgb(45, 43, 67)
			else Build.darken(palette, 0.55)
		local shelf = if isPirate
			then rgb(108, 84, 62)
			elseif isCrystal then rgb(72, 68, 95)
			else Build.darken(palette, 0.3)
		local lampHeight = math.min(13.5, size.Y - 2)
		Build.part(
			model,
			"BackRock",
			V(31, size.Y - 1, 1),
			CFrame.new(origin + V(0, size.Y / 2, -0.5)),
			back,
			Enum.Material.Slate
		)
		Build.part(model, "RockShelf", V(29, 3, 6), CFrame.new(origin + V(0, 1.5, -4)), shelf, Enum.Material.Slate)
		if isPirate then
			pirate(model, origin)
		elseif isCrystal then
			crystal(model, origin)
		else
			landmark(model, origin, pocket.Layer)
		end
		-- Local fill keeps the authored shapes readable under the actual depth lighting.
		-- One shadowless light per streamed alcove; no global exposure change.
		Build.part(
			model,
			"LampPost",
			V(0.6, lampHeight - 1.5, 0.6),
			CFrame.new(origin + V(-13, (lampHeight + 0.5) / 2, -6.5)),
			if isPirate then rgb(126, 78, 47) elseif isCrystal then rgb(57, 56, 86) else shelf
		)
		local lamp = Build.part(
			model,
			"AlcoveLamp",
			V(0.8, 1.2, 0.8),
			CFrame.new(origin + V(-13, lampHeight, -6.5)),
			if isPirate then rgb(224, 169, 77) elseif isCrystal then rgb(86, 193, 215) else Build.lighten(palette, 0.2),
			Enum.Material.Neon
		)
		local light = Instance.new("PointLight")
		light.Name = "AlcoveFill"
		light.Color = if isPirate
			then rgb(255, 221, 166)
			elseif isCrystal then rgb(188, 212, 255)
			else Build.lighten(palette, 0.65)
		light.Brightness = 2.5
		light.Range = 32
		light.Shadows = false
		light.Parent = lamp
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.CastShadow = false
			end
		end
	end
end

return Underground
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">Util</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Util — small builders shared by the World modules: anchored parts, signs with SurfaceGuis,
	proximity prompts, tags and Models.Prop placement (pcall-guarded so a broken/missing model
	never stops the map from building).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Models = require(ReplicatedStorage.Shared.Models)
local Layout = require(script.Parent.Layout)

local Theme = Config.Theme

local Util = {}

export type PartProps = {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3?,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
	Transparency: number?,
	Reflectance: number?,
	-- Collision: default true. Decorative = no collide, no query, no touch, no shadow.
	CanCollide: boolean?,
	Decor: boolean?,
	CastShadow: boolean?,
	Parent: Instance?,
}

local function apply(p: BasePart, props: PartProps)
	p.Name = props.Name or p.ClassName
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Color = props.Color or Color3.new(1, 1, 1)
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Transparency = props.Transparency or 0
	p.Reflectance = props.Reflectance or 0
	if props.Decor then
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
	else
		p.CanCollide = props.CanCollide ~= false
		p.CanTouch = false
	end
	if props.CastShadow ~= nil then
		p.CastShadow = props.CastShadow
	end
	p.Parent = props.Parent
end

function Util.Part(props: PartProps): Part
	local p = Instance.new("Part")
	if props.Shape then
		p.Shape = props.Shape
	end
	apply(p, props)
	return p
end

function Util.Wedge(props: PartProps): WedgePart
	local p = Instance.new("WedgePart")
	apply(p, props)
	return p
end

-- Vertical cylinder (Roblox cylinders run along X; rotate so the axis is world-up).
function Util.Cylinder(
	parent: Instance,
	name: string,
	center: Vector3,
	height: number,
	diameter: number,
	color: Color3,
	material: Enum.Material?,
	decor: boolean?
): Part
	return Util.Part({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material,
		Decor = decor,
		Parent = parent,
	})
end

function Util.Ball(
	parent: Instance,
	name: string,
	center: Vector3,
	diameter: number,
	color: Color3,
	material: Enum.Material?
): Part
	return Util.Part({
		Name = name,
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(diameter, diameter, diameter),
		CFrame = CFrame.new(center),
		Color = color,
		Material = material,
		Decor = true,
		Parent = parent,
	})
end

-- pcall for functions without return values (keeps the strict checker happy). Returns the
-- error message, or nil on success.
function Util.Try(fn: () -> ()): any
	local ok, err = pcall(function(): boolean
		fn()
		return true
	end)
	return if ok then nil else err
end

function Util.Folder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Util.Model(name: string, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Util.Tag(inst: Instance, tag: string)
	CollectionService:AddTag(inst, tag)
end

-- Text label filling a SurfaceGui/Frame. Chunky cartoon style: FredokaOne + dark stroke.
function Util.Label(parent: Instance, text: string, color: Color3, pos: UDim2, size: UDim2, font: Enum.Font?): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = pos
	label.Size = size
	label.Font = font or Theme.Fonts.Title
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextStrokeTransparency = 1
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.Stroke
	stroke.Thickness = 4
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = label
	label.Parent = parent
	return label
end

function Util.SurfaceGui(part: BasePart, face: Enum.NormalId?): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.MaxDistance = 250
	gui.Parent = part
	return gui
end

export type SignOptions = {
	Name: string?,
	BoardColor: Color3?,
	TextColor: Color3?,
	Material: Enum.Material?,
	SubText: string?,
	Decor: boolean?,
}

-- A board Part whose Front face (-Z of `cf`) shows `text`. Returns board and main label.
function Util.Sign(parent: Instance, text: string, size: Vector3, cf: CFrame, opts: SignOptions?): (Part, TextLabel)
	local o: SignOptions = opts or {}
	local board = Util.Part({
		Name = o.Name or "Sign",
		Size = size,
		CFrame = cf,
		Color = o.BoardColor or Theme.Colors.Panel,
		Material = o.Material or Enum.Material.SmoothPlastic,
		Decor = o.Decor,
		CastShadow = true,
		Parent = parent,
	})
	local gui = Util.SurfaceGui(board)
	local mainSize = if o.SubText then UDim2.fromScale(0.9, 0.62) else UDim2.fromScale(0.92, 0.84)
	local label = Util.Label(gui, text, o.TextColor or Theme.Colors.Text, UDim2.fromScale(0.05, 0.06), mainSize)
	if o.SubText then
		local sub = Util.Label(
			gui,
			o.SubText,
			Theme.Colors.Gold,
			UDim2.fromScale(0.08, 0.66),
			UDim2.fromScale(0.84, 0.28),
			Theme.Fonts.Number
		)
		sub.Name = "SubLabel"
	end
	return board, label
end

function Util.Prompt(part: BasePart, actionText: string, objectText: string, distance: number?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Prompt"
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = distance or 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = part
	return prompt
end

-- Make every part in a model anchored; optionally non-colliding & shadowless (small decor).
function Util.Finish(model: Instance, small: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			if small then
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d.CastShadow = false
			end
		end
	end
end

-- Put a model so the bottom of its bounding box rests at the Y of `cf`.
-- Height of the visible ground (smooth terrain or a map part) at `pos`. Smooth terrain's
-- visible surface sits ~2 studs above the 4-stud voxel grid that layout heights are built on,
-- so things placed at the grid height looked sunk (playtest: fountain, towels, egg labels).
-- Only accepts a hit within 4 studs of `pos.Y`; otherwise keeps `pos.Y`.
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = true

function Util.SurfaceY(pos: Vector3, ignore: { Instance }?): number
	groundParams.FilterDescendantsInstances = ignore or {}
	local hit = workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -8, 0), groundParams)
	if hit and math.abs(hit.Position.Y - pos.Y) <= 4 then
		return hit.Position.Y
	end
	return pos.Y
end

-- Height of the visible smooth-terrain surface at `pos` (pos.Y = a layout / voxel-grid height).
-- v2.2 playtest: the fountain and beach towels were STILL sunk after the SurfaceY fix. The map
-- is built in one go right after the terrain is written, and those raycasts can miss terrain
-- written in the same frame, so SurfaceY fell back to the grid height. Here a miss falls back
-- to the grid height + TERRAIN_VISIBLE_OFFSET instead (the same +2 that fixed egg pedestals).
Util.TERRAIN_VISIBLE_OFFSET = Layout.VISIBLE_SURFACE_OFFSET
local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.IgnoreWater = true

function Util.TerrainY(pos: Vector3): number
	terrainParams.FilterDescendantsInstances = { workspace.Terrain }
	local hit = workspace:Raycast(pos + Vector3.new(0, 6, 0), Vector3.new(0, -12, 0), terrainParams)
	if hit and math.abs(hit.Position.Y - pos.Y) <= 6 then
		return hit.Position.Y
	end
	return pos.Y + Util.TERRAIN_VISIBLE_OFFSET
end

function Util.Ground(model: Model, cf: CFrame)
	local groundY = Util.SurfaceY(cf.Position, { model :: Instance })
	cf = cf + Vector3.new(0, groundY - cf.Position.Y, 0)
	model:PivotTo(cf)
	local bbCF, bbSize = model:GetBoundingBox()
	local bottom = bbCF.Position.Y - bbSize.Y / 2
	model:PivotTo(cf + Vector3.new(0, cf.Position.Y - bottom, 0))
end

local SMALL_PROPS: { [string]: boolean } = {
	Crab = true,
	Shell = true,
	BeachBall = true,
	BeachTowel = true,
	Surfboard = true,
}

-- Models.Prop(name) placed on the visible ground at `pos` (Y = layout grid height), rotated `yawDeg`.
-- `onPart` = true: pos.Y is already the top of a part (deck, pier); don't look for the sand.
function Util.Prop(
	name: string,
	parent: Instance,
	pos: Vector3,
	yawDeg: number,
	scale: number?,
	onPart: boolean?
): Model?
	local ok, result = pcall(Models.Prop, name)
	if not ok or typeof(result) ~= "Instance" or not result:IsA("Model") then
		warn("[World] Models.Prop failed for", name, result)
		return nil
	end
	local model = result :: Model
	if scale and scale ~= 1 then
		pcall(function()
			model:ScaleTo(scale)
		end)
	end
	Util.Finish(model, SMALL_PROPS[name] == true)
	local ground = if onPart then pos else Vector3.new(pos.X, Util.TerrainY(pos), pos.Z)
	Util.Ground(model, CFrame.new(ground) * CFrame.Angles(0, math.rad(yawDeg), 0))
	model.Parent = parent
	return model
end

-- Yaw (degrees) that makes a model's -Z (LookVector) face from `from` towards `to`.
function Util.YawTowards(from: Vector3, to: Vector3): number
	local d = to - from
	return math.deg(math.atan2(-d.X, -d.Z))
end

-- Horizontal look CFrame (front = -Z) at `pos` facing `target`.
function Util.Facing(pos: Vector3, target: Vector3): CFrame
	return CFrame.lookAt(pos, Vector3.new(target.X, pos.Y, target.Z))
end

return Util
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">Vistas</string>
            <string name="Source"><![CDATA[--!strict
-- Low-part-count silhouettes outside the playable beach. No collision/query or loot.
local Layout = require(script.Parent.Layout)
local Util = require(script.Parent.Util)

local Vistas = {}
local V, CF = Vector3.new, CFrame.new
local ROCK = Color3.fromRGB(91, 109, 119)
local CREAM = Color3.fromRGB(243, 226, 188)
local CORAL = Color3.fromRGB(208, 85, 69)
local NAVY = Color3.fromRGB(31, 55, 73)

function Vistas.Build(parent: Instance)
	local m = Instance.new("Model")
	m.Name = "CoastalVistas"
	-- A small skyline kit remains visible beyond the streaming radius (roughly 40 parts).
	m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	m.Parent = parent
	local function part(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?)
		return Util.Part({
			Name = name,
			Size = size,
			CFrame = cf,
			Color = color,
			Material = material,
			Decor = true,
			CastShadow = true,
			Parent = m,
		})
	end
	local function cylinder(name: string, pos: Vector3, height: number, diameter: number, color: Color3)
		return Util.Cylinder(m, name, pos, height, diameter, color, Enum.Material.SmoothPlastic, true)
	end
	local function rock(name: string, size: Vector3, cf: CFrame, color: Color3)
		local p = part(name, size, cf, color, Enum.Material.Slate)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	-- Lighthouse on the eastern headland: a warm/cool silhouette visible above the dunes.
	local base = V(458, Layout.SURFACE_Y, 48)
	rock("Headland", V(78, 32, 76), CF(base + V(0, 1, 0)) * CFrame.Angles(0.12, 0.3, -0.08), ROCK)
	for k = 0, 4 do
		cylinder("TowerBand", base + V(0, 19 + k * 7, 0), 7, 19 - k * 1.5, if k % 2 == 0 then CREAM else CORAL)
	end
	cylinder("Gallery", base + V(0, 51, 0), 2, 19, NAVY)
	cylinder("Lantern", base + V(0, 56, 0), 8, 12, Color3.fromRGB(122, 186, 196))
	for k = 0, 7 do
		local a = k * math.pi / 4
		part("LanternFrame", V(0.6, 9, 0.6), CF(base + V(math.cos(a) * 5.7, 56, math.sin(a) * 5.7)), NAVY)
	end
	cylinder("Roof", base + V(0, 61, 0), 2, 16, CORAL)
	cylinder("Finial", base + V(0, 64, 0), 4, 1.4, NAVY)
	-- Offshore stacks frame the pier sightline. Broad silhouettes, no tiny distant details.
	for _, x in { -180, -116 } do
		local p = V(x, Layout.WATER_Y - 9, -310)
		rock("SeaStack", V(38, 65, 38), CF(p) * CFrame.Angles(0.08, x * 0.01, 0.1), ROCK)
		rock(
			"StackShoulder",
			V(25, 36, 32),
			CF(p + V(-12, -5, 4)) * CFrame.Angles(0, 0.3, -0.25),
			ROCK:Lerp(CREAM, 0.12)
		)
	end
	for k = 0, 6 do
		local t = k / 6
		rock(
			"ArchStone",
			V(19, 15, 27),
			CF(-180 + t * 64, Layout.WATER_Y + 18 + math.sin(t * math.pi) * 9, -310),
			ROCK:Lerp(CREAM, k % 2 * 0.08)
		)
	end
end

return Vistas
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="98">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="99">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="100">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="101">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="102">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">ChatLayoutController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ChatLayoutController — keeps Roblox's chat window off the HUD menu.

	The default TextChatService window opens in the top-left corner, exactly where the menu's
	first row (Shop, Beach) sits (UI/Layout "Menu"), so an expanded chat covered Shop in
	playtests. On mouse/keyboard screens the bottom-left corner is free (the bottom bar is
	centred and nothing else lives there), so the window is docked there. Touch screens keep
	Roblox's default: the bottom-left is the thumbstick, and mobile chat stays collapsed
	until the player opens it.
]]
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")

local ChatLayoutController = {}

export type Dock = { Horizontal: Enum.HorizontalAlignment, Vertical: Enum.VerticalAlignment }

-- Where the chat window goes for this device, or nil to keep Roblox's default.
function ChatLayoutController.DockFor(touchEnabled: boolean, keyboardEnabled: boolean): Dock?
	if touchEnabled and not keyboardEnabled then
		return nil
	end
	return { Horizontal = Enum.HorizontalAlignment.Left, Vertical = Enum.VerticalAlignment.Bottom }
end

local function apply(window: ChatWindowConfiguration)
	local dock = ChatLayoutController.DockFor(UserInputService.TouchEnabled, UserInputService.KeyboardEnabled)
	if dock then
		window.HorizontalAlignment = dock.Horizontal
		window.VerticalAlignment = dock.Vertical
	end
end

function ChatLayoutController.Init()
	local window = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
	if window then
		apply(window)
		return
	end
	-- legacy chat or not created yet: pick it up if it appears
	local connection: RBXScriptConnection? = nil
	connection = TextChatService.ChildAdded:Connect(function(child: Instance)
		if child:IsA("ChatWindowConfiguration") then
			apply(child)
			if connection then
				connection:Disconnect()
			end
		end
	end)
end

return ChatLayoutController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">DigController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	DigController — click / tap / hold (or gamepad R2) on terrain to dig.

	- Raycasts from the camera through the pointer, filtered to Workspace.Terrain only.
	- Local pre-checks (reach, inside the dig zone, cooldown, full backpack) avoid pointless
	  remote spam; the server stays authoritative and answers with DigResult.
	- Instant predicted feedback: scoop animation (ShovelPoseController.PlayScoop), layer-coloured
	  sand burst + chunks, dig sound, tiny camera shake.
	- DigResult: "+12 Sand" float text, new-layer banner, contextual hints for failures
	  ("Too hard! Get a better shovel" + guide beam to the ShovelShop, "Backpack full" + beam to
	  the SellZone). The server sends no Notify for dig failures, so each hint shows once.
	- PC/gamepad get a translucent dig cursor ball (green in reach, red out of reach).
	- Auto Dig (pass + "AutoDig" setting) digs straight down under the character.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local State = require(script.Parent.State)
local SoundController = require(script.Parent.SoundController)
local EffectsController = require(script.Parent.EffectsController)
local ShovelPoseController = require(script.Parent.ShovelPoseController)
local LayerController = require(script.Parent.LayerController)
local GuideController = require(script.Parent.GuideController)
local Signal = require(script.Parent.Parent.Util.Signal)
local Character = require(script.Parent.Parent.Util.Character)
local ItemStats = require(script.Parent.Parent.UI.ItemStats)

local DigController = {}

DigController.Dug = Signal.new() -- (DigResult) successful digs
DigController.Feedback = Signal.new() -- (reason: string) "TooHard" | "BackpackFull" | "OutOfZone" | "TooFar" | ...
DigController.Enabled = true -- UI can pause digging (e.g. while a modal is open)

type HoldKind = "Mouse" | "Touch" | "Gamepad"

local player = Players.LocalPlayer
local digRemote: RemoteEvent? = nil
local lastDig = 0
local holdKind: HoldKind? = nil
local holdInput: InputObject? = nil
local touchStart = Vector2.zero
local hintTimes: { [string]: number } = {}
local hintCallback: ((string, string) -> ())? = nil
local cursor: Part? = nil

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = { Workspace.Terrain }
rayParams.IgnoreWater = true

-- UI provides the toast function (keeps this controller free of UI requires).
function DigController.SetHintCallback(fn: (string, string) -> ())
	hintCallback = fn
end

local function hint(key: string, text: string, kind: string, cooldown: number?)
	local now = os.clock()
	if hintTimes[key] and now - hintTimes[key] < (cooldown or 2.5) then
		return
	end
	hintTimes[key] = now
	if hintCallback then
		hintCallback(text, kind)
	end
end

local function insideDigZone(position: Vector3): boolean
	return State.InDigZone(position, 1.5)
end

-- Edge (studs) of the voxel cube the server carves for this shovel radius.
local function digEdge(radius: number): number
	return math.max(1, math.floor(radius / 2 + 0.5)) * 4
end

local function layerAt(position: Vector3): (Types.LayerDef, number)
	local depth = State.SurfaceY() - position.Y
	local index = Config.GetLayerIndexAtDepth(depth)
	return Config.Layers[index], index
end

local function ensureToolEquipped()
	local character = player.Character
	if not character or character:FindFirstChildOfClass("Tool") then
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	local tool = if backpack then backpack:FindFirstChildOfClass("Tool") else nil
	local humanoid = Character.GetHumanoid()
	if tool and humanoid then
		humanoid:EquipTool(tool)
	end
end

-- Scoop animation (ShovelPoseController): plays immediately on the click, no server round trip.
local function swing(color: Color3?)
	ShovelPoseController.PlayScoop(nil, State.GetCooldown(), color)
end

local function getPointer(): (Vector2?, boolean)
	local camera = Workspace.CurrentCamera
	if holdKind == "Touch" then
		local input = holdInput
		if input then
			return Vector2.new(input.Position.X, input.Position.Y), false
		end
		return nil, false
	elseif holdKind == "Gamepad" then
		return camera.ViewportSize / 2, true
	end
	if UserInputService.GamepadEnabled and not UserInputService.MouseEnabled then
		return camera.ViewportSize / 2, true
	end
	return UserInputService:GetMouseLocation(), true
end

local function raycastPointer(pointer: Vector2, viewportSpace: boolean): RaycastResult?
	local camera = Workspace.CurrentCamera
	local ray = if viewportSpace
		then camera:ViewportPointToRay(pointer.X, pointer.Y)
		else camera:ScreenPointToRay(pointer.X, pointer.Y)
	return Workspace:Raycast(ray.Origin, ray.Direction * 300, rayParams)
end

-- Returns true if a dig request was sent.
function DigController.TryDigAt(position: Vector3): boolean
	if not DigController.Enabled then
		return false
	end
	local root = Character.GetRoot()
	if not root or not Character.GetHumanoid() then
		return false
	end
	local now = os.clock()
	if now - lastDig < State.GetCooldown() then
		return false
	end
	if (position - (root :: BasePart).Position).Magnitude > Config.REACH + 1 then
		lastDig = now
		hint("far", "Get closer to dig! 👣", "Info", 3)
		DigController.Feedback:Fire("TooFar")
		return false
	end
	if not insideDigZone(position) then
		lastDig = now
		hint("zone", "Dig on the sand by the water! 🏖️", "Warning", 3)
		DigController.Feedback:Fire("OutOfZone")
		return false
	end
	if State.Loaded and State.Data.Sand >= State.GetCapacity() then
		lastDig = now
		SoundController.Play("DigBlocked", 1.2, 0.6)
		hint("full", "Backpack full! Go SELL your sand 💰", "Warning", 4)
		DigController.Feedback:Fire("BackpackFull")
		return false
	end

	lastDig = now
	ensureToolEquipped()
	local layer = layerAt(position)
	swing(layer.Color)
	if State.GetShovel().Power < layer.Hardness then
		SoundController.Play("DigBlocked", 0.9 + math.random() * 0.2)
		EffectsController.FloatText(position, "Clank! 💢", Config.Theme.Colors.Danger, 0.9)
		EffectsController.Shake(0.25, 0.15)
		EffectsController.Burst(position, Color3.fromRGB(200, 200, 200), 4, 0.6)
	else
		-- better shovels hit harder: deeper thud, more sand and chunks, a touch more shake
		local heft = ItemStats.Heft(State.GetShovel().Id)
		SoundController.Play("Dig", (0.88 + math.random() * 0.24) / heft ^ 0.3, math.min(1.3, heft ^ 0.5))
		EffectsController.Burst(position, layer.Color, math.floor(12 * heft + 0.5))
		EffectsController.Chunks(position, layer.Color, math.floor(3 * heft + 0.5))
		EffectsController.Shake(0.12 * heft ^ 0.5, 0.1)
	end

	local remote = digRemote
	if remote then
		remote:FireServer(position)
	end
	return true
end

local function digAtPointer()
	local pointer, viewportSpace = getPointer()
	if not pointer then
		return
	end
	local result = raycastPointer(pointer :: Vector2, viewportSpace)
	if result then
		DigController.TryDigAt(result.Position)
	end
end

local function onDigResult(result: Types.DigResult)
	if typeof(result) ~= "table" then
		return
	end
	if typeof(result.Capacity) == "number" and result.Capacity > 0 then
		State.ServerCapacity = result.Capacity
	end
	if result.Success then
		local layer = Config.Layers[result.LayerIndex] or layerAt(result.Position)
		local color = Color3.new(1, 1, 1):Lerp(layer.Color, 0.35)
		EffectsController.FloatText(
			result.Position,
			"+" .. Format.Abbreviate(result.SandGained) .. " Sand",
			Config.Theme.Colors.Gold:Lerp(color, 0.2)
		)
		if typeof(result.Sand) == "number" then
			State.Apply({ Sand = result.Sand })
		end
		if result.NewLayer then
			LayerController.AnnounceNewLayer(result.LayerIndex)
			EffectsController.Shake(0.5, 0.35)
		end
		DigController.Dug:Fire(result)
		if result.Capacity and result.Sand >= result.Capacity then
			hint("full", "Backpack full! Go SELL your sand 💰", "Warning", 4)
			DigController.Feedback:Fire("BackpackFull")
		end
		return
	end
	local reason = result.Reason
	if reason == "TooHard" then
		hint("hard", "Too hard! Get a better shovel 🛠️", "Warning", 4)
	elseif reason == "BackpackFull" then
		hint("full", "Backpack full! Go SELL your sand 💰", "Warning", 4)
	elseif reason == "OutOfZone" then
		hint("zone", "Dig on the sand by the water! 🏖️", "Warning", 3)
	elseif reason == "TooFar" then
		hint("far", "Get closer to dig! 👣", "Info", 3)
	elseif reason == "Bottom" then
		hint("bottom", "You reached the bottom of the world! 🌟", "Success", 10)
	end
	if reason then
		DigController.Feedback:Fire(reason)
	end
end

-- Contextual guide beams: full backpack -> sell stand, too hard -> shovel shop.
local function setupGuides()
	DigController.Feedback:Connect(function(reason: string)
		local root = Character.GetRoot()
		local from = if root then root.Position else nil
		if reason == "TooHard" then
			local shop = GuideController.FindTagged("ShovelShop", from)
			if shop then
				GuideController.Set("TooHard", shop, 5, "pickaxe|🛠️", 8)
			end
		elseif reason == "BackpackFull" and not State.CanSellAnywhere() then
			local sell = GuideController.FindTagged("SellZone", from)
			if sell then
				GuideController.Set("SellHint", sell, 4, "Coins")
			end
		end
	end)
	State.Changed("Sand"):Connect(function(sand: number)
		if typeof(sand) == "number" and sand < State.GetCapacity() then
			GuideController.Clear("SellHint")
		end
	end)
	State.Changed("Shovel"):Connect(function()
		GuideController.Clear("TooHard")
	end)
end

local function getCursor(): Part
	if cursor and cursor.Parent then
		return cursor :: Part
	end
	local part = Instance.new("Part")
	part.Name = "DigCursor"
	part.Shape = Enum.PartType.Ball
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Transparency = 0.75
	part.Parent = Workspace
	cursor = part
	return part
end

local function updateCursor()
	local show = DigController.Enabled and (UserInputService.MouseEnabled or UserInputService.GamepadEnabled)
	local root = Character.GetRoot()
	local result: RaycastResult? = nil
	if show and root then
		local pointer, viewportSpace = getPointer()
		if pointer and holdKind ~= "Touch" then
			result = raycastPointer(pointer :: Vector2, viewportSpace)
		end
	end
	if not result or not root then
		if cursor then
			cursor.Transparency = 1
		end
		return
	end
	local hit = result :: RaycastResult
	local part = getCursor()
	local edge = digEdge(State.GetShovel().Radius)
	part.Size = Vector3.new(edge, edge, edge)
	part.Position = hit.Position
	local inReach = ((root :: BasePart).Position - hit.Position).Magnitude <= Config.REACH
		and insideDigZone(hit.Position)
	part.Color = if inReach then Color3.fromRGB(120, 255, 140) else Color3.fromRGB(255, 90, 90)
	part.Transparency = if inReach then 0.78 else 0.88
end

local function autoDig()
	if not (State.OwnsPass("AutoDig") and State.GetSetting("AutoDig", false) == true) then
		return
	end
	local root = Character.GetRoot()
	if not root then
		return
	end
	local origin = (root :: BasePart).Position
	local result = Workspace:Raycast(origin, Vector3.new(0, -14, 0), rayParams)
	if result then
		DigController.TryDigAt(result.Position)
	end
end

function DigController.Init()
	task.spawn(function()
		digRemote = Remotes.Get("Dig")
		Remotes.Get("DigResult").OnClientEvent:Connect(onDigResult)
	end)
	setupGuides()

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			holdKind = "Mouse"
			digAtPointer()
		elseif input.UserInputType == Enum.UserInputType.Touch then
			holdKind = "Touch"
			holdInput = input
			touchStart = Vector2.new(input.Position.X, input.Position.Y)
			digAtPointer()
		elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
			holdKind = "Gamepad"
			digAtPointer()
		end
	end)

	UserInputService.InputChanged:Connect(function(input: InputObject)
		if holdKind == "Touch" and input == holdInput then
			local moved = (Vector2.new(input.Position.X, input.Position.Y) - touchStart).Magnitude
			if moved > 45 then
				-- the finger is dragging the camera, stop digging
				holdKind = nil
				holdInput = nil
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if
			(holdKind == "Mouse" and input.UserInputType == Enum.UserInputType.MouseButton1)
			or (holdKind == "Touch" and input == holdInput)
			or (holdKind == "Gamepad" and input.KeyCode == Enum.KeyCode.ButtonR2)
		then
			holdKind = nil
			holdInput = nil
		end
	end)

	local autoAcc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		if holdKind then
			digAtPointer()
		end
		autoAcc += dt
		if autoAcc >= 0.1 then
			autoAcc = 0
			if not holdKind then
				autoDig()
			end
		end
	end)

	RunService.RenderStepped:Connect(updateCursor)
end

return DigController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">DiscoveryController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	DiscoveryController (v3 discovery slice) — the client half of buried finds. UI-agnostic: the
	detector HUD, the excavation minigame and the reveal presentation subscribe to its signals
	(wired in Main.client). Design: docs/design/Discovery.md.

	Detector
	  DiscoveryController.Scan()           ask the server for a scan (key T / gamepad L2 / HUD button)
	  DiscoveryController.Ping             last Types.DetectorPing (coarse: band / sector / up-down /
	                                       signal colour; the client never learns deposit positions)
	  DiscoveryController.PingChanged      (ping)
	  DiscoveryController.CooldownLeft()   seconds until Scan works again (client mirror)
	  Beeps faster as the band gets hotter (Finds.BeepInterval) while a scan runs, and a
	  world-space arrow (shaft "DetectorArrow" + chevron head) at the character's hip points at
	  the sector in the signal colour; it pulses when the find is in the hot band (not with
	  Reduced Motion). When the find is straight below / above (Ping.Overhead) it stands up in
	  front of the character pointing down / up instead: dig right here.

	Excavation
	  ExcavationStarted (Types.ExcavationInfo) -> UI/ExcavationGame plays the rings
	  DiscoveryController.Excavate(id, errors) answers the server
	  DiscoveryController.FindRevealed (Types.FindInfo) -> UI/FindReveal presents it

	World FX (every client, streaming-safe): models tagged "DiscoveryFind" are watched with
	Util/Tagged (existing + added + removed / streamed out). While Stage = "Excavating" the find
	sits half-buried (the owner's taps nudge it up locally); when Stage turns "Revealed" it rises
	out of the ground with a dust burst, and Beam+ tiers get a coloured light beam (Server and
	Spectacle tiers: a tall sky beam everyone on the server sees). A model that streams in already
	revealed is shown risen, without replaying the animation.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Finds = require(Shared:WaitForChild("Util"):WaitForChild("Finds"))

local State = require(script.Parent.State)
local SoundController = require(script.Parent.SoundController)
local EffectsController = require(script.Parent.EffectsController)
local Signal = require(script.Parent.Parent.Util.Signal)
local Character = require(script.Parent.Parent.Util.Character)
local Tagged = require(script.Parent.Parent.Util.Tagged)

local D = Config.Discovery
local TAG = "DiscoveryFind"

local DiscoveryController = {}

local EMPTY_PING: Types.DetectorPing = { Band = 0, Sector = -1, Vertical = "", Signal = "", Remaining = 0 }

DiscoveryController.Ping = EMPTY_PING
DiscoveryController.PingAt = 0 -- os.clock() when Ping arrived
DiscoveryController.PingChanged = Signal.new() -- (ping)
DiscoveryController.ExcavationStarted = Signal.new() -- (info: Types.ExcavationInfo)
DiscoveryController.FindRevealed = Signal.new() -- (info: Types.FindInfo)
DiscoveryController.Active = nil :: Types.ExcavationInfo?
DiscoveryController.Models = {} :: { [string]: Model } -- FindId -> streamed-in model

local lastScan = -math.huge
local lastBeep = 0
local arrow: Part? = nil
local initialized = false

-- Signal colour of a ping ("" -> white).
function DiscoveryController.SignalColor(signal: string): Color3
	return D.SIGNAL_COLORS[signal] or D.SIGNAL_COLORS.White
end

function DiscoveryController.CooldownLeft(): number
	return math.max(0, D.SCAN_COOLDOWN - (os.clock() - lastScan))
end

-- Seconds of scan left on the latest ping (counts down locally between pings).
function DiscoveryController.ScanLeft(): number
	local ping = DiscoveryController.Ping
	return math.max(0, ping.Remaining - (os.clock() - DiscoveryController.PingAt))
end

function DiscoveryController.IsScanning(): boolean
	return DiscoveryController.ScanLeft() > 0
end

-- Returns true when a scan request was sent.
function DiscoveryController.Scan(): boolean
	if DiscoveryController.CooldownLeft() > 0 then
		return false
	end
	lastScan = os.clock()
	SoundController.Play("DetectorBeep", 0.8)
	Remotes.Get("Scan"):FireServer()
	return true
end

function DiscoveryController.Excavate(id: string, errors: { number })
	if DiscoveryController.Active and DiscoveryController.Active.Id == id then
		DiscoveryController.Active = nil
	end
	Remotes.Get("Excavate"):FireServer(id, errors)
end

-- Direction (world, horizontal unit) of the latest ping, or nil. Nil too when the find is
-- straight below / above (Overhead): its compass sector is noise, the answer is to dig vertically.
function DiscoveryController.PingDirection(): Vector3?
	local ping = DiscoveryController.Ping
	if ping.Band <= 0 or ping.Sector < 0 or ping.Overhead == true then
		return nil
	end
	return Finds.SectorDirection(ping.Sector)
end

-- Screen-relative arrow angle in degrees (0 = straight ahead / up on screen, clockwise), or nil.
function DiscoveryController.ArrowAngle(cameraLook: Vector3?): number?
	local dir = DiscoveryController.PingDirection()
	if not dir then
		return nil
	end
	local look = cameraLook or (Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.LookVector) or Vector3.zAxis
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.zAxis
	end
	flat = flat.Unit
	local d = dir :: Vector3
	local right = Vector3.new(-flat.Z, 0, flat.X) -- camera right on the ground plane
	return math.deg(math.atan2(d:Dot(right), d:Dot(flat)))
end

-- Pings -------------------------------------------------------------------------------------------

local function sanitizePing(raw: any): Types.DetectorPing?
	if type(raw) ~= "table" then
		return nil
	end
	local band = if type(raw.Band) == "number" then math.clamp(math.floor(raw.Band), 0, #D.BANDS + 1) else 0
	return {
		Band = band,
		Sector = if type(raw.Sector) == "number" then math.floor(raw.Sector) else -1,
		Vertical = if type(raw.Vertical) == "string" then raw.Vertical else "",
		Signal = if type(raw.Signal) == "string" then raw.Signal else "",
		Remaining = if type(raw.Remaining) == "number" then math.max(raw.Remaining, 0) else 0,
		Overhead = raw.Overhead == true,
	}
end

function DiscoveryController.ApplyPing(raw: any)
	local maybe = sanitizePing(raw)
	if not maybe then
		return
	end
	local ping = maybe :: Types.DetectorPing
	DiscoveryController.Ping = ping
	DiscoveryController.PingAt = os.clock()
	DiscoveryController.PingChanged:Fire(ping)
end

local arrowHead: { Part } = {}

local function arrowPart(name: string, size: Vector3, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = Enum.PartType.Block
	part.Size = size
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Transparency = 1
	part.Parent = parent
	-- Dark outline: a white (common) signal is otherwise lost on pale sand.
	local outline = Instance.new("SelectionBox")
	outline.Name = "Outline"
	outline.Adornee = part
	outline.Color3 = Color3.fromRGB(29, 42, 68)
	outline.LineThickness = 0.06
	outline.SurfaceTransparency = 1
	outline.Visible = false
	outline.Parent = part
	return part
end

local function setArrowVisible(part: Part, transparency: number, color: Color3)
	part.Transparency = transparency
	part.Color = color
	local outline = part:FindFirstChild("Outline") :: SelectionBox?
	if outline then
		outline.Visible = transparency < 1
	end
end

-- Shaft part (its Color/Transparency are the arrow's) plus two chevron arms as its children.
local function getArrow(): Part
	local current = arrow
	if current and current.Parent then
		return current
	end
	local part = arrowPart("DetectorArrow", Vector3.new(0.7, 0.2, 3), Workspace)
	arrowHead = {
		arrowPart("HeadLeft", Vector3.new(0.7, 0.2, 1.8), part),
		arrowPart("HeadRight", Vector3.new(0.7, 0.2, 1.8), part),
	}
	arrow = part
	return part
end

local function hideArrow()
	if arrow then
		setArrowVisible(arrow, 1, arrow.Color)
	end
	for _, arm in arrowHead do
		setArrowVisible(arm, 1, arm.Color)
	end
end

local function updateWorld()
	local ping = DiscoveryController.Ping
	local scanning = DiscoveryController.IsScanning()
	local dir = DiscoveryController.PingDirection()
	local root = Character.GetRoot()
	-- beeps
	if scanning and ping.Band > 0 then
		local interval = Finds.BeepInterval(ping.Band)
		local now = os.clock()
		if interval > 0 and now - lastBeep >= interval then
			lastBeep = now
			SoundController.Play("DetectorBeep", 1 + (4 - ping.Band) * 0.12, 0.6)
		end
	end
	-- ground arrow: points along the compass sector, or straight down / up in front of the
	-- character when the find is overhead (Ping.Overhead: "dig right here")
	local vertical = scanning and ping.Band > 0 and ping.Overhead == true and ping.Vertical ~= "Level"
	if not scanning or not (dir or vertical) or not root then
		hideArrow()
		return
	end
	local rootPart = root :: BasePart
	local part = getArrow()
	local hot = ping.Band == 1
	local pulse = if hot and State.GetSetting("ReducedMotion", false) ~= true
		then 1 + 0.15 * math.sin(os.clock() * 8)
		else 1
	local color = DiscoveryController.SignalColor(ping.Signal)
	-- Stays clearly visible at every band; colour and size carry the signal, not fading.
	local transparency = 0.1 + (ping.Band - 1) * 0.06
	local d: Vector3
	local base: Vector3
	local axis: Vector3 -- the chevron arms sweep back around this axis
	if vertical then
		d = if ping.Vertical == "Up" then Vector3.yAxis else -Vector3.yAxis
		local forward = Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z)
		forward = if forward.Magnitude > 1e-3 then forward.Unit else Vector3.zAxis
		-- stands in front of the feet, tip toward the ground (or the sky), so it reads "here"
		base = rootPart.Position + forward * 3 + Vector3.new(0, 1.2, 0) - d * 3.2
		axis = forward
	else
		d = dir :: Vector3
		-- hip height, not the feet: in the default over-the-shoulder camera the bottom action
		-- row covers the ground at the character's feet (observed in playtest)
		base = rootPart.Position + Vector3.new(0, 0.4, 0)
		axis = Vector3.yAxis
	end
	-- `axis` is perpendicular to the shaft, so it is a safe up vector for a vertical arrow too
	local up = if vertical then axis else Vector3.yAxis
	part.CFrame = CFrame.lookAt(base + d * 3.6 * pulse, base + d * 6 * pulse, up)
	setArrowVisible(part, transparency, color)
	-- chevron: two arms meeting at the tip, swept back 40 degrees either side
	local tip = base + d * 5.4 * pulse
	for i, arm in arrowHead do
		local sweep = CFrame.fromAxisAngle(axis, math.rad(if i == 1 then 40 else -40)):VectorToWorldSpace(-d)
		local centre = tip + sweep * 0.85
		arm.CFrame = CFrame.lookAt(centre, centre + sweep, up)
		setArrowVisible(arm, transparency, color)
	end
end

-- World FX for tagged find models ---------------------------------------------------------------

local function modelColor(model: Model): Color3
	local rarity = Config.GetRarity(tostring(model:GetAttribute("Rarity") or ""))
	return if rarity then rarity.Color else Color3.new(1, 1, 1)
end

-- Vertical light beam (two attachments + Beam) from the find up into the sky.
local function makeBeam(model: Model, color: Color3, height: number, width: number): Instance?
	local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not root then
		return nil
	end
	local folder = Instance.new("Folder")
	folder.Name = "FindBeam"
	local a0 = Instance.new("Attachment")
	a0.Name = "BeamBottom"
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "BeamTop"
	a1.Position = Vector3.new(0, height, 0)
	a1.Parent = root
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color, Color3.new(1, 1, 1):Lerp(color, 0.5))
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	beam.Width0 = width
	beam.Width1 = width * 0.4
	beam.LightEmission = 0.8
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Segments = 1
	beam.Parent = root
	return beam
end

local function settle(model: Model, base: CFrame, rise: number, animate: boolean)
	local target = base + Vector3.new(0, rise, 0)
	if not animate then
		model:PivotTo(target)
		return
	end
	local start = model:GetPivot()
	local value = Instance.new("NumberValue")
	value.Value = 0
	value.Changed:Connect(function()
		local alpha = value.Value
		if model.Parent then
			model:PivotTo(start:Lerp(target, alpha) * CFrame.Angles(0, alpha * math.pi * 2, 0))
		end
	end)
	local tween = TweenService:Create(value, TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Value = 1,
	})
	tween.Completed:Once(function()
		value:Destroy()
	end)
	tween:Play()
end

local function onRevealed(model: Model, base: CFrame, animate: boolean)
	local tier = tostring(model:GetAttribute("Tier") or "Pop")
	local order = Finds.TierOrder(tier)
	local color = modelColor(model)
	local rise = model:GetAttribute("Rise")
	local riseBy = if type(rise) == "number" then rise else 1.5
	local pos = base.Position + Vector3.new(0, riseBy, 0)
	settle(model, base, riseBy, animate)
	if animate then
		EffectsController.Burst(pos, Color3.fromRGB(230, 200, 150), 18 + order * 6, 1 + order * 0.2)
		EffectsController.Chunks(pos, Color3.fromRGB(220, 190, 140), 4 + order)
		SoundController.Play("FindEmerge", 1)
	end
	if order >= Finds.TierOrder("Beam") then
		local server = order >= Finds.TierOrder("Server")
		makeBeam(model, color, if server then 400 else 18, if server then 6 else 2.5)
	end
end

local function watchModel(inst: Instance): Tagged.Cleanup?
	if not inst:IsA("Model") then
		return nil
	end
	local model = inst :: Model
	local id = tostring(model:GetAttribute("FindId") or "")
	if id ~= "" then
		DiscoveryController.Models[id] = model
	end
	local base = model:GetPivot() -- the server's half-buried pivot (owner nudges are local)
	local revealed = false
	local connection: RBXScriptConnection? = nil
	if model:GetAttribute("Stage") == "Revealed" then
		revealed = true
		onRevealed(model, base, false)
	else
		connection = model:GetAttributeChangedSignal("Stage"):Connect(function()
			if not revealed and model:GetAttribute("Stage") == "Revealed" then
				revealed = true
				onRevealed(model, base, true)
			end
		end)
	end
	return function()
		if connection then
			connection:Disconnect()
		end
		if id ~= "" and DiscoveryController.Models[id] == model then
			DiscoveryController.Models[id] = nil
		end
	end
end

-- Owner feedback during the minigame: nudge the (local copy of the) model up a little per hit.
function DiscoveryController.Nudge(id: string, amount: number)
	local model = DiscoveryController.Models[id]
	if model and model.Parent and model:GetAttribute("Stage") ~= "Revealed" then
		model:PivotTo(model:GetPivot() + Vector3.new(0, math.clamp(amount, 0, 0.5), 0))
		EffectsController.Burst(model:GetPivot().Position, Color3.fromRGB(230, 200, 150), 6, 0.7)
	end
end

-- Lifecycle ----------------------------------------------------------------------------------------

local function onExcavationStart(raw: any)
	if type(raw) ~= "table" or type(raw.Id) ~= "string" then
		return
	end
	local info = raw :: Types.ExcavationInfo
	DiscoveryController.Active = info
	if typeof(info.Position) == "Vector3" then
		EffectsController.Burst(info.Position, Color3.fromRGB(230, 200, 150), 14, 1)
		EffectsController.Shake(0.3, 0.2)
	end
	SoundController.Play("RareTreasure", 1.4, 0.7)
	DiscoveryController.ExcavationStarted:Fire(info)
end

local function onFindRevealed(raw: any)
	if type(raw) ~= "table" or type(raw.TreasureId) ~= "string" then
		return
	end
	local info = raw :: Types.FindInfo
	if DiscoveryController.Active and DiscoveryController.Active.Id == info.Id then
		DiscoveryController.Active = nil
	end
	DiscoveryController.FindRevealed:Fire(info)
end

function DiscoveryController.Init()
	if initialized then
		return
	end
	initialized = true
	task.spawn(function()
		Remotes.Get("DetectorPing").OnClientEvent:Connect(DiscoveryController.ApplyPing)
		Remotes.Get("ExcavationStart").OnClientEvent:Connect(onExcavationStart)
		Remotes.Get("FindRevealed").OnClientEvent:Connect(onFindRevealed)
	end)
	Tagged.Watch(TAG, watchModel)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or DiscoveryController.Active then
			return
		end
		if input.KeyCode == Enum.KeyCode.T or input.KeyCode == Enum.KeyCode.ButtonL2 then -- F = place shade, Y = menu focus
			DiscoveryController.Scan()
		end
	end)
	RunService.Heartbeat:Connect(function()
		if State.Loaded then
			updateWorld()
		end
	end)
	Players.LocalPlayer.CharacterRemoving:Connect(hideArrow)
end

return DiscoveryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	EffectsController — world-space juice: layer-coloured sand bursts, flying sand chunks,
	floating "+12 Sand" billboards and a small camera shake. All instances are client-only
	and cleaned up with Debris. LowGraphics setting trims particle counts and skips chunks.
]]
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)

local EffectsController = {}

local PARTICLE_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"

local shakeIntensity = 0
local shakeUntil = 0
local shakeDuration = 0.001
local effectsFolder: Folder? = nil

local function lowGraphics(): boolean
	return State.GetSetting("LowGraphics", false) == true
end

local function getFolder(): Folder
	if not effectsFolder or not effectsFolder.Parent then
		local folder = Instance.new("Folder")
		folder.Name = "ClientEffects"
		folder.Parent = Workspace
		effectsFolder = folder
	end
	return effectsFolder :: Folder
end

local function anchorAttachment(position: Vector3, lifetime: number): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = "FX"
	attachment.WorldPosition = position
	attachment.Parent = Workspace.Terrain
	attachment.WorldPosition = position
	Debris:AddItem(attachment, lifetime)
	return attachment
end

-- Sand puff in the colour of the layer that was dug.
function EffectsController.Burst(position: Vector3, color: Color3, count: number?, size: number?)
	local amount = count or 14
	if lowGraphics() then
		amount = math.max(3, math.floor(amount / 3))
	end
	local attachment = anchorAttachment(position, 2)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = PARTICLE_TEXTURE
	emitter.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.25))
	local s = size or 1
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.9 * s),
		NumberSequenceKeypoint.new(0.4, 1.3 * s),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(0.7, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(0.45, 0.85)
	emitter.Speed = NumberRange.new(9, 16)
	emitter.SpreadAngle = Vector2.new(55, 55)
	emitter.Acceleration = Vector3.new(0, -35, 0)
	emitter.Drag = 2.5
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.RotSpeed = NumberRange.new(-120, 120)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.LightEmission = 0.1
	emitter.Rate = 0
	emitter.Parent = attachment
	emitter:Emit(amount)
end

-- Little cubes of sand flung out of the hole (pure client physics, no collisions with players).
function EffectsController.Chunks(position: Vector3, color: Color3, count: number?)
	if lowGraphics() then
		return
	end
	local folder = getFolder()
	for _ = 1, count or 4 do
		local part = Instance.new("Part")
		part.Name = "SandChunk"
		local size = 0.35 + math.random() * 0.4
		part.Size = Vector3.new(size, size, size)
		part.Color = color:Lerp(Color3.new(0, 0, 0), math.random() * 0.15)
		part.Material = Enum.Material.SmoothPlastic
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0))
			* CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		part.Parent = folder
		local angle = math.random() * math.pi * 2
		part.AssemblyLinearVelocity = Vector3.new(math.cos(angle) * 9, 18 + math.random() * 10, math.sin(angle) * 9)
		part.AssemblyAngularVelocity = Vector3.new(math.random() * 10, math.random() * 10, math.random() * 10)
		TweenService:Create(part, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.2), {
			Size = Vector3.new(0.05, 0.05, 0.05),
		}):Play()
		Debris:AddItem(part, 1)
	end
end

-- Floating billboard text that rises and fades ("+12 Sand", "Too hard!").
function EffectsController.FloatText(position: Vector3, text: string, color: Color3, scale: number?)
	local attachment = anchorAttachment(position, 2)
	local s = scale or 1
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(5 * s, 1.6 * s)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 1.5, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 120
	billboard.Adornee = attachment
	billboard.Parent = attachment

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.fromRGB(35, 30, 60)
	label.TextStrokeTransparency = 0
	label.Parent = billboard
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(35, 30, 60)
	stroke.Parent = label

	local pop = Instance.new("UIScale")
	pop.Scale = 0.3
	pop.Parent = label
	TweenService:Create(pop, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	local drift = Vector3.new((math.random() - 0.5) * 1.5, 4.5, 0)
	TweenService:Create(
		billboard,
		TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ StudsOffsetWorldSpace = billboard.StudsOffsetWorldSpace + drift }
	):Play()
	TweenService:Create(
		label,
		TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.75),
		{ TextTransparency = 1, TextStrokeTransparency = 1 }
	):Play()
	TweenService:Create(stroke, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.75), {
		Transparency = 1,
	}):Play()
end

-- Small, decaying camera shake (stacks by taking the max intensity).
function EffectsController.Shake(intensity: number, duration: number)
	if State.GetSetting("ReducedMotion", false) == true then
		return
	end
	local now = os.clock()
	if now > shakeUntil then
		shakeIntensity = 0
	end
	shakeIntensity = math.max(shakeIntensity, intensity)
	shakeDuration = math.max(duration, 0.001)
	shakeUntil = math.max(shakeUntil, now + duration)
end

function EffectsController.Init()
	RunService:BindToRenderStep("DigCameraShake", Enum.RenderPriority.Camera.Value + 1, function()
		if State.GetSetting("ReducedMotion", false) == true then
			shakeIntensity = 0
			return
		end
		local now = os.clock()
		if now >= shakeUntil or shakeIntensity <= 0 then
			return
		end
		local camera = Workspace.CurrentCamera
		if camera then
			local fade = math.clamp((shakeUntil - now) / shakeDuration, 0, 1)
			local mag = shakeIntensity * fade
			local offset = Vector3.new((math.random() - 0.5) * mag, (math.random() - 0.5) * mag, 0)
			camera.CFrame = camera.CFrame
				* CFrame.new(offset)
				* CFrame.Angles(0, 0, math.rad((math.random() - 0.5) * mag * 4))
		end
	end)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">GuideController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	GuideController — one glowing Beam from the character to a world target plus a bouncing
	billboard marker over it. Several systems can request a guide (tutorial, "backpack full",
	"too hard"); the highest priority request wins.

		Guide.Set("Tutorial", target, 10, "Arrow")   -- target: BasePart | Vector3 | TagTarget | nil
		Guide.Clear("Tutorial")

	v2.3 streaming: stations far away are not on the client. FindTagged(tag) returns a TagTarget
	({ Tag = tag }) that is resolved EVERY FRAME: the nearest streamed-in part with the tag if
	there is one, else the nearest server-published anchor position (Util/Anchors). So a beam
	from the bottom of a hole to the sell stand still points the right way, and it locks onto the
	real part as soon as it streams in (a new instance after every stream-out). A BasePart target
	that streams out falls back to its last known position.

	Off-screen: when the target is outside the camera view (or behind it) an arrow badge pinned
	to the screen edge points the way, carrying the same marker icon. Markers are icon keys for
	AtlasIcon ("Coins", "Arrow", "pickaxe|🛠️"), never emoji in a TextScaled label.
	TurnCameraToward(target) is an onboarding-only nudge (the tutorial calls it): one smooth
	camera swing around the character when the target is far off-screen.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Character = require(script.Parent.Parent.Util.Character)
local Tagged = require(script.Parent.Parent.Util.Tagged)
local Anchors = require(script.Parent.Parent.Util.Anchors)
local State = require(script.Parent.State)
local AtlasIcon = require(script.Parent.Parent.UI.Components.AtlasIcon)
local Root = require(script.Parent.Parent.UI.Root)

local GuideController = {}

export type TagTarget = { Tag: string }
export type Target = BasePart | Vector3 | TagTarget

type Request = { Target: Target, Priority: number, Marker: string, Expires: number?, LastPosition: Vector3? }

local requests: { [string]: Request } = {}
local beam: Beam? = nil
local fromAttachment: Attachment? = nil
local toAttachment: Attachment? = nil
local marker: BillboardGui? = nil
local markerIcon: AtlasIcon.AtlasIcon? = nil
local activeKey: string? = nil

-- Screen-edge indicator (own ScreenGui: IgnoreGuiInset so it shares the camera's viewport space).
local EDGE_SIZE = 64 -- design px, scaled with the HUD
local EDGE_MARGIN = 56 -- design px kept clear of the screen edge
local edgeGui: ScreenGui? = nil
local edgeFrame: Frame? = nil
local edgeArrow: Frame? = nil
local edgeIcon: AtlasIcon.AtlasIcon? = nil

local function partTop(part: BasePart): Vector3
	return part.Position + Vector3.new(0, part.Size.Y / 2, 0)
end

-- World position of a target right now (nil = nothing known). `from` picks the nearest of many.
function GuideController.Resolve(target: Target, from: Vector3?): Vector3?
	if typeof(target) == "Vector3" then
		return target
	end
	if typeof(target) == "Instance" then
		local part = target :: BasePart
		return if part:IsDescendantOf(Workspace) then partTop(part) else nil
	end
	local tag = (target :: TagTarget).Tag
	local part = Tagged.Nearest(tag, from)
	local anchor = Anchors.Nearest(tag, from)
	if part and anchor and from then
		-- a nearer station may exist that has not streamed in: prefer the nearer of the two
		local top = partTop(part)
		return if (anchor - from).Magnitude + 1 < (top - from).Magnitude then anchor else top
	end
	return if part then partTop(part) else anchor
end

-- A guide target for the nearest station carrying `tag` (streamed in or not), or nil when the
-- tag exists nowhere (no streamed part and no published anchor).
function GuideController.FindTagged(tag: string, from: Vector3?): Target?
	if Tagged.Nearest(tag, from) or Anchors.Nearest(tag, from) then
		return { Tag = tag } :: TagTarget
	end
	return nil
end

local function ensureVisuals()
	if beam and beam.Parent then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "GuideFrom"
	local a1 = Instance.new("Attachment")
	a1.Name = "GuideTo"
	a1.Parent = Workspace.Terrain
	local b = Instance.new("Beam")
	b.Name = "GuideBeam"
	b.Attachment0 = a0
	b.Attachment1 = a1
	b.FaceCamera = true
	b.Width0 = 1.2
	b.Width1 = 1.2
	b.LightEmission = 0.6
	b.LightInfluence = 0
	b.Segments = 20
	b.CurveSize0 = 0
	b.CurveSize1 = 0
	b.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	b.TextureMode = Enum.TextureMode.Wrap
	b.TextureLength = 3
	b.TextureSpeed = 2
	b.Color = ColorSequence.new(Color3.fromRGB(255, 225, 60), Color3.fromRGB(255, 95, 125))
	b.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(0.15, 0.1),
		NumberSequenceKeypoint.new(1, 0.1),
	})
	b.Parent = Workspace.Terrain

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GuideMarker"
	billboard.Size = UDim2.fromOffset(90, 90)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	billboard.Adornee = a1
	billboard.Parent = a1
	local icon = AtlasIcon.new({ Icon = "Arrow", Name = "MarkerIcon", Parent = billboard })

	beam = b
	fromAttachment = a0
	toAttachment = a1
	marker = billboard
	markerIcon = icon
end

local function ensureEdge(): Frame?
	if edgeFrame and edgeGui and edgeGui.Parent then
		return edgeFrame
	end
	local playerGui = Players.LocalPlayer and Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return nil
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "Dig_GuideEdge"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 2 -- above the HUD, below panels and popups

	local frame = Instance.new("Frame")
	frame.Name = "EdgeArrow"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundColor3 = Color3.fromRGB(29, 42, 68)
	frame.BackgroundTransparency = 0.15
	frame.Visible = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 205, 40)
	stroke.Thickness = 3
	stroke.Parent = frame
	frame.Parent = gui

	edgeIcon =
		AtlasIcon.new({ Icon = "Arrow", Name = "MarkerIcon", Size = UDim2.fromScale(0.62, 0.62), Parent = frame })
	-- The pointer sits outside the badge on the side of the target; Rotation 0 = pointing down.
	edgeArrow = AtlasIcon.new({
		Icon = "Arrow",
		Name = "Pointer",
		Size = UDim2.fromScale(0.55, 0.55),
		ZIndex = 2,
		Parent = frame,
	}).Frame

	gui.Parent = playerGui
	edgeGui = gui
	edgeFrame = frame
	return frame
end

--[[
	Where the edge indicator goes. `rel` is the target in camera space (camera looks down -Z),
	`point` its WorldToViewportPoint result and `size` the viewport. Returns onScreen, the
	indicator centre (viewport px, inset by `margin` from every edge) and its rotation in degrees
	(0 = pointing down the screen). Behind the camera the projected point is meaningless, so the
	camera-space direction is used instead (behind and to the right -> arrow on the right).
]]
function GuideController.EdgePlacement(
	rel: Vector3,
	point: Vector3,
	size: Vector2,
	margin: number
): (boolean, Vector2, number)
	local inFront = rel.Z < 0
	if inFront and point.X >= 0 and point.X <= size.X and point.Y >= 0 and point.Y <= size.Y then
		return true, Vector2.new(point.X, point.Y), 0
	end
	local centre = size / 2
	local direction = if inFront then Vector2.new(point.X, point.Y) - centre else Vector2.new(rel.X, -rel.Y)
	if direction.Magnitude < 1e-3 then
		direction = Vector2.new(0, 1) -- straight behind: point down, "turn around"
	end
	local halfX = math.max(centre.X - margin, 1)
	local halfY = math.max(centre.Y - margin, 1)
	local scaleX = if math.abs(direction.X) > 1e-6 then halfX / math.abs(direction.X) else math.huge
	local scaleY = if math.abs(direction.Y) > 1e-6 then halfY / math.abs(direction.Y) else math.huge
	local position = centre + direction * math.min(scaleX, scaleY)
	local rotation = math.deg(math.atan2(direction.Y, direction.X)) - 90
	return false, position, rotation
end

--[[
	Signed horizontal angle (degrees) from the camera's flat look direction to `target` seen
	from `focus`; positive turns right (clockwise from above). nil when either is degenerate.
]]
function GuideController.YawToward(look: Vector3, focus: Vector3, target: Vector3): number?
	local flatLook = Vector3.new(look.X, 0, look.Z)
	local flatTarget = Vector3.new(target.X - focus.X, 0, target.Z - focus.Z)
	if flatLook.Magnitude < 1e-3 or flatTarget.Magnitude < 1 then
		return nil
	end
	local a, b = flatLook.Unit, flatTarget.Unit
	local cross = a.X * b.Z - a.Z * b.X -- > 0: target is to the right (camera right = look x up)
	return math.deg(math.atan2(cross, a:Dot(b)))
end

local TURN_MIN_DEGREES = 60 -- roughly on screen already: leave the camera alone
local TURN_SECONDS = 0.7
local turning = false

--[[
	Onboarding helper: when `target` is well off-screen, swing the default (Custom) camera around
	the character to face it once, so a full bucket does not leave a newcomer looking at the sea
	with the sell stand behind them. Composes with the player's own camera input (small per-frame
	yaw steps) and is instant with Reduced Motion. Returns true when a turn started.
]]
function GuideController.TurnCameraToward(target: Target): boolean
	local camera = Workspace.CurrentCamera
	local root = Character.GetRoot()
	if turning or not camera or not root or camera.CameraType ~= Enum.CameraType.Custom then
		return false
	end
	local position = GuideController.Resolve(target, root.Position)
	if not position then
		return false
	end
	local focus = root.Position
	local maybeYaw = GuideController.YawToward(camera.CFrame.LookVector, focus, position)
	if not maybeYaw or math.abs(maybeYaw) < TURN_MIN_DEGREES then
		return false
	end
	local yaw = maybeYaw :: number
	local function rotate(degrees: number)
		local cam = Workspace.CurrentCamera
		local maybeRoot = Character.GetRoot()
		if not cam or not maybeRoot then
			return
		end
		local pivot = maybeRoot.Position
		-- a positive yaw turns right = clockwise from above = negative rotation about +Y
		cam.CFrame = CFrame.new(pivot) * CFrame.Angles(0, -math.rad(degrees), 0) * CFrame.new(-pivot) * cam.CFrame
	end
	if State.GetSetting("ReducedMotion", false) == true then
		rotate(yaw)
		return true
	end
	turning = true
	local total = yaw
	local progress = 0
	local applied = 0
	local connection: RBXScriptConnection? = nil
	connection = RunService.RenderStepped:Connect(function(dt: number)
		progress = math.min(progress + dt / TURN_SECONDS, 1)
		local eased = 1 - (1 - progress) ^ 2 -- ease out
		rotate(total * eased - applied)
		applied = total * eased
		if progress >= 1 then
			turning = false
			if connection then
				connection:Disconnect()
			end
		end
	end)
	return true
end

local function hideEdge()
	if edgeFrame then
		edgeFrame.Visible = false
	end
end

local function updateEdge(position: Vector3, request: Request, t: number, reducedMotion: boolean)
	local camera = Workspace.CurrentCamera
	if not camera then
		hideEdge()
		return
	end
	local frame = ensureEdge()
	if not frame then
		return
	end
	local size = camera.ViewportSize
	local scale = if Root.Scale and Root.Scale > 0 then Root.Scale else 1
	local rel = camera.CFrame:PointToObjectSpace(position)
	local point = camera:WorldToViewportPoint(position)
	local onScreen, at, rotation = GuideController.EdgePlacement(rel, point, size, EDGE_MARGIN * scale)
	if onScreen then
		frame.Visible = false
		return
	end
	local pulse = if reducedMotion then 1 else 1 + 0.08 * math.sin(t * 5)
	local px = EDGE_SIZE * scale * pulse
	frame.Size = UDim2.fromOffset(px, px)
	frame.Position = UDim2.fromOffset(at.X, at.Y)
	frame.Visible = true
	if edgeIcon and edgeIcon.Key ~= request.Marker then
		edgeIcon:Set(request.Marker)
	end
	if edgeArrow then
		local angle = math.rad(rotation + 90)
		local offset = Vector2.new(math.cos(angle), math.sin(angle)) * 0.62
		edgeArrow.Position = UDim2.fromScale(0.5 + offset.X, 0.5 + offset.Y)
		edgeArrow.Rotation = rotation
	end
end

local function setVisible(visible: boolean)
	if beam then
		beam.Enabled = visible
	end
	if marker then
		marker.Enabled = visible
	end
end

local function pickActive(): (string?, Request?)
	local bestKey: string? = nil
	local best: Request? = nil
	local now = os.clock()
	for key, request in requests do
		if request.Expires and now > request.Expires then
			requests[key] = nil
		elseif not best or request.Priority > (best :: Request).Priority then
			best = request
			bestKey = key
		end
	end
	return bestKey, best
end

function GuideController.Set(key: string, target: Target?, priority: number?, markerText: string?, seconds: number?)
	if target == nil then
		requests[key] = nil
		return
	end
	requests[key] = {
		Target = target :: Target,
		Priority = priority or 0,
		Marker = markerText or "Arrow",
		Expires = if seconds then os.clock() + seconds else nil,
	}
end

function GuideController.Clear(key: string)
	requests[key] = nil
end

function GuideController.Init()
	local t = 0
	RunService.Heartbeat:Connect(function(dt: number)
		t += dt
		local key, found = pickActive()
		local maybeRoot = Character.GetRoot()
		local maybePosition: Vector3? = nil
		if found then
			maybePosition = GuideController.Resolve(found.Target, if maybeRoot then maybeRoot.Position else nil)
				or found.LastPosition -- a part target streamed out: keep its last known spot
			found.LastPosition = maybePosition
		end
		if not (found and maybeRoot and maybePosition) then
			setVisible(false)
			hideEdge()
			activeKey = nil
			return
		end
		local request = found :: Request
		local root = maybeRoot :: BasePart
		local position = maybePosition :: Vector3
		ensureVisuals()
		setVisible(true)
		local current = fromAttachment
		if current and current.Parent ~= root then
			-- The old one was destroyed with the previous character (its Parent is locked):
			-- give the beam a fresh attachment on the new root.
			current:Destroy()
			local a0 = Instance.new("Attachment")
			a0.Name = "GuideFrom"
			a0.Position = Vector3.new(0, -1.5, 0)
			a0.Parent = root
			fromAttachment = a0
			if beam then
				beam.Attachment0 = a0
			end
		end
		if toAttachment then
			toAttachment.WorldPosition = position
		end
		if markerIcon and key ~= activeKey then
			markerIcon:Set(request.Marker)
		end
		activeKey = key
		local reducedMotion = State.GetSetting("ReducedMotion", false) == true
		if marker then
			local bounce = if reducedMotion then 0 else math.abs(math.sin(t * 4)) * 1.5
			marker.StudsOffsetWorldSpace = Vector3.new(0, 4 + bounce, 0)
		end
		-- At the target the objective is enough; the billboard otherwise covers
		-- the player's head/tool in the normal over-the-shoulder spawn camera.
		local away = (root.Position - position).Magnitude > 8
		if marker then
			marker.Enabled = away
		end
		if beam then
			beam.TextureSpeed = if reducedMotion then 0 else 2
			beam.Enabled = away
		end
		if away then
			updateEdge(position, request, t, reducedMotion)
		else
			hideEdge()
		end
	end)
end

return GuideController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict
-- InputController — console/PC shortcuts. Gamepad: R2 dig (DigController), X = Surface,
-- Y = jump into the HUD menu with selection (B closes panels, see Panel). Keyboard: Q = Surface,
-- G = Shop, P = Pets.
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local SoundController = require(script.Parent.SoundController)
local HUD = require(script.Parent.Parent.UI.HUD)
local Panel = require(script.Parent.Parent.UI.Components.Panel)

local InputController = {}

local function onBegin(fn: () -> ()): (string, Enum.UserInputState, InputObject) -> Enum.ContextActionResult
	return function(_, state: Enum.UserInputState, _): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			fn()
		end
		return Enum.ContextActionResult.Sink
	end
end

function InputController.Init()
	ContextActionService:BindAction(
		"DigSurface",
		onBegin(function()
			SoundController.Play("Teleport")
			Remotes.Get("ReturnToSurface"):FireServer()
		end),
		false,
		Enum.KeyCode.ButtonX,
		Enum.KeyCode.Q
	)
	ContextActionService:BindAction(
		"DigMenu",
		onBegin(function()
			if GuiService.SelectedObject then
				GuiService.SelectedObject = nil
				return
			end
			local first = HUD.FirstMenuButton() -- the menu unlocks progressively
			if first then
				GuiService.SelectedObject = first.Face
			end
		end),
		false,
		Enum.KeyCode.ButtonY
	)
	ContextActionService:BindAction(
		"DigShortcutShop",
		onBegin(function()
			Panel.Toggle("Shop")
		end),
		false,
		Enum.KeyCode.G
	)
	ContextActionService:BindAction(
		"DigShortcutPets",
		onBegin(function()
			Panel.Toggle("Pets")
		end),
		false,
		Enum.KeyCode.P
	)
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">LayerController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	LayerController — tracks how deep the local character is (studs below the beach surface),
	fires DepthChanged / LayerEntered, shows the layer-enter banner and tints the world toward
	the layer's AmbientColor while underground via our OWN client-side ColorCorrectionEffect
	"DepthTint" in Lighting. The server owns WorldAtmosphere/WorldColorCorrection/WorldBloom
	(Golden Hour / High Tide) and Lighting properties, so we never touch those. Swaps music.
]]
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local State = require(script.Parent.State)
local SoundController = require(script.Parent.SoundController)
local Signal = require(script.Parent.Parent.Util.Signal)
local Character = require(script.Parent.Parent.Util.Character)

local LayerController = {}

LayerController.Depth = 0
LayerController.LayerIndex = 1
LayerController.DepthChanged = Signal.new() -- (depth, layerIndex)
LayerController.LayerEntered = Signal.new() -- (layerIndex, isNew)

local UPDATE_INTERVAL = 0.15
local BANNER_COOLDOWN = 12 -- don't re-announce the same layer within this many seconds
local FULL_TINT_DEPTH = 14 -- studs underground at which the tint reaches full strength

local colorCorrection: ColorCorrectionEffect? = nil
local lastTintKey = ""
local lastAnnounced: { [number]: number } = {}
local newLayerShown: { [number]: boolean } = {}
local bannerCallback: ((number, boolean) -> ())? = nil

-- UI registers how to show the banner (keeps Controllers free of UI requires).
function LayerController.SetBannerCallback(fn: (number, boolean) -> ())
	bannerCallback = fn
end

local function getColorCorrection(): ColorCorrectionEffect
	if colorCorrection and colorCorrection.Parent then
		return colorCorrection
	end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "DepthTint"
	cc.Parent = Lighting
	colorCorrection = cc
	return cc
end

local function applyTint(depth: number, layerIndex: number)
	local strength = math.clamp((depth - 2) / FULL_TINT_DEPTH, 0, 1)
	local key = layerIndex .. ":" .. math.floor(strength * 8)
	if key == lastTintKey then
		return
	end
	lastTintKey = key
	local layer = Config.Layers[layerIndex]
	local info = TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local cc = getColorCorrection()
	local tint = Color3.new(1, 1, 1):Lerp(layer.AmbientColor, 0.55 * strength)
	TweenService:Create(cc, info, {
		TintColor = tint,
		Saturation = 0.08 * strength,
		Contrast = 0.06 * strength,
		Brightness = -0.05 * strength,
	}):Play()
	SoundController.SetMusic(if depth > 20 then "MusicDeep" else "MusicBeach")
	SoundController.SetAmbience(depth <= 20)
end

-- Called by DigController when the server says this dig reached a never-seen layer.
function LayerController.AnnounceNewLayer(layerIndex: number)
	if newLayerShown[layerIndex] then
		return
	end
	newLayerShown[layerIndex] = true
	lastAnnounced[layerIndex] = os.clock()
	LayerController.LayerEntered:Fire(layerIndex, true)
	if bannerCallback then
		bannerCallback(layerIndex, true)
	end
end

local function update()
	local root = Character.GetRoot()
	if not root then
		return
	end
	local feetY = (root :: BasePart).Position.Y - 3
	local depth = math.max(0, State.SurfaceY() - feetY)
	-- Like the server (BeachService), depth only counts inside the dig zone: the beach slopes
	-- down to the ocean, which must not read as "underground". Unknown zone -> 0 as well.
	local cf = State.GetDigZone()
	if not cf or not State.InDigZone((root :: BasePart).Position, 2) then
		depth = 0
	end
	local index = Config.GetLayerIndexAtDepth(depth)
	local changed = math.abs(depth - LayerController.Depth) > 0.05 or index ~= LayerController.LayerIndex
	local previous = LayerController.LayerIndex
	LayerController.Depth = depth
	LayerController.LayerIndex = index
	if changed then
		LayerController.DepthChanged:Fire(depth, index)
	end
	if index ~= previous and depth > 1 then
		local last = lastAnnounced[index]
		if not last or os.clock() - last > BANNER_COOLDOWN then
			lastAnnounced[index] = os.clock()
			LayerController.LayerEntered:Fire(index, false)
			if bannerCallback and index > 1 then
				bannerCallback(index, false)
			end
		end
	end
	applyTint(depth, index)
end

function LayerController.Init()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc >= UPDATE_INTERVAL then
			acc = 0
			update()
		end
	end)
end

return LayerController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">PetFollowController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	PetFollowController — renders equipped pets for ALL players, client-side only, and plays the
	dig animation of digging pets (v2.1 companions: vehicle pets from Construction Crates and a few
	creatures; docs/design/Companions.md).

	Source of truth per player: Player attribute "EquippedPets" (comma-separated PetDef ids, sorted),
	set by PetService. For the local player we fall back to PlayerData.Pets (Equipped = true)
	whenever the attribute is missing, so our own pets show even if the server never sets it.

	Following:
	  - Creature pets trail behind the character in a little arc, bob up and down (flyers float
	    higher), smoothly lerp toward their slot and face where the owner is heading.
	  - Vehicle pets (PetDef.VehicleKind, Models/Diggers at pet scale) drive in a row behind the
	    creatures, snapped to the ground under them, with a little engine bob. Behind the owner
	    is solid wall (deep hole) or a big drop: they tuck in close at the owner's level.
	Digging (PetDug(player, slot, petId, position, sandGained) from PetDigService):
	  - The pet DRIVES / WALKS smoothly to its spot (never teleports): it parks PARK_DISTANCE
	    beyond the dig point on the side away from the owner, faces the hole and plays the dig
	    animation (vehicles: their "Motion" sub-Models — arm swing, bed tip, drill spin/plunge, see
	    Models/Diggers; creatures: a scooping hop). A layer-coloured burst pops at the point; the
	    owner also sees "+N", sand chunks and a soft dig sound.
	  - Between digs it stays parked at its spot while the owner stays put (PARK_HOLD seconds after
	    the last dig, cancelled as soon as the owner walks OWNER_LEAVE studs away), then follows.
	Far-away players' pets are hidden; LowGraphics hides other players' pets entirely.
	v2.2: Player attribute "EquippedGolden" (comma-separated 1-based slots in "EquippedPets") marks
	Golden pets; they render gold-tinted with sparkles (ModelFactory.MakeGolden).

	Public (tests): PetFollowController.GetVisuals(player)
	  -> { { Id, Golden, Slot, Model, Vehicle: boolean, Digging: boolean, Parked: boolean } }
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local Stats = require(Shared:WaitForChild("Util"):WaitForChild("Stats"))

local State = require(script.Parent.State)
local EffectsController = require(script.Parent.EffectsController)
local SoundController = require(script.Parent.SoundController)
local ModelFactory = require(script.Parent.Parent.Util.ModelFactory)
local Character = require(script.Parent.Parent.Util.Character)

local PetFollowController = {}

local ATTRIBUTE = "EquippedPets"
local GOLDEN_ATTRIBUTE = "EquippedGolden" -- v2.2: slots (1-based) of Golden pets in ATTRIBUTE
local RENDER_DISTANCE = 220
local FLYING_SHAPES = { Bird = true, Dragon = true, Star = true, Squid = true, Fish = true }

local VEHICLE_ROW = 8.5 -- studs behind the owner (creature pets use ~4.5-8)
local VEHICLE_SPACING = 4.5
local NEAR_HEIGHT = 6 -- ground this far above / below the feet counts as "not reachable"
local NEAR_SCALE = 0.4 -- vehicle slot offset scale when tucked in close
local GROUND_REFRESH = 0.2
local SNAP_DISTANCE = 60 -- further than this from its target: snap (respawn / long teleport)
local MAX_SPEED = 28 -- studs / second: pets drive / walk, they never jump across the beach

local PARK_DISTANCE = 2.4 -- the pet parks this far beyond its dig point (away from the owner)
local APPROACH_MAX = 1.6 -- seconds to drive to the spot before digging anyway
local ARRIVE_DISTANCE = 1.2
local DIG_DURATION = 0.8 -- seconds of one dig animation
local PARK_HOLD = 4 -- stay at the spot this long after the last dig...
local OWNER_LEAVE = 6 -- ...unless the owner walks this far away

type Joint = {
	Model: Model,
	Rest: CFrame, -- hinge pivot relative to the model pivot
	Motion: string,
	Amount: number,
	Plunge: number,
	Spin: number,
	Posed: boolean,
}

type Action = {
	Target: Vector3, -- dig point
	Park: Vector3?, -- ground position to stand on (resolved on first frame)
	Start: number,
	DigStart: number?,
	Sand: number,
	Burst: boolean,
}

type Park = {
	Position: Vector3,
	Face: Vector3,
	OwnerPos: Vector3,
	Until: number,
}

type PetVisual = {
	Id: string,
	Golden: boolean,
	Slot: number, -- 1-based index in the owner's equipped list (= PetDug slot)
	Model: Model,
	Offset: Vector3, -- pivot -> bottom correction
	Current: CFrame?,
	Flying: boolean,
	Vehicle: boolean,
	Phase: number,
	Joints: { Joint },
	GroundY: number?,
	NextGround: number,
	Near: boolean,
	Action: Action?,
	Park: Park?,
}

type Entry = {
	Key: string,
	Pets: { PetVisual },
}

local entries: { [Player]: Entry } = {}
local folder: Folder? = nil
local localUsesAttribute = false

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = false
local nextFilterRefresh = 0

local function getFolder(): Folder
	if not folder or not folder.Parent then
		local f = Instance.new("Folder")
		f.Name = "ClientPets"
		f.Parent = Workspace
		folder = f
	end
	return folder :: Folder
end

local function refreshFilter(now: number)
	if now < nextFilterRefresh then
		return
	end
	nextFilterRefresh = now + 1
	local list: { Instance } = { getFolder() }
	local effects = Workspace:FindFirstChild("ClientEffects")
	if effects then
		table.insert(list, effects)
	end
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	groundParams.FilterDescendantsInstances = list
end

local function groundBelow(position: Vector3): number?
	local hit = Workspace:Raycast(position + Vector3.new(0, 8, 0), Vector3.new(0, -40, 0), groundParams)
	return if hit then hit.Position.Y else nil
end

local function parse(value: any): { string }
	local ids = {}
	if typeof(value) == "string" then
		for id in string.gmatch(value, "[^,%s]+") do
			if Config.GetPet(id) then
				table.insert(ids, id)
			end
		end
	end
	return ids
end

local function collectJoints(model: Model): { Joint }
	local joints = {}
	local pivot = model:GetPivot()
	for _, d in model:GetDescendants() do
		if d:IsA("Model") and typeof(d:GetAttribute("Motion")) == "string" then
			local amount = d:GetAttribute("Amount")
			local plunge = d:GetAttribute("Plunge")
			table.insert(joints, {
				Model = d,
				Rest = pivot:ToObjectSpace(d:GetPivot()),
				Motion = d:GetAttribute("Motion") :: string,
				Amount = if typeof(amount) == "number" then amount else 0.4,
				Plunge = if typeof(plunge) == "number" then plunge else 0,
				Spin = 0,
				Posed = false,
			})
		end
	end
	return joints
end

local function clear(entry: Entry)
	for _, pet in entry.Pets do
		pet.Model:Destroy()
	end
	table.clear(entry.Pets)
end

-- "2,3" -> { [2] = true, [3] = true }
local function parseGolden(value: any): { [number]: boolean }
	local slots: { [number]: boolean } = {}
	if typeof(value) == "string" then
		for n in string.gmatch(value, "%d+") do
			slots[tonumber(n) :: number] = true
		end
	end
	return slots
end

-- ids in "EquippedPets" order (Stats.SortEquipped: by id, normal before Golden); golden[slot].
local function setPets(player: Player, ids: { string }, golden: { [number]: boolean }?)
	local goldenSlots: { [number]: boolean } = golden or {}
	local keyParts: { string } = {}
	for i, id in ids do
		keyParts[i] = id .. (if goldenSlots[i] then "*" else "")
	end
	local key = table.concat(keyParts, ",")
	local entry = entries[player]
	if not entry then
		entry = { Key = "", Pets = {} }
		entries[player] = entry
	end
	local e = entry :: Entry
	if e.Key == key then
		return
	end
	e.Key = key
	-- keep models (and their position) for pets that stay equipped
	local old: { [string]: { PetVisual } } = {}
	for _, pet in e.Pets do
		local oldKey = pet.Id .. (if pet.Golden then "*" else "")
		old[oldKey] = old[oldKey] or {}
		table.insert(old[oldKey], pet)
	end
	local fresh: { PetVisual } = {}
	for i, id in ids do
		local isGolden = goldenSlots[i] == true
		local reuseKey = id .. (if isGolden then "*" else "")
		local reuse = old[reuseKey] and table.remove(old[reuseKey], 1)
		if reuse then
			reuse.Slot = i
			table.insert(fresh, reuse)
			continue
		end
		local def = Config.GetPet(id)
		local model = ModelFactory.Pet(id)
		if isGolden then
			ModelFactory.MakeGolden(model)
		end
		ModelFactory.MakeVisualOnly(model, false)
		model.Name = player.Name .. "_" .. id
		local boxCFrame, size = model:GetBoundingBox()
		local pivot = model:GetPivot()
		local offset = Vector3.new(0, pivot.Position.Y - (boxCFrame.Position.Y - size.Y / 2), 0)
		model.Parent = getFolder()
		local vehicle = def ~= nil and def.VehicleKind ~= nil
		table.insert(fresh, {
			Id = id,
			Golden = isGolden,
			Slot = i,
			Model = model,
			Offset = offset,
			Current = nil,
			Flying = def ~= nil and not vehicle and FLYING_SHAPES[def.Look.Shape] == true,
			Vehicle = vehicle,
			Phase = i * 1.7,
			Joints = if vehicle then collectJoints(model) else {},
			GroundY = nil,
			NextGround = 0,
			Near = false,
			Action = nil,
			Park = nil,
		})
	end
	for _, list in old do
		for _, pet in list do
			pet.Model:Destroy()
		end
	end
	e.Pets = fresh
end

local function refresh(player: Player)
	local value = player:GetAttribute(ATTRIBUTE)
	if player == Players.LocalPlayer then
		localUsesAttribute = typeof(value) == "string"
		if not localUsesAttribute then
			local ids: { string } = {}
			local golden: { [number]: boolean } = {}
			for i, pet in Stats.SortEquipped(State.Data.Pets or {}) do
				ids[i] = pet.Id
				golden[i] = pet.Golden == true
			end
			setPets(player, ids, golden)
			return
		end
	end
	setPets(player, parse(value), parseGolden(player:GetAttribute(GOLDEN_ATTRIBUTE)))
end

local function track(player: Player)
	player:GetAttributeChangedSignal(ATTRIBUTE):Connect(function()
		refresh(player)
	end)
	player:GetAttributeChangedSignal(GOLDEN_ATTRIBUTE):Connect(function()
		refresh(player)
	end)
	refresh(player)
end

-- Slot positions behind the owner: up to 3 creatures in the first row, the rest in a second row.
local function slotOffset(index: number, count: number): Vector3
	local perRow = 3
	local row = math.floor((index - 1) / perRow)
	local inRow = math.min(perRow, count - row * perRow)
	local col = (index - 1) % perRow
	local x = (col - (inRow - 1) / 2) * 3.2
	local z = 4.5 + row * 3.2 + math.abs(x) * 0.25
	return Vector3.new(x, 0, z)
end

-- Vehicles drive in their own row behind the creatures.
local function vehicleOffset(index: number, count: number, creatureRows: number): Vector3
	local x = (index - (count + 1) / 2) * VEHICLE_SPACING
	return Vector3.new(x, 0, VEHICLE_ROW + math.max(creatureRows - 1, 0) * 3.2 + math.abs(x) * 0.15)
end

-- Animation ----------------------------------------------------------------------------------

local function poseJoints(pet: PetVisual, pivot: CFrame, digAlpha: number, dt: number, reducedMotion: boolean)
	for _, j in pet.Joints do
		local active = digAlpha > 0 or j.Motion == "Spin" or j.Motion == "Drill"
		if not active and not j.Posed then
			continue
		end
		local base = pivot * j.Rest
		local wave = math.sin(math.pi * digAlpha)
		local pose = base
		if j.Motion == "Swing" then
			pose = base * CFrame.Angles(j.Amount * wave, 0, 0)
		elseif j.Motion == "Tip" then
			pose = base * CFrame.Angles(j.Amount * wave * wave, 0, 0)
		elseif j.Motion == "Spin" or j.Motion == "Drill" then
			-- idle drills turn slowly, digging drills spin fast
			if digAlpha > 0 or not reducedMotion then
				j.Spin = (j.Spin + dt * j.Amount * (if digAlpha > 0 then 1 else 0.06)) % (math.pi * 2)
			end
			pose = base * CFrame.new(0, j.Plunge * wave, 0) * CFrame.Angles(0, j.Spin, 0)
		end
		j.Model:PivotTo(pose)
		j.Posed = active
	end
end

local function layerColor(position: Vector3): Color3
	return Config.GetLayerAtDepth(Config.SURFACE_Y - position.Y).Color
end

local function onDug(owner: Player, action: Action)
	local color = layerColor(action.Target)
	local mine = owner == Players.LocalPlayer
	EffectsController.Burst(action.Target, color, if mine then 12 else 6, 0.8)
	if mine then
		EffectsController.Chunks(action.Target, color, 4)
		if action.Sand > 0 then
			EffectsController.FloatText(
				action.Target + Vector3.new(0, 2, 0),
				"+" .. Format.Abbreviate(action.Sand),
				Color3.fromRGB(255, 225, 140),
				0.75
			)
		end
		SoundController.Play("Dig", 0.7 + math.random() * 0.15, 0.35)
	end
end

local function flatUnit(v: Vector3, fallback: Vector3): Vector3
	local f = v * Vector3.new(1, 0, 1)
	return if f.Magnitude > 0.01 then f.Unit else fallback
end

-- Where the pet wants to be this frame. Returns target position (bottom of the pet), the direction
-- to face (nil = face where it moves), the dig animation alpha (0 = not digging) and the follow
-- speed.
local function digTarget(
	owner: Player,
	pet: PetVisual,
	ownerPos: Vector3,
	now: number
): (Vector3?, Vector3?, number, number)
	local action = pet.Action
	if action then
		local a = action :: Action
		if not a.Park then
			local away = flatUnit(a.Target - ownerPos, Vector3.new(0, 0, 1))
			local spot = a.Target + away * PARK_DISTANCE
			local y = groundBelow(Vector3.new(spot.X, a.Target.Y + 2, spot.Z)) or a.Target.Y
			a.Park = Vector3.new(spot.X, y, spot.Z)
		end
		local park = a.Park :: Vector3
		local face = flatUnit(a.Target - park, Vector3.new(0, 0, -1))
		if not a.DigStart then
			local here = if pet.Current then (pet.Current :: CFrame).Position - pet.Offset else park
			local arrived = ((here - park) * Vector3.new(1, 0, 1)).Magnitude < ARRIVE_DISTANCE
			if arrived or now - a.Start > APPROACH_MAX then
				a.DigStart = now
			end
		end
		local digAlpha = 0
		if a.DigStart then
			local t = (now - (a.DigStart :: number)) / DIG_DURATION
			if t >= 1 then
				pet.Action = nil
				pet.Park = { Position = park, Face = face, OwnerPos = ownerPos, Until = now + PARK_HOLD }
				return park, face, 0, 6
			end
			digAlpha = math.max(t, 0.001)
			if not a.Burst and t >= 0.45 then
				a.Burst = true
				onDug(owner, a)
			end
		end
		return park, face, digAlpha, 6
	end
	local parked = pet.Park
	if parked then
		local p = parked :: Park
		local left = ((ownerPos - p.OwnerPos) * Vector3.new(1, 0, 1)).Magnitude > OWNER_LEAVE
		if left or now > p.Until then
			pet.Park = nil
		else
			return p.Position, p.Face, 0, 6
		end
	end
	return nil, nil, 0, 0
end

local function update(dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cameraPos = camera.CFrame.Position
	local low = State.GetSetting("LowGraphics", false) == true
	local reducedMotion = State.GetSetting("ReducedMotion", false) == true
	local now = os.clock()
	refreshFilter(now)
	for player, entry in entries do
		local root = Character.GetRoot(player)
		local visible = root ~= nil
			and (root :: BasePart).Position.Y > -400
			and ((root :: BasePart).Position - cameraPos).Magnitude < RENDER_DISTANCE
			and not (low and player ~= Players.LocalPlayer)
		local creatures, vehicles = 0, 0
		for _, pet in entry.Pets do
			if pet.Vehicle then
				vehicles += 1
			else
				creatures += 1
			end
		end
		local creatureRows = math.ceil(creatures / 3)
		local creatureIndex, vehicleIndex = 0, 0
		for _, pet in entry.Pets do
			if pet.Vehicle then
				vehicleIndex += 1
			else
				creatureIndex += 1
			end
			if not visible or not root then
				if pet.Model.Parent then
					pet.Model.Parent = nil
				end
				pet.Current = nil
				pet.Action = nil
				pet.Park = nil
				continue
			end
			if not pet.Model.Parent then
				pet.Model.Parent = getFolder()
			end
			local rootCFrame = (root :: BasePart).CFrame
			local flatLook = flatUnit(rootCFrame.LookVector, Vector3.new(0, 0, -1))
			local flat = CFrame.lookAt(rootCFrame.Position, rootCFrame.Position + flatLook)
			local feetY = rootCFrame.Position.Y - 3
			local ownerPos = Vector3.new(rootCFrame.Position.X, feetY, rootCFrame.Position.Z)

			local digPos, face, digAlpha, digSpeed = digTarget(player, pet, ownerPos, now)
			local target: Vector3
			local speed = 9
			if digPos then
				target = (digPos :: Vector3) + Vector3.new(0, if pet.Flying then 2.2 else 0, 0)
				speed = digSpeed
			elseif pet.Vehicle then
				local offset = vehicleOffset(vehicleIndex, vehicles, creatureRows)
				if pet.Near then
					offset *= NEAR_SCALE
				end
				local slot = flat:PointToWorldSpace(offset)
				if now >= pet.NextGround or pet.GroundY == nil then
					pet.NextGround = now + GROUND_REFRESH + math.random() * 0.05
					-- Behind the owner is solid wall (deep in a hole) or a big drop: tuck in close
					-- at the owner's level instead of vanishing into the terrain.
					local far = groundBelow(flat:PointToWorldSpace(vehicleOffset(vehicleIndex, vehicles, creatureRows)))
					pet.Near = far == nil or math.abs((far :: number) - feetY) > NEAR_HEIGHT
					if pet.Near then
						local nearOffset = vehicleOffset(vehicleIndex, vehicles, creatureRows) * NEAR_SCALE
						pet.GroundY = groundBelow(flat:PointToWorldSpace(nearOffset)) or feetY
					else
						pet.GroundY = far
					end
				end
				target = Vector3.new(slot.X, pet.GroundY or feetY, slot.Z)
				speed = 5
			else
				local slot = flat:PointToWorldSpace(slotOffset(creatureIndex, creatures))
				local bob = if reducedMotion then 0 else math.sin(now * 3 + pet.Phase) * 0.35
				if pet.Flying then
					target = slot + Vector3.new(0, 2.2 + bob * 1.4, 0)
				else
					-- Creature feet need their own surface, not the owner's height.
					-- Bound raycasts to the same cadence used for vehicle followers.
					if now >= pet.NextGround or pet.GroundY == nil then
						pet.NextGround = now + GROUND_REFRESH + math.random() * 0.05
						local far = groundBelow(slot)
						pet.Near = far == nil or math.abs((far :: number) - feetY) > NEAR_HEIGHT
						pet.GroundY = if pet.Near
							then groundBelow(flat:PointToWorldSpace(slotOffset(creatureIndex, creatures) * NEAR_SCALE))
								or feetY
							else far
					end
					if pet.Near then
						slot = flat:PointToWorldSpace(slotOffset(creatureIndex, creatures) * NEAR_SCALE)
					end
					target = Vector3.new(slot.X, (pet.GroundY or feetY) + math.max(bob, 0) * 1.2, slot.Z)
				end
			end
			target += pet.Offset

			local current = pet.Current
			local position: Vector3
			if not current or ((current :: CFrame).Position - target).Magnitude > SNAP_DISTANCE then
				position = target
			else
				local from = (current :: CFrame).Position
				position = from:Lerp(target, 1 - math.exp(-dt * speed))
				local stepVec = position - from
				local maxStep = MAX_SPEED * dt
				if stepVec.Magnitude > maxStep then
					position = from + stepVec.Unit * maxStep
				end
			end
			local moved = if current
				then (position - (current :: CFrame).Position) * Vector3.new(1, 0, 1)
				else Vector3.zero
			local look = flatLook
			if face then
				look = face :: Vector3
			elseif pet.Vehicle then
				-- vehicles keep their heading until they drive somewhere
				if moved.Magnitude > dt * 1.5 then
					look = moved.Unit
				elseif current then
					look = flatUnit((current :: CFrame).LookVector, flatLook)
				end
			elseif current then
				-- creatures face where they are going, else where the owner is heading
				local toTarget = (target - (current :: CFrame).Position) * Vector3.new(1, 0, 1)
				if toTarget.Magnitude > 0.4 then
					look = toTarget.Unit
				end
			end
			-- turn smoothly instead of snapping
			if current then
				local prev = flatUnit((current :: CFrame).LookVector, look)
				look = flatUnit(prev:Lerp(look, 1 - math.exp(-dt * 8)), look)
			end

			local pivot = CFrame.lookAt(position, position + look)
			pet.Current = pivot
			local shown = pivot
			if pet.Vehicle and not reducedMotion then
				local driving = math.clamp(moved.Magnitude / math.max(dt, 1e-3) / 16, 0, 1)
				local bob = math.abs(math.sin(now * 9 + pet.Phase)) * (0.04 + 0.12 * driving)
				local rumble = if digAlpha > 0 then math.sin(now * 40) * 0.03 else 0
				shown = pivot * CFrame.new(0, bob + rumble, 0) * CFrame.Angles(-driving * 0.04, 0, 0)
			elseif not pet.Vehicle and digAlpha > 0 then
				-- creatures: two quick scooping hops toward the hole
				local wave = math.abs(math.sin(math.pi * 2 * digAlpha))
				shown = pivot * CFrame.new(0, wave * 0.5, -wave * 0.2) * CFrame.Angles(-wave * 0.45, 0, 0)
			elseif pet.Flying and not reducedMotion then
				shown = pivot * CFrame.Angles(0, 0, math.sin(now * 2 + pet.Phase) * 0.12)
			end
			pet.Model:PivotTo(shown)
			if pet.Vehicle then
				poseJoints(pet, shown, digAlpha, dt, reducedMotion)
			end
		end
	end
end

local function onPetDug(player: any, slot: any, petId: any, position: any, sand: any)
	if
		typeof(player) ~= "Instance"
		or not (player :: Instance):IsA("Player")
		or typeof(petId) ~= "string"
		or typeof(position) ~= "Vector3"
	then
		return
	end
	local entry = entries[player :: Player]
	if not entry then
		return
	end
	local target: PetVisual? = nil
	if typeof(slot) == "number" then
		local candidate = (entry :: Entry).Pets[slot]
		if candidate and candidate.Id == petId then
			target = candidate
		end
	end
	if not target then
		for _, pet in (entry :: Entry).Pets do
			if pet.Id == petId then
				target = pet
				break
			end
		end
	end
	if not target then
		return
	end
	local pet = target :: PetVisual
	if not pet.Model.Parent or not pet.Current then
		return -- not rendered (far away / hidden): skip the animation entirely
	end
	pet.Action = {
		Target = position,
		Park = nil,
		Start = os.clock(),
		DigStart = nil,
		Sand = if typeof(sand) == "number" then sand else 0,
		Burst = false,
	}
	pet.Park = nil
end

-- Public ------------------------------------------------------------------------------------------

export type VisualInfo = {
	Id: string,
	Golden: boolean,
	Slot: number,
	Model: Model,
	Vehicle: boolean,
	Digging: boolean,
	Parked: boolean,
}

function PetFollowController.GetVisuals(player: Player): { VisualInfo }
	local list: { VisualInfo } = {}
	local entry = entries[player]
	if entry then
		for _, pet in (entry :: Entry).Pets do
			table.insert(list, {
				Id = pet.Id,
				Golden = pet.Golden,
				Slot = pet.Slot,
				Model = pet.Model,
				Vehicle = pet.Vehicle,
				Digging = pet.Action ~= nil,
				Parked = pet.Park ~= nil,
			})
		end
	end
	return list
end

function PetFollowController.Init()
	for _, player in Players:GetPlayers() do
		task.spawn(track, player)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(function(player: Player)
		local entry = entries[player]
		if entry then
			clear(entry)
			entries[player] = nil
		end
	end)
	State.Changed("Pets"):Connect(function()
		if not localUsesAttribute then
			refresh(Players.LocalPlayer)
		end
	end)
	task.spawn(function()
		Remotes.Get("PetDug").OnClientEvent:Connect(onPetDug)
	end)
	RunService.RenderStepped:Connect(update)
end

return PetFollowController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">PlacementController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	PlacementController — place a shade on the beach (owner: Survival). UI-agnostic: SurvivalHUD
	draws the Rotate / Place / Cancel bar from PlacementController.Changed.

	Flow: Begin(shadeId?) -> a see-through ghost (Models.Shade) plus a disc showing the shaded
	circle follows the pointer: the mouse on desktop, the last tap on touch screens (tap the sand
	to move it), the screen centre on gamepad. The ghost sits on the raycast hit point of the
	terrain (the VISIBLE smooth-terrain surface). Green = OK, red = can't place there (too far,
	in the sea, down a hole). R / L1 rotates, click / Place button / R2 places, B / Backspace /
	Cancel button cancels. Digging is paused while placing (DigController.Enabled).
	The server re-validates everything (SurvivalShades) and answers with a toast.

	API:
		PlacementController.Begin(shadeId?) / Cancel() / Toggle() / Rotate() / Confirm(): boolean
		PlacementController.Active: boolean, ShadeId: string?, Valid: boolean, Reason: string?
		PlacementController.Changed: Signal (active: boolean)
		PlacementController.BestOwnedShade(): string?
		PlacementController.SetPointer(screenPosition: Vector2)   -- touch: aim at a screen point
]]
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Signal = require(script.Parent.Parent.Util.Signal)
local Character = require(script.Parent.Parent.Util.Character)
local ModelFactory = require(script.Parent.Parent.Util.ModelFactory)
local State = require(script.Parent.State)
local SoundController = require(script.Parent.SoundController)
local DigController = require(script.Parent.DigController)
local Models = require(Shared:WaitForChild("Models"))

local PlacementController = {}

PlacementController.Active = false
PlacementController.ShadeId = nil :: string?
PlacementController.Valid = false
PlacementController.Reason = nil :: string?
PlacementController.Position = nil :: Vector3?
PlacementController.Yaw = 0
PlacementController.Changed = Signal.new()
-- Optional UI hook for local hints (SurvivalHUD sets it to Toasts.Show).
PlacementController.Hint = nil :: ((text: string, kind: string) -> ())?

local RENDER_NAME = "SurvivalShadePlacement"
local RAY_LENGTH = 400
local OK_COLOR = Color3.fromRGB(90, 230, 120)
local BAD_COLOR = Color3.fromRGB(255, 80, 80)
local SURFACE_BELOW = 6

local ghost: Model? = nil
local disc: Part? = nil
local pointer: Vector2? = nil -- screen (GUI inset excluded) position of the last tap
local digWasEnabled = true
local pointerDown = false -- mouse / touch held since it was pressed during placement
local restorePending = false
local initialized = false

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = { Workspace.Terrain }
rayParams.IgnoreWater = false

local function hint(text: string, kind: string)
	local fn = PlacementController.Hint
	if fn then
		fn(text, kind)
	end
end

function PlacementController.BestOwnedShade(): string?
	local owned = State.Data.OwnedShades or ({} :: { [string]: boolean })
	local best: string? = nil
	for _, def in Config.Shades do
		if owned[def.Id] then
			best = def.Id -- Config.Shades is ordered by price
		end
	end
	return best
end

local function destroyGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	if disc then
		disc:Destroy()
		disc = nil
	end
end

local function buildGhost(shadeId: string)
	destroyGhost()
	local ok, result = pcall(Models.Shade, shadeId)
	local model: Model
	if ok and typeof(result) == "Instance" and result:IsA("Model") then
		model = result
	else
		model = Instance.new("Model")
		local p = Instance.new("Part")
		p.Name = "Root"
		p.Size = Vector3.new(1, 8, 1)
		p.Parent = model
		model.PrimaryPart = p
	end
	ModelFactory.MakeVisualOnly(model, false)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Transparency = math.max(d.Transparency, 0.45)
		elseif d:IsA("BillboardGui") or d:IsA("PointLight") then
			d:Destroy()
		end
	end
	model.Name = "ShadeGhost"
	model.Parent = Workspace.CurrentCamera or Workspace
	ghost = model

	local def = Config.GetShade(shadeId)
	local radius = if def then def.Radius else 6
	local d = Instance.new("Part")
	d.Name = "ShadeGhostDisc"
	d.Shape = Enum.PartType.Cylinder
	d.Anchored = true
	d.CanCollide = false
	d.CanQuery = false
	d.CanTouch = false
	d.CastShadow = false
	d.Material = Enum.Material.SmoothPlastic
	d.Transparency = 0.65
	d.Size = Vector3.new(0.3, radius * 2, radius * 2)
	d.Color = OK_COLOR
	d.Parent = Workspace.CurrentCamera or Workspace
	disc = d
end

-- Camera ray for the current pointer (mouse / last tap / screen centre).
local function aimRay(): (Vector3?, Vector3?)
	local camera = Workspace.CurrentCamera
	if not camera then
		return nil, nil
	end
	local ray: Ray
	local tapped = pointer
	if tapped then
		ray = camera:ScreenPointToRay(tapped.X, tapped.Y)
	elseif UserInputService.MouseEnabled and not UserInputService.TouchEnabled then
		local mouse = UserInputService:GetMouseLocation()
		ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	else
		local size = camera.ViewportSize
		ray = camera:ViewportPointToRay(size.X / 2, size.Y * 0.6)
	end
	return ray.Origin, ray.Direction
end

local function horizontal(a: Vector3, b: Vector3): number
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

-- Recomputes the aim point, validity and ghost pose.
function PlacementController.Update()
	if not PlacementController.Active then
		return
	end
	local origin, direction = aimRay()
	local hit = if origin and direction then Workspace:Raycast(origin, direction.Unit * RAY_LENGTH, rayParams) else nil
	local valid = false
	local reason: string? = "Point at the sand"
	local position: Vector3? = nil
	if hit then
		position = hit.Position
		local root = Character.GetRoot()
		if hit.Material == Enum.Material.Water then
			reason = "Not in the water!"
		elseif hit.Position.Y < Config.SURFACE_Y - SURFACE_BELOW then
			reason = "Put it on the surface, not in a hole!"
		elseif root and horizontal(root.Position, hit.Position) > Config.Heat.ShadePlaceRange then
			reason = "Too far away!"
		else
			valid = true
			reason = nil
		end
	end
	PlacementController.Valid = valid
	PlacementController.Reason = reason
	PlacementController.Position = position
	local model = ghost
	local ring = disc
	if model and ring then
		if position then
			local pose = CFrame.new(position) * CFrame.Angles(0, PlacementController.Yaw, 0)
			model:PivotTo(pose)
			ring.CFrame = CFrame.new(position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
			ring.Color = if valid then OK_COLOR else BAD_COLOR
			ring.Transparency = 0.65
		else
			ring.Transparency = 1
		end
	end
end

local function bindInputs()
	ContextActionService:BindActionAtPriority("SurvivalPlaceRotate", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			PlacementController.Rotate()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.R, Enum.KeyCode.ButtonL1)
	ContextActionService:BindActionAtPriority("SurvivalPlaceCancel", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			PlacementController.Cancel()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.B, Enum.KeyCode.Backspace, Enum.KeyCode.ButtonB)
	ContextActionService:BindActionAtPriority("SurvivalPlaceConfirm", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			PlacementController.Confirm()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonR2, Enum.KeyCode.Return)
	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		PlacementController.Update()
	end)
end

local function unbindInputs()
	ContextActionService:UnbindAction("SurvivalPlaceRotate")
	ContextActionService:UnbindAction("SurvivalPlaceCancel")
	ContextActionService:UnbindAction("SurvivalPlaceConfirm")
	RunService:UnbindFromRenderStep(RENDER_NAME)
end

function PlacementController.Begin(shadeId: string?)
	local id = shadeId or PlacementController.BestOwnedShade()
	if not id then
		hint("Buy a shade at the Beach Shop first! ⛱️", "Info")
		return
	end
	local owned = State.Data.OwnedShades or ({} :: { [string]: boolean })
	if not owned[id :: string] then
		hint("You don't own that shade yet!", "Error")
		return
	end
	local wasActive = PlacementController.Active
	PlacementController.Active = true
	PlacementController.ShadeId = id
	pointer = nil
	buildGhost(id :: string)
	if not wasActive then
		if not restorePending then
			digWasEnabled = DigController.Enabled
		end
		restorePending = false
		DigController.Enabled = false
		bindInputs()
	end
	PlacementController.Update()
	SoundController.Play("Whoosh", 1.3, 0.5)
	PlacementController.Changed:Fire(true)
end

function PlacementController.Cancel()
	if not PlacementController.Active then
		return
	end
	PlacementController.Active = false
	PlacementController.ShadeId = nil
	PlacementController.Position = nil
	pointer = nil
	destroyGhost()
	unbindInputs()
	-- The click that placed the shade is still held: DigController would keep hold-digging, so
	-- only resume digging once it is released.
	if pointerDown then
		restorePending = true
	else
		DigController.Enabled = digWasEnabled
	end
	PlacementController.Changed:Fire(false)
end

function PlacementController.Toggle()
	if PlacementController.Active then
		PlacementController.Cancel()
	else
		PlacementController.Begin(nil)
	end
end

function PlacementController.Rotate()
	if not PlacementController.Active then
		return
	end
	PlacementController.Yaw = (PlacementController.Yaw + math.pi / 4) % (math.pi * 2)
	SoundController.Play("Click")
	PlacementController.Update()
end

-- Touch: aim at a screen point (GUI coordinates, inset excluded).
function PlacementController.SetPointer(position: Vector2)
	pointer = position
	PlacementController.Update()
end

function PlacementController.Confirm(): boolean
	if not PlacementController.Active then
		return false
	end
	PlacementController.Update()
	local position = PlacementController.Position
	local id = PlacementController.ShadeId
	if not PlacementController.Valid or not position or not id then
		SoundController.Play("Error")
		hint(PlacementController.Reason or "Can't place it there!", "Error")
		return false
	end
	Remotes.Get("PlaceShade"):FireServer(id, position, PlacementController.Yaw)
	SoundController.Play("Purchase", 1.1, 0.6)
	PlacementController.Cancel()
	return true
end

function PlacementController.Init()
	if initialized then
		return
	end
	initialized = true
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not PlacementController.Active then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pointerDown = true
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			PlacementController.Confirm()
		elseif input.UserInputType == Enum.UserInputType.Touch then
			PlacementController.SetPointer(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pointerDown = false
			if restorePending then
				restorePending = false
				DigController.Enabled = digWasEnabled
			end
		end
	end)
	-- Respawn / leaving: never leave a ghost or a paused DigController behind.
	Players.LocalPlayer.CharacterAdded:Connect(function()
		PlacementController.Cancel()
	end)
	-- Losing the shade (rebirth won't, but be safe) cancels too.
	State.Changed("OwnedShades"):Connect(function(owned: any)
		local id = PlacementController.ShadeId
		if PlacementController.Active and id and not (typeof(owned) == "table" and owned[id]) then
			PlacementController.Cancel()
		end
	end)
end

return PlacementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">PurchaseController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	PurchaseController — Robux prompts straight from the client via MarketplaceService.
	Ids of 0 mean "not configured" (Config.Monetization): never prompt, callers disable the UI.
	On a completed pass purchase we mark it owned locally and re-sync with GetOwnedPasses.
	v2.2: never prompts a PaidRandom item while the player is policy-restricted (State.CanBuy);
	the server's MonetizationService refuses those prompts too.
	v2.3: GetPrice(kind, key) returns the live Robux price from MarketplaceService:GetProductInfo
	(fetched once per configured Id, in the background) and falls back to the config suggestion
	(Config.Monetization *.Price) while the Id is 0, the lookup is pending or failed, or the item
	is off sale. PriceChanged fires when a live price arrives so the store can re-render.
]]
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local State = require(script.Parent.State)
local Signal = require(script.Parent.Parent.Util.Signal)
local Track = require(script.Parent.Parent.Util.Track)

local PurchaseController = {}

PurchaseController.PassPurchased = Signal.new() -- (key)
PurchaseController.PriceChanged = Signal.new() -- (kind, key)

local livePrices: { [string]: number } = {} -- "GamePass:VIP" -> Robux
local priceRequested: { [string]: boolean } = {}

local function fetchPrice(kind: string, key: string, id: number)
	local ok, info = pcall(function(): any
		local infoType = if kind == "GamePass" then Enum.InfoType.GamePass else Enum.InfoType.Product
		return MarketplaceService:GetProductInfo(id, infoType)
	end)
	local price = if ok and type(info) == "table" then (info :: any).PriceInRobux else nil
	if type(price) == "number" and price > 0 then
		livePrices[kind .. ":" .. key] = price
		PurchaseController.PriceChanged:Fire(kind, key)
	end
end

-- Robux price to show: live Creator Hub price when known, else the config suggestion.
function PurchaseController.GetPrice(kind: string, key: string): number
	local id, price
	if kind == "GamePass" then
		local pass = Config.Monetization.GamePasses[key]
		if not pass then
			return 0
		end
		id, price = pass.Id, pass.Price
	else
		local product = Config.Monetization.Products[key]
		if not product then
			return 0
		end
		id, price = product.Id, product.Price
	end
	local cacheKey = kind .. ":" .. key
	local live = livePrices[cacheKey]
	if live then
		return live
	end
	if id ~= 0 and not priceRequested[cacheKey] then
		priceRequested[cacheKey] = true
		task.spawn(fetchPrice, kind, key, id)
	end
	return price
end

-- "Configured" = has a real id AND may be offered to this player (v2.2 policy: PaidRandom items
-- are unavailable while State.IsPaidRandomRestricted()), so UI that hides unconfigured items
-- (Rebirth panel's Skip button, Golden Egg buttons) also hides restricted ones.
function PurchaseController.IsPassConfigured(key: string): boolean
	local pass = Config.Monetization.GamePasses[key]
	return pass ~= nil and pass.Id ~= 0 and State.CanBuy("GamePass", key)
end

function PurchaseController.IsProductConfigured(key: string): boolean
	local product = Config.Monetization.Products[key]
	return product ~= nil and product.Id ~= 0 and State.CanBuy("Product", key)
end

-- Returns false (and does nothing) when the pass id is 0 or it is already owned.
function PurchaseController.PromptPass(key: string): boolean
	local pass = Config.Monetization.GamePasses[key]
	if not pass or pass.Id == 0 or State.OwnsPass(key) then
		return false
	end
	if not State.CanBuy("GamePass", key) then
		return false -- v2.2 policy: paid random items are hidden for this player
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, pass.Id)
	end)
	if ok then
		Track.Send("purchase_prompted", "GamePass", key)
	end
	if not ok then
		warn("[Purchase] pass prompt failed", key, err)
	end
	return ok
end

function PurchaseController.PromptProduct(key: string): boolean
	local product = Config.Monetization.Products[key]
	if not product or product.Id == 0 then
		return false
	end
	if not State.CanBuy("Product", key) then
		return false -- v2.2 policy: paid random items are hidden for this player
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(Players.LocalPlayer, product.Id)
	end)
	if ok then
		Track.Send("purchase_prompted", "Product", key)
	end
	if not ok then
		warn("[Purchase] product prompt failed", key, err)
	end
	return ok
end

function PurchaseController.Init()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(
		function(player: Player, passId: number, purchased: boolean)
			if player ~= Players.LocalPlayer or not purchased then
				return
			end
			local key = Config.GetGamePassKeyById(passId)
			if key then
				State.SetPassOwned(key, true)
				PurchaseController.PassPurchased:Fire(key)
			end
			task.delay(2, State.RefreshPasses)
		end
	)
end

return PurchaseController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">RideController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	RideController — drives the ride-on vehicle (v2.1; server: Services/RideService).

	- Toggle (V / gamepad DPadUp / UI/RideButton): fires "ToggleRide" when the player owns a
	  rideable pet (Config.FindRideablePet over State.Data.Pets).
	- Riding = the local Humanoid sits in a "RideSeat" whose vehicle has OwnerUserId == us.
	  While riding:
	    * Input: the PlayerModule's GetControls():GetMoveVector() (WASD / arrows / thumbstick /
	      gamepad stick), else the keyboard, else Humanoid.MoveDirection. Forward/back = throttle,
	      left/right = steer (tank-style turn, also on the spot).
	    * The rider owns the assembly's physics: every frame a target pivot is integrated (speed
	      with acceleration, yaw rate), clamped to the ride area (RideMath.Bounds), put on the
	      ground (RideMath.GroundY: never below the surface, so holes are bridged) and written to
	      AlignPosition.Position / AlignOrientation.CFrame. If the real vehicle lags far behind
	      the target (blocked, or reset by the server) the target re-syncs to it.
	    * Dig: hold left mouse / R2 / the on-screen Dig button -> "RideDig" every DigInterval.
	      Shovel digging (DigController) is paused while riding.
	    * Camera: zoomed out (min zoom 18) and eased behind the vehicle while driving, unless the
	      player is dragging the camera.
	    * Engine: looped built-in sound (Config.Sounds.Dig id, slowed down; pitch follows speed).
	    * Jump leaves the seat (the server despawns the vehicle).
	- "RideDug"(player, position, success, layerIndex) from the server: every client plays the
	  bucket scoop (Motor6D.Transform on BoomMotor / StickMotor / BucketMotor) and a sand burst.

	API: RideController.CanRide(), .Toggle(), .SetDigHeld(held), .Riding, .RidingChanged (Signal),
	.CanRideChanged (Signal), .GetVehicle().
]]
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local RideMath = require(Shared:WaitForChild("Util"):WaitForChild("RideMath"))

local State = require(script.Parent.State)
local SoundController = require(script.Parent.SoundController)
local EffectsController = require(script.Parent.EffectsController)
local DigController = require(script.Parent.DigController)
local Signal = require(script.Parent.Parent.Util.Signal)
local Character = require(script.Parent.Parent.Util.Character)

local RideController = {}

RideController.Riding = false
RideController.RidingChanged = Signal.new() -- (riding: boolean)
RideController.CanRideChanged = Signal.new() -- (canRide: boolean)

local R = Config.Ride
local SCOOP_TIME = 0.9
local RESYNC_DISTANCE = 6
local MIN_ZOOM = 18
local CAMERA_FOLLOW_RATE = 2.2 -- 1/s
local CAMERA_IDLE_AFTER_DRAG = 1.2 -- seconds of no camera drag before auto-follow resumes

type Ride = {
	Model: Model,
	Root: BasePart,
	Seat: Seat,
	AlignPosition: AlignPosition,
	AlignOrientation: AlignOrientation,
	Position: Vector3,
	Yaw: number,
	Speed: number,
	LastDig: number,
	Engine: Sound?,
	DigWasEnabled: boolean,
	MinZoom: number,
}

type Scoop = { Start: number, Success: boolean }

local player = Players.LocalPlayer
local current: Ride? = nil
local canRide = false
local digButtonHeld = false
local mouseHeld = false
local padHeld = false
local lastCameraDrag = -math.huge
local cameraDragging = false
local controls: any = nil
local controlsTried = false
local bounds: RideMath.Bounds? = nil
local scoops: { [Model]: Scoop } = {}
local initialized = false

local function getBounds(): RideMath.Bounds?
	if bounds then
		return bounds
	end
	local zoneCFrame, zoneSize = State.GetDigZone()
	if zoneCFrame and zoneSize then
		bounds = RideMath.Bounds(zoneCFrame, zoneSize)
	end
	return bounds
end

local function getControls(): any
	if controlsTried then
		return controls
	end
	controlsTried = true
	local ok, result = pcall(function(): any
		local scripts = player:FindFirstChild("PlayerScripts")
		local module = if scripts then scripts:FindFirstChild("PlayerModule") else nil
		if module and module:IsA("ModuleScript") then
			return (require :: any)(module):GetControls()
		end
		return nil
	end)
	controls = if ok then result else nil
	return controls
end

function RideController.CanRide(): boolean
	return Config.FindRideablePet(State.Data.Pets) ~= nil
end

function RideController.GetVehicle(): Model?
	local ride = current
	return if ride then ride.Model else nil
end

function RideController.Toggle()
	if not RideController.Riding and not RideController.CanRide() then
		return
	end
	SoundController.Play("Click")
	Remotes.Get("ToggleRide"):FireServer()
end

function RideController.SetDigHeld(held: boolean)
	digButtonHeld = held
end

-- The ride model the local humanoid currently sits in, or nil.
local function seatedVehicle(): (Model?, Seat?)
	local humanoid = Character.GetHumanoid()
	local part: Instance? = if humanoid then humanoid.SeatPart else nil
	if not part then
		return nil, nil
	end
	assert(part) -- refine for the type checker (guarded above)
	if not part:IsA("Seat") or part.Name ~= "RideSeat" or part.Parent == nil then
		return nil, nil
	end
	local model = part.Parent
	if model and model:IsA("Model") and model:GetAttribute("OwnerUserId") == player.UserId then
		return model, part :: Seat
	end
	return nil, nil
end

local function yawOf(cf: CFrame): number
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z)
end

local function startRiding(model: Model, seat: Seat)
	local root = model.PrimaryPart
	local alignPosition = root and root:FindFirstChild("RideAlignPosition")
	local alignOrientation = root and root:FindFirstChild("RideAlignOrientation")
	if
		not root
		or not alignPosition
		or not alignPosition:IsA("AlignPosition")
		or not alignOrientation
		or not alignOrientation:IsA("AlignOrientation")
	then
		return
	end
	assert(root) -- refine for the type checker (guarded above)
	local pivot = root.CFrame
	local engine: Sound? = nil
	local def = Config.Sounds.Dig
	if def and def.Id ~= "" then
		local sound = Instance.new("Sound")
		sound.Name = "RideEngine"
		sound.SoundId = def.Id
		sound.Looped = true
		sound.Volume = if State.GetSetting("SFX", true) == false then 0 else def.Volume * 0.45
		sound.PlaybackSpeed = 0.35
		sound.RollOffMaxDistance = 80
		sound.Parent = root
		sound:Play()
		engine = sound
	end
	current = {
		Model = model,
		Root = root,
		Seat = seat,
		AlignPosition = alignPosition :: AlignPosition,
		AlignOrientation = alignOrientation :: AlignOrientation,
		Position = pivot.Position,
		Yaw = yawOf(pivot),
		Speed = 0,
		LastDig = 0,
		Engine = engine,
		DigWasEnabled = DigController.Enabled,
		MinZoom = player.CameraMinZoomDistance,
	}
	DigController.Enabled = false
	player.CameraMinZoomDistance = math.max(player.CameraMinZoomDistance, MIN_ZOOM)
	RideController.Riding = true
	RideController.RidingChanged:Fire(true)
end

local function stopRiding()
	local ride = current
	if not ride then
		return
	end
	assert(ride) -- refine for the type checker (guarded above)
	current = nil
	local engine = ride.Engine
	if engine then
		engine:Destroy()
	end
	DigController.Enabled = ride.DigWasEnabled
	player.CameraMinZoomDistance = ride.MinZoom
	mouseHeld = false
	padHeld = false
	digButtonHeld = false
	RideController.Riding = false
	RideController.RidingChanged:Fire(false)
end

-- Throttle (-1..1, + = forward) and steer (-1..1, + = turn left).
local function readInput(ride: Ride): (number, number)
	local c = getControls()
	if c then
		local ok, move = pcall(function(): any
			return c:GetMoveVector()
		end)
		if ok and typeof(move) == "Vector3" and move.Magnitude > 0.05 then
			return math.clamp(-move.Z, -1, 1), math.clamp(-move.X, -1, 1)
		end
	end
	local throttle, steer = 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
		throttle += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
		throttle -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		steer += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		steer -= 1
	end
	if throttle ~= 0 or steer ~= 0 then
		return throttle, steer
	end
	-- Last resort: the humanoid's world move direction relative to the vehicle.
	local humanoid = Character.GetHumanoid()
	local dir = if humanoid then humanoid.MoveDirection else Vector3.zero
	if dir.Magnitude > 0.05 then
		local look = Vector3.new(-math.sin(ride.Yaw), 0, -math.cos(ride.Yaw))
		local right = Vector3.new(-look.Z, 0, look.X)
		return math.clamp(dir:Dot(look), -1, 1), math.clamp(-dir:Dot(right), -1, 1)
	end
	return 0, 0
end

local function approach(value: number, target: number, step: number): number
	if value < target then
		return math.min(value + step, target)
	end
	return math.max(value - step, target)
end

local function drive(ride: Ride, dt: number)
	local engine = ride.Engine
	if engine then
		-- Settings still apply while the dig zone is unavailable (for example during streaming).
		engine.Volume = if State.GetSetting("SFX", true) == false then 0 else Config.Sounds.Dig.Volume * 0.45
	end
	local b = getBounds()
	if not b then
		return
	end
	assert(b) -- refine for the type checker (guarded above)
	local throttle, steer = readInput(ride)
	local top = if throttle >= 0 then R.MaxSpeed else R.MaxSpeed * R.ReverseFactor
	ride.Speed = approach(ride.Speed, throttle * top, R.Acceleration * dt)
	ride.Yaw += steer * R.TurnRate * dt

	-- Re-sync when the real vehicle is far from the target (blocked by a prop, server reset).
	local actual = ride.Root.Position
	local gap = Vector3.new(actual.X - ride.Position.X, 0, actual.Z - ride.Position.Z)
	if gap.Magnitude > RESYNC_DISTANCE then
		ride.Position = actual
		ride.Speed *= 0.5
	end

	local look = Vector3.new(-math.sin(ride.Yaw), 0, -math.cos(ride.Yaw))
	local nextPos = RideMath.Clamp(ride.Position + look * ride.Speed * dt, b)
	local pivot = CFrame.new(nextPos.X, 0, nextPos.Z) * CFrame.Angles(0, ride.Yaw, 0)
	local y = RideMath.GroundY(pivot)
	pivot += Vector3.new(0, y, 0)
	ride.Position = pivot.Position
	ride.AlignPosition.Position = pivot.Position
	ride.AlignOrientation.CFrame = pivot.Rotation

	if engine then
		engine.PlaybackSpeed = 0.35 + 0.3 * math.abs(ride.Speed) / R.MaxSpeed
	end
end

local function followCamera(ride: Ride, dt: number)
	if cameraDragging or os.clock() - lastCameraDrag < CAMERA_IDLE_AFTER_DRAG or math.abs(ride.Speed) < 2 then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local focus = camera.Focus.Position
	local offset = camera.CFrame.Position - focus
	local flat = Vector3.new(offset.X, 0, offset.Z)
	if flat.Magnitude < 1 then
		return
	end
	-- Behind the vehicle = opposite its heading (drive in reverse: keep the current side).
	local behindYaw = ride.Yaw
	local currentYaw = math.atan2(flat.X, flat.Z)
	local delta = (behindYaw - currentYaw + math.pi) % (2 * math.pi) - math.pi
	local turn = delta * math.min(1, CAMERA_FOLLOW_RATE * dt)
	local rotated = CFrame.Angles(0, turn, 0) * offset
	camera.CFrame = CFrame.lookAt(focus + rotated, focus)
end

local function tryDig(ride: Ride)
	if not (digButtonHeld or mouseHeld or padHeld) then
		return
	end
	local interval = ride.Model:GetAttribute("DigInterval")
	local wait = if typeof(interval) == "number" then interval else 1
	local now = os.clock()
	if now - ride.LastDig < wait then
		return
	end
	ride.LastDig = now
	Remotes.Get("RideDig"):FireServer()
end

-- Scoop animation -------------------------------------------------------------------------------

local function motors(model: Model): (Motor6D?, Motor6D?, Motor6D?)
	local boom = model:FindFirstChild("BoomMotor", true)
	local stick = model:FindFirstChild("StickMotor", true)
	local bucket = model:FindFirstChild("BucketMotor", true)
	return if boom and boom:IsA("Motor6D") then boom else nil,
		if stick and stick:IsA("Motor6D") then stick else nil,
		if bucket and bucket:IsA("Motor6D") then bucket else nil
end

local function poseScoop(model: Model, t: number, success: boolean)
	local boom, stick, bucket = motors(model)
	local dip = math.sin(math.pi * math.clamp(t, 0, 1)) -- 0 -> 1 -> 0
	local curl = math.clamp((t - 0.35) / 0.3, 0, 1) * (1 - math.clamp((t - 0.85) / 0.15, 0, 1))
	if boom then
		boom.Transform = CFrame.Angles(-0.32 * dip, 0, 0)
	end
	if stick then
		stick.Transform = CFrame.Angles(0.45 * dip - 0.25 * curl, 0, 0)
	end
	if bucket then
		bucket.Transform = CFrame.Angles(0.9 * curl, 0, 0)
	end
	local load = model:FindFirstChild("BucketSand", true)
	if load and load:IsA("BasePart") then
		load.Transparency = if success and t > 0.45 and t < 1 then 0 else 1
	end
end

local function updateScoops()
	local now = os.clock()
	for model, scoop in scoops do
		local t = (now - scoop.Start) / SCOOP_TIME
		if model.Parent == nil then
			scoops[model] = nil
		elseif t >= 1 then
			poseScoop(model, 1, false)
			scoops[model] = nil
		else
			poseScoop(model, t, scoop.Success)
		end
	end
end

local function findVehicle(owner: Player): Model?
	local folder = Workspace:FindFirstChild("Rides")
	local model = if folder then folder:FindFirstChild("Ride_" .. owner.UserId) else nil
	return if model and model:IsA("Model") then model else nil
end

local function onRideDug(owner: any, position: any, success: any, layerIndex: any)
	if typeof(owner) ~= "Instance" or not owner:IsA("Player") or typeof(position) ~= "Vector3" then
		return
	end
	local ok = success == true
	local model = findVehicle(owner)
	if model then
		scoops[model] = { Start = os.clock(), Success = ok }
	end
	local layer = Config.Layers[if typeof(layerIndex) == "number" then layerIndex else 1] or Config.Layers[1]
	-- the bucket bites a moment after the boom starts dropping
	task.delay(SCOOP_TIME * 0.35, function()
		if ok then
			EffectsController.Burst(position, layer.Color, 22, 1.4)
			EffectsController.Chunks(position, layer.Color, 6)
		else
			EffectsController.Burst(position, Color3.fromRGB(200, 200, 200), 6, 0.8)
		end
		if owner == player then
			SoundController.Play(if ok then "Dig" else "DigBlocked", 0.6 + math.random() * 0.1)
			EffectsController.Shake(if ok then 0.22 else 0.12, 0.15)
		end
	end)
end

-- Lifecycle -------------------------------------------------------------------------------------

local function refreshCanRide()
	local value = RideController.CanRide()
	if value ~= canRide then
		canRide = value
		RideController.CanRideChanged:Fire(value)
	end
end

local function step(dt: number)
	local model, seat = seatedVehicle()
	local ride = current
	if ride and (model ~= ride.Model or ride.Model.Parent == nil) then
		stopRiding()
		ride = nil
	end
	if not ride and model and seat then
		startRiding(model, seat)
		ride = current
	end
	if ride then
		drive(ride, dt)
		followCamera(ride, dt)
		tryDig(ride)
	end
	updateScoops()
end

function RideController.Init()
	if initialized then
		return
	end
	initialized = true

	State.Observe("Pets", function()
		refreshCanRide()
	end)

	ContextActionService:BindAction(
		"RideToggle",
		function(_, inputState: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
			if input.KeyCode == Enum.KeyCode.DPadUp and GuiService.SelectedObject ~= nil then
				return Enum.ContextActionResult.Pass -- gamepad UI navigation
			end
			if not RideController.Riding and not RideController.CanRide() then
				return Enum.ContextActionResult.Pass
			end
			if inputState == Enum.UserInputState.Begin then
				RideController.Toggle()
			end
			return Enum.ContextActionResult.Sink
		end,
		false,
		Enum.KeyCode.V,
		Enum.KeyCode.DPadUp
	)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			cameraDragging = true
			lastCameraDrag = os.clock()
		elseif input.UserInputType == Enum.UserInputType.Touch then
			lastCameraDrag = os.clock()
		end
		if processed or not RideController.Riding then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			mouseHeld = true
		elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
			padHeld = true
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 and input.Position.Magnitude > 0.2 then
			lastCameraDrag = os.clock()
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			cameraDragging = false
			lastCameraDrag = os.clock()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			mouseHeld = false
		elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
			padHeld = false
		end
	end)
	UserInputService.JumpRequest:Connect(function()
		if RideController.Riding then
			local humanoid = Character.GetHumanoid()
			if humanoid then
				humanoid.Sit = false
			end
		end
	end)

	task.spawn(function()
		Remotes.Get("RideDug").OnClientEvent:Connect(onRideDug)
	end)
	RunService.Heartbeat:Connect(step)
end

return RideController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">ShovelPoseController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ShovelPoseController — procedural arm pose + scoop animation for held shovels.

	Runs on every client for EVERY character (Motor6D.Transform is local-only, so each client
	poses everybody, and other players' shovels look right too):
	  * Full-size shovels (Tool attribute "TwoHanded" = true, set by ShopService from the model):
	    both arms are solved with 2-bone IK every frame so the right fist holds the top grip and
	    the left fist holds the shaft lower down; the upper body twists and leans a little like
	    a real digger. Arms ignore the walk animation while the shovel is out (legs still walk).
	  * Hand tools (one-handed spade / trowel): the right arm hangs at the side with the spade
	    pointing forward/down (ONE_HAND_REST, solved with IK like the two-handed hold). v2.2
	    playtest: with the default "toolnone" hold (arm out in front) every scoop first had to
	    drop the arm, so the scoop read as digging DOWN. Now a scoop swings the blade forward
	    into the sand and lifts it UP, then the arm goes back to the side.
	  * Scoop (both): wind-up (blade lifts back) -> thrust down/forward into the sand -> LIFT the
	    blade up with a sand clump on it -> toss forward -> back to rest. The length follows the
	    shovel cooldown (SCOOP_*); a scoop that starts while another runs continues from the
	    current pose, so very fast shovels chop continuously instead of snapping.
	  * Local player: DigController calls PlayScoop on every dig click (no server round trip).
	    Others: the server fires "Scoop"(player) for each successful shovel dig (ShopService).
	  * R6 avatars, hand tools (v2.2 playtest 2: the spade still stuck out on blocky R6 avatars):
	    the one-piece right arm swings about the shoulder only (pitch from the same Pose keys),
	    and because a lowered arm would point the spade backwards with the fixed Tool.Grip, the
	    RightGrip weld's C1 is re-aimed locally so the shaft follows the pose (restored on
	    release). R6 + full-size shovels keep the plain grip; a local scoop there falls back to
	    the default Animate "Slash" tool animation.

	Joints: classic Motor6Ds, or AnimationConstraints when Roblox's Avatar Joint Upgrade
	(StarterPlayer.AvatarJointUpgrade) builds the character. v2.2 playtest: the owner's Studio
	used the upgrade, every Motor6D was "missing" and the spade kept the default hold. Both are
	wrapped as a Joint (C0/C1 = Attachment0/1.CFrame for a constraint; same Transform rule).

	R15 joint math (all in UPPERTORSO space, U = identity):
	  A Motor6D places Part1 = Part0 * C0 * Transform * C1:Inverse(). C0.Position is the joint in
	  Part0 space, C1.Position is the same joint in Part1 space. So to put a limb at a wanted
	  CFrame A (U space) under a parent at P:  Transform = C0:Inverse() * P:Inverse() * A * C1.
	  The chain is UpperTorso -RightShoulder-> RightUpperArm -RightElbow-> RightLowerArm
	  -RightWrist-> RightHand (same on the left). Axes: +X right, +Y up, -Z forward.
	  1. Shoulder S = RightShoulder.C0.Position. Bone lengths come from the rig at runtime
	     (upper arm = |RightElbow.C0 - RightShoulder.C1| in UpperArm space, forearm =
	     |RightWrist.C0 - RightElbow.C1|), so any body scale / proportions work.
	  2. The pose gives the right palm point (S + Hand * armLength) and the shaft direction.
	     The wanted Handle CFrame H is the rotation that maps the tool's ShaftAxis/CupAxis
	     (Handle attributes) onto that shaft direction / "cup up" vector, translated so the
	     palm point H * Grip.Position lands on the target. The tool hangs off the hand through
	     the RightGrip weld (Hand * GripC0 == Handle * Grip), so the hand must be
	     Hand = H * Grip * GripC0:Inverse(), and the wrist target is Hand * RightWrist.C1.Position.
	  3. Arm IK, exact for the R15 hinge elbow: the shoulder joint sits at the torso edge, ~0.5
	     stud off the arm's own axis, so a plain shoulder-elbow-wrist triangle is NOT the elbow's
	     bend plane. Instead (solveArm): the elbow flexes about its joint X axis, so the end
	     point is J * Rx(theta) * u (J = RightElbow.C0); the shoulder->end distance depends on
	     theta only and gives theta in closed form (law of cosines in J's YZ plane, see
	     armGeometry). Then the whole arm rotates about the shoulder joint so shoulder->end
	     points at the target, twisted so the back of the upper arm (+Z, the elbow tip) faces
	     the POLE direction. The elbow Transform is then exactly Rx(theta). Out of reach: the
	     arm straightens and the hand (and shovel) slide back to the reachable wrist point.
	  4. Left hand: the target is H * LeftHand (on the shaft). If the left arm can't reach it,
	     the grip slides along the shaft towards the right hand (sphere/line intersection), so
	     the fist never floats off the shaft on short-armed avatars. The forearm and hand are
	     solved as one straight bone (wrist straight); the hand then twists about its own axis
	     so the fist axis (hand -Z) follows the shaft.
	  5. Waist.Transform = Rx(-Lean) * Ry(-Yaw): lean forward, twist the chest to the right (the
	     left shoulder comes forward, which is what lets the short R15 arms reach the shaft).
	     Neck.Transform undoes the twist and part of the lean so the head keeps looking ahead.
	  All writes happen in RunService.Stepped (after the Animator has written this frame's
	  animation Transforms, before physics/render). When a character stops holding a shovel
	  every joint we touched is reset to identity once, and the Animator takes over again.

	Public API:
		ShovelPoseController.Init()
		ShovelPoseController.PlayScoop(character: Model?, cooldown: number?, color: Color3?): boolean
		ShovelPoseController.IsScooping(character: Model?): boolean
		ShovelPoseController.GetDebug(character: Model?): { Posed, TwoHanded, Weight, Scooping }?
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local State = require(script.Parent.State)
local ItemStats = require(script.Parent.Parent.UI.ItemStats)

local ShovelPoseController = {}

-- =============================================================================================
-- Tuning (UpperTorso axes: +X right, +Y up, -Z forward; Hand offsets are in ARM LENGTHS from the
-- right shoulder joint; Shaft = direction from the top grip to the head; angles in radians).
-- =============================================================================================
type Pose = {
	Hand: Vector3, -- right palm: shoulder + Hand * armLength
	Shaft: Vector3, -- shaft direction (normalised at use)
	Roll: number, -- blade roll about the shaft (0 = cupped face up; negative tips it to the left)
	Yaw: number, -- chest twist at the waist (positive = turn right, left shoulder forward)
	Lean: number, -- forward lean at the waist
}
type Key = { T: number, Pose: Pose }

local rad = math.rad
local V3 = Vector3.new

-- Two-handed rest: right fist at the front of the right hip, shaft crossing down/forward/left,
-- blade ~0.5 stud above the sand ~4 studs ahead (default R15 proportions).
local TWO_HAND_REST: Pose = {
	Hand = V3(-0.6, -0.38, -0.45),
	Shaft = V3(-0.75, -0.42, -0.5),
	Roll = 0,
	Yaw = rad(40),
	Lean = rad(12),
}
-- Scoop keyframes (T = fraction of the scoop). Key 1 is replaced by the current pose.
local TWO_HAND_SCOOP: { Key } = {
	{ T = 0, Pose = TWO_HAND_REST },
	-- wind-up: hands draw back, blade lifts
	{
		T = 0.2,
		Pose = {
			Hand = V3(-0.55, -0.22, -0.36),
			Shaft = V3(-0.78, -0.18, -0.6),
			Roll = 0,
			Yaw = rad(46),
			Lean = rad(4),
		},
	},
	-- thrust: drive the blade down/forward into the sand, lean in
	{
		T = 0.42,
		Pose = {
			Hand = V3(-0.68, -0.46, -0.58),
			Shaft = V3(-0.74, -0.54, -0.42),
			Roll = 0,
			Yaw = rad(38),
			Lean = rad(26),
		},
	},
	-- lift: pull the hands up and level the blade, sand rides on the cupped face
	{
		T = 0.7,
		Pose = {
			Hand = V3(-0.62, -0.28, -0.38),
			Shaft = V3(-0.78, -0.06, -0.62),
			Roll = 0,
			Yaw = rad(42),
			Lean = rad(8),
		},
	},
	-- toss: flick the blade up and roll it over to throw the sand forward
	{
		T = 0.84,
		Pose = {
			Hand = V3(-0.55, -0.2, -0.5),
			Shaft = V3(-0.7, 0.15, -0.7),
			Roll = rad(-70),
			Yaw = rad(30),
			Lean = rad(4),
		},
	},
	{ T = 1, Pose = TWO_HAND_REST },
}
-- Short scoops (fast shovels): no wind-up, straight into the thrust.
local TWO_HAND_FAST: { Key } = {
	{ T = 0, Pose = TWO_HAND_REST },
	{ T = 0.32, Pose = TWO_HAND_SCOOP[3].Pose },
	{ T = 0.66, Pose = TWO_HAND_SCOOP[4].Pose },
	{ T = 0.82, Pose = TWO_HAND_SCOOP[5].Pose },
	{ T = 1, Pose = TWO_HAND_REST },
}

-- One-handed rest: arm hanging at the side, hand by the hip just in front of the thigh, spade
-- pointing forward and down (blade clear of the leg).
local ONE_HAND_REST: Pose = {
	Hand = V3(0.1, -0.9, -0.2),
	Shaft = V3(0.05, -0.5, -0.86),
	Roll = 0,
	Yaw = 0,
	Lean = 0,
}
-- From the side: swing the blade forward and down into the sand (lean in), then lift it UP with
-- the sand on it and flick it forward, then let the arm fall back to the side.
local ONE_HAND_SCOOP: { Key } = {
	{ T = 0, Pose = ONE_HAND_REST },
	{
		T = 0.38,
		Pose = { Hand = V3(0.06, -0.72, -0.5), Shaft = V3(-0.12, -0.85, -0.5), Roll = 0, Yaw = rad(-6), Lean = rad(34) },
	},
	{
		T = 0.72,
		Pose = { Hand = V3(0.18, -0.2, -0.62), Shaft = V3(-0.1, 0.35, -0.93), Roll = rad(-45), Yaw = 0, Lean = rad(4) },
	},
	{ T = 1, Pose = ONE_HAND_REST },
}
local ONE_HAND_FAST: { Key } = ONE_HAND_SCOOP -- no wind-up to skip any more

-- Elbow pole directions (where the elbow points): out to the side, down and a little back.
local RIGHT_POLE = V3(0.8, -0.6, 0.6)
local LEFT_POLE = V3(-0.9, -0.7, 0.2)
local ONE_HAND_POLE = V3(0.6, -0.8, 0.5)

local ELBOW_MAX = rad(150) -- elbow flexion limit
local LEFT_REACH = 0.97 -- left grip slides up the shaft beyond this fraction of a straight arm
local LEFT_MIN_SPACING = 0.45 -- studs: the left fist never slides closer than this to the right
local HEAD_LEAN_FOLLOW = 0.4 -- how much of the waist lean the head keeps (0 = level gaze)
local TWO_HAND_BLEND_TIME = 0.15 -- seconds to blend from the animation into either shovel hold

local SCOOP_COOLDOWN_FRACTION = 0.95 -- scoop length = cooldown * this ...
local SCOOP_MIN_TIME = 0.2 -- ... clamped to [min, max] seconds
local SCOOP_MAX_TIME = 0.45
local SCOOP_FAST_BELOW = 0.3 -- shorter scoops skip the wind-up

local CLUMP_PICKUP_T = { Two = 0.44, One = 0.4 } -- scoop fraction where sand appears on the blade
local CLUMP_TOSS_T = { Two = 0.84, One = 0.72 } -- ... and where it is thrown
local CLUMP_SIZE = { Two = 0.6, One = 0.36 }
local CLUMP_TOSS_VELOCITY = V3(-4, 16, -14) -- character space (forward = -Z), studs/s
local CLUMP_LIFETIME = 1

-- =============================================================================================

-- A Motor6D or an AnimationConstraint, read and written through the same fields:
-- Part1 = Part0 * C0 * Transform * C1:Inverse() for both.
type Joint = {
	Inst: Instance,
	C0: CFrame,
	C1: CFrame,
	Part0: BasePart?,
	Part1: BasePart?,
	Transform: CFrame,
	Parent: Instance?,
}

type Rig = {
	Humanoid: Humanoid,
	UpperTorso: BasePart,
	RightShoulder: Joint,
	RightElbow: Joint,
	RightWrist: Joint,
	LeftShoulder: Joint,
	LeftElbow: Joint,
	LeftWrist: Joint,
	Waist: Joint,
	Neck: Joint?,
	RightHand: BasePart,
	LeftHand: BasePart,
}

type R6Rig = {
	Humanoid: Humanoid,
	Torso: BasePart,
	RightShoulder: Joint,
	RightArm: BasePart,
}

type ToolInfo = {
	Tool: Tool,
	Handle: BasePart,
	TwoHanded: boolean,
	Shaft: Vector3, -- Handle space
	Cup: Vector3,
	Left: Vector3?,
	Blade: Vector3,
}

type Scoop = {
	Start: number,
	Duration: number,
	Keys: { Key },
	BlendIn: boolean,
	Color: Color3?,
	ClumpDone: boolean,
}

type CharState = {
	Rig: Rig?,
	R6: R6Rig?,
	Grips: { [Weld]: CFrame }, -- R6: RightGrip welds whose C1 we re-aimed -> original C1
	RigCheckedAt: number,
	Info: ToolInfo?,
	Weight: number,
	Touched: { Joint },
	Pose: Pose?,
	Scoop: Scoop?,
	Clump: BasePart?,
	Posed: boolean,
}

local states: { [Model]: CharState } = setmetatable({}, { __mode = "k" }) :: any
local toolInfos: { [Tool]: ToolInfo | false } = setmetatable({}, { __mode = "k" }) :: any
local effectsFolder: Folder? = nil

-- Math helpers ----------------------------------------------------------------------------------

local function isFinite(v: Vector3): boolean
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6
end

-- Rotation whose Y axis is `primary` and whose X axis is `secondary` made perpendicular to it.
local function frameFrom(primary: Vector3, secondary: Vector3): CFrame
	local y = primary.Unit
	local x = secondary - y * secondary:Dot(y)
	if x.Magnitude < 1e-4 then
		local alt = if math.abs(y.X) < 0.9 then Vector3.xAxis else Vector3.zAxis
		x = alt - y * alt:Dot(y)
	end
	x = x.Unit
	return CFrame.fromMatrix(Vector3.zero, x, y, x:Cross(y))
end

-- Rotation mapping fromPrimary -> toPrimary exactly and fromSecondary -> toSecondary as well as
-- possible (both secondaries taken perpendicular to their primaries).
local function align(fromPrimary: Vector3, fromSecondary: Vector3, toPrimary: Vector3, toSecondary: Vector3): CFrame
	return frameFrom(toPrimary, toSecondary) * frameFrom(fromPrimary, fromSecondary):Inverse()
end

local function smooth(x: number): number
	local u = math.clamp(x, 0, 1)
	return u * u * (3 - 2 * u)
end

local function lerpPose(a: Pose, b: Pose, t: number): Pose
	return {
		Hand = a.Hand:Lerp(b.Hand, t),
		Shaft = a.Shaft.Unit:Lerp(b.Shaft.Unit, t),
		Roll = a.Roll + (b.Roll - a.Roll) * t,
		Yaw = a.Yaw + (b.Yaw - a.Yaw) * t,
		Lean = a.Lean + (b.Lean - a.Lean) * t,
	}
end

local function sample(keys: { Key }, alpha: number): Pose
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if alpha <= b.T then
			return lerpPose(a.Pose, b.Pose, smooth((alpha - a.T) / math.max(b.T - a.T, 1e-3)))
		end
	end
	return keys[#keys].Pose
end

-- Rig / tool lookup -------------------------------------------------------------------------------

local jointProxies: { [Instance]: Joint } = setmetatable({}, { __mode = "k" }) :: any

local function attachmentParent(a: any): BasePart?
	local p = if a then a.Parent else nil
	return if p and p:IsA("BasePart") then p else nil
end

-- One stable proxy per joint instance (state.Touched compares them by identity).
local function wrapJoint(inst: Instance): Joint
	local cached = jointProxies[inst]
	if cached then
		return cached
	end
	local raw = inst :: any
	local isMotor = inst:IsA("Motor6D")
	local proxy = setmetatable({ Inst = inst }, {
		__index = function(_, key: string): any
			if isMotor then
				return raw[key]
			elseif key == "C0" then
				local a = raw.Attachment0
				return if a then a.CFrame else CFrame.identity
			elseif key == "C1" then
				local a = raw.Attachment1
				return if a then a.CFrame else CFrame.identity
			elseif key == "Part0" then
				return attachmentParent(raw.Attachment0)
			elseif key == "Part1" then
				return attachmentParent(raw.Attachment1)
			end
			return raw[key] -- Transform, Parent
		end,
		__newindex = function(_, key: string, value: any)
			raw[key] = value -- only Transform is ever written
		end,
	})
	local joint = proxy :: any
	jointProxies[inst] = joint
	return joint
end

local function isJoint(inst: Instance?): boolean
	return inst ~= nil and (inst:IsA("Motor6D") or inst:IsA("AnimationConstraint"))
end

-- The joint called `name` between parts `part0` and `part1`: first by name anywhere in the
-- character, then any Motor6D / AnimationConstraint that connects those two parts.
local function findJoint(character: Model, name: string, part0: string, part1: string): Joint?
	local named = character:FindFirstChild(name, true)
	if named and isJoint(named) then
		local j = wrapJoint(named)
		if j.Part0 and j.Part1 then
			return j
		end
	end
	for _, d in character:GetDescendants() do
		if isJoint(d) then
			local j = wrapJoint(d)
			local p0, p1 = j.Part0, j.Part1
			if p0 and p1 and p0.Name == part0 and p1.Name == part1 then
				return j
			end
		end
	end
	return nil
end

local function part(character: Model, name: string): BasePart?
	local p = character:FindFirstChild(name)
	return if p and p:IsA("BasePart") then p else nil
end

-- The character's R15 rig, or nil plus what is missing (Studio diagnostics).
local function resolveRig(character: Model): (Rig?, string?)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil, "no Humanoid"
	elseif humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return nil, "rig is " .. humanoid.RigType.Name
	end
	local upper = part(character, "UpperTorso")
	local rightHand = part(character, "RightHand")
	local leftHand = part(character, "LeftHand")
	local rs = findJoint(character, "RightShoulder", "UpperTorso", "RightUpperArm")
	local re = findJoint(character, "RightElbow", "RightUpperArm", "RightLowerArm")
	local rw = findJoint(character, "RightWrist", "RightLowerArm", "RightHand")
	local ls = findJoint(character, "LeftShoulder", "UpperTorso", "LeftUpperArm")
	local le = findJoint(character, "LeftElbow", "LeftUpperArm", "LeftLowerArm")
	local lw = findJoint(character, "LeftWrist", "LeftLowerArm", "LeftHand")
	local waist = findJoint(character, "Waist", "LowerTorso", "UpperTorso")
	if not (upper and rightHand and leftHand and rs and re and rw and ls and le and lw and waist) then
		local missing = {}
		local function need(name: string, found: any)
			if found == nil then
				table.insert(missing, name)
			end
		end
		need("UpperTorso", upper)
		need("RightHand", rightHand)
		need("LeftHand", leftHand)
		need("RightShoulder", rs)
		need("RightElbow", re)
		need("RightWrist", rw)
		need("LeftShoulder", ls)
		need("LeftElbow", le)
		need("LeftWrist", lw)
		need("Waist", waist)
		table.sort(missing)
		return nil, "R15 rig is missing " .. table.concat(missing, ", ")
	end
	-- refine for the type checker (guarded above)
	assert(upper and rightHand and leftHand and rs and re and rw and ls and le and lw and waist)
	if rs.Part0 ~= upper or ls.Part0 ~= upper then
		return nil,
			"shoulders are not attached to UpperTorso (RightShoulder.Part0 = " .. (if rs.Part0
				then rs.Part0.Name
				else "nil") .. ")"
	end
	return {
		Humanoid = humanoid :: Humanoid,
		UpperTorso = upper :: BasePart,
		RightShoulder = rs :: Joint,
		RightElbow = re :: Joint,
		RightWrist = rw :: Joint,
		LeftShoulder = ls :: Joint,
		LeftElbow = le :: Joint,
		LeftWrist = lw :: Joint,
		Waist = waist :: Joint,
		Neck = findJoint(character, "Neck", "UpperTorso", "Head"),
		RightHand = rightHand :: BasePart,
		LeftHand = leftHand :: BasePart,
	}
end

local function resolveR6(character: Model): R6Rig?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R6 then
		return nil
	end
	local torso = part(character, "Torso")
	local arm = part(character, "Right Arm")
	local rs = findJoint(character, "Right Shoulder", "Torso", "Right Arm")
	if not (torso and arm and rs) or rs.Part0 ~= torso or rs.Part1 ~= arm then
		return nil
	end
	return {
		Humanoid = humanoid :: Humanoid,
		Torso = torso :: BasePart,
		RightShoulder = rs :: Joint,
		RightArm = arm :: BasePart,
	}
end

-- Every joint still in the character and connected. Avatar appearance loading can replace
-- limbs/joints after spawn; a stale joint must trigger a re-resolve, not silent writes to it.
local function jointAlive(m: Joint?): boolean
	return m ~= nil and m.Parent ~= nil and m.Part0 ~= nil and m.Part1 ~= nil
end

local function rigAlive(rig: Rig): boolean
	return rig.Humanoid.Parent ~= nil
		and jointAlive(rig.RightShoulder)
		and jointAlive(rig.RightElbow)
		and jointAlive(rig.RightWrist)
		and jointAlive(rig.LeftShoulder)
		and jointAlive(rig.LeftElbow)
		and jointAlive(rig.LeftWrist)
		and jointAlive(rig.Waist)
end

local function vecAttr(inst: Instance, name: string): Vector3?
	local v = inst:GetAttribute(name)
	return if typeof(v) == "Vector3" then v else nil
end

local function getToolInfo(tool: Tool): ToolInfo?
	local cached = toolInfos[tool]
	if cached == false then
		return nil
	elseif cached then
		return cached :: ToolInfo
	end
	local found = tool:FindFirstChild("Handle")
	if tool:GetAttribute("ShovelId") == nil or not found or not found:IsA("BasePart") then
		return nil -- not ready yet (or not a shovel); try again next frame
	end
	local handle = found :: BasePart
	local shaft = vecAttr(handle, "ShaftAxis")
	local cup = vecAttr(handle, "CupAxis")
	if not shaft or not cup then
		toolInfos[tool] = false
		return nil
	end
	local shaftAxis = (shaft :: Vector3).Unit
	local left = vecAttr(handle, "LeftHand")
	local twoHanded = (tool:GetAttribute("TwoHanded") == true or handle:GetAttribute("TwoHanded") == true)
		and left ~= nil
	local info: ToolInfo = {
		Tool = tool,
		Handle = handle,
		TwoHanded = twoHanded,
		Shaft = shaftAxis,
		Cup = (cup :: Vector3).Unit,
		Left = left,
		Blade = vecAttr(handle, "BladePoint") or shaftAxis * 3,
	}
	toolInfos[tool] = info
	return info
end

local function heldShovel(character: Model): Tool?
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("ShovelId") ~= nil then
			return child
		end
	end
	return nil
end

-- Palm frame of the right hand (RightGrip weld C0) and the tool grip (C1).
local function gripFrames(rig: Rig, info: ToolInfo): (CFrame, CFrame)
	local weld = rig.RightHand:FindFirstChild("RightGrip")
	if weld and weld:IsA("Weld") and weld.Part1 == info.Handle then
		return weld.C0, weld.C1
	end
	local attachment = rig.RightHand:FindFirstChild("RightGripAttachment")
	local c0 = if attachment and attachment:IsA("Attachment")
		then attachment.CFrame
		else CFrame.new(0, -rig.RightHand.Size.Y / 2, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
	return c0, info.Tool.Grip
end

local function palmPoint(hand: BasePart, attachmentName: string): Vector3
	local attachment = hand:FindFirstChild(attachmentName)
	if attachment and attachment:IsA("Attachment") then
		return attachment.Position
	end
	return V3(0, -hand.Size.Y / 2, 0)
end

-- Writing Transforms --------------------------------------------------------------------------

local function write(state: CharState, m: Joint, target: CFrame, weight: number)
	if not table.find(state.Touched, m) then
		table.insert(state.Touched, m)
	end
	m.Transform = if weight >= 0.999 then target else m.Transform:Lerp(target, weight)
end

local function release(state: CharState)
	for _, m in state.Touched do
		if m.Parent then
			m.Transform = CFrame.identity
		end
	end
	table.clear(state.Touched)
	for weld, original in state.Grips do
		if weld.Parent then
			weld.C1 = original
		end
	end
	table.clear(state.Grips)
	state.Weight = 0
	state.Posed = false
end

type ArmSolve = { Upper: CFrame, Lower: CFrame, Wrist: Vector3 }

-- Arm geometry, all from the rig: shoulder joint point in UpperArm space (sh.C1), elbow joint
-- frame J = el.C0 (UpperArm space; the R15 elbow is a hinge about J's X axis), and the arm's end
-- point u relative to J (el.C1:Inverse() * endLocal, endLocal in LowerArm space). With the elbow
-- bent by theta the end sits at J * Rx(theta) * u, so its distance from the shoulder joint is
--   |Rx(theta) u - a|^2 = |u|^2 + |a|^2 - 2 a.X u.X - 2 |a_yz| |u_yz| cos(theta + delta)
-- with a = shoulder point in J space and delta = angle(u_yz) - angle(a_yz) (angles measured in
-- J's YZ plane, the plane Rx rotates). That gives theta in closed form for a wanted distance.
type ArmGeometry = { A: Vector3, U: Vector3, Ryz: number, Delta: number }

local function armGeometry(sh: Joint, el: Joint, endLocal: Vector3): ArmGeometry
	local u = el.C1:Inverse() * endLocal
	local a = el.C0:PointToObjectSpace(sh.C1.Position)
	return {
		A = a,
		U = u,
		Ryz = math.sqrt(a.Y * a.Y + a.Z * a.Z) * math.sqrt(u.Y * u.Y + u.Z * u.Z),
		Delta = math.atan2(u.Z, u.Y) - math.atan2(a.Z, a.Y),
	}
end

-- Longest shoulder -> end distance (elbow as straight as the rig allows).
local function maxReach(geo: ArmGeometry): number
	local u, a = geo.U, geo.A
	return math.sqrt(math.max(0, u:Dot(u) + a:Dot(a) - 2 * a.X * u.X + 2 * geo.Ryz))
end

local function wrapAngle(x: number): number
	return (x + math.pi) % (2 * math.pi) - math.pi
end

-- Elbow flexion (radians about the hinge X; positive swings the forearm forward) for a wanted
-- shoulder -> end distance. Of the two mirror solutions, the one that bends the elbow forward.
local function elbowAngle(geo: ArmGeometry, dist: number): number
	if geo.Ryz < 1e-6 then
		return 0
	end
	local u, a = geo.U, geo.A
	local k = (u:Dot(u) + a:Dot(a) - dist * dist - 2 * a.X * u.X) / (2 * geo.Ryz)
	local base = math.acos(math.clamp(k, -1, 1))
	local c1 = wrapAngle(base - geo.Delta)
	local c2 = wrapAngle(-base - geo.Delta)
	local function cost(x: number): number
		return if x < -0.05 then -0.05 - x elseif x > ELBOW_MAX then x - ELBOW_MAX else 0
	end
	local k1, k2 = cost(c1), cost(c2)
	if k1 == k2 then
		return math.min(c1, c2)
	end
	return if k1 < k2 then c1 else c2
end

-- Solves an arm so its end point (endLocal, LowerArm space) reaches `target` (U space):
-- 1. elbow angle from the distance, 2. rotate the whole arm about the shoulder joint so the
-- shoulder->end vector points at the target, choosing the twist that turns the back of the
-- upper arm (+Z, where the elbow tip points) towards `pole`. Out of reach: the arm straightens
-- and the reached end point is returned.
local function solveArm(sh: Joint, el: Joint, endLocal: Vector3, target: Vector3, pole: Vector3): ArmSolve
	local geo = armGeometry(sh, el, endLocal)
	local s = sh.C0.Position -- shoulder joint, U space
	local sUpper = sh.C1.Position -- shoulder joint, UpperArm space
	local d = target - s
	local dist = d.Magnitude
	local dir = if dist > 1e-4 then d / dist else V3(0, -1, 0)
	local theta = elbowAngle(geo, dist)
	local bent = el.C0 * CFrame.Angles(theta, 0, 0) -- elbow joint frame after flexion (UpperArm space)
	local v = bent * geo.U - sUpper -- shoulder -> end, UpperArm space
	local r1 = align(v, Vector3.zAxis, dir, pole)
	local upper = CFrame.new(s - r1 * sUpper) * r1
	local lower = upper * bent * el.C1:Inverse()
	return { Upper = upper, Lower = lower, Wrist = s + dir * v.Magnitude }
end

local function applyArm(state: CharState, sh: Joint, el: Joint, wr: Joint, arm: ArmSolve, hand: CFrame, w: number)
	write(state, sh, sh.C0:Inverse() * arm.Upper * sh.C1, w)
	write(state, el, el.C0:Inverse() * arm.Upper:Inverse() * arm.Lower * el.C1, w)
	write(state, wr, wr.C0:Inverse() * arm.Lower:Inverse() * hand * wr.C1, w)
end

local function armLength(sh: Joint, el: Joint, wr: Joint, palm: Vector3): number
	return (el.C0.Position - sh.C1.Position).Magnitude
		+ (wr.C0.Position - el.C1.Position).Magnitude
		+ (palm - wr.C1.Position).Magnitude
end

-- Tool rotation (torso space) for a pose: shaft along pose.Shaft, cupped face up, rolled.
local function toolRotation(info: ToolInfo, pose: Pose): CFrame
	local shaft = pose.Shaft.Unit
	local up = Vector3.yAxis - shaft * shaft.Y
	if up.Magnitude < 0.2 then
		up = -Vector3.zAxis - shaft * -shaft.Z
	end
	local cup = CFrame.fromAxisAngle(shaft, pose.Roll) * up.Unit
	return align(info.Shaft, info.Cup, shaft, cup)
end

-- R6, hand tools: swing the one-piece arm forward about the shoulder by the pose's pitch (the
-- angle of pose.Hand in front of straight down), then re-aim the grip weld so the shaft points
-- along pose.Shaft from the palm. All in Torso space.
local function applyPoseR6(state: CharState, rig: R6Rig, info: ToolInfo, pose: Pose, weight: number): boolean
	local weld = rig.RightArm:FindFirstChild("RightGrip")
	if not (weld and weld:IsA("Weld") and weld.Part1 == info.Handle) then
		return false
	end
	local rs = rig.RightShoulder
	local pitch = math.atan2(-pose.Hand.Z, math.max(-pose.Hand.Y, 0.05))
	local pivot = rs.C0.Position
	local arm = CFrame.new(pivot) * CFrame.Angles(pitch, 0, 0) * CFrame.new(-pivot) * rs.C0 * rs.C1:Inverse()
	write(state, rs, rs.C0:Inverse() * arm * rs.C1, weight)

	local original = state.Grips[weld] or weld.C1
	state.Grips[weld] = original
	local palm = arm * weld.C0
	local rot = toolRotation(info, pose)
	local handle = CFrame.new(palm.Position - rot * original.Position) * rot
	local c1 = handle:Inverse() * palm -- weld rule: Arm * C0 == Handle * C1
	weld.C1 = if weight >= 0.999 then c1 else original:Lerp(c1, weight)
	return true
end

-- Poses one character. Returns false if the pose could not be solved (nothing written).
local function applyPose(state: CharState, rig: Rig, info: ToolInfo, pose: Pose, weight: number): boolean
	local rs, re, rw = rig.RightShoulder, rig.RightElbow, rig.RightWrist
	local gripC0, grip = gripFrames(rig, info)
	local rightPalm = gripC0.Position
	local shoulder = rs.C0.Position
	local reach = armLength(rs, re, rw, rightPalm)

	-- 2. Wanted tool CFrame (U space): shaft along pose.Shaft, cupped face up, rolled.
	local rot = toolRotation(info, pose)
	local palmTarget = shoulder + pose.Hand * reach
	if not isFinite(palmTarget) then
		return false
	end
	local handle = CFrame.new(palmTarget - rot * grip.Position) * rot
	local hand = handle * grip * gripC0:Inverse()

	-- 3. Right arm IK to the wrist point of that hand.
	local wristTarget = hand * rw.C1.Position
	local right = solveArm(rs, re, rw.C0.Position, wristTarget, if info.TwoHanded then RIGHT_POLE else ONE_HAND_POLE)
	local slip = right.Wrist - wristTarget -- non-zero only when out of reach
	hand += slip
	handle += slip
	if not isFinite(right.Wrist) then
		return false
	end
	applyArm(state, rs, re, rw, right, hand, weight)

	-- 4. Left hand on the shaft.
	local left = info.Left
	if info.TwoHanded and left then
		local ls, le, lw = rig.LeftShoulder, rig.LeftElbow, rig.LeftWrist
		local lPalmHand = palmPoint(rig.LeftHand, "LeftGripAttachment")
		local lShoulder = ls.C0.Position
		-- Forearm + hand as one straight bone: the palm in LowerArm space with the wrist at rest.
		local wristRest = lw.C0 * lw.C1:Inverse()
		local lEnd = wristRest * lPalmHand
		local lReach = maxReach(armGeometry(ls, le, lEnd)) * LEFT_REACH
		local gripPoint = handle * grip.Position
		local axis = handle:VectorToWorldSpace(info.Shaft)
		local want = (handle * left - gripPoint):Dot(axis)
		-- Sphere (left reach) / shaft line intersection: |q + axis * t| = lReach.
		local q = gripPoint - lShoulder
		local b = q:Dot(axis)
		local disc = b * b - (q:Dot(q) - lReach * lReach)
		local t = want
		if disc >= 0 then
			local far = -b + math.sqrt(disc)
			if t > far then
				t = math.max(far, LEFT_MIN_SPACING)
			end
		else
			t = math.min(want, LEFT_MIN_SPACING)
		end
		local leftTarget = gripPoint + axis * t
		local leftArm = solveArm(ls, le, lEnd, leftTarget, LEFT_POLE)
		local leftHand = leftArm.Lower * wristRest
		-- Twist the hand about its own axis so the fist axis (hand -Z) runs along the shaft.
		local localAxis = leftHand:VectorToObjectSpace(axis)
		if localAxis.X * localAxis.X + localAxis.Z * localAxis.Z > 0.05 then
			local twist = math.atan2(-localAxis.X, -localAxis.Z)
			if twist > math.pi / 2 then
				twist -= math.pi
			elseif twist < -math.pi / 2 then
				twist += math.pi
			end
			local pivot = lw.C1.Position
			leftHand = leftHand * CFrame.new(pivot) * CFrame.Angles(0, twist, 0) * CFrame.new(-pivot)
		end
		applyArm(state, ls, le, lw, leftArm, leftHand, weight)
	end

	-- 5. Waist twist / lean, head counter-rotation.
	local waist = CFrame.Angles(-pose.Lean, 0, 0) * CFrame.Angles(0, -pose.Yaw, 0)
	write(state, rig.Waist, waist, weight)
	local neck = rig.Neck
	if neck then
		write(
			state,
			neck,
			CFrame.Angles(0, pose.Yaw, 0) * CFrame.Angles(pose.Lean * (1 - HEAD_LEAN_FOLLOW), 0, 0),
			weight
		)
	end
	return true
end

-- Sand clump --------------------------------------------------------------------------------------

local function lowGraphics(): boolean
	return State.GetSetting("LowGraphics", false) == true
end

local function getFolder(): Folder
	local folder = effectsFolder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "ShovelEffects"
	f.Parent = Workspace
	effectsFolder = f
	return f
end

local function layerColorAt(character: Model): Color3
	local root = character:FindFirstChild("HumanoidRootPart")
	local depth = 0
	if root and root:IsA("BasePart") then
		depth = math.max(0, Config.SURFACE_Y - (root.Position.Y - 3))
	end
	local layer = Config.Layers[Config.GetLayerIndexAtDepth(depth)] or Config.Layers[1]
	return layer.Color
end

local function bladeCFrame(info: ToolInfo): CFrame
	return info.Handle.CFrame * CFrame.new(info.Blade)
end

local function spawnClump(state: CharState, info: ToolInfo, color: Color3)
	if lowGraphics() then
		return
	end
	-- bigger shovels scoop visibly bigger clumps (ItemStats.Heft), for every player's scoops
	local heft = ItemStats.Heft(tostring(info.Tool:GetAttribute("ShovelId")))
	local size = (if info.TwoHanded then CLUMP_SIZE.Two else CLUMP_SIZE.One) * heft
	local clump = Instance.new("Part")
	clump.Name = "SandClump"
	clump.Shape = Enum.PartType.Ball
	clump.Size = V3(size, size * 0.8, size)
	clump.Color = color
	clump.Material = Enum.Material.Sand
	clump.Anchored = true
	clump.CanCollide = false
	clump.CanQuery = false
	clump.CanTouch = false
	clump.CastShadow = false
	clump.CFrame = bladeCFrame(info)
	clump.Parent = getFolder()
	state.Clump = clump
end

local function tossClump(state: CharState, character: Model)
	if not state.Clump then
		return
	end
	local clump = state.Clump :: BasePart
	state.Clump = nil
	local root = character:FindFirstChild("HumanoidRootPart")
	local velocity = if root and root:IsA("BasePart")
		then root.CFrame:VectorToWorldSpace(CLUMP_TOSS_VELOCITY)
		else V3(0, CLUMP_TOSS_VELOCITY.Y, 0)
	clump.Anchored = false
	clump.AssemblyLinearVelocity = velocity
	clump.AssemblyAngularVelocity = V3(math.random() * 8, math.random() * 8, math.random() * 8)
	Debris:AddItem(clump, CLUMP_LIFETIME)
end

-- Per-frame update -------------------------------------------------------------------------------

local function getState(character: Model): CharState
	local state = states[character]
	if not state then
		local s: CharState = {
			Rig = nil,
			R6 = nil,
			Grips = {},
			RigCheckedAt = -math.huge,
			Info = nil,
			Weight = 0,
			Touched = {},
			Pose = nil,
			Scoop = nil,
			Clump = nil,
			Posed = false,
		}
		states[character] = s
		state = s
	end
	return state :: CharState
end

-- Studio only: one Output line per character whenever its pose status changes, so a playtest
-- shows whether the shovel pose runs and, if not, why (v2.2 playtest: the spade kept the
-- default hold on the owner's avatar and nothing said why).
local lastStatus: { [Model]: string } = setmetatable({}, { __mode = "k" }) :: any
local function report(character: Model, status: string, isProblem: boolean)
	if not RunService:IsStudio() or lastStatus[character] == status then
		return
	end
	lastStatus[character] = status
	local line = "[ShovelPose] " .. character.Name .. ": " .. status
	if isProblem then
		warn(line)
	else
		print(line)
	end
end

-- The character's R15 rig, or (when it has none) its R6 rig.
local function getRig(state: CharState, character: Model, now: number): (Rig?, R6Rig?)
	local rig = state.Rig
	if rig and rigAlive(rig) then
		return rig, nil
	end
	local r6 = state.R6
	if r6 and r6.RightShoulder.Parent ~= nil and r6.Humanoid.Parent ~= nil then
		return nil, r6
	end
	state.Rig = nil
	state.R6 = nil
	if now - state.RigCheckedAt < 1 then
		return nil, nil
	end
	state.RigCheckedAt = now
	local rig15, why = resolveRig(character)
	state.Rig = rig15
	state.R6 = if rig15 then nil else resolveR6(character)
	if not rig15 and not state.R6 then
		report(character, "can't pose the shovel: " .. (why or "unknown rig"), true)
	end
	return state.Rig, state.R6
end

local function updateCharacter(character: Model, now: number, dt: number)
	local state = getState(character)
	local tool = heldShovel(character)
	local found = if tool then getToolInfo(tool) else nil
	local foundRig, foundR6 = nil, nil
	if found then
		foundRig, foundR6 = getRig(state, character, now)
	end
	if found and found.TwoHanded then
		foundR6 = nil -- R6 + full-size shovel: plain grip
	end
	if found ~= state.Info then
		if state.Clump then
			tossClump(state, character)
		end
		state.Info = found
		state.Scoop = nil
		release(state)
	end
	if not found or not (foundRig or foundR6) then
		if state.Posed then
			release(state)
		end
		return
	end
	local info = found :: ToolInfo
	local humanoid = if foundRig then foundRig.Humanoid else (foundR6 :: R6Rig).Humanoid
	if humanoid.Health <= 0 or humanoid.Sit then
		if state.Posed then
			release(state)
		end
		return
	end

	local scoop = state.Scoop
	local alpha = 1
	if scoop then
		alpha = (now - scoop.Start) / scoop.Duration
		if alpha >= 1 then
			state.Scoop = nil
			if state.Clump then
				tossClump(state, character)
			end
			scoop = nil
		end
	end

	-- Both holds are posed all the time while the shovel is out (blended in on equip).
	state.Weight = math.min(1, state.Weight + dt / TWO_HAND_BLEND_TIME)
	local weight = state.Weight
	local rest = if info.TwoHanded then TWO_HAND_REST else ONE_HAND_REST
	local pose: Pose = if scoop then sample(scoop.Keys, alpha) else rest

	state.Pose = pose
	local posed = if foundRig
		then applyPose(state, foundRig, info, pose, weight)
		else applyPoseR6(state, foundR6 :: R6Rig, info, pose, weight)
	if posed then
		state.Posed = true
		report(
			character,
			"posing "
				.. (if info.TwoHanded then "two-handed" else "one-handed")
				.. (if foundRig then " (R15)" else " (R6)"),
			false
		)
	else
		report(character, "pose could not be solved for this avatar", true)
	end

	-- sand clump rides the blade between the thrust and the toss
	if scoop and not scoop.ClumpDone then
		local pickup = if info.TwoHanded then CLUMP_PICKUP_T.Two else CLUMP_PICKUP_T.One
		if alpha >= pickup then
			scoop.ClumpDone = true
			if state.Clump then
				tossClump(state, character)
			end
			spawnClump(state, info, scoop.Color or layerColorAt(character))
		end
	end
	if state.Clump and scoop then
		local toss = if info.TwoHanded then CLUMP_TOSS_T.Two else CLUMP_TOSS_T.One
		if alpha >= toss then
			tossClump(state, character)
		end
	end
end

local function onStepped(_time: number, dt: number)
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character then
			local ok, err = pcall(function(): any
				updateCharacter(character, now, dt)
				return nil
			end)
			if not ok then
				warn("[ShovelPose] " .. tostring(err))
				local state = states[character]
				if state then
					state.Scoop = nil
					release(state)
				end
			end
		end
	end
end

-- Riding clumps follow the blade after physics has moved the arms this frame.
local function onHeartbeat()
	for character, state in states do
		local clump = state.Clump
		local info = state.Info
		if clump and info then
			if info.Handle.Parent and character.Parent then
				clump.CFrame = bladeCFrame(info)
			else
				tossClump(state, character)
			end
		end
	end
end

-- Public API --------------------------------------------------------------------------------------

local function scoopDuration(cooldown: number): number
	return math.clamp(cooldown * SCOOP_COOLDOWN_FRACTION, SCOOP_MIN_TIME, SCOOP_MAX_TIME)
end

local function legacySwing(character: Model)
	-- R6 / unposable rigs: the default Animate script plays its slash when it sees this value.
	local tool = heldShovel(character)
	if tool and character == (Players.LocalPlayer and Players.LocalPlayer.Character) then
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
	end
end

-- Plays one scoop on `character` (default: the local player's). `cooldown` = the shovel's dig
-- cooldown (sets the scoop length); `color` = sand colour of the clump (default: the layer
-- under the character).
function ShovelPoseController.PlayScoop(character: Model?, cooldown: number?, color: Color3?): boolean
	local localPlayer = Players.LocalPlayer
	local target = character or (localPlayer and localPlayer.Character)
	if not target then
		return false
	end
	local char = target :: Model
	local tool = heldShovel(char)
	local found = if tool then getToolInfo(tool) else nil
	local now = os.clock()
	local state = getState(char)
	local rig, r6 = nil, nil
	if found then
		rig, r6 = getRig(state, char, now)
	end
	if not found or not (rig or (r6 and not found.TwoHanded)) then
		legacySwing(char)
		return false
	end
	local info = found :: ToolInfo
	local cd = cooldown
	if cd == nil then
		local def = Config.GetShovel(tostring((tool :: Tool):GetAttribute("ShovelId")))
		cd = if def then def.Cooldown else 0.4
	end
	local duration = scoopDuration(cd :: number)
	local template = if info.TwoHanded
		then (if duration < SCOOP_FAST_BELOW then TWO_HAND_FAST else TWO_HAND_SCOOP)
		else (if duration < SCOOP_FAST_BELOW then ONE_HAND_FAST else ONE_HAND_SCOOP)
	local keys = table.clone(template)
	local running = state.Scoop ~= nil
	local current = state.Pose
	if running and current then
		keys[1] = { T = 0, Pose = current } -- continue from where the arms are now
	end
	if state.Clump then
		tossClump(state, char)
	end
	state.Info = info
	state.Scoop = {
		Start = now,
		Duration = duration,
		Keys = keys,
		BlendIn = not (running and current ~= nil),
		Color = color,
		ClumpDone = false,
	}
	return true
end

function ShovelPoseController.IsScooping(character: Model?): boolean
	local localPlayer = Players.LocalPlayer
	local target = character or (localPlayer and localPlayer.Character)
	local state = if target then states[target] else nil
	return state ~= nil and state.Scoop ~= nil
end

-- For tests / debugging.
function ShovelPoseController.GetDebug(
	character: Model?
): { Posed: boolean, TwoHanded: boolean, Weight: number, Scooping: boolean }?
	local localPlayer = Players.LocalPlayer
	local target = character or (localPlayer and localPlayer.Character)
	local found = if target then states[target] else nil
	if not found then
		return nil
	end
	local state = found :: CharState
	local info = state.Info
	return {
		Posed = state.Posed,
		TwoHanded = info ~= nil and info.TwoHanded,
		Weight = state.Weight,
		Scooping = state.Scoop ~= nil,
	}
end

function ShovelPoseController.Init()
	RunService.Stepped:Connect(onStepped)
	RunService.Heartbeat:Connect(onHeartbeat)
	task.spawn(function()
		Remotes.Get("Scoop").OnClientEvent:Connect(function(player: any)
			if typeof(player) ~= "Instance" or not (player :: Instance):IsA("Player") then
				return
			end
			local character = (player :: Player).Character
			if character then
				ShovelPoseController.PlayScoop(character)
			end
		end)
	end)
end

return ShovelPoseController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[--!strict
-- Plays Config.Sounds by key (skips entries whose Id is ""), honours the SFX / Music settings.
-- Music: "MusicBeach" / "MusicDeep" by depth (Music setting). Ambience: the looping beach bed
-- plays only near the surface and follows the SFX setting; both stay silent until ids exist.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local State = require(script.Parent.State)

local SoundController = {}

local folder: Folder? = nil
local cache: { [string]: Sound } = {}
local currentMusic: string? = nil
local musicSound: Sound? = nil
local wantedMusic = "MusicBeach"
local ambienceWanted = true -- at the surface (LayerController)
local ambienceSound: Sound? = nil

local function getFolder(): Folder
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "ClientSounds"
		f.Parent = SoundService
		folder = f
	end
	return folder :: Folder
end

local function getSound(name: string): Sound?
	local def = Config.Sounds[name]
	if not def or def.Id == "" then
		return nil
	end
	local sound = cache[name]
	if not sound then
		local s = Instance.new("Sound")
		s.Name = name
		s.SoundId = def.Id
		s.Volume = def.Volume
		s.PlaybackSpeed = def.PlaybackSpeed
		s.Looped = def.Looped
		s.Parent = getFolder()
		cache[name] = s
		sound = s
	end
	return sound
end

-- pitch: multiplier on the configured PlaybackSpeed (adds variety to repeated sounds).
function SoundController.Play(name: string, pitch: number?, volume: number?)
	if State.GetSetting("SFX", true) == false then
		return
	end
	local sound = getSound(name)
	if sound then
		local def = Config.Sounds[name]
		sound.PlaybackSpeed = def.PlaybackSpeed * (pitch or 1)
		sound.Volume = def.Volume * (volume or 1)
		SoundService:PlayLocalSound(sound)
	end
end

local function refreshMusic()
	local enabled = State.GetSetting("Music", true) ~= false
	local target = if enabled then wantedMusic else nil
	if target == currentMusic then
		return
	end
	if musicSound then
		musicSound:Stop()
	end
	currentMusic = target
	musicSound = nil
	if target then
		local sound = getSound(target)
		if sound then
			musicSound = sound
			sound:Play()
		end
	end
end

local function refreshAmbience()
	local play = ambienceWanted and State.GetSetting("SFX", true) ~= false
	local sound = if play then getSound("Ambience") else nil
	if sound == ambienceSound then
		return
	end
	if ambienceSound then
		ambienceSound:Stop()
	end
	ambienceSound = sound
	if sound then
		sound:Play()
	end
end

-- "MusicBeach" near the surface, "MusicDeep" underground (LayerController decides).
function SoundController.SetMusic(name: string)
	wantedMusic = name
	refreshMusic()
end

-- Beach ambience on near the surface, off underground (LayerController decides).
function SoundController.SetAmbience(on: boolean)
	ambienceWanted = on
	refreshAmbience()
end

-- What is looping right now (tests / diagnostics).
function SoundController.Playing(): { Music: string?, Ambience: boolean }
	return { Music = if musicSound then currentMusic else nil, Ambience = ambienceSound ~= nil }
end

function SoundController.Init()
	State.Changed("Settings"):Connect(function()
		refreshMusic()
		refreshAmbience()
	end)
	refreshMusic()
	refreshAmbience()
end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--!strict
--[[
	State — client-side store (DataStore-like) of everything the UI renders:
	- Data: merged Types.PlayerData (full snapshot from DataChanged/GetData, then {key=value} deltas)
	- Passes: owned game passes by Config.Monetization key (GetOwnedPasses + purchase events)
	- Dig zone: the shared diggable beach strip, from Workspace attributes "DigZoneCFrame" /
	  "DigZoneSize" set by the server's World (State.GetDigZone / InDigZone / NearestSand)
	- ActiveEvents: active event ids (EventChanged / Workspace attribute "ActiveEvents")
	- PaidRandomRestricted (v2.2): Player attribute set by the server's PolicyService. true until
	  the server says false, so paid random items (Config.IsPaidRandom) never flash on screen for
	  players who may not see them. State.GetStatsContext() feeds Util/Stats (true luck + odds).

	Every key has its own Changed signal: State.Changed("Coins"):Connect(fn(new, old)).
	State.Observe(key, fn) calls fn right away with the current value and again on every change,
	so UI built before the data arrives fixes itself when it does (robust to late data).
	Data starts as Config.NewPlayerData() so nothing ever indexes nil.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Stats = require(Shared:WaitForChild("Util"):WaitForChild("Stats"))
local Signal = require(script.Parent.Parent.Util.Signal)

type Signal = Signal.Signal
type Connection = Signal.Connection

local State = {}

State.Data = Config.NewPlayerData()
State.Loaded = false
State.Passes = {} :: { [string]: boolean }
State.ActiveEvents = {} :: { string }
State.PaidRandomRestricted = true -- v2.2: until PolicyService's attribute says false

State.LoadedSignal = Signal.new() -- fired once when the first real data arrives
State.AnyChanged = Signal.new() -- (key, new, old)

local SPECIAL_KEYS = { Passes = true, ActiveEvents = true, PaidRandomRestricted = true }

local signals: { [string]: Signal } = {}
local gotSnapshot = false
local initialized = false

function State.Changed(key: string): Signal
	local signal = signals[key]
	if not signal then
		signal = Signal.new()
		signals[key] = signal
	end
	return signal
end

function State.Get(key: string): any
	if SPECIAL_KEYS[key] then
		return (State :: any)[key]
	end
	return (State.Data :: any)[key]
end

local function set(key: string, value: any)
	local old = State.Get(key)
	if SPECIAL_KEYS[key] then
		(State :: any)[key] = value
	else
		(State.Data :: any)[key] = value
	end
	local signal = signals[key]
	if signal then
		signal:Fire(value, old)
	end
	State.AnyChanged:Fire(key, value, old)
end

-- Calls fn(value) now and on every change. Returns the connection.
function State.Observe(key: string, fn: (any, any) -> ()): Connection
	task.spawn(fn, State.Get(key), nil)
	return State.Changed(key):Connect(fn)
end

-- Calls fn() now and whenever ANY of the keys change (coalesced to once per frame).
function State.ObserveMany(keys: { string }, fn: () -> ()): { Connection }
	local queued = false
	local function schedule()
		if queued then
			return
		end
		queued = true
		task.defer(function()
			queued = false
			fn()
		end)
	end
	local connections = {}
	for _, key in keys do
		table.insert(connections, State.Changed(key):Connect(schedule))
	end
	task.spawn(fn)
	return connections
end

local function markLoaded()
	if not State.Loaded then
		State.Loaded = true
		State.LoadedSignal:Fire(State.Data)
	end
end

-- Merge a full snapshot or partial delta into State.Data.
function State.Apply(delta: { [string]: any })
	for key, value in delta do
		if typeof(key) == "string" then
			set(key, value)
		end
	end
end

-- Resolves immediately when loaded, otherwise yields until the first data arrives.
function State.WaitForData(): Types.PlayerData
	if not State.Loaded then
		State.LoadedSignal:Wait()
	end
	return State.Data
end

-- Passes ------------------------------------------------------------------------------------

function State.OwnsPass(key: string): boolean
	return State.Passes[key] == true
end

-- v2.2 Rebirth perks (Config.RebirthPerks): level of a perk (0 = not bought).
function State.PerkLevel(perkId: string): number
	return Config.RebirthPerks.Level(State.Data.RebirthPerks, perkId)
end

-- Sell Anywhere: the game pass OR the earned rebirth perk (server: EconomyService.CanSellAnywhere).
function State.CanSellAnywhere(): boolean
	return State.OwnsPass("SellAnywhere") or Config.RebirthPerks.HasSellAnywhere(State.Data.RebirthPerks)
end

function State.SetPassOwned(key: string, owned: boolean)
	local copy = table.clone(State.Passes)
	copy[key] = owned
	set("Passes", copy)
end

function State.RefreshPasses()
	task.spawn(function()
		local ok, result = pcall(function()
			return Remotes.GetFunction("GetOwnedPasses"):InvokeServer()
		end)
		if ok and typeof(result) == "table" then
			local passes: { [string]: boolean } = {}
			for key, owned in result do
				if typeof(key) == "string" then
					passes[key] = owned == true
				end
			end
			set("Passes", passes)
		end
	end)
end

-- Settings ----------------------------------------------------------------------------------

function State.GetSetting(key: string, default: any): any
	local value = State.Data.Settings and State.Data.Settings[key]
	if value == nil then
		return default
	end
	return value
end

-- Optimistic: updates the local copy immediately, then tells the server.
function State.SetSetting(key: string, value: any)
	local settings = table.clone(State.Data.Settings or {})
	settings[key] = value
	set("Settings", settings)
	task.spawn(function()
		Remotes.Get("SetSetting"):FireServer(key, value)
	end)
end

-- Derived values ------------------------------------------------------------------------------

function State.ServerNow(): number
	return Workspace:GetServerTimeNow()
end

function State.GetShovel(): Types.ShovelDef
	return Config.GetShovel(State.Data.Shovel) or Config.Shovels[1]
end

function State.GetBackpack(): Types.BackpackDef
	return Config.GetBackpack(State.Data.Backpack) or Config.Backpacks[1]
end

-- Last effective capacity reported by the server (DigResult.Capacity). Preferred over the
-- local estimate because the server may apply bonuses the client doesn't know about.
State.ServerCapacity = nil :: number?

function State.GetCapacity(): number
	local serverCapacity = State.ServerCapacity
	if serverCapacity then
		return serverCapacity
	end
	local mega = if State.OwnsPass("MegaBackpack")
		then (Config.Monetization.GamePasses.MegaBackpack.CapacityMultiplier or 2)
		else 1
	local pockets = Config.RebirthPerks.CapacityFactor(State.Data.RebirthPerks) -- v2.2 Deep Pockets
	return math.floor(State.GetBackpack().Capacity * Config.RebirthMultiplier(State.Data.Rebirths) * mega * pockets)
end

function State.GetEquippedPetIds(): { string }
	local ids = {}
	local pets = State.Data.Pets
	if pets then
		for _, pet in pets do
			if pet.Equipped then
				table.insert(ids, pet.Id)
			end
		end
	end
	return ids
end

-- Base PetSlots + every owned pass's ExtraPetSlots (ExtraPets +2, AutoDig +1), like Stats.GetPetSlots.
function State.GetPetSlots(): number
	local extra = 0
	for key, pass in Config.Monetization.GamePasses do
		if pass.ExtraPetSlots and State.OwnsPass(key) then
			extra += pass.ExtraPetSlots
		end
	end
	extra += Config.RebirthPerks.ExtraPetSlots(State.Data.RebirthPerks) -- v2.2 Pet Den perk
	return (State.Data.PetSlots or Config.MAX_EQUIPPED_PETS) + extra
end

function State.GetPetMultiplier(): number
	local ids = {}
	local golden: { [number]: boolean } = {}
	for _, pet in State.Data.Pets or {} :: { [string]: Types.PetInstance } do
		if pet.Equipped then
			table.insert(ids, pet.Id)
			golden[#ids] = pet.Golden == true
		end
	end
	return Config.PetMultiplier(ids, golden)
end

-- v2.2: a Util/Stats context from the replicated state (same inputs the server uses), for true
-- odds / luck in the UI: Stats.GetLuck(State.GetStatsContext()).
function State.GetStatsContext(): Stats.Context
	local localPlayer = Players.LocalPlayer
	local friends = localPlayer:GetAttribute("FriendsInServer")
	return {
		Data = State.Data,
		Passes = State.Passes,
		IsPremium = localPlayer:GetAttribute("Premium") == true,
		InGroup = localPlayer:GetAttribute("InGroup") == true,
		FriendsInServer = if typeof(friends) == "number" then friends else 0,
		ActiveEvents = State.ActiveEvents,
		Now = State.ServerNow(),
	}
end

-- v2.2 policy: hide paid random items (Config.IsPaidRandom) for restricted players.
function State.IsPaidRandomRestricted(): boolean
	return State.PaidRandomRestricted ~= false
end

-- Can this pass / product be shown and prompted? kind: "GamePass" | "Product".
function State.CanBuy(kind: string, key: string): boolean
	return not (Config.IsPaidRandom(kind, key) and State.IsPaidRandomRestricted())
end

-- Seconds left on a boost (0 if inactive).
function State.GetBoostRemaining(boostId: string): number
	local expires = State.Data.Boosts and State.Data.Boosts[boostId]
	if not expires then
		return 0
	end
	return math.max(0, expires - State.ServerNow())
end

-- Local estimate of the dig cooldown (server is authoritative).
function State.GetCooldown(): number
	local cooldown = State.GetShovel().Cooldown
	for _, boost in Config.Boosts do
		if boost.Kind == "Speed" and State.GetBoostRemaining(boost.Id) > 0 then
			cooldown /= boost.Multiplier
		end
	end
	for key, pass in Config.Monetization.GamePasses do
		if pass.SpeedMultiplier and State.OwnsPass(key) then
			cooldown /= pass.SpeedMultiplier
		end
	end
	return cooldown
end

function State.IsEventActive(eventId: string): boolean
	return table.find(State.ActiveEvents, eventId) ~= nil
end

function State.SurfaceY(): number
	return Config.SURFACE_Y
end

-- The dig zone (CFrame at the centre of the flat surface, Size = X/Z footprint + depth), or nil
-- until the server's map attributes have replicated.
function State.GetDigZone(): (CFrame?, Vector3?)
	local cf = Workspace:GetAttribute("DigZoneCFrame")
	local size = Workspace:GetAttribute("DigZoneSize")
	if typeof(cf) == "CFrame" and typeof(size) == "Vector3" then
		return cf, size
	end
	return nil, nil
end

-- Is `position` (X/Z) inside the dig zone footprint (+ `margin` studs)? Unknown zone -> true
-- (let the server decide).
function State.InDigZone(position: Vector3, margin: number?): boolean
	local cf, size = State.GetDigZone()
	if not cf or not size then
		return true
	end
	local rel = (cf :: CFrame):PointToObjectSpace(position)
	local m = margin or 0
	return math.abs(rel.X) <= (size :: Vector3).X / 2 + m and math.abs(rel.Z) <= (size :: Vector3).Z / 2 + m
end

-- Closest surface point of the dig zone to `from`, `inset` studs inside its edges.
function State.NearestSand(from: Vector3, inset: number?): Vector3?
	local cf, size = State.GetDigZone()
	if not cf or not size then
		return nil
	end
	local zone = cf :: CFrame
	local half = (size :: Vector3) / 2
	local i = inset or 0
	local rel = zone:PointToObjectSpace(from)
	local x = math.clamp(rel.X, -math.max(0, half.X - i), math.max(0, half.X - i))
	local z = math.clamp(rel.Z, -math.max(0, half.Z - i), math.max(0, half.Z - i))
	return zone:PointToWorldSpace(Vector3.new(x, 0, z))
end

-- Init ----------------------------------------------------------------------------------------

local function parseEventAttribute()
	local value = Workspace:GetAttribute("ActiveEvents")
	if typeof(value) ~= "string" then
		return
	end
	local ids = {}
	for id in string.gmatch(value, "[^,%s]+") do
		table.insert(ids, id)
	end
	set("ActiveEvents", ids)
end

function State.Init()
	if initialized then
		return
	end
	initialized = true

	-- Events fired before we connect are queued by Roblox, so the snapshot is never lost.
	task.spawn(function()
		Remotes.Get("DataChanged").OnClientEvent:Connect(function(payload: any)
			if typeof(payload) ~= "table" then
				return
			end
			if payload.Version ~= nil and payload.FirstJoin ~= nil then
				gotSnapshot = true
			end
			State.Apply(payload)
			markLoaded()
		end)
	end)

	task.spawn(function()
		local getData = Remotes.GetFunction("GetData")
		for attempt = 1, 6 do
			if gotSnapshot then
				break
			end
			local ok, result = pcall(function()
				return getData:InvokeServer()
			end)
			if ok and typeof(result) == "table" then
				if not gotSnapshot then
					gotSnapshot = true
					State.Apply(result)
					markLoaded()
				end
				break
			end
			task.wait(attempt)
		end
	end)

	task.spawn(function()
		Remotes.Get("EventChanged").OnClientEvent:Connect(function(ids: any)
			if typeof(ids) == "table" then
				local list = {}
				for _, id in ids do
					if typeof(id) == "string" then
						table.insert(list, id)
					end
				end
				set("ActiveEvents", list)
			end
		end)
	end)

	-- equipment / rebirth / pass changes invalidate the server-reported capacity
	for _, key in { "Backpack", "Rebirths", "Passes", "RebirthPerks" } do
		State.Changed(key):Connect(function()
			State.ServerCapacity = nil
		end)
	end

	Workspace:GetAttributeChangedSignal("ActiveEvents"):Connect(parseEventAttribute)
	parseEventAttribute()

	-- The server checks pass ownership asynchronously after join (GetOwnedPasses may answer
	-- before that finished) and mirrors it as Player attributes "Pass_<Key>": follow them.
	local localPlayer = Players.LocalPlayer
	local function readPolicy()
		local restricted = localPlayer:GetAttribute("PaidRandomRestricted") ~= false
		if State.PaidRandomRestricted ~= restricted then
			set("PaidRandomRestricted", restricted)
		end
	end
	readPolicy()
	localPlayer.AttributeChanged:Connect(function(name: string)
		if name == "PaidRandomRestricted" then
			readPolicy()
		elseif string.sub(name, 1, 5) == "Pass_" then
			local key = string.sub(name, 6)
			local owned = localPlayer:GetAttribute(name) == true
			if State.OwnsPass(key) ~= owned then
				State.SetPassOwned(key, owned)
			end
		end
	end)

	State.RefreshPasses()
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">StatusController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	StatusController — overhead nameplates and worn-backpack sand level for EVERY player
	(v2.2 B6a / B6b, Status & Social agent).

	Nameplates are client-rendered (decision: no server GUI traffic, and each viewer can hide them
	with the "ShowNameplates" setting). Built from replicated Player attributes set by the
	server's StatusService / MonetizationService:
		TitleLayer   -> title + colour (Config.GetTitle; deepest layer ever reached)
		RebirthCount -> gold stars: "★★★" up to Config.Social.Nameplate.StarsInline, then "★x12"
		VIP / Premium -> small tag pill before the name (VIP wins)
	One BillboardGui "Nameplate" per character (kept in PlayerGui.Nameplates, Adornee = Head):
	MaxDistance 60, AlwaysOnTop false, sized in studs so it shrinks with distance, every text
	outlined (UI_STYLE), no emoji (★ is a plain text glyph). While nameplates are shown the
	default Roblox name above heads is hidden locally (Humanoid.DisplayDistanceType = None).

	Worn backpack (welded by the server, model "WornBackpack"): the "SandFill" part(s) scale with
	the owner's "BackpackFill" attribute (0..1) and turn gold when full. Local-only visual.

	v2.3 streaming: other players' characters stream out (far away) and back in as NEW parts.
	A 0.5 s reconcile re-adorns each plate to the current Head (plates whose Head is gone are just
	hidden by the engine) and re-applies the backpack fill when a new WornBackpack shows up, so
	no state depends on CharacterAdded firing again.

	Your own plate hides while a Reveal popup is up (SetOwnHidden, wired in Main.client): its
	rarity headline sits right where your nameplate floats in the default camera.

	API (tests): StatusController.StarsText(n), StatusController.Describe(player),
	             StatusController.GetPlate(player): BillboardGui?, StatusController.Refresh(),
	             StatusController.SetOwnHidden(hidden)
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local State = require(script.Parent.State)

local StatusController = {}

export type Description = {
	Name: string,
	Title: string,
	TitleColor: Color3,
	Stars: string, -- "" when no rebirths
	Tag: string?, -- "VIP" | "PREMIUM"
}

local NAMEPLATE = Config.Social.Nameplate
local Theme = Config.Theme
local STAR = "★"
local SETTING = "ShowNameplates"

type Plate = {
	Gui: BillboardGui,
	Stars: TextLabel,
	Name: TextLabel,
	Tag: TextLabel,
	Title: TextLabel,
}

local plates: { [Player]: Plate } = {}
local folder: Folder? = nil
local fillOriginals: { [BasePart]: { Size: Vector3, Color: Color3, Transparency: number } } = setmetatable(
	{},
	{ __mode = "k" }
) :: any

function StatusController.StarsText(rebirths: number): string
	local n = math.max(0, math.floor(rebirths))
	if n == 0 then
		return ""
	elseif n <= NAMEPLATE.StarsInline then
		return string.rep(STAR, n)
	end
	return STAR .. "x" .. n
end

local function numberAttr(player: Player, name: string): number
	local value = player:GetAttribute(name)
	return if typeof(value) == "number" then value else 0
end

function StatusController.Describe(player: Player): Description
	local layer = math.max(numberAttr(player, "TitleLayer"), 1)
	local title, color = Config.GetTitle(layer)
	local tag: string? = nil
	if player:GetAttribute("VIP") == true then
		tag = "VIP"
	elseif player:GetAttribute("Premium") == true then
		tag = "PREMIUM"
	end
	return {
		Name = player.DisplayName,
		Title = title,
		TitleColor = color,
		Stars = StatusController.StarsText(numberAttr(player, "RebirthCount")),
		Tag = tag,
	}
end

function StatusController.GetPlate(player: Player): BillboardGui?
	local plate = plates[player]
	return if plate then plate.Gui else nil
end

local function enabled(): boolean
	return State.GetSetting(SETTING, true) ~= false
end

local ownHidden = false

-- Whether this player's plate shows right now (setting, and your own plate during reveals).
local function plateOn(player: Player): boolean
	return enabled() and not (ownHidden and player == Players.LocalPlayer)
end

local function getFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "Nameplates"
	f.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	folder = f
	return f
end

local function text(parent: Instance, name: string, font: Enum.Font, color: Color3, stroke: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Font = font
	label.TextColor3 = color
	label.TextScaled = true
	label.Text = ""
	label.Parent = parent
	local s = Instance.new("UIStroke")
	s.Color = Theme.Colors.Stroke
	s.Thickness = stroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Parent = label
	return label
end

local function render(player: Player)
	local plate = plates[player]
	if not plate then
		return
	end
	local info = StatusController.Describe(player)
	plate.Stars.Text = info.Stars
	plate.Stars.Visible = info.Stars ~= ""
	plate.Name.Text = info.Name
	plate.Title.Text = info.Title
	plate.Title.TextColor3 = info.TitleColor
	local tag = info.Tag
	plate.Tag.Visible = tag ~= nil
	if tag then
		plate.Tag.Text = tag
		plate.Tag.BackgroundColor3 = if tag == "VIP" then Theme.Colors.Gold else Theme.Colors.Ocean
	end
	-- name shifts right to make room for the tag pill
	plate.Name.Position = if tag then UDim2.fromScale(0.29, 0.3) else UDim2.fromScale(0.02, 0.3)
	plate.Name.Size = if tag then UDim2.fromScale(0.69, 0.36) else UDim2.fromScale(0.96, 0.36)
	plate.Gui.Enabled = plateOn(player)
end

local function setDefaultName(character: Model?, hidden: boolean)
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid then
		humanoid.DisplayDistanceType = if hidden
			then Enum.HumanoidDisplayDistanceType.None
			else Enum.HumanoidDisplayDistanceType.Viewer
	end
end

local function removePlate(player: Player)
	local plate = plates[player]
	if plate then
		plate.Gui:Destroy()
		plates[player] = nil
	end
end

local function buildPlate(player: Player, head: BasePart)
	removePlate(player)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Nameplate_" .. player.UserId
	gui.Adornee = head
	gui.Size = UDim2.fromScale(6, 1.9) -- studs: shrinks with distance like the world
	gui.StudsOffset = Vector3.new(0, 2.7, 0)
	gui.MaxDistance = NAMEPLATE.MaxDistance
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Parent = getFolder()

	local stars = text(gui, "Stars", Theme.Fonts.Title, Theme.Colors.Gold, 2)
	stars.Size = UDim2.fromScale(1, 0.28)
	stars.Position = UDim2.fromScale(0, 0)

	local tag = text(gui, "Tag", Theme.Fonts.Title, Theme.Colors.Text, 1.5)
	tag.Size = UDim2.fromScale(0.25, 0.3)
	tag.Position = UDim2.fromScale(0.02, 0.33)
	tag.BackgroundTransparency = 0
	tag.Visible = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = tag
	local ring = Instance.new("UIStroke")
	ring.Color = Theme.Colors.Stroke
	ring.Thickness = 2
	ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ring.Parent = tag

	local name = text(gui, "PlayerName", Theme.Fonts.Title, Theme.Colors.Text, 2)
	local title = text(gui, "Title", Theme.Fonts.Title, Theme.Colors.Text, 2)
	title.Size = UDim2.fromScale(1, 0.3)
	title.Position = UDim2.fromScale(0, 0.68)

	plates[player] = { Gui = gui, Stars = stars, Name = name, Tag = tag, Title = title }
	render(player)
	setDefaultName(player.Character, enabled())
end

-- Worn backpack sand level -------------------------------------------------------------------------

local function applyFill(player: Player)
	local character = player.Character
	local found = if character then character:FindFirstChild("WornBackpack") else nil
	if found == nil then
		return
	end
	local pack = found :: Instance
	local fill = math.clamp(numberAttr(player, "BackpackFill"), 0, 1)
	for _, d in pack:GetDescendants() do
		if d:IsA("BasePart") and d.Name == "SandFill" then
			local original = fillOriginals[d]
			if not original then
				original = { Size = d.Size, Color = d.Color, Transparency = d.Transparency }
				fillOriginals[d] = original
			end
			assert(original) -- refine for the type checker (set above)
			d.Size = Vector3.new(original.Size.X, original.Size.Y * (0.25 + 0.75 * fill), original.Size.Z)
			d.Transparency = if fill <= 0 then 1 else original.Transparency
			d.Color = if fill >= 1 then Theme.Colors.Gold else original.Color
		end
	end
end

-- Characters ----------------------------------------------------------------------------------------

local function onCharacter(player: Player, character: Model)
	local function tryHead(): boolean
		local head = character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			buildPlate(player, head)
			return true
		end
		return false
	end
	if not tryHead() then
		local connection: RBXScriptConnection? = nil
		connection = character.ChildAdded:Connect(function(child: Instance)
			if child.Name == "Head" and tryHead() and connection then
				connection:Disconnect()
			end
		end)
	end
	character.ChildAdded:Connect(function(child: Instance)
		if child.Name == "WornBackpack" then
			task.defer(applyFill, player)
		elseif child:IsA("Humanoid") then
			setDefaultName(character, enabled())
		end
	end)
	applyFill(player)
end

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(function(character: Model)
		onCharacter(player, character)
	end)
	player.CharacterRemoving:Connect(function()
		removePlate(player)
	end)
	player.AttributeChanged:Connect(function(name: string)
		if name == "BackpackFill" then
			applyFill(player)
		elseif name == "TitleLayer" or name == "RebirthCount" or name == "VIP" or name == "Premium" then
			render(player)
		end
	end)
	if player.Character then
		onCharacter(player, player.Character)
	end
end

function StatusController.Refresh()
	local on = enabled()
	for player, plate in plates do
		plate.Gui.Enabled = plateOn(player)
		setDefaultName(player.Character, on)
	end
end

function StatusController.SetOwnHidden(hidden: boolean)
	if hidden == ownHidden then
		return
	end
	ownHidden = hidden
	local plate = plates[Players.LocalPlayer]
	if plate then
		plate.Gui.Enabled = plateOn(Players.LocalPlayer)
	end
end

-- v2.3 streaming: keep plates and backpack fills attached to the parts that exist right now.
local lastPack: { [Player]: Instance? } = setmetatable({}, { __mode = "k" }) :: any
local RECONCILE_INTERVAL = 0.5

function StatusController.Reconcile()
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local head = if character then character:FindFirstChild("Head") else nil
		if head and head:IsA("BasePart") then
			local plate = plates[player]
			if not plate then
				buildPlate(player, head)
			elseif plate.Gui.Adornee ~= head then
				plate.Gui.Adornee = head
				setDefaultName(character, enabled())
			end
		end
		local pack = if character then character:FindFirstChild("WornBackpack") else nil
		if pack ~= lastPack[player] then
			lastPack[player] = pack
			if pack then
				applyFill(player)
			end
		end
	end
end

function StatusController.Init()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt: number)
		elapsed += dt
		if elapsed >= RECONCILE_INTERVAL then
			elapsed = 0
			StatusController.Reconcile()
		end
	end)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(removePlate)
	State.Changed("Settings"):Connect(StatusController.Refresh)
end

return StatusController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">SurvivalController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	SurvivalController — client side of heat / shade / snacks (owner: Survival). UI-agnostic:
	SurvivalHUD and BeachShopPanel call into it.

	- Map prompts: parts tagged "WaterFountain" -> DrinkFountain remote, "BeachShop" -> opens
	  Panel "BeachShop" (v2.3: streaming-safe prompt hooks via Util/Tagged).
	- Keybinds: 1 / 2 / 3 use the consumable quick-slots, F starts / stops shade placement.
	- Quick-slots: the (up to) 3 best owned consumables, cheapest first.
	- Reads the server's player attributes: Heat, Sunburnt, InShade, HeatZone, HeatGrace.

	API:
		SurvivalController.GetHeat(): number                 (0..Config.Heat.Max)
		SurvivalController.IsSunburnt(): boolean
		SurvivalController.GetZone(): string                 ("Sun" | "Shade" | "Underground" | "Cool")
		SurvivalController.GetQuickSlots(): { string }       consumable ids
		SurvivalController.UseSlot(index) / UseConsumable(id) / DrinkFountain()
		SurvivalController.GetMyShades(): { Model }          my placed shades (tag "PlacedShade")
		SurvivalController.Changed: Signal                   heat attributes changed
]]
local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Types = require(Shared:WaitForChild("Types"))
local Signal = require(script.Parent.Parent.Util.Signal)
local State = require(script.Parent.State)
local SoundController = require(script.Parent.SoundController)
local PlacementController = require(script.Parent.PlacementController)
local Panel = require(script.Parent.Parent.UI.Components.Panel)
local Tagged = require(script.Parent.Parent.Util.Tagged)

local SurvivalController = {}

SurvivalController.Changed = Signal.new()
SurvivalController.SLOT_COUNT = 3

local HEAT_ATTRIBUTES = { Heat = true, Sunburnt = true, InShade = true, HeatZone = true, HeatGrace = true }
local SLOT_KEYS = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three }

local localPlayer = Players.LocalPlayer
local initialized = false

function SurvivalController.GetHeat(): number
	local heat = localPlayer:GetAttribute("Heat")
	return if type(heat) == "number" then heat else 0
end

function SurvivalController.IsSunburnt(): boolean
	return localPlayer:GetAttribute("Sunburnt") == true
end

function SurvivalController.IsInShade(): boolean
	return localPlayer:GetAttribute("InShade") == true
end

function SurvivalController.InGrace(): boolean
	return localPlayer:GetAttribute("HeatGrace") == true
end

function SurvivalController.GetZone(): string
	local zone = localPlayer:GetAttribute("HeatZone")
	return if type(zone) == "string" then zone else "Cool"
end

-- Up to SLOT_COUNT owned consumables: the most valuable ones, shown cheapest first.
function SurvivalController.GetQuickSlots(): { string }
	local owned: { Types.ConsumableDef } = {}
	local counts = State.Data.Consumables or ({} :: { [string]: number })
	for _, def in Config.Consumables do
		if def.Price > 0 and (counts[def.Id] or 0) > 0 then
			table.insert(owned, def)
		end
	end
	table.sort(owned, function(a, b)
		return a.Price > b.Price
	end)
	local best: { Types.ConsumableDef } = {}
	for i = 1, math.min(#owned, SurvivalController.SLOT_COUNT) do
		table.insert(best, owned[i])
	end
	table.sort(best, function(a, b)
		return a.Price < b.Price
	end)
	local ids = {}
	for _, def in best do
		table.insert(ids, def.Id)
	end
	return ids
end

function SurvivalController.UseConsumable(id: string): boolean
	local count = (State.Data.Consumables or ({} :: { [string]: number }))[id] or 0
	if count <= 0 then
		SoundController.Play("Error")
		return false
	end
	SoundController.Play("Splash", 1.4, 0.5)
	Remotes.Get("UseConsumable"):FireServer(id)
	return true
end

function SurvivalController.UseSlot(index: number): boolean
	local id = SurvivalController.GetQuickSlots()[index]
	if not id then
		Panel.Open("BeachShop", { Tab = "Snacks" })
		return false
	end
	return SurvivalController.UseConsumable(id)
end

function SurvivalController.DrinkFountain()
	SoundController.Play("Splash")
	Remotes.Get("DrinkFountain"):FireServer()
end

function SurvivalController.GetMyShades(): { Model }
	local list = {}
	for _, inst in CollectionService:GetTagged("PlacedShade") do
		-- v2.3: own shades are PersistentPerPlayer on the server, so they never stream out for us
		if inst:IsA("Model") and inst:GetAttribute("OwnerUserId") == localPlayer.UserId and inst.Parent then
			table.insert(list, inst)
		end
	end
	return list
end

function SurvivalController.IsShadePlaced(shadeId: string): boolean
	for _, model in SurvivalController.GetMyShades() do
		if model:GetAttribute("ShadeId") == shadeId then
			return true
		end
	end
	return false
end

-- Prompts -----------------------------------------------------------------------------------------

local OPENERS: { [string]: () -> () } = {
	WaterFountain = function()
		SurvivalController.DrinkFountain()
	end,
	BeachShop = function()
		Panel.Open("BeachShop", { Tab = "Shade" })
	end,
}

-- Init ----------------------------------------------------------------------------------------------

function SurvivalController.Init()
	if initialized then
		return
	end
	initialized = true

	for tag, opener in OPENERS do
		-- v2.3 streaming-safe: late stream-in, stream-out cleanup (Util/Tagged)
		Tagged.WatchPrompts(tag, function()
			opener()
		end)
	end

	localPlayer.AttributeChanged:Connect(function(name: string)
		if HEAT_ATTRIBUTES[name] then
			SurvivalController.Changed:Fire(name)
		end
	end)

	for i, key in SLOT_KEYS do
		ContextActionService:BindAction("SurvivalSlot" .. i, function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				SurvivalController.UseSlot(i)
			end
			return Enum.ContextActionResult.Sink
		end, false, key)
	end
	ContextActionService:BindAction("SurvivalPlaceShade", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			PlacementController.Toggle()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.F)
end

return SurvivalController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	TutorialController — first-time user experience driven by Config.TUTORIAL_STEPS.

	Progress = number of completed steps, persisted with SetSetting("Tutorial", n) and read
	back from data.Settings.Tutorial (veterans without the key skip it). Each step shows the
	slim top-centre objective pill (UI/ObjectiveBanner: icon, short line, step n/6, arrow),
	a guide Beam + bouncing marker to its Target
	("Sand" = the nearest point of the shared dig zone, otherwise the nearest part with that
	CollectionService tag), and completes on its Complete event:
	  AtSand        standing on the dig-zone sand   Dig        first successful dig
	  BackpackFull  sand >= capacity               Sell       sand emptied after filling
	  BuyShovel     own a 2nd shovel               HatchEgg   hatched / own a pet
	  NewLayer      reached the first layer the starter shovel cannot dig (the upgrade's payoff)
	The checks are state-based (polled), so the tutorial resumes correctly after rejoining.
	While the "shop" step's shovel is unaffordable, the banner shows coins/price and the guide
	points back to the sand (or the sell stand when the bucket is full) instead of the shop.
	On join, steps that are already satisfied are skipped silently, so inserting a step never
	re-runs the tutorial (or its completion fanfare) for players who had finished it.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Types = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Types"))
local State = require(script.Parent.State)
local GuideController = require(script.Parent.GuideController)
local DigController = require(script.Parent.DigController)
local DiscoveryController = require(script.Parent.DiscoveryController)
local SoundController = require(script.Parent.SoundController)
local Character = require(script.Parent.Parent.Util.Character)
local ObjectiveBanner = require(script.Parent.Parent.UI.ObjectiveBanner)
local HUD = require(script.Parent.Parent.UI.HUD)
local Toasts = require(script.Parent.Parent.UI.Toasts)
local UIEffects = require(script.Parent.Parent.UI.UIEffects)
local HatchAnimation = require(script.Parent.Parent.UI.HatchAnimation)

local TutorialController = {}

local GUIDE_KEY = "Tutorial"
local SCAN_SETTING = "TutorialScanUsed"
local SCAN_TEXT = "Tap SCAN; follow the arrow to buried treasure!"
local STEPS = Config.TUTORIAL_STEPS

local completed = 0
local running = false
local dugFlag = false
local fullFlag = false
local soldFlag = false
local hatchedFlag = false

local built = false
local showingScanTip = false
local shortText: string? = nil -- "shop" step banner while the next shovel is unaffordable
local cameraTurnKey: string? = nil -- the selling moment the camera already turned for

-- Banner icon per step (atlas key, emoji fallback).
local STEP_ICONS: { [string]: string } = {
	AtSand = "sand",
	Dig = "Hand",
	BackpackFull = "Backpack",
	Sell = "Sell",
	BuyShovel = "Shop",
	NewLayer = "layer",
	HatchEgg = "Eggs",
}

-- Depth of the first layer the starter shovel cannot dig: reaching it proves the upgrade works.
local function firstLockedLayerDepth(): number
	local index = Config.GetMaxLayerIndexForPower(Config.Shovels[1].Power) + 1
	local layer = Config.Layers[index] or Config.Layers[#Config.Layers]
	return layer.DepthStart
end

local function count(t: { [string]: any }?): number
	local n = 0
	if t then
		for _ in t do
			n += 1
		end
	end
	return n
end

local function buildBar()
	built = true
end

local function bucketFull(): boolean
	return (State.Data.Sand or 0) >= State.GetCapacity()
end

-- The shovel the "shop" step is asking for: the cheapest coin shovel not owned yet.
local function nextShovel(): Types.ShovelDef?
	local owned = State.Data.OwnedShovels or {}
	local best: Types.ShovelDef? = nil
	for _, def in Config.Shovels do
		if def.Price > 0 and not owned[def.Id] and (best == nil or def.Price < (best :: Types.ShovelDef).Price) then
			best = def
		end
	end
	return best
end

-- A first bucket without passes can sell for a few coins less than the first upgrade (missed
-- excavations lower find value). Sending that player to a shop they cannot use stalls the
-- second minute, so until they can afford it the step sends them back to the sand instead.
-- Returns the banner text while short of coins, else nil.
function TutorialController.ShortOfShovelText(step: Types.TutorialStep): string?
	if step.Complete ~= "BuyShovel" then
		return nil
	end
	local def = nextShovel()
	local coins = State.Data.Coins or 0
	if not def or coins >= def.Price then
		return nil
	end
	local verb = if bucketFull() then "Bucket full! Sell it" else "Dig & sell more"
	return string.format("%s for the %s! (%d/%d)", verb, def.Name, math.floor(coins), def.Price)
end

local function currentStep(): Types.TutorialStep?
	return STEPS[completed + 1]
end

-- Nearest sand a few studs inside the dig zone (straight ahead from the boardwalk).
local function sandTarget(): Vector3?
	local root = Character.GetRoot()
	if not root then
		return nil
	end
	local point = State.NearestSand((root :: BasePart).Position, 8)
	return if point then point + Vector3.new(0, 1, 0) else nil
end

local function onSand(): boolean
	local root = Character.GetRoot()
	local cf = State.GetDigZone()
	return root ~= nil and cf ~= nil and State.InDigZone(root.Position, 0)
end

local function isSatisfied(step: Types.TutorialStep): boolean
	local data = State.Data
	local event = step.Complete
	if event == "AtSand" then
		-- Sand is reachable from the boardwalk. A confirmed dig already proves the
		-- player found it, even if their feet have not crossed the zone boundary.
		return onSand() or dugFlag or data.TotalSandDug > 0
	elseif event == "Dig" then
		return dugFlag or data.TotalSandDug > 0
	elseif event == "BackpackFull" then
		return fullFlag or data.Sand >= State.GetCapacity()
	elseif event == "Sell" then
		-- A saved fill-up step proves the bucket was full before this session. If it
		-- is already empty, the sale finished before tutorial progress was saved.
		return soldFlag or (completed >= 3 and data.Sand == 0)
	elseif event == "BuyShovel" then
		return count(data.OwnedShovels) > 1
	elseif event == "HatchEgg" then
		return hatchedFlag or count(data.Pets) > 0
	elseif event == "NewLayer" then
		return (data.MaxDepth or 0) >= firstLockedLayerDepth()
	end
	return false
end

local function updateGuide(step: Types.TutorialStep)
	if showingScanTip then
		GuideController.Clear(GUIDE_KEY)
		return
	end
	local target = step.Target
	if TutorialController.ShortOfShovelText(step) then
		-- not enough coins yet: back to digging (or selling a full bucket), not to the shop
		target = if bucketFull() then "SellZone" else "Sand"
	end
	if not target then
		GuideController.Clear(GUIDE_KEY)
		return
	end
	if target == "Sand" then
		local position = sandTarget()
		if position then
			GuideController.Set(GUIDE_KEY, position, 10, if step.Complete == "Dig" then "Hand" else "Arrow")
		end
		return
	end
	local root = Character.GetRoot()
	local part = GuideController.FindTagged(target :: string, if root then root.Position else nil)
	if part then
		GuideController.Set(GUIDE_KEY, part, 10, "Arrow")
	else
		GuideController.Clear(GUIDE_KEY)
	end
end

local function showStep()
	local step = currentStep()
	if not step or not built then
		return
	end
	local s = step :: Types.TutorialStep
	-- Keep the saved numeric steps intact. Introduce intentional treasure hunting in the
	-- existing objective once the first find has demonstrated the reward. Selling/upgrading
	-- still takes priority, and a scan is optional rather than a new progression gate.
	showingScanTip = (s.Complete == "BackpackFull" or s.Complete == "NewLayer")
		and count(State.Data.Index) > 0
		and State.GetSetting(SCAN_SETTING, false) ~= true
	shortText = TutorialController.ShortOfShovelText(s)
	local text = if showingScanTip then SCAN_TEXT else shortText or s.Text
	ObjectiveBanner.Show(text, STEP_ICONS[s.Complete] or "Star", {
		Step = (completed + 1) .. "/" .. #STEPS,
		Arrow = not showingScanTip and s.Target ~= nil,
	})
	HUD.SetBackpackHighlight(s.Complete == "BackpackFull")
	if s.Complete == "BuyShovel" and not shortText then
		HUD.Flash("Shop", 6)
	elseif s.Complete == "HatchEgg" then
		HUD.Flash("Eggs", 6)
	end
	updateGuide(s)
	-- A full bucket usually leaves the camera facing the sea with the stand behind: swing it
	-- round once per selling moment (never repeatedly, so it cannot fight the player).
	if s.Complete == "Sell" or (shortText ~= nil and bucketFull()) then
		local key = completed .. ":" .. tostring(shortText ~= nil) .. ":" .. tostring(bucketFull())
		if key ~= cameraTurnKey then
			cameraTurnKey = key
			local root = Character.GetRoot()
			local sell = GuideController.FindTagged("SellZone", if root then root.Position else nil)
			if sell then
				GuideController.TurnCameraToward(sell)
			end
		end
	end
end

local function finish()
	running = false
	GuideController.Clear(GUIDE_KEY)
	HUD.SetBackpackHighlight(false)
	ObjectiveBanner.Hide()
	Toasts.Show("Tutorial complete! Now dig to the CORE! 🌟", "Success", 5)
	UIEffects.Confetti(50)
end

local function advance()
	completed += 1
	State.SetSetting("Tutorial", completed)
	SoundController.Play("Purchase", 1.1)
	if completed >= #STEPS then
		finish()
	else
		showStep()
	end
end

local function loop()
	while running do
		local step = currentStep()
		if not step then
			finish()
			break
		end
		if isSatisfied(step :: Types.TutorialStep) then
			advance()
		else
			local wantsScanTip = (step.Complete == "BackpackFull" or step.Complete == "NewLayer")
				and count(State.Data.Index) > 0
				and State.GetSetting(SCAN_SETTING, false) ~= true
			if
				wantsScanTip ~= showingScanTip
				or TutorialController.ShortOfShovelText(step :: Types.TutorialStep) ~= shortText
			then
				showStep()
			end
			updateGuide(step :: Types.TutorialStep)
		end
		task.wait(0.4)
	end
end

function TutorialController.IsActive(): boolean
	return running
end

function TutorialController.Init()
	DiscoveryController.PingChanged:Connect(function(ping: Types.DetectorPing)
		-- A server response confirms the player used Scan; an empty signal still counts.
		if running and ping.Remaining > 0 and State.GetSetting(SCAN_SETTING, false) ~= true then
			State.SetSetting(SCAN_SETTING, true)
		end
	end)
	DigController.Dug:Connect(function(result: Types.DigResult)
		dugFlag = true
		if result.Capacity and result.Sand >= result.Capacity then
			fullFlag = true
		end
	end)
	DigController.Feedback:Connect(function(reason: string)
		if reason == "BackpackFull" then
			fullFlag = true
		end
	end)
	State.Changed("Sand"):Connect(function(new: any, old: any)
		if typeof(new) == "number" and typeof(old) == "number" and old > 0 and new == 0 and fullFlag then
			soldFlag = true
		end
	end)
	HatchAnimation.Hatched:Connect(function()
		hatchedFlag = true
	end)

	task.spawn(function()
		local data = State.WaitForData()
		local saved = data.Settings and data.Settings.Tutorial
		if typeof(saved) == "number" then
			completed = math.clamp(math.floor(saved), 0, #STEPS)
		else
			local veteran = data.Rebirths > 0 or count(data.OwnedShovels) > 1 or count(data.Pets) > 0
			if veteran then
				completed = #STEPS
				State.SetSetting("Tutorial", completed)
			end
		end
		-- skip (silently) steps this player has already done, e.g. a step added after they
		-- passed that point
		local resumed = completed
		while completed < #STEPS and isSatisfied(STEPS[completed + 1]) do
			completed += 1
		end
		if completed ~= resumed then
			State.SetSetting("Tutorial", completed)
		end
		if completed >= #STEPS then
			return
		end
		-- Steps past "fill up" assume the bucket was filled in a previous session.
		if completed >= 3 then
			fullFlag = true
		end
		buildBar()
		running = true
		showStep()
		loop()
	end)
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">WorldPromptController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	WorldPromptController — map stations open UI. Parts tagged ShovelShop / BackpackShop /
	EggShop / RebirthStatue carry a ProximityPrompt; Triggered opens the matching panel.
	EggShop pedestals (and their prompt) carry attribute "EggId" -> egg panel focuses that egg.
	v2.3 streaming: Util/Tagged.WatchPrompts handles parts that stream in late, prompts that
	arrive after their part, and stream-outs (connections are dropped with the instance).
]]
local Panel = require(script.Parent.Parent.UI.Components.Panel)
local Tagged = require(script.Parent.Parent.Util.Tagged)

local WorldPromptController = {}

type Opener = (inst: Instance, prompt: ProximityPrompt) -> ()

local function eggIdOf(inst: Instance, prompt: ProximityPrompt): string?
	local id = prompt:GetAttribute("EggId") or inst:GetAttribute("EggId")
	return if typeof(id) == "string" then id else nil
end

local OPENERS: { [string]: Opener } = {
	ShovelShop = function()
		Panel.Open("Shop", { Tab = "Shovels" })
	end,
	BackpackShop = function()
		Panel.Open("Shop", { Tab = "Backpacks" })
	end,
	EggShop = function(inst, prompt)
		Panel.Open("Eggs", { EggId = eggIdOf(inst, prompt) })
	end,
	RebirthStatue = function()
		Panel.Open("Rebirth")
	end,
}

function WorldPromptController.Init()
	for tag, opener in OPENERS do
		-- v2.3 streaming: stations stream in late, out, and back in as new instances; Tagged
		-- hooks every arrival and disconnects on InstanceRemoved.
		Tagged.WatchPrompts(tag, opener)
	end
end

return WorldPromptController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="121">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Client bootstrap (StarterPlayerScripts.Client.Main).
	Order: data store -> services/controllers without UI -> UI root & components -> HUD/panels
	-> world controllers -> tutorial. Every step is isolated with xpcall so one failing module
	never takes the whole client down, and nothing blocks on PlayerData: UI renders defaults
	and fills in when DataChanged / GetData arrives (State.Observe).
]]
-- Guard against a second copy of the client (e.g. a stale "Client" folder left in the place
-- next to the Rojo-synced one), which would double every popup and remote call.
local sharedState = shared :: any
if sharedState.DigToTheCoreClient then
	warn(
		"[Client] Duplicate client script ignored: "
			.. script:GetFullName()
			.. " (already running: "
			.. tostring(sharedState.DigToTheCoreClient)
			.. "). Delete the extra copy from StarterPlayerScripts."
	)
	return
end
sharedState.DigToTheCoreClient = script:GetFullName()

-- The shovel is auto-equipped, so hide Roblox's tool hotbar (it covers the backpack bar).
pcall(function()
	game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local Client = script.Parent
local Controllers = Client:WaitForChild("Controllers")
local UI = Client:WaitForChild("UI")
local Panels = UI:WaitForChild("Panels")

local State = require(Controllers:WaitForChild("State"))
local SoundController = require(Controllers:WaitForChild("SoundController"))
local EffectsController = require(Controllers:WaitForChild("EffectsController"))
local PurchaseController = require(Controllers:WaitForChild("PurchaseController"))
local GuideController = require(Controllers:WaitForChild("GuideController"))
local LayerController = require(Controllers:WaitForChild("LayerController"))
local DigController = require(Controllers:WaitForChild("DigController"))
local ShovelPoseController = require(Controllers:WaitForChild("ShovelPoseController"))
local PetFollowController = require(Controllers:WaitForChild("PetFollowController"))
local WorldPromptController = require(Controllers:WaitForChild("WorldPromptController"))
local InputController = require(Controllers:WaitForChild("InputController"))
local TutorialController = require(Controllers:WaitForChild("TutorialController"))

local Root = require(UI:WaitForChild("Root"))
local Toasts = require(UI:WaitForChild("Toasts"))
local Banner = require(UI:WaitForChild("Banner"))
local HUD = require(UI:WaitForChild("HUD"))
local HatchAnimation = require(UI:WaitForChild("HatchAnimation"))
local TreasurePopup = require(UI:WaitForChild("TreasurePopup"))
local OfflinePopup = require(UI:WaitForChild("OfflinePopup")) -- v2.2 offline pet earnings

local ShopPanel = require(Panels:WaitForChild("ShopPanel"))
local EggPanel = require(Panels:WaitForChild("EggPanel"))
local PetsPanel = require(Panels:WaitForChild("PetsPanel"))
local IndexPanel = require(Panels:WaitForChild("IndexPanel"))
local QuestsPanel = require(Panels:WaitForChild("QuestsPanel"))
local DailyPanel = require(Panels:WaitForChild("DailyPanel"))
local RebirthPanel = require(Panels:WaitForChild("RebirthPanel"))
local StorePanel = require(Panels:WaitForChild("StorePanel"))
local SettingsPanel = require(Panels:WaitForChild("SettingsPanel"))
local BeachShopPanel = require(Panels:WaitForChild("BeachShopPanel"))
local SurvivalHUD = require(UI:WaitForChild("SurvivalHUD"))
local SurvivalController = require(Controllers:WaitForChild("SurvivalController"))
local PlacementController = require(Controllers:WaitForChild("PlacementController"))
local RideController = require(Controllers:WaitForChild("RideController"))
local RideButton = require(UI:WaitForChild("RideButton"))
-- v2.2 status & social: nameplates + worn pack fill, rare-find banners, server goal / friends
local StatusController = require(Controllers:WaitForChild("StatusController"))
local Announcements = require(UI:WaitForChild("Announcements"))
local SocialHUD = require(UI:WaitForChild("SocialHUD"))
-- v3 discovery slice: detector, excavation minigame, tiered find reveals
local DiscoveryController = require(Controllers:WaitForChild("DiscoveryController"))
local DetectorHUD = require(UI:WaitForChild("DetectorHUD"))
local ExcavationGame = require(UI:WaitForChild("ExcavationGame"))
local FindReveal = require(UI:WaitForChild("FindReveal"))
local Reveal = require(UI:WaitForChild("Reveal"))
local ChatLayoutController = require(Controllers:WaitForChild("ChatLayoutController"))

local function start(name: string, fn: () -> ())
	local ok, err = xpcall(function(): any
		fn()
		return nil
	end, function(message: any): string
		return debug.traceback(tostring(message))
	end)
	if not ok then
		warn("[Client] " .. name .. " failed to start:\n" .. tostring(err))
	end
end

-- 1. Data + non-visual services
start("State", State.Init)
start("Sound", SoundController.Init)
start("Effects", EffectsController.Init)
start("Purchase", PurchaseController.Init)
start("Guide", GuideController.Init)
start("ChatLayout", ChatLayoutController.Init)

-- 2. UI
start("UIRoot", Root.Init)
start("Toasts", Toasts.Init)
start("HUD", HUD.Init)
start("ShopPanel", ShopPanel.Init)
start("EggPanel", EggPanel.Init)
start("PetsPanel", PetsPanel.Init)
start("IndexPanel", IndexPanel.Init)
start("QuestsPanel", QuestsPanel.Init)
start("DailyPanel", DailyPanel.Init)
start("RebirthPanel", RebirthPanel.Init)
start("StorePanel", StorePanel.Init)
start("SettingsPanel", SettingsPanel.Init)
start("BeachShopPanel", BeachShopPanel.Init)
start("SurvivalHUD", SurvivalHUD.Init)
start("HatchAnimation", HatchAnimation.Init)
start("TreasurePopup", TreasurePopup.Init)
start("OfflinePopup", OfflinePopup.Init)
start("Announcements", Announcements.Init)
start("SocialHUD", SocialHUD.Init)
start("DetectorHUD", DetectorHUD.Init)
start("ExcavationGame", ExcavationGame.Init)
start("FindReveal", FindReveal.Init)

-- 3. Wiring between controllers and UI (controllers stay UI-agnostic)
DigController.SetHintCallback(function(text: string, kind: string)
	Toasts.Show(text, kind)
end)
LayerController.SetBannerCallback(function(index: number, isNew: boolean)
	Banner.ShowLayer(index, isNew)
end)
-- Reveal headlines sit where your own nameplate floats: hide it while one is up.
Reveal.Opened:Connect(function()
	StatusController.SetOwnHidden(true)
end)
Reveal.Closed:Connect(function()
	task.defer(function()
		StatusController.SetOwnHidden(Reveal.IsShowing())
	end)
end)

-- 4. World controllers
start("Layer", LayerController.Init)
start("Dig", DigController.Init)
start("ShovelPose", ShovelPoseController.Init)
start("PetFollow", PetFollowController.Init)
start("WorldPrompts", WorldPromptController.Init)
start("Input", InputController.Init)
start("Tutorial", TutorialController.Init)
start("Survival", SurvivalController.Init)
start("Placement", PlacementController.Init)
start("Ride", RideController.Init)
start("RideButton", RideButton.Init)
start("Status", StatusController.Init)
start("Discovery", DiscoveryController.Init)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="122">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">Announcements</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Announcements — server-wide brags as a big gold banner across the top of the screen (v2.2
	B6c, Status & Social agent). The server's Notify("Announce", text) is routed here by Toasts
	(Toasts.SetRoute), e.g.
		"Sandy found a LEGENDARY Golden Idol!"   (DigService)
		"Sandy hatched a MYTHIC Mega Excavator!" (PetService)
		"SERVER GOAL REACHED! ..."               (ServerGoalService)
	Find / hatch texts are parsed so the rarity word gets its own pill in the rarity colour and
	the banner's outline glows in it; anything else shows as a plain gold banner.

	Rate limit: one banner at a time for Config.Social.Announce.Duration seconds, a short gap
	between them, at most MaxQueued waiting (the oldest are dropped, duplicates are merged).
	A soft chime (RareTreasure, quieter and higher) plays with each banner.

	API: Announcements.Show(text), Announcements.Parse(text), Announcements.QueueLength(),
	     Announcements.IsShowing()
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Root = require(script.Parent.Root)
local Style = require(script.Parent.Components.Style)
local AtlasIcon = require(script.Parent.Components.AtlasIcon)
local Layout = require(script.Parent.Layout)
local Toasts = require(script.Parent.Toasts)
local UIEffects = require(script.Parent.UIEffects)
local SoundController = require(script.Parent.Parent.Controllers.SoundController)

local Announcements = {}

export type Parsed = {
	Player: string,
	Verb: string, -- "found" | "hatched"
	Rarity: string, -- "Legendary"
	Item: string,
}

local SETTINGS = Config.Social.Announce
local WIDTH, HEIGHT = 560, 92

local queue: { string } = {}
local showing = false

-- "Sandy found a LEGENDARY Golden Idol!" -> { Player, Verb, Rarity = "Legendary", Item }.
function Announcements.Parse(text: string): Parsed?
	local who, verb, rarity, item = string.match(text, "^(.-) (%a+) an? (%u+) (.-)!$")
	if who == nil or verb == nil or rarity == nil or item == nil then
		return nil
	end
	local w, v, r, i = who :: string, verb :: string, rarity :: string, item :: string
	if w == "" or i == "" or (v ~= "found" and v ~= "hatched") then
		return nil
	end
	local name = string.upper(string.sub(r, 1, 1)) .. string.lower(string.sub(r, 2))
	if not Config.GetRarity(name) then
		return nil
	end
	local parsed: Parsed = { Player = w, Verb = v, Rarity = name, Item = i }
	return parsed
end

local function build(text: string): Frame
	local parsed = Announcements.Parse(text)
	local rarity = if parsed then Config.GetRarity(parsed.Rarity) else nil
	local accent = if rarity then rarity.Color else Style.Colors.Sunset
	local gold = Style.Colors.Gold

	local holder = Instance.new("Frame")
	holder.Name = "Announcement"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Size = UDim2.fromOffset(WIDTH, HEIGHT + 22)
	-- over the toast column, under the objective pill + event chips
	holder.Position = UDim2.new(0.5, 0, 0, Layout.Current().Toasts.Y - 4)
	holder.ZIndex = 30
	holder.Parent = Root.Get("Popups")

	local ribbon = Instance.new("Frame")
	ribbon.Name = "Ribbon"
	ribbon.Size = UDim2.new(1, 0, 0, HEIGHT - 20)
	ribbon.Position = UDim2.fromOffset(0, 22)
	ribbon.BackgroundColor3 = Color3.new(1, 1, 1)
	ribbon.ZIndex = 31
	ribbon.Parent = holder
	Style.Corner(ribbon, Style.Theme.CornerLarge)
	Style.Stroke(ribbon, Style.Colors.Stroke, 4)
	Style.Gradient(ribbon, { Style.Lighten(gold, 0.35), gold, Style.Darken(gold, 0.2) }, 90)
	Style.Gloss(ribbon, Style.Theme.CornerMedium, 31)
	-- inner glow ring in the rarity colour
	local glow = Instance.new("Frame")
	glow.Name = "Glow"
	glow.BackgroundTransparency = 1
	glow.Size = UDim2.new(1, -8, 1, -8)
	glow.Position = UDim2.fromOffset(4, 4)
	glow.ZIndex = 32
	glow.Parent = ribbon
	Style.Corner(glow, Style.Theme.CornerMedium)
	Style.Stroke(glow, accent, 3)

	local icon = if parsed and parsed.Verb == "hatched" then "egg_hatch" elseif parsed then "treasure" else "trophy"
	AtlasIcon.new({
		Name = "AnnounceIcon",
		Icon = icon,
		Size = UDim2.fromOffset(84, 84),
		Position = UDim2.new(0, -18, 0.5, -2),
		AnchorPoint = Vector2.new(0, 0.5),
		Rotation = -8,
		ZIndex = 34,
		Parent = ribbon,
	})

	local body = text
	if parsed then
		local hex = "#" .. Style.Lighten(accent, 0.15):ToHex()
		local article = if string.find(string.lower(string.sub(parsed.Rarity, 1, 1)), "[aeiou]") then "an" else "a"
		body = string.format(
			'%s %s %s <font color="%s">%s %s</font>!',
			parsed.Player,
			parsed.Verb,
			article,
			hex,
			parsed.Rarity,
			parsed.Item
		)
	end
	Style.Label({
		Name = "Text",
		Text = body,
		RichText = parsed ~= nil,
		Size = UDim2.new(1, -96, 0.84, 0),
		Position = UDim2.new(0, 72, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		MaxTextSize = 28,
		StrokeThickness = 3,
		Wrapped = true,
		ZIndex = 33,
		Parent = ribbon,
	})

	local tagText = if parsed then string.upper(parsed.Rarity) .. "!" else "SERVER"
	local tag = Style.Label({
		Name = "Tag",
		Text = tagText,
		Size = UDim2.fromOffset(170, 32),
		Position = UDim2.new(0.5, 0, 0, 4),
		AnchorPoint = Vector2.new(0.5, 0),
		MaxTextSize = 22,
		ZIndex = 35,
		Parent = holder,
	})
	tag.BackgroundTransparency = 0
	tag.BackgroundColor3 = accent
	Style.Corner(tag, Style.Theme.CornerPill)
	Style.Stroke(tag, Style.Colors.Stroke, 3)
	return holder
end

local function pump()
	if showing or #queue == 0 then
		return
	end
	showing = true
	local text = table.remove(queue, 1) :: string
	local holder = build(text)
	SoundController.Play("RareTreasure", 1.3, 0.45) -- soft chime, not the full "you found it" sting
	local scale = Style.GetPopScale(holder)
	scale.Scale = 0.3
	Style.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local parsed = Announcements.Parse(text)
	if parsed and parsed.Rarity == "Mythic" then
		UIEffects.Confetti(24)
	end
	task.delay(SETTINGS.Duration, function()
		local out = Style.Tween(scale, 0.3, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		out.Completed:Once(function()
			holder:Destroy()
			task.delay(SETTINGS.Gap, function()
				showing = false
				pump()
			end)
		end)
	end)
end

function Announcements.Show(text: string)
	if text == "" then
		return
	end
	for _, queued in queue do
		if queued == text then
			return -- same brag twice (e.g. a retry): show it once
		end
	end
	table.insert(queue, text)
	while #queue > SETTINGS.MaxQueued do
		table.remove(queue, 1)
	end
	pump()
end

function Announcements.QueueLength(): number
	return #queue
end

function Announcements.IsShowing(): boolean
	return showing
end

function Announcements.Init()
	Toasts.SetRoute("Announce", Announcements.Show)
end

return Announcements
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">Banner</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Banner — big centre-screen announcements, queued one at a time:
	- ShowLayer(index, isNew): "Welcome to the Pirate Cove!" with the layer's atlas icon + layer
	  FlavorText, glossy outlined ribbon in the layer colour (isNew adds "NEW LAYER!" + confetti).
	- Show({ Title, Subtitle, Color, Icon }) for rebirths, milestones, events.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Root = require(script.Parent.Root)
local Style = require(script.Parent.Components.Style)
local AtlasIcon = require(script.Parent.Components.AtlasIcon)
local UIEffects = require(script.Parent.UIEffects)
local State = require(script.Parent.Parent.Controllers.State)
local SoundController = require(script.Parent.Parent.Controllers.SoundController)

local Banner = {}

export type BannerSpec = {
	Title: string,
	Subtitle: string?,
	Icon: string?, -- AtlasIcon key shown overlapping the ribbon's left end
	Tag: string?, -- small pill above the title ("NEW LAYER!")
	Color: Color3?,
	Duration: number?,
	Sound: string?,
	Confetti: boolean?,
}

local queue: { BannerSpec } = {}
local showing = false

local function build(spec: BannerSpec): Frame
	local color = spec.Color or Style.Colors.Ocean
	local holder = Instance.new("Frame")
	holder.Name = "Banner"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(620, 150)
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.3)
	holder.ZIndex = 20
	holder.Parent = Root.Get("Popups")

	local ribbon = Instance.new("Frame")
	ribbon.Name = "Ribbon"
	ribbon.Size = UDim2.new(1, 0, 0, 74)
	ribbon.Position = UDim2.fromOffset(0, 26)
	ribbon.BackgroundColor3 = Color3.new(1, 1, 1)
	ribbon.ZIndex = 21
	ribbon.Parent = holder
	Style.Corner(ribbon, Style.Theme.CornerLarge)
	Style.Stroke(ribbon, Style.Colors.Stroke, 4)
	Style.Gradient(ribbon, { Style.Lighten(color, 0.35), color, Style.Darken(color, 0.25) }, 90)

	Style.Gloss(ribbon, Style.Theme.CornerMedium, 21)
	local inset = if spec.Icon then 70 else 0
	Style.Label({
		Name = "Title",
		Text = spec.Title,
		Size = UDim2.new(1, -30 - inset, 0.8, 0),
		Position = UDim2.new(0.5, inset / 2, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 44,
		StrokeThickness = 4,
		ZIndex = 22,
		Parent = ribbon,
	})
	if spec.Icon then
		AtlasIcon.new({
			Name = "BannerIcon",
			Icon = spec.Icon,
			Size = UDim2.fromOffset(96, 96),
			Position = UDim2.new(0, -14, 0.5, -4),
			AnchorPoint = Vector2.new(0, 0.5),
			Rotation = -8,
			ZIndex = 23,
			Parent = ribbon,
		})
	end

	if spec.Tag then
		local tag = Style.Label({
			Name = "Tag",
			Text = spec.Tag,
			Size = UDim2.fromOffset(200, 34),
			Position = UDim2.new(0.5, 0, 0, 10),
			AnchorPoint = Vector2.new(0.5, 0),
			MaxTextSize = 22,
			ZIndex = 24,
			Parent = holder,
		})
		tag.BackgroundTransparency = 0
		tag.BackgroundColor3 = Style.Colors.Coral
		Style.Corner(tag, Style.Theme.CornerPill)
		Style.Stroke(tag, Style.Colors.Stroke, 3)
	end

	if spec.Subtitle and spec.Subtitle ~= "" then
		local sub = Style.Label({
			Name = "Subtitle",
			Text = spec.Subtitle,
			Size = UDim2.new(0.92, 0, 0, 46),
			Position = UDim2.new(0.5, 0, 0, 104),
			AnchorPoint = Vector2.new(0.5, 0),
			MaxTextSize = 20,
			Font = Style.Fonts.Body,
			Wrapped = true,
			ZIndex = 22,
			Parent = holder,
		})
		sub.BackgroundTransparency = 0.08
		sub.BackgroundColor3 = Style.Colors.NavyDark
		Style.Corner(sub, Style.Theme.CornerMedium)
		Style.Stroke(sub, Style.Colors.Stroke, 3)
		Style.Padding(sub, 4, 12)
	end
	return holder
end

local function pump()
	if showing or #queue == 0 then
		return
	end
	showing = true
	local spec = table.remove(queue, 1) :: BannerSpec
	local holder = build(spec)
	if spec.Sound ~= "" then
		SoundController.Play(spec.Sound or "NewLayer")
	end
	if spec.Confetti then
		UIEffects.Confetti(36)
	end
	local scale = Style.GetPopScale(holder)
	scale.Scale = 0.2
	Style.Tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	task.delay(spec.Duration or 3.4, function()
		Style.Tween(
			holder,
			0.35,
			{ Position = UDim2.fromScale(0.5, 0.12) },
			Enum.EasingStyle.Back,
			Enum.EasingDirection.In
		)
		local out = Style.Tween(scale, 0.35, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		out.Completed:Once(function()
			holder:Destroy()
			showing = false
			pump()
		end)
	end)
end

function Banner.Show(spec: BannerSpec)
	-- drop stale duplicates
	for i = #queue, 1, -1 do
		if queue[i].Title == spec.Title then
			table.remove(queue, i)
		end
	end
	table.insert(queue, spec)
	if #queue > 3 then
		table.remove(queue, 1)
	end
	pump()
end

function Banner.ShowLayer(index: number, isNew: boolean?)
	local layer = Config.Layers[index]
	if not layer then
		return
	end
	local article = if string.sub(layer.Name, 1, 4) == "The " then "" else "the "
	local subtitle = layer.FlavorText
	if State.GetShovel().Power < layer.Hardness then
		subtitle = "Too hard for your shovel! Needs " .. layer.Hardness .. " power."
	end
	Banner.Show({
		Title = "Welcome to " .. article .. layer.Name .. "!",
		Icon = "Layers." .. layer.Id,
		Subtitle = subtitle,
		Tag = if isNew then "NEW LAYER!" else Config.DepthToMeters(layer.DepthStart) .. "m deep",
		Color = layer.Color,
		Sound = "NewLayer",
		Confetti = isNew == true,
		Duration = if isNew then 4 else 3,
	})
end

return Banner
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="125">
            <Properties>
              <string name="Name">Components</string>
            </Properties>
            <Item class="ModuleScript" referent="126">
              <Properties>
                <string name="Name">AtlasIcon</string>
                <string name="Source"><![CDATA[--!strict
--[[
	AtlasIcon — every icon slot in the UI. Renders one cell of the icon atlas
	(Config/IconAtlas.luau: AssetId, CellSize, Icons = { name = offset }, Aliases, Groups) as an
	ImageLabel while the owner has uploaded the sheet (AssetId ~= ""), otherwise the emoji from
	UI/Icons.luau through Style.Icon (emoji-safe sizing, never TextScaled emoji). Uploading the
	atlas therefore upgrades every icon at once.

		local icon = AtlasIcon.new({ Icon = "Coins", Size = UDim2.fromOffset(40, 40), Parent = f })
		icon:Set("Layers.pirate_cove")   -- swap later (Button:SetIcon uses this)

	`Icon` accepts, in this order:
	  - an atlas icon name ("coins", "sun")
	  - an Icons.luau key ("Coins", "Shop") via IconAtlas.Aliases
	  - "Group.key" for the grouped Icons tables ("Layers.shell_bed", "PetShapes.Crab",
	    "BoostKinds.Luck", "TreasureShapes.Gem", ...) via IconAtlas.Groups (+ group Default)
	  - "atlas_name|emoji" (AtlasIcon.With): an atlas cell with an explicit emoji fallback
	  - a raw emoji ("💰"): reverse-mapped to its Icons key when there is one; otherwise it is
	    simply drawn as that emoji (also after the atlas is uploaded).
	The container Frame carries the attribute "Icon" (the key it was given) for tests/debugging.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Style = require(script.Parent.Style)
local Icons = require(script.Parent.Parent.Icons)

local AtlasIcon = {}

-- Some clients do not emit IsLoaded changes when a cached texture becomes renderable.
-- One shared poll covers pending icons; completed/destroyed icons leave the set.
local pending: { [Frame]: () -> boolean } = {}
local polling = false
local function watchLoading(frame: Frame, checkLoaded: () -> boolean)
	pending[frame] = checkLoaded
	if polling then
		return
	end
	polling = true
	task.spawn(function()
		while next(pending) ~= nil do
			task.wait(0.25)
			for target, check in pending do
				if check() then
					pending[target] = nil
				end
			end
		end
		polling = false
	end)
end

-- The atlas module is generated by another tool and may change shape: read it loosely.
local atlas: any = nil
do
	local ok, result = pcall(function(): any
		local config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
		local module = config:FindFirstChild("IconAtlas")
		if module and module:IsA("ModuleScript") then
			return require(module) :: any
		end
		return nil
	end)
	if ok and typeof(result) == "table" then
		atlas = result
	end
end

-- Emoji for atlas names that have no Icons.luau key.
local NAME_EMOJI: { [string]: string } = {
	shovel = "⛏️",
	spade = "⛏️",
	pickaxe = "⛏️",
	layer = "⛰️",
	trophy = "🏆",
	beach_shop = "⛱️",
	gift = "🎁",
	place_shade = "⛱️",
	heat = "🌡️",
	sun = "☀️",
	shade = "⛱️",
	water = "💧",
	lemonade = "🍋",
	coconut = "🥥",
	popsicle = "🍭",
	shaved_ice = "🍧",
	watermelon_slice = "🍉",
	giant_watermelon = "🍉",
	boost_sand = "⏳",
	boost_luck = "🍀",
	boost_speed = "⚡",
	boost_coins = "💰",
	golden_hour = "🌅",
	high_tide = "🌊",
	treasure = "🧰",
	egg_hatch = "🥚",
	arrow_right = "➡️",
	arrow_down = "⬇️",
	notify = "💬",
	music = "🎵",
	sfx = "🔊",
	codes = "🎟️",
	info = "💬",
	gem = "💎",
	shell = "🐚",
	crab = "🦀",
	hourglass = "⏳",
}

local GROUPS = { "Layers", "PetShapes", "VehicleKinds", "BackpackShapes", "TreasureShapes", "BoostKinds", "Events" }

-- emoji -> first Icons key ("Coins") or "Group.key" that uses it
local byEmoji: { [string]: string } = {}
do
	local keys = {}
	for key, value in Icons :: any do
		if typeof(value) == "string" then
			table.insert(keys, key)
		end
	end
	table.sort(keys)
	for _, key in keys do
		local emoji = (Icons :: any)[key]
		if byEmoji[emoji] == nil then
			byEmoji[emoji] = key
		end
	end
	for _, group in GROUPS do
		local tbl = (Icons :: any)[group]
		if typeof(tbl) == "table" then
			local groupKeys = {}
			for key in tbl do
				table.insert(groupKeys, key)
			end
			table.sort(groupKeys)
			for _, key in groupKeys do
				local emoji = tbl[key]
				if typeof(emoji) == "string" and byEmoji[emoji] == nil then
					byEmoji[emoji] = group .. "." .. key
				end
			end
		end
	end
end

local function atlasTable(field: string): any
	local value = if atlas then atlas[field] else nil
	return if typeof(value) == "table" then value else nil
end

-- Atlas cell offset for a key (no asset check).
local function offsetFor(key: string): Vector2?
	local icons = atlasTable("Icons")
	if not icons then
		return nil
	end
	local direct = icons[key]
	if typeof(direct) == "Vector2" then
		return direct
	end
	local aliases = atlasTable("Aliases")
	local alias = if aliases then aliases[key] else nil
	if typeof(alias) == "string" and typeof(icons[alias]) == "Vector2" then
		return icons[alias]
	end
	local group, sub = string.match(key, "^(%a+)%.(.+)$")
	if group and sub then
		local groups = atlasTable("Groups")
		local entry = if groups then groups[group] else nil
		if typeof(entry) == "table" then
			local name = entry[sub] or entry.Default
			if typeof(name) == "string" and typeof(icons[name]) == "Vector2" then
				return icons[name]
			end
		end
	end
	return nil
end

-- "atlas_name|emoji" key: that atlas cell, with an explicit emoji fallback (config items such
-- as snacks whose emoji lives in Config: AtlasIcon.With("lemonade", def.Icon)).
function AtlasIcon.With(name: string, emoji: string): string
	return name .. "|" .. emoji
end

-- Config items (snacks, shades) by id: the atlas cell of the same name when there is one.
local ITEM_NAMES: { [string]: string } = { coconut_water = "coconut" }
function AtlasIcon.Item(id: string, emoji: string): string
	return AtlasIcon.With(ITEM_NAMES[id] or id, emoji)
end

-- Emoji for a key (or the text itself when it already is one).
function AtlasIcon.Emoji(key: string): string
	local value = (Icons :: any)[key]
	if typeof(value) == "string" then
		return value
	end
	local group, sub = string.match(key, "^(%a+)%.(.+)$")
	if group and sub then
		local tbl = (Icons :: any)[group]
		if typeof(tbl) == "table" and typeof(tbl[sub]) == "string" then
			return tbl[sub]
		end
	end
	local aliases = atlasTable("Aliases")
	if aliases then
		for iconsKey, name in aliases do
			if name == key and typeof((Icons :: any)[iconsKey]) == "string" then
				return (Icons :: any)[iconsKey]
			end
		end
	end
	return NAME_EMOJI[key] or key
end

function AtlasIcon.HasAtlas(): boolean
	local id = if atlas then atlas.AssetId else nil
	return typeof(id) == "string" and id ~= ""
end

local function cellSize(): number
	local size = if atlas then atlas.CellSize else nil
	return if typeof(size) == "number" then size else 128
end

-- (atlas offset or nil when the atlas is not uploaded / has no such icon, emoji fallback)
function AtlasIcon.Resolve(icon: string): (Vector2?, string)
	local named, explicit = string.match(icon, "^([^|]+)|(.+)$")
	if named and explicit then
		-- "atlas_name|emoji": atlas cell when uploaded, else exactly this emoji
		return if AtlasIcon.HasAtlas() then offsetFor(named) else nil, explicit
	end
	local key = byEmoji[icon] or icon
	local emoji = if byEmoji[icon] then icon else AtlasIcon.Emoji(key)
	if not AtlasIcon.HasAtlas() then
		return nil, emoji
	end
	return offsetFor(key), emoji
end

export type AtlasIconProps = {
	Icon: string,
	Name: string?,
	Size: UDim2?, -- default: fills the parent (kept square)
	Position: UDim2?, -- default: centred
	AnchorPoint: Vector2?,
	ZIndex: number?,
	LayoutOrder: number?,
	Rotation: number?,
	Square: boolean?, -- default true: aspect-locked inside Size
	Parent: Instance?,
}

export type AtlasIcon = {
	Frame: Frame,
	Key: string,
	Set: (self: AtlasIcon, icon: string) -> (),
	SetTransparency: (self: AtlasIcon, alpha: number) -> (),
}

function AtlasIcon.new(props: AtlasIconProps): AtlasIcon
	local frame = Instance.new("Frame")
	frame.Name = props.Name or "Icon"
	frame.BackgroundTransparency = 1
	frame.Size = props.Size or UDim2.fromScale(1, 1)
	frame.Position = props.Position or UDim2.fromScale(0.5, 0.5)
	frame.AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5)
	frame.ZIndex = props.ZIndex or 1
	frame.LayoutOrder = props.LayoutOrder or 0
	frame.Rotation = props.Rotation or 0
	if props.Square ~= false then
		local ratio = Instance.new("UIAspectRatioConstraint")
		ratio.AspectRatio = 1
		ratio.AspectType = Enum.AspectType.FitWithinMaxSize
		ratio.Parent = frame
	end

	local image: ImageLabel? = nil
	local emojiLabel: TextLabel? = nil
	local usesAtlas = false
	local loadConnection: RBXScriptConnection? = nil
	local function syncLoaded()
		local loaded = usesAtlas and image ~= nil and image.IsLoaded
		if image then
			-- Invisible ImageLabels can remain unrequested even after PreloadAsync succeeds.
			-- Keep the image renderable so Roblox starts loading; the transparent background
			-- leaves the emoji readable until IsLoaded switches it off.
			image.Visible = usesAtlas
		end
		if emojiLabel then
			emojiLabel.Visible = not loaded
		end
	end
	frame.Destroying:Once(function()
		pending[frame] = nil
		if loadConnection then
			loadConnection:Disconnect()
		end
	end)

	local self: AtlasIcon
	self = {
		Frame = frame,
		Key = props.Icon,
		Set = function(this: AtlasIcon, icon: string)
			this.Key = icon
			frame:SetAttribute("Icon", icon)
			local offset, emoji = AtlasIcon.Resolve(icon)
			usesAtlas = offset ~= nil
			if not emojiLabel then
				emojiLabel = Style.Icon({
					Name = "Emoji",
					Text = emoji,
					Size = UDim2.fromScale(1, 1),
					ZIndex = frame.ZIndex,
					Parent = frame,
				})
			end
			(emojiLabel :: TextLabel).Text = emoji
			if offset then
				local img = image
				if not img then
					local made = Instance.new("ImageLabel")
					made.Name = "Image"
					made.BackgroundTransparency = 1
					made.Size = UDim2.fromScale(1, 1)
					made.ScaleType = Enum.ScaleType.Fit
					made.ZIndex = frame.ZIndex
					made.Parent = frame
					image = made
					img = made
					loadConnection = made:GetPropertyChangedSignal("IsLoaded"):Connect(syncLoaded)
				end
				local cell = cellSize()
				local i = img :: ImageLabel
				i.Image = atlas.AssetId
				i.ImageRectOffset = offset
				i.ImageRectSize = Vector2.new(cell, cell)
				syncLoaded()
				if not i.IsLoaded then
					watchLoading(frame, function(): boolean
						syncLoaded()
						return not usesAtlas or i.IsLoaded
					end)
				end
			else
				pending[frame] = nil
				local label = emojiLabel
				if not label then
					label = Style.Icon({
						Name = "Emoji",
						Text = emoji,
						Size = UDim2.fromScale(1, 1),
						ZIndex = frame.ZIndex,
						Parent = frame,
					})
					emojiLabel = label
				end
				local l = label :: TextLabel
				l.Text = emoji
				l.Visible = true
				if image then
					image.Visible = false
				end
			end
		end,
		SetTransparency = function(_: AtlasIcon, alpha: number)
			if image then
				image.ImageTransparency = alpha
			end
			if emojiLabel then
				emojiLabel.TextTransparency = alpha
			end
		end,
	}
	self:Set(props.Icon)
	if props.Parent then
		frame.Parent = props.Parent
	end
	return self
end

return AtlasIcon
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="127">
              <Properties>
                <string name="Name">Button</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Button — chunky "toy" button (docs/UI_STYLE.md): a darker base lip under a bright face with
	a soft gloss strip along its top third, a thick dark outline on both, rounded corners, an
	atlas icon (AtlasIcon, emoji fallback) and outlined text. Pressing sinks the face onto the
	lip, hover grows it slightly, clicks play the Click sound. Gamepad-selectable (TextButton
	face named "Face").

	Layouts:
	  Vertical = true   oversized icon (~70% of the face, may poke over the top edge) with the
	                    outlined caption across the bottom edge (HUD menu style)
	  Icon only/inline  icon on the left, text on the right (prices: Icon = "Coins")
	  text only         centred caption
	Never make one smaller than Theme.MinTouchSize design px (44 real px at UI scale 0.6); a
	small visual can keep a bigger touch area with HitPadding (invisible "HitArea" button).
]]
local Style = require(script.Parent.Style)
local AtlasIcon = require(script.Parent.AtlasIcon)
local Signal = require(script.Parent.Parent.Parent.Util.Signal)
local SoundController = require(script.Parent.Parent.Parent.Controllers.SoundController)

local Button = {}

local LIP = 6

export type ButtonProps = {
	Name: string?,
	Parent: Instance?,
	Text: string?,
	Icon: string?, -- AtlasIcon key: atlas name, Icons.luau key, "Group.key" or emoji
	Color: Color3?,
	TextColor: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	LayoutOrder: number?,
	MaxTextSize: number?,
	Vertical: boolean?, -- big icon above an outlined caption (HUD menu style)
	Round: boolean?, -- pill/circle corners (top-right round buttons)
	Corner: UDim?,
	ZIndex: number?,
	HitPadding: number?, -- extra invisible touch area around the button (design px)
	Sound: string?, -- default "Click"; "" for silent
	OnClick: (() -> ())?,
}

export type Button = {
	Holder: Frame,
	Face: TextButton,
	Shadow: Frame,
	Label: TextLabel,
	Icon: AtlasIcon.AtlasIcon?,
	Badge: TextLabel,
	Enabled: boolean,
	Color: Color3,
	Activated: Signal.Signal,
	SetText: (self: Button, text: string) -> (),
	SetIcon: (self: Button, icon: string) -> (),
	SetColor: (self: Button, color: Color3) -> (),
	SetEnabled: (self: Button, enabled: boolean) -> (),
	SetBadge: (self: Button, text: string?) -> (),
	SetVisible: (self: Button, visible: boolean) -> (),
	Destroy: (self: Button) -> (),
}

function Button.new(props: ButtonProps): Button
	local color = props.Color or Style.Colors.Ocean
	local corner = props.Corner or (if props.Round then Style.Theme.CornerPill else UDim.new(0, 10))
	local z = props.ZIndex or 1

	local holder = Instance.new("Frame")
	holder.Name = props.Name or "Button"
	holder.BackgroundTransparency = 1
	holder.Size = props.Size or UDim2.fromOffset(160, 56)
	holder.Position = props.Position or UDim2.new()
	holder.AnchorPoint = props.AnchorPoint or Vector2.zero
	holder.LayoutOrder = props.LayoutOrder or 0
	holder.ZIndex = z

	local shadow = Instance.new("Frame")
	shadow.Name = "Shadow"
	shadow.Size = UDim2.new(1, 0, 1, -LIP)
	shadow.Position = UDim2.fromOffset(0, LIP)
	shadow.BackgroundColor3 = Style.Darken(color, 0.45)
	shadow.BorderSizePixel = 0
	shadow.ZIndex = z
	shadow.Parent = holder
	Style.Corner(shadow, corner)
	Style.Stroke(shadow, Style.Colors.Stroke, 3)

	local face = Instance.new("TextButton")
	face.Name = "Face"
	face.Text = ""
	face.AutoButtonColor = false
	face.Size = UDim2.new(1, 0, 1, -LIP)
	face.Position = UDim2.fromOffset(0, 0)
	face.BackgroundColor3 = color
	face.BorderSizePixel = 0
	face.ZIndex = z + 1
	face.Parent = holder
	Style.Corner(face, corner)
	local faceStroke = Style.Stroke(face, Style.Colors.Stroke, 3)
	local gloss = Style.Gloss(face, if props.Round then Style.Theme.CornerPill else UDim.new(0, 7), z + 1)

	local icon: AtlasIcon.AtlasIcon? = nil
	local label: TextLabel
	local text = props.Text or ""
	local maxText = props.MaxTextSize or 26
	local function caption(size: UDim2, position: UDim2, anchor: Vector2, max: number, min: number?): TextLabel
		return Style.Label({
			Name = "Label",
			Text = text,
			Size = size,
			Position = position,
			AnchorPoint = anchor,
			MaxTextSize = max,
			MinTextSize = min,
			TextColor = props.TextColor,
			StrokeThickness = if max >= 22 then 3 else 2,
			ZIndex = z + 3,
			Parent = face,
		})
	end
	if props.Icon and props.Vertical then
		-- Oversized icon (pokes a little over the top edge) + caption on the bottom edge.
		local hasText = text ~= ""
		icon = AtlasIcon.new({
			Icon = props.Icon,
			Size = UDim2.fromScale(if hasText then 0.86 else 0.9, if hasText then 0.74 else 0.9),
			Position = UDim2.fromScale(0.5, if hasText then 0.34 else 0.47),
			ZIndex = z + 2,
			Parent = face,
		})
		label = caption(
			UDim2.new(1, -4, 0.32, 0),
			UDim2.new(0.5, 0, 1, -2),
			Vector2.new(0.5, 1),
			props.MaxTextSize or 20,
			10
		)
	elseif props.Icon then
		icon = AtlasIcon.new({
			Icon = props.Icon,
			Size = UDim2.fromScale(0.5, 0.86),
			Position = UDim2.new(0, 6, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			ZIndex = z + 2,
			Parent = face,
		})
		label = caption(
			UDim2.new(1, if text ~= "" then -56 else -12, 0.7, 0),
			UDim2.new(1, -8, 0.5, 0),
			Vector2.new(1, 0.5),
			maxText
		)
	else
		label = caption(UDim2.new(1, -14, 0.7, 0), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), maxText)
	end

	local badge = Style.Label({
		Name = "Badge",
		Text = "!",
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, 8, 0, -8),
		AnchorPoint = Vector2.new(1, 0),
		MaxTextSize = 20,
		StrokeThickness = 2,
		ZIndex = z + 5,
		Parent = holder,
	})
	badge.BackgroundTransparency = 0
	badge.BackgroundColor3 = Style.Colors.Danger
	badge.Visible = false
	Style.Corner(badge, Style.Theme.CornerPill)
	local badgeRing = Instance.new("UIStroke")
	badgeRing.Color = Style.Colors.Stroke
	badgeRing.Thickness = 2.5
	badgeRing.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	badgeRing.Parent = badge

	local hoverScale = Instance.new("UIScale")
	hoverScale.Name = "Hover"
	hoverScale.Parent = face -- separate from the "Pop" scale on the holder

	local button: Button
	local pressed = false
	local focused = false

	local function press(down: boolean)
		if down == pressed then
			return
		end
		pressed = down
		local offset = if down then LIP - 1 else 0
		Style.Tween(face, if down then 0.05 else 0.12, { Position = UDim2.fromOffset(0, offset) })
	end

	local activated = Signal.new()
	local function activate()
		press(false)
		if not button.Enabled then
			SoundController.Play("Error", 1, 0.6)
			Style.Pop(holder, -0.06)
			return
		end
		if props.Sound ~= "" then
			SoundController.Play(props.Sound or "Click", 0.95 + math.random() * 0.1)
		end
		Style.Pop(holder, 0.1)
		activated:Fire()
		if props.OnClick then
			task.spawn(props.OnClick)
		end
	end

	face.MouseButton1Down:Connect(function()
		if button.Enabled then
			press(true)
		end
	end)
	face.MouseButton1Up:Connect(function()
		press(false)
	end)
	face.MouseLeave:Connect(function()
		press(false)
		Style.Tween(hoverScale, 0.12, { Scale = 1 })
	end)
	face.MouseEnter:Connect(function()
		if button.Enabled then
			Style.Tween(hoverScale, 0.15, { Scale = 1.05 }, Enum.EasingStyle.Back)
		end
	end)
	face.SelectionGained:Connect(function()
		focused = true
		faceStroke.Color = Style.Colors.Gold
		faceStroke.Thickness = 4
		Style.Tween(hoverScale, 0.15, { Scale = 1.06 }, Enum.EasingStyle.Back)
	end)
	face.SelectionLost:Connect(function()
		focused = false
		faceStroke.Color = Style.Colors.Stroke
		faceStroke.Thickness = 3
		Style.Tween(hoverScale, 0.12, { Scale = 1 })
	end)
	face.Activated:Connect(activate)

	if props.HitPadding and props.HitPadding > 0 then
		-- Bigger invisible touch target behind the face (small round HUD buttons).
		local pad = props.HitPadding :: number
		local hit = Instance.new("TextButton")
		hit.Name = "HitArea"
		hit.Text = ""
		hit.BackgroundTransparency = 1
		hit.Selectable = false
		hit.AutoButtonColor = false
		hit.Size = UDim2.new(1, pad * 2, 1, pad * 2)
		hit.Position = UDim2.fromScale(0.5, 0.5)
		hit.AnchorPoint = Vector2.new(0.5, 0.5)
		hit.ZIndex = z
		hit.Parent = holder
		hit.Activated:Connect(activate)
	end

	local function paint(c: Color3, enabled: boolean)
		face.BackgroundColor3 = c
		shadow.BackgroundColor3 = Style.Darken(c, 0.45)
		faceStroke.Transparency = if enabled then 0 else 0.25
		faceStroke.Color = if focused then Style.Colors.Gold else Style.Colors.Stroke
		gloss.Visible = enabled
	end

	button = {
		Holder = holder,
		Face = face,
		Shadow = shadow,
		Label = label,
		Icon = icon,
		Badge = badge,
		Enabled = true,
		Color = color,
		Activated = activated,
		SetText = function(self: Button, newText: string)
			self.Label.Text = newText
		end,
		SetIcon = function(self: Button, newIcon: string)
			local current = self.Icon
			if current and current.Key ~= newIcon then
				current:Set(newIcon)
			end
		end,
		SetColor = function(self: Button, newColor: Color3)
			self.Color = newColor
			if self.Enabled then
				paint(newColor, true)
			end
		end,
		SetEnabled = function(self: Button, enabled: boolean)
			self.Enabled = enabled
			paint(if enabled then self.Color else Style.Colors.Disabled, enabled)
		end,
		SetBadge = function(self: Button, badgeText: string?)
			local wasVisible = self.Badge.Visible
			self.Badge.Visible = badgeText ~= nil
			if badgeText then
				self.Badge.Text = badgeText
				if not wasVisible then
					Style.PopIn(self.Badge)
				end
			end
		end,
		SetVisible = function(self: Button, visible: boolean)
			self.Holder.Visible = visible
		end,
		Destroy = function(self: Button)
			activated:DisconnectAll()
			self.Holder:Destroy()
		end,
	}

	if props.Parent then
		holder.Parent = props.Parent
	end
	return button
end

return Button
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="128">
              <Properties>
                <string name="Name">Card</string>
                <string name="Source"><![CDATA[--!strict
-- Card — rounded tile with a chunky dark base and outline. Default colour is the lighter
-- navy used for inner cards on the ocean-navy panel bodies (docs/UI_STYLE.md); optional
-- gradient (e.g. rarity colours). SetHighlight(Gold) = selected/current (3-4 px gold outline).
local Style = require(script.Parent.Style)

local Card = {}

local SHADOW = 4

export type CardProps = {
	Name: string?,
	Parent: Instance?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Color: Color3?,
	Gradient: { Color3 }?,
	GradientRotation: number?,
	StrokeColor: Color3?,
	LayoutOrder: number?,
	Corner: UDim?,
	ZIndex: number?,
}

export type Card = {
	Holder: Frame,
	Face: Frame,
	Shadow: Frame,
	Stroke: UIStroke,
	Gradient: UIGradient?,
	SetColor: (self: Card, color: Color3, gradient: { Color3 }?) -> (),
	SetHighlight: (self: Card, color: Color3?) -> (),
}

function Card.new(props: CardProps): Card
	local color = props.Color or Style.Colors.NavyCard
	local corner = props.Corner or Style.Theme.CornerMedium
	local z = props.ZIndex or 1

	local holder = Instance.new("Frame")
	holder.Name = props.Name or "Card"
	holder.BackgroundTransparency = 1
	holder.Size = props.Size or UDim2.fromOffset(150, 200)
	holder.Position = props.Position or UDim2.new()
	holder.AnchorPoint = props.AnchorPoint or Vector2.zero
	holder.LayoutOrder = props.LayoutOrder or 0
	holder.ZIndex = z

	local shadow = Instance.new("Frame")
	shadow.Name = "Shadow"
	shadow.Size = UDim2.new(1, 0, 1, -SHADOW)
	shadow.Position = UDim2.fromOffset(0, SHADOW)
	shadow.BackgroundColor3 = Style.Colors.Stroke
	shadow.BackgroundTransparency = 0.2
	shadow.BorderSizePixel = 0
	shadow.ZIndex = z
	shadow.Parent = holder
	Style.Corner(shadow, corner)

	local face = Instance.new("Frame")
	face.Name = "Face"
	face.Size = UDim2.new(1, 0, 1, -SHADOW)
	face.BackgroundColor3 = color
	face.BorderSizePixel = 0
	face.ZIndex = z + 1
	face.Parent = holder
	Style.Corner(face, corner)
	local stroke = Style.Stroke(face, props.StrokeColor or Style.Colors.Stroke, 3)

	local gradient: UIGradient? = nil
	if props.Gradient then
		face.BackgroundColor3 = Color3.new(1, 1, 1)
		gradient = Style.Gradient(face, props.Gradient, props.GradientRotation or 90)
	end

	local card: Card
	card = {
		Holder = holder,
		Face = face,
		Shadow = shadow,
		Stroke = stroke,
		Gradient = gradient,
		SetColor = function(self: Card, newColor: Color3, newGradient: { Color3 }?)
			if newGradient then
				face.BackgroundColor3 = Color3.new(1, 1, 1)
				if not self.Gradient then
					self.Gradient = Style.Gradient(face, newGradient, props.GradientRotation or 90)
				else
					(self.Gradient :: UIGradient).Color = Style.Sequence(newGradient)
				end
			else
				face.BackgroundColor3 = newColor
				if self.Gradient then
					(self.Gradient :: UIGradient):Destroy()
					self.Gradient = nil
				end
			end
		end,
		SetHighlight = function(self: Card, highlight: Color3?)
			self.Stroke.Color = highlight or props.StrokeColor or Style.Colors.Stroke
			self.Stroke.Thickness = if highlight then 4 else 3
		end,
	}

	if props.Parent then
		holder.Parent = props.Parent
	end
	return card
end

return Card
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="129">
              <Properties>
                <string name="Name">IconLabel</string>
                <string name="Source"><![CDATA[--!strict
-- IconLabel — HUD currency pill: big atlas icon overlapping the left end of a dark navy pill
-- with a big outlined number (coloured by meaning: green coins, mint tokens).
-- SetValue animates the number counting up/down with a pop for that "numbers go up" feel.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Style = require(script.Parent.Style)
local AtlasIcon = require(script.Parent.AtlasIcon)
local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"):WaitForChild("Format"))

local IconLabel = {}

export type IconLabelProps = {
	Name: string?,
	Parent: Instance?,
	Icon: string,
	Text: string?,
	Color: Color3?, -- glow behind the icon
	TextColor: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	LayoutOrder: number?,
	MaxTextSize: number?,
}

export type IconLabel = {
	Frame: Frame,
	Badge: Frame,
	Icon: AtlasIcon.AtlasIcon,
	Label: TextLabel,
	Value: number,
	SetText: (self: IconLabel, text: string, pop: boolean?) -> (),
	SetValue: (self: IconLabel, value: number, formatter: ((number) -> string)?) -> (),
}

function IconLabel.new(props: IconLabelProps): IconLabel
	local frame = Instance.new("Frame")
	frame.Name = props.Name or "IconLabel"
	frame.Size = props.Size or UDim2.fromOffset(200, 44)
	frame.Position = props.Position or UDim2.new()
	frame.AnchorPoint = props.AnchorPoint or Vector2.zero
	frame.LayoutOrder = props.LayoutOrder or 0
	Style.Pill(frame, 0.12)

	-- Big icon overlapping the pill's left end (docs/UI_STYLE.md currency counters).
	local height = if frame.Size.Y.Offset > 0 then frame.Size.Y.Offset else 44
	local iconSize = height + 16
	local badge = Instance.new("Frame")
	badge.Name = "Badge"
	badge.BackgroundTransparency = 1
	badge.Size = UDim2.fromOffset(iconSize, iconSize)
	badge.Position = UDim2.new(0, -iconSize * 0.3, 0.5, 0)
	badge.AnchorPoint = Vector2.new(0, 0.5)
	badge.ZIndex = 3
	badge.Parent = frame
	if props.Color then
		-- soft coloured glow behind the icon
		local glow = Instance.new("Frame")
		glow.Name = "Glow"
		glow.Size = UDim2.fromScale(0.72, 0.72)
		glow.Position = UDim2.fromScale(0.5, 0.5)
		glow.AnchorPoint = Vector2.new(0.5, 0.5)
		glow.BackgroundColor3 = props.Color
		glow.BackgroundTransparency = 0.55
		glow.ZIndex = 3
		glow.Parent = badge
		Style.Corner(glow, Style.Theme.CornerPill)
	end
	local icon = AtlasIcon.new({ Icon = props.Icon, ZIndex = 4, Parent = badge })

	local textLeft = iconSize * 0.7 + 6
	local label = Style.Label({
		Name = "Value",
		Text = props.Text or "0",
		Size = UDim2.new(1, -(textLeft + 12), 0.86, 0),
		Position = UDim2.new(0, textLeft, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Font = Style.Fonts.Title,
		TextColor = props.TextColor,
		StrokeThickness = 3,
		MaxTextSize = props.MaxTextSize or 28,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = frame,
	})

	local counting: RBXScriptConnection? = nil

	local iconLabel: IconLabel
	iconLabel = {
		Frame = frame,
		Badge = badge,
		Icon = icon,
		Label = label,
		Value = 0,
		SetText = function(_: IconLabel, text: string, pop: boolean?)
			label.Text = text
			if pop then
				Style.Pop(badge, 0.25)
			end
		end,
		SetValue = function(self: IconLabel, value: number, formatter: ((number) -> string)?)
			local fmt = formatter or Format.Abbreviate
			local from = self.Value
			self.Value = value
			if counting then
				counting:Disconnect()
				counting = nil
			end
			if from == value then
				label.Text = fmt(value)
				return
			end
			if value > from then
				Style.Pop(badge, 0.3)
			end
			local start = os.clock()
			local duration = 0.45
			counting = RunService.Heartbeat:Connect(function()
				local t = math.min((os.clock() - start) / duration, 1)
				local eased = 1 - (1 - t) ^ 3
				label.Text = fmt(from + (value - from) * eased)
				if t >= 1 and counting then
					counting:Disconnect()
					counting = nil
				end
			end)
		end,
	}

	if props.Parent then
		frame.Parent = props.Parent
	end
	return iconLabel
end

return IconLabel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="130">
              <Properties>
                <string name="Name">Panel</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Panel — centred modal window (docs/UI_STYLE.md): ocean-navy body with a thick dark outline,
	one saturated header bar (atlas icon, big outlined title, red square close button) — plus
	the panel registry: only one panel is open at a time.

		local panel = Panel.new({ Name = "Shop", Title = "Shop", Icon = Icons.Shop, Color = ... })
		panel.Opened:Connect(function(args) ... end)
		Panel.Open("Shop", { Tab = "Backpacks" })  -- from anywhere (HUD, prompts, tutorial)

	Opening pops the window in with Back easing, dims the world, and on gamepad selects the
	first button. ButtonB / clicking the dim background closes it.
]]
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Style = require(script.Parent.Style)
local AtlasIcon = require(script.Parent.AtlasIcon)
local Signal = require(script.Parent.Parent.Parent.Util.Signal)
local Root = require(script.Parent.Parent.Root)
local SoundController = require(script.Parent.Parent.Parent.Controllers.SoundController)

local Panel = {}

local HEADER = 58

export type PanelProps = {
	Name: string,
	Title: string,
	Icon: string?,
	Color: Color3?,
	Size: Vector2?, -- design px
}

export type Panel = {
	Name: string,
	Window: Frame,
	Body: Frame,
	Header: Frame,
	Title: TextLabel,
	IsOpen: boolean,
	Opened: Signal.Signal, -- (args)
	Closed: Signal.Signal,
	Open: (self: Panel, args: any?) -> (),
	Close: (self: Panel) -> (),
	SetTitle: (self: Panel, text: string) -> (),
}

local registry: { [string]: Panel } = {}
local current: Panel? = nil
local dim: TextButton? = nil

Panel.Changed = Signal.new() -- (openPanelName or nil)

local function getDim(): TextButton
	if dim then
		return dim
	end
	local d = Instance.new("TextButton")
	d.Name = "Dim"
	d.Text = ""
	d.AutoButtonColor = false
	d.Selectable = false
	d.BackgroundColor3 = Color3.new(0, 0, 0)
	d.BackgroundTransparency = 1
	d.Size = UDim2.fromScale(4, 4)
	d.Position = UDim2.fromScale(0.5, 0.5)
	d.AnchorPoint = Vector2.new(0.5, 0.5)
	d.Visible = false
	d.ZIndex = 0
	d.Parent = Root.Get("Panels")
	d.Activated:Connect(function()
		Panel.CloseAll()
	end)
	dim = d
	return d
end

local function setDim(visible: boolean)
	local d = getDim()
	if visible then
		d.Visible = true
		Style.Tween(d, 0.2, { BackgroundTransparency = 0.6 })
	else
		local tween = Style.Tween(d, 0.2, { BackgroundTransparency = 1 })
		tween.Completed:Once(function()
			if not current then
				d.Visible = false
			end
		end)
	end
end

local function firstSelectable(root: Instance): GuiObject?
	for _, d in root:GetDescendants() do
		if d:IsA("GuiButton") and d.Visible and d.Selectable and d.Name == "Face" then
			return d
		end
	end
	return nil
end

local function bindBack(panel: Panel)
	ContextActionService:BindActionAtPriority("DigClosePanel", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			panel:Close()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
end

function Panel.new(props: PanelProps): Panel
	local size = props.Size or Vector2.new(760, 470)
	local color = props.Color or Style.Colors.Ocean

	local window = Instance.new("Frame")
	window.Name = props.Name
	window.BackgroundTransparency = 1
	window.Size = UDim2.fromOffset(size.X, size.Y)
	window.AnchorPoint = Vector2.new(0.5, 0.5)
	window.Position = UDim2.new(0.5, 0, 0.5, 6)
	window.Visible = false
	window.ZIndex = 2
	window.Parent = Root.Get("Panels")

	local openScale = Instance.new("UIScale")
	openScale.Name = "Open"
	openScale.Parent = window

	-- Shrink the whole window when the screen is smaller than the panel (short phones),
	-- keeping a small margin (the close button sits inside the header).
	local function fit(): number
		local design = Root.GetDesignSize()
		if design.X <= 0 or design.Y <= 0 then
			return 1
		end
		return math.min(1, (design.Y - 24) / (size.Y + 12), (design.X - 24) / (size.X + 12))
	end
	Root.ScaleChanged:Connect(function()
		if window.Visible then
			openScale.Scale = fit()
		end
	end)

	local shadow = Instance.new("Frame")
	shadow.Name = "Shadow"
	shadow.Size = UDim2.new(1, 0, 1, -6)
	shadow.Position = UDim2.fromOffset(0, 8)
	shadow.BackgroundColor3 = Style.Colors.Stroke
	shadow.BackgroundTransparency = 0.25
	shadow.ZIndex = 2
	shadow.Parent = window
	Style.Corner(shadow, Style.Theme.CornerLarge)

	-- Ocean-navy body with a thick dark outline.
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.Size = UDim2.new(1, 0, 1, -6)
	face.ZIndex = 3
	face.Parent = window
	Style.Corner(face, Style.Theme.CornerLarge)
	Style.Stroke(face, Style.Colors.Stroke, 4)
	Style.NavyBody(face)

	-- One saturated header bar: icon, big outlined title, red square close button.
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, HEADER)
	header.BackgroundColor3 = color
	header.ZIndex = 4
	header.Parent = face
	Style.Corner(header, Style.Theme.CornerLarge)
	-- square off the header's bottom corners
	local headerFill = Instance.new("Frame")
	headerFill.Name = "Square"
	headerFill.Size = UDim2.new(1, 0, 0, 20)
	headerFill.Position = UDim2.new(0, 0, 1, -20)
	headerFill.BackgroundColor3 = color
	headerFill.BorderSizePixel = 0
	headerFill.ZIndex = 4
	headerFill.Parent = header
	local shine = Style.Gloss(header, Style.Theme.CornerMedium, 4)
	shine.Size = UDim2.new(1, -12, 0.42, 0)
	shine.Position = UDim2.fromOffset(6, 4)
	local divider = Instance.new("Frame")
	divider.Name = "Divider"
	divider.Size = UDim2.new(1, 0, 0, 4)
	divider.Position = UDim2.new(0, 0, 1, -2)
	divider.BackgroundColor3 = Style.Colors.Stroke
	divider.BorderSizePixel = 0
	divider.ZIndex = 5
	divider.Parent = header

	local titleLeft = 20
	if props.Icon then
		AtlasIcon.new({
			Name = "HeaderIcon",
			Icon = props.Icon,
			Size = UDim2.fromOffset(66, 66),
			Position = UDim2.new(0, 8, 0.5, -6),
			AnchorPoint = Vector2.new(0, 0.5),
			Rotation = -6,
			ZIndex = 7,
			Parent = header,
		})
		titleLeft = 80
	end
	local title = Style.Label({
		Name = "Title",
		Text = props.Title,
		Size = UDim2.new(1, -(titleLeft + 84), 0, 44),
		Position = UDim2.new(0, titleLeft, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		MaxTextSize = 38,
		XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 3,
		ZIndex = 6,
		Parent = header,
	})

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Size = UDim2.new(1, -28, 1, -HEADER - 22)
	body.Position = UDim2.fromOffset(14, HEADER + 10)
	body.ZIndex = 4
	body.Parent = face

	-- Red square close button with a drawn X (built inline to avoid a Button <-> Panel loop).
	local closeLip = Instance.new("Frame")
	closeLip.Name = "CloseLip"
	closeLip.Size = UDim2.fromOffset(50, 50)
	closeLip.AnchorPoint = Vector2.new(1, 0.5)
	closeLip.Position = UDim2.new(1, -10, 0, HEADER / 2 + 3)
	closeLip.BackgroundColor3 = Style.Darken(Style.Colors.Danger, 0.45)
	closeLip.ZIndex = 8
	closeLip.Parent = window
	Style.Corner(closeLip, UDim.new(0, 10))
	Style.Stroke(closeLip, Style.Colors.Stroke, 3)
	local close = Instance.new("TextButton")
	close.Name = "Face"
	close.Text = ""
	close.AutoButtonColor = true
	close.BackgroundColor3 = Style.Colors.Danger
	close.Size = UDim2.fromOffset(50, 50)
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.Position = UDim2.new(1, -10, 0, HEADER / 2 - 2)
	close.ZIndex = 9
	close.Parent = window
	Style.Corner(close, UDim.new(0, 10))
	Style.Stroke(close, Style.Colors.Stroke, 3)
	Style.Gloss(close, UDim.new(0, 7), 9)
	for _, angle in { 45, -45 } do
		local bar = Instance.new("Frame")
		bar.Name = "X"
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Position = UDim2.fromScale(0.5, 0.5)
		bar.Size = UDim2.new(0.64, 0, 0, 9)
		bar.Rotation = angle
		bar.BackgroundColor3 = Style.Colors.Text
		bar.BorderSizePixel = 0
		bar.ZIndex = 10
		bar.Parent = close
		Style.Corner(bar, Style.Theme.CornerPill)
		Style.Stroke(bar, Style.Colors.Stroke, 2)
	end
	-- Invisible, larger touch target (>= 44 real px on a phone at UI scale 0.6).
	local closeHit = Instance.new("TextButton")
	closeHit.Name = "HitArea"
	closeHit.Text = ""
	closeHit.BackgroundTransparency = 1
	closeHit.Selectable = false
	closeHit.Size = UDim2.fromOffset(80, 80)
	closeHit.AnchorPoint = Vector2.new(0.5, 0.5)
	closeHit.Position = UDim2.new(1, -35, 0, HEADER / 2)
	closeHit.ZIndex = 7
	closeHit.Parent = window

	local opened = Signal.new()
	local closed = Signal.new()

	local panel: Panel
	panel = {
		Name = props.Name,
		Window = window,
		Body = body,
		Header = header,
		Title = title,
		IsOpen = false,
		Opened = opened,
		Closed = closed,
		Open = function(self: Panel, args: any?)
			if current and current ~= self then
				(current :: Panel):Close()
			end
			current = self
			local wasOpen = self.IsOpen
			self.IsOpen = true
			if not wasOpen then
				window.Visible = true
				local target = fit()
				openScale.Scale = 0.55 * target
				Style.Tween(openScale, 0.32, { Scale = target }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				setDim(true)
				SoundController.Play("Whoosh", 1.2, 0.6)
				bindBack(self)
				Panel.Changed:Fire(self.Name)
			end
			opened:Fire(args)
			if UserInputService.GamepadEnabled then
				task.defer(function()
					GuiService.SelectedObject = firstSelectable(body) or close
				end)
			end
		end,
		Close = function(self: Panel)
			if not self.IsOpen then
				return
			end
			self.IsOpen = false
			if current == self then
				current = nil
				setDim(false)
				ContextActionService:UnbindAction("DigClosePanel")
				Panel.Changed:Fire(nil)
			end
			local tween =
				Style.Tween(openScale, 0.14, { Scale = 0.6 * fit() }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			tween.Completed:Once(function()
				if not self.IsOpen then
					window.Visible = false
				end
			end)
			local selected = GuiService.SelectedObject
			if selected and selected:IsDescendantOf(window) then
				GuiService.SelectedObject = nil
			end
			closed:Fire()
		end,
		SetTitle = function(_: Panel, text: string)
			title.Text = text
		end,
	}

	close.Activated:Connect(function()
		SoundController.Play("Click")
		panel:Close()
	end)
	closeHit.Activated:Connect(function()
		SoundController.Play("Click")
		panel:Close()
	end)

	registry[props.Name] = panel
	return panel
end

function Panel.Get(name: string): Panel?
	return registry[name]
end

function Panel.Open(name: string, args: any?)
	local panel = registry[name]
	if panel then
		panel:Open(args)
	else
		warn("[Panel] unknown panel", name)
	end
end

function Panel.Toggle(name: string, args: any?)
	local panel = registry[name]
	if not panel then
		return
	end
	if panel.IsOpen then
		panel:Close()
	else
		panel:Open(args)
	end
end

function Panel.CloseAll()
	if current then
		(current :: Panel):Close()
	end
end

function Panel.Current(): string?
	return if current then (current :: Panel).Name else nil
end

-- Helper: a vertical scrolling list/grid area that auto-sizes its canvas.
function Panel.Scroller(parent: Instance, size: UDim2?, position: UDim2?): ScrollingFrame
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name = "Scroller"
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.Size = size or UDim2.fromScale(1, 1)
	scroller.Position = position or UDim2.new()
	scroller.CanvasSize = UDim2.new()
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.ScrollingDirection = Enum.ScrollingDirection.Y
	scroller.ScrollBarThickness = 10
	scroller.ScrollBarImageColor3 = Style.Colors.Sky
	scroller.ScrollBarImageTransparency = 0.1
	scroller.VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar
	scroller.ElasticBehavior = Enum.ElasticBehavior.Always
	scroller.Selectable = false
	scroller.ZIndex = 5
	scroller.Parent = parent
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 6)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.PaddingLeft = UDim.new(0, 4)
	padding.PaddingRight = UDim.new(0, 4)
	padding.Parent = scroller
	return scroller
end

return Panel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="131">
              <Properties>
                <string name="Name">ProgressBar</string>
                <string name="Source"><![CDATA[--!strict
-- ProgressBar — pill-shaped bar with shiny fill and centred caption. Set(alpha, text).
local Style = require(script.Parent.Style)

local ProgressBar = {}

export type ProgressBarProps = {
	Name: string?,
	Parent: Instance?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Color: Color3?,
	BackColor: Color3?,
	Text: string?,
	LayoutOrder: number?,
	MaxTextSize: number?,
	Vertical: boolean?, -- fills bottom -> top
	ZIndex: number?,
}

export type ProgressBar = {
	Frame: Frame,
	Fill: Frame,
	Label: TextLabel,
	Stroke: UIStroke,
	Alpha: number,
	Set: (self: ProgressBar, alpha: number, text: string?, instant: boolean?) -> (),
	SetColor: (self: ProgressBar, color: Color3) -> (),
}

function ProgressBar.new(props: ProgressBarProps): ProgressBar
	local z = props.ZIndex or 1
	local vertical = props.Vertical == true

	local frame = Instance.new("Frame")
	frame.Name = props.Name or "ProgressBar"
	frame.Size = props.Size or UDim2.fromOffset(240, 32)
	frame.Position = props.Position or UDim2.new()
	frame.AnchorPoint = props.AnchorPoint or Vector2.zero
	frame.BackgroundColor3 = props.BackColor or Style.Colors.NavyDark
	frame.BackgroundTransparency = 0.05
	frame.BorderSizePixel = 0
	frame.LayoutOrder = props.LayoutOrder or 0
	frame.ZIndex = z
	frame.ClipsDescendants = false
	Style.Corner(frame, Style.Theme.CornerPill)
	local stroke = Style.Stroke(frame, Style.Colors.Stroke, 3)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = props.Color or Style.Colors.Palm
	fill.ZIndex = z + 1
	if vertical then
		fill.AnchorPoint = Vector2.new(0, 1)
		fill.Position = UDim2.fromScale(0, 1)
		fill.Size = UDim2.fromScale(1, 0)
	else
		fill.Size = UDim2.fromScale(0, 1)
	end
	fill.Parent = frame
	Style.Corner(fill, Style.Theme.CornerPill)
	Style.Gradient(
		fill,
		{ Color3.new(1, 1, 1), Color3.fromRGB(225, 225, 225), Color3.fromRGB(190, 190, 190) },
		if vertical then 0 else 90
	)

	local label = Style.Label({
		Name = "Caption",
		Text = props.Text or "",
		Size = UDim2.new(1, -12, 0.8, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = props.MaxTextSize or 22,
		Font = Style.Fonts.Title,
		StrokeThickness = 2,
		ZIndex = z + 2,
		Parent = frame,
	})

	local bar: ProgressBar
	bar = {
		Frame = frame,
		Fill = fill,
		Label = label,
		Stroke = stroke,
		Alpha = 0,
		Set = function(self: ProgressBar, alpha: number, text: string?, instant: boolean?)
			alpha = math.clamp(if alpha ~= alpha then 0 else alpha, 0, 1)
			self.Alpha = alpha
			local visible = alpha > 0.001
			local target = if vertical then UDim2.new(1, 0, alpha, 0) else UDim2.new(alpha, 0, 1, 0)
			fill.Visible = visible
			if instant then
				fill.Size = target
			else
				Style.Tween(fill, 0.25, { Size = target }, Enum.EasingStyle.Quad)
			end
			if text then
				label.Text = text
			end
		end,
		SetColor = function(_: ProgressBar, color: Color3)
			fill.BackgroundColor3 = color
		end,
	}

	if props.Parent then
		frame.Parent = props.Parent
	end
	return bar
end

return ProgressBar
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="132">
              <Properties>
                <string name="Name">Style</string>
                <string name="Source"><![CDATA[--!strict
-- Shared styling helpers: theme access, instance property application, corners, strokes,
-- gradients, chunky text and bouncy tweens. Every component builds on these.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Root = require(script.Parent.Parent.Root)

local Style = {}

Style.Theme = Config.Theme
Style.Colors = Config.Theme.Colors
Style.Fonts = Config.Theme.Fonts

-- Assigns props to inst (Parent last) and returns inst with its type preserved.
function Style.Apply<T>(inst: T, props: { [string]: any }): T
	local parent = nil
	for key, value in props do
		if key == "Parent" then
			parent = value
		else
			(inst :: any)[key] = value
		end
	end
	if parent then
		(inst :: any).Parent = parent
	end
	return inst
end

function Style.Darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

function Style.Lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

function Style.Corner(parent: Instance, radius: UDim?): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius or Style.Theme.CornerMedium
	corner.Parent = parent
	return corner
end

-- border = true strokes the frame outline; false strokes text (Contextual).
function Style.Stroke(parent: Instance, color: Color3?, thickness: number?, border: boolean?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Style.Colors.Stroke
	stroke.Thickness = thickness or Style.Theme.StrokeThickness
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.ApplyStrokeMode = if border == false then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border
	stroke.Parent = parent
	return stroke
end

function Style.Sequence(colors: { Color3 }): ColorSequence
	if #colors == 0 then
		return ColorSequence.new(Color3.new(1, 1, 1))
	elseif #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local keypoints = {}
	for i, color in colors do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), color))
	end
	return ColorSequence.new(keypoints)
end

function Style.Gradient(parent: Instance, colors: { Color3 }, rotation: number?): UIGradient
	local gradient = Instance.new("UIGradient")
	gradient.Color = Style.Sequence(colors)
	gradient.Rotation = rotation or 90
	gradient.Parent = parent
	return gradient
end

-- Subtle top-to-bottom shine used on buttons/cards (white -> light grey multiplies the colour).
function Style.Shine(parent: Instance): UIGradient
	return Style.Gradient(parent, { Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215) }, 90)
end

-- Toy-button gloss (docs/UI_STYLE.md): a soft white strip across the top third of a face,
-- inset from the outline. Returns the strip so callers can hide it (e.g. disabled buttons).
function Style.Gloss(parent: GuiObject, corner: UDim?, zIndex: number?): Frame
	local gloss = Instance.new("Frame")
	gloss.Name = "Gloss"
	gloss.BackgroundColor3 = Color3.new(1, 1, 1)
	gloss.BackgroundTransparency = 0.72
	gloss.BorderSizePixel = 0
	gloss.Size = UDim2.new(1, -8, 0.36, -2)
	gloss.Position = UDim2.fromOffset(4, 3)
	gloss.ZIndex = zIndex or parent.ZIndex
	gloss.Active = false
	gloss.Parent = parent
	Style.Corner(gloss, corner or Style.Theme.CornerSmall)
	local fade = Instance.new("UIGradient")
	fade.Rotation = 90
	fade.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 0.55),
	})
	fade.Parent = gloss
	return gloss
end

-- Ocean-navy panel/card body gradient (Navy -> NavyDark).
function Style.NavyBody(parent: GuiObject): UIGradient
	parent.BackgroundColor3 = Color3.new(1, 1, 1)
	return Style.Gradient(parent, { Style.Colors.Navy, Style.Colors.NavyDark }, 90)
end

-- Small dark rounded "pill" backdrop for HUD readouts / toasts / the objective banner.
function Style.Pill(parent: GuiObject, transparency: number?)
	parent.BackgroundColor3 = Style.Colors.NavyDark
	parent.BackgroundTransparency = transparency or 0.08
	parent.BorderSizePixel = 0
	Style.Corner(parent, Style.Theme.CornerPill)
	Style.Stroke(parent, Style.Colors.Stroke, 3)
end

function Style.Padding(parent: Instance, px: number, horizontal: number?): UIPadding
	local padding = Instance.new("UIPadding")
	local h = UDim.new(0, horizontal or px)
	local v = UDim.new(0, px)
	padding.PaddingLeft = h
	padding.PaddingRight = h
	padding.PaddingTop = v
	padding.PaddingBottom = v
	padding.Parent = parent
	return padding
end

function Style.List(
	parent: Instance,
	direction: Enum.FillDirection?,
	padding: number?,
	hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?
): UIListLayout
	local list = Instance.new("UIListLayout")
	list.FillDirection = direction or Enum.FillDirection.Vertical
	list.Padding = UDim.new(0, padding or 6)
	list.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center
	list.VerticalAlignment = vAlign or Enum.VerticalAlignment.Top
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = parent
	return list
end

-- Text size caps follow the UI scale --------------------------------------------------------
-- UITextSizeConstraint limits are applied in screen pixels and are NOT multiplied by the
-- canvas UIScale, so on a big PC screen (scale 1.35) a "MaxTextSize = 16" caption stayed 16 px
-- inside a button that had grown 35% ("tiny text" playtest feedback). Every constraint made
-- by Style.Label registers its design-pixel caps here and is rescaled whenever Root.Scale
-- changes. Caps are never shrunk below their design value (TextScaled already shrinks text to
-- fit smaller boxes on phones) and the minimum never drops below a readable 8 px.
local MIN_READABLE = 8
local constraints: { [UITextSizeConstraint]: { Max: number, Min: number } } = setmetatable({}, { __mode = "k" }) :: any

local function applyCaps(constraint: UITextSizeConstraint, caps: { Max: number, Min: number }, scale: number)
	local up = math.max(scale, 1)
	constraint.MaxTextSize = math.clamp(math.floor(caps.Max * up + 0.5), 1, 100)
	constraint.MinTextSize = math.clamp(math.max(caps.Min, MIN_READABLE), 1, constraint.MaxTextSize)
end

-- Registers a UITextSizeConstraint (design-pixel caps) so it follows the UI scale.
function Style.TrackTextSize(constraint: UITextSizeConstraint, maxDesign: number, minDesign: number?)
	local caps = { Max = maxDesign, Min = minDesign or MIN_READABLE }
	constraints[constraint] = caps
	applyCaps(constraint, caps, Root.Scale)
	constraint.Destroying:Once(function()
		constraints[constraint] = nil
	end)
end

Root.ScaleChanged:Connect(function(scale: number)
	for constraint, caps in constraints do
		applyCaps(constraint, caps, scale)
	end
end)

-- Emoji-safe sizing ------------------------------------------------------------------------
-- Playtest: every label containing an emoji ("⛏️ 0m", menu icons) rendered at a fraction of its
-- box, while plain-text labels were fine. TextScaled sizes by the font's line metrics and the
-- emoji fallback font reports a very tall line, so the whole label shrinks. Labels whose text
-- contains a multi-byte symbol therefore use an explicit TextSize computed from the box
-- (height, then shrunk to fit the measured width) instead of TextScaled.
local FIT_HEIGHT = 0.8
local FIT_WIDTH = 0.96

local function hasSymbol(text: string): boolean
	-- 3- and 4-byte UTF-8 sequences: emoji and pictographic symbols (☀ ⛏ 🏝 ...).
	return string.find(text, "[\226-\244]") ~= nil
end

local function fitLabel(label: TextLabel, constraint: UITextSizeConstraint)
	local text = label.Text
	if not hasSymbol(text) then
		label.TextScaled = true
		if constraint.Parent ~= label then
			-- Playtest red error "Parent property of UITextSizeConstraint is locked": a refit
			-- can still run for a label that is being destroyed (deferred signals fire after
			-- Destroy), when its constraint is already locked. Nothing to fit then.
			pcall(function()
				constraint.Parent = label
			end)
		end
		return
	end
	constraint.Parent = nil -- caps are applied by hand below
	label.TextScaled = false
	local box = label.AbsoluteSize
	if box.X < 1 or box.Y < 1 then
		return
	end
	local scale = if Root.Scale > 0 then Root.Scale else 1
	local px = box.Y * FIT_HEIGHT
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(text, math.max(1, math.floor(px)), label.Font, Vector2.new(1e5, 1e5))
	end)
	if ok and bounds.X > box.X * FIT_WIDTH then
		px *= box.X * FIT_WIDTH / bounds.X
	end
	-- TextSize is in canvas units; the canvas UIScale multiplies it back up to screen pixels.
	label.TextSize = math.clamp(math.floor(px / scale), MIN_READABLE, 100)
end

local function autoFit(label: TextLabel, constraint: UITextSizeConstraint)
	local alive = true
	local function refit()
		if alive then
			fitLabel(label, constraint)
		end
	end
	local textConn = label:GetPropertyChangedSignal("Text"):Connect(refit)
	local sizeConn = label:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
	local scaleConn = Root.ScaleChanged:Connect(refit)
	label.Destroying:Connect(function()
		alive = false
		textConn:Disconnect()
		sizeConn:Disconnect()
		scaleConn:Disconnect()
		constraints[constraint] = nil
		-- Symbol fitting can detach this constraint from the label. Dispose it too.
		if constraint.Parent == nil then
			constraint:Destroy()
		end
	end)
	refit()
end

export type LabelProps = {
	Name: string?,
	Text: string?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Font: Enum.Font?,
	TextColor: Color3?,
	MaxTextSize: number?,
	MinTextSize: number?,
	Stroke: boolean?, -- dark outline (default true for light text)
	StrokeColor: Color3?,
	StrokeThickness: number?,
	XAlign: Enum.TextXAlignment?,
	YAlign: Enum.TextYAlignment?,
	LayoutOrder: number?,
	ZIndex: number?,
	Wrapped: boolean?,
	RichText: boolean?,
	Parent: Instance?,
}

-- Chunky cartoon text: scaled to fit, capped by MaxTextSize, dark stroke by default.
function Style.Label(props: LabelProps): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = props.Name or "Label"
	label.BackgroundTransparency = 1
	label.Text = props.Text or ""
	label.Size = props.Size or UDim2.fromScale(1, 1)
	label.Position = props.Position or UDim2.new()
	label.AnchorPoint = props.AnchorPoint or Vector2.zero
	label.Font = props.Font or Style.Fonts.Title
	label.TextColor3 = props.TextColor or Style.Colors.Text
	label.TextScaled = true
	label.TextWrapped = props.Wrapped == true
	label.RichText = props.RichText == true
	label.TextXAlignment = props.XAlign or Enum.TextXAlignment.Center
	label.TextYAlignment = props.YAlign or Enum.TextYAlignment.Center
	label.LayoutOrder = props.LayoutOrder or 0
	label.ZIndex = props.ZIndex or 1
	local constraint = Instance.new("UITextSizeConstraint")
	Style.TrackTextSize(constraint, props.MaxTextSize or 28, props.MinTextSize)
	constraint.Parent = label
	autoFit(label, constraint)
	if props.Stroke ~= false then
		Style.Stroke(label, props.StrokeColor, props.StrokeThickness or 2, false)
	end
	if props.Parent then
		label.Parent = props.Parent
	end
	return label
end

export type IconProps = {
	Name: string?,
	Text: string,
	Size: UDim2?, -- default: fills the parent
	Position: UDim2?, -- default: centred
	AnchorPoint: Vector2?,
	ZIndex: number?,
	LayoutOrder: number?,
	Parent: Instance?,
}

-- Emoji icon that fills its box: square (aspect-ratio locked, fits inside the given size),
-- centred, TextScaled with no small cap, no stroke. Use for every icon slot so icons read at
-- the same visual weight on PC and phone.
function Style.Icon(props: IconProps): TextLabel
	local icon = Style.Label({
		Name = props.Name or "Icon",
		Text = props.Text,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.fromScale(0.5, 0.5),
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
		MaxTextSize = 96,
		MinTextSize = 12,
		Stroke = false,
		ZIndex = props.ZIndex,
		LayoutOrder = props.LayoutOrder,
	})
	icon.TextYAlignment = Enum.TextYAlignment.Center
	local ratio = Instance.new("UIAspectRatioConstraint")
	ratio.AspectRatio = 1
	ratio.AspectType = Enum.AspectType.FitWithinMaxSize
	ratio.Parent = icon
	if props.Parent then
		icon.Parent = props.Parent
	end
	return icon
end

function Style.Tween(
	inst: Instance,
	time: number,
	props: { [string]: any },
	easingStyle: Enum.EasingStyle?,
	direction: Enum.EasingDirection?,
	repeatCount: number?,
	reverses: boolean?
): Tween
	local info = TweenInfo.new(
		time,
		easingStyle or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out,
		repeatCount or 0,
		reverses or false
	)
	local tween = TweenService:Create(inst, info, props)
	tween:Play()
	return tween
end

-- Returns (creating if needed) a UIScale named "Pop" used for bounce effects.
function Style.GetPopScale(gui: GuiObject): UIScale
	local existing = gui:FindFirstChild("Pop")
	if existing and existing:IsA("UIScale") then
		return existing
	end
	local scale = Instance.new("UIScale")
	scale.Name = "Pop"
	scale.Parent = gui
	return scale
end

-- Quick squash-and-stretch bounce: grows by `amount` then springs back.
function Style.Pop(gui: GuiObject, amount: number?)
	local scale = Style.GetPopScale(gui)
	scale.Scale = 1 + (amount or 0.18)
	Style.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
end

-- Pop in from nothing.
function Style.PopIn(gui: GuiObject, time: number?)
	local scale = Style.GetPopScale(gui)
	scale.Scale = 0
	Style.Tween(scale, time or 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

-- Endless gentle pulse; returns the tween so callers can :Cancel() it.
function Style.Pulse(gui: GuiObject, amount: number?, period: number?): Tween
	local scale = Style.GetPopScale(gui)
	scale.Scale = 1
	return Style.Tween(
		scale,
		(period or 0.9) / 2,
		{ Scale = 1 + (amount or 0.08) },
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.InOut,
		-1,
		true
	)
end

function Style.StopPulse(gui: GuiObject, tween: Tween?)
	if tween then
		tween:Cancel()
	end
	local scale = gui:FindFirstChild("Pop")
	if scale and scale:IsA("UIScale") then
		Style.Tween(scale, 0.15, { Scale = 1 })
	end
end

return Style
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="133">
              <Properties>
                <string name="Name">UpgradeRow</string>
                <string name="Source"><![CDATA[--!strict
--[[
	UpgradeRow — one shop item as an upgrade row (docs/UI_STYLE.md "Shop"):
	  [model] Name / tag
	          [ current stat ]  ➜  [ next stat (orange) ]            [ big price button ]
	e.g. "Dig 4×4 ➜ Dig 8×8", "Holds 50 ➜ Holds 120", "Shade 6 ➜ Shade 8 studs". The panel
	drives the state through row.Button (green affordable / grey not / Equip / Equipped) and
	SetStats / SetTag / SetLocked. Extra buttons (e.g. "Pick Up") go into row.Actions.

		local row = UpgradeRow.new({ Name = id, Title = def.Name, Model = model, Parent = list,
			OnClick = function() ... end })
		row:SetStats({ Main = "Dig 4×4", Sub = "Wet Sand" }, { Main = "Dig 8×8", Sub = "Shell Bed" })
]]
local Style = require(script.Parent.Style)
local Button = require(script.Parent.Button)
local Card = require(script.Parent.Card)
local Viewport = require(script.Parent.Viewport)
local AtlasIcon = require(script.Parent.AtlasIcon)

local UpgradeRow = {}

UpgradeRow.HEIGHT = 108
local STAGE = 88
local BOX = Vector2.new(162, 56)
local ARROW = 34
local ACTION_W = 190

export type Stat = { Main: string, Sub: string? }

export type Props = {
	Name: string,
	Title: string,
	Parent: Instance?,
	LayoutOrder: number?,
	Model: Model?,
	Yaw: number?,
	Pitch: number?,
	Fill: number?,
	Rotation: CFrame?,
	StageColors: { Color3 }?,
	ActionWidth: number?,
	OnClick: (() -> ())?,
}

export type UpgradeRow = {
	Card: Card.Card,
	Button: Button.Button,
	Actions: Frame,
	Title: TextLabel,
	SetStats: (self: UpgradeRow, current: Stat?, nextStat: Stat) -> (),
	SetTag: (self: UpgradeRow, text: string?, color: Color3?) -> (),
	SetLocked: (self: UpgradeRow, locked: boolean) -> (),
}

local function statBox(
	parent: Instance,
	name: string,
	x: number,
	color: Color3,
	stroke: Color3
): (Frame, TextLabel, TextLabel)
	local box = Instance.new("Frame")
	box.Name = name
	box.Size = UDim2.fromOffset(BOX.X, BOX.Y)
	box.Position = UDim2.fromOffset(x, 42)
	box.BackgroundColor3 = color
	box.ZIndex = 4
	box.Parent = parent
	Style.Corner(box, Style.Theme.CornerSmall)
	Style.Stroke(box, stroke, 3)
	local main = Style.Label({
		Name = "Main",
		Text = "",
		Size = UDim2.new(1, -10, 0.56, 0),
		Position = UDim2.new(0.5, 0, 0, 3),
		AnchorPoint = Vector2.new(0.5, 0),
		MaxTextSize = 22,
		StrokeThickness = 2,
		ZIndex = 5,
		Parent = box,
	})
	local sub = Style.Label({
		Name = "Sub",
		Text = "",
		Size = UDim2.new(1, -10, 0.36, 0),
		Position = UDim2.new(0.5, 0, 1, -3),
		AnchorPoint = Vector2.new(0.5, 1),
		Font = Style.Fonts.Body,
		MaxTextSize = 13,
		StrokeThickness = 1.5,
		ZIndex = 5,
		Parent = box,
	})
	return box, main, sub
end

function UpgradeRow.new(props: Props): UpgradeRow
	local C = Style.Colors
	local card = Card.new({
		Name = props.Name,
		Size = UDim2.new(1, -14, 0, UpgradeRow.HEIGHT),
		LayoutOrder = props.LayoutOrder,
		ZIndex = 2,
		Parent = props.Parent,
	})
	local face = card.Face

	local stage = Instance.new("Frame")
	stage.Name = "Preview"
	stage.Size = UDim2.fromOffset(STAGE, STAGE)
	stage.Position = UDim2.new(0, 8, 0.5, -2)
	stage.AnchorPoint = Vector2.new(0, 0.5)
	stage.BackgroundColor3 = Color3.new(1, 1, 1)
	stage.ZIndex = 3
	stage.Parent = face
	Style.Corner(stage, Style.Theme.CornerMedium)
	Style.Stroke(stage, C.Stroke, 3)
	Style.Gradient(stage, props.StageColors or { C.Sky, C.Ocean }, 90)
	if props.Model then
		local view = Viewport.new({
			Size = UDim2.fromScale(1, 1),
			ZIndex = 4,
			Pitch = props.Pitch,
			Yaw = props.Yaw,
			Fill = props.Fill,
			Rotation = props.Rotation,
			Parent = stage,
		})
		view:SetModel(props.Model)
	end
	local lock = AtlasIcon.new({
		Name = "Lock",
		Icon = "Lock",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, 6, 1, 6),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 6,
		Parent = stage,
	})
	lock.Frame.Visible = false

	local left = STAGE + 20
	local title = Style.Label({
		Name = "ItemName",
		Text = props.Title,
		Size = UDim2.new(0, BOX.X * 2 + ARROW - 90, 0, 30),
		Position = UDim2.fromOffset(left, 7),
		MaxTextSize = 24,
		StrokeThickness = 2.5,
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 4,
		Parent = face,
	})
	local tag = Style.Label({
		Name = "Tag",
		Text = "",
		Size = UDim2.fromOffset(96, 24),
		Position = UDim2.fromOffset(left + BOX.X * 2 + ARROW - 96, 9),
		MaxTextSize = 15,
		StrokeThickness = 2,
		ZIndex = 5,
		Parent = face,
	})
	tag.BackgroundTransparency = 0
	tag.BackgroundColor3 = C.Coral
	tag.Visible = false
	Style.Corner(tag, Style.Theme.CornerPill)
	Style.Stroke(tag, C.Stroke, 2)

	local currentBox, currentMain, currentSub = statBox(face, "Current", left, C.NavyDark, C.Stroke)
	local arrow = AtlasIcon.new({
		Name = "Arrow",
		Icon = "arrow_right|➜",
		Size = UDim2.fromOffset(ARROW, ARROW),
		Position = UDim2.fromOffset(left + BOX.X + ARROW / 2, 42 + BOX.Y / 2),
		ZIndex = 5,
		Parent = face,
	})
	local nextBox, nextMain, nextSub =
		statBox(face, "Next", left + BOX.X + ARROW, C.Highlight, Style.Darken(C.Highlight, 0.55))
	Style.Gloss(nextBox, Style.Theme.CornerSmall, 4)

	local actions = Instance.new("Frame")
	actions.Name = "Actions"
	actions.BackgroundTransparency = 1
	actions.Size = UDim2.new(0, props.ActionWidth or ACTION_W, 0, 80)
	actions.Position = UDim2.new(1, -10, 0.5, 0)
	actions.AnchorPoint = Vector2.new(1, 0.5)
	actions.ZIndex = 4
	actions.Parent = face
	Style.List(actions, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local button = Button.new({
		Name = "Action",
		Text = "Buy",
		Icon = "Coins",
		Size = UDim2.new(1, 0, 0, 80),
		Color = C.Success,
		MaxTextSize = 26,
		LayoutOrder = 10,
		ZIndex = 5,
		Parent = actions,
		OnClick = props.OnClick,
	})

	local row: UpgradeRow
	row = {
		Card = card,
		Button = button,
		Actions = actions,
		Title = title,
		SetStats = function(_: UpgradeRow, current: Stat?, nextStat: Stat)
			currentBox.Visible = current ~= nil
			arrow.Frame.Visible = current ~= nil
			if current then
				currentMain.Text = current.Main
				currentSub.Text = current.Sub or ""
				nextBox.Position = UDim2.fromOffset(left + BOX.X + ARROW, 42)
			else
				nextBox.Position = UDim2.fromOffset(left, 42)
			end
			nextMain.Text = nextStat.Main
			nextSub.Text = nextStat.Sub or ""
		end,
		SetTag = function(_: UpgradeRow, text: string?, color: Color3?)
			local was = tag.Visible
			tag.Visible = text ~= nil
			tag.Text = text or ""
			tag.BackgroundColor3 = color or C.Coral
			if text and not was then
				Style.PopIn(tag)
			end
		end,
		SetLocked = function(_: UpgradeRow, locked: boolean)
			lock.Frame.Visible = locked
			face.BackgroundColor3 = if locked then C.NavyCardDark else C.NavyCard
			nextBox.BackgroundColor3 = if locked then Style.Darken(C.Highlight, 0.45) else C.Highlight
		end,
	}
	return row
end

return UpgradeRow
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="134">
              <Properties>
                <string name="Name">Viewport</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Viewport — ViewportFrame that frames any Model so it fills ~75% of the frame, from a nice
	three-quarter angle in FRONT of the model (models face -Z, see Shared.Models), optional slow
	spin, optional silhouette (undiscovered index entries).
	The spin connection is cleaned up automatically when the frame is destroyed.

	Framing (Viewport.Fit): only VISIBLE parts count (invisible "Root"/hitbox parts are ignored).
	The model is recentred so its visible bounding-box centre sits at the origin, then every
	corner of every visible part is projected into camera space and the camera distance is the
	smallest D for which all corners fit inside `Fill` of both the vertical and the horizontal
	field of view:  D >= depth + |x| / (tan(hfov/2) * Fill)  and  D >= depth + |y| / (tan(vfov/2) * Fill).
	(For a sphere this is the classic distance = radius / sin(fov/2) with a margin; corner
	projection is tighter for long or flat models such as shovels, coins and backpacks.)
	When spinning, corners are tested at 8 yaw angles so the model never clips mid-turn.

	API (other agents: use this for shop / garage cards):
	  local vp = Viewport.new({ Size = UDim2.fromScale(1, 1), Parent = cardPreview,
	                            Spin = false, Fill = 0.75, Yaw = 25, Pitch = 15, ZIndex = 4 })
	  vp:SetModel(Models.Digger(id))   -- takes ownership; the previous model is destroyed
	  vp:SetSpin(true) / vp:SetSilhouette(true) / vp:Refit()
	  Viewport.Fit(camera, model, { Fill?, Yaw?, Pitch?, Spin?, Aspect?, Rotation? }) -- low-level
	    for your own ViewportFrame: recentres `model` at the origin and points `camera` at it.
	  The frame refits itself when its AbsoluteSize (aspect ratio) changes.
]]
local RunService = game:GetService("RunService")
local State = require(script.Parent.Parent.Parent.Controllers.State)

local Viewport = {}

local DEFAULT_FILL = 0.75
local DEFAULT_YAW = 25 -- degrees: camera swings to the model's front-right
local DEFAULT_PITCH = 15 -- degrees the camera looks down
local FOV = 30

export type FitOptions = {
	Fill: number?, -- fraction of the frame the model should cover (0..1)
	Yaw: number?, -- degrees
	Pitch: number?, -- degrees
	Spin: boolean?, -- fit for every yaw (model spins about Y)
	Aspect: number?, -- frame width / height (default 1)
	Rotation: CFrame?, -- extra model rotation before framing (e.g. tilt a shovel diagonally)
}

export type ViewportProps = {
	Name: string?,
	Parent: Instance?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	LayoutOrder: number?,
	ZIndex: number?,
	Spin: boolean?,
	SpinSpeed: number?, -- radians/sec
	Silhouette: boolean?,
	Fill: number?, -- default 0.75
	Distance: number?, -- legacy: extra camera distance multiplier (1 = exact fit)
	Yaw: number?, -- degrees, default 25
	Pitch: number?, -- degrees the camera looks down, default 15
	Rotation: CFrame?, -- extra model rotation (e.g. CFrame.Angles(0, 0, math.rad(-40)))
}

export type Viewport = {
	Frame: ViewportFrame,
	Camera: Camera,
	Model: Model?,
	SetModel: (self: Viewport, model: Model?) -> (),
	SetSilhouette: (self: Viewport, on: boolean) -> (),
	SetSpin: (self: Viewport, on: boolean) -> (),
	Refit: (self: Viewport) -> (),
}

local function visibleCorners(model: Model): { Vector3 }
	local points = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 0.98 then
			local cf = d.CFrame
			local h = d.Size / 2
			for _, sx in { -1, 1 } do
				for _, sy in { -1, 1 } do
					for _, sz in { -1, 1 } do
						table.insert(points, cf:PointToWorldSpace(Vector3.new(h.X * sx, h.Y * sy, h.Z * sz)))
					end
				end
			end
		end
	end
	return points
end

-- Recentres `model` (pivoted upright at the origin) on its visible bounds and frames it.
-- Returns the CFrame the model was pivoted to (the spin centre).
function Viewport.Fit(camera: Camera, model: Model, options: FitOptions?): CFrame
	local opts: FitOptions = options or {}
	local rotation = if opts.Rotation then opts.Rotation.Rotation else CFrame.identity
	model:PivotTo(rotation)
	local points = visibleCorners(model)
	if #points == 0 then
		local boxCf, size = model:GetBoundingBox()
		local h = size / 2
		for _, sx in { -1, 1 } do
			for _, sy in { -1, 1 } do
				for _, sz in { -1, 1 } do
					table.insert(points, boxCf:PointToWorldSpace(Vector3.new(h.X * sx, h.Y * sy, h.Z * sz)))
				end
			end
		end
	end
	local minV = Vector3.new(math.huge, math.huge, math.huge)
	local maxV = -minV
	for _, p in points do
		minV = minV:Min(p)
		maxV = maxV:Max(p)
	end
	local centre = (minV + maxV) / 2
	local pivot = CFrame.new(-centre) * rotation
	model:PivotTo(pivot)

	local fill = math.clamp(opts.Fill or DEFAULT_FILL, 0.2, 1)
	local yaw = math.rad(opts.Yaw or DEFAULT_YAW)
	local pitch = math.rad(opts.Pitch or DEFAULT_PITCH)
	local aspect = math.max(opts.Aspect or 1, 0.1)
	-- Camera sits in front of the model (models face -Z), swung by yaw, raised by pitch.
	local dir = Vector3.new(math.sin(yaw) * math.cos(pitch), math.sin(pitch), -math.cos(yaw) * math.cos(pitch))
	local look = CFrame.lookAt(dir, Vector3.zero) -- rotation only matters
	local right, up, back = look.RightVector, look.UpVector, -look.LookVector

	camera.FieldOfView = FOV
	local tanV = math.tan(math.rad(FOV / 2)) * fill
	local tanH = tanV * aspect

	local angles = if opts.Spin then 8 else 1
	local distance = 0.5
	for i = 0, angles - 1 do
		local spin = CFrame.Angles(0, i * 2 * math.pi / angles, 0)
		for _, p in points do
			local q = spin * (p - centre)
			local x, y, z = q:Dot(right), q:Dot(up), q:Dot(back)
			distance = math.max(distance, z + math.abs(x) / tanH, z + math.abs(y) / tanV, z + 0.5)
		end
	end
	camera.CFrame = CFrame.lookAt(back * distance, Vector3.zero)
	return pivot
end

function Viewport.new(props: ViewportProps): Viewport
	local frame = Instance.new("ViewportFrame")
	frame.Name = props.Name or "Viewport"
	frame.BackgroundTransparency = 1
	frame.Size = props.Size or UDim2.fromOffset(120, 120)
	frame.Position = props.Position or UDim2.new()
	frame.AnchorPoint = props.AnchorPoint or Vector2.zero
	frame.LayoutOrder = props.LayoutOrder or 0
	frame.ZIndex = props.ZIndex or 1
	-- Soft, even lighting: bright enough to read colours, no blown-out highlights.
	frame.Ambient = Color3.fromRGB(165, 165, 175)
	frame.LightColor = Color3.fromRGB(235, 230, 220)
	frame.LightDirection = Vector3.new(-0.6, -1, 0.8) -- from the camera side (front, -Z)

	local camera = Instance.new("Camera")
	camera.FieldOfView = FOV
	camera.Parent = frame
	frame.CurrentCamera = camera

	local spinOn = props.Spin == true
	local angle = 0
	local center = CFrame.new()
	local spinConnection: RBXScriptConnection? = nil
	local lastAspect = 1

	local vp: Viewport

	local function stopSpin()
		if spinConnection then
			spinConnection:Disconnect()
			spinConnection = nil
		end
	end

	local function startSpin()
		stopSpin()
		if not spinOn or not vp.Model then
			return
		end
		spinConnection = RunService.RenderStepped:Connect(function(dt: number)
			local model = vp.Model
			if model and frame.Parent then
				local visible = frame.Visible and State.GetSetting("ReducedMotion", false) ~= true
				local ancestor: Instance? = frame.Parent
				while visible and ancestor do
					if ancestor:IsA("GuiObject") and not ancestor.Visible then
						visible = false
					elseif ancestor:IsA("ScreenGui") and not ancestor.Enabled then
						visible = false
					end
					ancestor = ancestor.Parent
				end
				if visible then
					angle += dt * (props.SpinSpeed or 1.2)
					model:PivotTo(CFrame.Angles(0, angle, 0) * center)
				end
			else
				stopSpin()
			end
		end)
	end

	local function aspectOf(): number
		local size = frame.AbsoluteSize
		if size.X > 1 and size.Y > 1 then
			return size.X / size.Y
		end
		return 1
	end

	local function fit()
		local current = vp.Model
		if not current then
			return
		end
		local model = current :: Model
		lastAspect = aspectOf()
		center = Viewport.Fit(camera, model, {
			Fill = (props.Fill or DEFAULT_FILL) / (props.Distance or 1),
			Yaw = props.Yaw,
			Pitch = props.Pitch,
			Spin = spinOn,
			Aspect = lastAspect,
			Rotation = props.Rotation,
		})
		if spinOn then
			model:PivotTo(CFrame.Angles(0, angle, 0) * center)
		end
	end

	vp = {
		Frame = frame,
		Camera = camera,
		Model = nil,
		SetModel = function(self: Viewport, newModel: Model?)
			if self.Model then
				(self.Model :: Model):Destroy()
			end
			self.Model = newModel
			if not newModel then
				stopSpin()
				return
			end
			local model = newModel :: Model
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") then
					d.Anchored = true
				elseif d:IsA("Script") or d:IsA("LocalScript") then
					d:Destroy()
				end
			end
			angle = 0
			fit()
			model.Parent = frame
			startSpin()
		end,
		SetSilhouette = function(_: Viewport, on: boolean)
			frame.ImageColor3 = if on then Color3.new(0, 0, 0) else Color3.new(1, 1, 1)
			frame.ImageTransparency = if on then 0.35 else 0
		end,
		SetSpin = function(_: Viewport, on: boolean)
			if on ~= spinOn then
				spinOn = on
				fit() -- spinning needs room for every yaw
			end
			if on then
				startSpin()
			else
				stopSpin()
			end
		end,
		Refit = function(_: Viewport)
			fit()
		end,
	}

	if props.Silhouette then
		vp:SetSilhouette(true)
	end
	frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if vp.Model and math.abs(aspectOf() - lastAspect) > 0.05 then
			fit()
		end
	end)
	frame.Destroying:Connect(stopSpin)
	if props.Parent then
		frame.Parent = props.Parent
	end
	return vp
end

return Viewport
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">DetectorHUD</string>
              <string name="Source"><![CDATA[--!strict
--[[
	DetectorHUD (v3 discovery slice) — the free treasure detector everyone has.

	One big toy button "Scan" (80 x 80 design px, same as Surface / Sell / Auto) at the left of
	the bottom action row (HUD.ActionsRow), so phones, tablets and PCs all get it in the same
	thumb-friendly spot. Key T / gamepad L2 do the same (DiscoveryController).

	While a scan runs the button becomes the radar:
	  - its outline glows in the signal colour (white = common, gold = rare+, purple = mythic+)
	  - a dot orbits the button pointing at the find, relative to the camera
	  - the caption reads the distance band (HOT! / Warm / Cool / Faint / Nothing)
	  - a pill above it says what to do: DIG HERE! / DIG DOWN! when the find is within the hot
	    band, DIG DOWN HERE! when it is straight below you (Ping.Overhead: the dot hides, since
	    walking would not help), otherwise DOWN / UP when it is below / above you
	    (DetectorHUD.Instruction)
	  - the orbiting dot carries an arrowhead pointing away from the button, toward the find
	Between scans the caption counts the cooldown down. Everything is driven by the coarse
	DetectorPing (band, sector, vertical, signal); DetectorHUD.Render(ping, scanning, cooldown)
	is public for tests.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))

local Style = require(script.Parent.Components.Style)
local Button = require(script.Parent.Components.Button)
local AtlasIcon = require(script.Parent.Components.AtlasIcon)
local HUD = require(script.Parent.HUD)
local DiscoveryController = require(script.Parent.Parent.Controllers.DiscoveryController)

local DetectorHUD = {}

DetectorHUD.Button = nil :: Button.Button?
DetectorHUD.BAND_WORDS = table.freeze({ "HOT!", "Warm", "Cool", "Faint" })

local C = Style.Colors
local pivot: Frame? = nil
local dot: Frame? = nil
local ringStroke: UIStroke? = nil
local verticalPill: TextLabel? = nil
local initialized = false

-- What the pill above the button says (pure, tests): "" when there is nothing to say.
function DetectorHUD.Instruction(ping: Types.DetectorPing, scanning: boolean): string
	if not scanning or ping.Band <= 0 then
		return ""
	end
	if ping.Band == 1 then
		return if ping.Vertical == "Up" then "UP HERE!" elseif ping.Vertical == "Down" then "DIG DOWN!" else "DIG HERE!"
	end
	if ping.Overhead == true then
		-- straight below / above: no compass arrow, say exactly what to do
		return if ping.Vertical == "Down" then "DIG DOWN HERE!" elseif ping.Vertical == "Up" then "UP HERE!" else ""
	end
	return if ping.Vertical == "Down" then "DOWN" elseif ping.Vertical == "Up" then "UP" else ""
end

-- Caption for the button (pure, tests).
function DetectorHUD.Caption(ping: Types.DetectorPing, scanning: boolean, cooldown: number): string
	if scanning then
		if ping.Band <= 0 then
			return "Nothing"
		end
		return DetectorHUD.BAND_WORDS[math.clamp(ping.Band, 1, #DetectorHUD.BAND_WORDS)]
	end
	if cooldown > 0 then
		return tostring(math.ceil(cooldown)) .. "s"
	end
	return "Scan"
end

function DetectorHUD.Render(ping: Types.DetectorPing, scanning: boolean, cooldown: number)
	local maybeButton = DetectorHUD.Button
	if not maybeButton then
		return
	end
	local button = maybeButton :: Button.Button
	button:SetText(DetectorHUD.Caption(ping, scanning, cooldown))
	local live = scanning and ping.Band > 0
	local color = DiscoveryController.SignalColor(ping.Signal)
	if ringStroke then
		ringStroke.Color = if live then color else C.Stroke
		ringStroke.Transparency = if live then 0 else 1
	end
	local angle = if live then DiscoveryController.ArrowAngle() else nil
	if pivot and dot then
		dot.Visible = angle ~= nil
		dot.BackgroundColor3 = color
		if angle then
			pivot.Rotation = angle
			local size = 14 + (4 - math.clamp(ping.Band, 1, 4)) * 4
			dot.Size = UDim2.fromOffset(size, size)
		end
	end
	if verticalPill then
		local word = DetectorHUD.Instruction(ping, scanning)
		verticalPill.Visible = word ~= ""
		verticalPill.Text = word
		verticalPill.BackgroundColor3 = if ping.Band == 1 then color:Lerp(C.Navy, 0.35) else C.Navy
	end
	button:SetColor(if scanning then C.Purple elseif cooldown > 0 then C.Disabled else C.Coral)
end

function DetectorHUD.Init()
	if initialized then
		return
	end
	initialized = true
	local row = HUD.ActionsRow
	if not row then
		return
	end
	local button = Button.new({
		Name = "Scan",
		Icon = "📡",
		Text = "Scan",
		Vertical = true,
		Color = C.Coral,
		Size = UDim2.fromOffset(80, 80),
		MaxTextSize = 18,
		LayoutOrder = 0,
		Sound = "",
		Parent = row,
		OnClick = function()
			DiscoveryController.Scan()
		end,
	})
	DetectorHUD.Button = button
	HUD.Buttons.Scan = button

	-- radar overlay: glowing outline, orbiting direction dot, DOWN/UP pill
	local ring = Instance.new("Frame")
	ring.Name = "Radar"
	ring.BackgroundTransparency = 1
	ring.Size = UDim2.new(1, 8, 1, 8)
	ring.Position = UDim2.fromOffset(-4, -4)
	ring.ZIndex = 6
	ring.Parent = button.Holder
	Style.Corner(ring, UDim.new(0, 14))
	ringStroke = Style.Stroke(ring, C.Stroke, 4)
	local p = Instance.new("Frame")
	p.Name = "Pivot"
	p.BackgroundTransparency = 1
	p.AnchorPoint = Vector2.new(0.5, 0.5)
	p.Position = UDim2.fromScale(0.5, 0.46)
	p.Size = UDim2.fromOffset(100, 100)
	p.ZIndex = 7
	p.Parent = button.Holder
	pivot = p
	local d = Instance.new("Frame")
	d.Name = "Dot"
	d.AnchorPoint = Vector2.new(0.5, 0.5)
	d.Position = UDim2.fromScale(0.5, 0)
	d.Size = UDim2.fromOffset(16, 16)
	d.Visible = false
	d.ZIndex = 8
	d.Parent = p
	Style.Corner(d, UDim.new(1, 0))
	Style.Stroke(d, C.Stroke, 2)
	-- the pivot's rotation carries this round; 180 turns the down-arrow icon to point outward
	AtlasIcon.new({
		Name = "Pointer",
		Icon = "Arrow",
		Size = UDim2.fromScale(1.1, 1.1),
		Position = UDim2.fromScale(0.5, -0.35),
		Rotation = 180,
		ZIndex = 8,
		Parent = d,
	})
	dot = d
	-- Raised clear of the orbiting dot's arrowhead, which sits above the button when the find is
	-- straight ahead (the pill used to cover exactly that direction).
	local pill = Style.Label({
		Name = "Vertical",
		Text = "",
		Size = UDim2.fromOffset(136, 26),
		Position = UDim2.new(0.5, 0, 0, -46),
		AnchorPoint = Vector2.new(0.5, 1),
		MaxTextSize = 16,
		ZIndex = 9,
		Parent = button.Holder,
	})
	pill.BackgroundTransparency = 0
	pill.BackgroundColor3 = C.Navy
	pill.Visible = false
	Style.Corner(pill, Style.Theme.CornerPill)
	Style.Stroke(pill, C.Stroke, 2)
	verticalPill = pill

	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < 0.1 then
			return
		end
		acc = 0
		DetectorHUD.Render(
			DiscoveryController.Ping,
			DiscoveryController.IsScanning(),
			DiscoveryController.CooldownLeft()
		)
	end)
	DetectorHUD.Render(DiscoveryController.Ping, false, 0)
end

return DetectorHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">ExcavationGame</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ExcavationGame (v3 discovery slice) — the 3-5 second "dig it out!" moment when one of your
	digs uncovers a buried find (server ExcavationStart -> DiscoveryController.ExcavationStarted).

	Rings: after a short "ready" lead, info.Rings rings shrink one after another onto a target
	circle in the middle of the screen (info.RingSeconds each, info.RingGap apart). Tap anywhere
	(touch / click), or press Space / E / gamepad A / R2, when the ring meets the circle:
	  |error| <= PerfectWindow  PERFECT!   (2 points)
	  |error| <= GoodWindow     GOOD       (1 point)
	  later / no tap            MISS       (0; the find is never lost, only its quality drops)
	When every ring is graded the client sends Excavate(id, errors) (seconds, -1 = no tap); the
	server re-grades them (Util/Finds.Score) and decides the quality. Digging is paused while
	the session runs. The state machine (Start / Tap / Step with an optional clock) is public so
	tests can drive it without the UI.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Finds = require(Shared:WaitForChild("Util"):WaitForChild("Finds"))

local Root = require(script.Parent.Root)
local Toasts = require(script.Parent.Toasts)
local Style = require(script.Parent.Components.Style)
local SoundController = require(script.Parent.Parent.Controllers.SoundController)
local DiscoveryController = require(script.Parent.Parent.Controllers.DiscoveryController)
local DigController = require(script.Parent.Parent.Controllers.DigController)
local Signal = require(script.Parent.Parent.Util.Signal)

local ExcavationGame = {}

ExcavationGame.LEAD = 0.45 -- seconds of "ready" before the first ring starts shrinking
ExcavationGame.Graded = Signal.new() -- (ring: number, grade: string)
ExcavationGame.Finished = Signal.new() -- (id: string, errors: { number })

local TARGET = 150 -- design px
local RING_START = 430

type Game = {
	Info: Types.ExcavationInfo,
	StartAt: number,
	Errors: { number },
	Done: boolean,
}

local session: Game? = nil
type UiRefs = {
	Root: TextButton,
	Ring: Frame,
	RingStroke: UIStroke,
	Target: Frame,
	Cue: TextLabel,
	Grade: TextLabel,
	Dots: { Frame },
}
local gui: UiRefs? = nil
local retiring: { [string]: TextButton } = {}
local initialized = false

local function targetTime(g: Game, ring: number): number
	local info = g.Info
	return g.StartAt + ExcavationGame.LEAD + (ring - 1) * (info.RingSeconds + info.RingGap) + info.RingSeconds
end

function ExcavationGame.IsActive(): boolean
	return session ~= nil and not (session :: Game).Done
end

function ExcavationGame.Errors(): { number }
	return if session then table.clone((session :: Game).Errors) else {}
end

local GRADE_COLORS: { [string]: Color3 } = {
	Perfect = Color3.fromRGB(120, 255, 200),
	Good = Color3.fromRGB(255, 220, 90),
	Miss = Color3.fromRGB(255, 110, 110),
}

local function showGrade(ring: number, grade: string)
	local maybeUi = gui
	if not maybeUi then
		return
	end
	local ui = maybeUi :: UiRefs
	local result = if grade == "Perfect" then "PERFECT!" elseif grade == "Good" then "GOOD!" else "MISS"
	ui.Grade.Text = string.format("%d/%d: %s", ring, #ui.Dots, result)
	ui.Grade.TextColor3 = GRADE_COLORS[grade]
	ui.Cue.Text = ""
	ui.Ring.Visible = false
	Style.Pop(ui.Grade, 0.35)
	local dot = ui.Dots[ring]
	if dot then
		dot.BackgroundColor3 = GRADE_COLORS[grade]
	end
end

local function teardown()
	-- Keep notices clear until the final grade actually leaves the screen.
	task.delay(0.6, function()
		if not ExcavationGame.IsActive() then
			Toasts.SetExcavating(false)
		end
	end)
	local ui = gui
	gui = nil
	if ui then
		local root = ui.Root
		local id = if session then session.Info.Id else ""
		retiring[id] = root
		task.delay(0.6, function()
			if retiring[id] == root then
				retiring[id] = nil
			end
			root:Destroy()
		end)
	end
	DigController.Enabled = true
end

-- The confirmed reward takes over the screen, even if the final grade is still retiring.
function ExcavationGame.DismissForReveal(id: string)
	if session and session.Info.Id == id and not session.Done then
		session.Done = true
		teardown()
	end
	local root = retiring[id]
	if root then
		retiring[id] = nil
		root:Destroy()
	end
end

local function finish(g: Game)
	if g.Done then
		return
	end
	g.Done = true
	DiscoveryController.Excavate(g.Info.Id, g.Errors)
	ExcavationGame.Finished:Fire(g.Info.Id, table.clone(g.Errors))
	teardown()
end

local function record(g: Game, err: number)
	local ring = #g.Errors + 1
	table.insert(g.Errors, err)
	local grade = Finds.Grade(err)
	showGrade(ring, grade)
	if grade == "Perfect" then
		SoundController.Play("ExcavatePerfect", 1 + ring * 0.08)
		DiscoveryController.Nudge(g.Info.Id, 0.35)
	elseif grade == "Good" then
		SoundController.Play("ExcavateHit", 1)
		DiscoveryController.Nudge(g.Info.Id, 0.2)
	else
		SoundController.Play("DigBlocked", 0.9, 0.5)
	end
	ExcavationGame.Graded:Fire(ring, grade)
	if #g.Errors >= g.Info.Rings then
		finish(g)
	end
end

-- A tap at `now` (default os.clock()). Taps before the current ring appears are ignored.
function ExcavationGame.Tap(nowArg: number?): string?
	local maybe = session
	if not maybe then
		return nil
	end
	local g = maybe :: Game
	if g.Done then
		return nil
	end
	local now = nowArg or os.clock()
	local ring = #g.Errors + 1
	local t = targetTime(g, ring)
	if now < t - g.Info.RingSeconds then
		return nil
	end
	local err = math.abs(now - t)
	if err > g.Info.GoodWindow then
		err = if now < t then err else -1 -- early-but-visible taps count as a (missed) attempt
	end
	record(g, err)
	return Finds.Grade(err)
end

-- Advance time: rings that passed their window without a tap are misses.
function ExcavationGame.Step(nowArg: number?)
	local maybe = session
	if not maybe then
		return
	end
	local g = maybe :: Game
	if g.Done then
		return
	end
	local now = nowArg or os.clock()
	while not g.Done and now > targetTime(g, #g.Errors + 1) + g.Info.GoodWindow do
		record(g, -1)
	end
	local maybeUi = gui
	if maybeUi and not g.Done then
		local ui = maybeUi :: UiRefs
		local t = targetTime(g, #g.Errors + 1)
		local alpha = math.clamp(1 - (t - now) / g.Info.RingSeconds, 0, 1.15)
		local visible = now >= t - g.Info.RingSeconds
		local size = RING_START + (TARGET - RING_START) * alpha
		ui.Ring.Size = UDim2.fromOffset(size, size)
		ui.Ring.Visible = visible
		local close = math.abs(t - now) <= g.Info.GoodWindow
		ui.RingStroke.Color = if close then GRADE_COLORS.Perfect else Color3.new(1, 1, 1)
		-- The numbered result stays readable while the centre cues the next attempt.
		ui.Cue.Text = if visible then (if close then "TAP!" else "WAIT...") elseif #g.Errors == 0 then "READY..." else ""
		ui.Cue.TextColor3 = if close then GRADE_COLORS.Perfect else Color3.new(1, 1, 1)
	end
end

local function build(info: Types.ExcavationInfo)
	local color = DiscoveryController.SignalColor(info.Signal)
	local canvas = Root.Get("Popups")
	local overlay = Instance.new("TextButton")
	overlay.Name = "Excavation"
	overlay.Text = ""
	overlay.AutoButtonColor = false
	overlay.Selectable = false
	overlay.BackgroundColor3 = Color3.new(0, 0, 0)
	overlay.BackgroundTransparency = 0.75
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = 50
	overlay.Parent = canvas

	local title = Style.Label({
		Name = "Title",
		Text = "DIG IT OUT!",
		Size = UDim2.fromOffset(520, 64),
		Position = UDim2.new(0.5, 0, 0.5, -250),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor = color,
		MaxTextSize = 56,
		StrokeThickness = 4,
		ZIndex = 52,
		Parent = overlay,
	})
	Style.PopIn(title)
	Style.Label({
		Name = "Hint",
		Text = "Tap when the ring hits the circle!",
		Size = UDim2.fromOffset(520, 30),
		Position = UDim2.new(0.5, 0, 0.5, -205),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 24,
		ZIndex = 52,
		Parent = overlay,
	})

	local target = Instance.new("Frame")
	target.Name = "Target"
	target.AnchorPoint = Vector2.new(0.5, 0.5)
	target.Position = UDim2.fromScale(0.5, 0.5)
	target.Size = UDim2.fromOffset(TARGET, TARGET)
	target.BackgroundColor3 = color
	target.BackgroundTransparency = 0.55
	target.ZIndex = 51
	target.Parent = overlay
	Style.Corner(target, UDim.new(1, 0))
	Style.Stroke(target, Style.Colors.Stroke, 5)

	local ring = Instance.new("Frame")
	ring.Name = "Ring"
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromScale(0.5, 0.5)
	ring.Size = UDim2.fromOffset(RING_START, RING_START)
	ring.BackgroundTransparency = 1
	ring.Visible = false
	ring.ZIndex = 53
	ring.Parent = overlay
	Style.Corner(ring, UDim.new(1, 0))
	local ringStroke = Style.Stroke(ring, Color3.new(1, 1, 1), 8)

	local cue = Style.Label({
		Name = "Cue",
		Text = "READY...",
		Size = UDim2.fromOffset(TARGET + 60, 50),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 40,
		StrokeThickness = 4,
		ZIndex = 54,
		Parent = overlay,
	})
	local grade = Style.Label({
		Name = "Grade",
		Text = "",
		Size = UDim2.fromOffset(300, 42),
		Position = UDim2.new(0.5, 0, 0.5, 125),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 28,
		StrokeThickness = 3,
		ZIndex = 54,
		Parent = overlay,
	})

	local dotsRow = Instance.new("Frame")
	dotsRow.Name = "Dots"
	dotsRow.BackgroundTransparency = 1
	dotsRow.AnchorPoint = Vector2.new(0.5, 0.5)
	dotsRow.Position = UDim2.new(0.5, 0, 0.5, 200)
	dotsRow.Size = UDim2.fromOffset(info.Rings * 44, 34)
	dotsRow.ZIndex = 52
	dotsRow.Parent = overlay
	Style.List(dotsRow, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	local dots: { Frame } = {}
	for i = 1, info.Rings do
		local dot = Instance.new("Frame")
		dot.Name = "Dot" .. i
		dot.Size = UDim2.fromOffset(32, 32)
		dot.BackgroundColor3 = Style.Colors.NavyCard
		dot.LayoutOrder = i
		dot.ZIndex = 53
		dot.Parent = dotsRow
		Style.Corner(dot, UDim.new(1, 0))
		Style.Stroke(dot, Style.Colors.Stroke, 3)
		dots[i] = dot
	end

	overlay.Activated:Connect(function()
		ExcavationGame.Tap()
	end)
	gui =
		{ Root = overlay, Ring = ring, RingStroke = ringStroke, Target = target, Cue = cue, Grade = grade, Dots = dots }
end

-- Starts the minigame for a server ExcavationStart. `now` lets tests pin the clock.
function ExcavationGame.Start(info: Types.ExcavationInfo, nowArg: number?, headless: boolean?)
	if session and not (session :: Game).Done then
		finish(session :: Game) -- a new find replaces an unanswered one (server already moved on)
	end
	local rings = math.clamp(math.floor(tonumber(info.Rings) or 3), 1, 5)
	local safe: Types.ExcavationInfo = {
		Id = info.Id,
		Position = info.Position,
		Signal = info.Signal,
		Rings = rings,
		RingSeconds = math.clamp(tonumber(info.RingSeconds) or 0.9, 0.3, 3),
		RingGap = math.clamp(tonumber(info.RingGap) or 0.25, 0, 2),
		PerfectWindow = tonumber(info.PerfectWindow) or 0.09,
		GoodWindow = tonumber(info.GoodWindow) or 0.22,
		Timeout = tonumber(info.Timeout) or 9,
	}
	session = { Info = safe, StartAt = nowArg or os.clock(), Errors = {}, Done = false }
	DigController.Enabled = false
	Toasts.SetExcavating(true)
	if not headless then
		build(safe)
	end
end

function ExcavationGame.Init()
	if initialized then
		return
	end
	initialized = true
	DiscoveryController.ExcavationStarted:Connect(function(info: Types.ExcavationInfo)
		ExcavationGame.Start(info)
	end)
	UserInputService.InputBegan:Connect(function(input: InputObject, _processed: boolean)
		if not ExcavationGame.IsActive() then
			return
		end
		local key = input.KeyCode
		if
			key == Enum.KeyCode.Space
			or key == Enum.KeyCode.E
			or key == Enum.KeyCode.ButtonA
			or key == Enum.KeyCode.ButtonR2
		then
			ExcavationGame.Tap()
		end
	end)
	RunService.Heartbeat:Connect(function()
		if ExcavationGame.IsActive() then
			ExcavationGame.Step()
		end
	end)
end

return ExcavationGame
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">FindReveal</string>
              <string name="Source"><![CDATA[--!strict
--[[
	FindReveal (v3 discovery slice) — "rarity you feel": presents a FindRevealed by its Tier
	(Util/Finds.Tier; the world-side beam / rise is DiscoveryController's job, for every player):

	  Pop        Common / Uncommon: float text over the find ("Bottle Cap! +8"), soft sting.
	             First finds use a compact card instead of floating name/value text.
	  Beam       Rare, or any Giant / Golden / Fossilized / Crystal variant: coloured beam in
	             the world, distinct sting, compact card.
	  Card       Epic / Legendary: the full Reveal card + a camera moment (shake + FOV punch).
	  Server     Mythic: full card + flash + confetti; the server announces it (UI/Announcements)
	             and the sky beam is visible to everyone for ~12 s.
	  Spectacle  Relic: everything above, bigger.

	The card lists RARITY, SIZE, MATERIAL, QUALITY and VALUE, with NEW! / NEW VARIANT! tags.
	FindReveal.Presentation(info) is the pure tier -> presentation table (tests).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local Finds = require(Shared:WaitForChild("Util"):WaitForChild("Finds"))
local Models = require(Shared:WaitForChild("Models"))

local Style = require(script.Parent.Components.Style)
local Reveal = require(script.Parent.Reveal)
local ExcavationGame = require(script.Parent.ExcavationGame)
local EffectsController = require(script.Parent.Parent.Controllers.EffectsController)
local SoundController = require(script.Parent.Parent.Controllers.SoundController)
local DiscoveryController = require(script.Parent.Parent.Controllers.DiscoveryController)
local ModelFactory = require(script.Parent.Parent.Util.ModelFactory)
local State = require(script.Parent.Parent.Controllers.State)

local FindReveal = {}

export type Presentation = {
	Tier: string,
	Float: boolean, -- world float text over the find
	Card: string, -- "None" | "Compact" | "Full"
	Sound: string,
	Camera: boolean, -- shake + FOV punch
	Flash: boolean,
	Confetti: boolean,
}

local C = Style.Colors

function FindReveal.Presentation(info: Types.FindInfo): Presentation
	local tier = if table.find(Finds.TIERS, info.Tier)
		then info.Tier
		else Finds.Tier(info.Rarity, info.Size, info.Material)
	local order = Finds.TierOrder(tier)
	local fresh = info.IsNew or #info.NewVariants > 0
	local card = if order >= Finds.TierOrder("Card")
		then "Full"
		elseif order == Finds.TierOrder("Beam") or fresh then "Compact"
		else "None"
	return {
		Tier = tier,
		Float = card == "None",
		Card = card,
		Sound = if order >= Finds.TierOrder("Beam") then "RareTreasure" else "Treasure",
		Camera = order >= Finds.TierOrder("Card"),
		Flash = order >= Finds.TierOrder("Server"),
		Confetti = order >= Finds.TierOrder("Server"),
	}
end

local function cameraMoment(strength: number)
	if State.GetSetting("ReducedMotion", false) == true then
		return
	end
	EffectsController.Shake(0.35 * strength, 0.35)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local fov = camera.FieldOfView
	local punch = TweenService:Create(
		camera,
		TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true),
		{ FieldOfView = fov - 8 * strength }
	)
	punch:Play()
end

local function rows(info: Types.FindInfo, color: Color3): { Reveal.Row }
	local list: { Reveal.Row } = { { Label = "RARITY", Value = info.Rarity, Color = color } }
	local size = Finds.GetSize(info.Size)
	local material = Finds.GetMaterial(info.Material)
	local quality = Finds.GetQuality(info.Quality)
	if size then
		table.insert(list, { Label = "SIZE", Value = info.Size, Color = size.Color })
	end
	if material and info.Material ~= "None" then
		table.insert(list, { Label = "MATERIAL", Value = info.Material, Color = material.Color })
	end
	if quality and not info.Ambient then
		table.insert(list, { Label = "QUALITY", Value = quality.Name, Color = quality.Color })
	end
	table.insert(list, { Label = "VALUE", Value = Format.Abbreviate(info.Value) .. " coins", Color = C.Money })
	return list
end

function FindReveal.Show(info: Types.FindInfo)
	ExcavationGame.DismissForReveal(info.Id)
	local p = FindReveal.Presentation(info)
	local rarity = Config.GetRarity(info.Rarity)
	local color = if rarity then rarity.Color else C.Text
	local name = Finds.DisplayName(info.TreasureId, info.Size, info.Material)
	if p.Float and typeof(info.Position) == "Vector3" then
		local scale = 0.9 + Finds.TierOrder(p.Tier) * 0.15
		EffectsController.FloatText(info.Position + Vector3.new(0, 2, 0), name .. "!", color, scale)
		task.delay(0.35, function()
			EffectsController.FloatText(info.Position, "+" .. Format.Abbreviate(info.Value), C.Money, 0.8)
		end)
	end
	if p.Camera then
		cameraMoment(if p.Flash then 1.6 else 1)
	end
	if p.Card == "None" then
		SoundController.Play(p.Sound)
		return
	end
	local model: Model? = nil
	local ok, built = pcall(function(): Model
		return Models.Find(info.TreasureId, info.Size, info.Material)
	end)
	if ok then
		model = built
		ModelFactory.MakeVisualOnly(built)
	else
		model = ModelFactory.Treasure(info.TreasureId)
	end
	local tag = if info.IsNew then "NEW!" elseif #info.NewVariants > 0 then "NEW VARIANT!" else nil
	Reveal.Show({
		Headline = string.upper(info.Rarity) .. "!",
		Color = color,
		Gradient = if rarity then rarity.Gradient else nil,
		Caption = if info.Perfect then "PERFECT DIG!" elseif info.Ambient then "LUCKY FIND!" else "YOU DUG UP",
		Items = {
			{
				Name = name,
				NameColor = C.Text,
				Model = model,
				Pitch = 20,
				Spin = info.TreasureId ~= "lost_flip_flop",
				Rows = rows(info, color),
				Tag = tag,
			},
		},
		Compact = p.Card == "Compact",
		CompactScale = 0.78,
		Hold = if p.Card == "Full" then 4.5 else 2.6,
		Sound = p.Sound,
		Flash = p.Flash,
		Confetti = p.Confetti,
	})
end

function FindReveal.Init()
	DiscoveryController.FindRevealed:Connect(function(info: Types.FindInfo)
		FindReveal.Show(info)
	end)
end

return FindReveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!strict
--[[
	HUD — always-on screen UI (docs/UI_STYLE.md). Every region is placed by UI/Layout.luau
	(design px, recomputed on resize; see the region map there):
	  TopRight  "TopRight" cluster: Coins pill (big green number, icon overlapping its left
	            end), Daily + Settings small round buttons (Daily gets a "!" when claimable),
	            Tokens pill and the rebirth/pet multiplier pill under them
	  Menu      "Menu": big square buttons in 2 columns (Shop, Beach, Eggs, Pets, Index, Quests,
	            Rebirth, Store) with oversized icons, outlined captions on the bottom edge and red
	            "!" badges (claimable quests, rebirth ready, affordable next shovel/backpack).
	            Hidden while a panel is open on small screens.
	            Progressive disclosure (UI/MenuGate, docs/design/Onboarding.md): each button (and
	            the top-right Daily button) appears only once relevant and never disappears
	            again; the visible ones re-flow into the 2 columns without gaps; a newly
	            unlocked one pops in with a toast and a gold "NEW!" tag until its panel is opened.
	  Depth     "Depth" meter: depth, layer, progress bar, record + next layer
	            (top-centre-right on wide screens, under the TopRight cluster on narrow ones)
	  Timers    "Timers": active boost / event chips (live timers) in the top-centre column,
	            under the objective banner (UI/ObjectiveBanner) and above the toasts
	  Bottom    "Bottom": backpack bar (red + pulsing "SELL!" when full), Surface, Sell (pass),
	            Auto Dig (pass) buttons
	HUD.Buttons keeps every button by name (menu entries plus Daily, Settings, Surface, Sell,
	AutoDig). Every button face is >= 74 design px (44 real px at the minimum UI scale 0.6), the
	small round buttons get an invisible 80 px touch area.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
