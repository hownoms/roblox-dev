{
  "name": "DigToTheCoreAssetGallery",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": { "Shared": { "$path": "src/shared", "GalleryCatalog": { "$path": "tools/gallery/Catalog.luau" } } },
    "StarterPlayer": { "StarterPlayerScripts": {
      "UI": { "$className": "Folder", "Components": { "$className": "Folder", "Viewport": { "$path": "src/client/UI/Components/Viewport.luau" } } },
      "Controllers": { "$className": "Folder", "State": { "$path": "tools/gallery/ReviewState.luau" } },
      "GalleryReview": { "$path": "tools/gallery/GalleryReview.client.luau" }
    } },
    "ServerScriptService": { "Gallery": { "$path": "tools/gallery/Gallery.server.luau" } },
    "Workspace": { "$properties": { "StreamingEnabled": false } },
    "Lighting": { "$properties": { "Technology": "Future", "ClockTime": 14, "Brightness": 2, "ExposureCompensation": -0.3, "Ambient": [0.4, 0.4, 0.4], "OutdoorAmbient": [0.6, 0.6, 0.6] } }
  }
}
