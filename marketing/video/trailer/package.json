{
  "name": "dig-to-the-core-trailer",
  "private": true,
  "version": "1.0.0",
  "description": "Launch trailer (16:9) and vertical short (9:16) for Dig to the Core!, built with Remotion from real gameplay clips.",
  "scripts": {
    "studio": "remotion studio",
    "render:trailer": "remotion render Trailer out/dig-to-the-core-trailer.mp4 --codec h264 --crf 16",
    "render:vertical": "remotion render Vertical out/dig-to-the-core-vertical.mp4 --codec h264 --crf 16"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
