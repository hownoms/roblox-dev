diff --git a/src/client/Controllers/InputController.luau b/src/client/Controllers/InputController.luau
index ba5b24b..bb75774 100644
--- a/src/client/Controllers/InputController.luau
+++ b/src/client/Controllers/InputController.luau
@@ -1,5 +1,6 @@
 --!strict
 -- InputController — console/PC shortcuts. Gamepad: R2 dig (DigController), X = Surface,
+-- (Q yields to the adventure's Broadwave charge only while a Broadwave tool is equipped),
 -- Y = jump into the HUD menu with selection (B closes panels, see Panel). Keyboard: Q = Surface,
 -- G = Shop, P = Pets.
 local ContextActionService = game:GetService("ContextActionService")
@@ -8,6 +9,7 @@ local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
 local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
 local SoundController = require(script.Parent.SoundController)
+local InputArbiter = require(script.Parent.InputArbiter)
 local HUD = require(script.Parent.Parent.UI.HUD)
 local Panel = require(script.Parent.Parent.UI.Components.Panel)
 
@@ -23,13 +25,23 @@ local function onBegin(fn: () -> ()): (string, Enum.UserInputState, InputObject)
 end
 
 function InputController.Init()
-	ContextActionService:BindAction(
+	-- Q is shared with the adventure's Broadwave charge (Q / L1). Bound one step above default
+	-- priority so Q surfaces as before unless a Broadwave tool is equipped, in which case Q passes
+	-- to the charge action (InputArbiter). ButtonX always surfaces.
+	ContextActionService:BindActionAtPriority(
 		"DigSurface",
-		onBegin(function()
-			SoundController.Play("Teleport")
-			Remotes.Get("ReturnToSurface"):FireServer()
-		end),
+		function(_, state: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
+			if input.KeyCode == Enum.KeyCode.Q and InputArbiter.BroadwaveEquipped() then
+				return Enum.ContextActionResult.Pass
+			end
+			if state == Enum.UserInputState.Begin then
+				SoundController.Play("Teleport")
+				Remotes.Get("ReturnToSurface"):FireServer()
+			end
+			return Enum.ContextActionResult.Sink
+		end,
 		false,
+		Enum.ContextActionPriority.Medium.Value + 1,
 		Enum.KeyCode.ButtonX,
 		Enum.KeyCode.Q
 	)
