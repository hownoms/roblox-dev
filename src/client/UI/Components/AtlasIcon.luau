--!strict
--[[
	AtlasIcon — every icon slot in the UI. Renders one cell of the icon atlas
	(Config/IconAtlas.luau: AssetId, CellSize, Icons = { name = offset }, Aliases, Groups) as an
	ImageLabel while the owner has uploaded the sheet (AssetId ~= ""), otherwise the emoji from
	UI/Icons.luau through Style.Icon (emoji-safe sizing, never TextScaled emoji). Uploading the
	atlas therefore upgrades every icon at once.

		local icon = AtlasIcon.new({ Icon = "Coins", Size = UDim2.fromOffset(40, 40), Parent = f })
		icon:Set("Layers.pirate_cove")   -- swap later (Button:SetIcon uses this)

	`Icon` accepts, in this order:
	  - an atlas icon name ("coins", "sun")
	  - an Icons.luau key ("Coins", "Shop") via IconAtlas.Aliases
	  - "Group.key" for the grouped Icons tables ("Layers.shell_bed", "PetShapes.Crab",
	    "BoostKinds.Luck", "TreasureShapes.Gem", ...) via IconAtlas.Groups (+ group Default)
	  - "atlas_name|emoji" (AtlasIcon.With): an atlas cell with an explicit emoji fallback
	  - a raw emoji ("💰"): reverse-mapped to its Icons key when there is one; otherwise it is
	    simply drawn as that emoji (also after the atlas is uploaded).
	The container Frame carries the attribute "Icon" (the key it was given) for tests/debugging.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Style = require(script.Parent.Style)
local Icons = require(script.Parent.Parent.Icons)

local AtlasIcon = {}

-- The atlas module is generated by another tool and may change shape: read it loosely.
local atlas: any = nil
do
	local ok, result = pcall(function(): any
		local config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
		local module = config:FindFirstChild("IconAtlas")
		if module and module:IsA("ModuleScript") then
			return require(module) :: any
		end
		return nil
	end)
	if ok and typeof(result) == "table" then
		atlas = result
	end
end

-- Emoji for atlas names that have no Icons.luau key.
local NAME_EMOJI: { [string]: string } = {
	shovel = "⛏️",
	spade = "⛏️",
	pickaxe = "⛏️",
	layer = "⛰️",
	trophy = "🏆",
	beach_shop = "⛱️",
	gift = "🎁",
	place_shade = "⛱️",
	heat = "🌡️",
	sun = "☀️",
	shade = "⛱️",
	water = "💧",
	lemonade = "🍋",
	coconut = "🥥",
	popsicle = "🍭",
	shaved_ice = "🍧",
	watermelon_slice = "🍉",
	giant_watermelon = "🍉",
	boost_sand = "⏳",
	boost_luck = "🍀",
	boost_speed = "⚡",
	boost_coins = "💰",
	golden_hour = "🌅",
	high_tide = "🌊",
	treasure = "🧰",
	egg_hatch = "🥚",
	arrow_right = "➡️",
	arrow_down = "⬇️",
	notify = "💬",
	music = "🎵",
	sfx = "🔊",
	codes = "🎟️",
	info = "💬",
	gem = "💎",
	shell = "🐚",
	crab = "🦀",
	hourglass = "⏳",
}

local GROUPS = { "Layers", "PetShapes", "VehicleKinds", "BackpackShapes", "TreasureShapes", "BoostKinds", "Events" }

-- emoji -> first Icons key ("Coins") or "Group.key" that uses it
local byEmoji: { [string]: string } = {}
do
	local keys = {}
	for key, value in Icons :: any do
		if typeof(value) == "string" then
			table.insert(keys, key)
		end
	end
	table.sort(keys)
	for _, key in keys do
		local emoji = (Icons :: any)[key]
		if byEmoji[emoji] == nil then
			byEmoji[emoji] = key
		end
	end
	for _, group in GROUPS do
		local tbl = (Icons :: any)[group]
		if typeof(tbl) == "table" then
			local groupKeys = {}
			for key in tbl do
				table.insert(groupKeys, key)
			end
			table.sort(groupKeys)
			for _, key in groupKeys do
				local emoji = tbl[key]
				if typeof(emoji) == "string" and byEmoji[emoji] == nil then
					byEmoji[emoji] = group .. "." .. key
				end
			end
		end
	end
end

local function atlasTable(field: string): any
	local value = if atlas then atlas[field] else nil
	return if typeof(value) == "table" then value else nil
end

-- Atlas cell offset for a key (no asset check).
local function offsetFor(key: string): Vector2?
	local icons = atlasTable("Icons")
	if not icons then
		return nil
	end
	local direct = icons[key]
	if typeof(direct) == "Vector2" then
		return direct
	end
	local aliases = atlasTable("Aliases")
	local alias = if aliases then aliases[key] else nil
	if typeof(alias) == "string" and typeof(icons[alias]) == "Vector2" then
		return icons[alias]
	end
	local group, sub = string.match(key, "^(%a+)%.(.+)$")
	if group and sub then
		local groups = atlasTable("Groups")
		local entry = if groups then groups[group] else nil
		if typeof(entry) == "table" then
			local name = entry[sub] or entry.Default
			if typeof(name) == "string" and typeof(icons[name]) == "Vector2" then
				return icons[name]
			end
		end
	end
	return nil
end

-- "atlas_name|emoji" key: that atlas cell, with an explicit emoji fallback (config items such
-- as snacks whose emoji lives in Config: AtlasIcon.With("lemonade", def.Icon)).
function AtlasIcon.With(name: string, emoji: string): string
	return name .. "|" .. emoji
end

-- Config items (snacks, shades) by id: the atlas cell of the same name when there is one.
local ITEM_NAMES: { [string]: string } = { coconut_water = "coconut" }
function AtlasIcon.Item(id: string, emoji: string): string
	return AtlasIcon.With(ITEM_NAMES[id] or id, emoji)
end

-- Emoji for a key (or the text itself when it already is one).
function AtlasIcon.Emoji(key: string): string
	local value = (Icons :: any)[key]
	if typeof(value) == "string" then
		return value
	end
	local group, sub = string.match(key, "^(%a+)%.(.+)$")
	if group and sub then
		local tbl = (Icons :: any)[group]
		if typeof(tbl) == "table" and typeof(tbl[sub]) == "string" then
			return tbl[sub]
		end
	end
	local aliases = atlasTable("Aliases")
	if aliases then
		for iconsKey, name in aliases do
			if name == key and typeof((Icons :: any)[iconsKey]) == "string" then
				return (Icons :: any)[iconsKey]
			end
		end
	end
	return NAME_EMOJI[key] or key
end

function AtlasIcon.HasAtlas(): boolean
	local id = if atlas then atlas.AssetId else nil
	return typeof(id) == "string" and id ~= ""
end

local function cellSize(): number
	local size = if atlas then atlas.CellSize else nil
	return if typeof(size) == "number" then size else 128
end

-- (atlas offset or nil when the atlas is not uploaded / has no such icon, emoji fallback)
function AtlasIcon.Resolve(icon: string): (Vector2?, string)
	local named, explicit = string.match(icon, "^([^|]+)|(.+)$")
	if named and explicit then
		-- "atlas_name|emoji": atlas cell when uploaded, else exactly this emoji
		return if AtlasIcon.HasAtlas() then offsetFor(named) else nil, explicit
	end
	local key = byEmoji[icon] or icon
	local emoji = if byEmoji[icon] then icon else AtlasIcon.Emoji(key)
	if not AtlasIcon.HasAtlas() then
		return nil, emoji
	end
	return offsetFor(key), emoji
end

export type AtlasIconProps = {
	Icon: string,
	Name: string?,
	Size: UDim2?, -- default: fills the parent (kept square)
	Position: UDim2?, -- default: centred
	AnchorPoint: Vector2?,
	ZIndex: number?,
	LayoutOrder: number?,
	Rotation: number?,
	Square: boolean?, -- default true: aspect-locked inside Size
	Parent: Instance?,
}

export type AtlasIcon = {
	Frame: Frame,
	Key: string,
	Set: (self: AtlasIcon, icon: string) -> (),
	SetTransparency: (self: AtlasIcon, alpha: number) -> (),
}

function AtlasIcon.new(props: AtlasIconProps): AtlasIcon
	local frame = Instance.new("Frame")
	frame.Name = props.Name or "Icon"
	frame.BackgroundTransparency = 1
	frame.Size = props.Size or UDim2.fromScale(1, 1)
	frame.Position = props.Position or UDim2.fromScale(0.5, 0.5)
	frame.AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5)
	frame.ZIndex = props.ZIndex or 1
	frame.LayoutOrder = props.LayoutOrder or 0
	frame.Rotation = props.Rotation or 0
	if props.Square ~= false then
		local ratio = Instance.new("UIAspectRatioConstraint")
		ratio.AspectRatio = 1
		ratio.AspectType = Enum.AspectType.FitWithinMaxSize
		ratio.Parent = frame
	end

	local image: ImageLabel? = nil
	local emojiLabel: TextLabel? = nil
	local usesAtlas = false
	local loadConnection: RBXScriptConnection? = nil
	local function syncLoaded()
		local loaded = usesAtlas and image ~= nil and image.IsLoaded
		if image then
			image.Visible = loaded
		end
		if emojiLabel then
			emojiLabel.Visible = not loaded
		end
	end
	frame.Destroying:Once(function()
		if loadConnection then
			loadConnection:Disconnect()
		end
	end)

	local self: AtlasIcon
	self = {
		Frame = frame,
		Key = props.Icon,
		Set = function(this: AtlasIcon, icon: string)
			this.Key = icon
			frame:SetAttribute("Icon", icon)
			local offset, emoji = AtlasIcon.Resolve(icon)
			usesAtlas = offset ~= nil
			if not emojiLabel then
				emojiLabel = Style.Icon({
					Name = "Emoji",
					Text = emoji,
					Size = UDim2.fromScale(1, 1),
					ZIndex = frame.ZIndex,
					Parent = frame,
				})
			end
			(emojiLabel :: TextLabel).Text = emoji
			if offset then
				local img = image
				if not img then
					local made = Instance.new("ImageLabel")
					made.Name = "Image"
					made.BackgroundTransparency = 1
					made.Size = UDim2.fromScale(1, 1)
					made.ScaleType = Enum.ScaleType.Fit
					made.ZIndex = frame.ZIndex
					made.Parent = frame
					image = made
					img = made
					loadConnection = made:GetPropertyChangedSignal("IsLoaded"):Connect(syncLoaded)
				end
				local cell = cellSize()
				local i = img :: ImageLabel
				i.Image = atlas.AssetId
				i.ImageRectOffset = offset
				i.ImageRectSize = Vector2.new(cell, cell)
				syncLoaded()
			else
				local label = emojiLabel
				if not label then
					label = Style.Icon({
						Name = "Emoji",
						Text = emoji,
						Size = UDim2.fromScale(1, 1),
						ZIndex = frame.ZIndex,
						Parent = frame,
					})
					emojiLabel = label
				end
				local l = label :: TextLabel
				l.Text = emoji
				l.Visible = true
				if image then
					image.Visible = false
				end
			end
		end,
		SetTransparency = function(_: AtlasIcon, alpha: number)
			if image then
				image.ImageTransparency = alpha
			end
			if emojiLabel then
				emojiLabel.TextTransparency = alpha
			end
		end,
	}
	self:Set(props.Icon)
	if props.Parent then
		frame.Parent = props.Parent
	end
	return self
end

return AtlasIcon
